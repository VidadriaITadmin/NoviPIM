{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "TodoWrite",
      "Task",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet list:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --info)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore --staged:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git bundle:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(sqlcmd:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl http://localhost:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(mv:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(Remove-Item:*)",
      "Bash(Move-Item:*)",
      "Bash(sc:*)",
      "Bash(net:*)",
      "Bash(schtasks:*)",
      "Bash(reg:*)",
      "Bash(iisreset:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./appsettings.Local.json)",
      "Read(./**/appsettings.Local.json)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pfx)",
      "Read(./**/*secrets*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "additionalDirectories": [
      "../PIM_test"
    ]
  }
}
