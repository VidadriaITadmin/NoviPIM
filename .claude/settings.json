{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "TodoWrite",
      "Task",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(Remove-Item:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(git push:*)",
      "Bash(sc:*)",
      "Bash(net:*)",
      "Bash(schtasks:*)",
      "Bash(reg:*)",
      "Bash(iisreset:*)"
    ],
    "deny": [
      "Read(./appsettings.Local.json)",
      "Read(./**/appsettings.Local.json)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pfx)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "additionalDirectories": [
      "../PIM_test"
    ]
  }
}
