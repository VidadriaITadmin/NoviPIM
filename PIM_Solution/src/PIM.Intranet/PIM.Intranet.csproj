<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 10 SSR navigation redirects without throwing NavigationException. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WorkbookTable: branje delovnega zvezka pri uvozu mnozicnih sprememb. -->
    <ProjectReference Include="..\PIM.Operations\PIM.Operations.csproj" />
    <!-- SaopDocumentBuilder in SaopIntentResolver: predogled mora sestaviti isti dokument,
         kot ga sestavi posiljatelj. Predogled z lastnim gradnikom bi lagal. -->
    <ProjectReference Include="..\PIM.Outbound\PIM.Outbound.csproj" />
  </ItemGroup>

</Project>
