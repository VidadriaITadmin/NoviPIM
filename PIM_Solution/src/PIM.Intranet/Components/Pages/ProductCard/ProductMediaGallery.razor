@namespace PIM.Intranet.Components.Pages.ProductCardParts

<section class="media-section" aria-labelledby="media-gallery-title">
  <h2 id="media-gallery-title">Vse slike izdelka (@Media.Count.ToString("N0"))</h2>
  <PimState Empty="@(Media.Count == 0)" EmptyText="Artikel nima nobenega medija.">
    <div class="media-gallery">
      @foreach (var row in OrderedMedia)
      {
        var url = MediaUrlPolicy.Normalize(row.Url);
        <article class="media-card @(IsPrimary(row) ? "primary" : null)">
          <div class="media-preview">
            @if (url.Href is not null && !Failed.Contains(row.ProductMediaId))
            {
              <img src="@url.Href" alt="@ProductName" loading="lazy" @onerror="() => ImageFailed(row.ProductMediaId)" />
            }
            else
            {
              <span>@(url.Href is null ? "Brez slike" : "Slike ni mogoče naložiti")</span>
            }
          </div>
          <strong>@(IsPrimary(row) ? "Glavna slika" : row.Role) · #@row.SortOrder</strong>
          <span class="media-address" title="@url.Display">@Shorten(url.Display)</span>
          @if (url.Href is not null) { <a href="@url.Href" target="_blank" rel="noopener noreferrer">Odpri izvirnik</a> }
          @if (url.Note is not null) { <span class="media-note">@url.Note</span> }
        </article>
      }
    </div>
  </PimState>

  <h2>Dokumenti</h2>
  <PimState Empty="@(Documents.Count == 0)" EmptyText="Artikel nima dokumentov.">
    <PimTable Caption="Dokumenti in tehnične datoteke izdelka" Columns="DocumentColumns">
      <Rows>
        @foreach (var row in Documents.OrderBy(row => row.Role).ThenBy(row => row.SortOrder))
        {
          var url = MediaUrlPolicy.Normalize(row.Url);
          <tr>
            <td>@row.Role</td>
            <td>@(row.Title ?? "—")</td>
            <td>
              @if (url.Href is not null) { <a href="@url.Href" target="_blank" rel="noopener noreferrer">@Shorten(url.Display)</a> }
              else { <span class="muted" title="@url.Note">@Shorten(url.Display)</span> }
            </td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
  @if (Media.Count == 0) { <p><a href="mediji">Odpri skupni pregled medijev</a></p> }
</section>

@code {
  [Parameter, EditorRequired] public required string ProductName { get; set; }
  [Parameter, EditorRequired] public required IReadOnlyList<ProductCardMedia> Media { get; set; }
  [Parameter, EditorRequired] public required IReadOnlyList<ProductCardDocument> Documents { get; set; }

  readonly HashSet<long> Failed = [];
  IEnumerable<ProductCardMedia> OrderedMedia => Media.OrderByDescending(IsPrimary).ThenBy(row => row.Role).ThenBy(row => row.SortOrder);
  static readonly IReadOnlyList<PimColumn> DocumentColumns = [new("Vloga"), new("Naziv"), new("Naslov")];

  static bool IsPrimary(ProductCardMedia row) =>
    row.SortOrder == 1 || row.Role.Contains("MAIN", StringComparison.OrdinalIgnoreCase)
      || row.Role.Contains("GLAV", StringComparison.OrdinalIgnoreCase);
  void ImageFailed(long id) => Failed.Add(id);
  static string Shorten(string value) => value.Length <= 72 ? value : value[..36] + " … " + value[^30..];
}
