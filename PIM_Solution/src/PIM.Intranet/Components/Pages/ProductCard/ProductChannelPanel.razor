@namespace PIM.Intranet.Components.Pages.ProductCardParts
@using PIM.Intranet.Components.Pages.ProductCardParts

@* Obrazec enega kanala. Slog je v ProductChannelPanel.razor.css in ne sme biti v kartici:
   izoliran slog Blazorja velja samo za oznako svoje komponente, zato je bil obrazec prej brez
   sloga — pravila so bila zapisana pri kartici, oznaka pa je tu. *@

<section id="@PanelId" role="tabpanel" aria-labelledby="@TabId" tabindex="0"
         class="channel-panel" hidden="@Hidden">
  <header class="panel-head">
    <div class="panel-heading">
      <h2>@Title</h2>
      <PimChip Text="@StatusText" Tone="@StatusTone" />
    </div>
    <dl class="panel-meta">
      <div><dt>Blokirajoče napake</dt><dd class="@(BlockingCount > 0 ? "bad" : null)">@BlockingCount.ToString("N0")</dd></div>
      <div><dt>Opozorila</dt><dd>@WarningCount.ToString("N0")</dd></div>
      <div><dt>Validirano</dt><dd>@PimFormat.Ago(LastValidatedUtc)</dd></div>
    </dl>
    <div class="panel-tools">
      @if (Toolbar is not null) { @Toolbar }
      @* U3, pregled 2026-09-08: pod vsakim poljem je stal tehnicni kljuc (ProductText.WEB_TITLE.sl,
         Product.WebPublish). Urednik ga ne potrebuje, razvijalec pa ga potrebuje takoj — zato ni
         izbrisan, ampak skrit za enim preklopom na panel. *@
      <label class="key-toggle">
        <input type="checkbox" checked="@ShowFieldKeys" @onchange="args => ShowFieldKeys = args.Value is bool on && on" />
        <span>Tehnični ključi</span>
      </label>
    </div>
  </header>

  <div class="panel-body">
    @foreach (var group in Fields.GroupBy(row => row.Hint ?? DefaultGroup))
    {
      var missing = group.Count(row => row.Missing && row.Required);
      <section class="field-group @(TwoColumnGroups?.Contains(group.Key, StringComparer.Ordinal) == true ? "two-columns" : null)">
        <h3 class="group-title">
          @group.Key
          @if (missing > 0) { <span class="group-count">@missing brez vrednosti</span> }
        </h3>
        <div class="field-grid">
          @foreach (var row in group)
          {
            var controlId = ControlId(row);
            <div class="field @(row.Format == "multiline" ? "wide" : null) @(row.Required && row.Missing ? "needs-value" : null)">
              <label for="@controlId">
                <span class="field-label">@row.Label</span>
                @if (row.Required) { <span class="tag tag-required">obvezno</span> }
                @if (row.Edit == ProductFieldEdit.Saop) { <span class="tag tag-saop">SAOP</span> }
              </label>

              @if (row.Edit == ProductFieldEdit.None || ReadOnly)
              {
                <output id="@controlId" class="field-value">@Display(row)</output>
              }
              else if (row.Format == "bool")
              {
                <select id="@controlId" class="field-input" disabled="@row.Pending"
                        value="@Draft(row)" @onchange="args => Change(row, args)">
                  <option value="">— ni določeno —</option>
                  <option value="da">Da</option>
                  <option value="ne">Ne</option>
                </select>
              }
              else if (row.Format == "multiline")
              {
                <textarea id="@controlId" class="field-input" rows="4" disabled="@row.Pending"
                          value="@Draft(row)" @onchange="args => Change(row, args)"></textarea>
              }
              else
              {
                <input id="@controlId" class="field-input" inputmode="@(row.Format == "decimal" ? "decimal" : null)" disabled="@row.Pending"
                       value="@Draft(row)" @onchange="args => Change(row, args)"
                       @onkeyup="args => EnterSaves(args)" />
              }

              <p class="field-note">
                @if (ShowFieldKeys) { <span class="code-value">@row.FieldKey</span> }
                @if (row.Edit == ProductFieldEdit.None && !row.InReadModel) { <span>ni v bralnem modelu</span> }
                @if (ReadOnly && row.Edit != ProductFieldEdit.None) { <span>tvoja vloga tega polja ne sme urejati</span> }
              </p>
            </div>
          }
        </div>
      </section>
    }

    <section class="field-group">
      <h3 class="group-title">Odprte težave kanala</h3>
      <PimState Empty="@(Issues.Count == 0)" EmptyText="Kanal nima odprtih validacijskih težav.">
        <ul class="issue-list">
          @foreach (var row in Issues)
          {
            <li class="issue @(row.Severity == "ERROR" ? "error" : "warning")">
              <span class="issue-mark" aria-hidden="true"></span>
              <div>
                <p class="issue-message">@row.Message</p>
                <p class="issue-meta">
                  <span class="code-value">@row.FieldCode</span>
                  <span>@row.ProfileCode</span>
                  <span>@(row.Severity == "ERROR" ? "blokira" : "opozorilo")</span>
                  <span>@PimFormat.Ago(row.LastDetectedUtc)</span>
                </p>
              </div>
              @* 249: EAN, proizvajalec, dobavitelj so obvezni, a »skrbnik lahko potrdi, da artikel tega nima«
                 (sodelavka, Excel 11. 9.). Gumb vidi samo skrbnik in samo pri polju, ki ga baza dovoli potrditi. *@
              @if (CanWaive && Waivable(row.FieldCode) is { IsWaived: false } waivable)
              {
                <button type="button" class="ghost-button issue-waive" title="Potrditev velja, dokler je skrbnik ne prekliče; artikel se takoj ponovno validira."
                        @onclick="() => WaiverChanged.InvokeAsync((row.FieldCode, true))">@waivable.Label — potrdi</button>
              }
            </li>
          }
        </ul>
      </PimState>
    </section>

    @if (Waivers.Any(row => row.IsWaived))
    {
      <section class="field-group">
        <h3 class="group-title">Potrditve skrbnika</h3>
        <ul class="issue-list">
          @foreach (var row in Waivers.Where(row => row.IsWaived))
          {
            <li class="issue waived">
              <span class="issue-mark" aria-hidden="true"></span>
              <div>
                <p class="issue-message">@row.Label</p>
                <p class="issue-meta">
                  <span class="code-value">@row.FieldCode</span>
                  <span>potrdil @row.CreatedBy</span>
                  <span>@PimFormat.Ago(row.CreatedUtc)</span>
                  @if (!string.IsNullOrWhiteSpace(row.Reason)) { <span>@row.Reason</span> }
                </p>
              </div>
              @if (CanWaive)
              {
                <button type="button" class="ghost-button issue-waive" @onclick="() => WaiverChanged.InvokeAsync((row.FieldCode, false))">Prekliči</button>
              }
            </li>
          }
        </ul>
      </section>
    }
  </div>
</section>

@code {
  [Parameter, EditorRequired] public required string PanelId { get; set; }
  [Parameter, EditorRequired] public required string TabId { get; set; }
  [Parameter, EditorRequired] public required string Title { get; set; }
  [Parameter, EditorRequired] public required string StatusText { get; set; }
  [Parameter] public string? StatusTone { get; set; }
  [Parameter] public long BlockingCount { get; set; }
  [Parameter] public long WarningCount { get; set; }
  [Parameter] public DateTime? LastValidatedUtc { get; set; }
  [Parameter, EditorRequired] public required IReadOnlyList<ProductChannelField> Fields { get; set; }
  [Parameter, EditorRequired] public required IReadOnlyList<ProductCardIssue> Issues { get; set; }
  [Parameter] public bool Hidden { get; set; }
  [Parameter] public RenderFragment? Toolbar { get; set; }

  /// <summary>Potrdljiva polja (249) z morebitno veljavno potrditvijo skrbnika za ta artikel.</summary>
  [Parameter] public IReadOnlyList<ProductFieldWaiverRow> Waivers { get; set; } = [];

  /// <summary>Ali sme prijavljeni uporabnik potrjevati — samo skrbnik (politika <c>FieldWaiver</c>).</summary>
  [Parameter] public bool CanWaive { get; set; }

  /// <summary>(koda polja, potrdi/prekliči) — kartica zapiše potrditev in se znova naloži.</summary>
  [Parameter] public EventCallback<(string FieldCode, bool Active)> WaiverChanged { get; set; }

  ProductFieldWaiverRow? Waivable(string fieldCode) =>
    Waivers.FirstOrDefault(row => string.Equals(row.FieldCode, fieldCode, StringComparison.OrdinalIgnoreCase));

  /// <summary>
  /// Vloga brez pravice pisanja (A1, pregled 2026-09-08). Obrazec se takrat izrise kot vrednosti
  /// in ne kot vnosna polja; to je videz, prava varovalka je <c>PimWriteGuard</c> v servisu.
  /// </summary>
  [Parameter] public bool ReadOnly { get; set; }

  /// <summary>Ali so pod polji vidni tehnicni kljuci registra. Privzeto ne (U3).</summary>
  bool ShowFieldKeys;

  /// <summary>Skupine, ki se izrisejo v natanko dveh stolpcih namesto v samodejni mrezi.</summary>
  [Parameter] public IReadOnlyList<string>? TwoColumnGroups { get; set; }
  [Parameter] public string DefaultGroup { get; set; } = "Polja kanala";

  /// <summary>Nepotrjene spremembe kartice; ključ je <see cref="ProductChannelField.FieldKey"/>.</summary>
  [Parameter] public IReadOnlyDictionary<string, string?> Drafts { get; set; } = new Dictionary<string, string?>();

  [Parameter] public EventCallback<(ProductChannelField Field, string? Value)> FieldChanged { get; set; }

  /// <summary>Shrani takoj, brez zgornjega gumba — uporabno, kadar je sprememba ena sama
  /// (uporabnik 2026-09-11). @onkeyup pride po @onchange (brskalnik odda "change" ob Enterju,
  /// preden pride "keyup"), zato je osnutek v Drafts že posodobljen, ko ta klic sprozi shranjevanje.</summary>
  [Parameter] public EventCallback EnterToSave { get; set; }

  string ControlId(ProductChannelField field) =>
    PanelId + "-" + new string(field.FieldKey.Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-').ToArray());

  string? Draft(ProductChannelField field)
  {
    if (Drafts.TryGetValue(field.FieldKey, out var value)) return value;
    // Izhodiscna vrednost pride kot "Da"/"Ne" (YesNo v kartici), vrednosti opcij spodaj pa so "da"/"ne" —
    // brez uskladitve select vedno pokaze prazno izbiro, ceprav vrednost obstaja.
    return field.Format == "bool" ? field.Value?.ToLowerInvariant() : field.Value;
  }

  static string Display(ProductChannelField field) =>
    !field.InReadModel ? "ni v bralnem modelu" : string.IsNullOrWhiteSpace(field.Value) ? "—" : field.Value;

  Task Change(ProductChannelField field, ChangeEventArgs args) =>
    FieldChanged.InvokeAsync((field, args.Value?.ToString()));

  Task EnterSaves(KeyboardEventArgs args) =>
    args.Key == "Enter" ? EnterToSave.InvokeAsync() : Task.CompletedTask;
}
