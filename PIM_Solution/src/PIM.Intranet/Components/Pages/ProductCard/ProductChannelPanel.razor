@namespace PIM.Intranet.Components.Pages.ProductCardParts
@using PIM.Intranet.Components.Pages.ProductCardParts

@* Obrazec enega kanala. Slog je v ProductChannelPanel.razor.css in ne sme biti v kartici:
   izoliran slog Blazorja velja samo za oznako svoje komponente, zato je bil obrazec prej brez
   sloga — pravila so bila zapisana pri kartici, oznaka pa je tu. *@

<section id="@PanelId" role="tabpanel" aria-labelledby="@TabId" tabindex="0"
         class="channel-panel" hidden="@Hidden">
  <header class="panel-head">
    <div class="panel-heading">
      <h2>@Title</h2>
      <PimChip Text="@StatusText" Tone="@StatusTone" />
    </div>
    @* Uporabnik 2026-09-28: števci so bili dvoumni. Zdaj ime pove posledico: napaka ustavi objavo,
       opozorilo ne; »preverjeno« je čas zadnje validacije, ne shranjevanja. *@
    <dl class="panel-meta">
      @* Števca štejeta polja NA TEM ZAVIHKU (2026-09-28): prej sta štela težave profila, polje pa je
         lahko stalo na drugem zavihku — glava je rekla »0 opozoril«, povzetek pod njo »2 prazni polji«. *@
      <div><dt>Ustavi objavo</dt><dd class="@(MissingRequired.Count > 0 ? "bad" : null)" title="Prazna polja na tem zavihku, zaradi katerih objava ne gre skozi">@MissingRequired.Count.ToString("N0")</dd></div>
      <div><dt>Priporočeno</dt><dd class="@(MissingRecommended.Count > 0 ? "warn" : null)" title="Prazna polja na tem zavihku, ki objave ne ustavijo">@MissingRecommended.Count.ToString("N0")</dd></div>
      <div><dt>Čaka SAOP</dt><dd class="@(PendingSaop.Count > 0 ? "info" : null)" title="Spremembe, ki v PIM že veljajo in čakajo odobritev ali potrditev SAOP">@PendingSaop.Count.ToString("N0")</dd></div>
      <div><dt>Preverjeno</dt><dd title="Čas zadnje validacije tega artikla">@PimFormat.Ago(LastValidatedUtc)</dd></div>
    </dl>
    <div class="panel-tools">
      @if (Toolbar is not null) { @Toolbar }
      @* U3, pregled 2026-09-08: pod vsakim poljem je stal tehnicni kljuc (ProductText.WEB_TITLE.sl,
         Product.WebPublish). Urednik ga ne potrebuje, razvijalec pa ga potrebuje takoj — zato ni
         izbrisan, ampak skrit za enim preklopom na panel. *@
      <label class="key-toggle">
        <input type="checkbox" checked="@ShowFieldKeys" @onchange="args => ShowFieldKeys = args.Value is bool on && on" />
        <span>Tehnični ključi</span>
      </label>
    </div>
  </header>

  <div class="panel-body">
    @* Uporabnik 2026-09-28: »obvestila so dvoumna, uporabniku ni s prve jasno, koliko je česa, kje in
       kaj manjka«. Zato najprej en povzetek z imeni polj, potem legenda poti — oboje iz istih polj,
       ki so spodaj, brez posebnega štetja. *@
    <div class="panel-summary" role="status">
      @if (MissingRequired.Count == 0 && MissingRecommended.Count == 0 && PendingSaop.Count == 0 && DraftCount == 0)
      {
        <p class="summary-line good"><span class="summary-mark" aria-hidden="true"></span>Vsa polja, ki jih zahteva validacija, so izpolnjena. Nič ne čaka na SAOP.</p>
      }
      @if (MissingRequired.Count > 0)
      {
        <p class="summary-line bad">
          <span class="summary-mark" aria-hidden="true"></span>
          <strong>@PimFormat.Count(MissingRequired.Count, "obvezno polje je prazno", "obvezni polji sta prazni", "obvezna polja so prazna", "obveznih polj je praznih")</strong>
          <span>— ustavi objavo: @string.Join(", ", MissingRequired.Select(row => row.Label))</span>
        </p>
      }
      @if (MissingRecommended.Count > 0)
      {
        <p class="summary-line warn">
          <span class="summary-mark" aria-hidden="true"></span>
          <strong>@PimFormat.Count(MissingRecommended.Count, "priporočeno polje je prazno", "priporočeni polji sta prazni", "priporočena polja so prazna", "priporočenih polj je praznih")</strong>
          <span>— objave ne ustavi: @string.Join(", ", MissingRecommended.Select(row => row.Label))</span>
        </p>
      }
      @if (PendingSaop.Count > 0)
      {
        <p class="summary-line info">
          <span class="summary-mark" aria-hidden="true"></span>
          <strong>@PimFormat.Count(PendingSaop.Count, "sprememba čaka SAOP", "spremembi čakata SAOP", "spremembe čakajo SAOP", "sprememb čaka SAOP")</strong>
          <span>— v PIM že veljajo: @string.Join(", ", PendingSaop.Select(row => row.Label)). <a href="saop">Izhod v SAOP</a></span>
        </p>
      }
      @if (DraftCount > 0)
      {
        <p class="summary-line draft">
          <span class="summary-mark" aria-hidden="true"></span>
          <strong>@PimFormat.Count(DraftCount, "neshranjena sprememba", "neshranjeni spremembi", "neshranjene spremembe", "neshranjenih sprememb")</strong>
          <span>na tem zavihku — shrani z gumbom »Shrani spremembe« zgoraj.</span>
        </p>
      }
    </div>

    @if (!ReadOnly && Routes.Count > 0)
    {
      <dl class="route-legend" aria-label="Kam gre sprememba polja">
        @foreach (var route in Routes)
        {
          <div><dt><span class="tag @RouteClass(route)">@RouteLabel(route)</span></dt><dd>@RouteExplain(route)</dd></div>
        }
      </dl>
    }

    @foreach (var group in Fields.GroupBy(row => row.Hint ?? DefaultGroup))
    {
      var missing = group.Count(row => row.Missing && (row.Required || row.Recommended));
      <section class="field-group @(TwoColumnGroups?.Contains(group.Key, StringComparer.Ordinal) == true ? "two-columns" : null)">
        <h3 class="group-title">
          @group.Key
          @if (missing > 0) { <span class="group-count">@PimFormat.Count(missing, "prazno polje", "prazni polji", "prazna polja", "praznih polj")</span> }
        </h3>
        <div class="field-grid">
          @foreach (var row in group)
          {
            var controlId = ControlId(row);
            var recommendedOnly = row.Recommended && !row.Required;
            var route = RouteOf(row);
            var dirty = Drafts.ContainsKey(row.FieldKey);
            @* 2026-09-29: @key po ključu polja in autocomplete="off" — brez njiju je vrednost ostala na mestu
               v DOM, ko se je seznam polj spremenil (jeziki, spletno mesto), in brskalnik je ob vrnitvi na stran
               obnovil vnose po vrstnem redu: angleški naziv se je prikazal pod »de«, slovenski pod »en«. *@
            <div @key="row.FieldKey" class="field @(row.Format == "multiline" ? "wide" : null) @(row.Required && row.Missing ? "needs-value" : null) @(recommendedOnly && row.Missing ? "should-have-value" : null) @(dirty ? "is-dirty" : null) @(route == FieldRoute.Locked ? "is-locked" : null)">
              <label for="@controlId">
                <span class="field-label">@row.Label</span>
                @* Značka sledi resnosti v validacijskem profilu: napaka ustavi objavo (obvezno),
                   opozorilo ne (priporočeno). Prej je bila vsaka težava »obvezno«. *@
                @if (row.Required) { <span class="tag tag-required" title="Napaka v validaciji — ustavi objavo">obvezno</span> }
                else if (recommendedOnly) { <span class="tag tag-recommended" title="Opozorilo v validaciji — objave ne ustavi">priporočeno</span> }
                <span class="tag @RouteClass(route)" title="@RouteExplain(route)">@RouteLabel(route)</span>
              </label>

              @* Uporabnik 2026-09-28: »dej vse v oblačke«. Tudi zaklenjeno polje je okence (onemogočeno),
                 da je kartica enotna; zakaj je zaklenjeno, pove opomba pod njim. *@
              @if (row.Format == "bool")
              {
                <select id="@controlId" class="field-input" autocomplete="off" disabled="@(!Editable(row))" aria-describedby="@($"{controlId}-note")"
                        value="@Draft(row)" @onchange="args => Change(row, args)">
                  <option value="">— ni določeno —</option>
                  <option value="da">Da</option>
                  <option value="ne">Ne</option>
                </select>
              }
              else if (row.Format == "multiline")
              {
                <textarea id="@controlId" class="field-input" rows="4" autocomplete="off" disabled="@(!Editable(row))" aria-describedby="@($"{controlId}-note")"
                          value="@Draft(row)" @onchange="args => Change(row, args)"></textarea>
              }
              else
              {
                <input id="@controlId" class="field-input" autocomplete="off" inputmode="@(row.Format == "decimal" ? "decimal" : null)"
                       disabled="@(!Editable(row))" aria-describedby="@($"{controlId}-note")"
                       value="@Draft(row)" @onchange="args => Change(row, args)"
                       @onkeyup="args => EnterSaves(args)" />
              }

              <p class="field-note" id="@($"{controlId}-note")">
                @if (ShowFieldKeys) { <span class="code-value">@row.FieldKey</span> }
                @if (dirty) { <span class="note-dirty">Spremenjeno, še ni shranjeno@(route == FieldRoute.Saop ? " — po shranjevanju velja v PIM, v SAOP gre po odobritvi" : "")</span> }
                @* 2026-09-23: čakajoča sprememba polja ne zaklene več — nova vrednost nadomesti staro
                   sporočilo (out.EnqueueMessage, Superseded); tu se samo pove, kje je. *@
                else if (row.Pending) { <span class="note-pending">@PendingText(row.PendingStatus)</span> }
                @if (row.Required && row.Missing && !dirty) { <span class="note-bad">Prazno — ustavi objavo</span> }
                else if (recommendedOnly && row.Missing && !dirty) { <span>Prazno — priporočeno, objave ne ustavi</span> }
                @if (route == FieldRoute.Locked && row.LockReason is not null) { <span>@row.LockReason</span> }
                @if (route == FieldRoute.PimOnlyFromSaop) { <span>SAOP tega polja ne sprejme: velja v PIM, ob naslednjem zajemu artikla ga SAOP lahko prepiše.</span> }
                @if (ReadOnly && route != FieldRoute.Locked) { <span>Tvoja vloga tega polja ne sme urejati.</span> }
              </p>
            </div>
          }
        </div>
      </section>
    }

    @if (ChildContent is not null) { @ChildContent }

    <section class="field-group">
      <h3 class="group-title">Odprte težave kanala</h3>
      <PimState Empty="@(Issues.Count == 0)" EmptyText="Kanal nima odprtih validacijskih težav.">
        <ul class="issue-list">
          @foreach (var row in Issues)
          {
            <li class="issue @(IsBlocking(row) ? "error" : "warning")">
              <span class="issue-mark" aria-hidden="true"></span>
              <div>
                <p class="issue-message">@row.Message</p>
                <p class="issue-meta">
                  <span class="code-value">@row.FieldCode</span>
                  <span>@row.ProfileCode</span>
                  <span>@IssueEffect(row)</span>
                  <span>@PimFormat.Ago(row.LastDetectedUtc)</span>
                </p>
              </div>
              @* 249: EAN, proizvajalec, dobavitelj so obvezni, a »skrbnik lahko potrdi, da artikel tega nima«
                 (sodelavka, Excel 11. 9.). Gumb vidi samo skrbnik in samo pri polju, ki ga baza dovoli potrditi. *@
              @if (CanWaive && Waivable(row.FieldCode) is { IsWaived: false } waivable)
              {
                <button type="button" class="ghost-button issue-waive" title="Potrditev velja, dokler je skrbnik ne prekliče; artikel se takoj ponovno validira."
                        @onclick="() => WaiverChanged.InvokeAsync((row.FieldCode, true))">@waivable.Label — potrdi</button>
              }
            </li>
          }
        </ul>
      </PimState>
    </section>

    @if (Waivers.Any(row => row.IsWaived))
    {
      <section class="field-group">
        <h3 class="group-title">Potrditve skrbnika</h3>
        <ul class="issue-list">
          @foreach (var row in Waivers.Where(row => row.IsWaived))
          {
            <li class="issue waived">
              <span class="issue-mark" aria-hidden="true"></span>
              <div>
                <p class="issue-message">@row.Label</p>
                <p class="issue-meta">
                  <span class="code-value">@row.FieldCode</span>
                  <span>potrdil @row.CreatedBy</span>
                  <span>@PimFormat.Ago(row.CreatedUtc)</span>
                  @if (!string.IsNullOrWhiteSpace(row.Reason)) { <span>@row.Reason</span> }
                </p>
              </div>
              @if (CanWaive)
              {
                <button type="button" class="ghost-button issue-waive" @onclick="() => WaiverChanged.InvokeAsync((row.FieldCode, false))">Prekliči</button>
              }
            </li>
          }
        </ul>
      </section>
    }
  </div>
</section>

@code {
  [Parameter, EditorRequired] public required string PanelId { get; set; }
  [Parameter, EditorRequired] public required string TabId { get; set; }
  [Parameter, EditorRequired] public required string Title { get; set; }
  [Parameter, EditorRequired] public required string StatusText { get; set; }
  [Parameter] public string? StatusTone { get; set; }
  [Parameter] public long BlockingCount { get; set; }
  [Parameter] public long WarningCount { get; set; }
  [Parameter] public DateTime? LastValidatedUtc { get; set; }
  [Parameter, EditorRequired] public required IReadOnlyList<ProductChannelField> Fields { get; set; }
  [Parameter, EditorRequired] public required IReadOnlyList<ProductCardIssue> Issues { get; set; }
  [Parameter] public bool Hidden { get; set; }
  [Parameter] public RenderFragment? Toolbar { get; set; }

  /// <summary>Potrdljiva polja (249) z morebitno veljavno potrditvijo skrbnika za ta artikel.</summary>
  [Parameter] public IReadOnlyList<ProductFieldWaiverRow> Waivers { get; set; } = [];

  /// <summary>Ali sme prijavljeni uporabnik potrjevati — samo skrbnik (politika <c>FieldWaiver</c>).</summary>
  [Parameter] public bool CanWaive { get; set; }

  /// <summary>(koda polja, potrdi/prekliči) — kartica zapiše potrditev in se znova naloži.</summary>
  [Parameter] public EventCallback<(string FieldCode, bool Active)> WaiverChanged { get; set; }

  ProductFieldWaiverRow? Waivable(string fieldCode) =>
    Waivers.FirstOrDefault(row => string.Equals(row.FieldCode, fieldCode, StringComparison.OrdinalIgnoreCase));

  /// <summary>
  /// Vloga brez pravice pisanja (A1, pregled 2026-09-08). Obrazec se takrat izrise kot vrednosti
  /// in ne kot vnosna polja; to je videz, prava varovalka je <c>PimWriteGuard</c> v servisu.
  /// </summary>
  [Parameter] public bool ReadOnly { get; set; }

  /// <summary>Ali so pod polji vidni tehnicni kljuci registra. Privzeto ne (U3).</summary>
  bool ShowFieldKeys;

  /// <summary>Skupine, ki se izrisejo v natanko dveh stolpcih namesto v samodejni mrezi.</summary>
  [Parameter] public IReadOnlyList<string>? TwoColumnGroups { get; set; }
  [Parameter] public string DefaultGroup { get; set; } = "Polja kanala";

  /// <summary>Nepotrjene spremembe kartice; ključ je <see cref="ProductChannelField.FieldKey"/>.</summary>
  [Parameter] public IReadOnlyDictionary<string, string?> Drafts { get; set; } = new Dictionary<string, string?>();

  [Parameter] public EventCallback<(ProductChannelField Field, string? Value)> FieldChanged { get; set; }

  /// <summary>Shrani takoj, brez zgornjega gumba — uporabno, kadar je sprememba ena sama
  /// (uporabnik 2026-09-11). @onkeyup pride po @onchange (brskalnik odda "change" ob Enterju,
  /// preden pride "keyup"), zato je osnutek v Drafts že posodobljen, ko ta klic sprozi shranjevanje.</summary>
  [Parameter] public EventCallback EnterToSave { get; set; }

  string ControlId(ProductChannelField field) =>
    PanelId + "-" + new string(field.FieldKey.Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-').ToArray());

  string? Draft(ProductChannelField field)
  {
    if (Drafts.TryGetValue(field.FieldKey, out var value)) return value;
    // Izhodiscna vrednost pride kot "Da"/"Ne" (YesNo v kartici), vrednosti opcij spodaj pa so "da"/"ne" —
    // brez uskladitve select vedno pokaze prazno izbiro, ceprav vrednost obstaja.
    return field.Format == "bool" ? field.Value?.ToLowerInvariant() : field.Value;
  }

  /// <summary>Dodatna vsebina pod polji (npr. urejanje kategorij, dodajanje atributa), pred težavami kanala.</summary>
  [Parameter] public RenderFragment? ChildContent { get; set; }

  /// <summary>
  /// Kam gre sprememba — kartica to izbere sama (uporabnik 2026-09-28: »program mora sam zaznati, ali gre
  /// za SAOP polje«). Pot je lastnost polja, ne izbira uporabnika; tu se samo poimenuje.
  /// </summary>
  enum FieldRoute { Saop, Pim, PimOnlyFromSaop, Locked }

  static FieldRoute RouteOf(ProductChannelField field) => field.Edit switch
  {
    ProductFieldEdit.Saop => FieldRoute.Saop,
    ProductFieldEdit.None => FieldRoute.Locked,
    _ => field.SaopOrigin ? FieldRoute.PimOnlyFromSaop : FieldRoute.Pim,
  };

  static string RouteLabel(FieldRoute route) => route switch
  {
    FieldRoute.Saop => "PIM + SAOP",
    FieldRoute.Pim => "PIM",
    FieldRoute.PimOnlyFromSaop => "samo PIM",
    _ => "zaklenjeno",
  };

  static string RouteClass(FieldRoute route) => route switch
  {
    FieldRoute.Saop => "tag-saop",
    FieldRoute.Pim => "tag-pim",
    FieldRoute.PimOnlyFromSaop => "tag-local",
    _ => "tag-locked",
  };

  static string RouteExplain(FieldRoute route) => route switch
  {
    FieldRoute.Saop => "velja v PIM takoj, v SAOP gre po odobritvi na strani Izhod v SAOP",
    FieldRoute.Pim => "podatek PIM-a, velja takoj",
    FieldRoute.PimOnlyFromSaop => "pride iz SAOP, SAOP pa ga od PIM ne sprejme — velja v PIM, zajem ga lahko prepiše",
    _ => "ni mogoče urediti tu; opomba pod poljem pove zakaj",
  };

  bool Editable(ProductChannelField field) => !ReadOnly && field.Edit != ProductFieldEdit.None;

  static string PendingText(string? status) => status switch
  {
    "PendingApproval" => "V PIM velja; čaka odobritev za SAOP",
    "Pending" or "Retry" => "V PIM velja; odobreno, čaka pošiljanje v SAOP",
    "Sending" or "Sent" => "V PIM velja; poslano v SAOP, čaka potrditev",
    _ => "V PIM velja; na poti v SAOP",
  };

  IReadOnlyList<ProductChannelField> MissingRequired => Fields.Where(row => row.Required && row.Missing && !Drafts.ContainsKey(row.FieldKey)).ToList();
  IReadOnlyList<ProductChannelField> MissingRecommended => Fields.Where(row => row.Recommended && !row.Required && row.Missing && !Drafts.ContainsKey(row.FieldKey)).ToList();
  IReadOnlyList<ProductChannelField> PendingSaop => Fields.Where(row => row.Pending).ToList();
  int DraftCount => Fields.Count(row => Drafts.ContainsKey(row.FieldKey));

  /// <summary>Legenda samo s potmi, ki jih ta zavihek res ima — da ne razlaga česa, česar ni.</summary>
  IReadOnlyList<FieldRoute> Routes => Fields.Select(RouteOf).Distinct().OrderBy(route => route).ToList();

  Task Change(ProductChannelField field, ChangeEventArgs args) =>
    FieldChanged.InvokeAsync((field, args.Value?.ToString()));

  Task EnterSaves(KeyboardEventArgs args) =>
    args.Key == "Enter" ? EnterToSave.InvokeAsync() : Task.CompletedTask;

  // Pregled 2026-09-22: napaka profila, ki ne ustavi nicesar (COMMERCIAL_L2), je bila tu »blokira«.
  // Blokira samo napaka v profilu, ki ustavi ERP ali splet; ostalo je manjkajoc podatek ali opozorilo.
  static bool IsBlocking(ProductCardIssue row) => row.Severity == "ERROR" && (row.BlocksErp || row.BlocksWeb);

  static string IssueEffect(ProductCardIssue row) =>
    IsBlocking(row) ? "ustavi objavo" : row.Severity == "ERROR" ? "manjka (objave ne ustavi)" : "opozorilo";
}

