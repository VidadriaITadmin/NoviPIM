@page "/kakovost/kategorije"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.CategoryMappingService Mapping
@inject PIM.Intranet.Services.CategoryTreeService TreeService
@inject AuthenticationStateProvider Authentication

@* Delovni seznam in urejanje v enem. Do migracije 109 je bila ta stran samo seznam poti brez
   cilja — pokazala je nalogo in je ni znala rešiti. Zdaj je vsaka vrstica urejiva na mestu,
   ker je preslikava en sam podatek in ne zasluži svojega zaslona. *@

<PageTitle>Preslikave kategorij</PageTitle>
<PimPage Title="Preslikave kategorij"
         Subtitle="Kaj je poslal dobavitelj in kam to gre v našem drevesu. Dokler pot nima cilja, izdelek na spletu nima uvrstitve. Seznam je skupen vsem podjetjem, ker je drevo dobaviteljevo — preslikava, ki jo narediš tu, velja povsod."
         Crumbs="Crumbs" />

<PimTabs Active="mapiranje" Tabs="QualityTabs.Tabs" Label="Pogledi kakovosti" />

@if (Message is not null) { <p class="message-state" role="status">@Message</p> }
@if (Error is not null) { <p class="message-state error-message" role="alert">@Error</p> }

<section class="ui-card toolbar" role="search" aria-labelledby="mapping-filter-title">
  <h2 id="mapping-filter-title" class="visually-hidden">Filtriranje preslikav</h2>

  <label class="visually-hidden" for="mapping-source">Vir</label>
  <select id="mapping-source" class="filter-select" @bind="Source" @bind:after="ResetAndLoadAsync">
    <option value="">Vsi viri</option>
    @foreach (var source in Sources) { <option value="@source">@source</option> }
  </select>

  <label class="visually-hidden" for="mapping-tree">Drevo</label>
  <select id="mapping-tree" class="filter-select" @bind="Tree" @bind:after="ResetAndLoadAsync">
    <option value="">Vsa drevesa</option>
    @foreach (var tree in Trees) { <option value="@tree">@tree</option> }
  </select>

  <label class="visually-hidden" for="mapping-state">Stanje</label>
  <select id="mapping-state" class="filter-select" @bind="State" @bind:after="ResetAndLoadAsync">
    <option value="">Vsa stanja</option>
    <option value="Nepreslikano">Nepreslikano</option>
    <option value="Preslikano">Preslikano</option>
    <option value="Ugasnjeno">Ugasnjeno</option>
  </select>

  <label class="visually-hidden" for="mapping-search">Iskanje</label>
  <input id="mapping-search" class="form-input" type="search" placeholder="Išči po poti ali kategoriji"
         @bind="Search" @bind:after="ResetAndLoadAsync" />

  <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>
</section>

@* #34: paketna preslikava — izbrane poti (ali vse po filtru) naenkrat v isto kategorijo. Skupni gradnik
   PimBulkBar + PimRowSelection; zapis je ena transakcija v servisu (vse ali nič) z vrstico zgodovine na pot. *@
@if (CanWrite)
{
  <PimBulkBar Count="Selection.Count" AllMatching="Selection.AllMatching" MatchingTotal="Selection.MatchingTotal"
              PageSelected="PageFullySelected" PageRowCount="Rows.Count"
              OnPageChanged="SelectPage" OnSelectAllMatching="SelectAllMatching" OnClear="ClearSelection"
              AriaLabel="Izbira poti in paketna preslikava" Hint="Označi poti, ki jih želiš preslikati v isto kategorijo.">
    <button type="button" class="primary-button" disabled="@(Busy || BulkBusy)" @onclick="OpenBulkAsync">Preslikaj v kategorijo …</button>
  </PimBulkBar>
}
else if (!Loading)
{
  <p class="message-state read-only-note" role="status">Samo za branje — preslikave kategorij spreminjajo uvrstitev izdelkov na spletu, zato jih urejata urednik kataloga in skrbnik.</p>
}

@if (CanWrite && BulkOpen)
{
  <section class="ui-card bulk-map section-gap" aria-labelledby="bulk-map-title">
    <div class="bulk-map-head">
      <h2 id="bulk-map-title">Paketna preslikava — @BulkScopeLabel</h2>
      <button type="button" class="small-action" data-pim-close disabled="@BulkBusy" @onclick="CloseBulk">Zapri</button>
    </div>

    @if (BulkError is not null) { <p class="message-state error-message" role="alert">@BulkError</p> }

    @if (BulkRows.Count > 0 && BulkTree is not null)
    {
      <p class="muted">
        Drevo <strong>@BulkTree</strong> · @PathCount(BulkRows.Count) ·
        @BulkRows.Sum(row => row.ProductCount).ToString("N0") izdelkov za njimi
        @if (BulkAlreadyMapped > 0)
        {
          <text> · že preslikanih @BulkAlreadyMapped.ToString("N0") — dobijo novo kategorijo</text>
        }
      </p>

      @if (!BulkConfirming)
      {
        <div class="form-grid">
          <label class="form-field" for="bulk-category">
            Ciljna kategorija
            <PimPicker Id="bulk-category" Options="CategoryOptionsFor(BulkTree)" @bind-Value="BulkCategoryOrNull"
                       Placeholder="Vpiši del imena ali poti kategorije …" EmptyText="V tem drevesu ni kategorij." />
          </label>
          <label class="form-field" for="bulk-note">
            Opomba (neobvezno, gre v zgodovino vsake poti)
            <input id="bulk-note" class="form-input" @bind="BulkNote" disabled="@BulkBusy" />
          </label>
        </div>
        <div class="page-actions">
          <button type="button" class="primary-button" disabled="@(BulkBusy || string.IsNullOrWhiteSpace(BulkCategory))" @onclick="() => BulkConfirming = true">
            Naprej: preslikaj @PathCount(BulkRows.Count)
          </button>
          <button type="button" class="small-action" disabled="@BulkBusy" @onclick="CloseBulk">Prekliči</button>
        </div>
      }
      else
      {
        <div class="bulk-confirm" role="alertdialog" aria-labelledby="bulk-confirm-text">
          <p id="bulk-confirm-text"><strong>Preslikati @PathCount(BulkRows.Count) v »@BulkCategoryLabel«?</strong></p>
          <p class="muted">Vse ali nič: če baza zavrne eno pot, se ne zapiše nobena. Vsaka pot dobi svojo vrstico v zgodovini (kdo, kdaj, prejšnja kategorija). Izdelki dobijo novo uvrstitev ob naslednji preslikavi vira.</p>
          <div class="page-actions">
            <button type="button" class="primary-button" disabled="@BulkBusy" @onclick="SaveBulkAsync">
              @(BulkBusy ? "Preslikujem …" : "Da, preslikaj " + PathCount(BulkRows.Count))
            </button>
            <button type="button" class="small-action" disabled="@BulkBusy" @onclick="() => BulkConfirming = false">Nazaj</button>
          </div>
        </div>
      }
    }
    else if (BulkBusy)
    {
      <p class="muted" role="status">Zbiram izbrane poti …</p>
    }
  </section>
}

<section class="ui-card data-card section-gap" aria-label="Preslikave kategorij">
  <PimState Loading="Loading" Error="@Error" Empty="@(Rows.Count == 0)"
            EmptyText="Za te filtre ni nobene poti." LoadingText="Nalaganje preslikav …">
    <PimTable Caption="Poti iz virov, razvrščene po številu izdelkov za njimi" Columns="@(CanWrite ? SelectColumns : Columns)">
      <Rows>
        @foreach (var row in Rows)
        {
          var key = RowKey(row);
          <tr class="@(CanWrite && Selection.Contains(key) ? "is-selected" : null)">
            @if (CanWrite)
            {
              <td class="select-cell">
                <input type="checkbox" aria-label="@($"Izberi pot {Describe(row)} ({row.SourceCode}, drevo {row.CategoryTreeCode})")"
                       checked="@Selection.Contains(key)" @onchange="e => Toggle(row, e)" />
              </td>
            }
            <td><span class="code-value">@row.SourceCode</span></td>
            <td class="tree-path">
              @Describe(row)
              <div class="row-note code-value">@row.SourcePathKey</div>
            </td>
            <td class="numeric">@row.ProductCount.ToString("N0")</td>
            <td>
              <PimChip Text="@row.State" Tone="@StateTone(row.State)" />
              @if (row.UpdatedBy is not null)
              {
                <div class="row-note">@row.UpdatedBy · @(row.UpdatedUtc?.ToPimLocal().ToString("g"))</div>
              }
            </td>
            <td>
              @if (Editing == key)
              {
                <div class="form-grid">
                  <label class="form-field" for="@($"cat-{key}")">
                    Ciljna kategorija
                    @* Izbirnik s tipkanjem (PimPicker): isce po imenu in celotni poti, pokaze drevo z zamikom. *@
                    <PimPicker Id="@($"cat-{key}")" Options="CategoryOptionsFor(row.CategoryTreeCode)" @bind-Value="ChosenCategoryOrNull"
                               Placeholder="Vpiši del imena ali poti kategorije …" EmptyText="V tem drevesu ni kategorij."
                               AllowCreate="true" CreateLabel="Ustvari novo kategorijo" OnCreate="name => BeginCreate(name)" />
                    @if (CreatingName is not null)
                    {
                      @* 178: nova kategorija nastane tu, pod izbranim starsem; izbirnik je ze opozoril na enako ali podobno ime. *@
                      <div class="create-panel" role="region" aria-label="Nova kategorija">
                        <p>Nova kategorija <strong>»@CreatingName«</strong> v drevesu <strong>@row.CategoryTreeCode</strong>. Izberi nadrejeno kategorijo (prazno = koren drevesa).</p>
                        <PimPicker Id="@($"parent-{key}")" Options="CategoryOptionsFor(row.CategoryTreeCode)" @bind-Value="CreateParent"
                                   Placeholder="Nadrejena kategorija (prazno = koren) …" />
                        @if (SiblingDuplicate(row.CategoryTreeCode) is { } duplicate)
                        {
                          <p class="create-warning">Pod to nadrejeno kategorijo že obstaja »@duplicate.CategoryName« — izberi jo namesto ustvarjanja.</p>
                        }
                        <div class="page-actions">
                          <button type="button" class="button-primary" disabled="@(Busy || SiblingDuplicate(row.CategoryTreeCode) is not null)" @onclick="() => CreateCategoryAsync(row.CategoryTreeCode)">Ustvari in izberi</button>
                          <button type="button" disabled="@Busy" @onclick="() => CreatingName = null">Prekliči</button>
                        </div>
                      </div>
                    }
                  </label>
                  <label class="form-field" for="@($"note-{key}")">
                    Opomba (neobvezno)
                    <input id="@($"note-{key}")" class="form-input" @bind="Note" />
                  </label>
                </div>
                <div class="page-actions">
                  <button type="button" class="button-primary" disabled="@Busy"
                          @onclick="() => SaveAsync(row)">Shrani</button>
                  <button type="button" disabled="@Busy" @onclick="CancelEdit">Prekliči</button>
                  @if (row.State == "Preslikano")
                  {
                    <button type="button" disabled="@Busy" @onclick="() => DeactivateAsync(row)">Ugasni preslikavo</button>
                  }
                </div>
              }
              else
              {
                <div>@(row.CategoryPath ?? "—")</div>
                @if (CanWrite)
                {
                  <button type="button" @onclick="() => BeginEditAsync(row)">
                    @(row.State == "Nepreslikano" ? "Preslikaj" : "Uredi")
                  </button>
                }
              }
            </td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

<PimPager Skip="Skip" Take="PageSize" Total="Total" SkipChanged="OnSkipAsync" />

@code {
  IReadOnlyList<PIM.Intranet.Services.CategoryMappingService.MappingRow> Rows = [];
  IReadOnlyList<string> Sources = [];
  IReadOnlyList<string> Trees = [];
  readonly Dictionary<string, IReadOnlyList<PIM.Intranet.Services.CategoryMappingService.TreeNode>> NodeCache = [];

  bool Loading = true;
  bool Busy;
  string? Error;
  string? Message;
  string Source = "";
  string Tree = "";
  string State = "Nepreslikano";
  string Search = "";
  string? Editing;
  string ChosenCategory = "";
  string Note = "";
  int Skip;
  long Total;
  const int PageSize = 50;

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Kakovost", "kakovost"), new("Preslikave kategorij")];
  static readonly IReadOnlyList<PimColumn> Columns =
  [
    new("Vir"), new("Pot iz vira"), new("Izdelkov", Numeric: true), new("Stanje"), new("Naša kategorija")
  ];
  static readonly IReadOnlyList<PimColumn> SelectColumns = [new("Izbira"), .. Columns];

  string ResultSummary => Loading ? "Nalaganje …"
    : Error is not null ? "Rezultati niso na voljo"
    : $"{Total:N0} poti";

  static string RowKey(PIM.Intranet.Services.CategoryMappingService.MappingRow row) =>
    $"{row.SourceCode}|{row.CategoryTreeCode}|{row.SourcePathKey}";

  static string StateTone(string state) => state switch
  {
    "Preslikano" => "good",
    "Ugasnjeno" => "warn",
    _ => "bad"
  };

  // Ravni vira so berljive same po sebi; ključ poti je pod njimi, ker ga potrebuje samo tisti,
  // ki gleda v bazo.
  static string Describe(PIM.Intranet.Services.CategoryMappingService.MappingRow row) =>
    string.Join(" › ", new[] { row.SourceLevel1, row.SourceLevel2, row.SourceLevel3 }
      .Where(part => !string.IsNullOrWhiteSpace(part)));

  protected override async Task OnInitializedAsync()
  {
    try
    {
      CanWrite = await Mapping.CanWriteAsync();
      Sources = await Mapping.GetSourceCodesAsync();
      Trees = await Mapping.GetTreeCodesAsync();
    }
    catch (Exception exception) { Error = exception.Message; }
    await LoadAsync();
  }

  async Task LoadAsync()
  {
    Loading = true;
    Error = null;
    try
    {
      var page = Skip / PageSize + 1;
      var result = await Mapping.GetMappingsAsync(Source, Tree, State, Search, page, PageSize);
      Rows = result.Rows;
      Total = result.Total;
      Selection.UpdateFilter(FilterSignature, Total);
    }
    catch (Exception exception) { Error = exception.Message; Rows = []; Total = 0; }
    finally { Loading = false; }
  }

  Task ResetAndLoadAsync()
  {
    Skip = 0;
    Editing = null;
    return LoadAsync();
  }

  Task OnSkipAsync(int skip)
  {
    Skip = skip;
    Editing = null;
    return LoadAsync();
  }

  async Task BeginEditAsync(PIM.Intranet.Services.CategoryMappingService.MappingRow row)
  {
    Message = null;
    Error = null;
    Editing = RowKey(row);
    ChosenCategory = row.CategoryCode ?? "";
    Note = "";
    // Drevo naložimo enkrat na sejo: izbirnik ima do nekaj sto vozlišč in vsak klik nanj bi
    // sicer pomenil svoj obisk baze.
    if (!NodeCache.ContainsKey(row.CategoryTreeCode))
    {
      try { NodeCache[row.CategoryTreeCode] = await Mapping.GetTreeNodesAsync(row.CategoryTreeCode, null); }
      catch (Exception exception) { Error = exception.Message; NodeCache[row.CategoryTreeCode] = []; }
    }
  }

  string? ChosenCategoryOrNull { get => string.IsNullOrWhiteSpace(ChosenCategory) ? null : ChosenCategory; set => ChosenCategory = value ?? ""; }

  // 178: ustvarjanje kategorije iz izbirnika.
  string? CreatingName;
  string? CreateParent;

  void BeginCreate(string name) { CreatingName = name; CreateParent = null; }

  /// <summary>Isto ime (brez sumnikov, velikosti crk) pod izbranim starsem — postopek bi zavrnil, stran to pove prej.</summary>
  PIM.Intranet.Services.CategoryMappingService.TreeNode? SiblingDuplicate(string tree) =>
    CreatingName is null ? null
    : NodesFor(tree).FirstOrDefault(node => string.Equals(node.ParentCategoryCode ?? "", CreateParent ?? "", StringComparison.OrdinalIgnoreCase)
        && PIM.Intranet.Services.PimText.SameName(node.CategoryName, CreatingName));

  async Task CreateCategoryAsync(string tree)
  {
    if (string.IsNullOrWhiteSpace(CreatingName)) return;
    Busy = true;
    Error = null;
    try
    {
      var code = await TreeService.CreateCategoryAsync(tree, CreateParent, CreatingName, await ActorAsync());
      NodeCache.Remove(tree);
      PickerCache.Remove(tree);
      try { NodeCache[tree] = await Mapping.GetTreeNodesAsync(tree, null); }
      catch (Exception exception) { Error = exception.Message; NodeCache[tree] = []; }
      ChosenCategory = code;
      Message = $"Kategorija »{CreatingName}« je ustvarjena ({code}) in izbrana. Shrani preslikavo.";
      CreatingName = null;
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  readonly Dictionary<string, IReadOnlyList<PimPickerOption>> PickerCache = new(StringComparer.OrdinalIgnoreCase);

  /// <summary>Moznosti izbirnika: ime, celotna pot in zamik po ravni; predpomnjeno na drevo, ker se izrise ob vsakem tipkanju.</summary>
  IReadOnlyList<PimPickerOption> CategoryOptionsFor(string tree)
  {
    if (!PickerCache.TryGetValue(tree, out var options))
    {
      options = NodesFor(tree)
        .Select(node => new PimPickerOption(node.CategoryCode, node.CategoryName, node.CategoryPath, node.LevelNo - 1))
        .ToList();
      PickerCache[tree] = options;
    }
    return options;
  }

  IReadOnlyList<PIM.Intranet.Services.CategoryMappingService.TreeNode> NodesFor(string tree) =>
    NodeCache.TryGetValue(tree, out var nodes) ? nodes : [];

  void CancelEdit()
  {
    Editing = null;
    ChosenCategory = "";
    Note = "";
  }

  async Task SaveAsync(PIM.Intranet.Services.CategoryMappingService.MappingRow row)
  {
    if (string.IsNullOrWhiteSpace(ChosenCategory))
    {
      Error = "Izberi ciljno kategorijo.";
      return;
    }
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      var outcome = await Mapping.SaveMappingAsync(
        row.SourceCode, row.CategoryTreeCode, row.SourcePathKey, ChosenCategory, await ActorAsync(), NoteOrNull());
      Message = outcome switch
      {
        "Created" => $"Preslikava je zapisana. Velja za {row.ProductCount:N0} izdelkov ob naslednji preslikavi vira.",
        "Updated" => $"Preslikava je spremenjena. Velja za {row.ProductCount:N0} izdelkov ob naslednji preslikavi vira.",
        _ => "Preslikava je bila že takšna; nič se ni spremenilo."
      };
      CancelEdit();
      await LoadAsync();
    }
    // Postopek v bazi zavrne neobstoječo kategorijo (106003) in kategorijo brez prevedene poti
    // (106004). Sporočilo pokažemo takšno, kot ga je povedala baza — tam je pravilo, ne tukaj.
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  async Task DeactivateAsync(PIM.Intranet.Services.CategoryMappingService.MappingRow row)
  {
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      var outcome = await Mapping.DeactivateMappingAsync(
        row.SourceCode, row.CategoryTreeCode, row.SourcePathKey, await ActorAsync(), NoteOrNull());
      Message = outcome == "Deactivated"
        ? "Preslikava je ugasnjena. Vrstica ostane, da se vidi, da je bila odločitev sprejeta in preklicana."
        : "Preslikava je bila že ugasnjena.";
      CancelEdit();
      await LoadAsync();
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  string? NoteOrNull() => string.IsNullOrWhiteSpace(Note) ? null : Note;

  /* --- #34: izbira vrstic in paketna preslikava ------------------------------------------------ */

  const int MaxBulk = PIM.Intranet.Services.CategoryMappingService.MaxBulkPaths;
  bool CanWrite;
  readonly PimRowSelection<PIM.Intranet.Services.CategoryMappingService.MappingRow> Selection = new();

  string FilterSignature => $"{Source}|{Tree}|{State}|{Search}";
  IEnumerable<KeyValuePair<string, PIM.Intranet.Services.CategoryMappingService.MappingRow>> PageRows =>
    Rows.Select(row => new KeyValuePair<string, PIM.Intranet.Services.CategoryMappingService.MappingRow>(RowKey(row), row));
  bool PageFullySelected => Selection.AllSelected(Rows.Select(RowKey));
  void SelectPage(bool selected) => Selection.SetPage(PageRows, selected);
  void SelectAllMatching() => Selection.SelectAllMatching();
  void ClearSelection() => Selection.Clear();
  void Toggle(PIM.Intranet.Services.CategoryMappingService.MappingRow row, ChangeEventArgs args) =>
    Selection.Toggle(RowKey(row), row, args.Value is true, PageRows);

  static string PathCount(long count) => PimFormat.Count(count, "pot", "poti", "poti", "poti");

  bool BulkOpen;
  bool BulkBusy;
  bool BulkConfirming;
  string? BulkError;
  string? BulkTree;
  string BulkCategory = "";
  string BulkNote = "";
  IReadOnlyList<PIM.Intranet.Services.CategoryMappingService.MappingRow> BulkRows = [];

  string? BulkCategoryOrNull { get => string.IsNullOrWhiteSpace(BulkCategory) ? null : BulkCategory; set { BulkCategory = value ?? ""; BulkConfirming = false; } }
  int BulkAlreadyMapped => BulkRows.Count(row => row.CategoryCode is not null);
  string BulkScopeLabel => Selection.AllMatching
    ? $"vse poti, ki ustrezajo filtru ({Selection.Count:N0})"
    : PimFormat.Count(Selection.Count, "izbrana pot", "izbrani poti", "izbrane poti", "izbranih poti");
  string BulkCategoryLabel => BulkTree is not null
    && NodesFor(BulkTree).FirstOrDefault(node => node.CategoryCode == BulkCategory) is { } node
      ? node.CategoryPath ?? node.CategoryName
      : BulkCategory;

  /// <summary>Zbere izbrane poti: posamezne iz izbire, »vse po filtru« znova s strežnika (en klic, največ 500).
  /// Poti morajo biti iz enega drevesa, ker kategorija velja samo v svojem drevesu.</summary>
  async Task OpenBulkAsync()
  {
    BulkOpen = true;
    BulkBusy = true;
    BulkConfirming = false;
    BulkError = null;
    BulkRows = [];
    BulkTree = null;
    BulkCategory = "";
    BulkNote = "";
    Message = null;
    try
    {
      IReadOnlyList<PIM.Intranet.Services.CategoryMappingService.MappingRow> rows;
      if (Selection.AllMatching)
      {
        if (Selection.MatchingTotal > MaxBulk)
          throw new InvalidOperationException($"Filtru ustreza {Selection.MatchingTotal:N0} poti; naenkrat jih lahko preslikaš največ {MaxBulk:N0}. Zoži filter (vir, drevo ali iskanje).");
        rows = (await Mapping.GetMappingsAsync(Source, Tree, State, Search, 1, MaxBulk)).Rows;
      }
      else
      {
        rows = Selection.Items.ToList();
        if (rows.Count > MaxBulk)
          throw new InvalidOperationException($"Izbranih je {rows.Count:N0} poti; naenkrat jih lahko preslikaš največ {MaxBulk:N0}.");
      }
      if (rows.Count == 0) throw new InvalidOperationException("Ni izbrane nobene poti.");
      var trees = rows.Select(row => row.CategoryTreeCode).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
      if (trees.Count > 1)
        throw new InvalidOperationException($"Izbrane poti so iz več dreves ({string.Join(", ", trees)}). Kategorija velja samo v svojem drevesu — v filtru izberi drevo in označi znova.");
      BulkTree = trees[0];
      if (!NodeCache.ContainsKey(BulkTree)) NodeCache[BulkTree] = await Mapping.GetTreeNodesAsync(BulkTree, null);
      BulkRows = rows;
    }
    catch (Exception exception) { BulkError = exception.Message; }
    finally { BulkBusy = false; }
  }

  void CloseBulk()
  {
    BulkOpen = false;
    BulkConfirming = false;
    BulkError = null;
    BulkRows = [];
  }

  async Task SaveBulkAsync()
  {
    if (BulkTree is null || BulkRows.Count == 0 || string.IsNullOrWhiteSpace(BulkCategory)) return;
    BulkBusy = true;
    BulkError = null;
    Message = null;
    try
    {
      var label = BulkCategoryLabel;
      var products = BulkRows.Sum(row => row.ProductCount);
      var outcome = await Mapping.SaveMappingsAsync(
        BulkRows.Select(row => new PIM.Intranet.Services.CategoryMappingService.PathKey(row.SourceCode, row.CategoryTreeCode, row.SourcePathKey)).ToList(),
        BulkTree, BulkCategory, await ActorAsync(), string.IsNullOrWhiteSpace(BulkNote) ? null : BulkNote);
      Message = $"Preslikanih {PathCount(outcome.Total)} v »{label}«: novih {outcome.Created:N0}, spremenjenih {outcome.Updated:N0}, že takšnih {outcome.Unchanged:N0}. "
        + $"Velja za {products:N0} izdelkov ob naslednji preslikavi vira.";
      Selection.Clear();
      CloseBulk();
      await LoadAsync();
    }
    // Baza zavrne neobstoječo kategorijo (106003) ali kategorijo brez prevoda (106004) — takrat se ne zapiše nič.
    catch (Exception exception) { BulkError = exception.Message + " Nobena pot ni bila spremenjena."; BulkConfirming = false; }
    finally { BulkBusy = false; }
  }

  async Task<string> ActorAsync()
  {
    var state = await Authentication.GetAuthenticationStateAsync();
    return state.User.Identity?.Name ?? "neznan";
  }
}
