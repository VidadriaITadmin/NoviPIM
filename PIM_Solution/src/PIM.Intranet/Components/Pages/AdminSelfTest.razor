@page "/sistem/samotest"
@attribute [Authorize(Roles = "ADMIN")]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.AdminConsoleService Nadzor
@inject AuthenticationStateProvider Authentication

@*
  Zgodovina nočnega samotesta.

  En zagon pove, ali je sistem nocoj deloval. Šele zaporedje zagonov pove, ali se stanje
  slabša — in prav to je vprašanje, na katero doslej ni bilo mogoče odgovoriti: vsak kos je
  imel svoj zeleni test, celota pa nobenega.

  Trajanje je tu enakovredno izidu. Test, ki je še vedno PASS, a traja trikrat dlje kot pred
  mesecem, je opozorilo, ki ga status sam ne pove.

  Prenova 2026-09-10: koraki zadnjega zagona (prej "oblacki" na /sistem) so se preselili sem —
  na pregledni strani so bili predolg seznam, tu pa so natanko to, kar uporabnik pride iskat.

  Prenova 2026-09-26: razlaga je v zložljivi pomoči, zgodovina ima hitre izbore po izidu s števci
  (?izid= v naslovu) in pove, ali se trajanje daljša (zadnji zagon proti mediani zadnjih uspešnih).
*@

<PageTitle>Nočni samotest</PageTitle>
<PimPage Title="Nočni samotest" Subtitle="Ali je celota delovala vsako noč, kje se je ustavila in koliko časa je potrebovala.">
  <Actions>
    <button type="button" class="secondary-button" disabled="@Loading" @onclick="NaloziAsync">@(Loading ? "Berem …" : "Osveži")</button>
  </Actions>
</PimPage>

<PimTabs Active="samotest" Tabs="NadzorTabs.Tabs" Label="Pogledi nadzora" />

<details class="page-help">
  <summary>Kako deluje</summary>
  <p>
    Samotest samo bere in sestavi eno začasno datoteko; ne kliče SAOP-a, ne pošilja ničesar in ne spreminja podatkov.
    Zaganja ga načrtovano opravilo <span class="code-value">PIM samotest</span>; ročno ga poženeš z
    <span class="code-value">dotnet run --project tests\PIM.SelfTest.Nightly</span>. Časi so v naši uri (@PimTime.ZoneLabel).
  </p>
</details>

@if (!Loading && Error is null && Rows.Count > 0)
{
  var zadnji = Rows[0];
  <section class="ui-card selftest-last @Ton(zadnji.Status)" aria-labelledby="zadnji-naslov">
    <div>
      <h2 id="zadnji-naslov">Zadnji zagon: @Oznaka(zadnji.Status)</h2>
      <p>
        @PimTime.FormatWithAge(zadnji.StartedUtc) · @zadnji.StepsPassed.ToString("N0") / @zadnji.StepsTotal.ToString("N0") korakov uspelo
        · trajal @PimTime.Duration(zadnji.DurationMs)@(TrajanjeOpomba is { } opomba ? $" ({opomba})" : "")
      </p>
    </div>
    <PimChip Text="@Oznaka(zadnji.Status)" Tone="@Ton(zadnji.Status)" />
  </section>
}

@if (Steps.Count > 0)
{
  <section class="ui-card data-card section-gap" aria-labelledby="koraki-naslov">
    <div class="panel-title"><h2 id="koraki-naslov">Koraki zadnjega zagona</h2></div>
    <PimTable Caption="Koraki zadnjega samotesta z izmerjenim trajanjem" Columns="StolpciKorakov">
      <Rows>
        @foreach (var korak in Steps)
        {
          <tr class="@(korak.Status == "Failed" ? "row-alarm" : null)">
            <td class="numeric">@korak.Ordinal</td>
            <td><span class="code-value">@korak.StepCode</span></td>
            <td>@korak.Label</td>
            <td><PimChip Text="@Oznaka(korak.Status)" Tone="@Ton(korak.Status)" /></td>
            <td class="numeric">@PimTime.Duration(korak.DurationMs)</td>
            <td class="numeric">@Meritev(korak)</td>
            <td>@(korak.DetailRedacted ?? "—")</td>
          </tr>
        }
      </Rows>
    </PimTable>
  </section>
}

<section class="ui-card data-card section-gap" aria-labelledby="zgodovina-naslov">
  <div class="panel-title selftest-head">
    <h2 id="zgodovina-naslov">Zgodovina zagonov</h2>
  </div>
  <div class="selftest-segments">
    <PimSegments Segments="Izbori" Label="Zagoni po izidu" Loading="Loading" Summary="@Povzetek" />
  </div>
  <PimState Loading="Loading" Error="@Error" Empty="@(Prikazani.Count == 0)"
            EmptyText="@(Rows.Count == 0 ? "Samotest se še ni izvedel. Prvi zagon izvede načrtovano opravilo ponoči." : "V izbranem izidu ni zagonov. Izberi »Vsi«.")"
            LoadingText="Berem zgodovino samotestov …">
    <PimTable Caption="Zagoni samotesta: izid, koraki in trajanje" Columns="Stolpci">
      <Rows>
        @foreach (var zagon in Prikazani)
        {
          <tr class="@(zagon.Status is "Failed" or "Abandoned" ? "row-alarm" : null)">
            <td class="nowrap">@PimTime.FormatExact(zagon.StartedUtc)</td>
            <td><span class="code-value">@zagon.TestCode</span></td>
            <td><PimChip Text="@Oznaka(zagon.Status)" Tone="@Ton(zagon.Status)" /></td>
            <td class="numeric">@zagon.StepsPassed.ToString("N0") / @zagon.StepsTotal.ToString("N0")</td>
            <td class="numeric">@zagon.StepsFailed.ToString("N0")</td>
            <td class="numeric">@zagon.StepsSkipped.ToString("N0")</td>
            <td class="numeric">@PimTime.Duration(zagon.DurationMs)</td>
            <td>@Sprozilec(zagon.TriggeredBy)</td>
            <td>@(zagon.DetailRedacted ?? "—")</td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

@code {
  [SupplyParameterFromQuery(Name = "izid")] public string? QueryIzid { get; set; }

  IReadOnlyList<SelfTestRunRow> Rows = [];
  IReadOnlyList<SelfTestStepRow> Steps = [];
  bool Loading = true;
  string? Error;
  const int Take = 90;

  static readonly IReadOnlyList<PimColumn> Stolpci =
  [
    new("Zagnan"), new("Test"), new("Izid"), new("Uspelo", true), new("Padlo", true),
    new("Preskočeno", true), new("Trajanje", true), new("Sprožil"), new("Opomba"),
  ];
  static readonly IReadOnlyList<PimColumn> StolpciKorakov =
  [
    new("#", true), new("Koda"), new("Kaj preverja"), new("Izid"), new("Trajanje", true), new("Meritev", true), new("Podrobnost"),
  ];

  string Izid => QueryIzid is "padli" or "opozorila" or "uspeli" ? QueryIzid : "";

  static bool IzidUstreza(SelfTestRunRow zagon, string izid) => izid switch
  {
    "padli" => zagon.Status is "Failed" or "Abandoned",
    "opozorila" => zagon.Status == "Warning",
    "uspeli" => zagon.Status == "Passed",
    _ => true,
  };

  IReadOnlyList<SelfTestRunRow> Prikazani => Rows.Where(zagon => IzidUstreza(zagon, Izid)).ToList();

  IReadOnlyList<PimSegment> Izbori =>
  [
    new("Vsi", "sistem/samotest", Izid == "", Loading ? null : Rows.Count),
    new("Padli ali nedokončani", "sistem/samotest?izid=padli", Izid == "padli", Loading ? null : Rows.Count(z => IzidUstreza(z, "padli")), "Zagoni z vsaj enim padlim korakom ali brez konca", "bad"),
    new("Z opozorili", "sistem/samotest?izid=opozorila", Izid == "opozorila", Loading ? null : Rows.Count(z => IzidUstreza(z, "opozorila")), null, "warn"),
    new("Uspeli", "sistem/samotest?izid=uspeli", Izid == "uspeli", Loading ? null : Rows.Count(z => IzidUstreza(z, "uspeli"))),
  ];

  string? Povzetek => Loading || Error is not null ? null : $"{Prikazani.Count:N0} od zadnjih {Rows.Count:N0} zagonov";

  /// <summary>Trajanje zadnjega zagona proti mediani zadnjih uspešnih — status sam ne pove, da se test daljša.</summary>
  string? TrajanjeOpomba
  {
    get
    {
      if (Rows.Count < 3 || Rows[0].DurationMs is not { } zadnje) return null;
      var uspesni = Rows.Skip(1).Where(z => z.Status == "Passed" && z.DurationMs is > 0).Select(z => z.DurationMs!.Value).Order().ToList();
      if (uspesni.Count < 3) return null;
      var mediana = uspesni[uspesni.Count / 2];
      var razmerje = (double)zadnje / mediana;
      return razmerje >= 1.5 ? $"{razmerje:0.0}× dlje kot običajno" : razmerje <= 0.67 ? "hitreje kot običajno" : "običajno";
    }
  }

  protected override Task OnInitializedAsync() => NaloziAsync();

  async Task NaloziAsync()
  {
    Loading = true;
    Error = null;
    try
    {
      Rows = await Nadzor.GetSelfTestHistoryAsync(Take);

      // Koraki zadnjega zagona niso del zgodovine (ena vrstica na zagon); pridejo iz istega
      // utripa kot /sistem, ker ni druge poizvedbe, ki bi jih vrnila same.
      var state = await Authentication.GetAuthenticationStateAsync();
      var uporabnik = state.User.Identity?.Name ?? "neznan";
      Steps = (await Nadzor.GetPulseAsync(uporabnik)).SelfTestSteps;
    }
    catch { Error = "Zgodovine samotestov trenutno ni mogoče prebrati. Poskusi z Osveži; če se ponovi, preveri povezavo z bazo."; }
    finally { Loading = false; }
  }

  static string Meritev(SelfTestStepRow korak) => korak.Measure is null ? "—"
    : $"{korak.Measure.Value:N0} {korak.MeasureUnit}".TrimEnd();

  static string Oznaka(string status) => status switch
  {
    "Passed" => "Uspel", "Failed" => "Padel", "Warning" => "Z opozorili",
    "Running" => "V teku", "Abandoned" => "Nedokončan", _ => status,
  };

  static string? Ton(string status) => status switch
  {
    "Passed" => "good", "Failed" or "Abandoned" => "bad", "Warning" => "warn", _ => null,
  };

  static string Sprozilec(string value) => value switch
  {
    "Scheduler" => "urnik", "Task" => "načrtovano opravilo", _ => "ročno",
  };
}
