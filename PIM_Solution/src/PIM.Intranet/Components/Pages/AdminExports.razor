@page "/sistem/izvozi"
@attribute [Authorize(Roles = "ADMIN")]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.AdminConsoleService Nadzor

@*
  Zagoni izvozov.

  Do migracije 172 po izvozu ni ostalo nič: out.ExportProfile pove, kakšna naj bi datoteka
  bila, ne pa ali je kdaj nastala, koliko vrstic je imela in kako dolgo je trajalo.
  "Ali je Magento zjutraj dobil svež CSV" je bilo vprašanje za Raziskovalca datotek.

  Hash je tu zato, ker je edini način, da se dve dostavi ločita brez odpiranja datoteke.
*@

<PageTitle>Zagoni izvozov</PageTitle>
<PimPage Title="Zagoni izvozov"
         Subtitle="@($"Katera datoteka je nastala, kdaj, koliko vrstic je imela in kako dolgo je trajalo. Časi so v naši uri ({PimTime.ZoneLabel}).")"
         Crumbs="Crumbs" />

<PimTabs Active="izvozi" Tabs="NadzorTabs.Tabs" Label="Pogledi nadzora" />

<section class="ui-card toolbar" role="search" aria-labelledby="izvozi-filter-naslov">
  <h2 id="izvozi-filter-naslov" class="visually-hidden">Filtriranje zagonov izvozov</h2>

  <label class="visually-hidden" for="izvozi-obdobje">Obdobje</label>
  <select id="izvozi-obdobje" class="filter-select" @bind="Dni" @bind:after="NaloziAsync">
    <option value="1">Zadnji dan</option>
    <option value="7">Zadnjih 7 dni</option>
    <option value="30">Zadnjih 30 dni</option>
    <option value="90">Zadnjih 90 dni</option>
  </select>

  <label class="visually-hidden" for="izvozi-profil">Profil</label>
  <input id="izvozi-profil" type="search" class="filter-select" placeholder="Koda profila …" @bind="Profil" />

  <button type="button" class="filter-button" disabled="@Loading" @onclick="NaloziAsync">Poišči</button>
  <span class="result-count" role="status" aria-live="polite">@Povzetek</span>
</section>

<section class="ui-card data-card section-gap" aria-label="Zagoni izvozov">
  <PimState Loading="Loading" Error="@Error" Empty="@(Rows.Count == 0)"
            EmptyText="V izbranem obdobju ni zabeleženega izvoza. Zgodovina se polni od migracije 172 naprej."
            LoadingText="Berem zagone izvozov …">
    <PimTable Caption="Zagoni izvozov s trajanjem, številom vrstic in izidom" Columns="Stolpci">
      <Rows>
        @foreach (var izvoz in Rows)
        {
          <tr class="@(izvoz.Status == "Failed" ? "row-alarm" : null)">
            <td class="nowrap">@PimTime.FormatExact(izvoz.StartedUtc)</td>
            <td><span class="code-value">@izvoz.ProfileCode</span><div class="tree-path">@(izvoz.ProfileName ?? "—")</div></td>
            <td>@(izvoz.OrganizationName ?? "—")</td>
            <td><PimChip Text="@Oznaka(izvoz.Status)" Tone="@Ton(izvoz.Status)" /></td>
            <td class="numeric">@(izvoz.RowCountValue?.ToString("N0") ?? "—")</td>
            <td class="numeric">@(izvoz.ColumnCountValue?.ToString("N0") ?? "—")</td>
            <td class="numeric">@Velikost(izvoz.ByteCountValue)</td>
            <td class="numeric">@PimTime.Duration(izvoz.DurationMs)</td>
            <td>@Sprozilec(izvoz.TriggeredBy)<div class="tree-path">@(izvoz.Actor ?? "—")</div></td>
            <td>
              @if (izvoz.ErrorRedacted is { Length: > 0 } napaka) { <span class="drift-flag">@napaka</span> }
              else { <span>@(izvoz.FileName ?? "—")</span> }
              @if (izvoz.Sha256 is { Length: > 8 } hash)
              {
                <div class="tree-path" title="SHA-256 datoteke">@hash[..12].ToUpperInvariant() …</div>
              }
            </td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

@code {
  IReadOnlyList<ExportRunRow> Rows = [];
  int Dni = 7;
  string Profil = "";
  bool Loading = true;
  string? Error;
  const int Take = 500;

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Sistem", "sistem"), new("Zagoni izvozov")];
  static readonly IReadOnlyList<PimColumn> Stolpci =
  [
    new("Zagnan"), new("Profil"), new("Podjetje"), new("Izid"), new("Vrstic", true), new("Stolpcev", true),
    new("Velikost", true), new("Trajanje", true), new("Sprožil"), new("Datoteka ali napaka"),
  ];

  protected override Task OnInitializedAsync() => NaloziAsync();

  async Task NaloziAsync()
  {
    Loading = true;
    Error = null;
    try { Rows = await Nadzor.GetExportRunsAsync(Dni, Profil, Take); }
    catch { Error = "Zagonov izvozov trenutno ni mogoče prebrati."; }
    finally { Loading = false; }
  }

  string Povzetek => Loading ? "Nalaganje …"
    : Error is not null ? "Rezultati niso na voljo"
    : $"{Rows.Count:N0} zagonov, {Rows.Count(row => row.Status == "Failed"):N0} neuspešnih";

  static string Velikost(long? bytes) => bytes switch
  {
    null => "—",
    < 1024 => $"{bytes} B",
    < 1024 * 1024 => $"{bytes / 1024.0:N0} kB",
    _ => $"{bytes / (1024.0 * 1024.0):N1} MB",
  };

  static string Oznaka(string status) => status switch
  {
    "Succeeded" => "Uspel", "Failed" => "Padel", "Running" => "V teku", "Abandoned" => "Nedokončan", _ => status,
  };

  static string? Ton(string status) => status switch
  {
    "Succeeded" => "good", "Failed" or "Abandoned" => "bad", "Running" => "warn", _ => null,
  };

  static string Sprozilec(string value) => value switch
  {
    "Scheduler" => "urnik", "Task" => "opravilo", _ => "ročno",
  };
}
