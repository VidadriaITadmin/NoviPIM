@page "/sistem/workerji"
@attribute [Authorize(Roles = "ADMIN")]
@rendermode InteractiveServer
@implements IDisposable
@inject PIM.Intranet.Services.WorkerConsoleService Konzola
@inject PIM.Intranet.Services.WorkerSchedulerService Razporejevalnik
@inject PIM.Intranet.Services.WorkerSchedulerStore Shramba
@inject PIM.Intranet.Services.IntranetDataService Data
@inject PIM.Intranet.Services.AdminConsoleService Nadzor
@inject AuthenticationStateProvider Authentication

@*
  Workerji: razporejevalnik, ročni zagon, izpis v živo in dnevniki.

  2026-09-15: »v aplikaciji mi omogoči da ročno poženem in spremljam potem kaj se zgodi in da
  vidim loge od vsakega workerja«. Isti dan se je izkazalo, da je šest dni tekel samo katalog:
  po selitvi repozitorija je bila znova registrirana ena Windows naloga od štirih.

  2026-09-17: »zakaj na IIS-ju ne delajo workerji, v aplikaciji pa delajo. Naredi mi, da mi bodo
  workerji delali ne glede, kje je aplikacija postavljena.« Pod IIS bazen Windows nalog ne vidi in
  jih ne sme registrirati, objavljen intranet pa nima ne PIM.sln ne PowerShella. Zato je ura zdaj v
  aplikaciji (WorkerSchedulerService, migracija 221): prvi razdelek pove, ali ta proces drži najem,
  kateri cikel je kdaj tekel, kdaj je naslednjič na vrsti in kje zaostaja — cikel, ki od zadnjega
  začetka miruje dvakrat svoj razmik, je označen ZASTAL in ima odprt alarm.

  Zagon teče v intranetu (WorkerConsoleService, singleton), zato stran lahko zapreš in se vrneš.
  Vsak zagon piše svoj dnevnik (logs\cikli, logs\workerji); ta ostane tudi po ponovnem zagonu
  intraneta in je spodaj med dnevniki. Zgodovina zagonov ciklov je v bazi (ops.WorkerCycleRun).
*@

<PageTitle>Workerji</PageTitle>
<PimPage Title="Workerji"
         Subtitle="@($"Razporejevalnik, ročni zagon, izpis v živo in dnevnik vsakega workerja. Časi so v naši uri ({PimTime.ZoneLabel}).")"
         Crumbs="Crumbs">
  <Actions>
    <button type="button" class="filter-button" disabled="@Loading" @onclick="() => NaloziAsync(true)">Osveži</button>
  </Actions>
</PimPage>

<PimTabs Active="workerji" Tabs="NadzorTabs.Tabs" Label="Pogledi nadzora" />

@if (!Konzola.Setup.Available)
{
  <p class="message-state error-message" role="alert">
    Cikli in workerji tu ne morejo teči: @Konzola.Setup.Reason
  </p>
}
@if (Message is not null) { <p class="message-state success-message" role="status" aria-live="polite">@Message</p> }
@if (Error is not null) { <p class="message-state error-message" role="alert">@Error</p> }

@* ── 1. Razporejevalnik ──────────────────────────────────────────────────── *@
<section class="ui-card data-card section-gap" aria-labelledby="razporejevalnik-naslov">
  <div class="panel-title">
    <h2 id="razporejevalnik-naslov">Razporejevalnik</h2>
    <PimChip Text="@StanjeRazporejevalnika().Text" Tone="@StanjeRazporejevalnika().Tone" Prefix="Razporejevalnik: " />
  </div>
  <p class="panel-note">
    Ura je v aplikaciji: intranet, ki drži najem v bazi, vsakih nekaj sekund pogleda, kateri cikel je
    na vrsti, in ga požene sam — pod IIS, v Visual Studiu ali z dotnet run, brez Windows nalog.
    Isti cikel nikoli ne teče dvakrat hkrati, tudi če intranet teče na več mestih. Cikel, ki od
    zadnjega začetka miruje več kot dvakrat svoj razmik, je označen ZASTAL in ima odprt alarm v zvoncu.
  </p>

  <dl class="scheduler-facts">
    <div><dt>Ta proces</dt><dd><span class="code-value">@Stanje.Owner</span>@(Stanje.IsIis ? " (IIS)" : "")</dd></div>
    <div>
      <dt>Najem drži</dt>
      <dd>
        @if (Stanje.Lease is { } najem)
        {
          <span class="code-value">@najem.Owner</span>
          <span class="muted"> od @PimTime.Format(najem.AcquiredUtc) · zadnji utrip @PimFormat.Ago(najem.HeartbeatUtc) · tikov @najem.TickCount.ToString("N0")</span>
          @if (!najem.IsLive(DateTime.UtcNow)) { <span class="drift-flag">najem je potekel @PimTime.Format(najem.ExpiresUtc)</span> }
          @if (!najem.CanRunCycles) { <span class="drift-flag">ta lastnik nima workerjev in ciklov ne poganja — drži uro le za alarme, dokler ga ne zamenja intranet z workerji</span> }
        }
        else { <span class="muted">—</span> }
      </dd>
    </div>
    <div><dt>Zadnji tik</dt><dd>@PimTime.FormatWithAge(Stanje.LastTickUtc, "še ni tiknil")@(Stanje.Ticks > 0 ? $" · {Stanje.Ticks:N0} tikov" : "")</dd></div>
    <div><dt>Workerji</dt><dd>@(Konzola.Setup.PublishedWorkersRoot is { } objavljeni ? $"objavljeni: {objavljeni}" : Konzola.Setup.HasSource ? $"izvorna koda: {Konzola.Setup.SolutionRoot} (dotnet run)" : "—")</dd></div>
    <div><dt>Dnevniki</dt><dd><span class="code-value">@Konzola.Setup.LogRoot</span>@if (Stanje.LogRootNote is { } opombaDnevnikov) { <span class="drift-flag">@opombaDnevnikov</span> }</dd></div>
    @if (Stanje.IsIis)
    {
      <div>
        <dt>IIS</dt>
        <dd>
          Samodejni utrip @(Stanje.SelfUrl is null ? "čaka na prvo zahtevo" : $"na {Stanje.SelfUrl}/health"),
          zadnji @PimTime.FormatWithAge(Stanje.LastKeepAliveUtc, "še ni")@(Stanje.KeepAliveError is { } napakaUtripa ? $" — {napakaUtripa}" : "").
          Bazen naj bo nastavljen na »Always running« s predhodnim nalaganjem (deploy\Configure-IisAlwaysRunning.ps1),
          sicer po recikliranju ura stoji do prve zahteve.
        </dd>
      </div>
    }
    @if (Stanje.LastError is { } napakaTika) { <div><dt>Zadnja napaka</dt><dd><span class="error-count">@napakaTika</span> <span class="muted">(@PimTime.FormatWithAge(Stanje.LastErrorUtc))</span></dd></div> }
    @foreach (var opombaRazporejevalnika in Stanje.Notes) { <div><dt>Opomba</dt><dd>@opombaRazporejevalnika</dd></div> }
  </dl>

  @if (Podvojeni.Count > 0)
  {
    <div class="message-state error-message" role="alert">
      <strong>Podvojeno:</strong> stara Windows naloga še teče vzporedno z razporejevalnikom —
      @foreach (var (naloga, _, zapis) in Podvojeni) { <span>@naloga (dnevnik skripte @PimTime.FormatWithAge(zapis)) </span> }
      Isti cikel tako poganjata dve uri. Odstrani naloge v PowerShellu na tistem računalniku:
      <pre class="command">powershell -ExecutionPolicy Bypass -File scripts\Namesti-opravila.ps1 -Odstrani
powershell -ExecutionPolicy Bypass -File scripts\Namesti-samotest.ps1 -Odstrani</pre>
    </div>
  }

  <PimState Loading="@(CikliVrstice is null)" Empty="@(CikliVrstice is { Count: 0 })" EmptyText="V bazi ni ciklov (migracija 221)." LoadingText="Berem cikle …">
    <PimTable Caption="Cikli: razpored, zadnji zagon, naslednji termin in ritem" Columns="StolpciCiklov">
      <Rows>
        @foreach (var cikel in CikliVrstice ?? [])
        {
          var opis = WorkerCycles.Find(cikel.CycleKey);
          var ritem = Ritem(cikel);
          var tece = Konzola.ActiveForCycle(cikel.CycleKey);
          var kljuc = cikel.CycleKey;
          <tr class="@(ritem.State == CycleRhythm.Overdue ? "row-alarm" : null)">
            <td class="job-cell">
              <strong>@cikel.Label</strong>
              <div class="job-note">@(opis?.Description ?? "")</div>
              @if (opis is { Reach: not WorkerJobReach.Internal }) { <span class="reach-flag">@opis.ReachNote</span> }
            </td>
            <td>
              <div class="schedule-edit">
                @if (cikel.IntervalSeconds is not null)
                {
                  <label class="visually-hidden" for="@($"razmik-{kljuc}")">Razmik v minutah za @cikel.Label</label>
                  <input id="@($"razmik-{kljuc}")" type="number" min="1" max="1440" class="filter-select interval-input"
                         value="@Minute(cikel)" @onchange="@(e => NastaviMinute(kljuc, e.Value?.ToString()))" />
                  <span class="muted">min</span>
                }
                else
                {
                  <label class="visually-hidden" for="@($"ura-{kljuc}")">Ura dnevnega zagona za @cikel.Label</label>
                  <span class="muted">vsak dan ob</span>
                  <input id="@($"ura-{kljuc}")" type="time" class="filter-select time-input"
                         value="@Ura(cikel)" @onchange="@(e => NastaviUro(kljuc, e.Value?.ToString()))" />
                }
                <button type="button" class="small-action" disabled="@(Busy || !Spremenjen(cikel))" @onclick="() => ShraniCikelAsync(cikel)">Shrani</button>
              </div>
              <div class="schedule-edit">
                <PimChip Text="@(cikel.IsEnabled ? "Vklopljen" : "Izklopljen")" Tone="@(cikel.IsEnabled ? "good" : "bad")" />
                <button type="button" class="small-action @(cikel.IsEnabled ? "warn-action" : "good-action")" disabled="@Busy" @onclick="() => PreklopiCikelAsync(cikel)">
                  @(cikel.IsEnabled ? "Izklopi" : "Vklopi")
                </button>
              </div>
            </td>
            <td>
              @if (cikel.RunningRunId is not null)
              {
                <div><PimChip Text="@($"Teče {Trajanje(DateTime.UtcNow - (cikel.RunningSinceUtc ?? DateTime.UtcNow))}")" Tone="warn" /></div>
                <div class="job-note">od @PimTime.FormatTime(cikel.RunningSinceUtc) na @cikel.RunningHost@(cikel.RunningStep is { } tekociKorak ? $" · {tekociKorak}" : "")</div>
              }
              else if (cikel.LastStartedUtc is null)
              {
                <span class="muted">še nikoli</span>
              }
              else
              {
                <div class="nowrap">@PimTime.FormatWithAge(cikel.LastStartedUtc)</div>
                <div class="job-note">
                  <PimChip Text="@StatusCikla(cikel.LastStatus)" Tone="@TonCikla(cikel.LastStatus)" />
                  trajanje @PimTime.Duration(cikel.LastDurationMs) · @Sprozilec(cikel.LastTriggeredBy) · @cikel.LastHost
                  @if (cikel.LastStepsFailed is > 0) { <span class="error-count"> · padlih skupin: @cikel.LastStepsFailed</span> }
                </div>
                @if (cikel.LastError is { Length: > 0 } napaka) { <div class="drift-flag" title="@napaka">@Skrajsaj(napaka)</div> }
              }
            </td>
            <td class="nowrap">
              @if (!cikel.IsEnabled) { <span class="muted">—</span> }
              else if (cikel.NextDueUtc is { } termin)
              {
                <div>@PimTime.Format(termin)</div>
                <div class="job-note">@(termin > DateTime.UtcNow ? $"čez {Trajanje(termin - DateTime.UtcNow)}" : $"na vrsti že {Trajanje(DateTime.UtcNow - termin)}")</div>
              }
              else { <span class="muted">ob naslednjem tiku</span> }
            </td>
            <td>
              <PimChip Text="@RitemOznaka(ritem)" Tone="@RitemTon(ritem)" Prefix="Ritem: " />
              @if (cikel.OpenOverdueAlerts > 0) { <div class="job-note error-count">odprt alarm</div> }
            </td>
            <td>
              <div class="table-actions">
                @if (tece is not null)
                {
                  <button type="button" class="small-action" @onclick="() => PokaziIzpis(tece)">Izpis</button>
                  <button type="button" class="small-action warn-action" @onclick="() => UstaviAsync(tece)">Ustavi</button>
                }
                else if (cikel.RunningRunId is not null)
                {
                  <span class="muted">teče drugje</span>
                }
                else if (Potrjuje == "cikel:" + kljuc)
                {
                  <button type="button" class="small-action danger-action" disabled="@(!Konzola.Setup.Available)" @onclick="() => PozeniCikelAsync(cikel)">Potrdi zagon</button>
                  <button type="button" class="small-action" @onclick="() => Potrjuje = null">Prekliči</button>
                }
                else
                {
                  <button type="button" class="small-action primary-small" disabled="@(!Konzola.Setup.Available || Busy)" @onclick="() => PozeniCikelAsync(cikel)">Poženi zdaj</button>
                }
              </div>
            </td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>

  <details class="legacy-tasks">
    <summary>Stare naloge Windows na tem računalniku (niso več potrebne)</summary>
    <p class="panel-note">
      Do 2026-09-17 je cikle sprožala Windows naloga pod računom človeka. Zdaj jih poganja
      razporejevalnik zgoraj; registrirana naloga bi isti cikel poganjala še enkrat. Pod IIS račun
      bazena nalog drugega uporabnika ne vidi — stolpec stanja nosi sporočilo Windows.
    </p>
    <PimState Loading="@(Naloge is null)" Empty="false" LoadingText="Berem načrtovane naloge Windows …">
      <PimTable Caption="Načrtovane naloge Windows na tem računalniku" Columns="StolpciNalog">
        <Rows>
          @foreach (var naloga in Naloge ?? [])
          {
            <tr>
              <td><span class="code-value">@naloga.Name</span></td>
              <td>
                @if (naloga.Registered == true) { <PimChip Text="Registrirana" Tone="warn" /> }
                else if (naloga.Registered == false) { <PimChip Text="Ni registrirana" Tone="good" /> }
                else { <PimChip Text="Neznano" /> }
              </td>
              <td class="nowrap">@(naloga.NextRun ?? "—")</td>
              <td>@(naloga.Status ?? "—")</td>
              <td class="nowrap">@(naloga.LogPrefix is null ? "—" : PimTime.FormatWithAge(ZadnjiDnevnik(naloga.LogPrefix), "ni dnevnika"))</td>
            </tr>
          }
        </Rows>
      </PimTable>
    </PimState>
    @if (RegistriraneNaloge.Count > 0)
    {
      <div class="message-state warn-message">
        Še registrirano: <strong>@string.Join(", ", RegistriraneNaloge)</strong>. Skripta se sicer umakne, kadar
        razporejevalnik drži najem (Sql.ps1), a naloge ni več treba imeti; odstrani jih v PowerShellu na tem računalniku:
        <pre class="command">powershell -ExecutionPolicy Bypass -File scripts\Namesti-opravila.ps1 -Odstrani
powershell -ExecutionPolicy Bypass -File scripts\Namesti-samotest.ps1 -Odstrani</pre>
      </div>
    }
  </details>
</section>

@* ── 2. Ročni zagon ───────────────────────────────────────────────────────── *@
<section class="ui-card data-card section-gap" aria-labelledby="zagon-naslov">
  <div class="panel-title">
    <h2 id="zagon-naslov">Ročni zagon</h2>
    <label class="picker">
      <span>Podjetje</span>
      <select class="filter-select" @bind="IzbranoPodjetje">
        <option value="0">Vsa podjetja</option>
        @foreach (var podjetje in Podjetja)
        {
          <option value="@podjetje.Id">@podjetje.Name</option>
        }
      </select>
    </label>
  </div>
  <p class="panel-note">
    Ročni zagon ne čaka na razpored, izklopljen postopek pa ga kljub temu zavrne z napako 51100.
    Tak postopek je označen pri poslu in ga lahko vklopiš kar tu. Posel, ki kliče SAOP ali
    dobavitelja ali pošlje e-pošto, zahteva še en klik za potrditev. Cikel iz te tabele teče za vsa
    vključena podjetja in prestavi svoj naslednji termin, da ga ura čez minuto ne požene še enkrat.
    Podjetje, izključeno na <a href="sistem/integracije">Alarmih in podjetjih</a>, tu namenoma ni na seznamu.
  </p>

  @foreach (var skupina in WorkerJobs.All.GroupBy(posel => posel.Group))
  {
    <h3 class="group-title">@skupina.Key</h3>
    <PimTable Caption="@skupina.Key" Columns="StolpciPoslov">
      <Rows>
        @foreach (var posel in skupina)
        {
          var tece = Konzola.ActiveFor(posel.Key);
          var izklopljeni = Izklopljeni(posel);
          var stanje = ZadnjeStanje(posel);
          var razlog = Konzola.Unavailable(posel);
          <tr>
            <td class="job-cell">
              <strong>@posel.Label</strong>
              <div class="job-note">@posel.Description</div>
              @if (posel.Reach != WorkerJobReach.Internal)
              {
                <span class="reach-flag">@posel.ReachNote</span>
              }
            </td>
            <td>
              @if (posel.Pipelines.Count == 0)
              {
                <span class="muted">brez razporeda</span>
              }
              else if (izklopljeni.Count == 0)
              {
                <PimChip Text="Vklopljen" Tone="good" />
              }
              else
              {
                foreach (var vrstica in izklopljeni)
                {
                  <div class="disabled-row">
                    <PimChip Text="@($"{vrstica.Pipeline} izklopljen · {vrstica.OrganizationName}")" Tone="bad" />
                    @if (!string.IsNullOrWhiteSpace(vrstica.UpdatedBy))
                    {
                      <span class="muted">@vrstica.UpdatedBy</span>
                    }
                    <button type="button" class="small-action good-action" disabled="@Busy" @onclick="() => VklopiAsync(vrstica)">Vklopi</button>
                  </div>
                }
              }
            </td>
            <td>
              @if (stanje is null)
              {
                <span class="muted">—</span>
              }
              else
              {
                <div class="nowrap">@PimTime.FormatWithAge(stanje.Value.OldestSuccess, "nikoli")</div>
                @if (stanje.Value.Error is { Length: > 0 } napaka)
                {
                  <div class="drift-flag" title="@napaka">@Skrajsaj(napaka)</div>
                }
              }
            </td>
            <td>
              <div class="table-actions">
                @if (tece is not null)
                {
                  <PimChip Text="@($"Teče {PimTime.Duration((long)tece.Elapsed.TotalMilliseconds)}")" Tone="warn" />
                  <button type="button" class="small-action" @onclick="() => PokaziIzpis(tece)">Izpis</button>
                  <button type="button" class="small-action warn-action" @onclick="() => UstaviAsync(tece)">Ustavi</button>
                }
                else if (Potrjuje == posel.Key)
                {
                  <button type="button" class="small-action danger-action" disabled="@(razlog is not null)" title="@razlog" @onclick="() => PozeniAsync(posel)">Potrdi zagon</button>
                  <button type="button" class="small-action" @onclick="() => Potrjuje = null">Prekliči</button>
                }
                else
                {
                  <button type="button" class="small-action primary-small" disabled="@(razlog is not null)" title="@razlog" @onclick="() => PozeniAsync(posel)">Poženi</button>
                  @if (razlog is not null)
                  {
                    <span class="muted" title="@razlog">ni na voljo tu</span>
                  }
                }
              </div>
            </td>
          </tr>
        }
      </Rows>
    </PimTable>
  }
</section>

@* ── 3. Izpis izbranega zagona ─────────────────────────────────────────────── *@
@if (Izbrani is { } zagon)
{
  <section class="ui-card data-card section-gap" aria-labelledby="izpis-naslov">
    <div class="panel-title">
      <h2 id="izpis-naslov">Izpis: @zagon.Job.Label</h2>
      <PimChip Text="@StatusOznaka(zagon.Status)" Tone="@StatusTon(zagon.Status)" />
    </div>
    <p class="run-meta">
      Sprožil @zagon.StartedBy@(zagon.Scheduled ? " (razporejevalnik)" : "") · @zagon.OrganizationsLabel · začetek @PimTime.FormatExact(zagon.StartedUtc) ·
      trajanje @PimTime.Duration((long)zagon.Elapsed.TotalMilliseconds)
      @if (zagon.ExitCode is { } koda)
      {
        <text> · izhodna koda @koda</text>
      }
      @if (zagon.ErrorLines > 0)
      {
        <text> · </text><span class="error-count">@zagon.ErrorLines vrstic z napako</span>
      }
    </p>
    @if (zagon.CurrentStep is { } trenutniKorak)
    {
      <p class="run-meta">Zdaj teče: <span class="code-value">@trenutniKorak</span></p>
    }
    <div class="console-toolbar">
      <label><input type="checkbox" @bind="SamoTezaveIzpis" /> Samo napake, opozorila in koraki</label>
      <span class="muted">Dnevnik: <span class="code-value">@RelativnaPot(zagon.LogPath)</span></span>
      @if (zagon.EndedUtc is not null)
      {
        <button type="button" class="small-action" @onclick="() => IzbraniId = null">Zapri</button>
      }
    </div>
    <div class="console" role="log" tabindex="0" aria-label="Izpis zagona">
      <div>
        @foreach (var vrstica in zagon.Snapshot(SamoTezaveIzpis, 1500))
        {
          <div class="line @Ton(vrstica.Tone)">@vrstica.Text</div>
        }
      </div>
    </div>
  </section>
}

@* ── 4. Zagoni v tem procesu ──────────────────────────────────────────────── *@
@if (Konzola.Runs.Count > 0)
{
  <section class="ui-card data-card section-gap" aria-labelledby="zagoni-naslov">
    <div class="panel-title">
      <h2 id="zagoni-naslov">Zagoni v tem procesu</h2>
      <span class="muted">od zadnjega zagona intraneta, z izpisom v živo; celotna zgodovina ciklov je spodaj</span>
    </div>
    <PimTable Caption="Zagoni v tem procesu, najnovejši najprej" Columns="StolpciZagonov">
      <Rows>
        @foreach (var tek in Konzola.Runs)
        {
          <tr class="@(tek.Id == IzbraniId ? "row-selected" : null)">
            <td class="nowrap">@PimTime.Format(tek.StartedUtc)</td>
            <td>@tek.Job.Label<div class="job-note">@tek.OrganizationsLabel</div></td>
            <td>@tek.StartedBy@(tek.Scheduled ? " (razporejevalnik)" : "")</td>
            <td><PimChip Text="@StatusOznaka(tek.Status)" Tone="@StatusTon(tek.Status)" /></td>
            <td class="numeric">@PimTime.Duration((long)tek.Elapsed.TotalMilliseconds)</td>
            <td class="numeric">
              @if (tek.ErrorLines > 0) { <span class="error-count">@tek.ErrorLines</span> }
              else { <span class="muted">0</span> }
            </td>
            <td><button type="button" class="small-action" @onclick="() => PokaziIzpis(tek)">Izpis</button></td>
          </tr>
        }
      </Rows>
    </PimTable>
  </section>
}

@* ── 5. Zgodovina zagonov ciklov (baza) ───────────────────────────────────── *@
<section class="ui-card data-card section-gap" aria-labelledby="zgodovina-naslov">
  <div class="panel-title">
    <h2 id="zgodovina-naslov">Zgodovina zagonov ciklov</h2>
    <span class="muted">ops.WorkerCycleRun — vsi gostitelji, ostane tudi po ponovnem zagonu intraneta</span>
  </div>
  <PimState Loading="@(Zgodovina is null)" Empty="@(Zgodovina is { Count: 0 })" EmptyText="Noben cikel še ni tekel." LoadingText="Berem zgodovino …">
    <PimTable Caption="Zadnjih 40 zagonov ciklov, najnovejši najprej" Columns="StolpciZgodovine">
      <Rows>
        @foreach (var tek in Zgodovina ?? [])
        {
          <tr class="@(tek.WorkerCycleRunId == OdprtZagon ? "row-selected" : null)">
            <td class="nowrap">@PimTime.Format(tek.StartedUtc)</td>
            <td>@(tek.Label ?? tek.CycleKey)</td>
            <td>@Sprozilec(tek.TriggeredBy)<div class="job-note">@tek.StartedBy · @tek.HostName</div></td>
            <td>
              <PimChip Text="@StatusCikla(tek.Status)" Tone="@TonCikla(tek.Status)" />
              @if (tek.Status == "Running" && tek.CurrentStep is { } korakVTeku) { <div class="job-note">@korakVTeku</div> }
              @if (tek.Summary is { Length: > 0 } povzetek && tek.Status != "Succeeded") { <div class="drift-flag" title="@povzetek">@Skrajsaj(povzetek)</div> }
            </td>
            <td class="numeric">@PimTime.Duration((long)tek.Duration.TotalMilliseconds)</td>
            <td class="numeric">@tek.StepsTotal<span class="muted"> / </span>@if (tek.StepsFailed > 0) { <span class="error-count">@tek.StepsFailed</span> } else { <span class="muted">0</span> }</td>
            <td>
              <div class="table-actions">
                <button type="button" class="small-action" @onclick="() => OdpriKorakeAsync(tek.WorkerCycleRunId)">Koraki</button>
                @if (Konzola.RelativeLogPath(tek.LogPath) is { } pot)
                {
                  <button type="button" class="small-action" @onclick="() => OdpriDnevnik(pot)">Dnevnik</button>
                }
              </div>
            </td>
          </tr>
          @if (tek.WorkerCycleRunId == OdprtZagon)
          {
            <tr class="row-selected">
              <td colspan="7">
                @if (Koraki.Count == 0) { <span class="muted">Zagon nima zapisanih korakov.</span> }
                else
                {
                  <table class="data-table steps-table">
                    <caption class="visually-hidden">Koraki zagona</caption>
                    <thead><tr><th scope="col">#</th><th scope="col">Korak</th><th scope="col">Podjetje</th><th scope="col">Začetek</th><th scope="col">Trajanje</th><th scope="col">Stanje</th><th scope="col">Ukaz / opomba</th></tr></thead>
                    <tbody>
                      @foreach (var korakZagona in Koraki)
                      {
                        <tr>
                          <td class="numeric">@korakZagona.StepOrder</td>
                          <td>@korakZagona.StepName</td>
                          <td>@(korakZagona.OrganizationId?.ToString() ?? "—")</td>
                          <td class="nowrap">@PimTime.FormatTime(korakZagona.StartedUtc)</td>
                          <td class="numeric">@(korakZagona.EndedUtc is { } konecKoraka ? PimTime.Duration((long)(konecKoraka - korakZagona.StartedUtc).TotalMilliseconds) : "—")</td>
                          <td><PimChip Text="@StatusKoraka(korakZagona.Status)" Tone="@TonCikla(korakZagona.Status)" /></td>
                          <td><span class="code-value">@korakZagona.Command</span>@if (korakZagona.Note is { Length: > 0 } opombaKoraka) { <div class="job-note">@opombaKoraka</div> }</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                }
              </td>
            </tr>
          }
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

@* ── 6. Dnevniki ──────────────────────────────────────────────────────────── *@
<section class="ui-card data-card section-gap" aria-labelledby="dnevniki-naslov">
  <div class="panel-title">
    <h2 id="dnevniki-naslov">Dnevniki</h2>
    <label class="picker">
      <span>Vrsta</span>
      <select class="filter-select" @bind="VrstaDnevnika">
        <option value="">Vse vrste</option>
        @foreach (var vrsta in WorkerLogs.Kinds)
        {
          <option value="@vrsta.Key">@vrsta.Label</option>
        }
      </select>
    </label>
  </div>
  <p class="panel-note">
    Mapa <span class="code-value">@Konzola.Setup.LogRoot</span>. Cikli razporejevalnika in ročni zagoni
    ciklov pišejo v podmapo <span class="code-value">@WorkerLogs.CycleFolder</span>, ročni zagoni workerjev v
    <span class="code-value">@WorkerLogs.ManualFolder</span>, skripte (stare Windows naloge) en dnevnik na dan v koren.
    Stolpec napak šteje vrstice z napako v zadnjih 64 KB datoteke.
  </p>
  <PimState Loading="@(Dnevniki is null)" Empty="@(FiltriraniDnevniki.Count == 0)"
            EmptyText="V mapi dnevnikov ni datotek te vrste." LoadingText="Berem mapo dnevnikov …">
    <PimTable Caption="Datoteke dnevnikov, najnovejše najprej" Columns="StolpciDnevnikov">
      <Rows>
        @foreach (var dnevnik in FiltriraniDnevniki)
        {
          <tr class="@(dnevnik.RelativePath == OdprtDnevnik ? "row-selected" : null)">
            <td><span class="code-value">@dnevnik.RelativePath</span></td>
            <td>@WorkerLogs.KindLabel(dnevnik.Kind)</td>
            <td class="nowrap">@PimTime.FormatWithAge(dnevnik.LastWriteUtc)</td>
            <td class="numeric">@Velikost(dnevnik.Length)</td>
            <td class="numeric">
              @if (dnevnik.ErrorLines > 0) { <span class="error-count">@dnevnik.ErrorLines</span> }
              else { <span class="muted">0</span> }
            </td>
            <td><button type="button" class="small-action" @onclick="() => OdpriDnevnik(dnevnik.RelativePath)">Odpri</button></td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>

  @if (OdprtDnevnik is not null)
  {
    <div class="console-toolbar section-gap">
      <strong>@OdprtDnevnik</strong>
      <label><input type="checkbox" @bind="SamoTezaveDnevnik" /> Samo napake, opozorila in koraki</label>
      <button type="button" class="small-action" @onclick="() => OdpriDnevnik(OdprtDnevnik)">Osveži</button>
      <button type="button" class="small-action" @onclick="ZapriDnevnik">Zapri</button>
    </div>
    <p class="run-meta">Prikazan je konec datoteke (do 512 KB): @VrsticeDnevnika.Count vrstic.</p>
    <div class="console" role="log" tabindex="0" aria-label="Vsebina dnevnika">
      <div>
        @foreach (var vrstica in PrikazaneVrsticeDnevnika)
        {
          <div class="line @Ton(vrstica.Tone)">@vrstica.Text</div>
        }
      </div>
    </div>
  }
</section>

@code {
  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Sistem", "sistem"), new("Workerji")];
  static readonly IReadOnlyList<PimColumn> StolpciCiklov =
    [new("Cikel"), new("Razpored"), new("Zadnji zagon"), new("Naslednjič"), new("Ritem"), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> StolpciNalog =
    [new("Naloga"), new("Registrirana"), new("Naslednji zagon"), new("Stanje v Windows"), new("Zadnji dnevnik skripte")];
  static readonly IReadOnlyList<PimColumn> StolpciPoslov =
    [new("Posel"), new("Razpored"), new("Najstarejši zadnji uspeh"), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> StolpciZagonov =
    [new("Začetek"), new("Posel"), new("Sprožil"), new("Stanje"), new("Trajanje", true), new("Napak", true), new("")];
  static readonly IReadOnlyList<PimColumn> StolpciZgodovine =
    [new("Začetek"), new("Cikel"), new("Sprožil"), new("Stanje"), new("Trajanje", true), new("Korakov / padlih", true), new("")];
  static readonly IReadOnlyList<PimColumn> StolpciDnevnikov =
    [new("Datoteka"), new("Vrsta"), new("Zadnji zapis"), new("Velikost", true), new("Napak", true), new("")];

  IReadOnlyList<ScheduleRow> Urniki = [];
  IReadOnlyList<PIM.Intranet.Services.OrganizationAutomationRow> Avtomatika = [];
  IReadOnlyList<ScheduledTaskState>? Naloge;
  IReadOnlyList<WorkerLogFile>? Dnevniki;
  IReadOnlyList<WorkerCycleRow>? CikliVrstice;
  IReadOnlyList<WorkerCycleRunRow>? Zgodovina;
  IReadOnlyList<WorkerCycleStepRow> Koraki = [];
  IReadOnlyList<WorkerLogLine> VrsticeDnevnika = [];
  readonly Dictionary<string, int> UrejeneMinute = [];
  readonly Dictionary<string, string> UrejeneUre = [];
  long? OdprtZagon;
  string? OdprtDnevnik;
  string VrstaDnevnika = "";
  bool SamoTezaveIzpis;
  bool SamoTezaveDnevnik;
  int IzbranoPodjetje;
  string? Potrjuje;
  Guid? IzbraniId;
  bool Loading = true;
  bool Busy;
  string? Message;
  string? Error;
  long videnaRazlicica;
  int videnihTekov;
  int tikovOdOsvezitve;
  readonly CancellationTokenSource ustavi = new();

  SchedulerStatus Stanje => Razporejevalnik.Status;

  WorkerRun? Izbrani => IzbraniId is { } id ? Konzola.Find(id) : null;

  IReadOnlyList<(int Id, string Name)> Podjetja => Avtomatika
    .Where(podjetje => podjetje.IsAutomationEnabled)
    .OrderBy(podjetje => podjetje.OrganizationId)
    .Select(podjetje => (podjetje.OrganizationId, $"{podjetje.Name} ({podjetje.OrganizationId})"))
    .ToList();

  List<string> RegistriraneNaloge => (Naloge ?? []).Where(naloga => naloga.Registered == true).Select(naloga => naloga.Name).ToList();

  /// Skripta stare naloge je v zadnjih 15 minutah pisala svoj dnevnik, čeprav razporejevalnik drži najem.
  IReadOnlyList<(string Task, string CycleKey, DateTime LastWriteUtc)> Podvojeni =>
    Stanje.Lease is { } najem && najem.IsLive(DateTime.UtcNow)
      ? WorkerCycles.RecentLegacyRuns(Dnevniki ?? [], DateTime.UtcNow, TimeSpan.FromMinutes(15))
      : [];

  List<WorkerLogFile> FiltriraniDnevniki => (Dnevniki ?? [])
    .Where(dnevnik => VrstaDnevnika.Length == 0 || dnevnik.Kind == VrstaDnevnika)
    .ToList();

  IEnumerable<WorkerLogLine> PrikazaneVrsticeDnevnika => SamoTezaveDnevnik
    ? VrsticeDnevnika.Where(vrstica => vrstica.Tone is LogLineTone.Error or LogLineTone.Warning or LogLineTone.Header)
    : VrsticeDnevnika;

  protected override async Task OnInitializedAsync()
  {
    await NaloziAsync(false);
    videnaRazlicica = Konzola.Version;
    videnihTekov = Konzola.RunningCount;
    _ = OsvezujAsync(ustavi.Token);
  }

  async Task NaloziAsync(bool osveziNaloge)
  {
    Loading = true;
    Error = null;
    try
    {
      Urniki = await Data.GetSchedulesAsync();
      Avtomatika = await Data.GetOrganizationAutomationAsync();
      if (IzbranoPodjetje != 0 && !Avtomatika.Any(podjetje => podjetje.OrganizationId == IzbranoPodjetje && podjetje.IsAutomationEnabled))
        IzbranoPodjetje = 0;
    }
    catch { Error = "Razporedov iz baze trenutno ni mogoče prebrati; ročni zagon kljub temu deluje."; }
    await NaloziCikleAsync();
    try { Dnevniki = await Task.Run(() => Konzola.ListLogs()); }
    catch { Dnevniki = []; Error ??= "Mape dnevnikov ni mogoče prebrati."; }
    try { Naloge = await Konzola.GetScheduledTasksAsync(osveziNaloge); }
    catch { Naloge = []; Error ??= "Načrtovanih nalog Windows ni mogoče prebrati."; }
    Loading = false;
  }

  async Task NaloziCikleAsync()
  {
    try
    {
      CikliVrstice = await Shramba.GetCyclesAsync();
      UrejeneMinute.Clear();
      UrejeneUre.Clear();
    }
    catch { CikliVrstice = []; Error ??= "Ciklov iz baze ni mogoče prebrati (je migracija 221 uveljavljena?)."; }
    try { Zgodovina = await Shramba.GetRunsAsync(40); }
    catch { Zgodovina = []; }
  }

  // Izpis v živo: vsako sekundo, a samo, kadar je kaj novega ali kaj teče (trajanje raste). Ko
  // zagon konča, se znova preberejo cikli, razpored in dnevniki — sicer bi stran kazala stanje
  // izpred teka. Cikli in stanje razporejevalnika se osvežijo tudi vsakih 30 s, ker jih poganja
  // drug proces ali ozadje, ne ta stran.
  async Task OsvezujAsync(CancellationToken token)
  {
    using var ura = new PeriodicTimer(TimeSpan.FromSeconds(1));
    try
    {
      while (await ura.WaitForNextTickAsync(token))
      {
        var razlicica = Konzola.Version;
        var teceJih = Konzola.RunningCount;
        var redno = ++tikovOdOsvezitve >= 30;
        if (razlicica == videnaRazlicica && teceJih == 0 && videnihTekov == 0 && !redno) continue;

        var koncalJe = teceJih < videnihTekov;
        videnaRazlicica = razlicica;
        videnihTekov = teceJih;
        if (redno) tikovOdOsvezitve = 0;
        await InvokeAsync(async () =>
        {
          if (koncalJe) await NaloziAsync(false);
          else if (redno) await NaloziCikleAsync();
          StateHasChanged();
        });
      }
    }
    catch (OperationCanceledException) { }
    catch (ObjectDisposedException) { }
  }

  async Task PozeniAsync(WorkerJob posel)
  {
    Message = null;
    Error = null;
    if (posel.Reach != WorkerJobReach.Internal && Potrjuje != posel.Key)
    {
      Potrjuje = posel.Key;
      return;
    }
    Potrjuje = null;

    var akter = await AkterAsync();
    var vsa = IzbranoPodjetje == 0;
    IReadOnlyList<int> podjetja = vsa
      ? Podjetja.Select(podjetje => podjetje.Id).ToList()
      : [IzbranoPodjetje];
    if (podjetja.Count == 0 && posel.Kind != WorkerJobKind.Cycle)
    {
      Error = "Nobeno podjetje ni vključeno v avtomatiko. Podjetje najprej vključi na Alarmih in podjetjih.";
      return;
    }
    var oznaka = vsa ? "vsa vključena podjetja" : Podjetja.FirstOrDefault(podjetje => podjetje.Id == IzbranoPodjetje).Name ?? $"podjetje {IzbranoPodjetje}";
    // Posel s fiksnim podjetjem (izvoz kataloga, 213) izbiro prezre; oznaka naj pove, kaj je res teklo.
    if (posel.FixedOrganizationId is { } fiksno)
    {
      if (!VAvtomatiki(fiksno))
      {
        Error = $"Podjetje {fiksno} je izključeno iz avtomatike. Najprej ga vključi na Alarmih in podjetjih.";
        return;
      }
      oznaka = (Podjetja.FirstOrDefault(podjetje => podjetje.Id == fiksno).Name ?? $"podjetje {fiksno}") + " (vedno)";
    }
    if (posel.Kind == WorkerJobKind.Cycle) oznaka = "vsa podjetja (cikel)";

    try
    {
      var zagon = await Konzola.StartAsync(posel, podjetja, vsa, oznaka, akter);
      IzbraniId = zagon.Id;
      SamoTezaveIzpis = false;
      Message = $"{posel.Label} teče. Izpis je spodaj.";
    }
    catch (InvalidOperationException exception)
    {
      Error = exception.Message;
      return;
    }
    catch (Exception)
    {
      Error = "Zagona ni bilo mogoče začeti; baza ali mapa dnevnikov ni dosegljiva.";
      return;
    }

    await SledAsync(akter, "WORKER_RUN", $"Ročni zagon: {posel.Label} ({oznaka}).", posel.Key, vsa ? null : IzbranoPodjetje);
  }

  async Task PozeniCikelAsync(WorkerCycleRow cikel)
  {
    Message = null;
    Error = null;
    var posel = WorkerJobs.ForCycle(cikel.CycleKey);
    if (posel is null) { Error = $"Za cikel {cikel.CycleKey} ni posla."; return; }
    if (posel.Reach != WorkerJobReach.Internal && Potrjuje != "cikel:" + cikel.CycleKey)
    {
      Potrjuje = "cikel:" + cikel.CycleKey;
      return;
    }
    Potrjuje = null;

    var akter = await AkterAsync();
    try
    {
      var zagon = await Konzola.StartCycleAsync(posel, akter, scheduled: false);
      IzbraniId = zagon.Id;
      SamoTezaveIzpis = false;
      Message = $"{cikel.Label} teče. Izpis je spodaj.";
    }
    catch (InvalidOperationException exception) { Error = exception.Message; return; }
    catch (Exception) { Error = "Cikla ni bilo mogoče začeti; baza ali mapa dnevnikov ni dosegljiva."; return; }

    await SledAsync(akter, "WORKER_RUN", $"Ročni zagon cikla: {cikel.Label}.", cikel.CycleKey, null);
    await NaloziCikleAsync();
  }

  async Task UstaviAsync(WorkerRun zagon)
  {
    var akter = await AkterAsync();
    if (!Konzola.Cancel(zagon.Id, akter)) return;
    Message = $"{zagon.Job.Label}: proces se ustavlja.";
    await SledAsync(akter, "WORKER_CANCEL", $"Ročno ustavljen: {zagon.Job.Label}.", zagon.Job.Key, null);
  }

  async Task VklopiAsync(ScheduleRow vrstica)
  {
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      var akter = await AkterAsync();
      await Data.SaveScheduleAsync(vrstica.OrganizationId, vrstica.Pipeline, true, vrstica.IntervalSeconds, akter);
      // Ista sled kot na /sistem in /sistem/urniki: ops.ScheduleProfile hrani samo zadnjo spremembo.
      await Nadzor.LogActivityAsync(akter, "SCHEDULE_ENABLE", "Urnik", $"{vrstica.Pipeline} je vklopljen.",
        entityKey: vrstica.Pipeline, organizationId: vrstica.OrganizationId, oldValue: "izklopljen", newValue: "vklopljen");
      Message = $"{vrstica.Pipeline} za {vrstica.OrganizationName} je vklopljen.";
      Urniki = await Data.GetSchedulesAsync();
    }
    catch
    {
      Error = "Razporeda ni bilo mogoče vklopiti. Stanje ostaja nespremenjeno.";
    }
    finally { Busy = false; }
  }

  // ─── Razpored ciklov ────────────────────────────────────────────────────

  int Minute(WorkerCycleRow cikel) =>
    UrejeneMinute.TryGetValue(cikel.CycleKey, out var vrednost) ? vrednost : Math.Max(1, (cikel.IntervalSeconds ?? 60) / 60);

  string Ura(WorkerCycleRow cikel) =>
    UrejeneUre.TryGetValue(cikel.CycleKey, out var vrednost) ? vrednost : (cikel.DailyAtLocal ?? new TimeOnly(2, 30)).ToString("HH:mm");

  bool Spremenjen(WorkerCycleRow cikel) =>
    cikel.IntervalSeconds is not null
      ? UrejeneMinute.TryGetValue(cikel.CycleKey, out var minute) && minute != Math.Max(1, cikel.IntervalSeconds.Value / 60)
      : UrejeneUre.TryGetValue(cikel.CycleKey, out var ura) && ura != (cikel.DailyAtLocal ?? new TimeOnly(2, 30)).ToString("HH:mm");

  void NastaviMinute(string kljuc, string? vnos)
  {
    if (int.TryParse(vnos, out var minute) && minute is >= 1 and <= 1440) UrejeneMinute[kljuc] = minute;
  }

  void NastaviUro(string kljuc, string? vnos)
  {
    if (TimeOnly.TryParse(vnos, System.Globalization.CultureInfo.InvariantCulture, out var ura)) UrejeneUre[kljuc] = ura.ToString("HH:mm");
  }

  Task ShraniCikelAsync(WorkerCycleRow cikel) => ShraniCikelAsync(cikel, cikel.IsEnabled,
    cikel.IntervalSeconds is not null ? Minute(cikel) * 60 : null,
    cikel.IntervalSeconds is null ? TimeOnly.Parse(Ura(cikel), System.Globalization.CultureInfo.InvariantCulture) : null,
    "CYCLE_SCHEDULE",
    cikel.IntervalSeconds is not null ? $"{Math.Max(1, cikel.IntervalSeconds.Value / 60)} min" : cikel.DailyAtLocal?.ToString("HH:mm") ?? "",
    cikel.IntervalSeconds is not null ? $"{Minute(cikel)} min" : Ura(cikel));

  Task PreklopiCikelAsync(WorkerCycleRow cikel) => ShraniCikelAsync(cikel, !cikel.IsEnabled, cikel.IntervalSeconds, cikel.DailyAtLocal,
    cikel.IsEnabled ? "CYCLE_DISABLE" : "CYCLE_ENABLE", cikel.IsEnabled ? "vklopljen" : "izklopljen", cikel.IsEnabled ? "izklopljen" : "vklopljen");

  async Task ShraniCikelAsync(WorkerCycleRow cikel, bool vklopljen, int? sekunde, TimeOnly? ura, string dejanje, string staro, string novo)
  {
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      var akter = await AkterAsync();
      await Shramba.SaveCycleAsync(cikel.CycleKey, vklopljen, sekunde, ura, akter);
      var opis = sekunde is { } s ? $"vsakih {Math.Max(1, s / 60)} min" : $"vsak dan ob {ura:HH\\:mm}";
      Message = $"{cikel.Label}: {(vklopljen ? "vklopljen" : "izklopljen")}, {opis}. Velja od naslednjega tika razporejevalnika.";
      await SledAsync(akter, dejanje, $"Cikel {cikel.Label}: {Message}", cikel.CycleKey, null, staro, novo);
      await NaloziCikleAsync();
    }
    catch (Exception exception)
    {
      Error = "Spremembe cikla ni bilo mogoče shraniti: " + exception.Message;
    }
    finally { Busy = false; }
  }

  async Task OdpriKorakeAsync(long runId)
  {
    if (OdprtZagon == runId) { OdprtZagon = null; Koraki = []; return; }
    try { Koraki = await Shramba.GetStepsAsync(runId); OdprtZagon = runId; }
    catch { Error = "Korakov zagona ni mogoče prebrati."; }
  }

  async Task SledAsync(string akter, string dejanje, string opis, string kljuc, int? podjetje, string? staro = null, string? novo = null)
  {
    try
    {
      await Nadzor.LogActivityAsync(akter, dejanje, "Worker", opis, entityKey: kljuc, organizationId: podjetje, oldValue: staro, newValue: novo);
    }
    catch
    {
      Error = "Dejanje je izvedeno, sled v dnevniku sprememb pa ni zapisana.";
    }
  }

  bool VAvtomatiki(int organizationId) => Avtomatika.Count == 0 || Avtomatika.Any(podjetje => podjetje.OrganizationId == organizationId && podjetje.IsAutomationEnabled);

  List<ScheduleRow> Izklopljeni(WorkerJob posel) => Urniki
    .Where(vrstica => VAvtomatiki(vrstica.OrganizationId) && posel.Pipelines.Contains(vrstica.Pipeline) && !vrstica.IsEnabled
      && (IzbranoPodjetje == 0 || vrstica.OrganizationId == IzbranoPodjetje))
    .ToList();

  // Najstarejši zadnji uspeh in ne najnovejši: posel z več postopki je svež le toliko, kolikor je
  // svež njegov najšibkejši člen. Postopek, ki ni uspel nikoli, naredi celoto "nikoli".
  (DateTime? OldestSuccess, string? Error)? ZadnjeStanje(WorkerJob posel)
  {
    var vrstice = Urniki
      .Where(vrstica => VAvtomatiki(vrstica.OrganizationId) && posel.Pipelines.Contains(vrstica.Pipeline) && (IzbranoPodjetje == 0 || vrstica.OrganizationId == IzbranoPodjetje))
      .ToList();
    if (vrstice.Count == 0) return null;

    DateTime? najstarejsi = vrstice.Any(vrstica => vrstica.LastSuccessfulRunUtc is null)
      ? null
      : vrstice.Min(vrstica => vrstica.LastSuccessfulRunUtc);
    var napaka = vrstice
      .Where(vrstica => vrstica.Status == "Failed")
      .OrderByDescending(vrstica => vrstica.LastFailedRunUtc)
      .Select(vrstica => $"{vrstica.Pipeline} · {vrstica.OrganizationName}: {vrstica.LastErrorRedacted ?? "neuspešno"}")
      .FirstOrDefault();
    return (najstarejsi, napaka);
  }

  DateTime? ZadnjiDnevnik(string predpona) => (Dnevniki ?? [])
    .Where(dnevnik => dnevnik.Kind is not ("rocno" or "cikli") && Path.GetFileName(dnevnik.RelativePath).StartsWith(predpona, StringComparison.OrdinalIgnoreCase))
    .Select(dnevnik => (DateTime?)dnevnik.LastWriteUtc)
    .FirstOrDefault();

  void PokaziIzpis(WorkerRun zagon) => IzbraniId = zagon.Id;

  void OdpriDnevnik(string pot)
  {
    var vrstice = Konzola.ReadLog(pot);
    if (vrstice is null)
    {
      Error = "Dnevnika ni mogoče prebrati.";
      return;
    }
    OdprtDnevnik = pot;
    VrsticeDnevnika = vrstice.Select(vrstica => new WorkerLogLine(vrstica, WorkerLogs.Classify(vrstica))).ToList();
  }

  void ZapriDnevnik()
  {
    OdprtDnevnik = null;
    VrsticeDnevnika = [];
  }

  string RelativnaPot(string pot) =>
    Konzola.Setup.LogRoot.Length > 0 ? Path.GetRelativePath(Konzola.Setup.LogRoot, pot) : pot;

  async Task<string> AkterAsync() =>
    (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";

  // ─── Oznake ─────────────────────────────────────────────────────────────

  (string Text, string? Tone) StanjeRazporejevalnika()
  {
    var stanje = Stanje;
    if (!stanje.Enabled) return ("Izklopljen z nastavitvijo", "bad");
    if (stanje.IsOwner) return ("Teče v tej aplikaciji", "good");
    if (stanje.Lease is { } najem && najem.IsLive(DateTime.UtcNow)) return ($"Teče drugje: {najem.Owner}", "warn");
    if (stanje.LastTickUtc is null) return ("Zaganja se", "warn");
    return stanje.Lease is { } potekel
      ? ($"Ne teče — najem je potekel {PimFormat.Ago(potekel.ExpiresUtc)}", "bad")
      : ("Ne teče — brez najema", "bad");
  }

  static CycleLag Ritem(WorkerCycleRow cikel) => WorkerCycles.Evaluate(
    cikel.IsEnabled, cikel.RunningRunId is not null, cikel.LastStartedUtc, cikel.UpdatedUtc,
    cikel.IntervalSeconds, cikel.WarnAfterMultiplier, DateTime.UtcNow);

  static string RitemOznaka(CycleLag ritem) => ritem.State switch
  {
    CycleRhythm.Off => "Izklopljen",
    CycleRhythm.Running => "Teče",
    CycleRhythm.Never => "Še ni tekel",
    CycleRhythm.Ok => "V ritmu",
    CycleRhythm.Late => $"Zamuja {Trajanje(ritem.Behind ?? TimeSpan.Zero)}",
    CycleRhythm.Overdue => $"ZASTAL {Trajanje(ritem.Behind ?? TimeSpan.Zero)} čez razmik",
    _ => ritem.State.ToString(),
  };

  static string? RitemTon(CycleLag ritem) => ritem.State switch
  {
    CycleRhythm.Ok => "good",
    CycleRhythm.Running or CycleRhythm.Late => "warn",
    CycleRhythm.Overdue => "bad",
    _ => null,
  };

  static string Trajanje(TimeSpan trajanje) => PimTime.Duration((long)Math.Max(0, trajanje.TotalMilliseconds));

  static string Sprozilec(string? vrednost) => vrednost switch
  {
    "Scheduler" => "razporejevalnik",
    "Human" => "ročno",
    "Task" => "Windows naloga",
    null or "" => "—",
    _ => vrednost,
  };

  static string StatusCikla(string? status) => status switch
  {
    "Running" => "Teče",
    "Succeeded" => "Uspešno",
    "Failed" => "Napaka",
    "Cancelled" => "Ustavljeno",
    "Abandoned" => "Zapuščeno",
    null or "" => "—",
    _ => status,
  };

  static string StatusKoraka(string status) => status switch
  {
    "Succeeded" => "Uspešno",
    "Failed" => "Napaka",
    "Skipped" => "Preskočeno",
    "Cancelled" => "Ustavljeno",
    _ => status,
  };

  static string? TonCikla(string? status) => status switch
  {
    "Succeeded" => "good",
    "Running" => "warn",
    "Failed" or "Abandoned" => "bad",
    _ => null,
  };

  static string Ton(LogLineTone ton) => ton switch
  {
    LogLineTone.Error => "line-error",
    LogLineTone.Warning => "line-warn",
    LogLineTone.Header => "line-header",
    LogLineTone.Success => "line-ok",
    _ => "",
  };

  static string StatusOznaka(WorkerRunStatus status) => status switch
  {
    WorkerRunStatus.Running => "Teče",
    WorkerRunStatus.Succeeded => "Uspešno",
    WorkerRunStatus.Failed => "Napaka",
    WorkerRunStatus.Cancelled => "Ustavljeno",
    _ => status.ToString(),
  };

  static string? StatusTon(WorkerRunStatus status) => status switch
  {
    WorkerRunStatus.Running => "warn",
    WorkerRunStatus.Succeeded => "good",
    WorkerRunStatus.Failed => "bad",
    _ => null,
  };

  static string Velikost(long bajtov) =>
    bajtov < 1024 ? $"{bajtov} B"
    : bajtov < 1024 * 1024 ? $"{bajtov / 1024.0:N0} KB"
    : $"{bajtov / 1048576.0:N1} MB";

  static string Skrajsaj(string besedilo) => besedilo.Length <= 140 ? besedilo : besedilo[..137] + "…";

  public void Dispose()
  {
    ustavi.Cancel();
    ustavi.Dispose();
  }
}
