@page "/stranke"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@inject PIM.Intranet.Services.IntranetDataService Data
<PageTitle>Stranke</PageTitle>
<div class="page-header"><div><h1>Stranke</h1><p>Pregled strank in njihovih B2B nastavitev v aktivni organizaciji.</p></div></div>
<div class="page-tabs"><button class="page-tab @(Kind==""?"active":null)" @onclick='()=>SetKind("")'>Vse stranke (@(Rows?.Count ?? 0))</button><button class="page-tab @(Kind=="CUSTOMER"?"active":null)" @onclick='()=>SetKind("CUSTOMER")'>Kupci</button><button class="page-tab @(Kind=="SUPPLIER"?"active":null)" @onclick='()=>SetKind("SUPPLIER")'>Dobavitelji</button><button class="page-tab @(Kind=="BOTH"?"active":null)" @onclick='()=>SetKind("BOTH")'>Oboje</button></div>
<section class="ui-card toolbar"><label class="visually-hidden" for="customer-search">Poišči stranko</label><input id="customer-search" class="search-input" placeholder="Poišči po šifri ali nazivu …" @bind="Search" @bind:event="oninput"/><label class="visually-hidden" for="customer-type">Tip stranke</label><select id="customer-type" class="filter-select" @bind="Type"><option value="">Vsi tipi</option>@foreach(var type in Types){<option value="@type">@type</option>}</select><span class="result-count">@Filtered.Count rezultatov</span></section>
<section class="ui-card data-card">@if(Loading){<div class="loading-state">Nalaganje strank …</div>}else if(Error is not null){<div class="error-state" role="alert">@Error</div>}else if(Filtered.Count==0){<div class="empty-state">Za izbrane filtre ni strank.</div>}else{<table class="data-table"><caption>Stranke v aktivni organizaciji</caption><thead><tr><th>Šifra</th><th>Naziv</th><th>Vrsta</th><th>Tip stranke</th><th>Magento skupina</th><th>B2B+</th><th>Splet</th><th><span class="visually-hidden">Dejanje</span></th></tr></thead><tbody>@foreach(var row in PageRows){<tr><td><a href="stranke/@row.CustomerId">@row.CustomerKey</a></td><td>@row.Name</td><td>@KindLabel(row.CustomerKind)</td><td>@(row.CustomerType??"—")</td><td>@(row.MagentoGroupKey??"—")</td><td><span class="status-chip @(row.B2bPlusEnabled?"good":null)">@(row.B2bPlusEnabled?"Da":"Ne")</span></td><td><span class="status-chip @(row.WebEnabled?"good":null)">@(row.WebEnabled?"Omogočen":"Onemogočen")</span></td><td><a href="stranke/@row.CustomerId" aria-label="Odpri stranko @row.Name">›</a></td></tr>}</tbody></table><nav class="pagination" aria-label="Strani naloženih strank"><button disabled="@(Page==0)" @onclick="Previous">Prejšnja</button><span>Stran @(Page+1) od @PageCount</span><button disabled="@(Page+1>=PageCount)" @onclick="Next">Naslednja</button></nav>}</section>
@code{IReadOnlyList<PIM.Intranet.Services.CustomerRow>? Rows;bool Loading=true;string? Error;string Search="",Kind="",Type="";int Page;const int PageSize=25;IEnumerable<string> Types=>(Rows??[]).Select(x=>x.CustomerType).Where(x=>!string.IsNullOrWhiteSpace(x)).Select(x=>x!).Distinct().Order();IReadOnlyList<PIM.Intranet.Services.CustomerRow> Filtered=>(Rows??[]).Where(x=>(Kind==""||x.CustomerKind==Kind)&&(Type==""||x.CustomerType==Type)&&(Search==""||x.CustomerKey.Contains(Search,StringComparison.OrdinalIgnoreCase)||x.Name.Contains(Search,StringComparison.OrdinalIgnoreCase))).ToList();IEnumerable<PIM.Intranet.Services.CustomerRow> PageRows=>Filtered.Skip(Page*PageSize).Take(PageSize);int PageCount=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/(decimal)PageSize));protected override async Task OnInitializedAsync(){try{var org=await Data.GetCurrentOrganizationAsync();if(org is null){Error="Aktivna organizacija ni na voljo.";return;}Rows=await Data.GetCustomersAsync(org.OrganizationId);}catch{Error="Strank trenutno ni mogoče naložiti.";}finally{Loading=false;}}void SetKind(string value){Kind=value;Page=0;}void Previous()=>Page=Math.Max(0,Page-1);void Next()=>Page=Math.Min(PageCount-1,Page+1);static string KindLabel(string? value)=>value switch{"CUSTOMER"=>"Kupec","SUPPLIER"=>"Dobavitelj","BOTH"=>"Kupec in dobavitelj",_=>"—"};}
