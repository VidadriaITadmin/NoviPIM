@page "/cene/tisk"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PriceSheetService Sheet
@inject IntranetDataService Data
@inject CatalogReadService Catalog
@inject IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>Cenik za tisk</PageTitle>
<div class="no-print">
  <PimPage Title="Cenik za tisk" Subtitle="Digitalni cenik iz kategorije ali izbranih artiklov. Natisni ali shrani kot PDF z ukazom brskalnika (Ctrl+P → Shrani kot PDF)." Crumbs="Crumbs" />

  <section class="ui-card toolbar section-gap" role="search" aria-label="Izbira cenika">
    <label class="visually-hidden" for="sheet-organization">Podjetje</label>
    <select id="sheet-organization" class="filter-select" @bind="OrganizationId" @bind:after="ChangedAsync">
      @foreach (var organization in Organizations) { <option value="@organization.OrganizationId">@organization.Name</option> }
    </select>
    <label class="visually-hidden" for="sheet-pricelist">Cenik</label>
    <select id="sheet-pricelist" class="filter-select" @bind="PriceList" @bind:after="ChangedAsync">
      <option value="B2C">B2C (maloprodaja)</option>
      <option value="B2B">B2B (veleprodaja)</option>
    </select>
    <label class="visually-hidden" for="sheet-language">Jezik</label>
    <select id="sheet-language" class="filter-select" @bind="Language" @bind:after="ChangedAsync">
      @foreach (var language in Languages) { <option value="@language">@language</option> }
    </select>
    <label class="visually-hidden" for="sheet-site">Spletno mesto</label>
    <select id="sheet-site" class="filter-select" @bind="WebSite" @bind:after="ChangedAsync">
      <option value="">Vsa spletna mesta</option>
      @foreach (var site in Sites) { <option value="@site.WebSiteCode">@site.WebSiteName</option> }
    </select>
    @* #113: besedilni polji se uveljavita ob »change« (Enter ali izhod iz polja), ne na vsak pritisk tipke. *@
    <label class="visually-hidden" for="sheet-category">Kategorija (pot)</label>
    <input id="sheet-category" class="form-input" placeholder="Kategorija, npr. Notranja svetila > Viseča svetila" @bind="CategoryPath" @bind:after="ChangedAsync" />
    <label class="visually-hidden" for="sheet-items">Šifre artiklov</label>
    <input id="sheet-items" class="form-input" placeholder="Ali šifre, ločene z vejico ali novo vrstico" @bind="ItemIdsText" @bind:after="ChangedAsync" />
    <label class="filter-check"><input type="checkbox" @bind="OnlyPublished" @bind:after="ChangedAsync" /> samo objavljeni</label>
    <label class="filter-check"><input type="checkbox" @bind="ShowImages" @bind:after="ChangedAsync" /> s slikami</label>
    <button type="button" class="filter-button" disabled="@Loading" @onclick="PrepareAsync">@(Loaded ? "Osveži cenik" : "Pripravi cenik")</button>
    <button type="button" class="primary-button" disabled="@(Rows.Count == 0 || Loading)" @onclick="PrintAsync">Natisni / PDF</button>
  </section>
  @if (!Loaded && !Loading && Error is null)
  {
    <p class="hint" role="status">Vpiši kategorijo ali šifre in pritisni Enter, cenik se pripravi sam. Za cel cenik podjetja klikni »Pripravi cenik«.</p>
  }
  @if (Loaded && Rows.Count >= MaxRows)
  {
    <p class="message-state warn-message" role="status">Prikazanih je prvih @MaxRows.ToString("N0") artiklov. Zoži izbiro s kategorijo ali šiframi.</p>
  }
  @if (Loaded && Rows.Count > 0 && MissingItems.Count > 0)
  {
    @* #107: del vpisanih šifer ni v ceniku — povej katere, ne tiho izpusti. *@
    <p class="message-state warn-message" role="status">
      @PimFormat.Count(MissingItems.Count, "vpisana šifra ni", "vpisani šifri nista", "vpisane šifre niso", "vpisanih šifer ni") v ceniku @PriceList: @string.Join(", ", MissingItems.Take(20))@(MissingItems.Count > 20 ? " …" : "").
      Šifra ne obstaja v tem podjetju, nima cene v tem ceniku@(OnlyPublished ? " ali ni objavljena (odkljukaj »samo objavljeni«)" : "").
    </p>
  }
  @if (Loaded && Language != "sl")
  {
    <p class="hint" role="status">Nazivi so v jeziku »@Language«, kjer prevod obstaja; artikli brez prevoda ostanejo s slovenskim nazivom.</p>
  }
</div>

<section class="ui-card data-card price-sheet" aria-label="Cenik">
  <header class="sheet-head">
    <h2>@(Organizations.FirstOrDefault(organization => organization.OrganizationId == OrganizationId)?.Name) — cenik @PriceList</h2>
    <span>@DateTime.Now.ToString("dd.MM.yyyy") · @PimFormat.Count(Rows.Count, "artikel", "artikla", "artikli", "artiklov") · cene v EUR @(PriceList == "B2C" ? "z DDV" : "brez DDV")</span>
  </header>
  <PimState Loading="Loading" Error="@Error" Empty="@(Loaded && Rows.Count == 0)" EmptyText="@EmptyMessage" LoadingText="Priprava cenika …">
    @foreach (var group in Rows.GroupBy(row => row.CategoryPath ?? "Brez kategorije"))
    {
      <h3 class="sheet-category">@group.Key</h3>
      <table class="sheet-table">
        <thead><tr>@if (ShowImages) { <th></th> }<th>Šifra</th><th>Naziv</th><th>Proizvajalec</th><th class="numeric">Cena brez DDV</th><th class="numeric">DDV %</th><th class="numeric">Cena z DDV</th><th class="numeric">Zaloga</th></tr></thead>
        <tbody>
          @foreach (var row in group)
          {
            <tr>
              @if (ShowImages) { <td class="sheet-image">@if (row.ImageUrl is not null) { <img src="@(MediaUrlPolicy.Normalize(row.ImageUrl).Href ?? row.ImageUrl)" alt="" loading="lazy" /> }</td> }
              <td class="code-value">@row.ItemID<div class="tree-path">@row.EAN</div></td>
              <td>@row.Title</td>
              <td>@row.Manufacturer</td>
              <td class="numeric">@(row.Net?.ToString("N2") ?? "—")</td>
              <td class="numeric">@(row.VatRate?.ToString("N0") ?? "—")</td>
              <td class="numeric"><strong>@(row.Gross?.ToString("N2") ?? "—")</strong></td>
              <td class="numeric">@(row.Stock?.ToString("N0") ?? "—")</td>
            </tr>
          }
        </tbody>
      </table>
    }
  </PimState>
</section>

@code {
  const int MaxRows = 2000;
  static readonly string[] Languages = ["sl", "en", "de", "hr", "it"];
  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Cene in ceniki", "cene"), new("Cenik za tisk")];
  IReadOnlyList<OrganizationContext> Organizations = [];
  IReadOnlyList<WebSiteRow> Sites = [];
  IReadOnlyList<PriceSheetService.SheetRow> Rows = [];
  int OrganizationId;
  string PriceList = "B2C";
  string Language = "sl";
  string WebSite = "";
  string CategoryPath = "";
  string ItemIdsText = "";
  bool OnlyPublished = true;
  bool ShowImages;
  bool Loading;
  bool Loaded;
  string? Error;
  // #113: izbira, s katero je bil pripravljen prikazani cenik (ista izbira se ne bere znova).
  string? LoadedState;
  int loadVersion;
  bool UrlRead;

  // #113: vsa izbira je v naslovu — povezava odpre isti cenik, »Nazaj« v brskalniku vrne prejšnjo izbiro.
  [SupplyParameterFromQuery(Name = "podjetje")] public int? QueryOrganization { get; set; }
  [SupplyParameterFromQuery(Name = "cenik")] public string? QueryPriceList { get; set; }
  [SupplyParameterFromQuery(Name = "jezik")] public string? QueryLanguage { get; set; }
  [SupplyParameterFromQuery(Name = "mesto")] public string? QueryWebSite { get; set; }
  [SupplyParameterFromQuery(Name = "kategorija")] public string? QueryCategory { get; set; }
  [SupplyParameterFromQuery(Name = "sifre")] public string? QueryItems { get; set; }
  [SupplyParameterFromQuery(Name = "vsi")] public string? QueryAll { get; set; }
  [SupplyParameterFromQuery(Name = "slike")] public string? QueryImages { get; set; }
  [SupplyParameterFromQuery(Name = "pripravi")] public string? QueryPrepare { get; set; }

  /// <summary>Izbira, ki vpliva na vsebino cenika (»s slikami« spremeni samo prikaz).</summary>
  string DataState => string.Join("|", OrganizationId, PriceList, Language, WebSite, CategoryPath.Trim(), ItemIdsText.Trim(), OnlyPublished);
  bool HasScope => !string.IsNullOrWhiteSpace(CategoryPath) || !string.IsNullOrWhiteSpace(ItemIdsText);
  bool WantsLoad => HasScope || QueryPrepare == "1";

  protected override async Task OnInitializedAsync()
  {
    try
    {
      Organizations = await Data.GetOrganizationsAsync();
      Sites = await Catalog.GetWebSitesAsync();
    }
    catch (Exception exception) { Error = exception.Message; }
    ReadUrl();
    // Predupodabljanje (brez povezave) cenika ne bere — sicer bi se naložil dvakrat.
    if (!RendererInfo.IsInteractive) return;
    UrlRead = true;
    if (WantsLoad) await LoadAsync();
  }

  /// <summary>»Nazaj«/»Naprej« v brskalniku ali ročno spremenjen naslov: preberi izbiro in cenik pripravi znova.</summary>
  protected override async Task OnParametersSetAsync()
  {
    if (!UrlRead) return;
    var before = DataState + "|" + ShowImages;
    ReadUrl();
    if (DataState + "|" + ShowImages == before) return;
    if (WantsLoad) { if (LoadedState != DataState) await LoadAsync(); }
    else { Rows = []; Loaded = false; LoadedState = null; }
  }

  void ReadUrl()
  {
    OrganizationId = QueryOrganization is { } requested && Organizations.Any(organization => organization.OrganizationId == requested)
      ? requested
      : Organizations.FirstOrDefault(organization => organization.OrganizationId == 3)?.OrganizationId ?? Organizations.FirstOrDefault()?.OrganizationId ?? 0;
    PriceList = QueryPriceList == "B2B" ? "B2B" : "B2C";
    Language = QueryLanguage is { } language && Languages.Contains(language) ? language : "sl";
    WebSite = QueryWebSite is { } site && Sites.Any(row => row.WebSiteCode == site) ? site : "";
    CategoryPath = QueryCategory ?? "";
    ItemIdsText = QueryItems ?? "";
    OnlyPublished = QueryAll != "1";
    ShowImages = QueryImages == "1";
  }

  /// <summary>#113: izbira v naslov (vzorec SyncUrl na /cene) — podjetje je vedno v njem, da deljena povezava ne pomeša podjetij.</summary>
  void SyncUrl()
  {
    var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
      ["podjetje"] = OrganizationId == 0 ? null : OrganizationId,
      ["cenik"] = PriceList == "B2C" ? null : PriceList,
      ["jezik"] = Language == "sl" ? null : Language,
      ["mesto"] = Blank(WebSite),
      ["kategorija"] = Blank(CategoryPath),
      ["sifre"] = Blank(ItemIdsText),
      ["vsi"] = OnlyPublished ? null : "1",
      ["slike"] = ShowImages ? "1" : null,
      ["pripravi"] = Loaded && !HasScope ? "1" : null,
    });
    if (!string.Equals(uri, Navigation.Uri, StringComparison.Ordinal)) Navigation.NavigateTo(uri);
  }

  // #107: šifre, s katerimi je bil pripravljen prikazani cenik (za sporočilo o manjkajočih).
  IReadOnlyList<string> LoadedItems = [];
  IReadOnlyList<string> LoadedCategory = [];

  /// <summary>#107: vpisane šifre, ki jih v pripravljenem ceniku ni.</summary>
  IReadOnlyList<string> MissingItems => LoadedItems.Count == 0 ? []
    : LoadedItems.Except(Rows.Select(row => row.ItemID), StringComparer.OrdinalIgnoreCase).ToList();

  /// <summary>#107: prazen cenik pove, zakaj je prazen in kaj narediti — ne tiha praznina.</summary>
  string EmptyMessage
  {
    get
    {
      var organization = Organizations.FirstOrDefault(row => row.OrganizationId == OrganizationId)?.Name ?? "izbranem podjetju";
      var site = string.IsNullOrEmpty(WebSite) ? "" : $" na spletnem mestu »{Sites.FirstOrDefault(row => row.WebSiteCode == WebSite)?.WebSiteName ?? WebSite}«";
      var published = OnlyPublished ? " Poskusi brez kljukice »samo objavljeni«." : "";
      if (LoadedItems.Count > 0)
        return $"Nobena od vpisanih šifer ({PimFormat.Count(LoadedItems.Count, "šifra", "šifri", "šifre", "šifer")}) nima cene v ceniku {PriceList} podjetja {organization}. Preveri šifre (npr. {LoadedItems[0]}) ali izberi drug cenik ali podjetje.{published}";
      if (LoadedCategory.Count > 0)
        return $"V kategoriji »{LoadedCategory[0]}«{site} ni artiklov s ceno v ceniku {PriceList} podjetja {organization}. Pot kategorije mora biti natančna, npr. »Notranja svetila > Viseča svetila« (velja tudi za vse podkategorije).{published}";
      return $"Podjetje {organization} nima artiklov s ceno v ceniku {PriceList}{site}.{published}";
    }
  }

  static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

  /// <summary>
  /// #113: sprememba izbire se takoj zapiše v naslov. Z obsegom (kategorija ali šifre) ali že pripravljenim
  /// cenikom se cenik osveži sam; brez obsega (cel cenik podjetja, do 2000 vrstic) počaka na gumb.
  /// </summary>
  async Task ChangedAsync()
  {
    if ((HasScope || Loaded) && LoadedState != DataState) await LoadAsync();
    SyncUrl();
  }

  async Task PrepareAsync()
  {
    await LoadAsync();
    SyncUrl();
  }

  async Task LoadAsync()
  {
    var version = ++loadVersion;
    var state = DataState;
    Loading = true; Error = null;
    try
    {
      var items = ItemIdsText.Split([',', ';', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
      var rows = await Sheet.GetSheetAsync(OrganizationId, PriceList, Language, WebSite, CategoryPath.Trim(), items, OnlyPublished, MaxRows);
      // Hitra zaporedna sprememba: velja samo zadnja poizvedba.
      if (version != loadVersion) return;
      Rows = rows;
      LoadedItems = items.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
      LoadedCategory = string.IsNullOrWhiteSpace(CategoryPath) ? [] : [CategoryPath.Trim()];
      Loaded = true;
      LoadedState = state;
    }
    catch (Exception exception)
    {
      if (version != loadVersion) return;
      Error = exception.Message; Rows = []; LoadedState = null;
    }
    finally { if (version == loadVersion) Loading = false; }
  }

  async Task PrintAsync()
  {
    try { await Js.InvokeVoidAsync("window.print"); } catch { }
  }
}
