  /// <summary>
  /// Izdelki, na katere gre dejanje: posamezno izbrani ali — pri »vse po filtru« — ves pogled, prebran
  /// s strežnika po straneh po 20.000 (isti filter kot seznam in izvoz).
  /// </summary>
  async Task<List<ProductBulkEdit.Target>> CollectTargetsAsync(bool wholeView, CancellationToken cancellationToken)
  {
    if (!wholeView && !Selection.AllMatching)
      return Selection.Items.Select(item => new ProductBulkEdit.Target(item.OrganizationId, item.OrganizationName, item.ItemId)).ToList();
    var targets = new List<ProductBulkEdit.Target>();
    var filter = BuildExportFilter();
    for (var skip = 0; ; skip += 20_000)
    {
      cancellationToken.ThrowIfCancellationRequested();
      var page = await Workbench.GetProductListAsync(filter with { Skip = skip, Take = 20_000 });
      targets.AddRange(page.Rows.Select(row => new ProductBulkEdit.Target(row.OrganizationId, row.OrganizationName, row.ItemId)));
      if (page.Rows.Count == 0 || targets.Count >= page.TotalCount) break;
    }
    return targets;
  }

  async Task PreviewEditAsync()
  {
    if (EditColumn is not { } column || EditCellValue is not { } value || EditValidation is not null) return;
    EditBusy = true; EditError = null; EditPreview = null; EditSummary = null; EditResult = null;
    EditCancel?.Dispose();
    EditCancel = new CancellationTokenSource();
    var token = EditCancel.Token;
    try
    {
      // Pravica se preveri že pred branjem — Komerciala do sem ne pride niti mimo gumba.
      await Guard.RequireAsync(PimPolicies.CatalogWrite);
      EditMessage = Selection.AllMatching ? $"Zbiram izdelke filtra ({Selection.Count:N0}) …" : "Zbiram izbrane izdelke …";
      StateHasChanged();
      var targets = await CollectTargetsAsync(false, token);
      EditSelectedCount = targets.Count;
      EditMessage = $"Berem trenutno stanje {targets.Count:N0} izdelkov in pripravljam predogled …";
      StateHasChanged();
      using (await EnterEditLaneAsync(token))
        EditPreview = await ProductBulkEdit.PreviewAsync(Workbook, column, targets, value, EditMode, token);
      EditSummary = ProductBulkEdit.Summarize(EditPreview, column.FieldKey, targets.Count);
    }
    catch (OperationCanceledException) { EditError = "Predogled preklican. Nič ni zapisano."; EditPreview = null; }
    catch (UnauthorizedAccessException) { EditError = "Za paketno urejanje polj nimaš pravice (urednik kataloga ali skrbnik)."; EditPreview = null; }
    catch (WorkbookReadException failure) { EditError = failure.Message; EditPreview = null; }
    catch (Exception failure) { EditError = "Predogleda ni bilo mogoče pripraviti: " + failure.Message; EditPreview = null; }
    finally { EditBusy = false; EditMessage = null; }
  }

  async Task<IDisposable> EnterEditLaneAsync(CancellationToken cancellationToken)
  {
    if (Gate.Imports.TryEnter() is { } immediate) return immediate;
    EditMessage = $"Čakam v vrsti — hkrati tečeta največ {Gate.Imports.Limit} uvoza, pred tabo: {Gate.Imports.Waiting}. Začel se bo sam.";
    StateHasChanged();
    return await Gate.Imports.EnterAsync(cancellationToken);
  }

  async Task ApplyEditAsync()
  {
    if (EditPreview is null) return;
    EditBusy = true; EditWriting = true; EditError = null; EditCancelRequested = false;
    EditResultColumn = EditColumn;
    EditCancel?.Dispose();
    EditCancel = new CancellationTokenSource();
    var token = EditCancel.Token;
    try
    {
      var actor = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";
      var progress = new Progress<string>(text => { EditMessage = text; _ = InvokeAsync(StateHasChanged); });
      EditMessage = "Zapisujem …";
      StateHasChanged();
      // Zapis po paketih (ProductBulkEdit.ChunkSize): najprej zgodovina, nato paket za paketom z
      // napredkom; preklic velja med paketi.
      using (await EnterEditLaneAsync(token))
        EditResult = await ProductBulkEdit.ApplyAsync(Guard, Workbook, History, Withdrawals, EditPreview, actor,
          string.IsNullOrWhiteSpace(EditNote) ? null : EditNote.Trim(), progress, token);
      // Predogled se umakne, da drugi klik istega gumba paketa ne zapiše dvakrat.
      EditPreview = null; EditSummary = null;
      await ReloadListAsync();
    }
    catch (OperationCanceledException) { EditError = "Zapis preklican, preden se je začel. Nič ni zapisano."; }
    catch (UnauthorizedAccessException) { EditError = "Za paketno urejanje polj nimaš pravice (urednik kataloga ali skrbnik)."; }
    catch (Exception failure) { EditError = "Zapis ni uspel: " + failure.Message; }
    finally { EditBusy = false; EditWriting = false; EditCancelRequested = false; EditMessage = null; }
  }

  string EditResultText(ProductBulkEdit.Result result)
  {
    if (result.Outcome is not { } outcome)
      return result.Failure is null ? "Ni bilo kaj zapisati." : "Zapis se je ustavil: " + result.Failure;
    var text = $"Zapisano: {PimFormat.Count(outcome.PimChanges, "vrednost", "vrednosti", "vrednosti", "vrednosti")} na "
      + $"{PimFormat.Count(outcome.RowsTouched, "izdelku", "izdelkih", "izdelkih", "izdelkih")}. Validacija je ponovljena za spremenjene izdelke "
      + "(stolpec Splet v seznamu).";
    if (EditResultColumn is { } column) text += " " + ProductBulkEdit.WebNote(column);
    if (result.Withdrawn > 0) text += $" Samodejni umik s spleta: {result.Withdrawn:N0} (glej Splet → Umaknjeni).";
    if (result.Failure is not null) text += " " + result.Failure;
    return text;
  }

  /// <summary>Seznam znova, da stolpca ERP/Splet in »Zadnja sprememba« pokažeta stanje po zapisu.</summary>
  async Task ReloadListAsync()
  {
    var filter = CurrentFilter();
    try
    {
      Page = await Workbench.GetProductListAsync(filter);
      PageFilter = filter;
      StaleWarning = null;
      Selection.UpdateFilter(Href(page: 1), Page.TotalCount);
    }
    catch (Exception failure)
    {
      // Zapis je že uspel; ne uspe le osvežitev prikaza. Zadetki ostanejo, uporabnik pa izve,
      // da stolpci morda še ne kažejo stanja po zapisu.
      Log.LogWarning(failure, "Osvežitev seznama izdelkov po zapisu ni uspela ({Kind}). Iskanje={Search}, podjetje={Organization}",
        FailureKind(failure), filter.Search, filter.OrganizationId?.ToString() ?? "vsa");
      StaleWarning = "Seznama po zapisu ni bilo mogoče osvežiti; stolpci morda še ne kažejo novega stanja.";
    }
  }

