  string Href(string? view = null, string? search = null, string? organization = null, string? manufacturer = null,
    string? supplier = null, string? group = null, string? department = null, string? erp = null, string? web = null,
    string? activity = null, string? webPublish = null, string? completeness = null, string? image = null,
    string? category = null, string? sort = null, string? direction = null, int? page = null,
    string? packaging = null, string? discountGroup = null, string? special = null)
  {
    var parameters = new List<string>();
    Add("pogled", Resolve(view, ActiveView == "ALL" ? null : ActiveView));
    Add("isci", Resolve(search, QuerySearch));
    Add("podjetje", Resolve(organization, QueryOrganization));
    Add("proizvajalec", Resolve(manufacturer, QueryManufacturer));
    Add("dobavitelj", Resolve(supplier, QuerySupplier));
    Add("skupina", Resolve(group, QueryGroup));
    Add("oddelek", Resolve(department, QueryDepartment));
    Add("erp", Resolve(erp, QueryErp));
    Add("splet", Resolve(web, QueryWeb));
    Add("aktivnost", Resolve(activity, QueryActivity));
    Add("objava", Resolve(webPublish, QueryWebPublish));
    Add("popolnost", Resolve(completeness, QueryCompleteness));
    Add("slika", Resolve(image, QueryImage));
    Add("kategorija", Resolve(category, QueryCategory));
    Add("spopust", Resolve(packaging, QueryPackaging));
    Add("rabatna", Resolve(discountGroup, QueryDiscountGroup));
    Add("posebni", Resolve(special, QuerySpecial));
    Add("sort", Resolve(sort, QuerySort));
    Add("smer", Resolve(direction, QueryDirection));
    var resolvedPage = page ?? (view is null && search is null && organization is null && manufacturer is null
      && supplier is null && group is null && department is null && erp is null && web is null && activity is null
      && webPublish is null && completeness is null && image is null && sort is null && direction is null
      && packaging is null && discountGroup is null && special is null ? QueryPage : null);
    if (resolvedPage is > 1) parameters.Add("stran=" + resolvedPage);

    return parameters.Count == 0 ? "izdelki" : "izdelki?" + string.Join('&', parameters);

    void Add(string name, string? value)
    {
      if (!string.IsNullOrWhiteSpace(value)) parameters.Add(name + "=" + Uri.EscapeDataString(value));
    }

    static string? Resolve(string? requested, string? current) => requested is null ? current : requested;
  }

