  ProductListFilter CurrentFilter() => new(
    OrganizationScope, Skip, Take, QuerySearch, ActiveView,
    QueryManufacturer, QuerySupplier, QueryGroup, QueryErp, QueryWeb,
    QuerySort, string.Equals(QueryDirection, "desc", StringComparison.OrdinalIgnoreCase),
    "sl", QueryDepartment, QueryActivity, QueryWebPublish, QueryCompleteness, QueryImage,
    CategoryTreeOf(QueryCategory), CategoryCodeOf(QueryCategory),
    QueryPackaging, QueryDiscountGroup, QuerySpecial);

  Task RetryAsync() => LoadAsync();

  /// <summary>
  /// Najprej seznam (to uporabnik čaka), nato vrednosti filtrov. Vsak del ima svojo napako:
  /// fasete ali drevo kategorij ne podreta seznama, napaka seznama pa ne izbriše zadetkov
  /// istega filtra, ki so že na zaslonu. Vsaka napaka gre v dnevnik aplikacije z iskalnim nizom
  /// in podjetjem, da se vzrok (časovna meja, blokada, drugo) vidi.
  /// </summary>
  async Task LoadAsync()
  {
    var version = ++LoadVersion;
    var filter = CurrentFilter();
    RequestedFilter = filter;
    Loading = true;
    Error = null;
    StaleWarning = null;
    if (PageFilter != filter) { Page = null; PageFilter = null; }

    try
    {
      var page = await Workbench.GetProductListAsync(filter);
      if (version != LoadVersion) return;
      Page = page;
      PageFilter = filter;
      // Drug filter = druga izbira »vse po filtru«; stran (listanje) filtra ne spremeni.
      Selection.UpdateFilter(Href(page: 1), page.TotalCount);
    }
    catch (Exception failure)
    {
      if (version != LoadVersion) return;
      Log.LogError(failure, "Seznam izdelkov ni naložen ({Kind}). Iskanje={Search}, podjetje={Organization}, filter={Filter}",
        FailureKind(failure), filter.Search, filter.OrganizationId?.ToString() ?? "vsa", filter);
      var message = IsDatabaseBusy(failure)
        ? "Baza je trenutno zasedena in seznam izdelkov se ni naložil pravočasno. Poskusi znova čez nekaj trenutkov."
        : "Izdelkov trenutno ni mogoče naložiti. Napaka je zapisana v dnevnik aplikacije.";
      if (Page is not null && PageFilter == filter)
        StaleWarning = message + " Prikazani so zadnji prebrani zadetki.";
      else
        Error = message;
    }
    finally
    {
      if (version == LoadVersion) Loading = false;
    }

    if (version != LoadVersion) return;
    // Seznam je na zaslonu, preden se berejo vrednosti filtrov.
    StateHasChanged();
    await LoadFilterValuesAsync(filter.OrganizationId, version);
  }

  async Task LoadFilterValuesAsync(int? scope, int version)
  {
    var failed = false;
    // Vrednosti spustnih seznamov so vezane samo na obseg podjetja, zato se preberejo znova
    // sele ob njegovi spremembi, ne ob vsakem filtru.
    var scopeKey = scope?.ToString() ?? "";
    if (LoadedScope != scopeKey)
    {
      try
      {
        // 500 je zgornja meja procedure; 100 je bilo premalo (Vidadria ima 124 dobaviteljev).
        var facets = await Workbench.GetProductListFacetsAsync(scope, take: 500);
        if (version != LoadVersion) return;
        Facets = facets;
        LoadedScope = scopeKey;
      }
      catch (Exception failure)
      {
        failed = true;
        Log.LogWarning(failure, "Vrednosti filtrov izdelkov niso naložene ({Kind}), podjetje={Organization}",
          FailureKind(failure), scope?.ToString() ?? "vsa");
      }
    }

    // Drevesa kategorij se ne spreminjajo med filtriranjem; preberejo se enkrat na sejo strani
    // (ob napaki ostane seznam prazen in se prebere ob naslednjem filtru).
    if (CategoryOptions.Count == 0)
    {
      try
      {
        var picked = new List<CategoryTreeService.CategoryPickRow>();
        foreach (var treeCode in await Categories.GetTreeCodesAsync())
          picked.AddRange(await Categories.GetCategoryPickerAsync(treeCode));
        CategoryOptions = picked;
      }
      catch (Exception failure)
      {
        failed = true;
        Log.LogWarning(failure, "Drevo kategorij za filter izdelkov ni naloženo ({Kind})", FailureKind(failure));
      }
    }

    if (version != LoadVersion) return;
    FilterWarning = failed
      ? "Nekaterih vrednosti filtrov (proizvajalci, dobavitelji, kategorije) trenutno ni mogoče naložiti. Seznam je prikazan; filtri se preberejo znova ob naslednji spremembi."
      : null;
  }

  // SQL napake, ki pomenijo zasedeno bazo, ne napako v podatkih: -2 časovna meja ukaza,
  // 1205 izbran za žrtev zastoja (deadlock), 1222 časovna meja zaklepa. Poln bazen povezav
  // vrže InvalidOperationException z besedo »pool«.
  static bool IsDatabaseBusy(Exception failure) => failure switch
  {
    Microsoft.Data.SqlClient.SqlException sql => sql.Number is -2 or 1205 or 1222,
    TimeoutException => true,
    InvalidOperationException invalid => invalid.Message.Contains("pool", StringComparison.OrdinalIgnoreCase),
    _ => failure.InnerException is not null && IsDatabaseBusy(failure.InnerException),
  };

  static string FailureKind(Exception failure) => failure is Microsoft.Data.SqlClient.SqlException sql
    ? $"SqlException {sql.Number}{(IsDatabaseBusy(sql) ? ", baza zasedena" : "")}"
    : failure.GetType().Name + (IsDatabaseBusy(failure) ? ", baza zasedena" : "");

  string ResultSummary => Loading ? "Nalaganje …"
    : Error is not null ? "Rezultati niso na voljo"
    : PimFormat.Count(Page?.TotalCount ?? 0, "rezultat", "rezultata", "rezultati", "rezultatov");

  /* --- Kategorija -------------------------------------------------------------------------
     Vrednost filtra je »drevo:koda«. Dve polji bi pomenili dva spustna seznama in dve stanji v
     naslovu, uporabnik pa izbira eno stvar: kategorijo. Drevo je v vrednosti zato, ker sta kodi
     v dveh drevesih lahko enaki. */

  static string? CategoryTreeOf(string? value) =>
    string.IsNullOrWhiteSpace(value) || !value.Contains(':') ? null : value.Split(':', 2)[0];

  static string? CategoryCodeOf(string? value) =>
    string.IsNullOrWhiteSpace(value) ? null : value.Contains(':') ? value.Split(':', 2)[1] : value;

  static string TreeLabel(string treeCode) => treeCode switch
  {
    "svetila_si" => "Svetila.si",
    "videlektro" => "Videlektro",
    _ => treeCode,
  };

  string CategoryLabel(string value)
  {
    var tree = CategoryTreeOf(value);
    var code = CategoryCodeOf(value);
    var node = CategoryOptions.FirstOrDefault(row =>
      string.Equals(row.CategoryCode, code, StringComparison.OrdinalIgnoreCase)
      && (tree is null || string.Equals(row.CategoryTreeCode, tree, StringComparison.OrdinalIgnoreCase)));
    return node?.CategoryPath ?? node?.CategoryName ?? code ?? value;
  }

  List<FilterChip> ActiveChips
  {
    get
    {
      var chips = new List<FilterChip>();
      if (!string.IsNullOrWhiteSpace(QuerySearch)) chips.Add(new($"Iskanje: {QuerySearch}", Href(search: "")));
      if (!string.IsNullOrWhiteSpace(QueryOrganization)) chips.Add(new($"Podjetje: {OrganizationLabel(QueryOrganization)}", Href(organization: "")));
      if (ActiveView != "ALL") chips.Add(new($"Napaka: {ViewLabel(ActiveView)}", Href(view: "")));
      if (!string.IsNullOrWhiteSpace(QueryManufacturer)) chips.Add(new($"Proizvajalec: {PartnerChip("MANUFACTURER", QueryManufacturer)}", Href(manufacturer: "")));
      if (!string.IsNullOrWhiteSpace(QuerySupplier)) chips.Add(new($"Dobavitelj: {PartnerChip("SUPPLIER", QuerySupplier)}", Href(supplier: "")));
      if (!string.IsNullOrWhiteSpace(QueryGroup)) chips.Add(new($"Skupina: {QueryGroup}", Href(group: "")));
      if (!string.IsNullOrWhiteSpace(QueryDepartment)) chips.Add(new($"ABC klasifikacija: {QueryDepartment}", Href(department: "")));
      if (!string.IsNullOrWhiteSpace(QueryErp)) chips.Add(new($"ERP: {StatusLabel(QueryErp)}", Href(erp: "")));
      if (!string.IsNullOrWhiteSpace(QueryWeb)) chips.Add(new($"Splet: {StatusLabel(QueryWeb)}", Href(web: "")));
      if (!string.IsNullOrWhiteSpace(QueryActivity)) chips.Add(new($"Aktivnost: {ActivityLabel(QueryActivity)}", Href(activity: "")));
      if (!string.IsNullOrWhiteSpace(QueryWebPublish)) chips.Add(new($"Za splet: {WebPublishLabel(QueryWebPublish)}", Href(webPublish: "")));
      if (!string.IsNullOrWhiteSpace(QueryCompleteness)) chips.Add(new($"Popolnost: {CompletenessLabel(QueryCompleteness)}", Href(completeness: "")));
      if (!string.IsNullOrWhiteSpace(QueryImage)) chips.Add(new($"Slika: {ImageLabel(QueryImage)}", Href(image: "")));
      if (!string.IsNullOrWhiteSpace(QueryCategory)) chips.Add(new($"Kategorija: {CategoryLabel(QueryCategory)}", Href(category: "")));
      if (!string.IsNullOrWhiteSpace(QueryPackaging)) chips.Add(new($"S-popust: {PackagingLabel(QueryPackaging)}", Href(packaging: "")));
      if (!string.IsNullOrWhiteSpace(QueryDiscountGroup)) chips.Add(new($"Rabatna skupina: {QueryDiscountGroup}", Href(discountGroup: "")));
      if (!string.IsNullOrWhiteSpace(QuerySpecial)) chips.Add(new($"Posebni S: {SpecialLabel(QuerySpecial)}", Href(special: "")));
      return chips;
    }
  }

  // Filtri, pogled, razvrscanje in stran zivijo v naslovu: povezavo je mogoce deliti, gumb Nazaj
  // pa dela. Sentinel "" pomeni "odstrani ta filter", null pomeni "ohrani obstojecega".
  string Href(string? view = null, string? search = null, string? organization = null, string? manufacturer = null,
    string? supplier = null, string? group = null, string? department = null, string? erp = null, string? web = null,
    string? activity = null, string? webPublish = null, string? completeness = null, string? image = null,
    string? category = null, string? sort = null, string? direction = null, int? page = null,
    string? packaging = null, string? discountGroup = null, string? special = null)
  {
    var parameters = new List<string>();
    Add("pogled", Resolve(view, ActiveView == "ALL" ? null : ActiveView));
    Add("isci", Resolve(search, QuerySearch));
    Add("podjetje", Resolve(organization, QueryOrganization));
    Add("proizvajalec", Resolve(manufacturer, QueryManufacturer));
    Add("dobavitelj", Resolve(supplier, QuerySupplier));
    Add("skupina", Resolve(group, QueryGroup));
    Add("oddelek", Resolve(department, QueryDepartment));
    Add("erp", Resolve(erp, QueryErp));
    Add("splet", Resolve(web, QueryWeb));
    Add("aktivnost", Resolve(activity, QueryActivity));
    Add("objava", Resolve(webPublish, QueryWebPublish));
    Add("popolnost", Resolve(completeness, QueryCompleteness));
    Add("slika", Resolve(image, QueryImage));
    Add("kategorija", Resolve(category, QueryCategory));
    Add("spopust", Resolve(packaging, QueryPackaging));
    Add("rabatna", Resolve(discountGroup, QueryDiscountGroup));
    Add("posebni", Resolve(special, QuerySpecial));
    Add("sort", Resolve(sort, QuerySort));
    Add("smer", Resolve(direction, QueryDirection));
    var resolvedPage = page ?? (view is null && search is null && organization is null && manufacturer is null
      && supplier is null && group is null && department is null && erp is null && web is null && activity is null
      && webPublish is null && completeness is null && image is null && sort is null && direction is null
      && packaging is null && discountGroup is null && special is null ? QueryPage : null);
    if (resolvedPage is > 1) parameters.Add("stran=" + resolvedPage);

    return parameters.Count == 0 ? "izdelki" : "izdelki?" + string.Join('&', parameters);

    void Add(string name, string? value)
    {
      if (!string.IsNullOrWhiteSpace(value)) parameters.Add(name + "=" + Uri.EscapeDataString(value));
    }

    static string? Resolve(string? requested, string? current) => requested is null ? current : requested;
  }

  // Obseg izvoza pove izbira v tabeli, ne skrit spustni seznam: ce je kaj izbrano, gredo ven
  // izbrani, sicer cel pogled. Gumb to izpise, da uporabniku ni treba ugibati. Brez zgornje
  // meje — uporabnikova zahteva 2026-09-17, ker izbira zdaj potuje v pomnilniku do izvoza v
  // ozadju (StartExportAsync), ne vec skozi dolzino naslova (ExportJobService).
  string ExportScopeLabel => Selection.IsEmpty || Selection.AllMatching ? "(cel pogled)" : $"(izbrani: {Selection.Count:N0})";

  // Stanje uporabnikovega izvoza v ozadju, samo za zaklep gumba; napredek, napako in prenos
  // kaze okno izvozov v kotu strani. JobId sluzi kot filter na dogodku ExportJobs.Changed —
  // nastavljen je PRED klicem StartWorkbookExport, da noben dogodek (tudi zelo hiter) ne uide.
  Guid? ExportJobId;
  ExportRunStatus? ExportState;
  string ExportOwner = "neznan";

  // Posamezna polja, ki jih uporabnik lahko izklopi (pojavno okno »Stolpci«). Ključ (podjetje,
  // šifra, naziv) ni na seznamu in gre v izvoz vedno — glej ProductWorkbookService.BuildAsync/
  // Included. IncludedFieldKeys == null pomeni »vsa polja«, kar je tudi privzeto stanje; s tem
  // izvoz, ki okna nikoli ne odpre, ostane popolnoma enak, kot je bil doslej. Seznam polj sam je
  // odvisen od konteksta (kategorija doloca nabor atributov, podjetje jezike), zato pride s
  // streznika ob vsakem odpiranju okna, ne iz staticnega seznama skupin kot prej.
  bool ColumnPickerOpen;
  bool ColumnPickerLoading;
  string? ColumnPickerError;
  IReadOnlyList<ProductWorkbookColumn> AvailableColumns = [];
  HashSet<string>? IncludedFieldKeys;
  string ColumnSearch = "";

  int TotalColumnCount => AvailableColumns.Count;
  int SelectedColumnCount => IncludedFieldKeys?.Count ?? AvailableColumns.Count;

  sealed record ColumnPickerGroup(string Group, IReadOnlyList<ProductWorkbookColumn> Columns);

  // Iskanje filtrira polja, ne skupin: skupina brez zadetka preprosto izgine iz seznama. Vrstni
  // red skupin in polj znotraj njih je isti kot v datoteki (ProductWorkbookContract.Build) —
  // levo je tisto, po čemer se vrstica najde, potem tisto, kar uporabnik vpisuje.
  List<ColumnPickerGroup> FilteredGroups =>
    AvailableColumns
      .Where(column => string.IsNullOrWhiteSpace(ColumnSearch)
        || column.Header.Contains(ColumnSearch, StringComparison.OrdinalIgnoreCase))
      .GroupBy(column => column.Group)
      .Select(group => new ColumnPickerGroup(group.Key, group.ToList()))
      .ToList();

  bool IsIncluded(string fieldKey) => IncludedFieldKeys is null || IncludedFieldKeys.Contains(fieldKey);

  int GroupTotalCount(string group) => AvailableColumns.Count(column => column.Group == group);
  int GroupSelectedCount(string group) => AvailableColumns.Count(column => column.Group == group && IsIncluded(column.FieldKey));

  async Task OpenColumnPickerAsync()
  {
    ColumnPickerOpen = true;
    ColumnPickerLoading = true;
    ColumnPickerError = null;
    ColumnSearch = "";
    StateHasChanged();
    try
    {
      AvailableColumns = (await Workbook.DescribeColumnsAsync(BuildExportFilter()))
        .Where(column => column.Group != ProductWorkbookContract.GroupKey).ToList();
    }
    catch
    {
      AvailableColumns = [];
      ColumnPickerError = "Seznama polj trenutno ni mogoče naložiti.";
    }
    finally
    {
      ColumnPickerLoading = false;
    }
  }

  void CloseColumnPicker() => ColumnPickerOpen = false;

  void ToggleColumn(string fieldKey, bool included)
  {
    IncludedFieldKeys ??= AvailableColumns.Select(column => column.FieldKey).ToHashSet(StringComparer.Ordinal);
    if (included) IncludedFieldKeys.Add(fieldKey); else IncludedFieldKeys.Remove(fieldKey);
  }

  void ToggleGroup(string group, bool included)
  {
    IncludedFieldKeys ??= AvailableColumns.Select(column => column.FieldKey).ToHashSet(StringComparer.Ordinal);
    foreach (var column in AvailableColumns.Where(column => column.Group == group))
      if (included) IncludedFieldKeys.Add(column.FieldKey); else IncludedFieldKeys.Remove(column.FieldKey);
  }

  void SelectAllColumns() => IncludedFieldKeys = null;
  void SelectNoColumns() => IncludedFieldKeys = new(StringComparer.Ordinal);

  // Izvoz uporabi natanko iste filtre kot pogled: kar vidis, je to, kar se izvozi. Oblika je
  // delovni zvezek, ker ga uporabnik odpre v Excelu brez carovnika za uvoz.
  ProductListFilter BuildExportFilter() => new(
    OrganizationScope, 0, Take, QuerySearch, ActiveView,
    QueryManufacturer, QuerySupplier, QueryGroup, QueryErp, QueryWeb,
    QuerySort, string.Equals(QueryDirection, "desc", StringComparison.OrdinalIgnoreCase),
    "sl", QueryDepartment, QueryActivity, QueryWebPublish, QueryCompleteness, QueryImage,
    CategoryTreeOf(QueryCategory), CategoryCodeOf(QueryCategory),
    QueryPackaging, QueryDiscountGroup, QuerySpecial);

  async Task StartExportAsync()
  {
    ExportState = ExportRunStatus.Queued;

    var jobId = Guid.NewGuid();
    ExportJobId = jobId;
    // »Vse po filtru« je cel pogled — izvoz ga itak bere s streznika po istem filtru.
    var selection = !Selection.IsEmpty && !Selection.AllMatching
      ? Selection.Items.Select(item => $"{item.OrganizationId}|{item.ItemId}").ToList()
      : null;
    // null pomeni »vsa polja« — privzeto stanje, dokler uporabnik ne odpre okna »Stolpci« in
    // kaj odkljuka; tako izvoz z nespremenjeno izbiro ostane popolnoma isti kot doslej.
    ExportJobs.StartWorkbookExport(
      jobId, ExportOwner, ProductWorkbookService.FileName(DateTime.UtcNow), BuildExportFilter(), selection, IncludedFieldKeys);
    try
    {
      // Prenos se odpre ZDAJ, dokler brskalnik klik se steje za uporabnikovo dejanje (nekaj
      // sekund) — ne ob koncu gradnje. Tak prenos brskalnik pokaze v svojem polju prenosov
      // takoj in ga ne zadrzi kot sumljivega (»Obdrži«). Glej ExportDownloadEndpoint.
      await Js.InvokeVoidAsync("pimDownloadFile", $"izvoz/zvezek/{jobId}");
      // Okno izvozov (wwwroot/js/pim-export.js) sicer bere stanje ob nalaganju strani; tu ga
      // zbudimo takoj, da napredek pokaze od prvega trenutka, ne sele ob naslednji navigaciji.
      await Js.InvokeVoidAsync("pimExports.refresh");
    }
    catch (JSException) { }
    catch (JSDisconnectedException) { }
  }

  // Dogodek pride iz ExportJobService, torej iz niti gradnje — zato InvokeAsync, ne neposredna
  // sprememba polj. Tu se samo odklene gumb; prenos sprozi okno izvozov, ki ga vidi tudi stran,
  // na katero je uporabnik medtem odsel.
  void OnExportJobChanged(ExportJobState state)
  {
    if (state.JobId != ExportJobId || state.Status == ExportState) return;
    _ = InvokeAsync(() =>
    {
      ExportState = state.Status;
      StateHasChanged();
    });
  }

  public void Dispose()
  {
    ExportJobs.Changed -= OnExportJobChanged;
    // Predogled se ob odhodu prekine (nic se ne zapise); zapis, ki ze tece, se ne prekine — pol
    // zapisanega paketa bi bilo slabse od celega, zgodovina pa ga v obeh primerih zna povrniti.
    if (!EditWriting) EditCancel?.Cancel();
  }

