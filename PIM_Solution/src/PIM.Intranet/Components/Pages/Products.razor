@page "/izdelki"
@attribute [Authorize]
@inject PIM.Intranet.Services.IntranetDataService Data
<PageTitle>Izdelki</PageTitle>
<div class="page-header"><div><h1>Izdelki</h1><p>Pregled izdelkov v aktivni organizaciji.</p></div></div>
<div class="page-tabs"><span class="page-tab active">Vsi izdelki @(Page is null ? null : $"({Page.TotalCount:N0})")</span></div>
<section class="ui-card toolbar">
  <label class="visually-hidden" for="product-search">Išči po artiklu ali EAN</label><input id="product-search" class="search-input" placeholder="Išči po artiklu ali EAN …" @bind="Search" @bind:event="oninput" />
  <label class="visually-hidden" for="product-status">Status</label><select id="product-status" class="filter-select" @bind="Status"><option value="">Vsi statusi</option><option value="VALID">VALID</option><option value="INVALID">INVALID</option><option value="PENDING">PENDING</option></select>
  <button class="filter-button" @onclick="ApplyFiltersAsync">Uporabi filtre</button><span class="result-count">@(Page?.TotalCount ?? 0) rezultatov</span>
</section>
<section class="ui-card data-card">
@if (Loading) { <div class="loading-state">Nalaganje izdelkov …</div> }
else if (Error is not null) { <div class="error-state">@Error</div> }
else if (Page?.Rows.Count == 0) { <div class="empty-state">Za izbrane filtre ni izdelkov.</div> }
else if (Page is not null) { <table class="data-table"><caption>Izdelki v aktivni organizaciji</caption><thead><tr><th>Artikel</th><th>EAN</th><th>Status</th><th>Popolnost</th><th><span class="visually-hidden">Dejanje</span></th></tr></thead><tbody>@foreach (var row in Page.Rows) { <tr><td><a href="izdelki/@row.ProductId">@row.ItemId</a></td><td>@(row.Ean ?? "—")</td><td><span class="status-chip @Chip(row.Status)">@row.Status</span></td><td><div class="progress-line"><span class="progress-track" role="progressbar" aria-label="Popolnost" aria-valuenow="@row.Completeness" aria-valuemin="0" aria-valuemax="100"><i class="@(row.Completeness < 75 ? "warn" : null)" style="width:@Percent(row.Completeness)"></i></span>@row.Completeness.ToString("0.#") %</div></td><td><a href="izdelki/@row.ProductId" aria-label="Odpri izdelek @row.ItemId">›</a></td></tr> }</tbody></table>
  <nav class="pagination" aria-label="Strani izdelkov"><button disabled="@(Skip == 0)" @onclick="PreviousAsync">Prejšnja</button><span>Stran @(Skip / Take + 1) od @Math.Max(1, (long)Math.Ceiling(Page.TotalCount / (decimal)Take))</span><button disabled="@(Skip + Take >= Page.TotalCount)" @onclick="NextAsync">Naslednja</button></nav> }
</section>
@code {
  PIM.Intranet.Services.ProductPage? Page; bool Loading = true; string? Error; string Search = ""; string Status = ""; int Skip; const int Take = 50; int? OrganizationId;
  protected override async Task OnInitializedAsync() { try { var org=await Data.GetCurrentOrganizationAsync(); if(org is null){Error="Aktivna organizacija ni na voljo.";return;} OrganizationId=org.OrganizationId; await LoadAsync(); } catch { Error="Izdelkov trenutno ni mogoče naložiti."; } finally { Loading=false; } }
  async Task LoadAsync(){if(OrganizationId is null)return;Loading=true;Error=null;try{Page=await Data.GetProductsAsync(OrganizationId.Value,Skip,Take,Search,Status);}catch{Error="Izdelkov trenutno ni mogoče naložiti.";}finally{Loading=false;}}
  async Task ApplyFiltersAsync(){Skip=0;await LoadAsync();} async Task PreviousAsync(){Skip=Math.Max(0,Skip-Take);await LoadAsync();} async Task NextAsync(){Skip+=Take;await LoadAsync();}
  static string Chip(string value) => value == "VALID" ? "good" : value == "PENDING" ? "warn" : "bad";
  static string Percent(decimal value) => $"{Math.Clamp(value,0,100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%";
}
