  // Cela vrstica je povezava do kartice. Naziv zato ni <a> — podcrtan naziv sredi vrstice, ki
  // je vsa klikljiva, obljublja dve razlicni dejanji, pa je le eno.
  async Task OpenAsync(ProductListRow row)
  {
    // Kartica se nalaga vec kot trenutek. Brez tega je uporabnik ostal na seznamu brez znaka,
    // da se karkoli dogaja, in je klikal znova. Prekrivalo se izrise, preden se navigacija
    // zacne — StateHasChanged in prepustitev niti sta zato nujna, ne okras.
    Opening = row.ProductId;
    StateHasChanged();
    await Task.Yield();
    Navigation.NavigateTo($"izdelki/{row.ProductId}");
  }

  Task OpenKeyAsync(KeyboardEventArgs args, ProductListRow row) =>
    args.Key is "Enter" or " " ? OpenAsync(row) : Task.CompletedTask;

