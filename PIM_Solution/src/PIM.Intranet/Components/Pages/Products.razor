@page "/izdelki"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using PIM.Operations
@inject IntranetDataService Data
@inject ProductWorkbenchService Workbench
@inject CategoryTreeService Categories
@inject NavigationManager Navigation
@inject ExportJobService ExportJobs
@inject IJSRuntime Js

<PageTitle>Izdelki</PageTitle>

<PimPage Title="Izdelki" Subtitle="Delovni seznam kataloga vseh podjetij: kaj je pripravljeno za ERP, kaj za splet in kaj manjka. Privzeto so vsa podjetja; filter zoži na eno." />

<section class="ui-card toolbar" role="search" aria-labelledby="products-filter-title">
  <h2 id="products-filter-title" class="visually-hidden">Filtriranje izdelkov</h2>

  <div class="toolbar-row">
    <div class="search-field">
      <span class="search-icon" aria-hidden="true"></span>
      <label class="visually-hidden" for="product-search">Išči po artiklu ali EAN</label>
      <input id="product-search" type="search" class="search-input" placeholder="Išči po šifri artikla ali EAN …" @bind="SearchDraft" @bind:event="oninput" @onkeydown="SearchKeyAsync" />
    </div>

    <button type="button" class="ghost-button filter-toggle @(FiltersOpen ? "open" : null)" aria-expanded="@FiltersOpen.ToString().ToLowerInvariant()" aria-controls="products-filter-panel" @onclick="ToggleFilters">
      <span class="funnel" aria-hidden="true"></span>Filtri
      @if (ActiveChips.Count > 0) { <span class="filter-badge">@ActiveChips.Count</span> }
    </button>

    <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>

    @* Dve dejanji in nic vec. Uporabnik 2026-09-08: »zakaj imava petsto gumbov, naredi samo
       izvoz in uvoz«. Sest gumbov v vrsti je bilo sest vprasanj namesto enega odgovora.

       Kar je odslo, ni izginilo. Predloga SAOP je se vedno svoja predloga istega izvoza,
       cakalna lista artiklov je zavihek Artikli v razdelku SAOP, mnozicno urejanje pa je
       povezano s strani kakovosti in s strani uvoza. Tu ostane samo pot, po kateri se dela
       vsak dan: datoteka ven, popravljena datoteka nazaj.

       Obseg izvoza pove izbira v tabeli — ce je kaj izbrano, gredo ven izbrani, sicer cel
       pogled — in gumb to prebere na glas. *@
    <div class="toolbar-actions">
      @* Katere skupine stolpcev gredo v datoteko — uporabnikova zahteva: manj podatkov je manjši
         izvoz IN hitrejši uvoz nazaj (posodobi se samo, kar je v datoteki). Privzeto vse; ključ
         (podjetje, šifra, naziv) gre v datoteko vedno in tu ni izbirljiv. *@
      <button type="button" class="ghost-button" @onclick="OpenColumnPicker"
              title="Izberi, katere skupine stolpcev gredo v izvoz. Manj stolpcev je manjša datoteka in hitrejši uvoz nazaj — uvoz posodobi samo stolpce, ki so v datoteki.">
        Stolpci
        @if (IncludedGroups.Count < AllWorkbookGroups.Length) { <span class="filter-badge">@IncludedGroups.Count</span> }
      </button>
      <button type="button" class="primary-button" disabled="@(ExportState is ExportRunStatus.Running or ExportRunStatus.Queued)" @onclick="StartExportAsync"
              title="ERP, splet, spletne strani, kategorije in atributi v eni datoteki; uredi jo v Excelu in vrni nazaj. Gradi se v ozadju, prenos se sproži sam.">
        @if (ExportState is ExportRunStatus.Running or ExportRunStatus.Queued) { <span class="opening-spinner" aria-hidden="true"></span> }
        Izvozi Excel @ExportScopeLabel
      </button>
      <a class="ghost-button" href="izdelki/uvoz" title="Urejena datoteka se vrne v PIM: spletni podatki takoj, ERP polja v vrsto za SAOP.">Uvozi Excel</a>
    </div>
  </div>

  <div id="products-filter-panel" class="filter-panel" hidden="@(!FiltersOpen)">
    <div class="filter-grid">
      <div class="filter-field">
        <label for="product-organization">Podjetje</label>
        <select id="product-organization" class="filter-select" @bind="OrganizationDraft" @bind:after="OrganizationDraftChanged">
          <option value="">Vsa podjetja</option>
          @foreach (var organization in Organizations)
          {
            <option value="@organization.OrganizationId">@organization.Name</option>
          }
        </select>
      </div>

      @* Napaka nadomesti nekdanjo vrstico zavihkov (Za urediti, Brez slike, …): ista izbira, en
         filter, brez locenega stetja ob vsaki zamenjavi podjetja. Uporabnik 2026-09-17: »a bi
         stran kej hitreje delal ce to odstraniva, sej to lahk vse v filtre dodava«. *@
      <div class="filter-field">
        <label for="product-view">Napaka</label>
        <select id="product-view" class="filter-select" @bind="ViewDraft">
          <option value="">Vse</option>
          <option value="TO_FIX">Za urediti (katerakoli napaka)</option>
          <option value="NO_IMAGE">Brez slike</option>
          <option value="NO_WEB_TITLE">Brez spletnega naziva</option>
          <option value="NO_CATEGORY">Brez kategorije</option>
          <option value="NO_EAN">Brez EAN</option>
          <option value="NOT_PUBLISHED">Neobjavljeni</option>
          <option value="WAITING_SAOP">Čaka SAOP</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-manufacturer">Proizvajalec</label>
        <PimPicker Id="product-manufacturer" Options="ManufacturerOptions" @bind-Value="ManufacturerDraftOrNull"
                   Placeholder="Vsi proizvajalci" EmptyText="Ni proizvajalcev." />
      </div>

      <div class="filter-field">
        <label for="product-supplier">Dobavitelj</label>
        <PimPicker Id="product-supplier" Options="SupplierOptions" @bind-Value="SupplierDraftOrNull"
                   Placeholder="Vsi dobavitelji" EmptyText="Ni dobaviteljev." />
      </div>

      <div class="filter-field">
        <label for="product-group">Skupina artikla</label>
        <PimPicker Id="product-group" Options="GroupOptions" @bind-Value="GroupDraftOrNull"
                   Placeholder="Vse skupine" EmptyText="Ni skupin." />
      </div>

      @* Kategorija je filter in ne pogled: izbrana kategorija zoži seznam IN določi, katere
         atribute nosi delovni list. Ob imenu stojita število izdelkov pod kategorijo in
         velikost njenega nabora, sicer bi uporabnik izbiral naslepo. *@
      <div class="filter-field filter-field-wide">
        <label for="product-category">Kategorija</label>
        <PimPicker Id="product-category" Options="CategoryPickerOptions" @bind-Value="CategoryDraftOrNull"
                   Placeholder="Vse kategorije" EmptyText="Ni kategorij." />
      </div>

      <div class="filter-field">
        <label for="product-image">Slika</label>
        <select id="product-image" class="filter-select" @bind="ImageDraft">
          <option value="">Vsi</option>
          <option value="YES">Ima sliko</option>
          <option value="NO">Brez slike</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-department">ABC klasifikacija</label>
        <PimPicker Id="product-department" Options="DepartmentOptions" @bind-Value="DepartmentDraftOrNull"
                   Placeholder="Vse klasifikacije" EmptyText="Ni klasifikacij." />
      </div>

      <div class="filter-field">
        <label for="product-erp">Pripravljenost za ERP</label>
        <select id="product-erp" class="filter-select" @bind="ErpDraft">
          <option value="">Vsi</option>
          <option value="VALID">Pripravljeni za ERP</option>
          <option value="INVALID">Blokirani za ERP</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-web">Pripravljenost za splet</label>
        <select id="product-web" class="filter-select" @bind="WebDraft">
          <option value="">Vsi</option>
          <option value="VALID">Pripravljeni za splet</option>
          <option value="INVALID">Blokirani za splet</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-activity">Aktivnost artikla</label>
        <select id="product-activity" class="filter-select" @bind="ActivityDraft">
          <option value="">Vsi</option>
          <option value="ACTIVE">Samo aktivni</option>
          <option value="INACTIVE">Samo neaktivni</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-webpublish">Zastavica za splet</label>
        <select id="product-webpublish" class="filter-select" @bind="WebPublishDraft">
          <option value="">Vsi</option>
          <option value="YES">Označeni za splet</option>
          <option value="NO">Neoznačeni za splet</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-completeness">Popolnost</label>
        <select id="product-completeness" class="filter-select" @bind="CompletenessDraft">
          <option value="">Vsa</option>
          <option value="EMPTY">0 %</option>
          <option value="LOW">Pod 50 %</option>
          <option value="MID">50–99 %</option>
          <option value="FULL">100 %</option>
        </select>
      </div>
    </div>

    <div class="filter-actions">
      <button type="button" class="primary-button" @onclick="ApplyFiltersAsync">Uporabi filtre</button>
      <a class="link-button" href="izdelki">Počisti vse</a>
    </div>
  </div>
</section>

@* Izbira stolpcev za izvoz. Ključ (podjetje, šifra, naziv) ni na seznamu, ker gre v datoteko
   vedno — brez njega uvoz vrstice sploh ne bi znal najti. Uvoz sam se ne spremeni: prepozna
   vsak stolpec, ki je v datoteki, in ostalo pusti pri miru (ProductWorkbookContract.Match), zato
   manjši izvoz pomeni tudi manjši, hitrejši uvoz nazaj — brez posebne poti zanj. *@
@if (ColumnPickerOpen)
{
  <div class="xml-lightbox" role="dialog" aria-modal="true" aria-label="Izberi stolpce izvoza" @onclick="CloseColumnPicker">
    <div class="xml-lightbox-panel" @onclick:stopPropagation="true">
      <header>
        <div>
          <strong>Kateri stolpci gredo v datoteko</strong>
          <span>Ključ (podjetje, šifra, naziv) je v izvozu vedno. Manj izbranih skupin je manjša datoteka; uvoz nazaj posodobi samo stolpce, ki so v njej.</span>
        </div>
        <button type="button" class="small-action" @onclick="CloseColumnPicker">Zapri</button>
      </header>
      <div class="xml-lightbox-body">
        @foreach (var group in AllWorkbookGroups)
        {
          <label class="column-picker-row">
            <input type="checkbox" checked="@IncludedGroups.Contains(group)"
                   @onchange="@(args => ToggleColumnGroup(group, (bool)(args.Value ?? false)))" />
            @group
          </label>
        }
      </div>
      <footer>
        <button type="button" class="link-button" @onclick="SelectAllColumnGroups">Izberi vse</button>
        <button type="button" class="primary-button" @onclick="CloseColumnPicker">Uporabi</button>
      </footer>
    </div>
  </div>
}

@if (ActiveChips.Count > 0)
{
  <section class="ui-card active-filters" aria-label="Aktivni filtri">
    @foreach (var chip in ActiveChips)
    {
      <a class="filter-chip" href="@chip.RemoveHref" aria-label="Odstrani filter @chip.Label">@chip.Label<span class="chip-remove" aria-hidden="true"></span></a>
    }
    <a class="filter-chip clear-all" href="izdelki">Počisti vse</a>
  </section>
}

@* Izvoz gradi zvezek v ozadju (ExportJobService) — uporabnik 2026-09-17: brez zgornje meje
   vrstic, klik pa ne sme cakati na odgovor. To sporoca napredek in ob koncu sprozi prenos. *@
@if (ExportState is not null)
{
  <p class="notice export-notice export-notice-@ExportState.ToString()!.ToLowerInvariant()" role="status">
    @switch (ExportState)
    {
      case ExportRunStatus.Queued:
        <span class="opening-spinner" aria-hidden="true"></span>
        <span>Izvoz čaka v vrsti (pred tabo: @ExportQueuePosition). Hkrati tečeta največ dva izvoza, da strani ostanejo odzivne; tvoj se začne sam.</span>
        break;
      case ExportRunStatus.Running:
        <span class="opening-spinner" aria-hidden="true"></span>
        <span>Zvezek se gradi v ozadju@(ExportRowCount is > 0 ? $" — zapisanih {ExportRowCount:N0} vrstic" : "") — lahko nadaljuješ z delom, ko bo gotov, se prenos začne sam.</span>
        break;
      case ExportRunStatus.Completed:
        <span>Izvoz je pripravljen, prenos se je začel. Če se ni, ga <a href="@ExportDownloadUrl">prenesi ročno</a>.</span>
        <button type="button" class="link-button" @onclick="DismissExportNotice">Skrij</button>
        break;
      case ExportRunStatus.Failed:
        <span>Izvoz ni uspel: @ExportErrorMessage</span>
        <button type="button" class="link-button" @onclick="DismissExportNotice">Skrij</button>
        break;
    }
  </p>
}

@* Razvrstitev ni filter — ne zozi nabora, samo obrne vrstni red — zato stoji nad tabelo,
   kjer ucinkuje, in ne v panelu filtrov. Deluje takoj ob izbiri, brez gumba Uporabi. *@
<div class="table-toolbar">
  <label for="product-sort">Razvrstitev</label>
  <select id="product-sort" class="filter-select" @bind="SortDraft" @bind:after="ApplySortAsync">
    <option value="ITEM">Šifra naraščajoče</option>
    <option value="ITEM:desc">Šifra padajoče</option>
    <option value="COMPLETENESS:desc">Najbolj popolni</option>
    <option value="COMPLETENESS">Najmanj popolni</option>
    <option value="CHANGED:desc">Nazadnje spremenjeni</option>
    <option value="CHANGED">Najdlje nespremenjeni</option>
    <option value="ORGANIZATION">Po podjetju</option>
  </select>
</div>

<section class="ui-card data-card @(Opening is null ? null : "opening-card")" aria-label="Seznam izdelkov">
  @if (Opening is not null)
  {
    <div class="opening-overlay" role="status" aria-live="assertive"><span class="opening-spinner" aria-hidden="true"></span><span>Odpiram kartico izdelka …</span></div>
  }
  <PimState Loading="Loading" Error="@Error" Empty="@(Page is not null && Page.Rows.Count == 0)"
            EmptyText="Za izbrane filtre ni izdelkov." LoadingText="Nalaganje izdelkov …">
    @if (Page is not null)
    {
      <PimTable Caption="@ScopeCaption" AriaLabel="Tabela izdelkov" Columns="Columns">
        <Rows>
          @foreach (var row in Page.Rows)
          {
            var thumbnail = MediaUrlPolicy.Normalize(row.ThumbnailUrl);
            <tr class="row-link @(Opening == row.ProductId ? "opening" : null)" tabindex="0" @onclick="() => OpenAsync(row)" @onkeydown="args => OpenKeyAsync(args, row)"
                aria-label="Odpri izdelek @row.ItemId" aria-busy="@(Opening == row.ProductId ? "true" : null)">
              @* Klikanje po vrstici ne sme prekljukati izbire, zato ima celica izbire svojo ustavitev. *@
              <td class="select-cell" @onclick:stopPropagation="true">
                <input type="checkbox" aria-label="Izberi izdelek @row.ItemId" checked="@Selected.ContainsKey(SelectionKey(row))" @onchange="e => Toggle(row, e)" />
              </td>
              <td class="thumb-cell">
                <span class="thumb">
                  @if (thumbnail.Href is not null)
                  {
                    <img src="@thumbnail.Href" alt="" loading="lazy" />
                  }
                  else
                  {
                    <span class="thumb-empty" aria-hidden="true"></span>
                  }
                </span>
              </td>
              <td>
                <span class="product-name">@row.Name</span>
                <span class="product-meta"><span class="code-value">@row.ItemId</span>@if (row.Ean is not null) { <span>· EAN @row.Ean</span> }</span>
              </td>
              <td>@row.OrganizationName</td>
              <td>@row.ManufacturerLabel</td>
              <td>@row.SupplierLabel</td>
              <td><PimChip Text="@StatusLabel(row.ErpStatus)" Tone="@Tone(row.ErpStatus)" Prefix="Stanje ERP: " /></td>
              <td><PimChip Text="@StatusLabel(row.WebStatus)" Tone="@Tone(row.WebStatus)" Prefix="Stanje splet: " /></td>
              <td><PimBar Percent="row.Completeness" Label="@($"Popolnost izdelka {row.ItemId}")" /></td>
              <td class="numeric">@row.OpenIssueCount.ToString("N0")</td>
              <td class="row-flags">
                @if (row.MediaCount == 0) { <span class="gap-flag">brez slike</span> }
                @if (!row.HasWebTitle) { <span class="gap-flag">brez naziva</span> }
                @if (row.CategoryCount == 0) { <span class="gap-flag">brez kategorije</span> }
                @if (row.PendingOutboundCount > 0) { <span class="wait-flag">čaka SAOP (@row.PendingOutboundCount)</span> }
                @if (row.IsPromoted) { <span class="ok-flag">objavljen</span> }
              </td>
              <td>@(row.LastChangedUtc?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
            </tr>
          }
        </Rows>
      </PimTable>
      <PimPager Skip="Skip" Take="Take" Total="Page.TotalCount" Label="Strani izdelkov" SkipChanged="GoToSkipAsync" />
    }
  </PimState>
</section>

<p class="muted source-note">
  Vir: <span class="code-value">intranet.GetProductList</span> in
  <span class="code-value">intranet.GetProductListFilters</span> (migraciji 101 in 108). Urejanje polja je na kartici izdelka; izvoz pogleda je delovni zvezek Excel.
  Vrednosti spustnih seznamov se ravnajo po izbranem podjetju, ne po preostalih filtrih.
</p>

@code {
  [SupplyParameterFromQuery(Name = "pogled")] public string? QueryView { get; set; }
  [SupplyParameterFromQuery(Name = "isci")] public string? QuerySearch { get; set; }
  [SupplyParameterFromQuery(Name = "podjetje")] public string? QueryOrganization { get; set; }
  [SupplyParameterFromQuery(Name = "proizvajalec")] public string? QueryManufacturer { get; set; }
  [SupplyParameterFromQuery(Name = "dobavitelj")] public string? QuerySupplier { get; set; }
  [SupplyParameterFromQuery(Name = "skupina")] public string? QueryGroup { get; set; }
  [SupplyParameterFromQuery(Name = "oddelek")] public string? QueryDepartment { get; set; }
  [SupplyParameterFromQuery(Name = "erp")] public string? QueryErp { get; set; }
  [SupplyParameterFromQuery(Name = "splet")] public string? QueryWeb { get; set; }
  [SupplyParameterFromQuery(Name = "aktivnost")] public string? QueryActivity { get; set; }
  [SupplyParameterFromQuery(Name = "objava")] public string? QueryWebPublish { get; set; }
  [SupplyParameterFromQuery(Name = "popolnost")] public string? QueryCompleteness { get; set; }
  [SupplyParameterFromQuery(Name = "slika")] public string? QueryImage { get; set; }
  [SupplyParameterFromQuery(Name = "kategorija")] public string? QueryCategory { get; set; }
  [SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }
  [SupplyParameterFromQuery(Name = "smer")] public string? QueryDirection { get; set; }
  [SupplyParameterFromQuery(Name = "stran")] public int? QueryPage { get; set; }

  // Izbira zivi cez strani in cez filtre: urednik pogosto izbere nekaj na eni strani, spremeni
  // filter in izbere se nekaj. Ce bi se izbira ob vsakem premiku izgubila, bi bilo mnozicno
  // urejanje uporabno samo za eno stran rezultatov. Kljuc nosi podjetje, ker je sifra artikla
  // enolicna samo znotraj podjetja — 0000000000001 obstaja v DEMO in v Vidadrii.
  readonly Dictionary<string, SelectedItem> Selected = new(StringComparer.OrdinalIgnoreCase);

  ProductListPage? Page;
  IReadOnlyList<ProductListFacet> Facets = [];
  IReadOnlyList<OrganizationContext> Organizations = [];
  bool Loading = true;
  string? Error;

  // Sentinel za "se nic ni naloženo": prazen niz pomeni vsa podjetja in je veljaven obseg,
  // zato ga ni mogoce uporabiti kot znak, da fasete se niso prebrane.
  string? LoadedScope;
  string SearchDraft = "";
  string OrganizationDraft = "";
  string ViewDraft = "";
  string ManufacturerDraft = "";
  string SupplierDraft = "";
  string GroupDraft = "";
  string DepartmentDraft = "";
  string ErpDraft = "";
  string WebDraft = "";
  string ActivityDraft = "";
  string WebPublishDraft = "";
  string CompletenessDraft = "";
  string ImageDraft = "";
  string CategoryDraft = "";
  IReadOnlyList<CategoryTreeService.CategoryPickRow> CategoryOptions = [];
  string SortDraft = "ITEM";

  // PimPicker izbira niclivo vrednost (null = nic izbranega), Draft polja pa prazen niz zaradi
  // Href/ApplyFiltersAsync spodaj; ta polja samo prevajajo med obema pomenoma "nic ni izbrano".
  string? ManufacturerDraftOrNull { get => string.IsNullOrEmpty(ManufacturerDraft) ? null : ManufacturerDraft; set => ManufacturerDraft = value ?? ""; }
  string? SupplierDraftOrNull { get => string.IsNullOrEmpty(SupplierDraft) ? null : SupplierDraft; set => SupplierDraft = value ?? ""; }
  string? GroupDraftOrNull { get => string.IsNullOrEmpty(GroupDraft) ? null : GroupDraft; set => GroupDraft = value ?? ""; }
  string? DepartmentDraftOrNull { get => string.IsNullOrEmpty(DepartmentDraft) ? null : DepartmentDraft; set => DepartmentDraft = value ?? ""; }
  string? CategoryDraftOrNull { get => string.IsNullOrEmpty(CategoryDraft) ? null : CategoryDraft; set => CategoryDraft = value ?? ""; }

  // Seznami za PimPicker: isce se po imenu, sifra pa je vseeno del iskanega besedila (Key), da
  // najde tudi tisti, ki pozna samo sifro proizvajalca/dobavitelja, ne njegovega imena.
  List<PimPickerOption> ManufacturerOptions =>
    Facets.Where(row => row.FacetKind == "MANUFACTURER")
      .Select(facet => new PimPickerOption(facet.FacetValue, PartnerLabel(facet), Badge: facet.ProductCount.ToString("N0"))).ToList();

  List<PimPickerOption> SupplierOptions =>
    Facets.Where(row => row.FacetKind == "SUPPLIER")
      .Select(facet => new PimPickerOption(facet.FacetValue, PartnerLabel(facet), Badge: facet.ProductCount.ToString("N0"))).ToList();

  // Ime, dolgo do 32 znakov (sicer obrezano z "…"), in nato sifra v oklepaju — ista sifra kot na
  // strani Stranke (canon.PartnerName.PartnerCode). Ce imena ni (FacetLabel pade nazaj na sifro
  // samo), se sifra ne podvoji.
  const int PartnerLabelMaxLength = 32;
  static string PartnerLabel(ProductListFacet facet)
  {
    var name = facet.FacetLabel.Length > PartnerLabelMaxLength
      ? facet.FacetLabel[..PartnerLabelMaxLength] + "…"
      : facet.FacetLabel;
    return string.Equals(facet.FacetLabel, facet.FacetValue, StringComparison.Ordinal)
      ? name
      : $"{name} ({facet.FacetValue})";
  }

  List<PimPickerOption> GroupOptions =>
    Facets.Where(row => row.FacetKind == "ITEM_GROUP")
      .Select(facet => new PimPickerOption(facet.FacetValue, facet.FacetLabel, Badge: facet.ProductCount.ToString("N0"))).ToList();

  List<PimPickerOption> DepartmentOptions =>
    Facets.Where(row => row.FacetKind == "DEPARTMENT")
      .Select(facet => new PimPickerOption(facet.FacetValue, facet.FacetLabel, Badge: facet.ProductCount.ToString("N0"))).ToList();

  /// <summary>Pot, izdelki in velikost nabora — troje, po čemer se izbira kategorija za izvoz.</summary>
  List<PimPickerOption> CategoryPickerOptions =>
    CategoryOptions.GroupBy(row => row.CategoryTreeCode).OrderBy(group => group.Key, StringComparer.Ordinal)
      .SelectMany(tree => tree.Select(node => new PimPickerOption(
        $"{node.CategoryTreeCode}:{node.CategoryCode}", node.CategoryPath ?? node.CategoryName,
        Level: node.LevelNo - 1, Badge: $"{node.ProductCount:N0} izd., {node.AttributeCount:N0} atr.",
        Group: TreeLabel(node.CategoryTreeCode)))).ToList();

  // Enajst filtrov v eni vrsti je bilo natrpano in nepregledno. Odprejo se na zahtevo in
  // ostanejo odprti, dokler je kaj izbrano — sicer bi uporabnik izgubil sled, kaj je nastavil.
  bool? FiltersOpenOverride;

  const int Take = 50;

  int Skip => Math.Max(0, ((QueryPage ?? 1) - 1) * Take);
  string ActiveView => string.IsNullOrWhiteSpace(QueryView) ? "ALL" : QueryView.Trim().ToUpperInvariant();

  // Neveljavna stevilka v naslovu ne sme tiho pomeniti vseh podjetij; bralna procedura
  // neznano podjetje vrne kot prazen nabor, kar je iskrenejse od tihe razsiritve obsega.
  int? OrganizationScope => int.TryParse(QueryOrganization, out var value) ? value : null;

  /// <summary>
  /// U1, pregled 2026-09-08: napis tabele je pisal »Izdelki v aktivni organizaciji«, stran pa je
  /// privzeto kazala vsa podjetja. Napis odslej pove dejanski obseg, ne domnevnega.
  /// </summary>
  string ScopeCaption => OrganizationScope is int scope
    ? "Izdelki podjetja " + (Organizations.FirstOrDefault(row => row.OrganizationId == scope)?.Name ?? scope.ToString())
    : $"Izdelki vseh podjetij ({Organizations.Count})";

  /// <summary>
  /// Izbrana vrstica. Ime podjetja je tu zato, ker izbira sega cez podjetja: delovni list ima
  /// stolpec Podjetje in uvoz iz njega ve, komu vrstica pripada, zato izbire ni treba zozevati
  /// na eno podjetje kot prej pri mnozicnem urejanju.
  /// </summary>
  sealed record SelectedItem(int OrganizationId, string OrganizationName, string ItemId);

  static string SelectionKey(ProductListRow row) => row.OrganizationId + "|" + row.ItemId;

  static readonly IReadOnlyList<PimColumn> Columns =
  [
    new("Izbor"), new("Slika"), new("Izdelek"), new("Podjetje"), new("Proizvajalec"), new("Dobavitelj"),
    new("ERP"), new("Splet"), new("Popolnost"), new("Težave", Numeric: true), new("Vrzeli"), new("Zadnja sprememba"),
  ];

  sealed record FilterChip(string Label, string RemoveHref);

  protected override async Task OnInitializedAsync()
  {
    ExportJobs.Changed += OnExportJobChanged;
    try { Organizations = await Data.GetOrganizationsAsync(); }
    catch { Organizations = []; }
  }

  protected override async Task OnParametersSetAsync()
  {
    SearchDraft = QuerySearch ?? "";
    OrganizationDraft = QueryOrganization ?? "";
    ViewDraft = ActiveView == "ALL" ? "" : ActiveView;
    ManufacturerDraft = QueryManufacturer ?? "";
    SupplierDraft = QuerySupplier ?? "";
    GroupDraft = QueryGroup ?? "";
    DepartmentDraft = QueryDepartment ?? "";
    ErpDraft = QueryErp ?? "";
    WebDraft = QueryWeb ?? "";
    ActivityDraft = QueryActivity ?? "";
    WebPublishDraft = QueryWebPublish ?? "";
    CompletenessDraft = QueryCompleteness ?? "";
    ImageDraft = QueryImage ?? "";
    CategoryDraft = QueryCategory ?? "";
    SortDraft = string.IsNullOrWhiteSpace(QuerySort) ? "ITEM"
      : string.Equals(QueryDirection, "desc", StringComparison.OrdinalIgnoreCase) ? QuerySort + ":desc" : QuerySort;

    Loading = true;
    Error = null;
    try
    {
      // Vrednosti spustnih seznamov so vezane samo na obseg podjetja, zato se preberejo znova
      // sele ob njegovi spremembi, ne ob vsakem filtru.
      var scope = OrganizationScope;
      var scopeKey = scope?.ToString() ?? "";
      if (LoadedScope != scopeKey)
      {
        LoadedScope = scopeKey;
        Facets = await Workbench.GetProductListFacetsAsync(scope);
      }

      // Drevesa kategorij se ne spreminjajo med filtriranjem; preberejo se enkrat na sejo strani.
      if (CategoryOptions.Count == 0)
      {
        var picked = new List<CategoryTreeService.CategoryPickRow>();
        foreach (var treeCode in await Categories.GetTreeCodesAsync())
          picked.AddRange(await Categories.GetCategoryPickerAsync(treeCode));
        CategoryOptions = picked;
      }

      Page = await Workbench.GetProductListAsync(new ProductListFilter(
        scope, Skip, Take, QuerySearch, ActiveView,
        QueryManufacturer, QuerySupplier, QueryGroup, QueryErp, QueryWeb,
        QuerySort, string.Equals(QueryDirection, "desc", StringComparison.OrdinalIgnoreCase),
        "sl", QueryDepartment, QueryActivity, QueryWebPublish, QueryCompleteness, QueryImage,
        CategoryTreeOf(QueryCategory), CategoryCodeOf(QueryCategory)));
    }
    catch
    {
      Error = "Izdelkov trenutno ni mogoče naložiti.";
    }
    finally
    {
      Loading = false;
    }
  }

  string ResultSummary => Loading ? "Nalaganje …"
    : Error is not null ? "Rezultati niso na voljo"
    : $"{Page?.TotalCount ?? 0:N0} rezultatov";

  /* --- Kategorija -------------------------------------------------------------------------
     Vrednost filtra je »drevo:koda«. Dve polji bi pomenili dva spustna seznama in dve stanji v
     naslovu, uporabnik pa izbira eno stvar: kategorijo. Drevo je v vrednosti zato, ker sta kodi
     v dveh drevesih lahko enaki. */

  static string? CategoryTreeOf(string? value) =>
    string.IsNullOrWhiteSpace(value) || !value.Contains(':') ? null : value.Split(':', 2)[0];

  static string? CategoryCodeOf(string? value) =>
    string.IsNullOrWhiteSpace(value) ? null : value.Contains(':') ? value.Split(':', 2)[1] : value;

  static string TreeLabel(string treeCode) => treeCode switch
  {
    "svetila_si" => "Svetila.si",
    "videlektro" => "Videlektro",
    _ => treeCode,
  };

  string CategoryLabel(string value)
  {
    var tree = CategoryTreeOf(value);
    var code = CategoryCodeOf(value);
    var node = CategoryOptions.FirstOrDefault(row =>
      string.Equals(row.CategoryCode, code, StringComparison.OrdinalIgnoreCase)
      && (tree is null || string.Equals(row.CategoryTreeCode, tree, StringComparison.OrdinalIgnoreCase)));
    return node?.CategoryPath ?? node?.CategoryName ?? code ?? value;
  }

  List<FilterChip> ActiveChips
  {
    get
    {
      var chips = new List<FilterChip>();
      if (!string.IsNullOrWhiteSpace(QuerySearch)) chips.Add(new($"Iskanje: {QuerySearch}", Href(search: "")));
      if (!string.IsNullOrWhiteSpace(QueryOrganization)) chips.Add(new($"Podjetje: {OrganizationLabel(QueryOrganization)}", Href(organization: "")));
      if (ActiveView != "ALL") chips.Add(new($"Napaka: {ViewLabel(ActiveView)}", Href(view: "")));
      if (!string.IsNullOrWhiteSpace(QueryManufacturer)) chips.Add(new($"Proizvajalec: {QueryManufacturer}", Href(manufacturer: "")));
      if (!string.IsNullOrWhiteSpace(QuerySupplier)) chips.Add(new($"Dobavitelj: {QuerySupplier}", Href(supplier: "")));
      if (!string.IsNullOrWhiteSpace(QueryGroup)) chips.Add(new($"Skupina: {QueryGroup}", Href(group: "")));
      if (!string.IsNullOrWhiteSpace(QueryDepartment)) chips.Add(new($"ABC klasifikacija: {QueryDepartment}", Href(department: "")));
      if (!string.IsNullOrWhiteSpace(QueryErp)) chips.Add(new($"ERP: {StatusLabel(QueryErp)}", Href(erp: "")));
      if (!string.IsNullOrWhiteSpace(QueryWeb)) chips.Add(new($"Splet: {StatusLabel(QueryWeb)}", Href(web: "")));
      if (!string.IsNullOrWhiteSpace(QueryActivity)) chips.Add(new($"Aktivnost: {ActivityLabel(QueryActivity)}", Href(activity: "")));
      if (!string.IsNullOrWhiteSpace(QueryWebPublish)) chips.Add(new($"Za splet: {WebPublishLabel(QueryWebPublish)}", Href(webPublish: "")));
      if (!string.IsNullOrWhiteSpace(QueryCompleteness)) chips.Add(new($"Popolnost: {CompletenessLabel(QueryCompleteness)}", Href(completeness: "")));
      if (!string.IsNullOrWhiteSpace(QueryImage)) chips.Add(new($"Slika: {ImageLabel(QueryImage)}", Href(image: "")));
      if (!string.IsNullOrWhiteSpace(QueryCategory)) chips.Add(new($"Kategorija: {CategoryLabel(QueryCategory)}", Href(category: "")));
      return chips;
    }
  }

  // Filtri, pogled, razvrscanje in stran zivijo v naslovu: povezavo je mogoce deliti, gumb Nazaj
  // pa dela. Sentinel "" pomeni "odstrani ta filter", null pomeni "ohrani obstojecega".
  string Href(string? view = null, string? search = null, string? organization = null, string? manufacturer = null,
    string? supplier = null, string? group = null, string? department = null, string? erp = null, string? web = null,
    string? activity = null, string? webPublish = null, string? completeness = null, string? image = null,
    string? category = null, string? sort = null, string? direction = null, int? page = null)
  {
    var parameters = new List<string>();
    Add("pogled", Resolve(view, ActiveView == "ALL" ? null : ActiveView));
    Add("isci", Resolve(search, QuerySearch));
    Add("podjetje", Resolve(organization, QueryOrganization));
    Add("proizvajalec", Resolve(manufacturer, QueryManufacturer));
    Add("dobavitelj", Resolve(supplier, QuerySupplier));
    Add("skupina", Resolve(group, QueryGroup));
    Add("oddelek", Resolve(department, QueryDepartment));
    Add("erp", Resolve(erp, QueryErp));
    Add("splet", Resolve(web, QueryWeb));
    Add("aktivnost", Resolve(activity, QueryActivity));
    Add("objava", Resolve(webPublish, QueryWebPublish));
    Add("popolnost", Resolve(completeness, QueryCompleteness));
    Add("slika", Resolve(image, QueryImage));
    Add("kategorija", Resolve(category, QueryCategory));
    Add("sort", Resolve(sort, QuerySort));
    Add("smer", Resolve(direction, QueryDirection));
    var resolvedPage = page ?? (view is null && search is null && organization is null && manufacturer is null
      && supplier is null && group is null && department is null && erp is null && web is null && activity is null
      && webPublish is null && completeness is null && image is null && sort is null && direction is null ? QueryPage : null);
    if (resolvedPage is > 1) parameters.Add("stran=" + resolvedPage);

    return parameters.Count == 0 ? "izdelki" : "izdelki?" + string.Join('&', parameters);

    void Add(string name, string? value)
    {
      if (!string.IsNullOrWhiteSpace(value)) parameters.Add(name + "=" + Uri.EscapeDataString(value));
    }

    static string? Resolve(string? requested, string? current) => requested is null ? current : requested;
  }

  // Obseg izvoza pove izbira v tabeli, ne skrit spustni seznam: ce je kaj izbrano, gredo ven
  // izbrani, sicer cel pogled. Gumb to izpise, da uporabniku ni treba ugibati. Brez zgornje
  // meje — uporabnikova zahteva 2026-09-17, ker izbira zdaj potuje v pomnilniku do izvoza v
  // ozadju (StartExportAsync), ne vec skozi dolzino naslova (ExportJobService).
  string ExportScopeLabel => Selected.Count == 0 ? "(cel pogled)" : $"(izbrani: {Selected.Count:N0})";

  // Stanje trenutnega izvoza v ozadju; null = se ni bilo sproženo (ali je uporabnik skril
  // sporocilo). JobId sluzi kot filter na dogodku ExportJobs.Changed — nastavljen je PRED
  // klicem StartWorkbookExport, da noben dogodek (tudi zelo hiter) ne uide (glej OnExportJobChanged).
  Guid? ExportJobId;
  ExportRunStatus? ExportState;
  string? ExportDownloadUrl;
  string? ExportErrorMessage;
  // Polozaj v vrsti (Queued) in napredek (Running) — oboje pride z dogodkom ExportJobs.Changed.
  int ExportQueuePosition;
  int? ExportRowCount;

  // Skupine stolpcev, ki jih uporabnik lahko izklopi (pojavno okno »Stolpci«). Ključ ni na
  // seznamu in gre v izvoz vedno — glej ProductWorkbookService.BuildAsync/Included. Privzeto so
  // izbrane vse; uvoz nazaj potrebuje ta seznam samo posredno (manj stolpcev v datoteki).
  static readonly string[] AllWorkbookGroups =
  [
    ProductWorkbookContract.GroupErp,
    ProductWorkbookContract.GroupWeb,
    ProductWorkbookContract.GroupAttributesInSet,
    ProductWorkbookContract.GroupAttributesOutside,
    ProductWorkbookContract.GroupState,
  ];
  bool ColumnPickerOpen;
  HashSet<string> IncludedGroups = new(AllWorkbookGroups, StringComparer.Ordinal);

  void OpenColumnPicker() => ColumnPickerOpen = true;
  void CloseColumnPicker() => ColumnPickerOpen = false;
  void ToggleColumnGroup(string group, bool included)
  {
    if (included) IncludedGroups.Add(group); else IncludedGroups.Remove(group);
  }
  void SelectAllColumnGroups() => IncludedGroups = new(AllWorkbookGroups, StringComparer.Ordinal);

  // Izvoz uporabi natanko iste filtre kot pogled: kar vidis, je to, kar se izvozi. Oblika je
  // delovni zvezek, ker ga uporabnik odpre v Excelu brez carovnika za uvoz.
  ProductListFilter BuildExportFilter() => new(
    OrganizationScope, 0, Take, QuerySearch, ActiveView,
    QueryManufacturer, QuerySupplier, QueryGroup, QueryErp, QueryWeb,
    QuerySort, string.Equals(QueryDirection, "desc", StringComparison.OrdinalIgnoreCase),
    "sl", QueryDepartment, QueryActivity, QueryWebPublish, QueryCompleteness, QueryImage,
    CategoryTreeOf(QueryCategory), CategoryCodeOf(QueryCategory));

  void StartExportAsync()
  {
    ExportErrorMessage = null;
    ExportDownloadUrl = null;
    ExportState = ExportRunStatus.Queued;
    ExportQueuePosition = 0;
    ExportRowCount = null;

    var jobId = Guid.NewGuid();
    ExportJobId = jobId;
    var selection = Selected.Count > 0
      ? Selected.Values.Select(item => $"{item.OrganizationId}|{item.ItemId}").ToList()
      : null;
    // Vse skupine izbrane = brez omejitve (null); tako izvoz z nespremenjeno izbiro ostane
    // popolnoma isti kot doslej, brez odvisnosti od vrstnega reda AllWorkbookGroups.
    var includeGroups = IncludedGroups.Count >= AllWorkbookGroups.Length ? null : (IReadOnlySet<string>)IncludedGroups;
    ExportJobs.StartWorkbookExport(
      jobId, ProductWorkbookService.FileName(DateTime.UtcNow), BuildExportFilter(), selection, includeGroups);
  }

  // Dogodek pride iz ExportJobService, torej lahko iz drugega vezja niti (Task.Run v ozadju) —
  // zato InvokeAsync, ne neposredna sprememba polj. Prenos se sprozi tu, ne v markupu, ker mora
  // steci natanko enkrat, takoj ko je token znan.
  void OnExportJobChanged(ExportJobState state)
  {
    if (state.JobId != ExportJobId) return;
    _ = InvokeAsync(async () =>
    {
      ExportState = state.Status;
      ExportErrorMessage = state.Error;
      ExportQueuePosition = state.QueuePosition;
      ExportRowCount = state.RowCount;
      if (state.Status == ExportRunStatus.Completed && state.DownloadToken is { } token)
      {
        ExportDownloadUrl = $"izvoz/prenos/{token}";
        StateHasChanged();
        await Js.InvokeVoidAsync("pimDownloadFile", ExportDownloadUrl);
      }
      else
      {
        StateHasChanged();
      }
    });
  }

  void DismissExportNotice()
  {
    ExportState = null;
    ExportDownloadUrl = null;
    ExportErrorMessage = null;
  }

  public void Dispose() => ExportJobs.Changed -= OnExportJobChanged;

  Task ApplyFiltersAsync()
  {
    var sort = SortDraft.Split(':');
    Navigation.NavigateTo(Href(
      view: ViewDraft, search: SearchDraft.Trim(), organization: OrganizationDraft, manufacturer: ManufacturerDraft,
      supplier: SupplierDraft, group: GroupDraft, department: DepartmentDraft, erp: ErpDraft, web: WebDraft,
      activity: ActivityDraft, webPublish: WebPublishDraft, completeness: CompletenessDraft,
      image: ImageDraft,
      category: CategoryDraft,
      sort: sort[0] == "ITEM" ? "" : sort[0], direction: sort.Length > 1 ? "desc" : "", page: 1));
    return Task.CompletedTask;
  }

  // Razvrstitev ucinkuje takoj: ni filter in ne potrebuje gumba Uporabi.
  Task ApplySortAsync()
  {
    var sort = SortDraft.Split(':');
    Navigation.NavigateTo(Href(sort: sort[0] == "ITEM" ? "" : sort[0], direction: sort.Length > 1 ? "desc" : "", page: 1));
    return Task.CompletedTask;
  }

  // Proizvajalci, dobavitelji, skupine in oddelki so vrednosti izbranega podjetja. Ko se
  // podjetje spremeni, stara izbira v novem podjetju najpogosteje ne obstaja in bi vrnila
  // prazen seznam brez pojasnila, zato se ob zamenjavi sprosti.
  bool FiltersOpen => FiltersOpenOverride ?? ActiveChips.Count > 0;

  void ToggleFilters() => FiltersOpenOverride = !FiltersOpen;

  void OrganizationDraftChanged()
  {
    ManufacturerDraft = "";
    SupplierDraft = "";
    GroupDraft = "";
    DepartmentDraft = "";
  }

  Task SearchKeyAsync(KeyboardEventArgs args) =>
    args.Key == "Enter" ? ApplyFiltersAsync() : Task.CompletedTask;

  Task GoToSkipAsync(int skip)
  {
    Navigation.NavigateTo(Href(page: skip / Take + 1));
    return Task.CompletedTask;
  }

  // Cela vrstica je povezava do kartice. Naziv zato ni <a> — podcrtan naziv sredi vrstice, ki
  // je vsa klikljiva, obljublja dve razlicni dejanji, pa je le eno.
  async Task OpenAsync(ProductListRow row)
  {
    // Kartica se nalaga vec kot trenutek. Brez tega je uporabnik ostal na seznamu brez znaka,
    // da se karkoli dogaja, in je klikal znova. Prekrivalo se izrise, preden se navigacija
    // zacne — StateHasChanged in prepustitev niti sta zato nujna, ne okras.
    Opening = row.ProductId;
    StateHasChanged();
    await Task.Yield();
    Navigation.NavigateTo($"izdelki/{row.ProductId}");
  }

  Task OpenKeyAsync(KeyboardEventArgs args, ProductListRow row) =>
    args.Key is "Enter" or " " ? OpenAsync(row) : Task.CompletedTask;

  // Izdelek, ki se odpira; null pomeni, da se nic ne odpira.
  long? Opening;

  void Toggle(ProductListRow row, ChangeEventArgs args)
  {
    var key = SelectionKey(row);
    if (args.Value is true) Selected[key] = new(row.OrganizationId, row.OrganizationName, row.ItemId);
    else Selected.Remove(key);
  }

  // Sifre gredo skupaj s podjetjem, ker jih mnozicno urejanje pise nazaj v SAOP tega podjetja.
  string OrganizationLabel(string? value) =>
    int.TryParse(value, out var id)
      ? Organizations.FirstOrDefault(row => row.OrganizationId == id)?.Name ?? $"neznano ({value})"
      : value ?? "";

  static string ActivityLabel(string? value) => value switch
  {
    "ACTIVE" => "samo aktivni",
    "INACTIVE" => "samo neaktivni",
    _ => value ?? "",
  };

  static string ViewLabel(string? value) => value?.Trim().ToUpperInvariant() switch
  {
    "TO_FIX" => "za urediti",
    "NO_IMAGE" => "brez slike",
    "NO_WEB_TITLE" => "brez spletnega naziva",
    "NO_CATEGORY" => "brez kategorije",
    "NO_EAN" => "brez EAN",
    "NOT_PUBLISHED" => "neobjavljeni",
    "WAITING_SAOP" => "čaka SAOP",
    _ => value ?? "",
  };

  static string ImageLabel(string? value) => value switch
  {
    "YES" => "ima sliko",
    "NO" => "brez slike",
    _ => value ?? "",
  };

  static string WebPublishLabel(string? value) => value switch
  {
    "YES" => "označeni",
    "NO" => "neoznačeni",
    _ => value ?? "",
  };

  static string CompletenessLabel(string? value) => value switch
  {
    "EMPTY" => "0 %",
    "LOW" => "pod 50 %",
    "MID" => "50–99 %",
    "FULL" => "100 %",
    _ => value ?? "",
  };

  static string StatusLabel(string? status) => status switch
  {
    "VALID" => "Pripravljen",
    "INVALID" => "Blokiran",
    "PENDING" => "Čaka validacijo",
    "NOT_CONFIGURED" => "Ni profila",
    _ => status ?? "—",
  };

  static string Tone(string status) => status switch
  {
    "VALID" => "good",
    "INVALID" => "bad",
    "NOT_CONFIGURED" => "",
    _ => "warn",
  };
}
