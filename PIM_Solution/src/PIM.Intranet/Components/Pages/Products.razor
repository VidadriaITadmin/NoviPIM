  string PackagingLabel(string value) => value.ToUpperInvariant() switch
  {
    "ANY" => "ima S kodo",
    "NONE" => "brez S kode",
    var code => PackagingCodes.FirstOrDefault(item => item.Code == code) is { } found ? $"{found.Code} ({found.Percent:0.##} %)" : code,
  };

  string SpecialLabel(string value)
  {
    if (string.Equals(value, "ANY", StringComparison.OrdinalIgnoreCase)) return "katerikoli";
    if (value.StartsWith("TYPE:", StringComparison.OrdinalIgnoreCase))
    {
      var code = value[5..];
      return "tip " + (CustomerTypes.FirstOrDefault(type => string.Equals(type.CustomerTypeCode, code, StringComparison.OrdinalIgnoreCase))?.Name ?? code);
    }
    return value.StartsWith("CUSTOMER:", StringComparison.OrdinalIgnoreCase) ? "stranka " + value[9..] : value;
  }

  /// <summary>
  /// S-popust za izbrane ali za cel pogled. Privzeti S gre skozi en množični zapis na podjetje
  /// (pim.SaveProductPackagingDiscountsBulk, z zgodovino); posebni S za tip ali stranko je pravilo
  /// na izdelku (b2b.SavePackagingDiscountRule), prazna koda ga umakne.
  /// </summary>
  async Task ApplyBulkAsync(bool wholeView)
  {
    BulkBusy = true; BulkMessage = null; BulkProblems = [];
    try
    {
      var actor = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";
      List<(int OrganizationId, string ItemId)> targets;
      if (wholeView)
      {
        targets = [];
        var filter = BuildExportFilter();
        for (var skip = 0; ; skip += 20_000)
        {
          var page = await Workbench.GetProductListAsync(filter with { Skip = skip, Take = 20_000 });
          targets.AddRange(page.Rows.Select(row => (row.OrganizationId, row.ItemId)));
          if (page.Rows.Count == 0 || targets.Count >= page.TotalCount) break;
        }
      }
      else targets = Selected.Values.Select(item => (item.OrganizationId, item.ItemId)).ToList();

      var code = BulkCode.Length == 0 ? null : BulkCode;
      var customerKey = BulkKind == "CUSTOMER" ? BulkCustomer.Trim() : null;
      if (BulkKind == "CUSTOMER" && string.IsNullOrEmpty(customerKey)) { BulkProblems.Add("Vpiši šifro stranke."); return; }
      var changed = 0;
      foreach (var organization in targets.GroupBy(target => target.OrganizationId))
      {
        if (BulkKind == "DEFAULT")
        {
          var outcome = await Packaging.SaveDefaultsBulkAsync(organization.Key,
            organization.Select(target => (target.ItemId, code)).ToList(), actor, "Seznam izdelkov", "INTRANET");
          changed += outcome.Changed;
          BulkProblems.AddRange(outcome.Skipped.Select(skip => $"{skip.ItemId}: {skip.Reason}"));
          continue;
        }

        var existing = code is not null
          ? new Dictionary<string, PackagingRule>(StringComparer.OrdinalIgnoreCase)
          : (await Packaging.GetRulesAsync(organization.Key))
            .Where(rule => rule.ScopeKind == PackagingDiscountService.ScopeItem && rule.TargetKind == BulkKind && rule.ItemId is not null
              && string.Equals(rule.TargetCode, BulkKind == "TYPE" ? BulkType : customerKey, StringComparison.OrdinalIgnoreCase))
            .ToDictionary(rule => rule.ItemId!, StringComparer.OrdinalIgnoreCase);
        await using var connection = await Packaging.OpenAsync();
        var done = 0;
        var total = organization.Count();
        foreach (var target in organization)
        {
          try
          {
            if (code is not null)
            {
              await Packaging.SaveRuleAsync(organization.Key, new(BulkKind, BulkKind == "TYPE" ? BulkType : null, null, customerKey,
                PackagingDiscountService.ScopeItem, target.ItemId, null, null, code), actor, connection: connection);
              changed++;
            }
            else if (existing.TryGetValue(target.ItemId, out var rule))
            {
              await Packaging.RemoveRuleAsync(organization.Key, rule.RuleId, actor, connection: connection);
              changed++;
            }
          }
          catch (Microsoft.Data.SqlClient.SqlException failure) { BulkProblems.Add($"{target.ItemId}: {failure.Message}"); }
          if (++done % 250 == 0) { BulkMessage = $"Zapisujem … {done:N0} od {total:N0}"; StateHasChanged(); }
        }
      }
      BulkMessage = $"S-popust zapisan: {changed:N0} sprememb na {targets.Count:N0} izdelkih. V katalog.csv gre ob naslednjem izvozu.";
    }
    catch (Exception failure) { BulkProblems.Add("Zapis ni uspel: " + failure.Message); }
    finally { BulkBusy = false; }
  }

