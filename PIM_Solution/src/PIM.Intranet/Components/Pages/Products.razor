  // šifra, naziv) ni na seznamu in gre v izvoz vedno — glej ProductWorkbookService.BuildAsync/
  // Included. IncludedFieldKeys == null pomeni »vsa polja«, kar je tudi privzeto stanje; s tem
  // izvoz, ki okna nikoli ne odpre, ostane popolnoma enak, kot je bil doslej. Seznam polj sam je
  // odvisen od konteksta (kategorija doloca nabor atributov, podjetje jezike), zato pride s
  // streznika ob vsakem odpiranju okna, ne iz staticnega seznama skupin kot prej.
  bool ColumnPickerOpen;
  bool ColumnPickerLoading;
  string? ColumnPickerError;
  IReadOnlyList<ProductWorkbookColumn> AvailableColumns = [];
  HashSet<string>? IncludedFieldKeys;
  string ColumnSearch = "";

  int TotalColumnCount => AvailableColumns.Count;
  int SelectedColumnCount => IncludedFieldKeys?.Count ?? AvailableColumns.Count;

  sealed record ColumnPickerGroup(string Group, IReadOnlyList<ProductWorkbookColumn> Columns);

  // Iskanje filtrira polja, ne skupin: skupina brez zadetka preprosto izgine iz seznama. Vrstni
  // red skupin in polj znotraj njih je isti kot v datoteki (ProductWorkbookContract.Build) —
  // levo je tisto, po čemer se vrstica najde, potem tisto, kar uporabnik vpisuje.
  List<ColumnPickerGroup> FilteredGroups =>
    AvailableColumns
      .Where(column => string.IsNullOrWhiteSpace(ColumnSearch)
        || column.Header.Contains(ColumnSearch, StringComparison.OrdinalIgnoreCase))
      .GroupBy(column => column.Group)
      .Select(group => new ColumnPickerGroup(group.Key, group.ToList()))
      .ToList();

  bool IsIncluded(string fieldKey) => IncludedFieldKeys is null || IncludedFieldKeys.Contains(fieldKey);

  int GroupTotalCount(string group) => AvailableColumns.Count(column => column.Group == group);
  int GroupSelectedCount(string group) => AvailableColumns.Count(column => column.Group == group && IsIncluded(column.FieldKey));

  async Task OpenColumnPickerAsync()
  {
    ColumnPickerOpen = true;
    ColumnPickerLoading = true;
    ColumnPickerError = null;
    ColumnSearch = "";
    StateHasChanged();
    try
    {
      AvailableColumns = (await Workbook.DescribeColumnsAsync(BuildExportFilter()))
        .Where(column => column.Group != ProductWorkbookContract.GroupKey).ToList();
    }
    catch
    {
      AvailableColumns = [];
      ColumnPickerError = "Seznama polj trenutno ni mogoče naložiti.";
    }
    finally
    {
      ColumnPickerLoading = false;
    }
  }

  void CloseColumnPicker() => ColumnPickerOpen = false;

  void ToggleColumn(string fieldKey, bool included)
  {
    IncludedFieldKeys ??= AvailableColumns.Select(column => column.FieldKey).ToHashSet(StringComparer.Ordinal);
    if (included) IncludedFieldKeys.Add(fieldKey); else IncludedFieldKeys.Remove(fieldKey);
  }

  void ToggleGroup(string group, bool included)
  {
    IncludedFieldKeys ??= AvailableColumns.Select(column => column.FieldKey).ToHashSet(StringComparer.Ordinal);
    foreach (var column in AvailableColumns.Where(column => column.Group == group))
      if (included) IncludedFieldKeys.Add(column.FieldKey); else IncludedFieldKeys.Remove(column.FieldKey);
  }

  void SelectAllColumns() => IncludedFieldKeys = null;
  void SelectNoColumns() => IncludedFieldKeys = new(StringComparer.Ordinal);

  // Izvoz uporabi natanko iste filtre kot pogled: kar vidis, je to, kar se izvozi. Oblika je
  // delovni zvezek, ker ga uporabnik odpre v Excelu brez carovnika za uvoz.
  ProductListFilter BuildExportFilter() => new(
    OrganizationScope, 0, Take, QuerySearch, ActiveView,
    QueryManufacturer, QuerySupplier, QueryGroup, QueryErp, QueryWeb,
    QuerySort, string.Equals(QueryDirection, "desc", StringComparison.OrdinalIgnoreCase),
    "sl", QueryDepartment, QueryActivity, QueryWebPublish, QueryCompleteness, QueryImage,
    CategoryTreeOf(QueryCategory), CategoryCodeOf(QueryCategory),
    QueryPackaging, QueryDiscountGroup, QuerySpecial);

  async Task StartExportAsync()
  {
    ExportState = ExportRunStatus.Queued;

    var jobId = Guid.NewGuid();
    ExportJobId = jobId;
    var selection = Selected.Count > 0
      ? Selected.Values.Select(item => $"{item.OrganizationId}|{item.ItemId}").ToList()
      : null;
    // null pomeni »vsa polja« — privzeto stanje, dokler uporabnik ne odpre okna »Stolpci« in
    // kaj odkljuka; tako izvoz z nespremenjeno izbiro ostane popolnoma isti kot doslej.
    ExportJobs.StartWorkbookExport(
      jobId, ExportOwner, ProductWorkbookService.FileName(DateTime.UtcNow), BuildExportFilter(), selection, IncludedFieldKeys);
    try
    {
      // Prenos se odpre ZDAJ, dokler brskalnik klik se steje za uporabnikovo dejanje (nekaj
      // sekund) — ne ob koncu gradnje. Tak prenos brskalnik pokaze v svojem polju prenosov
      // takoj in ga ne zadrzi kot sumljivega (»Obdrži«). Glej ExportDownloadEndpoint.
      await Js.InvokeVoidAsync("pimDownloadFile", $"izvoz/zvezek/{jobId}");
      // Okno izvozov (wwwroot/js/pim-export.js) sicer bere stanje ob nalaganju strani; tu ga
      // zbudimo takoj, da napredek pokaze od prvega trenutka, ne sele ob naslednji navigaciji.
      await Js.InvokeVoidAsync("pimExports.refresh");
    }
    catch (JSException) { }
    catch (JSDisconnectedException) { }
  }

  // Dogodek pride iz ExportJobService, torej iz niti gradnje — zato InvokeAsync, ne neposredna
  // sprememba polj. Tu se samo odklene gumb; prenos sprozi okno izvozov, ki ga vidi tudi stran,
  // na katero je uporabnik medtem odsel.
  void OnExportJobChanged(ExportJobState state)
  {
    if (state.JobId != ExportJobId || state.Status == ExportState) return;
    _ = InvokeAsync(() =>
    {
      ExportState = state.Status;
      StateHasChanged();
    });
  }

  public void Dispose() => ExportJobs.Changed -= OnExportJobChanged;

  Task ApplyFiltersAsync()
  {
    var sort = SortDraft.Split(':');
    Navigation.NavigateTo(Href(
      view: ViewDraft, search: SearchDraft.Trim(), organization: OrganizationDraft, manufacturer: ManufacturerDraft,
      supplier: SupplierDraft, group: GroupDraft, department: DepartmentDraft, erp: ErpDraft, web: WebDraft,
      activity: ActivityDraft, webPublish: WebPublishDraft, completeness: CompletenessDraft,
      image: ImageDraft,
      category: CategoryDraft,
      sort: sort[0] == "ITEM" ? "" : sort[0], direction: sort.Length > 1 ? "desc" : "", page: 1,
      packaging: PackagingDraft, discountGroup: DiscountGroupDraft, special: SpecialDraftValue));
    return Task.CompletedTask;
  }

  // Razvrstitev ucinkuje takoj: ni filter in ne potrebuje gumba Uporabi.
  Task ApplySortAsync()
  {
    var sort = SortDraft.Split(':');
    Navigation.NavigateTo(Href(sort: sort[0] == "ITEM" ? "" : sort[0], direction: sort.Length > 1 ? "desc" : "", page: 1));
    return Task.CompletedTask;
  }

  // Proizvajalci, dobavitelji, skupine in oddelki so vrednosti izbranega podjetja. Ko se
  // podjetje spremeni, stara izbira v novem podjetju najpogosteje ne obstaja in bi vrnila
  // prazen seznam brez pojasnila, zato se ob zamenjavi sprosti.
  bool FiltersOpen => FiltersOpenOverride ?? ActiveChips.Count > 0;

