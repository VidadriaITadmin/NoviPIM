@page "/izdelki"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using PIM.Operations
@inject IntranetDataService Data
@inject ProductWorkbenchService Workbench
@inject CategoryTreeService Categories
@inject NavigationManager Navigation
@inject ExportJobService ExportJobs
@inject ProductWorkbookService Workbook
@inject IJSRuntime Js
@inject AuthenticationStateProvider Authentication
@inject PackagingDiscountService Packaging

<PageTitle>Izdelki</PageTitle>

<PimPage Title="Izdelki" Subtitle="Delovni seznam kataloga vseh podjetij: kaj je pripravljeno za ERP, kaj za splet in kaj manjka. Privzeto so vsa podjetja; filter zoži na eno." />
<PimTabs Active="seznam" Tabs="ProductTabs.Tabs" Label="Pogledi izdelkov" />

<section class="ui-card toolbar" role="search" aria-labelledby="products-filter-title">
  <h2 id="products-filter-title" class="visually-hidden">Filtriranje izdelkov</h2>

  <div class="toolbar-row">
    <div class="search-field">
      <span class="search-icon" aria-hidden="true"></span>
      <label class="visually-hidden" for="product-search">Išči po artiklu ali EAN</label>
      <input id="product-search" type="search" class="search-input" placeholder="Išči po šifri artikla ali EAN …" @bind="SearchDraft" @bind:event="oninput" @onkeydown="SearchKeyAsync" />
    </div>

    <button type="button" class="ghost-button filter-toggle @(FiltersOpen ? "open" : null)" aria-expanded="@FiltersOpen.ToString().ToLowerInvariant()" aria-controls="products-filter-panel" @onclick="ToggleFilters">
      <span class="funnel" aria-hidden="true"></span>Filtri
      @if (ActiveChips.Count > 0) { <span class="filter-badge">@ActiveChips.Count</span> }
    </button>

    <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>

    @* Dve dejanji in nic vec. Uporabnik 2026-09-08: »zakaj imava petsto gumbov, naredi samo
       izvoz in uvoz«. Sest gumbov v vrsti je bilo sest vprasanj namesto enega odgovora.

       Kar je odslo, ni izginilo. Predloga SAOP je se vedno svoja predloga istega izvoza,
       cakalna lista artiklov je zavihek Artikli v razdelku SAOP, mnozicno urejanje pa je
       povezano s strani kakovosti in s strani uvoza. Tu ostane samo pot, po kateri se dela
       vsak dan: datoteka ven, popravljena datoteka nazaj.

       Obseg izvoza pove izbira v tabeli — ce je kaj izbrano, gredo ven izbrani, sicer cel
       pogled — in gumb to prebere na glas. *@
    <div class="toolbar-actions">
      @* Katere skupine stolpcev gredo v datoteko — uporabnikova zahteva: manj podatkov je manjši
         izvoz IN hitrejši uvoz nazaj (posodobi se samo, kar je v datoteki). Privzeto vse; ključ
         (podjetje, šifra, naziv) gre v datoteko vedno in tu ni izbirljiv. *@
      <button type="button" class="ghost-button" @onclick="OpenColumnPickerAsync"
              title="Izberi, katera polja gredo v izvoz. Manj stolpcev je manjša datoteka in hitrejši uvoz nazaj — uvoz posodobi samo stolpce, ki so v datoteki.">
        Stolpci
        @if (IncludedFieldKeys is not null) { <span class="filter-badge">@SelectedColumnCount/@TotalColumnCount</span> }
      </button>
      <button type="button" class="primary-button" disabled="@(ExportState is ExportRunStatus.Running or ExportRunStatus.Queued)" @onclick="StartExportAsync"
              title="@(ExportState is ExportRunStatus.Running or ExportRunStatus.Queued
                ? "Tvoj izvoz že teče — prenos je odprt v brskalniku, napredek je v oknu spodaj desno, na vsaki strani."
                : "ERP, splet, spletne strani, kategorije in atributi v eni datoteki; uredi jo v Excelu in vrni nazaj. Prenos se v brskalniku odpre takoj, datoteka pride, ko je gotova — vmes lahko greš na drugo stran.")">
        @if (ExportState is ExportRunStatus.Running or ExportRunStatus.Queued) { <span class="opening-spinner" aria-hidden="true"></span> }
        Izvozi Excel @ExportScopeLabel
      </button>
      <a class="ghost-button" href="izdelki/uvoz" title="Urejena datoteka se vrne v PIM: spletni podatki takoj, ERP polja v vrsto za SAOP.">Uvozi Excel</a>
      <a class="ghost-button" href="izdelki/odprodaja" title="Artikli v odprodaji: ročni vnos, uvoz seznama iz Excela, razstavni eksponat.">Odprodaja</a>
    </div>
  </div>

  <div id="products-filter-panel" class="filter-panel" hidden="@(!FiltersOpen)">
    <div class="filter-grid">
      <div class="filter-field">
        <label for="product-organization">Podjetje</label>
        <select id="product-organization" class="filter-select" @bind="OrganizationDraft" @bind:after="OrganizationDraftChanged">
          <option value="">Vsa podjetja</option>
          @foreach (var organization in Organizations)
          {
            <option value="@organization.OrganizationId">@organization.Name</option>
          }
        </select>
      </div>

      @* Napaka nadomesti nekdanjo vrstico zavihkov (Za urediti, Brez slike, …): ista izbira, en
         filter, brez locenega stetja ob vsaki zamenjavi podjetja. Uporabnik 2026-09-17: »a bi
         stran kej hitreje delal ce to odstraniva, sej to lahk vse v filtre dodava«. *@
      <div class="filter-field">
        <label for="product-view">Napaka</label>
        <select id="product-view" class="filter-select" @bind="ViewDraft">
          <option value="">Vse</option>
          <option value="TO_FIX">Za urediti (katerakoli napaka)</option>
          <option value="NO_IMAGE">Brez slike</option>
          <option value="NO_WEB_TITLE">Brez spletnega naziva</option>
          <option value="NO_CATEGORY">Brez kategorije</option>
          <option value="NO_EAN">Brez EAN</option>
          <option value="NOT_PUBLISHED">Neobjavljeni</option>
          <option value="WAITING_SAOP">Čaka SAOP</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-manufacturer">Proizvajalec</label>
        <PimPicker Id="product-manufacturer" Options="ManufacturerOptions" @bind-Value="ManufacturerDraftOrNull"
                   Placeholder="Vsi proizvajalci" EmptyText="Ni proizvajalcev." />
      </div>

      <div class="filter-field">
        <label for="product-supplier">Dobavitelj</label>
        <PimPicker Id="product-supplier" Options="SupplierOptions" @bind-Value="SupplierDraftOrNull"
                   Placeholder="Vsi dobavitelji" EmptyText="Ni dobaviteljev." />
      </div>

      <div class="filter-field">
        <label for="product-group">Skupina artikla</label>
        <PimPicker Id="product-group" Options="GroupOptions" @bind-Value="GroupDraftOrNull"
                   Placeholder="Vse skupine" EmptyText="Ni skupin." />
      </div>

      @* Kategorija je filter in ne pogled: izbrana kategorija zoži seznam IN določi, katere
         atribute nosi delovni list. Ob imenu stojita število izdelkov pod kategorijo in
         velikost njenega nabora, sicer bi uporabnik izbiral naslepo. *@
      <div class="filter-field filter-field-wide">
        <label for="product-category">Kategorija</label>
        <PimPicker Id="product-category" Options="CategoryPickerOptions" @bind-Value="CategoryDraftOrNull"
                   Placeholder="Vse kategorije" EmptyText="Ni kategorij." />
      </div>

      <div class="filter-field">
        <label for="product-image">Slika</label>
        <select id="product-image" class="filter-select" @bind="ImageDraft">
          <option value="">Vsi</option>
          <option value="YES">Ima sliko</option>
          <option value="NO">Brez slike</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-department">ABC klasifikacija</label>
        <PimPicker Id="product-department" Options="DepartmentOptions" @bind-Value="DepartmentDraftOrNull"
                   Placeholder="Vse klasifikacije" EmptyText="Ni klasifikacij." />
      </div>

      <div class="filter-field">
        <label for="product-erp">Pripravljenost za ERP</label>
        <select id="product-erp" class="filter-select" @bind="ErpDraft">
          <option value="">Vsi</option>
          <option value="VALID">Pripravljeni za ERP</option>
          <option value="INVALID">Blokirani za ERP</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-web">Pripravljenost za splet</label>
        <select id="product-web" class="filter-select" @bind="WebDraft">
          <option value="">Vsi</option>
          <option value="VALID">Pripravljeni za splet</option>
          <option value="INVALID">Blokirani za splet</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-activity">Aktivnost artikla</label>
        <select id="product-activity" class="filter-select" @bind="ActivityDraft">
          <option value="">Vsi</option>
          <option value="ACTIVE">Samo aktivni</option>
          <option value="INACTIVE">Samo neaktivni</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-webpublish">Zastavica za splet</label>
        <select id="product-webpublish" class="filter-select" @bind="WebPublishDraft">
          <option value="">Vsi</option>
          <option value="YES">Označeni za splet</option>
          <option value="NO">Neoznačeni za splet</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-completeness">Popolnost</label>
        <select id="product-completeness" class="filter-select" @bind="CompletenessDraft">
          <option value="">Vsa</option>
          <option value="EMPTY">0 %</option>
          <option value="LOW">Pod 50 %</option>
          <option value="MID">50–99 %</option>
          <option value="FULL">100 %</option>
        </select>
      </div>

      @* 274: S-popust na polno pakiranje. Privzeta S koda izdelka, rabatna skupina (SAOP) in
         posebni S po tipu stranke ali po stranki — isto, kar gre v katalog.csv. *@
      <div class="filter-field">
        <label for="product-scode">S-popust (privzeti)</label>
        <select id="product-scode" class="filter-select" @bind="PackagingDraft">
          <option value="">Vsi</option>
          <option value="ANY">Ima S kodo</option>
          <option value="NONE">Brez S kode</option>
          @foreach (var sCode in PackagingCodes) { <option value="@sCode.Code">@sCode.Code (@sCode.Percent.ToString("0.##") %)</option> }
        </select>
      </div>

      <div class="filter-field">
        <label for="product-discount-group">Rabatna skupina</label>
        <PimPicker Id="product-discount-group" Options="DiscountGroupOptions" @bind-Value="DiscountGroupDraftOrNull"
                   Placeholder="Vse rabatne skupine" EmptyText="Ni rabatnih skupin." />
      </div>

      <div class="filter-field">
        <label for="product-special-type">Posebni S za tip stranke</label>
        <select id="product-special-type" class="filter-select" @bind="SpecialTypeDraft">
          <option value="">Vsi</option>
          <option value="ANY">Ima katerikoli posebni S</option>
          @foreach (var type in CustomerTypes) { <option value="@("TYPE:" + type.CustomerTypeCode)">@type.Name</option> }
        </select>
      </div>

      <div class="filter-field">
        <label for="product-special-customer">Posebni S za stranko (šifra)</label>
        <input id="product-special-customer" class="filter-select" placeholder="npr. 00001234" @bind="SpecialCustomerDraft" />
      </div>
    </div>

    <div class="filter-actions">
      <button type="button" class="primary-button" @onclick="ApplyFiltersAsync">Uporabi filtre</button>
      <a class="link-button" href="izdelki">Počisti vse</a>
    </div>
  </div>
</section>

@* Izbira stolpcev za izvoz, polje za poljem. Ključ (podjetje, šifra, naziv) ni na seznamu, ker
   gre v datoteko vedno — brez njega uvoz vrstice sploh ne bi znal najti. Uvoz sam se ne spremeni:
   prepozna vsak stolpec, ki je v datoteki, in ostalo pusti pri miru (ProductWorkbookContract.Match),
   zato manjši izvoz pomeni tudi manjši, hitrejši uvoz nazaj — brez posebne poti zanj. Seznam polj
   pride s strežnika (DescribeColumnsAsync), ker je odvisen od konteksta: kategorija določa nabor
   atributov, podjetje jezike. *@
@if (ColumnPickerOpen)
{
  <div class="xml-lightbox" role="dialog" aria-modal="true" aria-label="Izberi stolpce izvoza" @onclick="CloseColumnPicker">
    <div class="xml-lightbox-panel column-picker-panel" @onclick:stopPropagation="true">
      <header>
        <div>
          <strong>Kateri stolpci gredo v datoteko</strong>
          <span>Ključ (podjetje, šifra, naziv) je v izvozu vedno. Izberi samo polja, ki jih res potrebuješ — manjša datoteka pomeni tudi hitrejši uvoz nazaj.</span>
        </div>
        <button type="button" class="small-action" @onclick="CloseColumnPicker">Zapri</button>
      </header>

      @if (!ColumnPickerLoading && ColumnPickerError is null && AvailableColumns.Count > 0)
      {
        <div class="column-picker-toolbar">
          <div class="search-field column-picker-search">
            <span class="search-icon" aria-hidden="true"></span>
            <input type="search" class="search-input" placeholder="Išči polje …" @bind="ColumnSearch" @bind:event="oninput" aria-label="Išči polje izvoza" />
          </div>
          <span class="column-picker-count" role="status" aria-live="polite">@SelectedColumnCount od @TotalColumnCount polj izbranih</span>
          <div class="column-picker-bulk">
            <button type="button" class="link-button" @onclick="SelectAllColumns">Izberi vse</button>
            <button type="button" class="link-button" @onclick="SelectNoColumns">Počisti vse</button>
          </div>
        </div>
      }

      <div class="xml-lightbox-body column-picker-body">
        @if (ColumnPickerLoading)
        {
          <p class="muted column-picker-status"><span class="opening-spinner" aria-hidden="true"></span> Nalagam seznam polj …</p>
        }
        else if (ColumnPickerError is not null)
        {
          <p class="notice">@ColumnPickerError</p>
        }
        else if (FilteredGroups.Count == 0)
        {
          <p class="muted column-picker-status">Nobeno polje ne ustreza iskanju »@ColumnSearch«.</p>
        }
        else
        {
          @foreach (var group in FilteredGroups)
          {
            <section class="column-picker-group">
              <header class="column-picker-group-header">
                <span class="column-picker-group-title">@group.Group</span>
                <span class="column-picker-group-count">@GroupSelectedCount(group.Group)/@GroupTotalCount(group.Group)</span>
                <span class="column-picker-group-actions">
                  <button type="button" class="link-button" @onclick="@(() => ToggleGroup(group.Group, true))">vse</button>
                  <button type="button" class="link-button" @onclick="@(() => ToggleGroup(group.Group, false))">nič</button>
                </span>
              </header>
              <div class="column-picker-fields">
                @foreach (var column in group.Columns)
                {
                  <label class="column-picker-row">
                    <input type="checkbox" checked="@IsIncluded(column.FieldKey)"
                           @onchange="@(args => ToggleColumn(column.FieldKey, (bool)(args.Value ?? false)))" />
                    <span>@column.Header</span>
                  </label>
                }
              </div>
            </section>
          }
        }
      </div>
      <footer>
        <span class="muted column-picker-footnote">Izbira velja za naslednji izvoz.</span>
        <button type="button" class="primary-button" @onclick="CloseColumnPicker">Uporabi</button>
      </footer>
    </div>
  </div>
}

@if (ActiveChips.Count > 0)
{
  <section class="ui-card active-filters" aria-label="Aktivni filtri">
    @foreach (var chip in ActiveChips)
    {
      <a class="filter-chip" href="@chip.RemoveHref" aria-label="Odstrani filter @chip.Label">@chip.Label<span class="chip-remove" aria-hidden="true"></span></a>
    }
    <a class="filter-chip clear-all" href="izdelki">Počisti vse</a>
  </section>
}

@* Napredek izvoza in prenos nista več tu, ampak v oknu izvozov v kotu vsake strani (MainLayout
   #pim-export-tray): uporabnik 2026-09-22 je kliknil »Izvozi«, takoj za tem »Uvozi«, in obvestilo
   je izginilo skupaj s to stranjo, izvoz pa je tekel naprej brez sledi. Glej ExportJobService. *@
@* Razvrstitev ni filter — ne zozi nabora, samo obrne vrstni red — zato stoji nad tabelo,
   kjer ucinkuje, in ne v panelu filtrov. Deluje takoj ob izbiri, brez gumba Uporabi. *@
@* 274: S-popust za izbrane izdelke ali za cel pogled. Privzeti S velja za vse stranke s kljukico
   »Popust polno pakiranje«; posebni S za tip stranke ali stranko ga zanjo zamenja (katalog.csv). *@
@if (CanEditDiscounts && BulkOpen)
{
  <section class="ui-card bulk-discount" aria-labelledby="bulk-discount-title">
    <div class="bulk-discount-head">
      <h2 id="bulk-discount-title">S-popust na polno pakiranje</h2>
      <button type="button" class="small-action" @onclick="() => BulkOpen = false">Zapri</button>
    </div>
    <div class="filter-grid">
      <div class="filter-field">
        <label for="bulk-kind">Kaj nastavim</label>
        <select id="bulk-kind" class="filter-select" @bind="BulkKind">
          <option value="DEFAULT">Privzeti S izdelka (za vse stranke)</option>
          <option value="TYPE">Posebni S za tip stranke</option>
          <option value="CUSTOMER">Posebni S za stranko</option>
        </select>
      </div>
      @if (BulkKind == "TYPE")
      {
        <div class="filter-field">
          <label for="bulk-type">Tip stranke</label>
          <select id="bulk-type" class="filter-select" @bind="BulkType">
            @foreach (var type in CustomerTypes) { <option value="@type.CustomerTypeCode">@type.Name</option> }
          </select>
        </div>
      }
      else if (BulkKind == "CUSTOMER")
      {
        <div class="filter-field">
          <label for="bulk-customer">Šifra stranke</label>
          <input id="bulk-customer" class="filter-select" placeholder="npr. 00001234" @bind="BulkCustomer" />
        </div>
      }
      <div class="filter-field">
        <label for="bulk-code">S koda</label>
        <select id="bulk-code" class="filter-select" @bind="BulkCode">
          <option value="">@(BulkKind == "DEFAULT" ? "Brez S (odstrani)" : "Odstrani posebni S")</option>
          @foreach (var sCode in PackagingCodes) { <option value="@sCode.Code">@sCode.Code (@sCode.Percent.ToString("0.##") %)</option> }
        </select>
      </div>
    </div>
    <div class="filter-actions">
      <button type="button" class="primary-button" disabled="@(BulkBusy || Selected.Count == 0)" @onclick="() => ApplyBulkAsync(false)">
        Uporabi za izbrane (@Selected.Count.ToString("N0"))
      </button>
      <button type="button" class="ghost-button" disabled="@(BulkBusy || Page is null || Page.TotalCount == 0)" @onclick="() => ApplyBulkAsync(true)">
        Uporabi za cel pogled (@((Page?.TotalCount ?? 0).ToString("N0")))
      </button>
      @if (BulkBusy) { <span class="opening-spinner" aria-hidden="true"></span> }
    </div>
    <p class="muted">Pravilo za celo rabatno skupino, S kodo ali vse artikle naenkrat nastaviš na strani <a href="pravila-popustov?podrocje=spopusti">Komercialna pravila → S-popusti</a>; tu se S zapiše vsakemu izdelku posebej.</p>
    @if (BulkMessage is not null) { <p class="message-state success-message" role="status">@BulkMessage</p> }
    @foreach (var problem in BulkProblems.Take(20)) { <p class="message-state warn-message">@problem</p> }
    @if (BulkProblems.Count > 20) { <p class="hint">… in še @(BulkProblems.Count - 20) opozoril.</p> }
  </section>
}

<div class="table-toolbar">
  @if (CanEditDiscounts)
  {
    <button type="button" class="ghost-button" @onclick="() => BulkOpen = !BulkOpen">S-popust …</button>
  }
  <label for="product-sort">Razvrstitev</label>
  <select id="product-sort" class="filter-select" @bind="SortDraft" @bind:after="ApplySortAsync">
    <option value="ITEM">Šifra naraščajoče</option>
    <option value="ITEM:desc">Šifra padajoče</option>
    <option value="COMPLETENESS:desc">Najbolj popolni</option>
    <option value="COMPLETENESS">Najmanj popolni</option>
    <option value="CHANGED:desc">Nazadnje spremenjeni</option>
    <option value="CHANGED">Najdlje nespremenjeni</option>
    <option value="ORGANIZATION">Po podjetju</option>
  </select>
</div>

<section class="ui-card data-card @(Opening is null ? null : "opening-card")" aria-label="Seznam izdelkov">
  @if (Opening is not null)
  {
    <div class="opening-overlay" role="status" aria-live="assertive"><span class="opening-spinner" aria-hidden="true"></span><span>Odpiram kartico izdelka …</span></div>
  }
  <PimState Loading="Loading" Error="@Error" Empty="@(Page is not null && Page.Rows.Count == 0)"
            EmptyText="Za izbrane filtre ni izdelkov." LoadingText="Nalaganje izdelkov …">
    @if (Page is not null)
    {
      <PimTable Caption="@ScopeCaption" AriaLabel="Tabela izdelkov" Columns="Columns">
        <Rows>
          @foreach (var row in Page.Rows)
          {
            var thumbnail = MediaUrlPolicy.Normalize(row.ThumbnailUrl);
            <tr class="row-link @(Opening == row.ProductId ? "opening" : null)" tabindex="0" @onclick="() => OpenAsync(row)" @onkeydown="args => OpenKeyAsync(args, row)"
                aria-label="Odpri izdelek @row.ItemId" aria-busy="@(Opening == row.ProductId ? "true" : null)">
              @* Klikanje po vrstici ne sme prekljukati izbire, zato ima celica izbire svojo ustavitev. *@
              <td class="select-cell" @onclick:stopPropagation="true">
                <input type="checkbox" aria-label="Izberi izdelek @row.ItemId" checked="@Selected.ContainsKey(SelectionKey(row))" @onchange="e => Toggle(row, e)" />
              </td>
              <td class="thumb-cell">
                <span class="thumb">
                  @if (thumbnail.Href is not null)
                  {
                    <img src="@thumbnail.Href" alt="" loading="lazy" />
                  }
                  else
                  {
                    <span class="thumb-empty" aria-hidden="true"></span>
                  }
                </span>
              </td>
              <td>
                <span class="product-name">@row.Name</span>
                <span class="product-meta"><span class="code-value">@row.ItemId</span>@if (row.Ean is not null) { <span>· EAN @row.Ean</span> }</span>
              </td>
              <td>@row.OrganizationName</td>
              <td>@row.ManufacturerLabel</td>
              <td>@row.SupplierLabel</td>
              <td><PimChip Text="@StatusLabel(row.ErpStatus)" Tone="@Tone(row.ErpStatus)" Prefix="Stanje ERP: " /></td>
              <td><PimChip Text="@StatusLabel(row.WebStatus)" Tone="@Tone(row.WebStatus)" Prefix="Stanje splet: " /></td>
              <td><PimBar Percent="row.Completeness" Label="@($"Popolnost izdelka {row.ItemId}")" /></td>
              <td class="numeric">@row.OpenIssueCount.ToString("N0")</td>
              <td class="row-flags">
                @if (row.MediaCount == 0) { <span class="gap-flag">brez slike</span> }
                @if (!row.HasWebTitle) { <span class="gap-flag">brez naziva</span> }
                @if (row.CategoryCount == 0) { <span class="gap-flag">brez kategorije</span> }
                @if (row.PendingOutboundCount > 0) { <span class="wait-flag">čaka SAOP (@row.PendingOutboundCount)</span> }
                @if (row.IsPromoted) { <span class="ok-flag">objavljen</span> }
              </td>
              <td>@(row.LastChangedUtc?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
            </tr>
          }
        </Rows>
      </PimTable>
      <PimPager Skip="Skip" Take="Take" Total="Page.TotalCount" Label="Strani izdelkov" SkipChanged="GoToSkipAsync" />
    }
  </PimState>
</section>

