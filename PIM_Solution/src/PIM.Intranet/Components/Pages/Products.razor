  async Task ApplyBulkAsync(bool wholeView)
  {
    BulkBusy = true; BulkMessage = null; BulkError = null; BulkProblems = [];
    try
    {
      var actor = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";
      BulkMessage = "Zbiram izdelke …";
      StateHasChanged();
      var targets = await CollectTargetsAsync(wholeView, CancellationToken.None);
      BulkMessage = $"Zapisujem {targets.Count:N0} izdelkov …";
      StateHasChanged();

      var code = BulkCode.Length == 0 ? null : BulkCode;
      var customerKey = BulkKind == "CUSTOMER" ? BulkCustomer.Trim() : null;
      if (BulkKind == "CUSTOMER" && string.IsNullOrEmpty(customerKey)) { BulkMessage = null; BulkError = "Vpiši šifro stranke."; return; }
      int changed = 0, unchanged = 0;
      var batches = new List<long>();
      foreach (var organization in targets.GroupBy(target => target.OrganizationId))
      {
        if (BulkKind == "DEFAULT")
        {
          var outcome = await Packaging.SaveDefaultsBulkAsync(organization.Key,
            organization.Select(target => (target.ItemId, code)).ToList(), actor, "Seznam izdelkov", "INTRANET");
          changed += outcome.Changed;
          BulkProblems.AddRange(outcome.Skipped.Select(skip => $"{skip.ItemId}: {skip.Reason}"));
          continue;
        }

        // En klic na podjetje: pravila so po podjetju, šifra stranke velja samo v svojem podjetju.
        try
        {
          var result = await Packaging.SaveRulesBulkAsync(organization.Key, BulkKind, BulkKind == "TYPE" ? BulkType : null, customerKey, code,
            organization.Select(target => target.ItemId).ToList(), "Seznam izdelkov", "INTRANET");
          changed += result.Changed;
          unchanged += result.Unchanged;
          if (result.BatchId is { } batchId) batches.Add(batchId);
          var organizationName = organization.First().OrganizationName;
          BulkProblems.AddRange(result.Skipped.Select(skip => $"{organizationName} · {skip.ItemId}: {skip.Reason}"));
        }
        catch (Microsoft.Data.SqlClient.SqlException failure) when (failure.Number is >= 50000)
        {
          // Napaka cilja (npr. stranke ni v tem podjetju) ustavi samo to podjetje, ne celega zapisa.
          BulkProblems.Add($"{organization.First().OrganizationName}: {failure.Message}");
        }
      }
      BulkMessage = BulkKind == "DEFAULT"
        ? $"S-popust zapisan: {changed:N0} sprememb na {targets.Count:N0} izdelkih. V katalog.csv gre ob naslednjem izvozu."
        : $"Posebni S zapisan: spremenjenih {changed:N0}, že enakih {unchanged:N0}, preskočenih {BulkProblems.Count:N0} od {targets.Count:N0} izdelkov."
          + (batches.Count > 0 ? $" Paket {string.Join(", ", batches.Select(id => "#" + id))} lahko razveljaviš spodaj." : "")
          + " Nič ne gre v SAOP; v katalog.csv gre ob naslednjem izvozu.";
      if (BulkKind != "DEFAULT") await LoadBulkBatchesAsync();
    }
    catch (UnauthorizedAccessException failure) { BulkMessage = null; BulkError = "Samo za branje: " + failure.Message; }
    catch (Exception failure) { BulkMessage = null; BulkError = "Zapis ni uspel: " + failure.Message; }
    finally { BulkBusy = false; }
  }

  async Task UndoBulkBatchAsync(PackagingRuleBatch batch)
  {
    BulkBusy = true; BulkMessage = null; BulkError = null; BulkProblems = [];
    try
    {
      var outcome = await Packaging.UndoRulesBatchAsync(batch.OrganizationId, batch.BatchId);
      BulkProblems.AddRange(outcome.Skipped.Select(skip => $"{skip.ItemId}: {skip.Reason}"));
      BulkMessage = $"Paket #{batch.BatchId} razveljavljen: vrnjenih {outcome.Undone:N0} izdelkov na prejšnje stanje"
        + (outcome.Skipped.Count > 0 ? $", {outcome.Skipped.Count:N0} jih je bilo medtem spet spremenjenih in so ostali, kot so." : ".")
        + " V katalog.csv gre ob naslednjem izvozu.";
      await LoadBulkBatchesAsync();
    }
    catch (UnauthorizedAccessException failure) { BulkError = "Samo za branje: " + failure.Message; }
    catch (Microsoft.Data.SqlClient.SqlException failure) when (failure.Number is >= 50000) { BulkError = failure.Message; }
    catch (Exception failure) { BulkError = "Razveljavitev ni uspela: " + failure.Message; }
    finally { BulkBusy = false; }
  }

  /* --- Paketno urejanje polja (#10) -------------------------------------------------------
     Izbrane vrstice ali vse po filtru → polje → vrednost → predogled prej/potem s številom →
     potrditev → zapis skozi uvoz delovnega lista (ProductBulkEdit). Predogled in zapis gresta skozi
     vrata za uvoze (HeavyWorkGate.Imports), da deset hkratnih paketov ne bere kataloga naenkrat. */

  bool EditOpen;
  bool EditColumnsLoading;
  bool EditBusy;
  bool EditWriting;
  string? EditMessage;
  string? EditError;
  IReadOnlyList<ProductWorkbookColumn> EditColumns = [];
  IReadOnlyList<WorkbookWebSite> EditSites = [];
  string? EditFieldKey;
  string EditValue = "";
  string? EditCategoryValue;
  bool EditClear;
  string EditNote = "";
  ProductBulkEdit.ListMode EditMode = ProductBulkEdit.ListMode.Add;
  readonly HashSet<string> EditSiteValues = new(StringComparer.OrdinalIgnoreCase);
  ProductWorkbookPreview? EditPreview;
  ProductBulkEdit.Summary? EditSummary;
  ProductBulkEdit.Result? EditResult;
  int EditSelectedCount;
  CancellationTokenSource? EditCancel;
  bool EditCancelRequested;
  /// <summary>Polje zadnjega zapisa — sporočilo po zapisu pove, ali gre na splet (atribut izven nabora ne gre).</summary>
  ProductWorkbookColumn? EditResultColumn;

  ProductWorkbookColumn? EditColumn => EditColumns.FirstOrDefault(column => column.FieldKey == EditFieldKey);

  string EditScopeLabel => Selection.AllMatching
    ? $"vse, ki ustrezajo filtru ({Selection.Count:N0})"
    : PimFormat.Count(Selection.Count, "izbrani izdelek", "izbrana izdelka", "izbrane izdelke", "izbranih izdelkov");

  List<PimPickerOption> EditFieldOptions =>
    EditColumns.Select(column => new PimPickerOption(column.FieldKey, column.Header, Group: column.Group)).ToList();

  /// <summary>Spletišča po drevesu (kljukica je na drevesu: jezikovni različici delita eno).</summary>
  List<(string Code, string Name)> EditTrees =>
    EditSites.GroupBy(site => site.CategoryTreeCode, StringComparer.OrdinalIgnoreCase)
      .Select(tree => (tree.Key, tree.First().Name)).ToList();

  List<PimPickerOption> EditCategoryOptions(WorkbookWebSite site) =>
    CategoryOptions.Where(node => string.Equals(node.CategoryTreeCode, site.CategoryTreeCode, StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(node.CategoryPath))
      .Select(node => new PimPickerOption(ProductWorkbookService.CategoryPathText(node.CategoryPath!), node.CategoryPath!,
        Level: node.LevelNo - 1, Badge: $"{node.ProductCount:N0} izd."))
      .ToList();

  /// <summary>Vrednost, kot gre v celico zvezka (»-« izprazni, D/N, seznam z »|«).</summary>
  string? EditCellValue
  {
    get
    {
      if (EditColumn is not { } column) return null;
      if (EditClear && !column.IsBool) return ProductWorkbookContract.ClearToken;
      if (column.IsBool) return EditValue is "D" or "N" ? EditValue : "D";
      if (column.FieldKey == ProductWorkbookContract.WebSitesField)
        return ProductWorkbookContract.JoinList(EditTrees.Where(tree => EditSiteValues.Contains(tree.Code)).Select(tree => tree.Code));
      if (ProductBulkEdit.CategorySite(column, EditSites) is not null) return EditCategoryValue;
      var text = EditValue.Trim();
      return text.Length == 0 ? null : text;
    }
  }

  /// <summary>Kar potrditev pokaže kot novo vrednost (spletišča z imeni, ne s kodami).</summary>
  string? EditDisplayValue => EditColumn?.FieldKey == ProductWorkbookContract.WebSitesField && !EditClear
    ? string.Join(", ", EditTrees.Where(tree => EditSiteValues.Contains(tree.Code)).Select(tree => tree.Name))
    : EditCellValue;

  /// <summary>Napaka ob polju — gumb predogleda je onemogočen, dokler ni popravljena.</summary>
  string? EditValidation
  {
    get
    {
      if (EditColumn is not { } column) return null;
      if (EditCellValue is null)
        return column.FieldKey == ProductWorkbookContract.WebSitesField ? "Izberi vsaj eno spletišče ali označi »Izprazni polje«."
          : ProductBulkEdit.CategorySite(column, EditSites) is not null ? "Izberi kategorijo ali označi »Izprazni polje«."
          : "Vpiši vrednost ali označi »Izprazni polje«.";
      if (EditCellValue == ProductWorkbookContract.ClearToken) return null;
      if (EditCellValue.Contains(ProductWorkbookContract.ListSeparator, StringComparison.Ordinal) && !column.IsMultiValue)
        return "Znak »|« loči vrednosti seznama; to polje ima eno vrednost.";
      return null;
    }
  }

