@page "/izdelki"
@attribute [Authorize]
@* Naloga #74: brez predupodabljanja. Prej je predupodobljena stran pokazala zadetke, interaktivni krog pa
   je seznam, fasete in drevo kategorij bral še enkrat; pod obremenjeno bazo je drugi krog padel in
   uporabnik je izgubil že prikazane zadetke (in vtipkano besedilo v še neinteraktivnem iskalnem polju).
   Prenos predupodobljenih podatkov (PersistentComponentState) ni varen: fasete (do 500) in drevo kategorij
   presežejo omejitev sporočila SignalR (32 KB), glej #52. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject ILogger<Products> Log
@using PIM.Operations
@inject IntranetDataService Data
@inject ProductWorkbenchService Workbench
@inject CategoryTreeService Categories
@inject NavigationManager Navigation
@inject ExportJobService ExportJobs
@inject ProductWorkbookService Workbook
@inject IJSRuntime Js
@inject AuthenticationStateProvider Authentication
@inject PackagingDiscountService Packaging
@inject PimWriteGuard Guard
@inject ImportHistoryService History
@inject WebWithdrawalService Withdrawals
@inject HeavyWorkGate Gate

<PageTitle>Izdelki</PageTitle>

<PimPage Title="Izdelki" Subtitle="Delovni seznam kataloga vseh podjetij: kaj je pripravljeno za ERP, kaj za splet in kaj manjka. Privzeto so vsa podjetja; filter zoži na eno." />
<PimTabs Active="seznam" Tabs="ProductTabs.Tabs" Label="Pogledi izdelkov" />

<section class="ui-card toolbar" role="search" aria-labelledby="products-filter-title">
  <h2 id="products-filter-title" class="visually-hidden">Filtriranje izdelkov</h2>

  <div class="toolbar-row">
    <div class="search-field">
      <span class="search-icon" aria-hidden="true"></span>
      <label class="visually-hidden" for="product-search">Išči po artiklu ali EAN</label>
      <input id="product-search" type="search" class="search-input" placeholder="Išči po šifri artikla ali EAN …" @bind="SearchDraft" @bind:event="oninput" @onkeydown="SearchKeyAsync" />
    </div>

    <button type="button" class="ghost-button filter-toggle @(FiltersOpen ? "open" : null)" aria-expanded="@FiltersOpen.ToString().ToLowerInvariant()" aria-controls="products-filter-panel" @onclick="ToggleFilters">
      <span class="funnel" aria-hidden="true"></span>Filtri
      @if (ActiveChips.Count > 0) { <span class="filter-badge">@ActiveChips.Count</span> }
    </button>

    <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>

    @* Dve dejanji in nic vec. Uporabnik 2026-09-08: »zakaj imava petsto gumbov, naredi samo
       izvoz in uvoz«. Sest gumbov v vrsti je bilo sest vprasanj namesto enega odgovora.

       Kar je odslo, ni izginilo. Predloga SAOP je se vedno svoja predloga istega izvoza,
       cakalna lista artiklov je zavihek Artikli v razdelku SAOP, mnozicno urejanje pa je
       povezano s strani kakovosti in s strani uvoza. Tu ostane samo pot, po kateri se dela
       vsak dan: datoteka ven, popravljena datoteka nazaj.

       Obseg izvoza pove izbira v tabeli — ce je kaj izbrano, gredo ven izbrani, sicer cel
       pogled — in gumb to prebere na glas. *@
    <div class="toolbar-actions">
      @* Katere skupine stolpcev gredo v datoteko — uporabnikova zahteva: manj podatkov je manjši
         izvoz IN hitrejši uvoz nazaj (posodobi se samo, kar je v datoteki). Privzeto vse; ključ
         (podjetje, šifra, naziv) gre v datoteko vedno in tu ni izbirljiv. *@
      <button type="button" class="ghost-button" @onclick="OpenColumnPickerAsync"
              title="Izberi, katera polja gredo v izvoz. Manj stolpcev je manjša datoteka in hitrejši uvoz nazaj — uvoz posodobi samo stolpce, ki so v datoteki.">
        Stolpci
        @if (IncludedFieldKeys is not null) { <span class="filter-badge">@SelectedColumnCount/@TotalColumnCount</span> }
      </button>
      <button type="button" class="primary-button" disabled="@(ExportState is ExportRunStatus.Running or ExportRunStatus.Queued)" @onclick="StartExportAsync"
              title="@(ExportState is ExportRunStatus.Running or ExportRunStatus.Queued
                ? "Tvoj izvoz že teče — prenos je odprt v brskalniku, napredek je v oknu spodaj desno, na vsaki strani."
                : "ERP, splet, spletne strani, kategorije in atributi v eni datoteki; uredi jo v Excelu in vrni nazaj. Prenos se v brskalniku odpre takoj, datoteka pride, ko je gotova — vmes lahko greš na drugo stran.")">
        @if (ExportState is ExportRunStatus.Running or ExportRunStatus.Queued) { <span class="opening-spinner" aria-hidden="true"></span> }
        Izvozi Excel @ExportScopeLabel
      </button>
      <a class="ghost-button" href="izdelki/uvoz" title="Urejena datoteka se vrne v PIM: spletni podatki takoj, ERP polja v vrsto za SAOP.">Uvozi Excel</a>
      <a class="ghost-button" href="izdelki/odprodaja" title="Artikli v odprodaji: ročni vnos, uvoz seznama iz Excela, razstavni eksponat.">Odprodaja</a>
    </div>
  </div>

  <div id="products-filter-panel" class="filter-panel" hidden="@(!FiltersOpen)">
    <div class="filter-grid">
      <div class="filter-field">
        <label for="product-organization">Podjetje</label>
        <select id="product-organization" class="filter-select" @bind="OrganizationDraft" @bind:after="OrganizationDraftChanged">
          <option value="">Vsa podjetja</option>
          @foreach (var organization in Organizations)
          {
            <option value="@organization.OrganizationId">@organization.Name</option>
          }
        </select>
      </div>

      @* Napaka nadomesti nekdanjo vrstico zavihkov (Za urediti, Brez slike, …): ista izbira, en
         filter, brez locenega stetja ob vsaki zamenjavi podjetja. Uporabnik 2026-09-17: »a bi
         stran kej hitreje delal ce to odstraniva, sej to lahk vse v filtre dodava«. *@
      <div class="filter-field">
        <label for="product-view">Napaka</label>
        <select id="product-view" class="filter-select" @bind="ViewDraft">
          <option value="">Vse</option>
          <option value="TO_FIX">Za urediti (katerakoli napaka)</option>
          <option value="NO_IMAGE">Brez slike</option>
          <option value="NO_WEB_TITLE">Brez spletnega naziva</option>
          <option value="NO_CATEGORY">Brez kategorije</option>
          <option value="NO_EAN">Brez EAN</option>
          <option value="NOT_PUBLISHED">Neobjavljeni</option>
          <option value="WAITING_SAOP">Čaka SAOP</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-manufacturer">Proizvajalec</label>
        <PimPicker Id="product-manufacturer" Options="ManufacturerOptions" @bind-Value="ManufacturerDraftOrNull"
                   Placeholder="Vsi proizvajalci" EmptyText="Ni proizvajalcev." />
      </div>

      <div class="filter-field">
        <label for="product-supplier">Dobavitelj</label>
        <PimPicker Id="product-supplier" Options="SupplierOptions" @bind-Value="SupplierDraftOrNull"
                   Placeholder="Vsi dobavitelji" EmptyText="Ni dobaviteljev." />
      </div>

      <div class="filter-field">
        <label for="product-group">Skupina artikla</label>
        <PimPicker Id="product-group" Options="GroupOptions" @bind-Value="GroupDraftOrNull"
                   Placeholder="Vse skupine" EmptyText="Ni skupin." />
      </div>

      @* Kategorija je filter in ne pogled: izbrana kategorija zoži seznam IN določi, katere
         atribute nosi delovni list. Ob imenu stojita število izdelkov pod kategorijo in
         velikost njenega nabora, sicer bi uporabnik izbiral naslepo. *@
      <div class="filter-field filter-field-wide">
        <label for="product-category">Kategorija</label>
        <PimPicker Id="product-category" Options="CategoryPickerOptions" @bind-Value="CategoryDraftOrNull"
                   Placeholder="Vse kategorije" EmptyText="Ni kategorij." />
      </div>

      <div class="filter-field">
        <label for="product-image">Slika</label>
        <select id="product-image" class="filter-select" @bind="ImageDraft">
          <option value="">Vsi</option>
          <option value="YES">Ima sliko</option>
          <option value="NO">Brez slike</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-department">ABC klasifikacija</label>
        <PimPicker Id="product-department" Options="DepartmentOptions" @bind-Value="DepartmentDraftOrNull"
                   Placeholder="Vse klasifikacije" EmptyText="Ni klasifikacij." />
      </div>

      <div class="filter-field">
        <label for="product-erp">Pripravljenost za ERP</label>
        <select id="product-erp" class="filter-select" @bind="ErpDraft">
          <option value="">Vsi</option>
          <option value="VALID">Pripravljeni za ERP</option>
          <option value="INVALID">Blokirani za ERP</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-web">Pripravljenost za splet</label>
        <select id="product-web" class="filter-select" @bind="WebDraft">
          <option value="">Vsi</option>
          <option value="VALID">Pripravljeni za splet</option>
          <option value="INVALID">Blokirani za splet</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-activity">Aktivnost artikla</label>
        <select id="product-activity" class="filter-select" @bind="ActivityDraft">
          <option value="">Vsi</option>
          <option value="ACTIVE">Samo aktivni</option>
          <option value="INACTIVE">Samo neaktivni</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-webpublish">Zastavica za splet</label>
        <select id="product-webpublish" class="filter-select" @bind="WebPublishDraft">
          <option value="">Vsi</option>
          <option value="YES">Označeni za splet</option>
          <option value="NO">Neoznačeni za splet</option>
        </select>
      </div>

      <div class="filter-field">
        <label for="product-completeness">Popolnost</label>
        <select id="product-completeness" class="filter-select" @bind="CompletenessDraft">
          <option value="">Vsa</option>
          <option value="EMPTY">0 %</option>
          <option value="LOW">Pod 50 %</option>
          <option value="MID">50–99 %</option>
          <option value="FULL">100 %</option>
        </select>
      </div>

      @* 274: S-popust na polno pakiranje. Privzeta S koda izdelka, rabatna skupina (SAOP) in
         posebni S po tipu stranke ali po stranki — isto, kar gre v katalog.csv. *@
      <div class="filter-field">
        <label for="product-scode">S-popust (privzeti)</label>
        <select id="product-scode" class="filter-select" @bind="PackagingDraft">
          <option value="">Vsi</option>
          <option value="ANY">Ima S kodo</option>
          <option value="NONE">Brez S kode</option>
          @foreach (var sCode in PackagingCodes) { <option value="@sCode.Code">@sCode.Code (@sCode.Percent.ToString("0.##") %)</option> }
        </select>
      </div>

      <div class="filter-field">
        <label for="product-discount-group">Rabatna skupina</label>
        <PimPicker Id="product-discount-group" Options="DiscountGroupOptions" @bind-Value="DiscountGroupDraftOrNull"
                   Placeholder="Vse rabatne skupine" EmptyText="Ni rabatnih skupin." />
      </div>

      <div class="filter-field">
        <label for="product-special-type">Posebni S za tip stranke</label>
        <select id="product-special-type" class="filter-select" @bind="SpecialTypeDraft">
          <option value="">Vsi</option>
          <option value="ANY">Ima katerikoli posebni S</option>
          @foreach (var type in CustomerTypes) { <option value="@("TYPE:" + type.CustomerTypeCode)">@type.Name</option> }
        </select>
      </div>

      <div class="filter-field">
        <label for="product-special-customer">Posebni S za stranko (šifra)</label>
        <input id="product-special-customer" class="filter-select" placeholder="npr. 00001234" @bind="SpecialCustomerDraft" />
      </div>
    </div>

    <div class="filter-actions">
      <button type="button" class="primary-button" @onclick="ApplyFiltersAsync">Uporabi filtre</button>
      <a class="link-button" href="izdelki">Počisti vse</a>
    </div>
  </div>
</section>

@* Izbira stolpcev za izvoz, polje za poljem. Ključ (podjetje, šifra, naziv) ni na seznamu, ker
   gre v datoteko vedno — brez njega uvoz vrstice sploh ne bi znal najti. Uvoz sam se ne spremeni:
   prepozna vsak stolpec, ki je v datoteki, in ostalo pusti pri miru (ProductWorkbookContract.Match),
   zato manjši izvoz pomeni tudi manjši, hitrejši uvoz nazaj — brez posebne poti zanj. Seznam polj
   pride s strežnika (DescribeColumnsAsync), ker je odvisen od konteksta: kategorija določa nabor
   atributov, podjetje jezike. *@
@if (ColumnPickerOpen)
{
  <div class="xml-lightbox" role="dialog" aria-modal="true" aria-label="Izberi stolpce izvoza" @onclick="CloseColumnPicker">
    <div class="xml-lightbox-panel column-picker-panel" @onclick:stopPropagation="true">
      <header>
        <div>
          <strong>Kateri stolpci gredo v datoteko</strong>
          <span>Ključ (podjetje, šifra, naziv) je v izvozu vedno. Izberi samo polja, ki jih res potrebuješ — manjša datoteka pomeni tudi hitrejši uvoz nazaj.</span>
        </div>
        <button type="button" class="small-action" @onclick="CloseColumnPicker">Zapri</button>
      </header>

      @if (!ColumnPickerLoading && ColumnPickerError is null && AvailableColumns.Count > 0)
      {
        <div class="column-picker-toolbar">
          <div class="search-field column-picker-search">
            <span class="search-icon" aria-hidden="true"></span>
            <input type="search" class="search-input" placeholder="Išči polje …" @bind="ColumnSearch" @bind:event="oninput" aria-label="Išči polje izvoza" />
          </div>
          <span class="column-picker-count" role="status" aria-live="polite">@SelectedColumnCount od @TotalColumnCount polj izbranih</span>
          <div class="column-picker-bulk">
            <button type="button" class="link-button" @onclick="SelectAllColumns">Izberi vse</button>
            <button type="button" class="link-button" @onclick="SelectNoColumns">Počisti vse</button>
          </div>
        </div>
      }

      <div class="xml-lightbox-body column-picker-body">
        @if (ColumnPickerLoading)
        {
          <p class="muted column-picker-status"><span class="opening-spinner" aria-hidden="true"></span> Nalagam seznam polj …</p>
        }
        else if (ColumnPickerError is not null)
        {
          <p class="notice">@ColumnPickerError</p>
        }
        else if (FilteredGroups.Count == 0)
        {
          <p class="muted column-picker-status">Nobeno polje ne ustreza iskanju »@ColumnSearch«.</p>
        }
        else
        {
          @foreach (var group in FilteredGroups)
          {
            <section class="column-picker-group">
              <header class="column-picker-group-header">
                <span class="column-picker-group-title">@group.Group</span>
                <span class="column-picker-group-count">@GroupSelectedCount(group.Group)/@GroupTotalCount(group.Group)</span>
                <span class="column-picker-group-actions">
                  <button type="button" class="link-button" @onclick="@(() => ToggleGroup(group.Group, true))">vse</button>
                  <button type="button" class="link-button" @onclick="@(() => ToggleGroup(group.Group, false))">nič</button>
                </span>
              </header>
              <div class="column-picker-fields">
                @foreach (var column in group.Columns)
                {
                  <label class="column-picker-row">
                    <input type="checkbox" checked="@IsIncluded(column.FieldKey)"
                           @onchange="@(args => ToggleColumn(column.FieldKey, (bool)(args.Value ?? false)))" />
                    <span>@column.Header</span>
                  </label>
                }
              </div>
            </section>
          }
        }
      </div>
      <footer>
        <span class="muted column-picker-footnote">Izbira velja za naslednji izvoz.</span>
        <button type="button" class="primary-button" @onclick="CloseColumnPicker">Uporabi</button>
      </footer>
    </div>
  </div>
}

@if (ActiveChips.Count > 0)
{
  <section class="ui-card active-filters" aria-label="Aktivni filtri">
    @foreach (var chip in ActiveChips)
    {
      <a class="filter-chip" href="@chip.RemoveHref" aria-label="Odstrani filter @chip.Label">@chip.Label<span class="chip-remove" aria-hidden="true"></span></a>
    }
    <a class="filter-chip clear-all" href="izdelki">Počisti vse</a>
  </section>
}

@* Napredek izvoza in prenos nista več tu, ampak v oknu izvozov v kotu vsake strani (MainLayout
   #pim-export-tray): uporabnik 2026-09-22 je kliknil »Izvozi«, takoj za tem »Uvozi«, in obvestilo
   je izginilo skupaj s to stranjo, izvoz pa je tekel naprej brez sledi. Glej ExportJobService. *@
@* Razvrstitev ni filter — ne zozi nabora, samo obrne vrstni red — zato stoji nad tabelo,
   kjer ucinkuje, in ne v panelu filtrov. Deluje takoj ob izbiri, brez gumba Uporabi. *@
@* 274: S-popust za izbrane izdelke ali za cel pogled. Privzeti S velja za vse stranke s kljukico
   »Popust polno pakiranje«; posebni S za tip stranke ali stranko ga zanjo zamenja (katalog.csv). *@
@if (CanEditDiscounts && BulkOpen)
{
  <section class="ui-card bulk-discount" aria-labelledby="bulk-discount-title">
    <div class="bulk-discount-head">
      <h2 id="bulk-discount-title">S-popust na polno pakiranje</h2>
      <button type="button" class="small-action" @onclick="() => BulkOpen = false">Zapri</button>
    </div>
    <div class="filter-grid">
      <div class="filter-field">
        <label for="bulk-kind">Kaj nastavim</label>
        <select id="bulk-kind" class="filter-select" @bind="BulkKind">
          <option value="DEFAULT">Privzeti S izdelka (za vse stranke)</option>
          <option value="TYPE">Posebni S za tip stranke</option>
          <option value="CUSTOMER">Posebni S za stranko</option>
        </select>
      </div>
      @if (BulkKind == "TYPE")
      {
        <div class="filter-field">
          <label for="bulk-type">Tip stranke</label>
          <select id="bulk-type" class="filter-select" @bind="BulkType">
            @foreach (var type in CustomerTypes) { <option value="@type.CustomerTypeCode">@type.Name</option> }
          </select>
        </div>
      }
      else if (BulkKind == "CUSTOMER")
      {
        <div class="filter-field">
          <label for="bulk-customer">Šifra stranke</label>
          <input id="bulk-customer" class="filter-select" placeholder="npr. 00001234" @bind="BulkCustomer" />
        </div>
      }
      <div class="filter-field">
        <label for="bulk-code">S koda</label>
        <select id="bulk-code" class="filter-select" @bind="BulkCode">
          <option value="">@(BulkKind == "DEFAULT" ? "Brez S (odstrani)" : "Odstrani posebni S")</option>
          @foreach (var sCode in PackagingCodes) { <option value="@sCode.Code">@sCode.Code (@sCode.Percent.ToString("0.##") %)</option> }
        </select>
      </div>
    </div>
    @if (BulkPendingWhole is { } pendingWhole)
    {
      @* Potrditev pove, koliko in česa (CLAUDE.md §2); zapis šele po drugem kliku. *@
      <p class="message-state warn-message" role="alert">@BulkConfirmText(pendingWhole)</p>
      <div class="filter-actions">
        <button type="button" class="primary-button" disabled="@BulkBusy" @onclick="ConfirmBulkAsync">Potrdi in zapiši</button>
        <button type="button" class="ghost-button" disabled="@BulkBusy" @onclick="() => BulkPendingWhole = null">Prekliči</button>
        @if (BulkBusy) { <span class="opening-spinner" aria-hidden="true"></span> }
      </div>
    }
    else
    {
      <div class="filter-actions">
        <button type="button" class="primary-button" disabled="@(BulkBusy || Selection.IsEmpty)" @onclick="() => AskBulk(false)">
          Uporabi za izbrane (@Selection.Count.ToString("N0"))
        </button>
        <button type="button" class="ghost-button" disabled="@(BulkBusy || Page is null || Page.TotalCount == 0)" @onclick="() => AskBulk(true)">
          Uporabi za cel pogled (@((Page?.TotalCount ?? 0).ToString("N0")))
        </button>
        @if (BulkBusy) { <span class="opening-spinner" aria-hidden="true"></span> }
      </div>
    }
    <p class="muted">Pravilo za celo rabatno skupino, S kodo ali vse artikle naenkrat nastaviš na strani <a href="pravila-popustov?podrocje=spopusti">Komercialna pravila → S-popusti</a>; tu se S zapiše vsakemu izdelku posebej. Posebni S za tip ali stranko se zapiše kot en paket, ki ga lahko razveljaviš spodaj. Nič ne gre v SAOP; v katalog.csv gre ob naslednjem izvozu.</p>
    @if (BulkMessage is not null) { <p class="message-state success-message" role="status">@BulkMessage</p> }
    @if (BulkError is not null) { <p class="message-state error-message" role="alert">@BulkError</p> }
    @foreach (var problem in BulkProblems.Take(20)) { <p class="message-state warn-message">@problem</p> }
    @if (BulkProblems.Count > 20) { <p class="hint">… in še @(BulkProblems.Count - 20) opozoril.</p> }
    @if (BulkBatches.Count > 0)
    {
      <h3 class="bulk-batches-title">Moji zadnji paketi posebnega S</h3>
      <ul class="bulk-batches" aria-label="Zadnji paketi posebnega S">
        @foreach (var batch in BulkBatches)
        {
          <li>
            <span>#@batch.BatchId · @batch.CreatedUtc.ToPimLocal().ToString("d. M. yyyy HH:mm") · @batch.OrganizationName · @batch.TargetLabel · @batch.ActionLabel · @PimFormat.Count(batch.ChangedCount, "izdelek", "izdelka", "izdelki", "izdelkov")</span>
            @if (batch.UndoneUtc is { } undone)
            {
              <span class="muted"> · razveljavljeno @undone.ToPimLocal().ToString("d. M. HH:mm") (@batch.UndoneBy)</span>
            }
            else
            {
              <button type="button" class="small-action" disabled="@BulkBusy" aria-label="@($"Razveljavi paket {batch.BatchId}")"
                      @onclick="() => UndoBulkBatchAsync(batch)">Razveljavi</button>
            }
          </li>
        }
      </ul>
    }
  </section>
}

@* #10: paketno urejanje polja za izbrane izdelke ali za vse po filtru. Pot je »navidezen uvoz Excela«
   (ProductBulkEdit): isto preverjanje, zapis, ponovna validacija, zgodovina in povratek na /uvozi kot pri
   uvozu delovnega lista. Samo podatki PIM — polja SAOP ostanejo uvozu Excela (PRIVZETO ZA NOČ). *@
@if (CanEditCatalog && EditOpen)
{
  <section class="ui-card bulk-edit" aria-labelledby="bulk-edit-title">
    <div class="bulk-discount-head">
      <h2 id="bulk-edit-title">Nastavi polje za @EditScopeLabel</h2>
      <button type="button" class="small-action" disabled="@EditWriting" @onclick="CloseEdit">Zapri</button>
    </div>

    @if (EditColumnsLoading)
    {
      <p class="muted" role="status"><span class="opening-spinner" aria-hidden="true"></span> Nalagam seznam polj …</p>
    }
    else if (EditPreview is null && EditResult is null)
    {
      <div class="filter-grid">
        <div class="filter-field filter-field-wide">
          <label for="bulk-edit-field">Polje</label>
          <PimPicker Id="bulk-edit-field" Options="EditFieldOptions" Value="@EditFieldKey" ValueChanged="EditFieldChanged"
                     Placeholder="Izberi polje (spletni naziv, atribut, kategorija, oznaka …)" EmptyText="Ni polj." Disabled="EditBusy" />
        </div>

        @if (EditColumn is { } column)
        {
          @if (column.IsBool)
          {
            <div class="filter-field">
              <label for="bulk-edit-bool">Vrednost</label>
              <select id="bulk-edit-bool" class="filter-select" @bind="EditValue" disabled="@EditBusy">
                <option value="D">Da</option>
                <option value="N">Ne</option>
              </select>
            </div>
          }
          else if (column.FieldKey == ProductWorkbookContract.WebSitesField)
          {
            <fieldset class="filter-field filter-field-wide bulk-edit-sites" disabled="@(EditBusy || EditClear)">
              <legend>Spletišča</legend>
              @foreach (var tree in EditTrees)
              {
                <label class="bulk-edit-check">
                  <input type="checkbox" aria-label="Spletišče @tree.Name" checked="@EditSiteValues.Contains(tree.Code)"
                         @onchange="e => ToggleEditSite(tree.Code, e.Value is true)" />
                  <span>@tree.Name</span>
                </label>
              }
            </fieldset>
          }
          else if (ProductBulkEdit.CategorySite(column, EditSites) is { } site)
          {
            <div class="filter-field filter-field-wide">
              <label for="bulk-edit-category">Kategorija (@site.Name)</label>
              <PimPicker Id="bulk-edit-category" Options="EditCategoryOptions(site)" @bind-Value="EditCategoryValue"
                         Placeholder="Izberi kategorijo" EmptyText="Drevo te strani nima kategorij." Disabled="@(EditBusy || EditClear)" />
            </div>
          }
          else if (column.FieldKey.Contains("DESCRIPTION", StringComparison.OrdinalIgnoreCase))
          {
            <div class="filter-field filter-field-wide">
              <label for="bulk-edit-text">Vrednost</label>
              <textarea id="bulk-edit-text" class="filter-select bulk-edit-textarea" rows="4" @bind="EditValue" @bind:event="oninput" disabled="@(EditBusy || EditClear)"></textarea>
            </div>
          }
          else
          {
            <div class="filter-field filter-field-wide">
              <label for="bulk-edit-value">Vrednost</label>
              <input id="bulk-edit-value" class="filter-select" @bind="EditValue" @bind:event="oninput" disabled="@(EditBusy || EditClear)" />
            </div>
          }

          @if (column.IsMultiValue)
          {
            <fieldset class="filter-field bulk-edit-mode" disabled="@(EditBusy || EditClear)">
              <legend>Kako</legend>
              <label class="bulk-edit-check"><input type="radio" name="bulk-edit-mode" checked="@(EditMode == ProductBulkEdit.ListMode.Add)" @onchange="() => EditMode = ProductBulkEdit.ListMode.Add" /> <span>Dodaj k obstoječim</span></label>
              <label class="bulk-edit-check"><input type="radio" name="bulk-edit-mode" checked="@(EditMode == ProductBulkEdit.ListMode.Replace)" @onchange="() => EditMode = ProductBulkEdit.ListMode.Replace" /> <span>Zamenjaj ves seznam</span></label>
            </fieldset>
          }
          @if (!column.IsBool)
          {
            <div class="filter-field">
              <span class="bulk-edit-label">Praznjenje</span>
              <label class="bulk-edit-check"><input type="checkbox" checked="@EditClear" disabled="@EditBusy" @onchange="e => EditClear = e.Value is true" /> <span>Izprazni polje</span></label>
            </div>
          }
          <div class="filter-field filter-field-wide">
            <label for="bulk-edit-note">Opomba (v zgodovini uvozov)</label>
            <input id="bulk-edit-note" class="filter-select" @bind="EditNote" disabled="@EditBusy" />
          </div>
        }
      </div>
      @if (EditValidation is { } invalid) { <p class="field-error" role="alert">@invalid</p> }
      <div class="filter-actions">
        <button type="button" class="primary-button" disabled="@(EditBusy || EditColumn is null || EditValidation is not null || Selection.IsEmpty)" @onclick="PreviewEditAsync">
          Pokaži predogled (@Selection.Count.ToString("N0"))
        </button>
        @if (EditBusy)
        {
          <span class="opening-spinner" aria-hidden="true"></span>
          <button type="button" class="small-action" @onclick="CancelEdit">Prekliči</button>
        }
      </div>
      <p class="muted">Nič se ne zapiše, dokler ne potrdiš predogleda. Polja, ki gredo v SAOP (ERP naziv, enota, skupina …), se paketno urejajo z <a href="izdelki/uvoz">uvozom Excela</a>, kjer čakajo odobritev.</p>
    }
    else if (EditPreview is not null && EditSummary is { } summary && EditColumn is { } previewColumn)
    {
      @if (summary.Products == 0)
      {
        <p class="message-state warn-message" role="status">Nobenemu od izbranih izdelkov (@EditSelectedCount.ToString("N0")) se »@previewColumn.Header« ne spremeni — vrednost je že taka ali izdelka ni.</p>
      }
      else
      {
        <p class="bulk-edit-question" role="status">
          Nastaviti <strong>»@previewColumn.Header«</strong> na <strong>»@ProductBulkEdit.Shown(EditDisplayValue, previewColumn.IsBool)«</strong>@(EditMode == ProductBulkEdit.ListMode.Add && previewColumn.IsMultiValue && !EditClear ? " (dodano k obstoječim)" : "")
          za <strong>@PimFormat.Count(summary.Products, "izdelek", "izdelka", "izdelke", "izdelkov")</strong>
          @(summary.ByOrganization.Count == 1 ? $"v podjetju {summary.ByOrganization[0].Organization}" : $"v {summary.ByOrganization.Count} podjetjih")?
        </p>
        <ul class="bulk-edit-orgs">
          @foreach (var organization in summary.ByOrganization) { <li>@organization.Organization: <strong>@organization.Products.ToString("N0")</strong></li> }
          @if (summary.Unchanged > 0) { <li class="muted">Brez spremembe (že tako ali ni izdelka): @summary.Unchanged.ToString("N0")</li> }
        </ul>
        @if (summary.LosingWebSite > 0)
        {
          <p class="message-state warn-message" role="alert">Izdelkov, ki izgubijo kljukico vsaj enega spletišča: @summary.LosingWebSite.ToString("N0") — ob naslednjem izvozu gredo s te spletne strani.</p>
        }
        @if (summary.Products > ProductBulkEdit.LargeBatch)
        {
          <p class="message-state warn-message">Velik paket: zapis gre po @ProductBulkEdit.ChunkSize izdelkov, vsak paket se takoj tudi validira, zato traja nekaj minut. Napredek in preostali čas vidiš sproti; zapis lahko prekličeš med paketi — kar je že zapisano, povrneš na /uvozi.</p>
        }
        <div class="table-scroll">
          <table class="data-table bulk-edit-table">
            <caption>Prej → potem (prvih @Math.Min(summary.Products, ProductBulkEdit.SampleSize) od @summary.Products.ToString("N0"))</caption>
            <thead><tr><th scope="col">Podjetje</th><th scope="col">Šifra</th><th scope="col">Prej</th><th scope="col">Potem</th></tr></thead>
            <tbody>
              @foreach (var sample in summary.Samples)
              {
                <tr>
                  <td>@sample.OrganizationName</td>
                  <td class="code-value">@sample.ItemId</td>
                  <td class="muted">@ProductBulkEdit.Shown(sample.Before, previewColumn.IsBool)</td>
                  <td>@ProductBulkEdit.Shown(sample.After, previewColumn.IsBool)</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
      @foreach (var problem in EditPreview.Problems.Take(10)) { <p class="message-state warn-message">@problem</p> }
      @if (EditPreview.Problems.Count > 10) { <p class="hint">… in še @(EditPreview.Problems.Count - 10) opozoril.</p> }
      <div class="filter-actions">
        @if (summary.Products > 0)
        {
          <button type="button" class="primary-button" disabled="@EditBusy" @onclick="ApplyEditAsync">
            Potrdi in zapiši (@summary.Products.ToString("N0"))
          </button>
        }
        <button type="button" class="ghost-button" disabled="@EditBusy" @onclick="BackToEdit">Nazaj na urejanje</button>
        @if (EditBusy) { <span class="opening-spinner" aria-hidden="true"></span> }
        @if (EditWriting)
        {
          <button type="button" class="small-action" disabled="@EditCancelRequested" @onclick="CancelEdit">@(EditCancelRequested ? "Ustavljam po tem paketu …" : "Prekliči zapis")</button>
        }
      </div>
      <p class="muted">Zapis se najprej zabeleži v <a href="uvozi">zgodovino uvozov</a>, od koder ga lahko v celoti povrneš — tudi če se ustavi na pol. Validacija se ponovi samo za spremenjene izdelke. @ProductBulkEdit.WebNote(previewColumn) Preklic velja med paketi po @ProductBulkEdit.ChunkSize izdelkov.</p>
    }

    @if (EditResult is { } result)
    {
      <p class="message-state @(result.Failure is null ? "success-message" : "warn-message")" role="status">
        @EditResultText(result)
        @if (result.HistoryId is { } historyId) { <text> </text><a href="@($"uvozi/{historyId}")">Odpri zapis #@historyId (tam je »Povrni«)</a> }
      </p>
      @foreach (var problem in (result.Outcome?.Problems ?? []).Take(10)) { <p class="message-state warn-message">@problem</p> }
      <div class="filter-actions">
        <button type="button" class="ghost-button" @onclick="BackToEdit">Nova paketna sprememba</button>
      </div>
    }
    @if (EditMessage is not null && EditBusy) { <p class="muted" role="status" aria-live="polite">@EditMessage</p> }
    @if (EditError is not null) { <p class="message-state error-message" role="alert">@EditError</p> }
  </section>
}

<div class="table-toolbar">
  @* S-popust je v vrstici izbire (PimBulkBar) — preverjanje #10: gumb je bil na strani dvakrat. *@
  <label for="product-sort">Razvrstitev</label>
  <select id="product-sort" class="filter-select" @bind="SortDraft" @bind:after="ApplySortAsync">
    <option value="ITEM">Šifra naraščajoče</option>
    <option value="ITEM:desc">Šifra padajoče</option>
    <option value="COMPLETENESS:desc">Najbolj popolni</option>
    <option value="COMPLETENESS">Najmanj popolni</option>
    <option value="CHANGED:desc">Nazadnje spremenjeni</option>
    <option value="CHANGED">Najdlje nespremenjeni</option>
    <option value="ORGANIZATION">Po podjetju</option>
  </select>
</div>

<PimBulkBar Count="Selection.Count" AllMatching="Selection.AllMatching" MatchingTotal="Selection.MatchingTotal"
            PageSelected="PageFullySelected" PageRowCount="@(Page?.Rows.Count ?? 0)"
            OnPageChanged="SelectPage" OnSelectAllMatching="SelectAllMatching" OnClear="ClearSelection"
            AriaLabel="Izbira izdelkov in paketna dejanja" Hint="Označi izdelke, ki jim želiš paketno nastaviti polje, S-popust ali jih izvoziti.">
  @if (CanEditCatalog)
  {
    <button type="button" class="ghost-button" @onclick="OpenEditAsync">Nastavi polje …</button>
  }
  @if (CanEditDiscounts)
  {
    <button type="button" class="ghost-button" @onclick="OpenBulkAsync">S-popust …</button>
  }
  <button type="button" class="ghost-button" disabled="@(ExportState is ExportRunStatus.Running or ExportRunStatus.Queued)" @onclick="StartExportAsync">Izvozi v Excel</button>
</PimBulkBar>

<section class="ui-card data-card @(Opening is null ? null : "opening-card")" aria-label="Seznam izdelkov">
  @if (Opening is not null)
  {
    <div class="opening-overlay" role="status" aria-live="assertive"><span class="opening-spinner" aria-hidden="true"></span><span>Odpiram kartico izdelka …</span></div>
  }
  @if (FilterWarning is not null)
  {
    <p class="message-state warn-message" role="status">@FilterWarning</p>
  }
  @if (StaleWarning is not null && Page is not null)
  {
    <div class="message-state warn-message retry-note" role="alert">
      <span>@StaleWarning</span>
      <button type="button" class="ghost-button" @onclick="RetryAsync" disabled="@Loading">Ponovi</button>
    </div>
  }
  <PimState Loading="@(Loading && !KeepRowsWhileLoading)" Error="@Error" Empty="@(Page is not null && Page.Rows.Count == 0)"
            EmptyText="Za izbrane filtre ni izdelkov." LoadingText="Nalaganje izdelkov …">
    @if (Page is not null)
    {
      <PimTable Caption="@ScopeCaption" AriaLabel="Tabela izdelkov" Columns="Columns">
        <Rows>
          @foreach (var row in Page.Rows)
          {
            var thumbnail = MediaUrlPolicy.Normalize(row.ThumbnailUrl);
            <tr class="row-link @(Opening == row.ProductId ? "opening" : null)" tabindex="0" @onclick="() => OpenAsync(row)" @onkeydown="args => OpenKeyAsync(args, row)"
                aria-label="Odpri izdelek @row.ItemId" aria-busy="@(Opening == row.ProductId ? "true" : null)">
              @* Klikanje po vrstici ne sme prekljukati izbire, zato ima celica izbire svojo ustavitev. *@
              <td class="select-cell" @onclick:stopPropagation="true">
                <input type="checkbox" aria-label="Izberi izdelek @row.ItemId" checked="@Selection.Contains(SelectionKey(row))" @onchange="e => Toggle(row, e)" />
              </td>
              <td class="thumb-cell">
                <span class="thumb">
                  @if (thumbnail.Href is not null)
                  {
                    <img src="@thumbnail.Href" alt="" loading="lazy" />
                  }
                  else
                  {
                    <span class="thumb-empty" aria-hidden="true"></span>
                  }
                </span>
              </td>
              <td>
                <span class="product-name">@row.Name</span>
                <span class="product-meta"><span class="code-value">@row.ItemId</span>@if (row.Ean is not null) { <span>· EAN @row.Ean</span> }</span>
              </td>
              <td>@row.OrganizationName</td>
              <td>@row.ManufacturerLabel</td>
              <td>@row.SupplierLabel</td>
              <td><PimChip Text="@StatusLabel(row.ErpStatus)" Tone="@Tone(row.ErpStatus)" Prefix="Stanje ERP: " /></td>
              <td><PimChip Text="@StatusLabel(row.WebStatus)" Tone="@Tone(row.WebStatus)" Prefix="Stanje splet: " /></td>
              <td><PimBar Percent="row.Completeness" Label="@($"Popolnost izdelka {row.ItemId}")" /></td>
              <td class="numeric">@row.OpenIssueCount.ToString("N0")</td>
              <td class="row-flags">
                @if (row.MediaCount == 0) { <span class="gap-flag">brez slike</span> }
                @if (!row.HasWebTitle) { <span class="gap-flag">brez naziva</span> }
                @if (row.CategoryCount == 0) { <span class="gap-flag">brez kategorije</span> }
                @if (row.PendingOutboundCount > 0) { <span class="wait-flag">čaka SAOP (@row.PendingOutboundCount)</span> }
                @if (row.IsPromoted) { <span class="ok-flag">objavljen</span> }
              </td>
              <td>@(row.LastChangedUtc?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
            </tr>
          }
        </Rows>
      </PimTable>
      <PimPager Skip="Skip" Take="Take" Total="Page.TotalCount" Label="Strani izdelkov" SkipChanged="GoToSkipAsync" />
    }
  </PimState>
  @if (Error is not null && !Loading)
  {
    <div class="retry-row">
      <button type="button" class="ghost-button" @onclick="RetryAsync">Ponovi</button>
    </div>
  }
</section>

<p class="muted source-note">
  Vir: <span class="code-value">intranet.GetProductList</span> in
  <span class="code-value">intranet.GetProductListFilters</span> (migraciji 101 in 108). Urejanje polja je na kartici izdelka; izvoz pogleda je delovni zvezek Excel.
  Vrednosti spustnih seznamov se ravnajo po izbranem podjetju, ne po preostalih filtrih.
</p>

@code {
  [SupplyParameterFromQuery(Name = "pogled")] public string? QueryView { get; set; }
  [SupplyParameterFromQuery(Name = "isci")] public string? QuerySearch { get; set; }
  [SupplyParameterFromQuery(Name = "podjetje")] public string? QueryOrganization { get; set; }
  [SupplyParameterFromQuery(Name = "proizvajalec")] public string? QueryManufacturer { get; set; }
  [SupplyParameterFromQuery(Name = "dobavitelj")] public string? QuerySupplier { get; set; }
  [SupplyParameterFromQuery(Name = "skupina")] public string? QueryGroup { get; set; }
  [SupplyParameterFromQuery(Name = "oddelek")] public string? QueryDepartment { get; set; }
  [SupplyParameterFromQuery(Name = "erp")] public string? QueryErp { get; set; }
  [SupplyParameterFromQuery(Name = "splet")] public string? QueryWeb { get; set; }
  [SupplyParameterFromQuery(Name = "aktivnost")] public string? QueryActivity { get; set; }
  [SupplyParameterFromQuery(Name = "objava")] public string? QueryWebPublish { get; set; }
  [SupplyParameterFromQuery(Name = "popolnost")] public string? QueryCompleteness { get; set; }
  [SupplyParameterFromQuery(Name = "slika")] public string? QueryImage { get; set; }
  [SupplyParameterFromQuery(Name = "kategorija")] public string? QueryCategory { get; set; }
  [SupplyParameterFromQuery(Name = "spopust")] public string? QueryPackaging { get; set; }
  [SupplyParameterFromQuery(Name = "rabatna")] public string? QueryDiscountGroup { get; set; }
  [SupplyParameterFromQuery(Name = "posebni")] public string? QuerySpecial { get; set; }
  [SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }
  [SupplyParameterFromQuery(Name = "smer")] public string? QueryDirection { get; set; }
  [SupplyParameterFromQuery(Name = "stran")] public int? QueryPage { get; set; }

  // Izbira zivi cez strani in cez filtre: urednik pogosto izbere nekaj na eni strani, spremeni
  // filter in izbere se nekaj. Ce bi se izbira ob vsakem premiku izgubila, bi bilo mnozicno
  // urejanje uporabno samo za eno stran rezultatov. Kljuc nosi podjetje, ker je sifra artikla
  // enolicna samo znotraj podjetja — 0000000000001 obstaja v DEMO in v Vidadrii.
  // #10: skupni model izbire (PimRowSelection) s tremi nacini — nic, posamezne vrstice, vse po
  // filtru. Pri »vse po filtru« izbira ni seznam kljucev, ampak filter: nabor se ob dejanju prebere
  // znova s streznika (CollectTargetsAsync).
  readonly PimRowSelection<SelectedItem> Selection = new();

  ProductListPage? Page;
  IReadOnlyList<ProductListFacet> Facets = [];
  IReadOnlyList<OrganizationContext> Organizations = [];
  bool Loading = true;
  string? Error;
  // Filter, s katerim je bil prebran trenutni Page. Ob ponovnem branju istega filtra (Ponovi,
  // osvežitev po zapisu) ostanejo zadetki vidni; ob drugem filtru ali podjetju se nikoli ne pokažejo
  // zadetki prejšnjega, ker bi uporabnik videl podatke, ki ne ustrezajo izbiri.
  ProductListFilter? PageFilter;
  ProductListFilter? RequestedFilter;
  // Opozorilo, da je prikazan zadnji uspešno prebrani seznam istega filtra, osvežitev pa ni uspela.
  string? StaleWarning;
  // Fasete ali drevo kategorij se niso naložili; seznam je vseeno prikazan.
  string? FilterWarning;
  // Hitro zaporedno filtriranje: rezultat starejšega branja ne sme povoziti novejšega.
  int LoadVersion;
  bool KeepRowsWhileLoading => Page is not null && PageFilter is not null && PageFilter == RequestedFilter;

  // Sentinel za "se nic ni naloženo": prazen niz pomeni vsa podjetja in je veljaven obseg,
  // zato ga ni mogoce uporabiti kot znak, da fasete se niso prebrane.
  string? LoadedScope;
  string SearchDraft = "";
  string OrganizationDraft = "";
  string ViewDraft = "";
  string ManufacturerDraft = "";
  string SupplierDraft = "";
  string GroupDraft = "";
  string DepartmentDraft = "";
  string ErpDraft = "";
  string WebDraft = "";
  string ActivityDraft = "";
  string WebPublishDraft = "";
  string CompletenessDraft = "";
  string ImageDraft = "";
  string CategoryDraft = "";
  string PackagingDraft = "";
  string DiscountGroupDraft = "";
  string SpecialTypeDraft = "";
  string SpecialCustomerDraft = "";
  IReadOnlyList<PackagingCode> PackagingCodes = [];
  IReadOnlyList<CustomerTypeRow> CustomerTypes = [];
  bool CanEditDiscounts;
  bool CanEditCatalog;
  bool BulkOpen;
  bool BulkBusy;
  string BulkKind = "DEFAULT";
  string BulkType = "";
  string BulkCustomer = "";
  string BulkCode = "";
  string? BulkMessage;
  List<string> BulkProblems = [];
  string? BulkError;
  /// <summary>Čaka potrditev: true = cel pogled, false = izbrani; null = ni odprte potrditve.</summary>
  bool? BulkPendingWhole;
  IReadOnlyList<PackagingRuleBatch> BulkBatches = [];
  IReadOnlyList<CategoryTreeService.CategoryPickRow> CategoryOptions = [];
  string SortDraft = "ITEM";

  // PimPicker izbira niclivo vrednost (null = nic izbranega), Draft polja pa prazen niz zaradi
  // Href/ApplyFiltersAsync spodaj; ta polja samo prevajajo med obema pomenoma "nic ni izbrano".
  string? ManufacturerDraftOrNull { get => string.IsNullOrEmpty(ManufacturerDraft) ? null : ManufacturerDraft; set => ManufacturerDraft = value ?? ""; }
  string? SupplierDraftOrNull { get => string.IsNullOrEmpty(SupplierDraft) ? null : SupplierDraft; set => SupplierDraft = value ?? ""; }
  string? GroupDraftOrNull { get => string.IsNullOrEmpty(GroupDraft) ? null : GroupDraft; set => GroupDraft = value ?? ""; }
  string? DepartmentDraftOrNull { get => string.IsNullOrEmpty(DepartmentDraft) ? null : DepartmentDraft; set => DepartmentDraft = value ?? ""; }
  string? CategoryDraftOrNull { get => string.IsNullOrEmpty(CategoryDraft) ? null : CategoryDraft; set => CategoryDraft = value ?? ""; }
  string? DiscountGroupDraftOrNull { get => string.IsNullOrEmpty(DiscountGroupDraft) ? null : DiscountGroupDraft; set => DiscountGroupDraft = value ?? ""; }

  List<PimPickerOption> DiscountGroupOptions =>
    Facets.Where(row => row.FacetKind == "DISCOUNT_GROUP")
      .Select(facet => new PimPickerOption(facet.FacetValue, facet.FacetLabel, Badge: facet.ProductCount.ToString("N0"))).ToList();

  /// <summary>Filter »posebni S« je en parameter: stranka (vpisana šifra) ima prednost pred izbranim tipom.</summary>
  string SpecialDraftValue => SpecialCustomerDraft.Trim().Length > 0 ? "CUSTOMER:" + SpecialCustomerDraft.Trim() : SpecialTypeDraft;

  // Seznami za PimPicker: isce se po imenu, sifra pa je vseeno del iskanega besedila (Key), da
  // najde tudi tisti, ki pozna samo sifro proizvajalca/dobavitelja, ne njegovega imena.
  // Brez izbranega podjetja je partner par (podjetje, sifra) in seznam je razdeljen po podjetjih
  // (250): Nowodvorski je v Vidadrii 0001209, v IQLighting 00001625 — dva vnosa, vsak s svojimi
  // izdelki. Z izbranim podjetjem so vnosi samo tega podjetja, brez naslovov skupin.
  List<PimPickerOption> ManufacturerOptions => PartnerOptions(Facets.Where(row => row.FacetKind == "MANUFACTURER"));

  List<PimPickerOption> SupplierOptions => PartnerOptions(Facets.Where(row => row.FacetKind == "SUPPLIER"));

  static List<PimPickerOption> PartnerOptions(IEnumerable<ProductListFacet> facets) =>
    facets.OrderBy(facet => facet.OrganizationName ?? "", StringComparer.CurrentCulture)
      .Select(facet => new PimPickerOption(facet.FacetValue, PartnerLabel(facet), Badge: facet.ProductCount.ToString("N0"),
        Group: facet.OrganizationName)).ToList();

  // Ime, dolgo do 32 znakov (sicer obrezano z "…"), in nato sifra v oklepaju — ista sifra kot na
  // strani Stranke (canon.PartnerName.PartnerCode). Ce imena ni (FacetLabel pade nazaj na sifro
  // samo), se sifra ne podvoji.
  const int PartnerLabelMaxLength = 32;
  static string PartnerLabel(ProductListFacet facet)
  {
    var code = facet.FacetCode ?? facet.FacetValue;
    var name = facet.FacetLabel.Length > PartnerLabelMaxLength
      ? facet.FacetLabel[..PartnerLabelMaxLength] + "…"
      : facet.FacetLabel;
    return string.Equals(facet.FacetLabel, code, StringComparison.Ordinal)
      ? name
      : $"{name} ({code})";
  }

  // Čip aktivnega filtra pove ime in podjetje, ne samo šifre (»3:0001209« ni za ljudi).
  string PartnerChip(string kind, string value)
  {
    var facet = Facets.FirstOrDefault(row => row.FacetKind == kind && string.Equals(row.FacetValue, value, StringComparison.Ordinal));
    if (facet is null) return value;
    return facet.OrganizationName is { Length: > 0 } organization ? $"{PartnerLabel(facet)} · {organization}" : PartnerLabel(facet);
  }

  List<PimPickerOption> GroupOptions =>
    Facets.Where(row => row.FacetKind == "ITEM_GROUP")
      .Select(facet => new PimPickerOption(facet.FacetValue, facet.FacetLabel, Badge: facet.ProductCount.ToString("N0"))).ToList();

  List<PimPickerOption> DepartmentOptions =>
    Facets.Where(row => row.FacetKind == "DEPARTMENT")
      .Select(facet => new PimPickerOption(facet.FacetValue, facet.FacetLabel, Badge: facet.ProductCount.ToString("N0"))).ToList();

  /// <summary>Pot, izdelki in velikost nabora — troje, po čemer se izbira kategorija za izvoz.</summary>
  List<PimPickerOption> CategoryPickerOptions =>
    CategoryOptions.GroupBy(row => row.CategoryTreeCode).OrderBy(group => group.Key, StringComparer.Ordinal)
      .SelectMany(tree => tree.Select(node => new PimPickerOption(
        $"{node.CategoryTreeCode}:{node.CategoryCode}", node.CategoryPath ?? node.CategoryName,
        Level: node.LevelNo - 1, Badge: $"{node.ProductCount:N0} izd., {node.AttributeCount:N0} atr.",
        Group: TreeLabel(node.CategoryTreeCode)))).ToList();

  // Enajst filtrov v eni vrsti je bilo natrpano in nepregledno. Odprejo se na zahtevo in
  // ostanejo odprti, dokler je kaj izbrano — sicer bi uporabnik izgubil sled, kaj je nastavil.
  bool? FiltersOpenOverride;

  const int Take = 50;

  int Skip => Math.Max(0, ((QueryPage ?? 1) - 1) * Take);
  string ActiveView => string.IsNullOrWhiteSpace(QueryView) ? "ALL" : QueryView.Trim().ToUpperInvariant();

  // Neveljavna stevilka v naslovu ne sme tiho pomeniti vseh podjetij; bralna procedura
  // neznano podjetje vrne kot prazen nabor, kar je iskrenejse od tihe razsiritve obsega.
  int? OrganizationScope => int.TryParse(QueryOrganization, out var value) ? value : null;

  /// <summary>
  /// U1, pregled 2026-09-08: napis tabele je pisal »Izdelki v aktivni organizaciji«, stran pa je
  /// privzeto kazala vsa podjetja. Napis odslej pove dejanski obseg, ne domnevnega.
  /// </summary>
  string ScopeCaption => (OrganizationScope ?? PartnerFilter.Split(QuerySupplier).OrganizationId
      ?? PartnerFilter.Split(QueryManufacturer).OrganizationId) is int scope
    ? "Izdelki podjetja " + (Organizations.FirstOrDefault(row => row.OrganizationId == scope)?.Name ?? scope.ToString())
    : $"Izdelki vseh podjetij ({Organizations.Count})";

  /// <summary>
  /// Izbrana vrstica. Ime podjetja je tu zato, ker izbira sega cez podjetja: delovni list ima
  /// stolpec Podjetje in uvoz iz njega ve, komu vrstica pripada, zato izbire ni treba zozevati
  /// na eno podjetje kot prej pri mnozicnem urejanju.
  /// </summary>
  sealed record SelectedItem(int OrganizationId, string OrganizationName, string ItemId);

  static string SelectionKey(ProductListRow row) => row.OrganizationId + "|" + row.ItemId;

  static readonly IReadOnlyList<PimColumn> Columns =
  [
    new("Izbor"), new("Slika"), new("Izdelek"), new("Podjetje"), new("Proizvajalec"), new("Dobavitelj"),
    new("ERP"), new("Splet"), new("Popolnost"), new("Težave", Numeric: true), new("Vrzeli"), new("Zadnja sprememba"),
  ];

  sealed record FilterChip(string Label, string RemoveHref);

  protected override async Task OnInitializedAsync()
  {
    ExportJobs.Changed += OnExportJobChanged;
    // Izvoz pripada uporabniku, ne tej strani: ce se ta se gradi (uporabnik je vmes odsel na
    // uvoz in se vrnil), gumb ostane zaklenjen, dokler ni gotov, namesto da bi sprozil drugega.
    ExportOwner = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";
    if (ExportJobs.ForOwner(ExportOwner).FirstOrDefault(job => job.IsActive) is { } running)
    {
      ExportJobId = running.JobId;
      ExportState = running.Status;
    }
    try { Organizations = await Data.GetOrganizationsAsync(); }
    catch (Exception failure) { Organizations = []; Log.LogWarning(failure, "Seznam podjetij za /izdelki ni naložen"); }
    try
    {
      PackagingCodes = await Packaging.GetCatalogAsync();
      CustomerTypes = await Data.GetCustomerTypesAsync();
      BulkType = CustomerTypes.FirstOrDefault()?.CustomerTypeCode ?? "";
    }
    catch (Exception failure) { PackagingCodes = []; CustomerTypes = []; Log.LogWarning(failure, "Šifranti embalaže in tipov strank za /izdelki niso naloženi"); }
    var user = (await Authentication.GetAuthenticationStateAsync()).User;
    CanEditDiscounts = user.IsInRole("ADMIN") || user.IsInRole("CATALOG_EDITOR") || user.IsInRole("COMMERCIAL");
    // Paketno urejanje polj: politika CatalogWrite (Admin, CatalogEditor). Skrit gumb je samo videz —
    // pravico preveri tudi ProductBulkEdit.ApplyAsync (PimWriteGuard) in zapisovalne procedure.
    CanEditCatalog = user.IsInRole("ADMIN") || user.IsInRole("CATALOG_EDITOR");
  }

  protected override async Task OnParametersSetAsync()
  {
    SearchDraft = QuerySearch ?? "";
    OrganizationDraft = QueryOrganization ?? "";
    ViewDraft = ActiveView == "ALL" ? "" : ActiveView;
    ManufacturerDraft = QueryManufacturer ?? "";
    SupplierDraft = QuerySupplier ?? "";
    GroupDraft = QueryGroup ?? "";
    DepartmentDraft = QueryDepartment ?? "";
    ErpDraft = QueryErp ?? "";
    WebDraft = QueryWeb ?? "";
    ActivityDraft = QueryActivity ?? "";
    WebPublishDraft = QueryWebPublish ?? "";
    CompletenessDraft = QueryCompleteness ?? "";
    ImageDraft = QueryImage ?? "";
    CategoryDraft = QueryCategory ?? "";
    PackagingDraft = QueryPackaging ?? "";
    DiscountGroupDraft = QueryDiscountGroup ?? "";
    SpecialTypeDraft = QuerySpecial is { } special && !special.StartsWith("CUSTOMER:", StringComparison.OrdinalIgnoreCase) ? special : "";
    SpecialCustomerDraft = QuerySpecial is { } customer && customer.StartsWith("CUSTOMER:", StringComparison.OrdinalIgnoreCase) ? customer["CUSTOMER:".Length..] : "";
    SortDraft = string.IsNullOrWhiteSpace(QuerySort) ? "ITEM"
      : string.Equals(QueryDirection, "desc", StringComparison.OrdinalIgnoreCase) ? QuerySort + ":desc" : QuerySort;

