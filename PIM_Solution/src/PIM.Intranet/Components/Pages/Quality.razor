@page "/kakovost"
@attribute [Authorize]
@rendermode InteractiveServer
@using PIM.Intranet.Services
@inject GovernanceReadService Governance
@inject IntranetDataService Data
@inject CatalogReadService Catalog
@inject QualityReadService QualityRead
@inject CategoryTreeService Tree
@inject NavigationManager Navigation

<PageTitle>Kakovost</PageTitle>

@* Faza toka: KAKOVOST (3). Vir: val.ProductIssue, val.FieldRequirement, val.ValidationProfile.
   Bralna stran.

   Prenova 2026-09-10. Zavihek "Pregled" in kartice "Kje popraviti" so odpadli — uporabnik je
   povedal, da isto ze kaze nadzorna plošca in da so kartice odvec, ko so lahko zavihki. Karantena
   in napake validacije sta zdaj prva dva zavihka, ker se z njima delo dejansko zacne. Isti
   QualityTabs seznam (Components/Shared/PimTab.cs) uporabljajo tudi /kakovost/karantena,
   /kakovost/napake, /kakovost/prevodi in /kakovost/kategorije, da je vrstni red povsod enak. *@
<PimPage Title="Kakovost" Subtitle="@HeadlineText" />

<PimTabs Active="@(ShowProfiles ? "profili" : ShowCategories ? "pokategorijah" : "")" Tabs="QualityTabs.Tabs" Label="Pogledi kakovosti" />

@* Ostane kot kratko besedilo, ne vec kot kartice-gumbi: razlaga je se vedno potrebna (uporabnik
   je 2026-08-28 vprasal, kaj karanteno loci od napake), pot do dela pa je zdaj zavihek zgoraj. *@
<p class="section-lead">
  Napaka in karantena nista isto in ne nastaneta na istem mestu v toku.
  <strong>Karantena je pred PIM-om:</strong> zapis iz vira je prispel, preslikava pa ga ni
  sprejela, zato izdelka iz njega sploh ni. <strong>Napaka validacije je za PIM-om:</strong>
  izdelek obstaja, a mu manjka polje, ki ga zahteva profil, zato ne sme ven.
  Popravek karantene je preslikava ali izvorni podatek; popravek napake je vrednost na kartici izdelka.
</p>

@if (ShowCategories)
{
  @* 177. Uporabnik 2026-09-08: "dodaj filter ... da bo po kategorijah — samo tako, da bo lahko
     vecnivojsko". Vsaka vrstica steje izdelke in odprte zahteve v kategoriji IN v vseh njenih
     podkategorijah; veje se zlagajo. Vir: intranet.GetQualityByCategory, vsa podjetja skupaj. *@
  <section class="ui-card toolbar" role="search" aria-labelledby="category-filter-title">
    <h2 id="category-filter-title" class="visually-hidden">Filtriranje po kategorijah</h2>
    <label class="visually-hidden" for="category-tree">Drevo</label>
    <select id="category-tree" class="filter-select" @bind="CategoryTree" @bind:after="LoadCategoriesAsync">
      @foreach (var tree in Trees) { <option value="@tree">@TreeLabel(tree)</option> }
    </select>
    <label class="visually-hidden" for="category-severity">Resnost</label>
    <select id="category-severity" class="filter-select" @bind="CategorySeverity" @bind:after="LoadCategoriesAsync">
      <option value="">Napake in opozorila</option>
      <option value="ERROR">Samo napake</option>
      <option value="WARNING">Samo opozorila</option>
    </select>
    <label class="filter-check">
      <input type="checkbox" @bind="OnlyCategoriesWithProducts" />
      Samo kategorije z izdelki
    </label>
    <button type="button" class="small-action" @onclick="() => CollapseTo(1)">Samo 1. raven</button>
    <button type="button" class="small-action" @onclick="() => CollapseTo(2)">Do 2. ravni</button>
    <button type="button" class="small-action" @onclick="() => Collapsed.Clear()">Razpri vse</button>
    <span class="result-count" role="status" aria-live="polite">@CategorySummary</span>
  </section>

  <section class="ui-card data-card section-gap" aria-label="Odprte zahteve po kategorijah">
    <PimState Loading="CategoriesLoading" Error="@CategoriesError" Empty="@(VisibleCategories.Count == 0)"
              EmptyText="V tem drevesu ni kategorije z izdelki." LoadingText="Nalaganje kategorij …">
      <PimTable Caption="Izdelki z odprto zahtevo po kategoriji, vključno s podkategorijami" Columns="CategoryColumns">
        <Rows>
          @foreach (var row in VisibleCategories)
          {
            <tr class="@(row.LevelNo == 1 ? "level-1" : null)">
              <td>
                <div class="category-cell" style="@Indent(row.LevelNo)">
                  @if (row.ChildCount > 0)
                  {
                    <button type="button" class="tree-toggle" aria-expanded="@(Collapsed.Contains(row.CategoryPath) ? "false" : "true")"
                            aria-label="@(Collapsed.Contains(row.CategoryPath) ? "Razpri" : "Zloži") @row.CategoryName" @onclick="() => Toggle(row.CategoryPath)">
                      @(Collapsed.Contains(row.CategoryPath) ? "▸" : "▾")
                    </button>
                  }
                  else { <span class="tree-toggle-space" aria-hidden="true"></span> }
                  <span class="category-name">@row.CategoryName</span>
                  @if (row.ChildCount > 0) { <span class="code-value">@row.ChildCount podkategorij</span> }
                </div>
              </td>
              <td class="numeric" title="Neposredno / s podkategorijami">@row.ProductCount.ToString("N0") / @row.SubtreeProductCount.ToString("N0")</td>
              <td>
                <div class="gap-share">
                  <span class="gap-count">@row.ProductsWithIssue.ToString("N0")</span>
                  <span class="gap-track" role="progressbar" aria-valuenow="@IssueShare(row)" aria-valuemin="0" aria-valuemax="100"
                        aria-label="@($"Delež izdelkov z odprto zahtevo v {row.CategoryName}")">
                    <i style="width:@Width(IssueShare(row))" aria-hidden="true"></i>
                  </span>
                  <span class="gap-percent">@IssueShare(row).ToString("0.#") %</span>
                </div>
              </td>
              <td class="numeric">@row.ErrorCount.ToString("N0")<div class="tree-path">@row.ProductsWithError.ToString("N0") izdelkov</div></td>
              <td class="numeric">@row.WarningCount.ToString("N0")</td>
              <td class="top-fields">
                @if (string.IsNullOrWhiteSpace(row.TopFields)) { <span class="muted">—</span> }
                else
                {
                  @foreach (var field in row.TopFields.Split("; ", StringSplitOptions.RemoveEmptyEntries))
                  {
                    <span class="top-field">@QualityFieldPolicy.FieldName(FieldOf(field)) <span class="code-value">@CountOf(field)</span></span>
                  }
                }
              </td>
              <td class="table-actions">
                <a href="@CategoryIssuesHref(row)">Odpri napake →</a>
              </td>
            </tr>
          }
        </Rows>
      </PimTable>
      <div class="card-note">
        Številke veljajo za kategorijo <strong>in vse njene podkategorije</strong>; izdelek, ki je v podkategoriji, se šteje tudi pri vsakem nadrejenem.
        Nabor atributov kategorije (kaj se spremlja) se ureja na <a href="nastavitve/nabori-atributov">/nastavitve/nabori-atributov</a>.
      </div>
    </PimState>
  </section>
}
else if (ShowProfiles)
{
  <PimState Loading="Loading" Error="@Error" Empty="@(Profiles.Count == 0)" EmptyText="Validacijskih profilov ni." LoadingText="Nalaganje kakovosti …">
    <section class="ui-card data-card" aria-labelledby="profiles-title">
      <h2 id="profiles-title" class="card-caption">Vseh @Profiles.Count profilov v eni tabeli — nivo je stolpec, ne ločen razdelek</h2>
      <PimTable Caption="Validacijski profili in njihove zahteve" Columns="ProfileColumns">
        <Rows>
          @foreach (var profile in OrderedProfiles)
          {
            var layers = ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).ToArray();
            <tr class="@(layers.Length == 0 ? "orphan-row" : null)">
              <td>
                <a href="@($"pravila/validacija?profil={Uri.EscapeDataString(profile.ProfileCode)}")">@profile.ProfileCode</a>
                <div class="tree-path">@profile.Name</div>
              </td>
              <td>
                @if (layers.Length == 0) { <span class="muted">brez nivoja</span> }
                else { @string.Join(" · ", layers.Select(ValidationLayer.Label)) }
              </td>
              <td>
                @(profile.Scope ?? "—")
                @if (ValidationLayer.IsShared(profile.Scope)) { <PimChip Text="Skupna" Tone="info" /> }
                @if (!profile.IsActive) { <PimChip Text="Neaktivna" Tone="neutral" /> }
              </td>
              <td class="numeric">@profile.RequirementCount.ToString("N0")</td>
              <td class="numeric">@profile.InvalidCount.ToString("N0")</td>
              <td><PimBar Percent="@Share(profile)" Label="@($"Delež veljavnih v profilu {profile.ProfileCode}")" /></td>
              <td>@Blocks(profile)</td>
            </tr>
          }
        </Rows>
      </PimTable>
      @if (OrphanProfiles.Count > 0)
      {
        <div class="card-note">
          Označene vrstice so profili, ki jih noben nivo ne prevzame:
          @string.Join(", ", OrphanProfiles.Select(profile => profile.ProfileCode)) —
          skupaj @OrphanProfiles.Sum(profile => profile.InvalidCount).ToString("N0") neveljavnih izdelkov,
          ki ne blokirajo ne ERP ne spleta. Dokler sta v registru, štejeta v šum, ne v odločitev.
        </div>
      }
    </section>
  </PimState>
}

@code {
  [SupplyParameterFromQuery(Name = "pogled")] public string? QueryView { get; set; }

  IReadOnlyList<ValidationProfileRow> Profiles = [];
  IReadOnlyList<OrganizationContext> Organizations = [];
  QualityTotals? Totals;
  bool ShowProfiles;

  // 177: pogled po kategorijah.
  bool ShowCategories;
  bool CategoriesLoading;
  string? CategoriesError;
  IReadOnlyList<string> Trees = [];
  string CategoryTree = "";
  string CategorySeverity = "";
  bool OnlyCategoriesWithProducts = true;
  IReadOnlyList<QualityCategoryRow> CategoryRows = [];
  readonly HashSet<string> Collapsed = new(StringComparer.Ordinal);

  static readonly IReadOnlyList<PimColumn> CategoryColumns =
    [new("Kategorija"), new("Izdelkov", Numeric: true), new("Z odprto zahtevo"), new("Napak", Numeric: true), new("Opozoril", Numeric: true), new("Najpogosteje manjka"), new("")];

  /// <param name="ProductsWithIssue">Aktivni izdelki z vsaj eno odprto zahtevo, vsa podjetja.</param>
  /// <param name="ActiveProducts">Vsi aktivni izdelki, vsa podjetja — imenovalec deležev.</param>
  sealed record QualityTotals(long ProductsWithIssue, long ActiveProducts);
  bool Loading = true;
  string? Error;

  static readonly IReadOnlyList<PimColumn> ProfileColumns =
  [
    new("Profil"), new("Nivo"), new("Obseg"), new("Zahtev", Numeric: true),
    new("Neveljavnih", Numeric: true), new("Delež veljavnih"), new("Vpliv")
  ];

  /// <summary>
  /// Uporabnik 2026-08-28: »Potem kaze kakovost samo DEMO artiklov, sploh ne vseh.«
  /// Stran je racunala iz GetCurrentOrganizationAsync, ta pa vrne vedno prvo podjetje po
  /// sifri. Kakovost je vprasanje celotnega kataloga, zato se stevila sestejejo cez vsa
  /// aktivna podjetja. Profili so skupni register in se ne sestevajo — preberejo se enkrat,
  /// stevila v njih pa se sestejejo po sifri profila.
  /// </summary>
  protected override async Task OnInitializedAsync()
  {
    // "Pregled" (privzeti pogled brez ?pogled=) je odpadel — kar je kazal, kaze nadzorna
    // plošca. Bare /kakovost zdaj vodi naravnost na prvi zavihek dela: karanteno.
    if (!IsKnownView(QueryView)) { Navigation.NavigateTo("kakovost/artikli"); return; }

    try
    {
      Organizations = await Data.GetOrganizationsAsync();
      if (Organizations.Count == 0) { Error = "Nobeno podjetje ni aktivno."; return; }
      Trees = await Tree.GetTreeCodesAsync();
      CategoryTree = Trees.FirstOrDefault(tree => tree == "svetila_si") ?? Trees.FirstOrDefault() ?? "";

      /* P2-11: branja tecejo vzporedno po podjetjih, ker so med seboj neodvisna. Vsak klic si
         odpre svojo povezavo (PimDb), zato skupnega stanja ni; stanje strani se spremeni sele,
         ko so vsi odgovori tu. */
      var perOrganization = await Task.WhenAll(Organizations.Select(async organization =>
      {
        var profiles = await Governance.GetValidationProfilesAsync(organization.OrganizationId);
        UnblockPlan? plan = null;
        try { plan = await Governance.GetUnblockPlanAsync(organization.OrganizationId); } catch { }
        return (Profiles: profiles, Plan: plan);
      }));

      var plans = perOrganization.Where(row => row.Plan is not null).Select(row => row.Plan!).ToList();

      Profiles = MergeProfiles(perOrganization.Select(row => row.Profiles).ToList());
      Totals = plans.Count == 0 ? null : new(
        plans.Sum(plan => plan.ProductsWithIssue),
        plans.Sum(plan => plan.ActiveProducts));
    }
    catch { Error = "Kakovosti trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  static bool IsKnownView(string? view) =>
    string.Equals(view, "profili", StringComparison.OrdinalIgnoreCase)
    || string.Equals(view, "kategorije", StringComparison.OrdinalIgnoreCase);

  /// <summary>Profil je skupen register; stevila v njem se sestejejo po sifri profila.</summary>
  static IReadOnlyList<ValidationProfileRow> MergeProfiles(IReadOnlyList<IReadOnlyList<ValidationProfileRow>> groups) =>
    groups.SelectMany(group => group)
      .GroupBy(profile => profile.ProfileCode, StringComparer.Ordinal)
      .Select(group => group.First() with
      {
        RequirementCount = group.Max(profile => profile.RequirementCount),
        ValidCount = group.Sum(profile => profile.ValidCount),
        InvalidCount = group.Sum(profile => profile.InvalidCount),
      })
      .ToArray();

  // Zavihek se bere iz naslova, zato se prebere ob vsaki navigaciji in ne samo ob prvem izrisu.
  protected override async Task OnParametersSetAsync()
  {
    if (!IsKnownView(QueryView)) { Navigation.NavigateTo("kakovost/artikli"); return; }

    ShowProfiles = string.Equals(QueryView, "profili", StringComparison.OrdinalIgnoreCase);
    ShowCategories = string.Equals(QueryView, "kategorije", StringComparison.OrdinalIgnoreCase);
    if (ShowCategories && CategoryRows.Count == 0 && !CategoriesLoading && !string.IsNullOrWhiteSpace(CategoryTree))
      await LoadCategoriesAsync();
  }

  async Task LoadCategoriesAsync()
  {
    if (string.IsNullOrWhiteSpace(CategoryTree)) return;
    CategoriesLoading = true;
    CategoriesError = null;
    try
    {
      // Vsa podjetja skupaj, enako kot ostali pogledi te strani (uporabnik 2026-08-28).
      CategoryRows = await QualityRead.GetByCategoryAsync(CategoryTree, null, CategorySeverity);
      if (Collapsed.Count == 0) CollapseTo(2);
    }
    catch (Exception exception) { CategoriesError = exception.Message; CategoryRows = []; }
    finally { CategoriesLoading = false; }
  }

  /// <summary>Vidne so vrstice, ki niso pod zlozeno vejo; filter izdelkov skrije prazne veje.</summary>
  IReadOnlyList<QualityCategoryRow> VisibleCategories => CategoryRows
    .Where(row => !OnlyCategoriesWithProducts || row.SubtreeProductCount > 0)
    .Where(row => !Collapsed.Any(path => row.CategoryPath.StartsWith(path + " > ", StringComparison.Ordinal)))
    .ToList();

  string CategorySummary => CategoriesLoading ? "Nalaganje …"
    : CategoriesError is not null ? "Rezultati niso na voljo"
    : $"{CategoryRows.Count(row => row.SubtreeProductCount > 0):N0} kategorij z izdelki · {CategoryRows.Where(row => row.LevelNo == 1).Sum(row => row.ProductsWithIssue):N0} izdelkov z odprto zahtevo";

  void Toggle(string path) { if (!Collapsed.Remove(path)) Collapsed.Add(path); }

  /// <summary>Zlozi vse veje, globlje od dane ravni; raven 1 pokaze samo korene.</summary>
  void CollapseTo(int level)
  {
    Collapsed.Clear();
    foreach (var row in CategoryRows.Where(row => row.ChildCount > 0 && row.LevelNo >= level)) Collapsed.Add(row.CategoryPath);
  }

  static string Indent(int level) => $"padding-left:{(level - 1) * 20}px";

  static string TreeLabel(string treeCode) => treeCode switch { "svetila_si" => "Svetila", "videlektro" => "Videlektro", _ => treeCode };

  static decimal IssueShare(QualityCategoryRow row) =>
    row.SubtreeProductCount == 0 ? 0 : Math.Round(100m * row.ProductsWithIssue / row.SubtreeProductCount, 1);

  static string FieldOf(string entry) => entry.LastIndexOf(" (", StringComparison.Ordinal) is var index and > 0 ? entry[..index] : entry;
  static string CountOf(string entry) => entry.LastIndexOf(" (", StringComparison.Ordinal) is var index and > 0 ? entry[(index + 1)..] : "";

  string CategoryIssuesHref(QualityCategoryRow row)
  {
    var href = $"kakovost/napake?drevo={Uri.EscapeDataString(row.CategoryTreeCode)}&kategorija={Uri.EscapeDataString(row.CategoryCode)}";
    return string.IsNullOrWhiteSpace(CategorySeverity) ? href : href + "&resnost=" + CategorySeverity;
  }

  string HeadlineText => Totals is null || Totals.ActiveProducts == 0
    ? "Validacija je razdeljena na štiri poslovne nivoje in več delovnih zavihkov spodaj."
    : $"{Totals.ProductsWithIssue:N0} od {Totals.ActiveProducts:N0} aktivnih izdelkov ima vsaj eno odprto zahtevo.";

  IReadOnlyList<ValidationProfileRow> OrderedProfiles => Profiles
    .OrderByDescending(profile => ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).Count > 0)
    .ThenBy(profile => profile.ProfileCode).ToArray();

  IReadOnlyList<ValidationProfileRow> OrphanProfiles => Profiles
    .Where(profile => ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).Count == 0)
    .ToArray();

  static string Width(decimal percent) =>
    Math.Clamp(percent, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

  static decimal Share(ValidationProfileRow profile)
  {
    var total = profile.ValidCount + profile.InvalidCount;
    return total == 0 ? 0 : 100m * profile.ValidCount / total;
  }

  static string Blocks(ValidationProfileRow profile) => (profile.BlocksErp, profile.BlocksWeb) switch
  {
    (true, true) => "ERP in splet",
    (true, false) => "ERP",
    (false, true) => "Splet",
    _ => "Ne blokira",
  };
}
