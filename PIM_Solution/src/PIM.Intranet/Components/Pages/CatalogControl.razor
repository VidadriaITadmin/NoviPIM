@page "/splet/katalog"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR")]
@rendermode InteractiveServer
@inject CatalogControlService Control
@inject IntranetDataService Data
@inject NavigationManager Navigation

<PageTitle>Nadzor kataloga</PageTitle>
<PimPage Title="Nadzor kataloga" Subtitle="@($"Katalog podjetja {OrganizationName}, skupna lastna zaloga IQ + VID in ločena zaloga dobaviteljev.")" />
<PimTabs Active="catalog" Tabs="WebTabs.Tabs" Label="Izhod na splet" />
<p>Artikel izbereš s kljukicama spletnih mest na <a href="izdelki">kartici artikla</a>.
    Za izvoz mora biti aktiven, imeti kategorijo in opravljeno spletno validacijo.
    Izključitev spodaj vedno prepreči izvoz. <a href="splet">Preveri izdelani katalog.csv</a>.</p>
<p>Pri oznakah X in O velja vneseni popust samo ob sveži pozitivni lastni zalogi.
    Ko lastna zaloga poide, gre v CSV popust 0; dobaviteljeva zaloga ostane ločena.
    Artikel O po porabi zaloge čaka na uredniški pregled.</p>
@* #88: obrazec, da Enter v polju sproži iskanje; iskanje in »Samo čakalna vrsta O« sta v naslovu. *@
<form class="ui-card toolbar section-gap" @onsubmit="SubmitAsync" role="search" aria-label="Iskanje artiklov v nadzoru kataloga">
    <label>Šifra ali EAN <input @bind="Search" name="iskanje" /></label>
    <label><input type="checkbox" @bind="ReviewOnly" @bind:after="SubmitAsync" aria-label="Samo čakalna vrsta O" /> Samo čakalna vrsta O</label>
    <button type="submit" class="primary-button" disabled="@Busy">Prikaži</button>
    <button type="button" class="ghost-button" disabled="@Busy" @onclick="RefreshAsync">Osveži čakalno vrsto</button>
</form>
@if (Message is not null) { <p role="status">@Message</p> }
@if (Error is not null && Loaded) { <p role="alert">@Error</p> }
<section class="ui-card section-gap">
<PimState Loading="@(Busy && !Loaded)" Error="@(Loaded ? null : Error)" Empty="@(Loaded && Rows.Count == 0)" EmptyText="@EmptyText">
<p role="status">@RowsLabel</p>
<table class="data-table">
    <caption>Največ 100 artiklov; iskanje po začetku šifre ali celotnem EAN</caption>
    <thead><tr><th>Artikel</th><th>ABC</th><th>Izbor / aktivnost</th><th>Validacija</th><th>Lastna zaloga</th><th>Dobavitelj</th><th>Rabatna skupina artikla / ERP</th><th>Odprodaja</th><th>Pregled</th></tr></thead>
    <tbody>@foreach (var row in Rows) {
        <tr><td><a href="@($"izdelki/{row.ProductId}")">@row.ItemId</a></td><td>@row.Department</td>
        <td>@(row.Selected ? "Izbran" : "Brez kljukice") / @(row.Active ? "Aktiven" : "Neaktiven") @(row.Excluded ? "/ Izključen" : "")</td>
        <td>@row.ValidationStatus</td><td>@Quantity(row.OwnAvailable)<br /><small>@Stamp(row.OwnSnapshotUtc)</small></td>
        <td>@Quantity(row.SupplierAvailable)<br /><small>@Stamp(row.SupplierSnapshotUtc)</small></td>
        <td>@row.ItemGroup / @row.DiscountGroup</td><td>@row.ClearancePercent % <button disabled="@Busy" @onclick="() => Select(row)">Uredi</button></td>
        <td>@(row.ReviewPending ? "Potreben pregled" : "—")</td></tr>
    }</tbody>
</table>
</PimState>
</section>
@if (Selected is not null) {
    <section class="ui-card section-gap">
        <h2>@Selected.ItemId</h2>
        <label><input type="checkbox" @bind="Excluded" /> Izključen iz kataloga</label>
        <label>Popust odprodaje % <input type="number" min="0" max="100" step="0.01" @bind="Percent" /></label>
        <button disabled="@Busy" @onclick="SaveAsync">Shrani</button>
        @if (Selected.ReviewPending) {
            <p>Najprej na kartici spremeni oznako ali aktivnost oziroma artikel izključi iz kataloga.</p>
            <label>Opravljen pregled <input maxlength="1000" @bind="Resolution" /></label>
            <button disabled="@Busy" @onclick="ResolveAsync">Zaključi pregled</button>
        }
    </section>
}
<section class="ui-card section-gap">
    <h2>Stolpci brez nastavljenega vira (@Unmapped.Count)</h2>
    <p>@string.Join(", ", Unmapped)</p>
    <p>Ti stolpci so prisotni v CSV, vendar ostanejo prazni. Tudi preslikano polje je lahko prazno,
        če izvor nima vrednosti. Polja, obvezna za posamezno kategorijo, določi v pravilih kakovosti.</p>
    <p>»Skupina popusta« je skupina pakirnega popusta. »Rabatna skupina artikla« povezuje artikel
        s skupinskimi rabati v stranke.csv. <a href="pravila-popustov">Uredi pravila popustov</a>.</p>
</section>

@code {
    const int OrganizationId = 2;
    IReadOnlyList<CatalogControlRow> Rows = [];
    IReadOnlyList<string> Unmapped = [];
    CatalogControlRow? Selected;
    string Search = "", Resolution = "";
    string? Error, Message;
    bool ReviewOnly = true, Excluded, Busy, Loaded;
    decimal Percent;
    // Ime podjetja iz dbo.OrganizationConfig (stran je vezana na podjetje 2); brez zapisa pokaže šifro.
    string OrganizationName = "s šifro 2";

    /* #88: ?iskanje=...&vrsta=1|0. Manjkajoča »vrsta« pomeni kot doslej »samo čakalna vrsta O«,
       zato se ob spremembi vedno zapiše izrecno (0 ali 1). Naslov je vir resnice: Nazaj in F5
       obnovita iskanje, povezavo se da deliti. */
    [SupplyParameterFromQuery(Name = "iskanje")] public string? QSearch { get; set; }
    [SupplyParameterFromQuery(Name = "vrsta")] public string? QQueue { get; set; }
    string? LoadedKey;
    static string Key(string search, bool reviewOnly) => $"{search}|{(reviewOnly ? 1 : 0)}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var organization = (await Data.GetOrganizationsAsync()).FirstOrDefault(o => o.OrganizationId == OrganizationId);
            if (organization is not null) OrganizationName = organization.Name;
        }
        catch { /* ime je samo napis; napako branja pokaže nalaganje seznama */ }
    }

    protected override async Task OnParametersSetAsync()
    {
        Search = (QSearch ?? "").Trim();
        ReviewOnly = QQueue != "0";
        if (LoadedKey == Key(Search, ReviewOnly)) return;
        await LoadAsync();
    }

    async Task RunAsync(Func<Task> work) {
        Busy = true; Error = null;
        try { await work(); } catch (Exception e) { Error = e.Message; }
        finally { Busy = false; }
    }
    async Task ReadAsync() {
        Rows = await Control.ReadAsync(OrganizationId, Search, ReviewOnly);
        Unmapped = await Control.UnmappedAsync();
        LoadedKey = Key(Search, ReviewOnly);
        Loaded = true;
    }
    Task LoadAsync() => RunAsync(ReadAsync);

    // Enter v polju, gumb Prikaži in kljukica: nov naslov (vnos v zgodovino brskalnika); isto iskanje še enkrat samo osveži.
    Task SubmitAsync()
    {
        Search = Search.Trim();
        Message = null;
        if (LoadedKey == Key(Search, ReviewOnly)) return LoadAsync();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["iskanje"] = Search == "" ? null : Search,
            ["vrsta"] = ReviewOnly ? "1" : "0",
        }));
        return Task.CompletedTask;
    }

    Task RefreshAsync() => RunAsync(async () => {
        Message = null;
        await Control.RefreshAsync(OrganizationId);
        await ReadAsync();
        var pending = Rows.Count(r => r.ReviewPending);
        Message = ReviewOnly && Search == ""
            ? (Rows.Count >= 100
                ? "Čakalna vrsta je osvežena. Na pregled čaka najmanj 100 artiklov (prikazanih je prvih 100)."
                : pending == 0
                    ? "Čakalna vrsta je osvežena. Noben artikel ne čaka na pregled."
                    : $"Čakalna vrsta je osvežena. Na pregled čaka {PimFormat.Count(pending, "artikel", "artikla", "artikli", "artiklov")}.")
            : $"Čakalna vrsta je osvežena. Med prikazanimi artikli jih na pregled čaka {pending:N0}.";
    });

    string RowsLabel => Rows.Count >= 100
        ? "Prikazanih je prvih 100 artiklov; zoži iskanje s šifro ali EAN."
        : PimFormat.Count(Rows.Count, "artikel", "artikla", "artikli", "artiklov");
    string EmptyText => (Search, ReviewOnly) switch
    {
        ("", true) => "Noben artikel ne čaka na pregled O. Odkljukaj »Samo čakalna vrsta O« za vse artikle ali klikni »Osveži čakalno vrsto«.",
        ("", false) => "Podjetje nima artiklov v katalogu.",
        (_, true) => $"Ni artikla s šifro ali EAN »{Search}« v čakalni vrsti O. Odkljukaj »Samo čakalna vrsta O« ali poskusi drugo šifro.",
        _ => $"Ni artikla s šifro ali EAN »{Search}«. Preveri začetek šifre ali vpiši cel EAN.",
    };
    void Select(CatalogControlRow row) { Selected = row; Excluded = row.Excluded; Percent = row.ClearancePercent; Resolution = ""; Message = null; }
    Task SaveAsync() => RunAsync(async () => {
        if (Selected is null) return;
        await Control.SaveAsync(OrganizationId, Selected.ProductId, Excluded, Percent);
        Message = "Pravilo je shranjeno. Upošteva ga naslednji izvoz.";
        await ReadAsync();
    });
    Task ResolveAsync() => RunAsync(async () => {
        if (Selected is null) return;
        await Control.ResolveAsync(OrganizationId, Selected.ProductId, Resolution);
        Selected = null; Message = "Pregled je zaključen."; await ReadAsync();
    });
    static string Quantity(decimal? value) => value?.ToString("N2") ?? "Ni podatka";
    static string Stamp(DateTime? utc) => utc is null ? "Čas ni znan" : $"{utc.Value.ToPimLocal():g}";
}
