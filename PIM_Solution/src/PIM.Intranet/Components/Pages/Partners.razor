@page "/partnerji"
@attribute [Authorize]
@inject NavigationManager Navigation

@* Ta stran je nastevala dobavitelje in proizvajalce iz polj na izdelku, ker svojega sifranta
   nista imela. Uporabnik jo je 2026-08-28 odpisal: »Partnerji – to stran pomoje ne rabimo, ker
   bomo ze stranke locili po dobavitelj in proizvajalec.« Vrsta stranke zdaj pozna kupca,
   kupca in dobavitelja, dobavitelja in proizvajalca (migracija 129), imena partnerjev pa so
   na seznamu izdelkov in na kartici izdelka ob sifri (migraciji 115 in 128).

   Datoteke ne brisem (AGENTS.md §4.1); stran je preusmeritev, da stari zaznamki ne obvisijo. *@

<PageTitle>Stranke</PageTitle>

@code {
  protected override void OnInitialized() => Navigation.NavigateTo("stranke", replace: true);
}
