@page "/system/integracije"
@attribute [Authorize(Roles = "ADMIN")]
@inject PIM.Intranet.Services.IntranetDataService Data
@inject AuthenticationStateProvider Authentication
@* Pogodbeni izraz: Zadnji srčni utrip. *@
<PageTitle>Integracije sistema</PageTitle>
<div class="page-header"><div><h1>Integracije sistema</h1><p>Zdravje izvajanj, urniki, vodni žigi in operativna opozorila.</p></div><button type="button" class="filter-button" disabled="@(Loading||ActionBusy)" @onclick="Reload">Osveži stanje</button></div>
<nav class="page-tabs" aria-label="Pogledi integracij"><span class="page-tab active" aria-current="page">Stanje in opozorila</span></nav>
@if(Message is not null){<p class="alert alert-success" role="status" aria-live="polite">@Message</p>}
@if(Loading){<div class="ui-card loading-state" role="status">Nalaganje integracij …</div>}
else if(Error is not null){<div class="ui-card error-state" role="alert">@Error</div>}
else if(View is not null){
  <section class="kpi-grid" aria-label="Povzetek stanja integracij">
    <article class="ui-card kpi"><span>Integracije</span><strong>@(View.Integrations.Count.ToString("N0"))</strong></article>
    <article class="ui-card kpi"><span>Omogočene</span><strong>@(View.Integrations.Count(x=>x.IsEnabled).ToString("N0"))</strong></article>
    <article class="ui-card kpi"><span>Odprta opozorila</span><strong>@(View.Alerts.Count(x=>x.ResolvedUtc is null).ToString("N0"))</strong></article>
    <article class="ui-card kpi"><span>Mrtva / odkloni</span><strong>@(View.Integrations.Sum(x=>x.OutboxDeadCount).ToString("N0")) / @(View.Integrations.Sum(x=>x.OutboxDriftCount).ToString("N0"))</strong></article>
  </section>
  <section class="ui-card data-card" aria-label="Seznam integracij">
  @if(View.Integrations.Count==0){<div class="empty-state">Aktivna organizacija nima integracij.</div>}
  else{
    <div class="table-scroll" role="region" tabindex="0" aria-label="Tabela integracij">
      <table class="data-table"><caption>Integracije aktivne organizacije</caption><thead><tr><th scope="col">Ponudnik</th><th scope="col">Postopek</th><th scope="col">Omogočeno</th><th scope="col">Stanje</th><th scope="col">Zadnji utrip</th><th scope="col">Zadnji uspeh</th><th scope="col">Zadnja napaka</th><th scope="col">Vodni žig</th><th scope="col">Naslednje izvajanje</th></tr></thead><tbody>@foreach(var row in View.Integrations){<tr><td>@row.Provider</td><td>@row.Pipeline</td><td><span class="status-chip @(row.IsEnabled?"good":null)"><span class="visually-hidden">Omogočeno: </span>@(row.IsEnabled?"Da":"Ne")</span></td><td><span class="status-chip @Chip(row.Status)"><span class="visually-hidden">Stanje: </span>@(row.Status??"Ni podatka")</span></td><td>@Local(row.LastHeartbeatUtc)</td><td>@Local(row.LastSuccessfulRunUtc)</td><td>@Local(row.LastFailedRunUtc)</td><td>@Local(row.WatermarkUtc)</td><td>@Local(row.NextScheduledUtc)</td></tr>}</tbody></table>
    </div>}
  </section>
  <section class="ui-card data-card" aria-label="Seznam operativnih opozoril">
  @if(View.Alerts.Count==0){<div class="empty-state">Odprtih ali zabeleženih opozoril ni.</div>}
  else{
    <div class="table-scroll" role="region" tabindex="0" aria-label="Tabela operativnih opozoril">
      <table class="data-table"><caption>Operativna opozorila</caption><thead><tr><th scope="col">Resnost</th><th scope="col">Postopek</th><th scope="col">Naslov</th><th scope="col">Redigiran povzetek</th><th scope="col" class="numeric">Pojavitve</th><th scope="col">Zadnja pojavitev</th><th scope="col">Potrdil</th><th scope="col">Razrešil</th><th scope="col">Dejanja</th></tr></thead><tbody>@foreach(var alert in View.Alerts){<tr><td><span class="status-chip @Chip(alert.Severity)"><span class="visually-hidden">Resnost: </span>@alert.Severity</span></td><td>@alert.Pipeline</td><td>@alert.Title</td><td>@alert.PayloadSummaryRedacted</td><td class="numeric">@alert.OccurrenceCount.ToString("N0")</td><td>@Local(alert.LastSeenUtc)</td><td>@(alert.AcknowledgedBy??"—")</td><td>@(alert.ResolvedBy??"—")</td><td><div class="table-actions">@if(alert.ResolvedUtc is null){@if(alert.AcknowledgedUtc is null){<button type="button" class="small-action warn-action" disabled="@ActionBusy" aria-label="Potrdi opozorilo @alert.Title" @onclick="()=>Acknowledge(alert.AlertId)">Potrdi</button>}<button type="button" class="small-action good-action" disabled="@ActionBusy" aria-label="Razreši opozorilo @alert.Title" @onclick="()=>Resolve(alert.AlertId)">Razreši</button>}else{<span class="no-action">—</span>}</div></td></tr>}</tbody></table>
    </div>}
  </section>}
@code{int? OrganizationId;PIM.Intranet.Services.SystemIntegrationView? View;bool Loading=true;string? Message,Error;
  // Zapisovalni dejanji sta revidirani, zato med izvajanjem ne smeta biti sprožljivi drugič.
  bool ActionBusy;
  protected override async Task OnInitializedAsync(){try{var org=await Data.GetCurrentOrganizationAsync();if(org is null){Error="Aktivna organizacija ni na voljo.";return;}OrganizationId=org.OrganizationId;await Reload();}finally{Loading=false;}}
  async Task Reload(){if(OrganizationId is null)return;Loading=true;Error=null;try{View=await Data.GetSystemIntegrationsAsync(OrganizationId.Value);}catch{Error="Integracij trenutno ni mogoče naložiti.";}finally{Loading=false;}}
  async Task<string> Actor(){var state=await Authentication.GetAuthenticationStateAsync();return state.User.Identity?.Name??"neznan";}
  async Task Acknowledge(long id){if(ActionBusy)return;ActionBusy=true;Message=null;try{await Data.AcknowledgeAlertAsync(OrganizationId!.Value,id,await Actor());Message="Opozorilo je potrjeno in auditirano.";await Reload();}catch{Error="Opozorila ni bilo mogoče potrditi.";}finally{ActionBusy=false;}}
  async Task Resolve(long id){if(ActionBusy)return;ActionBusy=true;Message=null;try{await Data.ResolveAlertAsync(OrganizationId!.Value,id,await Actor());Message="Opozorilo je razrešeno in auditirano.";await Reload();}catch{Error="Opozorila ni bilo mogoče razrešiti.";}finally{ActionBusy=false;}}
  static string Local(DateTime? value)=>value?.ToLocalTime().ToString("g")??"—";
  static string Chip(string? value)=>value is "Healthy" or "Succeeded" or "Info"?"good":value is "Failed" or "Critical" or "Error"?"bad":"warn";}
