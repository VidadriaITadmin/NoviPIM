@page "/pravila/validacija"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@inject GovernanceReadService Governance
@inject IntranetDataService Data
@inject RulesWriteService Rules
@inject AuthenticationStateProvider Authentication

<PageTitle>Validacijski profili</PageTitle>
<PimPage Title="Validacijski profili" Subtitle="Zahteve so razvrščene po istem poslovnem nivoju kot kartica izdelka in seznam napak. Vsako zahtevo lahko urediš tu: validacija se ravna po tem, kar tu piše." Crumbs="Crumbs">
  <Actions>
    <a class="secondary" href="kakovost/napake">Odpri napake izdelkov</a>
    <a class="primary-button" href="izvoz/validacijski-profili.xlsx" title="En list na nivo (ERP_SLO, ERP_EU/THIRD, KOMERCIALA, SPLET), s prevedenim imenom polja iz kartice izdelka.">Izvozi Excel</a>
  </Actions>
</PimPage>

<PimTabs Active="validation" Tabs="RulesTabs.Tabs" Label="Pravila in izvor podatkov" />

<section class="ui-card rule-guide" aria-labelledby="validation-guide-title">
  <div>
    <h2 id="validation-guide-title">Kdaj spremeniš validacijo?</h2>
    <p>Ko mora biti polje obvezno, ko naj težava samo opozori ali ko zahteva ne sme več blokirati izhoda.</p>
  </div>
  <ol class="rule-steps">
    <li><strong>Najdi zahtevo</strong><span>Filtriraj po profilu ali kodi polja.</span></li>
    <li><strong>Nastavi vpliv</strong><span>Napaka blokira, opozorilo pa samo opozori.</span></li>
    <li><strong>Preveri rezultat</strong><span>Validacija se po shranjevanju samodejno ponovi.</span></li>
  </ol>
</section>

@if (Message is not null) { <p class="message-state" role="status">@Message</p> }
@if (SaveError is not null) { <p class="message-state error-message" role="alert">@SaveError</p> }

@if (!Loading && Error is null)
{
  <div class="rule-summary" aria-label="Povzetek validacijskih zahtev">
    <div class="rule-summary-item"><span>Aktivne zahteve</span><strong>@ActiveCount.ToString("N0")</strong></div>
    <div class="rule-summary-item bad"><span>Blokirajoče napake</span><strong>@BlockingRequirementCount.ToString("N0")</strong></div>
    <div class="rule-summary-item warn"><span>Opozorila</span><strong>@WarningCount.ToString("N0")</strong></div>
    <div class="rule-summary-item"><span>Čakajo na znano polje</span><strong>@WaitingCount.ToString("N0")</strong></div>
  </div>
}

@* L1: uporabnik 2026-08-28 — »to bi bilo misljeno da uporabniki spreminjajo in da se potem
   validacija na podlagi tega dela; treba je omogocit da dodajajo napake in opozorila«.
   Zahteva se ne brise, ker odprte napake kazejo nanjo; umik je preklop v neaktivno. *@
<details class="ui-card compact-details section-gap">
  <summary>Dodaj novo zahtevo</summary>
  <div class="compact-details-body">
    <div class="form-grid">
      <label class="form-field">Kje naj zahteva velja?
        <select class="filter-select" @bind="NewProfileId">
          <option value="0">Izberi profil</option>
          @foreach (var profile in Profiles) { <option value="@profile.ValidationProfileId">@profile.ProfileCode — @profile.Name</option> }
        </select>
      </label>
      <label class="form-field">Katero polje je zahtevano?
        <input class="form-input" placeholder="npr. Product.EAN" list="validation-fields" @bind="NewFieldCode" />
      </label>
      <label class="form-field">Kaj naj se zgodi, če manjka?
        <select class="filter-select" @bind="NewSeverity">
          <option value="ERROR">Napaka — blokira izhod</option>
          <option value="WARNING">Opozorilo — izhoda ne blokira</option>
        </select>
      </label>
      <div class="form-action">
        <button type="button" class="primary-button" disabled="@(Busy || NewProfileId == 0 || NewFieldCode.Trim().Length == 0)" @onclick="AddRequirementAsync">Dodaj in ponovno preveri</button>
      </div>
    </div>
    <datalist id="validation-fields">
      @foreach (var field in KnownFieldCodes) { <option value="@field"></option> }
    </datalist>
    <p class="card-note">Če PIM kode polja še ne pozna, jo varno shrani kot neaktivno. Takšna zahteva je vidna v razdelku »Čakajo na polje« in ne ustvarja lažne blokade.</p>
  </div>
</details>

@* P2-16, pregled 2026-09-08: stran je nosila 623 vrstic s 623 izbirniki resnosti, zato je ena
   sprememba pomenila iskanje po vsem seznamu. Zahteve ostanejo vse — skrivanje bi bilo laz — dobijo
   pa filter po profilu, polju in resnosti ter pošteno število »prikazano X od Y«. *@
<section class="ui-card toolbar section-gap" role="search" aria-labelledby="rules-filter-title">
  <h2 id="rules-filter-title" class="visually-hidden">Filtriranje zahtev</h2>

  <label class="visually-hidden" for="rules-profile">Profil</label>
  <select id="rules-profile" class="filter-select" @bind="FilterProfile">
    <option value="">Vsi profili</option>
    @foreach (var profile in Profiles) { <option value="@profile.ProfileCode">@profile.ProfileCode</option> }
  </select>

  <label class="visually-hidden" for="rules-severity">Resnost</label>
  <select id="rules-severity" class="filter-select" @bind="FilterSeverity">
    <option value="">Vse resnosti</option>
    <option value="ERROR">Napaka — blokira</option>
    <option value="WARNING">Opozorilo — ne blokira</option>
  </select>

  <label class="visually-hidden" for="rules-search">Iskanje po polju</label>
  <input id="rules-search" class="form-input" type="search" placeholder="Išči po kodi polja …"
         @bind="FilterField" @bind:event="oninput" />

  @if (HasFilter)
  {
    <button type="button" class="secondary-button" @onclick="ClearFilters">Počisti filtre</button>
  }
  <span class="result-count">prikazano @VisibleCount.ToString("N0") od @ActiveCount.ToString("N0") aktivnih zahtev</span>
</section>

<PimState Loading="Loading" Error="@Error" Empty="@(Profiles.Count == 0)" EmptyText="Validacijskih profilov ni." LoadingText="Nalaganje profilov in zahtev …">
  @foreach (var layer in Layers)
  {
    var rows = RowsFor(layer, true);
    if (rows.Count == 0 && HasFilter) { continue; }
    <section class="ui-card data-card section-gap" aria-labelledby="@($"rules-{layer}")">
      <h2 id="@($"rules-{layer}")">@ValidationLayer.Label(layer)</h2>
      <PimTable Caption="@($"Aktivne zahteve nivoja {ValidationLayer.Label(layer)}")" Columns="RequirementColumns">
        <Rows>
          @foreach (var row in rows)
          {
            <tr>
              <td><strong>@row.Profile.Name</strong><div class="tree-path">@row.Profile.ProfileCode</div></td>
              <td><span class="code-value">@row.Requirement.FieldCode</span></td>
              <td>
                <label class="visually-hidden" for="@("sev-" + row.Requirement.FieldRequirementId)">Resnost zahteve @row.Requirement.FieldCode</label>
                <select id="@("sev-" + row.Requirement.FieldRequirementId)" class="filter-select severity-select" disabled="@Busy"
                        value="@(row.Requirement.Severity ?? "ERROR")"
                        @onchange="args => ChangeSeverityAsync(row, args.Value?.ToString())">
                  <option value="ERROR">Napaka</option>
                  <option value="WARNING">Opozorilo</option>
                </select>
              </td>
              <td>@(row.Requirement.IsRequired ? "Obvezno" : "Neobvezno")</td>
              <td>@Blocks(row.Profile)</td>
              <td>@if (ValidationLayer.IsShared(row.Profile.Scope)) { <PimChip Text="Skupno" Tone="info" /> }</td>
              <td class="numeric">@row.Requirement.OpenIssueCount.ToString("N0")</td>
              <td>
                @* Umik zahteve ni brisanje: odprte napake kazejo nanjo. *@
                <button type="button" class="small-action" disabled="@Busy" @onclick="() => SetActiveAsync(row, false)">Umakni</button>
              </td>
            </tr>
          }
        </Rows>
      </PimTable>
      @if (rows.Count == 0) { <div class="note-panel">Ta nivo nima aktivnih zahtev.</div> }
    </section>
  }

  <details class="ui-card compact-details section-gap">
    <summary id="waiting-fields-title">Čakajo na polje (@WaitingCount.ToString("N0"))</summary>
    <div class="compact-details-body">
      <p class="muted">To so umaknjene zahteve ali kode, ki jih podatkovni model še ne pozna. Ne blokirajo izdelkov.</p>
      <PimTable Caption="Neaktivne zahteve, ki čakajo na polje" Columns="WaitingColumns">
        <Rows>
          @foreach (var row in AllRows.Where(row => !row.Requirement.IsActive).OrderBy(row => row.Profile.ProfileCode).ThenBy(row => row.Requirement.FieldCode))
          {
            <tr>
              <td>@LayerNames(row.Profile)</td>
              <td><strong>@row.Profile.ProfileCode</strong></td>
              <td><span class="code-value">@row.Requirement.FieldCode</span></td>
              <td>@(row.Requirement.Severity ?? "—")</td>
              <td>@(row.Requirement.IsRequired ? "Obvezno" : "Neobvezno")</td>
              <td class="numeric">@row.Requirement.OpenIssueCount.ToString("N0")</td>
              <td><button type="button" class="small-action" disabled="@Busy" @onclick="() => SetActiveAsync(row, true)">Vklopi in preveri</button></td>
            </tr>
          }
        </Rows>
      </PimTable>
      @if (WaitingCount == 0) { <div class="note-panel">Ni neaktivnih zahtev.</div> }
    </div>
  </details>
</PimState>

@code {
  sealed record RequirementWithProfile(ValidationProfileRow Profile, FieldRequirementRow Requirement);

  static readonly PimValidationLayer[] Layers = Enum.GetValues<PimValidationLayer>();
  IReadOnlyList<ValidationProfileRow> Profiles = [];
  IReadOnlyList<RequirementWithProfile> AllRows = [];
  IReadOnlyList<string> KnownFields = [];
  bool Loading = true;
  bool Busy;
  string? Error;
  string? Message;
  string? SaveError;
  int NewProfileId;
  string NewFieldCode = "";
  string NewSeverity = "ERROR";
  bool InitialFilterApplied;

  [SupplyParameterFromQuery(Name = "profil")]
  public string? RequestedProfile { get; set; }

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Pravila", "pravila"), new("Validacijski profili")];
  static readonly IReadOnlyList<PimColumn> RequirementColumns =
  [new("Profil"), new("Polje"), new("Resnost"), new("Obveznost"), new("Vpliv"), new("Vrsta"), new("Odprtih", Numeric: true), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> WaitingColumns =
  [new("Nivo"), new("Profil"), new("Polje"), new("Resnost"), new("Obveznost"), new("Odprtih", Numeric: true), new("Dejanje")];

  protected override Task OnInitializedAsync() => ReloadAsync();

  async Task ReloadAsync()
  {
    Loading = true;
    Error = null;
    try
    {
      var organization = await Data.GetCurrentOrganizationAsync();
      if (organization is null) { Error = "Aktivna organizacija ni na voljo."; return; }
      if (KnownFields.Count == 0) KnownFields = await Governance.GetCanonicalFieldCodesAsync();
      Profiles = await Governance.GetValidationProfilesAsync(organization.OrganizationId);
      var tasks = Profiles.Select(async profile =>
        (Profile: profile, Requirements: await Governance.GetFieldRequirementsAsync(profile.ValidationProfileId, organization.OrganizationId)));
      var results = await Task.WhenAll(tasks);
      AllRows = results.SelectMany(result => result.Requirements.Select(requirement => new RequirementWithProfile(result.Profile, requirement))).ToArray();
      if (NewProfileId == 0) NewProfileId = Profiles.FirstOrDefault()?.ValidationProfileId ?? 0;
      if (!InitialFilterApplied)
      {
        var requested = (RequestedProfile ?? "").Trim();
        if (requested.Length > 0 && Profiles.Any(profile => string.Equals(profile.ProfileCode, requested, StringComparison.OrdinalIgnoreCase)))
          FilterProfile = Profiles.First(profile => string.Equals(profile.ProfileCode, requested, StringComparison.OrdinalIgnoreCase)).ProfileCode;
        InitialFilterApplied = true;
      }
    }
    catch { Error = "Validacijskih profilov in zahtev trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  async Task<string> ActorAsync() =>
    (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";

  async Task AddRequirementAsync()
  {
    Busy = true; Message = null; SaveError = null;
    try
    {
      var saved = await Rules.SaveRequirementAsync(NewProfileId, NewFieldCode.Trim(), NewSeverity, true, true, await ActorAsync());
      Message = saved.FieldKnown
        ? "Zahteva je dodana; velja ob naslednji validaciji."
        : $"Polje {NewFieldCode.Trim()} ni v katalogu, zato je zahteva zapisana kot neaktivna in čaka na polje.";
      NewFieldCode = "";
      await ReloadAsync();
    }
    catch { SaveError = "Zahteve ni bilo mogoče shraniti."; }
    finally { Busy = false; }
  }

  async Task ChangeSeverityAsync(RequirementWithProfile row, string? severity)
  {
    if (string.IsNullOrWhiteSpace(severity) || severity == row.Requirement.Severity) return;
    await SaveAsync(row, severity, row.Requirement.IsActive, $"Resnost zahteve {row.Requirement.FieldCode} je spremenjena.");
  }

  Task SetActiveAsync(RequirementWithProfile row, bool active) =>
    SaveAsync(row, row.Requirement.Severity ?? "ERROR", active,
      active ? $"Zahteva {row.Requirement.FieldCode} je vklopljena." : $"Zahteva {row.Requirement.FieldCode} je umaknjena; odprte napake se zaprejo ob naslednji validaciji.");

  async Task SaveAsync(RequirementWithProfile row, string severity, bool active, string message)
  {
    Busy = true; Message = null; SaveError = null;
    try
    {
      await Rules.SaveRequirementAsync(row.Profile.ValidationProfileId, row.Requirement.FieldCode,
        severity, row.Requirement.IsRequired, active, await ActorAsync());
      Message = message;
      await ReloadAsync();
    }
    catch { SaveError = "Spremembe ni bilo mogoče shraniti."; }
    finally { Busy = false; }
  }

  string FilterProfile = "", FilterSeverity = "", FilterField = "";
  bool HasFilter => FilterProfile.Length > 0 || FilterSeverity.Length > 0 || FilterField.Trim().Length > 0;

  /// <summary>Aktivne zahteve, ki ustrezajo filtru; imenovalec za »prikazano X od Y«.</summary>
  int ActiveCount => AllRows.Count(row => row.Requirement.IsActive);
  int VisibleCount => AllRows.Count(row => row.Requirement.IsActive && Matches(row));
  int BlockingRequirementCount => AllRows.Count(row => row.Requirement.IsActive
    && string.Equals(row.Requirement.Severity ?? "ERROR", "ERROR", StringComparison.OrdinalIgnoreCase)
    && (row.Profile.BlocksErp || row.Profile.BlocksWeb));
  int WarningCount => AllRows.Count(row => row.Requirement.IsActive
    && string.Equals(row.Requirement.Severity, "WARNING", StringComparison.OrdinalIgnoreCase));
  int WaitingCount => AllRows.Count(row => !row.Requirement.IsActive);
  IReadOnlyList<string> KnownFieldCodes => KnownFields.Concat(AllRows.Select(row => row.Requirement.FieldCode))
    .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(value => value).ToArray();

  void ClearFilters() => (FilterProfile, FilterSeverity, FilterField) = ("", "", "");

  bool Matches(RequirementWithProfile row) =>
    (FilterProfile.Length == 0 || string.Equals(row.Profile.ProfileCode, FilterProfile, StringComparison.OrdinalIgnoreCase))
    && (FilterSeverity.Length == 0 || string.Equals(row.Requirement.Severity ?? "ERROR", FilterSeverity, StringComparison.OrdinalIgnoreCase))
    && (FilterField.Trim().Length == 0 || row.Requirement.FieldCode.Contains(FilterField.Trim(), StringComparison.OrdinalIgnoreCase));

  IReadOnlyList<RequirementWithProfile> RowsFor(PimValidationLayer layer, bool active) => AllRows
    .Where(row => row.Requirement.IsActive == active)
    .Where(Matches)
    .Where(row => ValidationLayer.Resolve(row.Profile.ProfileCode, row.Profile.Scope, row.Profile.BlocksErp, row.Profile.BlocksWeb).Contains(layer))
    .OrderBy(row => row.Profile.ProfileCode).ThenBy(row => row.Requirement.FieldCode).ToArray();

  static string Blocks(ValidationProfileRow profile) => (profile.BlocksErp, profile.BlocksWeb) switch
  {
    (true, true) => "ERP in splet", (true, false) => "ERP", (false, true) => "Splet", _ => "Ne blokira",
  };

  static string LayerNames(ValidationProfileRow profile) => string.Join(", ",
    ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).Select(ValidationLayer.Code));
}
