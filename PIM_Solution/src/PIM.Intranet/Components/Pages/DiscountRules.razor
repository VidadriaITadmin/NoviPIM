@page "/pravila-popustov"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@inject IntranetDataService Data
@inject AuthenticationStateProvider Authentication
@inject PackagingDiscountService Packaging

<PageTitle>Komercialna pravila</PageTitle>
<PimPage OrganizationScope="true" Title="Komercialna pravila"
         Subtitle="Na enem mestu upravljaš preslikavo skupin strank, vrednostne popuste, poštnino in posebne izjeme."
         Crumbs="Crumbs" />

<PimTabs Active="commercial" Tabs="RulesTabs.Tabs" Label="Pravila in izvor podatkov" />

<section class="ui-card rule-guide" aria-labelledby="commercial-guide-title">
  <div>
    <h2 id="commercial-guide-title">Spremeni samo pravilo, ki določa rezultat</h2>
    <p>Najprej izberi področje. Vsaka sprememba se zapiše v revizijsko sled, zato ni treba voditi ločene evidence.</p>
  </div>
  <ol class="rule-steps">
    <li><strong>Izberi področje</strong><span>Skupine, pragovi, poštnina ali izjeme.</span></li>
    <li><strong>Uredi eno pravilo</strong><span>Obrazec pokaže samo polja, ki so zanj pomembna.</span></li>
    <li><strong>Shrani</strong><span>Sprememba velja pri naslednjem izračunu ali izvozu.</span></li>
  </ol>
</section>

@if (Message is not null) { <p class="message-state success-message" role="status">@Message</p> }
@if (SaveError is not null) { <p class="message-state error-message" role="alert">@SaveError</p> }

@if (!Loading && Error is null)
{
  <div class="rule-summary" aria-label="Povzetek komercialnih pravil">
    <div class="rule-summary-item good"><span>Preslikane skupine strank</span><strong>@MappedTypeCount.ToString("N0") / @Types.Count.ToString("N0")</strong></div>
    <div class="rule-summary-item"><span>Vrednostni pragovi</span><strong>@Tiers.Count.ToString("N0")</strong></div>
    <div class="rule-summary-item"><span>Pravila poštnine</span><strong>@((Rows?.Count ?? 0).ToString("N0"))</strong></div>
    <div class="rule-summary-item warn"><span>Trenutno veljavne izjeme</span><strong>@ActiveOverrideCount.ToString("N0")</strong></div>
  </div>
}

<nav class="commercial-sections" aria-label="Področja komercialnih pravil">
  <button type="button" class="@(Section == "types" ? "active" : null)" aria-pressed="@(Section == "types")" @onclick='() => Section = "types"'>
    <strong>Skupine strank</strong><span>@MappedTypeCount.ToString("N0") preslikanih</span>
  </button>
  <button type="button" class="@(Section == "tiers" ? "active" : null)" aria-pressed="@(Section == "tiers")" @onclick='() => Section = "tiers"'>
    <strong>Vrednostni pragovi</strong><span>@Tiers.Count.ToString("N0") stopenj</span>
  </button>
  <button type="button" class="@(Section == "shipping" ? "active" : null)" aria-pressed="@(Section == "shipping")" @onclick='() => Section = "shipping"'>
    <strong>Poštnina</strong><span>@(Rows?.Count ?? 0) pravil</span>
  </button>
  <button type="button" class="@(Section == "overrides" ? "active" : null)" aria-pressed="@(Section == "overrides")" @onclick='() => Section = "overrides"'>
    <strong>Posebne izjeme</strong><span>@Overrides.Count.ToString("N0") vnosov</span>
  </button>
  <button type="button" class="@(Section == "spopusti" ? "active" : null)" aria-pressed="@(Section == "spopusti")" @onclick='() => Section = "spopusti"'>
    <strong>S-popusti</strong><span>@PackagingRules.Count.ToString("N0") pravil</span>
  </button>
</nav>

<PimState Loading="Loading" Error="@Error" Empty="@(OrganizationId is null)" EmptyText="Aktivna organizacija ni na voljo." LoadingText="Nalaganje komercialnih pravil …">
  @if (Section == "types")
  {
    <section class="ui-card panel" aria-labelledby="customer-group-title">
      <div class="section-heading">
        <div>
          <h2 id="customer-group-title">Skupina Magento po tipu stranke</h2>
          <p>Izberi tip stranke; trenutna preslikava se izpolni samodejno. Prazen ključ preslikavo odstrani.</p>
        </div>
      </div>
      <div class="form-grid commercial-form">
        <label class="form-field">Tip stranke
          <select class="filter-select" @bind="TypeCode" @bind:after="OnTypeChanged">
            @foreach (var type in Types) { <option value="@type.CustomerTypeCode">@type.Name (@type.CustomerTypeCode)</option> }
          </select>
        </label>
        <label class="form-field">Ključ skupine Magento
          <input class="form-input" placeholder="Prazno pomeni brez preslikave" @bind="GroupKey" />
        </label>
        <div class="form-action"><button type="button" class="primary-button" disabled="@(Busy || TypeCode.Length == 0)" @onclick="SaveTypeAsync">Shrani preslikavo</button></div>
      </div>
    </section>

    <section class="ui-card data-card section-gap">
      <PimTable Caption="Vsi tipi strank in njihove skupine Magento" Columns="TypeColumns">
        <Rows>
          @foreach (var type in Types)
          {
            <tr>
              <td><strong>@type.Name</strong><div class="tree-path">@type.CustomerTypeCode</div></td>
              <td>@(type.MagentoGroupKey ?? "—")</td>
              <td><PimChip Text="@(string.IsNullOrWhiteSpace(type.MagentoGroupKey) ? "Ni preslikano" : "Preslikano")" Tone="@(string.IsNullOrWhiteSpace(type.MagentoGroupKey) ? "warn" : "good")" /></td>
              <td><button type="button" class="small-action" @onclick="() => SelectType(type)">Uredi</button></td>
            </tr>
          }
        </Rows>
      </PimTable>
    </section>
  }
  else if (Section == "tiers")
  {
    <section class="commercial-workspace">
      <section class="ui-card data-card">
        <PimTable Caption="Vrednostni pragovi — izberi vrstico za urejanje" Columns="TierColumns">
          <Rows>
            @foreach (var tier in Tiers)
            {
              <tr class="@(tier.TierNumber == TierNumber ? "selected-row" : null)">
                <td><strong>Stopnja @tier.TierNumber</strong></td>
                <td class="numeric">@tier.ThresholdGrossExVat.ToString("N2")</td>
                <td class="numeric">@tier.PercentValue.ToString("N2") %</td>
                <td><button type="button" class="small-action" @onclick="() => SelectTier(tier)">Uredi</button></td>
              </tr>
            }
          </Rows>
        </PimTable>
      </section>
      <section class="ui-card panel">
        <h2>Uredi stopnjo @TierNumber</h2>
        <p class="commercial-note">Ko skupna vrednost brez DDV doseže prag, se uporabi izbrani odstotek popusta.</p>
        <div class="tier-form">
          <label class="form-field">Prag bruto brez DDV
            <input type="number" min="0" step="0.01" class="form-input" @bind="TierThreshold" />
          </label>
          <label class="form-field">Popust %
            <input type="number" min="0" max="100" step="0.01" class="form-input" @bind="TierPercent" />
          </label>
          <button type="button" class="primary-button" disabled="@(Busy || !CanSaveTier)" @onclick="SaveTierAsync">Shrani stopnjo</button>
        </div>
      </section>
    </section>
  }
  else if (Section == "shipping")
  {
    <section class="ui-card data-card">
      @if (Rows is null || Rows.Count == 0)
      {
        <div class="empty-state">V bazi ni pravil poštnine.</div>
      }
      else
      {
        <table class="data-table">
          <caption>Pravila poštnine — spremeni vrstico in jo shrani</caption>
          <thead><tr><th>Pravilo</th><th>Prag naročila</th><th>Dolžina paketa (m)</th><th>Neto poštnina</th><th>Brezplačno</th><th>Prednost</th><th><span class="visually-hidden">Dejanje</span></th></tr></thead>
          <tbody>
            @foreach (var row in Rows)
            {
              <tr>
                <td><strong>@row.RuleCode</strong></td>
                <td><input type="number" min="0" step="0.01" class="table-input" aria-label="Prag naročila za @row.RuleCode" @bind="row.OrderThreshold" /></td>
                <td><input type="number" min="0" step="0.01" class="table-input" aria-label="Dolžina paketa za @row.RuleCode" @bind="row.PackageLengthMeters" /></td>
                <td><input type="number" min="0" step="0.01" class="table-input" aria-label="Neto poštnina za @row.RuleCode" @bind="row.ShippingNet" /></td>
                <td><label class="check-field"><input type="checkbox" aria-label="Brezplačna poštnina za @row.RuleCode" @bind="row.IsFree" />Da</label></td>
                <td><input type="number" min="0" class="table-input compact" aria-label="Prednost za @row.RuleCode" @bind="row.Priority" /></td>
                <td><button type="button" class="small-action good-action" disabled="@(Busy || !CanSaveShipping(row))" @onclick="() => SaveShippingAsync(row)">Shrani</button></td>
              </tr>
            }
          </tbody>
        </table>
      }
    </section>
  }
  else if (Section == "spopusti")
  {
    @* 274: S-popust na polno pakiranje (Magento_Pravila §4.4, §4.5, §4.8). Šifrant S kod, pravila po
       tipu stranke ali stranki za en artikel, rabatno skupino, vse artikle z dano S kodo ali vse
       artikle. Stranka ima prednost pred tipom; znotraj zmaga najbolj specifično pravilo. *@
    <section class="commercial-workspace">
      <section class="ui-card data-card">
        <PimTable Caption="Šifrant S kod — odstotek popusta pri količini ≥ PAK2" Columns="CodeColumns">
          <Rows>
            @foreach (var entry in PackagingCodes)
            {
              <tr class="@(entry.Code == EditCode ? "selected-row" : null)">
                <td><strong>@entry.Code</strong></td>
                <td class="numeric">@entry.Percent.ToString("0.##") %</td>
                <td><button type="button" class="small-action" @onclick="() => { EditCode = entry.Code; EditPercent = entry.Percent; }">Uredi</button></td>
              </tr>
            }
          </Rows>
        </PimTable>
      </section>
      <section class="ui-card panel">
        <h2>S koda</h2>
        <p class="commercial-note">Spremeni odstotek obstoječe kode ali vpiši novo (npr. S5). Sprememba velja za vse izdelke s to kodo ob naslednjem izvozu katalog.csv.</p>
        <div class="tier-form">
          <label class="form-field">Koda<input class="form-input" @bind="EditCode" /></label>
          <label class="form-field">Popust %<input type="number" min="0" max="100" step="0.01" class="form-input" @bind="EditPercent" /></label>
          <button type="button" class="primary-button" disabled="@(Busy || EditCode.Trim().Length == 0 || EditPercent <= 0 || EditPercent > 100)" @onclick="SavePercentAsync">Shrani kodo</button>
        </div>
      </section>
    </section>

    <section class="ui-card panel section-gap" aria-labelledby="packaging-rule-title">
      <div class="section-heading">
        <div>
          <h2 id="packaging-rule-title">Dodaj pravilo posebnega S</h2>
          <p>Npr. »vsi inštalaterji dobijo na rabatni skupini BRAYTRON S3« ali »tip Trgovec: vsi artikli z S2 dobijo S3«. Obstoječe pravilo za isti cilj in obseg se posodobi.</p>
        </div>
      </div>
      <div class="form-grid override-form">
        <label class="form-field">Komu
          <select class="filter-select" @bind="RuleTarget">
            <option value="TYPE">Tipu stranke</option>
            <option value="CUSTOMER">Stranki</option>
          </select>
        </label>
        @if (RuleTarget == PackagingDiscountService.TargetType)
        {
          <label class="form-field">Tip stranke
            <select class="filter-select" @bind="RuleType">
              @foreach (var type in Types) { <option value="@type.CustomerTypeCode">@type.Name</option> }
            </select>
          </label>
        }
        else
        {
          <label class="form-field">Šifra stranke<input class="form-input" placeholder="npr. 00001234" @bind="RuleCustomer" /></label>
        }
        <label class="form-field">Za artikle
          <select class="filter-select" @bind="RuleScope">
            <option value="ITEM_GROUP">Rabatna skupina</option>
            <option value="S_CODE">Vsi z privzeto S kodo</option>
            <option value="ALL">Vsi artikli</option>
            <option value="ITEM">En artikel</option>
          </select>
        </label>
        @if (RuleScope == PackagingDiscountService.ScopeItem)
        {
          <label class="form-field">Šifra artikla<input class="form-input" @bind="RuleItem" /></label>
        }
        else if (RuleScope == PackagingDiscountService.ScopeGroup)
        {
          <label class="form-field">Rabatna skupina<input class="form-input" placeholder="npr. BRAYTRON" @bind="RuleGroup" /></label>
        }
        else if (RuleScope == PackagingDiscountService.ScopeCode)
        {
          <label class="form-field">Privzeta S koda
            <select class="filter-select" @bind="RuleFrom">
              @foreach (var entry in PackagingCodes) { <option value="@entry.Code">@entry.Code</option> }
            </select>
          </label>
        }
        <label class="form-field">Nova S koda
          <select class="filter-select" @bind="RuleCode">
            @foreach (var entry in PackagingCodes) { <option value="@entry.Code">@entry.Code (@entry.Percent.ToString("0.##") %)</option> }
          </select>
        </label>
        <label class="form-field">Velja od<input type="date" class="form-input" @bind="RuleValidFrom" /></label>
        <label class="form-field">Velja do<input type="date" class="form-input" @bind="RuleValidTo" /></label>
        <div class="form-action"><button type="button" class="primary-button" disabled="@(Busy || !CanSaveRule)" @onclick="SaveRuleAsync">Shrani pravilo</button></div>
      </div>
    </section>

    <section class="ui-card data-card section-gap">
      <PimTable Caption="Pravila posebnega S — v katalog.csv: stranka v »Posebni popust za stranko«, tip v »Posebni S za skupino strank«" Columns="RuleColumns">
        <Rows>
          @foreach (var rule in PackagingRules)
          {
            <tr>
              <td>@rule.TargetLabel@if (rule.MagentoGroupKey is not null) { <div class="tree-path">@rule.MagentoGroupKey</div> }</td>
              <td>@rule.ScopeLabel</td>
              <td><strong>@rule.DiscountCode</strong> (@(rule.Percent?.ToString("0.##") ?? "?") %)</td>
              <td class="numeric">@rule.ProductCount.ToString("N0")</td>
              <td class="numeric">@rule.CustomerCount.ToString("N0")</td>
              <td>@(rule.ValidFrom?.ToString("d") ?? "takoj") – @(rule.ValidTo?.ToString("d") ?? "brez konca")</td>
              <td><button type="button" class="small-action" disabled="@Busy" @onclick="() => RemoveRuleAsync(rule)">Umakni</button></td>
            </tr>
          }
        </Rows>
      </PimTable>
      @if (PackagingRules.Count == 0) { <div class="empty-state">Pravil posebnega S še ni — vse stranke s kljukico dobijo privzeti S izdelka.</div> }
      <p class="commercial-note">Pravila za posamezen artikel urejaš tudi na kartici izdelka, na seznamu izdelkov (»S-popust …«) in v delovnem listu izdelkov; pravila stranke na kartici stranke in v delovnem listu strank (list »S po tipih strank« za tipe).</p>
    </section>
  }
  else
  {
    <section class="ui-card panel" aria-labelledby="override-title">
      <div class="section-heading">
        <div>
          <h2 id="override-title">Dodaj posebno izjemo skupinskega popusta</h2>
          <p>Izjema ima prednost pred uvoženim SAOP popustom. Polje »velja do« lahko pustiš prazno za trajno veljavnost.</p>
        </div>
      </div>
      <div class="form-grid override-form">
        <label class="form-field">Izjema velja za
          <select class="filter-select" @bind="TargetKind">
            <option value="TYPE">Tip stranke</option>
            <option value="CUSTOMER">Posamezno stranko</option>
          </select>
        </label>
        @if (TargetKind == "TYPE")
        {
          <label class="form-field">Tip stranke
            <select class="filter-select" @bind="OverrideType">
              @foreach (var type in Types) { <option value="@type.CustomerTypeCode">@type.Name (@type.CustomerTypeCode)</option> }
            </select>
          </label>
        }
        else
        {
          <label class="form-field">ID stranke
            <input type="number" min="1" class="form-input" placeholder="Interni ID stranke" @bind="OverrideCustomer" />
          </label>
        }
        <label class="form-field">Skupina artiklov
          <input class="form-input" placeholder="Koda skupine" @bind="ItemGroup" />
        </label>
        <label class="form-field">Popust %
          <input type="number" min="0" max="100" step="0.01" class="form-input" @bind="OverridePercent" />
        </label>
        <label class="form-field">Velja od
          <input type="date" class="form-input" @bind="OverrideFrom" />
        </label>
        <label class="form-field">Velja do
          <input type="date" class="form-input" @bind="OverrideTo" />
        </label>
        <div class="form-action"><button type="button" class="primary-button" disabled="@(Busy || !CanSaveOverride)" @onclick="SaveOverrideAsync">Dodaj izjemo</button></div>
      </div>
      @if (OverrideDatesInvalid) { <p class="message-state warn-message">Datum »velja do« ne more biti pred datumom »velja od«.</p> }
    </section>

    <section class="ui-card data-card section-gap">
      <PimTable Caption="Posebne izjeme — prednost: stranka, tip stranke, nato uvoženi SAOP popust" Columns="OverrideColumns">
        <Rows>
          @foreach (var item in Overrides)
          {
            <tr>
              <td>@(item.TargetKind == "CUSTOMER" ? "Stranka" : "Tip stranke")</td>
              <td><strong>@(item.CustomerKey ?? item.CustomerTypeCode ?? "—")</strong></td>
              <td>@item.ItemGroupCode</td>
              <td class="numeric">@item.PercentValue.ToString("N2") %</td>
              <td>@(item.ValidFrom?.ToString("d") ?? "takoj")</td>
              <td>@(item.ValidTo?.ToString("d") ?? "brez konca")</td>
              <td><PimChip Text="@OverrideStatus(item)" Tone="@OverrideTone(item)" /></td>
            </tr>
          }
        </Rows>
      </PimTable>
      @if (Overrides.Count == 0) { <div class="empty-state">Posebnih izjem še ni.</div> }
    </section>
  }
</PimState>

@code {
  IReadOnlyList<ShippingRuleRow>? Rows;
  IReadOnlyList<CustomerTypeRow> Types = [];
  IReadOnlyList<ValueTierRow> Tiers = [];
  IReadOnlyList<GroupOverrideRow> Overrides = [];
  [SupplyParameterFromQuery(Name = "podrocje")] public string? QuerySection { get; set; }
  string Section = "types";
  IReadOnlyList<PackagingCode> PackagingCodes = [];
  IReadOnlyList<PackagingRule> PackagingRules = [];
  string EditCode = "";
  decimal EditPercent;
  string RuleTarget = PackagingDiscountService.TargetType, RuleType = "", RuleCustomer = "", RuleScope = PackagingDiscountService.ScopeGroup;
  string RuleItem = "", RuleGroup = "", RuleFrom = "", RuleCode = "";
  DateTime? RuleValidFrom, RuleValidTo;
  string? Message;
  string? SaveError;
  string? Error;
  bool Loading = true;
  bool Busy;
  string TypeCode = "", GroupKey = "", TargetKind = "TYPE", OverrideType = "", ItemGroup = "";
  int TierNumber = 1;
  decimal TierThreshold, TierPercent, OverridePercent;
  long? OverrideCustomer;
  DateTime? OverrideFrom, OverrideTo;
  int? OrganizationId;

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Pravila", "pravila"), new("Komercialna pravila")];
  static readonly IReadOnlyList<PimColumn> TypeColumns = [new("Tip stranke"), new("Skupina Magento"), new("Stanje"), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> TierColumns = [new("Stopnja"), new("Prag brez DDV", Numeric: true), new("Popust", Numeric: true), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> CodeColumns = [new("Koda"), new("Popust", Numeric: true), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> RuleColumns =
  [new("Komu"), new("Za artikle"), new("S koda"), new("Izdelkov danes", Numeric: true), new("Strank", Numeric: true), new("Velja"), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> OverrideColumns =
  [new("Cilj"), new("Stranka ali tip"), new("Skupina artiklov"), new("Popust", Numeric: true), new("Od"), new("Do"), new("Stanje")];

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var organization = await Data.GetCurrentOrganizationAsync();
      if (organization is null) { Error = "Aktivna organizacija ni na voljo."; return; }
      OrganizationId = organization.OrganizationId;
      if (QuerySection is { Length: > 0 } requested) Section = requested;
      await ReloadAllAsync();
      TypeCode = Types.FirstOrDefault()?.CustomerTypeCode ?? "";
      OverrideType = TypeCode;
      OnTypeChanged();
      var firstTier = Tiers.FirstOrDefault();
      if (firstTier is not null) SelectTier(firstTier);
    }
    catch { Error = "Komercialnih pravil trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  async Task ReloadAllAsync()
  {
    if (OrganizationId is null) return;
    var shippingTask = Data.GetShippingRulesAsync();
    var typesTask = Data.GetCustomerTypesAsync();
    var tiersTask = Data.GetValueTiersAsync();
    var overridesTask = Data.GetGroupOverridesAsync(OrganizationId.Value);
    await Task.WhenAll(shippingTask, typesTask, tiersTask, overridesTask);
    Rows = await shippingTask;
    Types = await typesTask;
    Tiers = await tiersTask;
    Overrides = await overridesTask;
    PackagingCodes = await Packaging.GetCatalogAsync();
    PackagingRules = await Packaging.GetRulesAsync(OrganizationId.Value);
    RuleType = RuleType.Length > 0 ? RuleType : Types.FirstOrDefault()?.CustomerTypeCode ?? "";
    RuleCode = RuleCode.Length > 0 ? RuleCode : PackagingCodes.FirstOrDefault()?.Code ?? "";
    RuleFrom = RuleFrom.Length > 0 ? RuleFrom : PackagingCodes.FirstOrDefault()?.Code ?? "";
  }

  bool CanSaveRule => RuleCode.Length > 0
    && (RuleTarget == PackagingDiscountService.TargetType ? RuleType.Length > 0 : RuleCustomer.Trim().Length > 0)
    && (RuleValidFrom is null || RuleValidTo is null || RuleValidTo >= RuleValidFrom)
    && RuleScope switch
    {
      PackagingDiscountService.ScopeItem => RuleItem.Trim().Length > 0,
      PackagingDiscountService.ScopeGroup => RuleGroup.Trim().Length > 0,
      PackagingDiscountService.ScopeCode => RuleFrom.Length > 0,
      _ => true,
    };

  async Task SavePercentAsync() => await RunSaveAsync(async () =>
  {
    await Packaging.SavePercentAsync(OrganizationId!.Value, EditCode, EditPercent, await ActorAsync());
    PackagingCodes = await Packaging.GetCatalogAsync();
  }, $"S koda {EditCode.Trim().ToUpperInvariant()} je shranjena.");

  async Task SaveRuleAsync() => await RunSaveAsync(async () =>
  {
    await Packaging.SaveRuleAsync(OrganizationId!.Value, new(RuleTarget,
      RuleTarget == PackagingDiscountService.TargetType ? RuleType : null, null,
      RuleTarget == PackagingDiscountService.TargetCustomer ? RuleCustomer.Trim() : null,
      RuleScope,
      RuleScope == PackagingDiscountService.ScopeItem ? RuleItem.Trim() : null,
      RuleScope == PackagingDiscountService.ScopeGroup ? RuleGroup.Trim() : null,
      RuleScope == PackagingDiscountService.ScopeCode ? RuleFrom : null,
      RuleCode, RuleValidFrom, RuleValidTo), await ActorAsync());
    PackagingRules = await Packaging.GetRulesAsync(OrganizationId.Value);
  }, "Pravilo posebnega S je shranjeno.");

  async Task RemoveRuleAsync(PackagingRule rule) => await RunSaveAsync(async () =>
  {
    await Packaging.RemoveRuleAsync(OrganizationId!.Value, rule.RuleId, await ActorAsync());
    PackagingRules = await Packaging.GetRulesAsync(OrganizationId.Value);
  }, "Pravilo je umaknjeno.");

  void OnTypeChanged() =>
    GroupKey = Types.FirstOrDefault(type => type.CustomerTypeCode == TypeCode)?.MagentoGroupKey ?? "";

  void SelectType(CustomerTypeRow type)
  {
    TypeCode = type.CustomerTypeCode;
    GroupKey = type.MagentoGroupKey ?? "";
  }

  void SelectTier(ValueTierRow tier)
  {
    TierNumber = tier.TierNumber;
    TierThreshold = tier.ThresholdGrossExVat;
    TierPercent = tier.PercentValue;
  }

  async Task SaveTypeAsync() => await RunSaveAsync(async () =>
  {
    await Data.SaveCustomerTypeMappingAsync(OrganizationId!.Value, TypeCode, GroupKey, await ActorAsync());
    Types = await Data.GetCustomerTypesAsync();
    OnTypeChanged();
  }, "Preslikava skupine stranke je shranjena.");

  async Task SaveTierAsync() => await RunSaveAsync(async () =>
  {
    await Data.SaveValueTierAsync(OrganizationId!.Value, TierNumber, TierThreshold, TierPercent, await ActorAsync());
    Tiers = await Data.GetValueTiersAsync();
  }, $"Vrednostna stopnja {TierNumber} je shranjena.");

  async Task SaveShippingAsync(ShippingRuleRow row) => await RunSaveAsync(async () =>
  {
    await Data.SaveShippingRuleAsync(OrganizationId!.Value, row, await ActorAsync());
  }, $"Pravilo poštnine {row.RuleCode} je shranjeno.");

  async Task SaveOverrideAsync() => await RunSaveAsync(async () =>
  {
    await Data.SaveGroupOverrideAsync(OrganizationId!.Value, TargetKind,
      TargetKind == "CUSTOMER" ? OverrideCustomer : null,
      TargetKind == "TYPE" ? OverrideType : null,
      ItemGroup.Trim(), OverridePercent, OverrideFrom, OverrideTo, await ActorAsync());
    Overrides = await Data.GetGroupOverridesAsync(OrganizationId.Value);
    ItemGroup = "";
    OverridePercent = 0;
    OverrideCustomer = null;
    OverrideFrom = OverrideTo = null;
  }, "Posebna izjema je dodana.");

  async Task RunSaveAsync(Func<Task> action, string message)
  {
    if (OrganizationId is null) return;
    Busy = true; Message = SaveError = null;
    try { await action(); Message = message; }
    catch (Microsoft.Data.SqlClient.SqlException failure) when (failure.Number is >= 52700 and < 52800)
    { SaveError = failure.Message; }
    catch { SaveError = "Spremembe ni bilo mogoče shraniti. Preveri vnesene vrednosti in poskusi znova."; }
    finally { Busy = false; }
  }

  async Task<string> ActorAsync() =>
    (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";

  int MappedTypeCount => Types.Count(type => !string.IsNullOrWhiteSpace(type.MagentoGroupKey));
  int ActiveOverrideCount => Overrides.Count(item =>
    (item.ValidFrom is null || item.ValidFrom.Value.Date <= DateTime.Today)
    && (item.ValidTo is null || item.ValidTo.Value.Date >= DateTime.Today));
  bool CanSaveTier => TierNumber is >= 1 and <= 3 && TierThreshold >= 0 && TierPercent is >= 0 and <= 100;
  bool CanSaveShipping(ShippingRuleRow row) => row.ShippingNet >= 0 && row.Priority >= 0
    && (row.OrderThreshold is null || row.OrderThreshold >= 0)
    && (row.PackageLengthMeters is null || row.PackageLengthMeters >= 0);
  bool OverrideDatesInvalid => OverrideFrom is not null && OverrideTo is not null && OverrideTo.Value.Date < OverrideFrom.Value.Date;
  bool CanSaveOverride => ItemGroup.Trim().Length > 0 && OverridePercent is >= 0 and <= 100 && !OverrideDatesInvalid
    && (TargetKind == "TYPE" ? OverrideType.Length > 0 : OverrideCustomer > 0);

  static string OverrideStatus(GroupOverrideRow row)
  {
    if (row.ValidFrom is not null && row.ValidFrom.Value.Date > DateTime.Today) return "Prihodnja";
    if (row.ValidTo is not null && row.ValidTo.Value.Date < DateTime.Today) return "Potekla";
    return "Veljavna";
  }

  static string? OverrideTone(GroupOverrideRow row) => OverrideStatus(row) switch
  {
    "Veljavna" => "good",
    "Prihodnja" => "info",
    _ => null,
  };
}
