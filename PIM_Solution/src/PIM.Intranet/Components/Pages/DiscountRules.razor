@page "/pravila-popustov"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.IntranetDataService Data
@inject AuthenticationStateProvider Authentication

<PageTitle>Pravila popustov</PageTitle>
<div class="page-header"><div><h1>Pravila popustov</h1><p>Upravljanje preslikav, vrednostnih pragov, poštnine in skupinskih popustov.</p></div></div>

<section class="ui-card panel section-gap">
  <h2>Skupina Magento po tipu stranke</h2>
  <div class="form-grid">
    <label class="form-field">Tip stranke<select class="filter-select" @bind="TypeCode">@foreach(var type in Types){<option value="@type.CustomerTypeCode">@type.Name</option>}</select></label>
    <label class="form-field">Ključ skupine Magento<input class="form-input" @bind="GroupKey" /></label>
    <div class="form-action"><button class="primary-button" @onclick="SaveType">Shrani preslikavo</button></div>
  </div>
</section>

<section class="ui-card data-card section-gap">
  @if(Tiers.Count==0){<div class="empty-state">V bazi ni vrednostnih pragov.</div>}
  else{<table class="data-table"><caption>Vrednostni pragovi iz PIM baze</caption><thead><tr><th>Stopnja</th><th>Prag bruto brez DDV</th><th>Popust %</th><th><span class="visually-hidden">Dejanje</span></th></tr></thead><tbody>@foreach(var tier in Tiers){<tr><td>@tier.TierNumber</td><td>@tier.ThresholdGrossExVat</td><td>@tier.PercentValue</td><td><button class="small-action" @onclick="()=>SelectTier(tier)">Uredi</button></td></tr>}</tbody></table>}
</section>
<section class="ui-card panel section-gap">
  <h2>Uredi vrednostni prag</h2>
  <div class="form-grid">
    <label class="form-field">Stopnja<input type="number" min="1" max="3" class="form-input" @bind="TierNumber" /></label>
    <label class="form-field">Prag bruto brez DDV<input type="number" class="form-input" @bind="TierThreshold" /></label>
    <label class="form-field">Popust %<input type="number" class="form-input" @bind="TierPercent" /></label>
    <div class="form-action"><button class="primary-button" @onclick="SaveTier">Shrani prag</button></div>
  </div>
</section>

<section class="ui-card data-card section-gap">
  @if(Rows is null){<div class="loading-state">Nalaganje pravil …</div>}
  else{<table class="data-table"><caption>Pravila poštnine</caption><thead><tr><th>Pravilo</th><th>Prag</th><th>Dolžina paketa</th><th>Neto poštnina</th><th>Brezplačno</th><th>Prednost</th><th><span class="visually-hidden">Dejanje</span></th></tr></thead><tbody>@foreach(var row in Rows){<tr><td>@row.RuleCode</td><td><input type="number" class="table-input" aria-label="Prag za @row.RuleCode" @bind="row.OrderThreshold" /></td><td><input type="number" class="table-input" aria-label="Dolžina paketa za @row.RuleCode" @bind="row.PackageLengthMeters" /></td><td><input type="number" class="table-input" aria-label="Neto poštnina za @row.RuleCode" @bind="row.ShippingNet" /></td><td><input type="checkbox" aria-label="Brezplačna poštnina za @row.RuleCode" @bind="row.IsFree" /></td><td><input type="number" class="table-input compact" aria-label="Prednost za @row.RuleCode" @bind="row.Priority" /></td><td><button class="small-action good-action" @onclick="()=>Save(row)">Shrani pravilo</button></td></tr>}</tbody></table>}
</section>

<section class="ui-card data-card section-gap">
  <table class="data-table"><caption>Override skupinskih popustov — prioriteta: stranka, tip stranke, uvoženi SAOP popust</caption><thead><tr><th>Cilj</th><th>Tip ali stranka</th><th>Skupina artiklov</th><th>Popust %</th><th>Velja od</th><th>Velja do</th></tr></thead><tbody>@foreach(var item in Overrides){<tr><td>@(item.TargetKind=="CUSTOMER"?"Stranka":"Tip stranke")</td><td>@(item.CustomerKey??item.CustomerTypeCode)</td><td>@item.ItemGroupCode</td><td>@item.PercentValue</td><td>@item.ValidFrom?.ToString("d")</td><td>@item.ValidTo?.ToString("d")</td></tr>}</tbody></table>
</section>
<section class="ui-card panel section-gap">
  <h2>Dodaj override skupinskega popusta</h2>
  <div class="form-grid wide-form-grid">
    <label class="form-field">Cilj<select class="filter-select" @bind="TargetKind"><option value="TYPE">Tip stranke</option><option value="CUSTOMER">Stranka</option></select></label>
    <label class="form-field">Šifra tipa<input class="form-input" @bind="OverrideType" /></label>
    <label class="form-field">ID stranke<input type="number" class="form-input" @bind="OverrideCustomer" /></label>
    <label class="form-field">Skupina artiklov<input class="form-input" @bind="ItemGroup" /></label>
    <label class="form-field">Popust %<input type="number" class="form-input" @bind="OverridePercent" /></label>
    <label class="form-field">Velja od<input type="date" class="form-input" @bind="OverrideFrom" /></label>
    <label class="form-field">Velja do<input type="date" class="form-input" @bind="OverrideTo" /></label>
    <div class="form-action"><button class="primary-button" @onclick="SaveOverride">Dodaj override</button></div>
  </div>
</section>
@if(!string.IsNullOrEmpty(Message)){<p class="message-state info-message" role="status">@Message</p>}
@code{
  IReadOnlyList<PIM.Intranet.Services.ShippingRuleRow>? Rows;IReadOnlyList<PIM.Intranet.Services.CustomerTypeRow> Types=[];IReadOnlyList<PIM.Intranet.Services.ValueTierRow> Tiers=[];IReadOnlyList<PIM.Intranet.Services.GroupOverrideRow> Overrides=[];string? Message;string TypeCode="",GroupKey="",TargetKind="TYPE",OverrideType="",ItemGroup="";int TierNumber=1;decimal TierThreshold,TierPercent,OverridePercent;long? OverrideCustomer;DateTime? OverrideFrom,OverrideTo;int? OrganizationId;
  protected override async Task OnInitializedAsync(){var org=await Data.GetCurrentOrganizationAsync();if(org is null)return;OrganizationId=org.OrganizationId;Rows=await Data.GetShippingRulesAsync();Types=await Data.GetCustomerTypesAsync();Tiers=await Data.GetValueTiersAsync();Overrides=await Data.GetGroupOverridesAsync(org.OrganizationId);TypeCode=Types.FirstOrDefault()?.CustomerTypeCode??"";}
  async Task Save(PIM.Intranet.Services.ShippingRuleRow row){if(OrganizationId is null)return;var auth=await Authentication.GetAuthenticationStateAsync();await Data.SaveShippingRuleAsync(OrganizationId.Value,row,auth.User.Identity?.Name??"neznan");Message="Pravilo je shranjeno in revizijsko zabeleženo.";}
  async Task<string> Actor(){var auth=await Authentication.GetAuthenticationStateAsync();return auth.User.Identity?.Name??"neznan";}
  async Task SaveType(){if(OrganizationId is null)return;await Data.SaveCustomerTypeMappingAsync(OrganizationId.Value,TypeCode,GroupKey,await Actor());Message="Preslikava je shranjena in revizijsko zabeležena.";}
  void SelectTier(PIM.Intranet.Services.ValueTierRow tier){TierNumber=tier.TierNumber;TierThreshold=tier.ThresholdGrossExVat;TierPercent=tier.PercentValue;}
  async Task SaveTier(){if(OrganizationId is null)return;await Data.SaveValueTierAsync(OrganizationId.Value,TierNumber,TierThreshold,TierPercent,await Actor());Tiers=await Data.GetValueTiersAsync();Message="Vrednostni prag je shranjen in revizijsko zabeležen.";}
  async Task SaveOverride(){if(OrganizationId is null)return;await Data.SaveGroupOverrideAsync(OrganizationId.Value,TargetKind,TargetKind=="CUSTOMER"?OverrideCustomer:null,TargetKind=="TYPE"?OverrideType:null,ItemGroup,OverridePercent,OverrideFrom,OverrideTo,await Actor());Overrides=await Data.GetGroupOverridesAsync(OrganizationId.Value);Message="Override je dodan in revizijsko zabeležen.";}
}
