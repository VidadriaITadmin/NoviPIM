@page "/prijava"
@attribute [AllowAnonymous]
@layout PIM.Intranet.Components.Layout.EmptyLayout

<PageTitle>Prijava</PageTitle>

<main class="login-screen">
  <section class="login-card" aria-labelledby="login-title">
    <div id="login-title" class="login-brand"><span>PIM</span> Intranet</div>
    <p class="login-subtitle">Prijavite se z računom iz baze</p>
    @if (Napaka)
    {
      <p class="login-alert" role="alert">Uporabniško ime ali geslo ni pravilno.</p>
    }
    <form method="post" action="auth/prijava">
      <AntiforgeryToken />
      <div class="login-field">
        <label for="uporabniskoIme">Uporabniško ime</label>
        <input id="uporabniskoIme" name="uporabniskoIme" placeholder="npr. admin" autocomplete="username" required />
      </div>
      <div class="login-field">
        <label for="geslo">Geslo</label>
        <input id="geslo" name="geslo" type="password" autocomplete="current-password" required />
      </div>
      <label class="remember-me"><input name="zapomniMe" type="checkbox" /> <span>Zapomni si me (do 14 dni na tem računalniku)</span></label>
      <button type="submit" class="login-submit">Prijava</button>
    </form>
    <p class="login-note">Geslo se preveri varno; brez kljukice velja seja do zaprtja brskalnika.</p>
  </section>
</main>

@code {
  [SupplyParameterFromQuery(Name = "napaka")]
  public string? NapakaParam { get; set; }
  bool Napaka => NapakaParam == "1";
}
