@page "/nadzorna-plosca"
@attribute [Authorize]
@inject PIM.Intranet.Services.IntranetDataService Data
@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache Cache

<PageTitle>Nadzorna plošča</PageTitle>
<div class="page-heading"><span>Nadzorna plošča</span><h1>Nadzorna plošča</h1><p>Stanje vseh podjetij skupaj, ne samo prvega po šifri.</p></div>
@if (Error is not null)
{
  <div class="ui-card error-state" role="alert">@Error</div>
}
else if (Metrics is null)
{
  <p class="loading-state" role="status">Nalaganje podatkov …</p>
}
else
{
  <section class="dashboard-summary" aria-labelledby="povzetek-naslov">
  <h2 id="povzetek-naslov" class="visually-hidden">Povzetek stanja</h2>
  <div class="metric-grid">
    <a class="metric-card blue" href="izdelki"><span class="metric-icon icon-products" aria-hidden="true"></span><span>Skupaj izdelkov</span><strong>@Metrics.CanonProductCount.ToString("N0")</strong><small>@CompanyNote</small></a>
    <a class="metric-card green" href="izdelki"><span class="metric-icon icon-check" aria-hidden="true"></span><span>ERP veljavni</span><strong>@Metrics.ErpValidCount.ToString("N0")</strong><small>@ErpPercent % vseh izdelkov</small></a>
    <a class="metric-card orange" href="izdelki"><span class="metric-icon icon-published" aria-hidden="true"></span><span>Objavljeni izdelki</span><strong>@Metrics.PimProductCount.ToString("N0")</strong><small>Promovirani v PIM</small></a>
    <a class="metric-card red" href="napake-validacije"><span class="metric-icon icon-warning" aria-hidden="true"></span><span>Z napakami</span><strong>@Metrics.WebInvalidCount.ToString("N0")</strong><small>Neveljavni za splet</small></a>
    <a class="metric-card amber" href="karantena"><span class="metric-icon icon-lock" aria-hidden="true"></span><span>V karanteni</span><strong>@Metrics.QuarantineCount.ToString("N0")</strong><small>Zapisi za pregled</small></a>
  </div>
  </section>

  <div class="dashboard-grid">
    <section class="dashboard-panel companies-panel" aria-labelledby="podjetja-naslov">
      <div class="panel-title"><h2 id="podjetja-naslov">Po podjetjih</h2><a href="izdelki">Vsi izdelki</a></div>
      <div class="company-head"><span>Podjetje</span><span>Izdelkov</span><span>ERP veljavnih</span><span>Objavljenih</span><span>Z napakami</span><span>Karantena</span></div>
      @foreach (var company in Companies)
      {
        <a class="company-row" href="izdelki?podjetje=@company.Organization.OrganizationId">
          <span>@company.Organization.Name</span>
          <span class="numeric">@company.Metrics.CanonProductCount.ToString("N0")</span>
          <span class="numeric">@company.Metrics.ErpValidCount.ToString("N0")</span>
          <span class="numeric">@company.Metrics.PimProductCount.ToString("N0")</span>
          <span class="numeric">@company.Metrics.WebInvalidCount.ToString("N0")</span>
          <span class="numeric">@company.Metrics.QuarantineCount.ToString("N0")</span>
        </a>
      }
      <div class="company-row total"><span>Skupaj</span><span class="numeric">@Metrics.CanonProductCount.ToString("N0")</span><span class="numeric">@Metrics.ErpValidCount.ToString("N0")</span><span class="numeric">@Metrics.PimProductCount.ToString("N0")</span><span class="numeric">@Metrics.WebInvalidCount.ToString("N0")</span><span class="numeric">@Metrics.QuarantineCount.ToString("N0")</span></div>
    </section>

    <section class="dashboard-panel quality-panel" aria-labelledby="kakovost-naslov">
      <div class="panel-title"><h2 id="kakovost-naslov">Kakovost po profilih</h2><a href="napake-validacije">Poglej vse</a></div>
      @if (Profiles is null) { <p class="panel-state">Podatki o profilih niso na voljo.</p> }
      else if (Profiles.Count == 0) { <p class="panel-state">Ni podatkov o profilih kakovosti.</p> }
      else
      {
        @foreach (var profile in Profiles.Take(4))
        {
          var completeness = ProfileCompleteness(profile);
          <a class="quality-row" href="napake-validacije"><strong>@profile.ProfileCode</strong><span class="progress" role="progressbar" aria-valuenow="@completeness" aria-valuemin="0" aria-valuemax="100" aria-label="Popolnost profila @profile.ProfileCode"><i class="@(completeness < 75 ? "warn" : null)" style="width:@completeness%"></i></span><span>@completeness %</span><i></i></a>
        }
      }
      <div class="info-note">Popolnost je izračunana iz dejanskih rezultatov profilov vseh podjetij.</div>
    </section>

    <section class="dashboard-panel processes-panel" aria-labelledby="procesi-naslov">
      <div class="panel-title"><h2 id="procesi-naslov">Zadnji procesi / Status integracij</h2><a href="teki-obdelave">Poglej vse</a></div>
      @if (Runs is null) { <p class="panel-state">Zadnji procesi niso na voljo.</p> }
      else if (Runs.Count == 0) { <p class="panel-state">Ni zabeleženih procesov.</p> }
      else
      {
        <div class="process-head"><span>Proces / Integracija</span><span>Zadnji zagon</span><span>Status</span></div>
        @foreach (var run in Runs.OrderByDescending(row => row.StartedUtc).Take(5))
        {
          <a class="process-row" href="teki-obdelave"><span>@run.Pipeline</span><span>@run.StartedUtc.ToPimLocal().ToString("dd. MM. yyyy HH:mm")</span><strong class="status @StatusClass(run.Status)"><span class="visually-hidden">Status: </span>@run.Status</strong></a>
        }
      }
    </section>

    <section class="dashboard-panel alerts-panel" aria-labelledby="opozorila-naslov">
      <div class="panel-title"><h2 id="opozorila-naslov">Opozorila in prioritete</h2></div>
      @if (Alerts is null) { <p class="panel-state">Opozorila integracij niso na voljo.</p> }
      else if (!OpenAlerts.Any()) { <p class="panel-state good-state">Ni odprtih opozoril integracij.</p> }
      else
      {
        @foreach (var alert in OpenAlerts.Take(5))
        {
          <a class="alert-row" href="system/integracije"><span class="row-icon danger icon-warning" aria-hidden="true"></span><span><strong>@alert.Title</strong><small>@alert.Pipeline · @alert.OccurrenceCount pojavov</small></span><i></i></a>
        }
      }
      <a class="panel-link" href="system/integracije">Vsa opozorila</a>
    </section>

    <section class="dashboard-panel integration-panel" aria-labelledby="integracije-naslov">
      <div class="panel-title"><h2 id="integracije-naslov">Stanje integracij</h2><a href="system/integracije">Podrobnosti</a></div>
      @if (Integrations is null) { <p class="panel-state">Stanje integracij ni na voljo.</p> }
      else if (Integrations.Count == 0) { <p class="panel-state">Ni nastavljenih integracij.</p> }
      else
      {
        @foreach (var integration in Integrations.Take(5))
        {
          <a class="integration-row" href="system/integracije"><span>@integration.Provider</span><small>@integration.Pipeline</small><strong class="status @StatusClass(integration.Status)"><span class="visually-hidden">Status: </span>@(integration.Status ?? (integration.IsEnabled ? "Brez statusa" : "Onemogočeno"))</strong></a>
        }
      }
    </section>
  </div>
}

@code {
  // Uporabnik 2026-08-28: „te številke kažejo samo DEMO podjetje, morajo pa kazati celotno
  // tabelo". Plošča zato ne dela vec z GetCurrentOrganizationAsync (ta vrne vedno prvo podjetje
  // po sifri), ampak sesteje vsa aktivna podjetja iz GetOrganizationsAsync in poleg vsote pokaze
  // se razčlenitev po podjetjih. Panela „Moja opravila" in „Hitri dostopi" sta odpadla: prvi je
  // ponavljal dve kartici povzetka in priznaval, da drugih opravil v modelu ni, drugi pa je
  // podvajal levo navigacijo.
  sealed record CompanyMetrics(PIM.Intranet.Services.OrganizationContext Organization, PIM.Intranet.Services.DashboardMetrics Metrics);

  PIM.Intranet.Services.DashboardMetrics? Metrics;
  IReadOnlyList<CompanyMetrics> Companies = [];
  IReadOnlyList<PIM.Intranet.Services.QualityProfileRow>? Profiles;
  IReadOnlyList<PIM.Intranet.Services.PipelineRunRow>? Runs;
  IReadOnlyList<PIM.Intranet.Services.SystemAlertRow>? Alerts;
  IReadOnlyList<PIM.Intranet.Services.SystemIntegrationRow>? Integrations;
  string? Error;

  string CompanyNote => Companies.Count switch { 0 => "Kanonični izdelki", 1 => "Kanonični izdelki enega podjetja", var count => $"Kanonični izdelki {count} podjetij" };
  decimal ErpPercent => Metrics?.CanonProductCount > 0 ? Math.Round(100m * Metrics.ErpValidCount / Metrics.CanonProductCount) : 0;
  IEnumerable<PIM.Intranet.Services.SystemAlertRow> OpenAlerts => (Alerts ?? []).Where(row => row.ResolvedUtc is null).OrderByDescending(row => row.LastSeenUtc);
  static decimal ProfileCompleteness(PIM.Intranet.Services.QualityProfileRow profile) => Math.Clamp(Math.Round(profile.AverageCompleteness ?? (profile.ProductCount > 0 ? 100m * profile.ValidCount / profile.ProductCount : 0)), 0, 100);
  static string StatusClass(string? status) => status?.ToUpperInvariant() switch { "SUCCEEDED" or "OK" or "HEALTHY" => "good", "FAILED" or "ERROR" or "UNHEALTHY" => "bad", _ => "warn" };

  // Stevci plosce se spreminjajo z urno validacijo in petminutnimi cikli, zato jih proces drzi minuto v
  // pomnilniku: izmerjeno 2026-09-17 je deset uporabnikov na plosci hkrati pomenilo 40 socasnih tezkih
  // poizvedb (stiri podjetja x stiri klici) in vsem je stran padla na 30 s meji ukaza. Z minuto
  // predpomnilnika bazo vprasa prvi, ostali berejo isto.
  static readonly TimeSpan CacheFor = TimeSpan.FromSeconds(60);

  async Task<T> CachedAsync<T>(string key, Func<Task<T>> load)
  {
    var value = await Cache.GetOrCreateAsync(key, async entry =>
    {
      entry.AbsoluteExpirationRelativeToNow = CacheFor;
      return await load();
    });
    return value!;
  }

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var organizations = await Data.GetOrganizationsAsync();
      if (organizations.Count == 0) { Error = "Nobeno podjetje ni aktivno."; return; }

      // Podjetja vzporedno (218): vsak klic odpre svojo povezavo, zato stran caka na najpocasnejse
      // podjetje, ne na vsoto vseh — prej je slo zaporedoma in nadzorna plosca je cakala vsakega posebej.
      var companies = (await Task.WhenAll(organizations.Select(async organization =>
        new CompanyMetrics(organization, await CachedAsync(
          $"dashboard:metrics:{organization.OrganizationId}", () => Data.GetDashboardAsync(organization.OrganizationId)))))).ToList();
      Companies = companies;
      Metrics = new(
        companies.Sum(company => company.Metrics.CanonProductCount),
        companies.Sum(company => company.Metrics.PimProductCount),
        companies.Sum(company => company.Metrics.ErpValidCount),
        companies.Sum(company => company.Metrics.WebInvalidCount),
        companies.Sum(company => company.Metrics.QuarantineCount));

      // Panel ostane prikazan tudi, ce eno podjetje odpove; null pomeni, da ni uspelo nobeno.
      var profiles = new List<PIM.Intranet.Services.QualityProfileRow>();
      var runs = new List<PIM.Intranet.Services.PipelineRunRow>();
      var alerts = new List<PIM.Intranet.Services.SystemAlertRow>();
      var integrations = new List<PIM.Intranet.Services.SystemIntegrationRow>();
      bool anyProfiles = false, anyRuns = false, anyIntegrations = false;
      // Tudi ti trije klici na podjetje tecejo vzporedno; rezultati se zlozijo v istem vrstnem
      // redu podjetij kot prej, da se prikaz ne spremeni.
      var perOrganization = await Task.WhenAll(organizations.Select(organization =>
        CachedAsync($"dashboard:panels:{organization.OrganizationId}", async () =>
        {
          // take: 0 — nadzorna plosca bere samo profile (drugi nabor); seznam napak (prvi nabor, TOP 200
          // po datumu cez vse odprte napake podjetja) bi stal ~2 s na podjetje in se tu nikoli ne prikaze.
          var issuesTask = Task.Run(() => Data.GetValidationIssuesAsync(organization.OrganizationId, take: 0));
          var runsTask = Task.Run(() => Data.GetPipelineRunsAsync(organization.OrganizationId));
          var integrationsTask = Task.Run(() => Data.GetSystemIntegrationsAsync(organization.OrganizationId));
          PIM.Intranet.Services.QualityView? issues = null;
          IReadOnlyList<PIM.Intranet.Services.PipelineRunRow>? organizationRuns = null;
          PIM.Intranet.Services.SystemIntegrationView? view = null;
          try { issues = await issuesTask; } catch { }
          try { organizationRuns = await runsTask; } catch { }
          try { view = await integrationsTask; } catch { }
          return (issues, organizationRuns, view);
        })));
      foreach (var (issues, organizationRuns, view) in perOrganization)
      {
        if (issues is not null) { profiles.AddRange(issues.Profiles); anyProfiles = true; }
        if (organizationRuns is not null) { runs.AddRange(organizationRuns); anyRuns = true; }
        if (view is not null) { alerts.AddRange(view.Alerts); integrations.AddRange(view.Integrations); anyIntegrations = true; }
      }

      Profiles = anyProfiles ? MergeProfiles(profiles) : null;
      Runs = anyRuns ? runs : null;
      Alerts = anyIntegrations ? alerts : null;
      Integrations = anyIntegrations ? integrations : null;
    }
    catch { Error = "Nadzorne plošče trenutno ni mogoče naložiti."; }
  }

  // Isti profil pri vec podjetjih je en profil: stevila se sestejejo, popolnost se utezi z izdelki.
  static IReadOnlyList<PIM.Intranet.Services.QualityProfileRow> MergeProfiles(IReadOnlyList<PIM.Intranet.Services.QualityProfileRow> rows) =>
    rows.GroupBy(row => row.ProfileCode, StringComparer.Ordinal)
      .Select(group =>
      {
        var products = group.Sum(row => row.ProductCount);
        var weighted = group.Where(row => row.AverageCompleteness is not null && row.ProductCount > 0).ToArray();
        decimal? average = weighted.Length == 0 || weighted.Sum(row => row.ProductCount) == 0
          ? null
          : weighted.Sum(row => row.AverageCompleteness!.Value * row.ProductCount) / weighted.Sum(row => row.ProductCount);
        return new PIM.Intranet.Services.QualityProfileRow(group.Key, products, group.Sum(row => row.ValidCount), group.Sum(row => row.InvalidCount), average);
      })
      .OrderByDescending(row => row.ProductCount)
      .ToArray();
}
