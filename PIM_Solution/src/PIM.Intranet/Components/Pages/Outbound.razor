@page "/outbound"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@inject PIM.Intranet.Services.IntranetDataService Data
@inject AuthenticationStateProvider Authentication
<PageTitle>Izvozi</PageTitle>
<div class="page-header"><div><h1>Izvozi</h1><p>Odhodna sporočila in dejansko stanje dostave. Odobritev sporočilo samo uvrsti v čakalno vrsto.</p></div></div>
<nav class="page-tabs" aria-label="Pogledi izmenjave podatkov"><a class="page-tab" href="teki-obdelave">Uvozi</a><span class="page-tab active" aria-current="page">Vsi izvozi</span></nav>
@if (Rows is not null) {
  <section class="kpi-grid" aria-labelledby="outbound-kpi-title">
    <h2 id="outbound-kpi-title" class="visually-hidden">Hitri pregled izvozov</h2>
    <article class="ui-card kpi"><span>Čaka na odobritev</span><strong>@(Rows.Count(x=>x.Status=="PendingApproval").ToString("N0"))</strong><span class="kpi-share">@Share(Rows.Count(x=>x.Status=="PendingApproval"))</span></article>
    <article class="ui-card kpi"><span>V čakalni vrsti</span><strong>@(Rows.Count(x=>x.Status is "Pending" or "Retry").ToString("N0"))</strong><span class="kpi-share">@Share(Rows.Count(x=>x.Status is "Pending" or "Retry"))</span></article>
    <article class="ui-card kpi"><span>Napake dostave</span><strong>@(Rows.Count(x=>x.Status is "Error" or "Dead").ToString("N0"))</strong><span class="kpi-share">@Share(Rows.Count(x=>x.Status is "Error" or "Dead"))</span></article>
    <article class="ui-card kpi"><span>Zaznani odkloni</span><strong>@(Rows.Count(x=>x.DriftDetail is not null).ToString("N0"))</strong><span class="kpi-share">@Share(Rows.Count(x=>x.DriftDetail is not null))</span></article>
  </section> }
<section class="ui-card toolbar" role="search" aria-labelledby="outbound-filter-title">
  <h2 id="outbound-filter-title" class="visually-hidden">Filtriranje izvozov</h2>
  <label class="visually-hidden" for="out-search">Poišči izvoz</label><input id="out-search" type="search" class="search-input" placeholder="Poišči cilj, entiteto ali ključ …" @bind="Search" @bind:event="oninput" />
  <label class="visually-hidden" for="out-status">Status</label><select id="out-status" class="filter-select" @bind="StatusFilter"><option value="">Vsi statusi</option>@foreach (var status in Statuses) { <option>@status</option> }</select>
  <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>
</section>
<section class="ui-card data-card" aria-label="Seznam odhodnih sporočil">
@if (Loading) { <div class="loading-state" role="status">Nalaganje izvozov …</div> }
else if (Error is not null) { <div class="error-state" role="alert">@Error</div> }
else if (Filtered.Count == 0) { <div class="empty-state">Ni izvozov za izbrane filtre.</div> }
else {
  <div class="table-scroll" role="region" tabindex="0" aria-label="Tabela odhodnih sporočil">
    <p class="visually-hidden">Dedup ključ preprečuje podvojeno aktivno odhodno sporočilo z enakim kanoničnim payloadom.</p>
    <table class="data-table"><caption>Odhodna sporočila aktivne organizacije</caption><thead><tr><th scope="col">Cilj</th><th scope="col">Operacija</th><th scope="col">Entiteta</th><th scope="col">Polja</th><th scope="col">Status</th><th scope="col" class="numeric">Poskusi</th><th scope="col">Naslednji poskus</th><th scope="col">Odziv</th><th scope="col">Odklon</th><th scope="col">Dejanja</th></tr></thead><tbody>@foreach (var row in PageRows) { <tr><td>@row.TargetKind</td><td>@row.Operation</td><td>@row.EntityType / @row.EntityKey</td><td>@row.FieldSummary</td><td><span class="status-chip @Chip(row.Status)"><span class="visually-hidden">Status: </span>@row.Status</span></td><td class="numeric">@row.AttemptCount.ToString("N0")</td><td>@(row.NextAttemptUtc?.ToLocalTime().ToString("g") ?? "—")</td><td>@ResponseSummary(row)</td><td>@if (row.DriftDetail is not null) { <span class="drift-flag">@row.DriftDetail</span> } else { <text>—</text> }</td><td><div class="table-actions">@if (row.Status=="PendingApproval") { <button type="button" class="small-action good-action" disabled="@ActionBusy" aria-label="Odobri sporočilo @row.EntityType @row.EntityKey" @onclick="()=>Approve(row.OutboxMessageId)">Odobri</button> }@if (row.Status is "PendingApproval" or "Pending" or "Error" or "Retry") { <button type="button" class="small-action" disabled="@ActionBusy" aria-label="Prekliči sporočilo @row.EntityType @row.EntityKey" @onclick="()=>Cancel(row.OutboxMessageId)">Prekliči</button> }@if (row.Status is "Error" or "Dead") { <button type="button" class="small-action warn-action" disabled="@ActionBusy" aria-label="Ponovi sporočilo @row.EntityType @row.EntityKey" @onclick="()=>Retry(row.OutboxMessageId)">Ponovi</button> }</div></td></tr> }</tbody></table>
  </div>
  <nav class="pagination" aria-label="Strani naloženih izvozov"><button type="button" disabled="@(CurrentPage==0)" @onclick="Previous">Prejšnja</button><span class="page-position">Stran @(CurrentPage+1) od @PageCount</span><button type="button" disabled="@(CurrentPage+1>=PageCount)" @onclick="Next">Naslednja</button></nav> }
</section>
@if (Message is not null) { <p class="message-state success-message" role="status">@Message</p> }
@code{int? OrganizationId;IReadOnlyList<PIM.Intranet.Services.OutboundRow>? Rows;bool Loading=true,ActionBusy;string? Message,Error;string Search="",StatusFilter="";int Page;const int PageSize=10;IReadOnlyList<PIM.Intranet.Services.OutboundRow> Filtered=>(Rows??[]).Where(x=>(StatusFilter==""||x.Status==StatusFilter)&&(Search==""||x.TargetKind.Contains(Search,StringComparison.OrdinalIgnoreCase)||x.EntityType.Contains(Search,StringComparison.OrdinalIgnoreCase)||x.EntityKey.Contains(Search,StringComparison.OrdinalIgnoreCase))).ToList();IEnumerable<PIM.Intranet.Services.OutboundRow> PageRows=>Filtered.Skip(CurrentPage*PageSize).Take(PageSize);IEnumerable<string> Statuses=>(Rows??[]).Select(x=>x.Status).Distinct().Order();int PageCount=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/(decimal)PageSize));
  // Po zožitvi filtra je lahko izbrana stran izven obsega; izpiše se zadnja obstoječa, ne prazna.
  int CurrentPage => Math.Min(Page, PageCount - 1);
  void Previous()=>Page=Math.Max(0,CurrentPage-1);void Next()=>Page=Math.Min(PageCount-1,CurrentPage+1);
  protected override async Task OnInitializedAsync(){try{var org=await Data.GetCurrentOrganizationAsync();if(org is null){Error="Aktivna organizacija ni na voljo.";return;}OrganizationId=org.OrganizationId;await Reload();}catch{Error="Izvozov trenutno ni mogoče naložiti.";}finally{Loading=false;}}async Task Reload(){if(OrganizationId is not null)Rows=await Data.GetOutboundAsync(OrganizationId.Value);}async Task<string> Actor(){var state=await Authentication.GetAuthenticationStateAsync();return state.User.Identity?.Name??"neznan";}async Task Act(Func<string,Task> action,string success){ActionBusy=true;Error=null;Message=null;try{await action(await Actor());Message=success;await Reload();}catch{Error="Dejanja trenutno ni mogoče izvesti. Sprememba stanja ni potrjena.";}finally{ActionBusy=false;}}Task Approve(long id)=>Act(actor=>Data.ApproveOutboundAsync(id,actor),"Sporočilo je odobreno.");Task Cancel(long id)=>Act(actor=>Data.CancelOutboundAsync(id,actor),"Sporočilo je preklicano.");Task Retry(long id)=>Act(actor=>Data.RetryOutboundAsync(id,actor),"Sporočilo je pripravljeno za ponovni poskus.");static string Chip(string value)=>value is "Succeeded" or "Sent" or "Completed"?"good":value is "Error" or "Dead" or "Drift" or "Cancelled"?"bad":"warn";
  // Živo stanje seznama: bralcu zaslona se sporoči nalaganje, napaka ali dejansko število rezultatov.
  string ResultSummary=>Loading?"Nalaganje …":Error is not null?"Rezultati niso na voljo":$"{Filtered.Count} rezultatov";
  // Delež je izpeljan iz istega nabora vrstic; brez vrstic ni imenovalca in se zato ne prikaže.
  string Share(int count)=>Rows is null||Rows.Count == 0?"—":$"{((decimal)count*100/Rows.Count).ToString("0.#")} % sporočil";
  // Odziv sestavljata koda in korelacijski ključ; kadar ju procedura ne vrne, ostane celica pošteno prazna.
  static string ResponseSummary(PIM.Intranet.Services.OutboundRow row){var parts=new[]{row.ResponseStatusCode?.ToString(System.Globalization.CultureInfo.InvariantCulture),row.ResponseCorrelationId}.Where(x=>!string.IsNullOrWhiteSpace(x)).ToArray();return parts.Length==0?"—":string.Join(" ",parts);}}
