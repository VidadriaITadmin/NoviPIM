@page "/outbound"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@inject PIM.Intranet.Services.IntranetDataService Data
@inject AuthenticationStateProvider Authentication

<PageTitle>Odhodna pošta</PageTitle>
<h1>Odhodna pošta ERP</h1>
<p>Pošiljanje izvaja samo dispatcher. Odobritev sporočilo uvrsti v čakalno vrsto in ne kliče ERP neposredno.</p>
@if (Rows is null)
{
  <p>Nalaganje …</p>
}
else if (Rows.Count == 0)
{
  <p>Ni odhodnih sporočil.</p>
}
else
{
  <table class="table table-sm">
    <thead><tr><th>Cilj</th><th>Operacija</th><th>Entiteta</th><th>Polja</th><th>Dedup ključ</th><th>Stanje</th><th>Poskusi</th><th>Naslednji poskus</th><th>Odziv</th><th>Odklon</th><th>Dejanja</th></tr></thead>
    <tbody>
    @foreach (var row in Rows)
    {
      <tr>
        <td>@row.TargetKind</td><td>@row.Operation</td><td>@row.EntityType / @row.EntityKey</td><td>@row.FieldSummary</td>
        <td><small>@row.DedupKey</small></td><td>@row.Status</td><td>@row.AttemptCount</td><td>@row.NextAttemptUtc?.ToLocalTime()</td>
        <td>@row.ResponseStatusCode @row.ResponseCorrelationId</td><td>@row.DriftDetail</td>
        <td>
          @if (row.Status == "PendingApproval") { <button class="btn btn-sm btn-success" @onclick="()=>Approve(row.OutboxMessageId)">Odobri</button> }
          @if (row.Status is "PendingApproval" or "Pending" or "Error" or "Retry") { <button class="btn btn-sm btn-secondary" @onclick="()=>Cancel(row.OutboxMessageId)">Prekliči</button> }
          @if (row.Status is "Error" or "Dead") { <button class="btn btn-sm btn-warning" @onclick="()=>Retry(row.OutboxMessageId)">Ponovi</button> }
        </td>
      </tr>
    }
    </tbody>
  </table>
}
@if (!string.IsNullOrWhiteSpace(Message)) { <p class="alert alert-info">@Message</p> }

@code {
  const int OrganizationId = 2;
  IReadOnlyList<PIM.Intranet.Services.OutboundRow>? Rows;
  string? Message;
  protected override async Task OnInitializedAsync() => await Reload();
  async Task<string> Actor() { var state=await Authentication.GetAuthenticationStateAsync();return state.User.Identity?.Name??"neznan"; }
  async Task Reload() => Rows=await Data.GetOutboundAsync(OrganizationId);
  async Task Approve(long id) { await Data.ApproveOutboundAsync(id,await Actor());Message="Sporočilo je odobreno.";await Reload(); }
  async Task Cancel(long id) { await Data.CancelOutboundAsync(id,await Actor());Message="Sporočilo je preklicano.";await Reload(); }
  async Task Retry(long id) { await Data.RetryOutboundAsync(id,await Actor());Message="Sporočilo je pripravljeno za ponovni poskus.";await Reload(); }
}
