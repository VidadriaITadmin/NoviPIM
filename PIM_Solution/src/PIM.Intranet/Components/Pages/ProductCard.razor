    .Where(option => Detail?.Attributes.Any(row => string.Equals(row.AttributeCode, option.Name, StringComparison.OrdinalIgnoreCase)) != true
      && !AddedAttributes.Contains(option.Name, StringComparer.OrdinalIgnoreCase))
    .Select(option => new PimPickerOption(option.Name, option.Name,
      InAttributeSet(option.Name) ? "v naboru kategorije — gre na splet" : "izven nabora kategorije — ne gre na splet",
      Badge: InAttributeSet(option.Name) ? "nabor" : null))
    .ToList();

  bool InAttributeSet(string name) => AttributeSet.Any(row => row.Level != "EXCLUDED" && string.Equals(row.AttributeName, name, StringComparison.OrdinalIgnoreCase));

  void AddPickedAttribute()
  {
    if (string.IsNullOrWhiteSpace(PickedAttribute)) return;
    if (!AddedAttributes.Contains(PickedAttribute, StringComparer.OrdinalIgnoreCase)) AddedAttributes.Add(PickedAttribute);
    PickedAttribute = null;
  }

