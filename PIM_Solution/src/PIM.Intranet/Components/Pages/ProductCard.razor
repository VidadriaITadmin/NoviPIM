  /// <summary>
  /// »Obvezno« samo, kadar polje ima odprto NAPAKO. Uporabnik 2026-09-25: garancija je v profilu
  /// opozorilo, kartica pa jo je rdeče kazala kot obvezno — prej je štela vsaka težava, tudi opozorilo.
  /// </summary>
  /// 2026-09-28: in samo, kadar napaka res USTAVI objavo (profil blokira ERP ali splet). Napaka v
  /// komercialnem profilu (COMMERCIAL_L2, npr. Pak1) ne ustavi ničesar — kartica jo je kazala rdeče kot
  /// »obvezno«, povzetek pa je rekel, da je vse izpolnjeno. Zdaj je taka napaka »priporočeno«.
  /// </summary>
  bool RequiredField(string fieldKey) => FieldHasIssue(fieldKey, issue => issue.Severity == "ERROR" && (issue.BlocksErp || issue.BlocksWeb));

  /// <summary>Polje ima težavo, ki objave ne ustavi (opozorilo ali neblokirajoča napaka): priporočeno.</summary>
  bool RecommendedField(string fieldKey) => !RequiredField(fieldKey) && FieldHasIssue(fieldKey, _ => true);

  bool FieldHasIssue(string fieldKey, Func<ProductCardIssue, bool> match) => Detail?.Issues.Any(issue =>
    string.Equals(issue.FieldCode, fieldKey, StringComparison.OrdinalIgnoreCase) && match(issue)) == true;

  /// <summary>
  /// Prazno po istem pravilu kot validacija (249): 0 v številskem polju ProductCommercial.* šteje za
  /// prazno. Kartica je sicer kazala »0,00« kot vpisano, validacija pa je javljala, da polje manjka.
  /// </summary>
  static bool IsEmptyValue(string fieldKey, string? value) =>
    string.IsNullOrWhiteSpace(value)
    || (fieldKey.StartsWith("ProductCommercial.", StringComparison.OrdinalIgnoreCase)
        && decimal.TryParse(value.Replace(" ", "").Replace(',', '.'), System.Globalization.NumberStyles.Number,
             System.Globalization.CultureInfo.InvariantCulture, out var number) && number == 0);

  /// <summary>Polje kanala; ce je pisljivo v SAOP, je urejivo prek odhodne vrste, sicer samo prikaz.</summary>
  ProductChannelField Channel(string label, string fieldKey, string? value, string group, bool inReadModel = true)
  {
    var writable = Writable(fieldKey);
    var stored = Detail?.Fields.FirstOrDefault(row => row.FieldKey == fieldKey);
    var resolved = PendingValue(fieldKey) ?? value ?? stored?.Value;
    // Logično polje se na kartici vedno izpiše Da / Ne (uporabnik 2026-09-22), tudi kadar vrednost
    // pride kot 1/0 ali D/N — iz čakajočega sporočila (uvoz iz Excela pošlje 1/0) ali iz bralnega modela.
    if (FormatOf(writable) == "bool" && PIM.Operations.ProductWorkbookContract.ParseYesNo(resolved) is { } flag)
      resolved = YesNo(flag);
    return new(label, fieldKey, resolved, stored?.Owner ?? (writable is null ? "—" : "PIM"), null, null,
      Pending(fieldKey), inReadModel,
      writable is null ? ProductFieldEdit.None : ProductFieldEdit.Saop, FormatOf(writable),
      RequiredField(fieldKey), IsEmptyValue(fieldKey, resolved),
      Hint: group, Recommended: RecommendedField(fieldKey),
      LockReason: writable is null ? LockReasonFor(fieldKey) : null, PendingStatus: LiveOverlay(fieldKey)?.Status);
  }

  /// <summary>
  /// Zakaj polja ni mogoče urediti na kartici in kje se ureja. Uporabnik 2026-09-28: »nič zaklepat« —
  /// zaklenjeno ostane samo tisto, česar PIM ne sme ali ne more zapisati, in vedno z razlogom.
  /// </summary>
  static string LockReasonFor(string fieldKey) => fieldKey switch
  {
    "Product.ItemID" => "Šifra je ključ artikla v SAOP in PIM in se ne spreminja. Za drugo šifro se v SAOP odpre nov artikel.",
    "Product.HasSeries" => "Sledenje serij vpliva na zalogo, zato se nastavi samo v SAOP; PIM ga prebere ob zajemu.",
    _ when fieldKey.StartsWith("ProductPrice.", StringComparison.OrdinalIgnoreCase) => "Cene se urejajo na strani Cene.",
    _ when fieldKey.StartsWith("ProductMedia", StringComparison.OrdinalIgnoreCase) => "Slike in dokumente dodaš na zavihku Mediji.",
    _ when fieldKey.StartsWith("ProductCategory", StringComparison.OrdinalIgnoreCase) => "Kategorijo izbereš v razdelku Kategorije na zavihku Splet.",
    _ => "SAOP tega polja od PIM ne sprejme in PIM zanj nima svojega zapisa; spremeni ga v SAOP.",
  };

  /// <summary>
  /// Besedilo izdelka. Pot izbere register: kar je v out.SaopXmlField (ERP naziv sl, naziv 2 sl, ime za
  /// iskanje), gre v PIM takoj in v SAOP po odobritvi; ostalo gre v PIM. ERP besedila, ki jih SAOP od PIM
  /// ne sprejme (opisi, nazivi v drugih jezikih, kratki naziv), so od 2026-09-28 urejiva (uporabnik: »nič
  /// zaklepat«) in označena, da jih zajem iz SAOP lahko prepiše — prej (239) so bila samo prikaz.
  /// </summary>
  ProductChannelField TextField(string label, string textType, string language, string? value, string group)
  {
    var fieldKey = $"ProductText.{textType}.{language}";
    var writable = Writable(fieldKey);
    var stored = Detail?.Texts.FirstOrDefault(row => row.TextType == textType && row.Language == language);
    var resolved = PendingValue(fieldKey) ?? value ?? stored?.Value;
    var multiline = textType.Contains("DESCRIPTION", StringComparison.OrdinalIgnoreCase);
    var edit = writable is null ? ProductFieldEdit.Text : ProductFieldEdit.Saop;
    var format = writable is null && multiline ? "multiline" : FormatOf(writable);
    var fromSaop = writable is null && ProductFieldLabels.IsErpTextType(textType);
    return new(label, fieldKey, resolved, stored?.Owner ?? (fromSaop || writable is not null ? "SAOP" : "PIM"), null, null,
      Pending(fieldKey), true, edit, format,
      RequiredField(fieldKey), string.IsNullOrWhiteSpace(resolved),
      Language: language, TextType: textType, Hint: group, Recommended: RecommendedField(fieldKey),
      SaopOrigin: fromSaop, PendingStatus: LiveOverlay(fieldKey)?.Status);
  }

  /// <summary>
  /// Lastnost izdelka. Pot izbere register (2026-09-28): atribut, ki ga SAOP sprejme (Garancija → Warranty),
  /// gre tudi s tega zavihka v PIM takoj in v SAOP po odobritvi — prej je šel s Spleta samo v PIM, z ERP
