  /// <summary>
  /// Polja, ki jih izdelek DEJANSKO ima, pa jih pripravljen seznam kanala ne nasteje.
  ///
  /// Uporabnik 2026-08-31: »Treba bo izpisati vsa polja ki jih ima in potem omogociti
  /// spremembo.« Prej je kartica kazala pripravljen seznam polj in manjkajoce zahteve; kar je
  /// vir poslal poleg tega, je bilo v bazi, na zaslonu pa ne. Zdaj se vsako shranjeno polje
  /// kanala pokaze — tudi tisto, ki ga nihce ni predvidel. Urejanje ostane po istem pravilu
  /// kot pri ostalih poljih: kar je pisljivo v SAOP, je urejivo prek odhodne vrste.
  /// </summary>
  IEnumerable<ProductChannelField> StoredFields(IReadOnlyList<ProductChannelField> known, string prefix, string group)
  {
    if (Detail is null) yield break;
    foreach (var stored in Detail.Fields
      .Where(row => row.FieldKey.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
      .OrderBy(row => row.FieldKey, StringComparer.OrdinalIgnoreCase))
    {
      if (known.Any(row => string.Equals(row.FieldKey, stored.FieldKey, StringComparison.OrdinalIgnoreCase))) continue;
      // Logična polja brez registra (Product.HasSeries) bi sicer kazala golo 1/0.
      var value = stored.FieldKey == "Product.HasSeries" ? ActivityValue(stored.Value) : stored.Value;
      yield return Channel(FieldLabel(stored.FieldKey), stored.FieldKey, value, group);
    }
  }

  /// <summary>Manjkajoca obvezna polja tega kanala, ki jih seznam zgoraj se ne pokriva.</summary>
  IEnumerable<ProductChannelField> MissingRequired(IReadOnlyList<ProductChannelField> known, string prefix, string group)
  {
    if (Detail is null) yield break;
    foreach (var code in Detail.Issues
      .Select(issue => issue.FieldCode)
      .Where(code => code.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
      .Distinct(StringComparer.OrdinalIgnoreCase)
      .OrderBy(code => code, StringComparer.OrdinalIgnoreCase))
    {
      if (known.Any(row => string.Equals(row.FieldKey, code, StringComparison.OrdinalIgnoreCase))) continue;
      var parts = code.Split('.');
      if (code.StartsWith("ProductText.", StringComparison.OrdinalIgnoreCase) && parts.Length >= 3)
        yield return TextField($"{TextLabel(parts[1])} ({parts[2]})", parts[1], parts[2], null, group);
      else if (code.StartsWith("ProductAttribute.", StringComparison.OrdinalIgnoreCase) && parts.Length >= 2)
        yield return AttributeField(string.Join('.', parts.Skip(1)), null, group);
      else
        yield return Channel(FieldLabel(code), code, null, group);
    }
  }

  /// <summary>
  /// Partner na kartici: ime in sifra skupaj. Uporabnik 2026-08-28: »treba se dodati ime
  /// dobavitleja in proizvajalca, da se oboje vidi ime in kodo«. Sifra ostane, ker gre ona
  /// nazaj v SAOP; kadar imena za sifro ni, ostane sama sifra — izmisljati je ne gre.
  /// </summary>
  static string? PartnerValue(string? code, string? name) =>
    string.IsNullOrWhiteSpace(code) ? null
    : string.IsNullOrWhiteSpace(name) ? code
    : $"{name} ({code})";

  /// <summary>Eno mesto za imena vrst besedil (kartica, kakovost, AI) — ProductFieldLabels.</summary>
  static string TextLabel(string textType) => ProductFieldLabels.TextTypeLabel(textType);

  static string FieldLabel(string fieldKey) => fieldKey switch
  {
    "Product.ItemID" => "Šifra artikla",
    "Product.EAN" => "EAN",
    "Product.UoM" => "Merska enota",
    "Product.ItemGroup" => "Skupina artikla",
    "Product.Department" => "ABC klasifikacija",
    "Product.DiscountGroup" => "Skupina popusta",
    "Product.AccountingGroup" => "Knjižna skupina",
    "Product.Supplier" => "Dobavitelj",
    "Product.Manufacturer" => "Proizvajalec",
    "Product.IsActive" => "Aktiven",
    "Product.WebPublish" => "Objava na spletu",
    "Product.VatRateId" => "Davčna stopnja (šifra SAOP)",
    "Product.PriceListCode" => "Cenik (SAOP dodatna lastnost 4)",
    "Product.HasSeries" => "Sledenje serij",
    "ProductAttribute.Garancija" => "Garancija",
    "ProductCommercial.NetWeight" => "Neto teža",
    "ProductCommercial.GrossWeight" => "Bruto teža",
    "ProductCommercial.CustomsTariff" => "Carinska tarifa",
    "ProductCommercial.CountryOfOrigin" => "Država porekla",
    "ProductCommercial.Dimensions" => "Dimenzije",
    "ProductCommercial.Volume" => "Volumen",
    "ProductCommercial.PackageLength" => "Dolžina paketa",
    "ProductCommercial.PackageWidth" => "Širina paketa",
    "ProductCommercial.PackageHeight" => "Višina paketa",
    "ProductCommercial.DimensionUnit" => "Enota mer",
    "ProductCommercial.Pak1" => "Pakiranje 1",
    "ProductCommercial.Pak2" => "Pakiranje 2",
    _ => fieldKey,
  };

  /// <summary>
  /// ERP kanal — kar gre v SAOP. Razdelitev na kanale je prevzeta iz starega intraneta
  /// PIM_test (`ProductCatalogEditorSections.razor`, kartice »ERP — Slovenija«,
  /// »ERP — EU / tretje države«, »Pakiranje«, »Dimenzije pakiranja«), ker je bila tam
  /// poslovno preverjena: ERP nosi identiteto, sifrante ERP, partnerja, davek, nazive za
  /// ERP ter logistiko, ki jo zahteva izvoz (teze, tarifa, poreklo, pakiranje, dimenzije).
  /// Uvrstitev artikla in objava sta komercialni odlocitvi in sta zato na svojem kanalu.
  /// </summary>
  IReadOnlyList<ProductChannelField> ErpFields
  {
    get
    {
      if (Detail is null) return [];
      const string slovenia = "ERP — Slovenija";
      const string extra = "Dodatno (ERP iskanje, drugi naziv)";
      const string names = "Nazivi za ERP po jezikih";
      const string export = "ERP — EU / tretje države";
      const string packaging = "Pakiranje";
      const string dimensions = "Dimenzije pakiranja";
      var commercial = Detail.Commercial;
      var rows = new List<ProductChannelField>
      {
        Channel("Šifra artikla", "Product.ItemID", Detail.Header.ItemId, slovenia),
        Channel("EAN", "Product.EAN", Detail.Header.Ean, slovenia),
        TextField("ERP naziv (sl)", "TITLE_ERP", "sl", null, slovenia),
        Channel("Knjižna skupina", "Product.AccountingGroup", Detail.Header.AccountingGroup, slovenia),
        Channel("Skupina popusta", "Product.DiscountGroup", Detail.Header.DiscountGroup, slovenia),
        Channel("Merska enota", "Product.UoM", Detail.Header.Uom, slovenia),
        Channel("Dobavitelj", "Product.Supplier", PartnerValue(Detail.Header.Supplier, Detail.Header.SupplierName), slovenia),
        Channel("Proizvajalec", "Product.Manufacturer", PartnerValue(Detail.Header.Manufacturer, Detail.Header.ManufacturerName), slovenia),
        // 2026-09-28: kartica je iskala »Product.VatRate«, register in zajem pa poznata Product.VatRateId
        // (SAOP VATRateID) — zato je polje stalo prazno »ni v bralnem modelu«, vrednost pa je bila v bazi.
        Channel("Davčna stopnja (šifra SAOP)", "Product.VatRateId", VatRateId, slovenia),
        // Ključ iz registra SAOP (ItemExcludeQtyReservation). Prej »ProductPlanning« brez vrednosti:
        // polje ni bilo v registru, zato ga ni bilo mogoče urediti, in kazalo je »ni v bralnem modelu«.
        Channel("Izloči iz rezervacije zaloge", "Planning.ExcludeQtyReservation", YesNo(ReservationExcluded), slovenia),
        Channel("Garancija", "ProductAttribute.Garancija",
          StoredAttributeValue("Garancija"), slovenia),

        TextField("ERP naziv 2 (sl)", "TITLE_ERP2", "sl", null, extra),
        TextField("Ime za iskanje", "SEARCH_NAME", "sl", null, extra),
        // 239: kratki naziv iz SAOP je ERP polje; do zdaj je brez oznake pristal med spletnimi besedili.
        TextField("ERP kratki naziv (sl)", "TITLE_SHORT", "sl", null, extra),

        // Za izvoz so obvezna se logisticna polja — v PIM_test svoja kartica, tu svoja skupina.
        Channel("Neto teža", "ProductCommercial.NetWeight", Number(commercial?.NetWeight), export),
        Channel("Bruto teža", "ProductCommercial.GrossWeight", Number(commercial?.GrossWeight), export),
        Channel("Carinska / tarifna oznaka", "ProductCommercial.CustomsTariff", commercial?.CustomsTariff, export),
        Channel("Država porekla", "ProductCommercial.CountryOfOrigin", commercial?.CountryOfOrigin, export),

        Channel("Količina pakiranja", "ProductCommercial.Pak1", Number(commercial?.Pak1), packaging),
        // »Kosov v paketu« (Product.PiecesInPackage) je bil prazen okvir brez podatka v bazi in brez polja
        // v SAOP — odstranjen 2026-09-28; količina v paketu je Količina pakiranja (ItemQuantityOfPackaging).
        Channel("Količina pakiranja (2)", "ProductCommercial.Pak2", Number(commercial?.Pak2), packaging),

        Channel("Dolžina", "ProductCommercial.PackageLength", Number(commercial?.PackageLength), dimensions),
        Channel("Širina", "ProductCommercial.PackageWidth", Number(commercial?.PackageWidth), dimensions),
        Channel("Višina", "ProductCommercial.PackageHeight", Number(commercial?.PackageHeight), dimensions),
        Channel("Enota mer", "ProductCommercial.DimensionUnit", commercial?.DimensionUnit, dimensions),
        Channel("Prostornina", "ProductCommercial.Volume", Number(commercial?.Volume), dimensions),
        // »Dimenzije artikla« (ProductCommercial.Dimensions) odstranjeno 2026-09-28: 0 artiklov z vrednostjo,
        // polja ni v SAOP in PIM ga ne zna zapisati — bil je zaklenjen prazen okvir. Če ga bo kdaj zahtevala
        // validacija, se pojavi v skupini »Manjka za ERP« (MissingRequired).
      };

      // Slovenski naziv in naziv 2 sta ze zgoraj; tu so preostali jeziki, da se manjkajoc
      // prevod da vpisati tudi tam, kjer ga nihce ne zahteva.
      foreach (var language in ErpLanguages.Where(code => !string.Equals(code, "sl", StringComparison.OrdinalIgnoreCase)))
      {
        rows.Add(TextField($"ERP naziv ({language})", "TITLE_ERP", language, null, names));
        rows.Add(TextField($"ERP naziv 2 ({language})", "TITLE_ERP2", language, null, names));
      }

      // 239: opisi iz SAOP po jezikih in vrstah (DESCRIPTION_ERP, _K, _O ...). Uporabnik 2026-09-21: »ERP
      // opisi se pojavijo na kartici pod Splet – opisi«; zdaj imajo svoje mesto na ERP kanalu, spletni opis
      // na zavihku Splet pa je last PIM-a. Od 2026-09-28 urejivi, z oznako »samo PIM« (SAOP jih ne sprejme).
      const string erpDescriptions = "Opisi iz ERP (SAOP)";
      var erpDescriptionTypes = Detail.Texts.Select(row => row.TextType)
        .Where(type => type.StartsWith("DESCRIPTION_ERP", StringComparison.OrdinalIgnoreCase))
        .Append("DESCRIPTION_ERP")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(type => string.Equals(type, "DESCRIPTION_ERP", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
        .ThenBy(type => type, StringComparer.Ordinal);
      foreach (var type in erpDescriptionTypes)
      {
        var languages = PimLanguages.Order(Detail.Texts.Where(row => string.Equals(row.TextType, type, StringComparison.OrdinalIgnoreCase)).Select(row => row.Language).Append("sl"));
        foreach (var language in languages)
          rows.Add(TextField($"{TextLabel(type)} ({language})", type, language, null, erpDescriptions));
      }

      // Kanonicne kode ProductCommercial.* zdaj zivijo tu, zato se tu tudi dopolnita
      // seznam shranjenih polj in seznam manjkajocih zahtev.
      // Polja zavihka Komerciala se tu ne ponovijo: isti ključ na dveh zavihkih bi pomenil dve okenci
      // za eno vrednost in dvakrat štet »prazno« v povzetku.
      var onCommercial = CommercialFields;
      rows.AddRange(StoredFields(rows.Concat(onCommercial).ToList(), "Product.", "Druga polja iz vira"));
      rows.AddRange(StoredFields(rows, "ProductCommercial.", "Druga polja iz vira"));
      rows.AddRange(StoredFields(rows, "ProductText.", "Druga besedila iz ERP").Where(stored => ProductFieldLabels.IsErpTextType(TextTypeOf(stored.FieldKey))));
      rows.AddRange(MissingRequired(rows.Concat(onCommercial).ToList(), "Product.", "Manjka za ERP"));
      rows.AddRange(MissingRequired(rows, "ProductCommercial.", "Manjka za ERP"));
      return rows;
    }
  }

  /// <summary>
  /// Komercialni kanal — uvrstitev artikla, objava in nabavni pogoji. V PIM_test je bila to
  /// kartica »Komerciala — klasifikacija in objava«: ABC klasifikacija in skupina artikla sta
  /// komercialni razvrstitvi, ne sifranta ERP, aktivnost pa je prodajna odlocitev. Cene in
  /// zaloga imata v tem intranetu svoje strani in svoj zavihek, zato ju tu ni.
  /// </summary>
  IReadOnlyList<ProductChannelField> CommercialFields
  {
    get
    {
      if (Detail is null) return [];
      const string classification = "Klasifikacija in objava";
      var rows = new List<ProductChannelField>
      {
        Channel("ABC klasifikacija", "Product.Department", Detail.Header.Department, classification),
        Channel("Rabatna / skupina artikla", "Product.ItemGroup", Detail.Header.ItemGroup, classification),
        Channel("Aktivnost", "Product.IsActive", YesNo(Detail.Header.IsActive), classification),
        // D2/182: SAOP polje, ne pove vec "kam gre izdelek" (to dolocajo kljukice na zavihku
        // Splet > Spletisca) — zato tu, med ostalimi SAOP/ERP polji, ne na zavihku Splet.
        Channel("Objava na spletu (SAOP)", "Product.WebPublish", YesNo(Detail.Header.WebPublish), classification),
      };

      // 2026-09-28 odstranjeno: »Nabavni podatki« (prazen okvir brez podatka), »Knjigovodske šifre«
      // (ista vrednost kot Knjižna skupina na zavihku ERP) in »Cenovna polja« (prva od več cen, brez
      // cenika) — cene so v tabeli Cene spodaj, s cenikom in veljavnostjo.
      return rows;
    }
  }

  IReadOnlyList<ProductChannelField> WebFields
  {
    get
    {
      if (Detail is null) return [];
      const string titles = "Nazivi in opisi";
      const string attributes = "Atributi";
      var rows = new List<ProductChannelField>();

      // Nazivi in opisi po jezikih: prikazani so vsi jeziki spletnih kanalov, tudi tam, kjer
      // besedila se ni — sicer manjkajocega prevoda ni mogoce vpisati.
      foreach (var textType in WebTextTypes)
        foreach (var language in WebLanguages)
        {
          var textField = TextField($"{TextLabel(textType)} ({language})", textType, language, null, titles);
          // 239: do locitve je SAOP ob vsakem zajemu prepisal spletni opis z ERP opisom; kjer je
          // spletni opis se vedno dobesedna kopija, je to oznaceno, da urednik ve, da spletnega
          // besedila se ni (AI predlog ali rocni vnos ju locita).
          if (string.Equals(textType, "DESCRIPTION", StringComparison.OrdinalIgnoreCase) && SameAsErpDescription(language, textField.Value))
            textField = textField with { Label = textField.Label + " · enak ERP opisu" };
          rows.Add(textField);
        }

      // 2026-09-28: kategorije, število slik in spletni kanali so bili tu kot zaklenjena polja. Kategorije
      // se zdaj urejajo v razdelku pod polji (ProductCategoryEditor), slike na zavihku Mediji, spletišča
      // pa v razdelku Spletišča — isto vrednost dvakrat, enkrat zaklenjeno, je uporabnik bral kot »ne da se«.

      // Nabor atributov po kategoriji (147). Ce kategorija izdelka nabor doloca, so atributi iz
      // nabora v svoji skupini (tudi tisti brez vrednosti, da jih je mogoce vpisati), ostali pa
      // ostanejo vidni v skupini "izven nabora" — na splet ne gredo (out.GetExportRows).
      var inSet = AttributeSet
        .Where(row => row.Level != "EXCLUDED")
        .GroupBy(row => row.AttributeName, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);
      if (inSet.Count > 0)
      {
        const string categorySet = "Atributi kategorije (nabor)";
        const string outsideSet = "Atributi izven nabora — ne gredo na splet";
        foreach (var setRow in inSet.Values.OrderBy(row => row.Level == "REQUIRED" ? 0 : 1).ThenBy(row => row.AttributeName, StringComparer.CurrentCulture))
        {
          rows.AddRange(AttributeFields(setRow.AttributeName, StoredAttributes(setRow.AttributeName), categorySet,
            $"{setRow.AttributeName} ({(setRow.Level == "REQUIRED" ? "obvezen" : "priporočen")})", setRow.Level == "REQUIRED"));
        }
        // 116: po kodi združeno — prevedljiv atribut ima vrstico na jezik z istim ključem polja.
        foreach (var group in Detail.Attributes
          .Where(row => !inSet.ContainsKey(row.AttributeCode))
          .GroupBy(row => row.AttributeCode, StringComparer.OrdinalIgnoreCase)
          .OrderBy(group => group.Key, StringComparer.CurrentCulture))
          rows.AddRange(AttributeFields(group.Key, group.ToList(), outsideSet));
      }
      else
      {
        foreach (var group in Detail.Attributes
          .GroupBy(row => row.AttributeCode, StringComparer.OrdinalIgnoreCase)
          .OrderBy(group => group.Key, StringComparer.CurrentCulture))
          rows.AddRange(AttributeFields(group.Key, group.ToList(), attributes));
      }

      // »Dodaj atribut« (2026-09-28): atribut, ki ga izdelek še nima in ga nabor ne predvideva, dobi prazno
      // okence; shrani se z istim gumbom kot vsaka druga sprememba. Kar ni v naboru, na splet ne gre.
      foreach (var name in AddedAttributes.Where(name => rows.All(row => !string.Equals(row.AttributeCode, name, StringComparison.OrdinalIgnoreCase))))
        rows.Add(AttributeField(name, null, inSet.Count > 0 && !inSet.ContainsKey(name) ? "Dodani atributi — izven nabora, ne gredo na splet" : "Dodani atributi"));

      // 239: kar je last ERP-ja (nazivi ERP, kratki naziv, ime za iskanje, ERP opisi), ima svoje
      // mesto na ERP kanalu in tu ne sme vec pristati med »drugimi besedili«.
      rows.AddRange(StoredFields(rows, "ProductText.", "Druga besedila iz vira").Where(stored => !ProductFieldLabels.IsErpTextType(TextTypeOf(stored.FieldKey))));
      rows.AddRange(MissingRequired(rows, "ProductText.", "Manjka za splet").Where(missing => !ProductFieldLabels.IsErpTextType(TextTypeOf(missing.FieldKey))));
      rows.AddRange(MissingRequired(rows, "ProductAttribute.", "Manjka za splet"));
      return rows;
    }
  }

  /// <summary>Jeziki, ki jih kartica ponudi za vnos: tisti, ki so ze v izdelku, in tisti, ki jih zahteva validacija.</summary>
  IReadOnlyList<string> WebLanguages => LanguagesFor("WEB_TITLE");
  IReadOnlyList<string> ErpLanguages => LanguagesFor("TITLE_ERP");

  /// <summary>
  /// Jeziki, ki jih kartica ponudi za vnos. Uporabnik 2026-08-28: »Nazivi tako spletni kot ERP
  /// morajo imati vse jezike.« Prej so bili ponujeni samo jeziki, ki jih je izdelek ze imel ali
  /// jih je zahtevala validacija — manjkajocega prevoda zato ni bilo mogoce dodati tam, kjer ga
  /// nihce ni zahteval. Zdaj je izhodisce register canon.Language za to podjetje; kar je v
  /// izdelku poleg registra, se ne izgubi. Red je sl, en, de, hr, it (PimLanguages).
  /// </summary>
  IReadOnlyList<string> LanguagesFor(string textType)
  {
    if (Detail is null) return ["sl"];
    return PimLanguages.Order(RegisteredLanguages
      .Concat(Detail.Texts.Where(row => row.TextType == textType).Select(row => row.Language))
      .Concat(Detail.Issues.Select(issue => issue.FieldCode)
        .Where(code => code.StartsWith($"ProductText.{textType}.", StringComparison.OrdinalIgnoreCase))
        .Select(code => code.Split('.').Last()))
      .Append("sl"));
  }

  /// <summary>Jeziki iz registra tega podjetja; prazen seznam pomeni, da register ni dosegljiv.</summary>
  IReadOnlyList<string> RegisteredLanguages =>
    Languages.Where(row => row.IsActive).Select(row => row.LanguageCode).ToArray();

  /// <summary>
  /// Vrste spletnih besedil, ki jih izdelek ze ima ali jih zahteva validacija; brez vsega, kar je
  /// last ERP-ja (239: ProductFieldLabels.IsErpTextType — nazivi ERP, kratki naziv, ime za iskanje,
  /// ERP opisi). Spletni naziv in spletni opis sta ponujena vedno, tudi brez vrstice.
  /// </summary>
  IReadOnlyList<string> WebTextTypes
  {
    get
    {
      if (Detail is null) return ProductFieldLabels.CoreWebTextTypes;
      return Detail.Texts.Select(row => row.TextType)
        .Concat(Detail.Issues.Select(issue => issue.FieldCode)
          .Where(code => code.StartsWith("ProductText.", StringComparison.OrdinalIgnoreCase))
          .Select(code => TextTypeOf(code) ?? ""))
        .Where(type => type.Length > 0 && !ProductFieldLabels.IsErpTextType(type))
        .Concat(ProductFieldLabels.CoreWebTextTypes)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(type => type.Equals("WEB_TITLE", StringComparison.OrdinalIgnoreCase) ? 0 : type.Equals("DESCRIPTION", StringComparison.OrdinalIgnoreCase) ? 1 : 2)
        .ThenBy(type => type, StringComparer.Ordinal)
        .ToList();
    }
  }

  /// <summary>Vrsta besedila iz kljuca polja ProductText.&lt;vrsta&gt;.&lt;jezik&gt;; null za druge kljuce.</summary>
  static string? TextTypeOf(string fieldKey)
  {
    var parts = fieldKey.Split('.');
    return parts.Length >= 3 && string.Equals(parts[0], "ProductText", StringComparison.OrdinalIgnoreCase) ? parts[1] : null;
  }

  /// <summary>Spletni opis je se vedno dobesedna kopija ERP opisa v istem jeziku (239).</summary>
  bool SameAsErpDescription(string language, string? value) =>
    !string.IsNullOrWhiteSpace(value) && Detail is not null && Detail.Texts.Any(row =>
      string.Equals(row.TextType, "DESCRIPTION_ERP", StringComparison.OrdinalIgnoreCase)
      && string.Equals(row.Language, language, StringComparison.OrdinalIgnoreCase)
      && string.Equals(row.Value.Trim(), value.Trim(), StringComparison.Ordinal));

  // ─── AI predlog spletnih besedil (uporabnik 2026-09-21) ────────────────────────────────────
  string AiLanguage = "sl";
  bool AiBusy;
  string? AiMessage, AiError;

  /// <summary>
  /// AI dobi samo to, kar je v PIM-u (ERP besedila, atributi, kategorije, partnerja, obstojeca
  /// spletna besedila v drugih jezikih); predlog gre v osnutek, ne v bazo. Shrani ga isti gumb kot
  /// rocno spremembo, zato velja tudi ista sled sprememb in isto pravilo o pravicah.
  /// </summary>
  async Task SuggestWithAiAsync()
  {
    if (Detail is null || !CanEdit || AiBusy) return;
    AiBusy = true; AiMessage = null; AiError = null;
    try
    {
      var request = new AiWebTextRequest(
        Detail.Header.ItemId, Detail.Header.Ean,
        Detail.Header.ManufacturerName ?? Detail.Header.Manufacturer,
        Detail.Header.SupplierName ?? Detail.Header.Supplier,
        Detail.Texts.Where(row => ProductFieldLabels.IsErpTextType(row.TextType) && !string.IsNullOrWhiteSpace(row.Value))
          .Select(row => new AiText(row.TextType, row.Language, row.Value)).ToList(),
        Detail.Categories.Select(row => new AiCategory(row.WebSite, row.CategoryPath)).ToList(),
        Detail.Attributes.Where(row => !string.IsNullOrWhiteSpace(row.Value)).Select(row => new AiAttribute(row.AttributeCode, row.Value)).ToList(),
        Detail.Texts.Where(row => !ProductFieldLabels.IsErpTextType(row.TextType) && !string.IsNullOrWhiteSpace(row.Value)
            && !string.Equals(row.Language, AiLanguage, StringComparison.OrdinalIgnoreCase)
            && !SameAsErpDescription(row.Language, row.Value))
          .Select(row => new AiText(row.TextType, row.Language, row.Value)).ToList(),
        AiLanguage);
      var suggestion = await Ai.SuggestWebTextsAsync(request);
      ApplyAiDraft("WEB_TITLE", suggestion.Title);
      ApplyAiDraft("DESCRIPTION", suggestion.Description);
      AiMessage = $"AI ({suggestion.Model}) je predlagal spletni naziv in opis v jeziku {AiLanguage}. Besedili sta v osnutku na zavihku Splet — preveri ju in klikni »Shrani spremembe«.";
    }
    catch (Exception exception) { AiError = exception.Message; }
    finally { AiBusy = false; }
  }

  void ApplyAiDraft(string textType, string value)
  {
    var field = WebFields.FirstOrDefault(row =>
        string.Equals(row.TextType, textType, StringComparison.OrdinalIgnoreCase)
        && string.Equals(row.Language, AiLanguage, StringComparison.OrdinalIgnoreCase)
        && row.Edit == ProductFieldEdit.Text)
      ?? TextField($"{TextLabel(textType)} ({AiLanguage})", textType, AiLanguage, null, "Nazivi in opisi");
    if (field.Edit != ProductFieldEdit.Text) return;
    OnFieldChanged((field, value));
  }

  IEnumerable<(PimValidationLayer Layer, ProductCardIssue Issue, bool Shared)> LayerIssues => Detail is null ? [] :
    Detail.Issues.SelectMany(issue => ProfileLayers(issue.ProfileCode).Select(layer => (layer, issue, IsShared(issue.ProfileCode))))
      .OrderBy(row => row.layer).ThenByDescending(row => row.issue.Severity == "ERROR").ThenBy(row => row.issue.ProfileCode);

  protected override Task OnParametersSetAsync() => LoadAsync();

  async Task LoadAsync()
  {
    Loading = true; Error = null; Detail = null; Origins = []; HeroImageFailed = false; ActivitiesExpanded = false;
    Snapshot = null; SnapshotError = null;
    var principal = (await Authentication.GetAuthenticationStateAsync()).User;
    CanEdit = PimPolicies.Allows(principal, PimPolicies.CatalogWrite);
    CanWaive = PimPolicies.Allows(principal, PimPolicies.FieldWaiver);
    ShopDrafts.Clear();
    ShopMessage = null;
    ShopError = null;
    FlagDrafts.Clear();
    FlagMessage = null;
    FlagError = null;
    ClearanceMessage = null;
    ClearanceError = null;
    try
    {
      // Kartica je dosegljiva iz seznama vseh podjetij, zato obseg dolocì izdelek sam;
      // privzeto podjetje bi tuji izdelek prikazalo kot neobstojec.
      var organization = await Data.GetProductOrganizationAsync(ProductId);
      if (organization is null) { Error = "Izdelek s to oznako ne obstaja."; return; }
      OrganizationId = organization.OrganizationId;
      OrganizationName = organization.Name;
      var cardTask = Workbench.GetProductCardAsync(organization.OrganizationId, ProductId, "sl");
      // Izvor podatkov (intranet.GetProductOrigin) se nalozi sele, ko uporabnik odpre zavihek
      // Kakovost in zgodovina (LoadOriginsAsync): isce po 78 M vrstic map.ExtractedValue in je
      // bil izmerjeno 17,8 s od 18 s odpiranja kartice (2026-09-17), vidi pa ga redkokdo.
      OriginsLoaded = false;
      var priceTask = Features.GetPriceChecksAsync(organization.OrganizationId, ProductId);
      var stockTask = Features.GetStockChecksAsync(organization.OrganizationId, ProductId);
      var sitesTask = Catalog.GetWebSitesAsync();
      // Register jezikov, ne samo jeziki, ki jih izdelek ze ima: nazivi morajo imeti vse jezike.
      var languagesTask = Catalog.GetLanguagesAsync(organization.OrganizationId);
      var writableTask = SaopWrite.GetWritableFieldsAsync(organization.OrganizationId);
      // Nabor atributov po kategoriji (147): kateri atributi sodijo k izdelku in kateri manjkajo.
      var attributeSetTask = Workbench.GetProductAttributeSetAsync(ProductId);
      // Spletisca (182): oznaka na izdelku pove, kam gre in kdo ga validira.
      var shopTask = Edits.GetWebShopsAsync(ProductId);
      // Odprodaja (232) in oznake (233): neodvisna panela ob spletiscih.
      var clearanceTask = Clearance.GetForProductAsync(ProductId);
      var flagsTask = Edits.GetProductFlagsAsync(ProductId);
      var packageOrderTask = LoadPackageOrderAsync();
      // Kljukica »izloči iz rezervacije« (245): ni v bralnem modelu kartice, zato posebej.
      var reservationTask = Edits.GetReservationExclusionAsync(ProductId);
      // Davčna stopnja (2026-09-28): ni v bralnem modelu kartice, zato posebej — kot rezervacija zgoraj.
      var vatRateTask = Edits.GetVatRateIdAsync(ProductId);
      // Objava za splet po izvoznih pravilih (242): isti pogled kot /kakovost/artikli in /splet.
      var webExportTask = LoadWebExportAsync();
      // Potrditve skrbnika (249): katera polja sme potrditi in katera so za ta artikel ze potrjena.
      var waiverTask = LoadFieldWaiversAsync();
      // Samodejni umiki s spleta (251): pasica nad spletišči pove, kdaj in zakaj je kljukica izginila.
      var withdrawalsTask = LoadWithdrawalsAsync();
      await Task.WhenAll(cardTask, priceTask, stockTask, sitesTask, languagesTask, writableTask, attributeSetTask, shopTask, clearanceTask, flagsTask, reservationTask, vatRateTask, webExportTask, waiverTask, withdrawalsTask, packageOrderTask);
      OpenWithdrawals = await withdrawalsTask;
      Detail = await cardTask; PriceChecks = await priceTask; StockChecks = await stockTask;
      Sites = await sitesTask; Languages = await languagesTask; WritableSaopFields = await writableTask;
      AttributeSet = await attributeSetTask; WebShops = await shopTask;
      ClearanceItems = await clearanceTask; Flags = await flagsTask; WebExport = await webExportTask;
      PackageOrder = await packageOrderTask;
      // Obrazec za ročni vnos pokaže obstoječo ročno vrstico (preostanek in popust), da popravek ne začne od 1.
      if (ClearanceItems.FirstOrDefault(item => item.IsActive && item.Vir == ManualClearanceVir) is { } manual)
      {
        ClearanceKolicina = Trimmed(manual.Kolicina);
        ClearancePopust = Trimmed(manual.PopustOdstotek);
      }
      ReservationExcluded = await reservationTask;
      VatRateId = await vatRateTask;
      FieldWaivers = await waiverTask;
      var fragment = new Uri(Navigation.Uri).Fragment.TrimStart('#');
      if (Sections.Contains(fragment)) Section = fragment;
      if (Section == "saop-endpoint") _ = LoadSnapshotAsync();
      if (Section == "quality-history") _ = LoadOriginsAsync();
    }
    catch { Error = "Kartice izdelka trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

