@page "/izdelki/{ProductId:long}"
@using PIM.Intranet.Components.Pages.ProductCardParts
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntranetDataService Data
@inject ProductWorkbenchService Workbench
@inject IntranetFeatureReadService Features
@inject CatalogReadService Catalog
@inject ProductEditService Edits
@inject SaopWriteService SaopWrite
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>@(Detail?.Header.Name ?? "Izdelek")</PageTitle>

<PimState Loading="Loading" Error="@Error" Empty="@(Detail is null)"
          EmptyText="Izdelek s to oznako ne obstaja." LoadingText="Nalaganje kartice izdelka …">
  @if (Detail is not null)
  {
    var heroUrl = MediaUrlPolicy.Normalize(Detail.Header.ThumbnailUrl);
    var erpBlockingCount = ErpIssues.Count(row => row.Severity == "ERROR");
    var webBlockingCount = WebIssues.Count(row => row.Severity == "ERROR");
    var commercialWarningCount = CommercialIssues.Count;
    <PimPage Title="@Detail.Header.Name" Subtitle="@($"Artikel {Detail.Header.ItemId} · EAN {Detail.Header.Ean ?? "—"}")" Crumbs="ProductCrumbs">
      <Actions>
        <div class="card-actions">
          <span class="save-state" role="status" aria-live="polite">
            @if (Busy) { <span>Shranjujem …</span> }
            else if (SaveError is not null) { <span class="save-error">@SaveError</span> }
            else if (SaveMessage is not null) { <span class="save-ok">@SaveMessage</span> }
            else if (Drafts.Count > 0) { <span class="save-dirty">@Drafts.Count neshranjenih</span> }
          </span>
          <button type="button" class="ghost-button" disabled="@(Drafts.Count == 0 || Busy)" @onclick="DiscardChanges">Prekliči</button>
          <button type="button" class="primary-button" disabled="@(Drafts.Count == 0 || Busy)" @onclick="SaveChangesAsync">
            Shrani spremembe@(Drafts.Count > 0 ? $" ({Drafts.Count})" : "")
          </button>
        </div>
      </Actions>
    </PimPage>

    <section class="product-hero" aria-labelledby="product-identity-title">
      <div class="media-tile">
        @if (heroUrl.Href is not null && !HeroImageFailed)
        {
          <img src="@heroUrl.Href" alt="@Detail.Header.Name" loading="lazy" @onerror="HeroFailed" />
        }
        else { <span>Brez slike</span> }
      </div>

      <div class="product-identity">
        <h2 id="product-identity-title" class="visually-hidden">Identiteta izdelka</h2>
        <p class="identity-line">
          <span class="code-value">@Detail.Header.ItemId</span>
          @if (Detail.Header.Ean is not null) { <span>EAN @Detail.Header.Ean</span> }
          @if (Detail.Header.ItemGroup is not null) { <span>@Detail.Header.ItemGroup</span> }
        </p>
        <div class="header-chips" aria-label="Stanje izdelka">
          <span class="flag-chip @(Detail.Header.IsActive ? "on" : "off")">@(Detail.Header.IsActive ? "Aktiven" : "Neaktiven")</span>
          <span class="flag-chip @(Detail.Header.WebPublish ? "on" : "off")">@(Detail.Header.WebPublish ? "Za splet" : "Ni za splet")</span>
          <PimChip Text="@(Detail.Header.IsPromoted ? "Objavljen v PIM" : "Ni objavljen v PIM")" Tone="@(Detail.Header.IsPromoted ? "good" : "warn")" />
        </div>
        @if (heroUrl.Href is not null) { <a class="media-link" href="@heroUrl.Href" target="_blank" rel="noopener noreferrer">Odpri glavni medij</a> }
        else if (heroUrl.Note is not null) { <span class="muted">@heroUrl.Note</span> }
      </div>

      <div class="hero-completeness">
        <span class="score-value">@Detail.Header.Completeness.ToString("0.#") %</span>
        <span class="score-label">skupna popolnost</span>
        <PimBar Percent="Detail.Header.Completeness" Label="Popolnost izdelka" />
        <span class="score-note">@Detail.Header.OpenIssueCount.ToString("N0") odprtih zahtev</span>
      </div>
    </section>

    <div class="product-workspace">
      <aside class="section-nav-column">
        <nav class="section-nav-card product-section-nav" role="tablist" aria-label="Sklopi kartice izdelka" aria-orientation="vertical">
          @foreach (var entry in SectionList)
          {
            var active = Section == entry.Key;
            <button type="button" role="tab" id="tab-@entry.Key" aria-controls="panel-@entry.Key"
                    aria-selected="@Flag(active)" class="@(active ? "active" : null)" @onclick="() => SelectSection(entry.Key)">
              <span>@entry.Label</span>
              @if (entry.Count is > 0) { <span class="nav-badge @entry.Tone">@entry.Count.Value.ToString("N0")</span> }
            </button>
          }
        </nav>
      </aside>

      <div class="section-content">
        <section id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0" class="section-panel overview-panel" hidden="@(Section != "overview")">
          @if (erpBlockingCount > 0)
          {
            <div class="blocking-banner" role="alert">
              <span class="alert-mark" aria-hidden="true">!</span>
              <div>
                <strong>@erpBlockingCount.ToString("N0") napak blokira ERP</strong>
                <span>Manjkajo obvezni podatki za zapis v SAOP.</span>
              </div>
              <button type="button" class="banner-action" @onclick='() => SelectSection("quality-history")'>Odpri kakovost</button>
            </div>
          }

          <h2 class="section-title">Pregled artikla</h2>
          <section class="channel-strip" aria-label="Stanje treh kanalov izdelka">
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("core")'>
              <span class="channel-name">ERP (SAOP)</span>
              <PimChip Text="@StatusLabel(ErpStatus)" Tone="@Tone(ErpStatus)" />
              <small>@erpBlockingCount.ToString("N0") blokirajočih napak</small>
            </button>
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("sales")'>
              <span class="channel-name">Komerciala</span>
              <PimChip Text="@(commercialWarningCount == 0 ? "Brez odprtih opozoril" : "Potrebuje pregled")" Tone="@(commercialWarningCount == 0 ? "good" : "warn")" />
              <small>@commercialWarningCount.ToString("N0") opozoril · nikoli ne blokira</small>
            </button>
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("sales")'>
              <span class="channel-name">Splet</span>
              <PimChip Text="@StatusLabel(WebStatus)" Tone="@Tone(WebStatus)" />
              <small>@(string.IsNullOrWhiteSpace(SelectedSite) ? "vsa spletna mesta" : SelectedSite)</small>
            </button>
          </section>

          <div class="overview-grid">
            <section class="ui-card key-data-card" aria-labelledby="key-data-title">
              <h2 id="key-data-title">Ključni podatki</h2>
              <dl class="key-data-list">
                <div><dt>Artikel</dt><dd><span>@Detail.Header.ItemId</span><span class="owner-label">@OwnerFor("Product.ItemID")</span></dd></div>
                <div><dt>EAN</dt><dd><span>@Value(Detail.Header.Ean)</span><span class="owner-label">@OwnerFor("Product.EAN")</span></dd></div>
                <div><dt>Aktiven</dt><dd><span>@YesNo(Detail.Header.IsActive)</span><span class="owner-label">@OwnerFor("Product.IsActive")</span></dd></div>
                <div><dt>Za splet</dt><dd><span>@YesNo(Detail.Header.WebPublish)</span><span class="owner-label">@OwnerFor("Product.WebPublish")</span></dd></div>
              </dl>
              <button type="button" class="detail-link" @onclick='() => SelectSection("core")'>Prikaži vse podrobnosti <span aria-hidden="true">›</span></button>
            </section>

            <section class="ui-card task-card" aria-labelledby="tasks-title">
              <h2 id="tasks-title">Odprte naloge</h2>
              @if (erpBlockingCount == 0 && webBlockingCount == 0 && commercialWarningCount == 0)
              {
                <p class="empty-tasks">Ni odprtih nalog. Artikel je pripravljen za svoje cilje.</p>
              }
              else
              {
                <div class="task-list">
                  @if (erpBlockingCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("quality-history")'>
                      <span class="task-mark bad" aria-hidden="true">!</span><span>Dopolni ERP podatke</span><span class="task-status bad">Blokira</span><span aria-hidden="true">›</span>
                    </button>
                  }
                  @if (webBlockingCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("sales")'>
                      <span class="task-mark bad" aria-hidden="true">!</span><span>Dopolni spletne podatke</span><span class="task-status bad">Blokira</span><span aria-hidden="true">›</span>
                    </button>
                  }
                  @if (commercialWarningCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("sales")'>
                      <span class="task-mark warn" aria-hidden="true">!</span><span>Preglej komercialne podatke</span><span class="task-status warn">Opozorilo</span><span aria-hidden="true">›</span>
                    </button>
                  }
                </div>
              }
            </section>
          </div>
        </section>

        <section id="panel-core" role="tabpanel" aria-labelledby="tab-core" tabindex="0" class="section-panel section-stack" hidden="@(Section != "core")">
          <header class="section-heading"><h2>Osnovni podatki</h2><p>Identiteta, šifranti in podatki, ki jih PIM nadzorovano izmenjuje z ERP.</p></header>
          <ProductChannelPanel PanelId="panel-erp" TabId="tab-core" Title="ERP (SAOP)"
                               StatusText="@StatusLabel(ErpStatus)" StatusTone="@Tone(ErpStatus)"
                               BlockingCount="@erpBlockingCount"
                               WarningCount="@ErpIssues.Count(row => row.Severity == "WARNING")"
                               LastValidatedUtc="@Detail.Header.LastValidatedUtc" Fields="@ErpFields" Issues="@ErpIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" DefaultGroup="Osnovna polja za ERP" />
        </section>

        <section id="panel-sales" role="tabpanel" aria-labelledby="tab-sales" tabindex="0" class="section-panel section-stack" hidden="@(Section != "sales")">
          <header class="section-heading"><h2>Prodaja in kanali</h2><p>Komercialni podatki, spletna objava in cene na enem delovnem mestu.</p></header>
          <ProductChannelPanel PanelId="panel-komerciala" TabId="tab-sales" Title="Komerciala"
                               StatusText="@(commercialWarningCount == 0 ? "Brez odprtih opozoril" : "Potrebuje pregled")"
                               StatusTone="@(commercialWarningCount == 0 ? "good" : "warn")" BlockingCount="0"
                               WarningCount="@commercialWarningCount" LastValidatedUtc="@Detail.Header.LastValidatedUtc"
                               Fields="@CommercialFields" Issues="@CommercialIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" DefaultGroup="Trgovinski podatki" />

          <ProductChannelPanel PanelId="panel-splet" TabId="tab-sales" Title="Splet"
                               StatusText="@StatusLabel(WebStatus)" StatusTone="@Tone(WebStatus)"
                               BlockingCount="@webBlockingCount"
                               WarningCount="@WebIssues.Count(row => row.Severity == "WARNING")"
                               LastValidatedUtc="@Detail.Header.LastValidatedUtc" Fields="@WebFields" Issues="@WebIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" DefaultGroup="Spletna polja">
            <Toolbar>
              <label for="product-site">Spletno mesto</label>
              <select id="product-site" class="filter-select" @bind="SelectedSite">
                <option value="">Vsa spletna mesta</option>
                @foreach (var site in WebSites) { <option value="@site">@site</option> }
              </select>
            </Toolbar>
          </ProductChannelPanel>

          <section id="panel-prices" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Cene</h2><a href="cene?izdelek=@Detail.Header.ItemId">Odpri poslovni pogled</a></div>
            @if (PriceChecks?.IsMissing == true) { <PimMissing Object="intranet.GetPriceChecks" What="preverbe cen tega artikla po ceniku" Needs="canon.ProductPrice + šifrant preverb + prag marže" /> }
            <PimState Empty="@(Detail.Prices.Count == 0)" EmptyText="Izdelek nima cene.">
              <PimTable Caption="Cene izdelka po cenikih" Columns="PriceColumns"><Rows>@foreach (var row in Detail.Prices) { <tr><td>@row.PriceList</td><td class="numeric">@row.Net.ToString("N2")</td><td class="numeric">@row.VatRate.ToString("N1") %</td><td class="numeric">@row.Gross.ToString("N2")</td><td>@row.ValidFrom.ToLocalTime().ToString("d")</td><td><PimChip Text="@(row.IsActive ? "Veljavna" : "Neaktivna")" Tone="@(row.IsActive ? "good" : null)" /></td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>

        <section id="panel-media-stock" role="tabpanel" aria-labelledby="tab-media-stock" tabindex="0" class="section-panel section-stack" hidden="@(Section != "media-stock")">
          <header class="section-heading"><h2>Mediji in zaloga</h2><p>Gradiva izdelka in trenutno stanje razpoložljivosti.</p></header>
          <section id="panel-media" class="ui-card tab-panel">
            <div class="subsection-head"><h2>Mediji</h2><a href="mediji?izdelek=@Detail.Header.ItemId">Vsi mediji tega izdelka</a></div>
            <ProductMediaGallery ProductName="@Detail.Header.Name" Media="@Detail.Media" Documents="@Detail.Documents" />
          </section>

          <section id="panel-stock" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zaloga</h2><a href="zaloge?isci=@Uri.EscapeDataString(Detail.Header.ItemId)">Odpri poslovni pogled</a></div>
            @if (StockChecks?.IsMissing == true) { <PimMissing Object="intranet.GetStockChecks" What="preverbe zaloge tega artikla" Needs="stock.Snapshot, stock.Position, stock.UnmatchedPosition in potrjene pragove" /> }
            <PimState Empty="@(Detail.Stock.Count == 0)" EmptyText="Izdelek nima aktivnega zalogovnega posnetka.">
              <PimTable Caption="Aktivne zalogovne pozicije izdelka" Columns="StockColumns"><Rows>@foreach (var row in Detail.Stock) { <tr><td>@(row.WarehouseName ?? row.WarehouseCode ?? row.MatchKey)</td><td>@(row.ProviderKind ?? "—")</td><td class="numeric">@row.Quantity.ToString("N2")</td><td class="numeric">@(row.IncomingQuantity?.ToString("N2") ?? "—")</td><td>@(row.AvailabilityDate?.ToLocalTime().ToString("d") ?? "—")</td><td>@PimFormat.Ago(row.SnapshotUtc)</td><td>@StockRule(row)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>

        <section id="panel-quality-history" role="tabpanel" aria-labelledby="tab-quality-history" tabindex="0" class="section-panel section-stack" hidden="@(Section != "quality-history")">
          <header class="section-heading"><h2>Kakovost in zgodovina</h2><p>Odprte zahteve, pot v SAOP, revizijska sled in dokaz o izvoru.</p></header>
          <section id="panel-quality" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Kakovost</h2><span>@Detail.Issues.Count.ToString("N0") odprtih zahtev</span></div>
            <PimState Empty="@(Detail.Issues.Count == 0)" EmptyText="Izdelek nima odprtih validacijskih težav.">
              <PimTable Caption="Odprte težave po nivoju validacije" Columns="IssueColumns">
                <Rows>@foreach (var item in LayerIssues) { <tr><td><PimChip Text="@ValidationLayer.Label(item.Layer)" Tone="@(item.Layer == PimValidationLayer.Komerciala ? "warn" : null)" />@if (item.Shared) { <PimChip Text="SKUPNO" Tone="warn" /> }</td><td>@item.Issue.ProfileCode</td><td><PimChip Text="@item.Issue.Severity" Tone="@(item.Issue.Severity == "ERROR" ? "bad" : "warn")" /></td><td>@item.Issue.FieldCode</td><td>@item.Issue.Message</td><td>@item.Issue.LastDetectedUtc.ToLocalTime().ToString("g")</td></tr> }</Rows>
              </PimTable>
            </PimState>
          </section>

          <section id="panel-saop" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zapisi v SAOP</h2><a href="saop">Odpri skupni pregled</a></div>
            <PimState Empty="@(Detail.Outbound.Count == 0)" EmptyText="Za izdelek ni odhodnih sporočil.">
              <PimTable Caption="Spremembe izdelka na poti v SAOP" Columns="OutboundColumns"><Rows>@foreach (var row in Detail.Outbound) { <tr><td>@row.OutboxMessageId</td><td>@row.FieldSummary</td><td>@row.Operation</td><td><PimChip Text="@StatusLabel(row.Status)" Tone="@Tone(row.Status)" /></td><td class="numeric">@row.AttemptCount</td><td>@Moment(row.SentUtc)</td><td>@Moment(row.VerifiedUtc)</td><td>@Value(row.DriftDetail ?? row.LastAttemptFailureReason ?? row.LastError)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>

          <section id="panel-history" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zgodovina sprememb</h2></div>
            <PimState Empty="@(Detail.History.Count == 0)" EmptyText="Za ta izdelek še ni zabeleženih sprememb sledljivih polj.">
              <PimTable Caption="Revizijska sled sprememb izdelka" Columns="HistoryColumns"><Rows>@foreach (var row in Detail.History) { <tr><td>@row.FieldKey</td><td>@Value(row.OldValue)</td><td>@Value(row.NewValue)</td><td>@row.Owner</td><td>@row.ChangeSource</td><td>@row.ChangedBy</td><td>@row.ChangedAtUtc.ToLocalTime().ToString("g")</td><td>@Value(row.Note)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>

          <section id="panel-origin" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Izvor podatkov</h2></div>
            <PimState Empty="@(Origins.Count == 0)" EmptyText="Za izdelek ni mogoče določiti vhodnega zapisa.">
              <PimTable Caption="Vhodni teki in strani, iz katerih izvirajo podatki" Columns="OriginColumns"><Rows>@foreach (var row in Origins) { <tr><td><a href="zajem/tezave/INBOX/@row.InboxId">@row.SourceCode</a></td><td><a href="zajem/teki/@row.RunId">@ShortId(row.RunId)</a></td><td>@row.EntityType</td><td class="numeric">@row.PageNumber</td><td class="numeric">@row.RecordOrdinal</td><td class="numeric">@row.ExtractedFieldCount</td><td>@row.Status</td><td>@row.ReceivedUtc.ToLocalTime().ToString("g")</td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>
      </div>
    </div>
  }
</PimState>

@code {
  [Parameter] public long ProductId { get; set; }

  ProductCardView? Detail;
  IReadOnlyList<ProductOriginRow> Origins = [];
  IReadOnlyList<WebSiteRow> Sites = [];
  PimReadResult<BusinessCheckRow>? PriceChecks;
  PimReadResult<BusinessCheckRow>? StockChecks;
  bool Loading = true;
  bool HeroImageFailed;
  string? Error;
  string Section = "overview";
  string SelectedSite = "";

  int OrganizationId;
  IReadOnlyList<WritableFieldRow> WritableSaopFields = [];

  /// <summary>Nepotrjene spremembe: kljuc polja → nova vrednost. Zivijo, dokler jih uporabnik
  /// ne shrani ali preklice; menjava sklopa jih ne izgubi, ker je kartica en obrazec.</summary>
  readonly Dictionary<string, string?> Drafts = new(StringComparer.OrdinalIgnoreCase);
  readonly Dictionary<string, ProductChannelField> DraftFields = new(StringComparer.OrdinalIgnoreCase);
  bool Busy;
  string? SaveMessage;
  string? SaveError;

  static readonly IReadOnlyList<PimCrumb> ProductCrumbs = [new("Izdelki", "izdelki"), new("Kartica")];
  static readonly IReadOnlyList<PimColumn> PriceColumns = [new("Cenik"), new("Neto", true), new("DDV", true), new("Bruto", true), new("Velja od"), new("Stanje")];
  static readonly IReadOnlyList<PimColumn> StockColumns = [new("Skladišče"), new("Vir"), new("Količina", true), new("Prihaja", true), new("Razpoložljivo"), new("Svežina"), new("Min/max")];
  static readonly IReadOnlyList<PimColumn> IssueColumns = [new("Nivo"), new("Profil"), new("Resnost"), new("Zahteva"), new("Sporočilo"), new("Zaznano")];
  static readonly IReadOnlyList<PimColumn> OutboundColumns = [new("ID"), new("Polje"), new("Operacija"), new("Status"), new("Poskusov", true), new("Poslano"), new("Potrjeno"), new("Vzrok/odmik")];
  static readonly IReadOnlyList<PimColumn> HistoryColumns = [new("Polje"), new("Stara vrednost"), new("Nova vrednost"), new("Lastnik"), new("Vir"), new("Spremenil"), new("Čas"), new("Razlog")];
  static readonly IReadOnlyList<PimColumn> OriginColumns = [new("Vir"), new("Tek"), new("Entiteta"), new("Stran", true), new("Zapis", true), new("Polj", true), new("Stanje"), new("Prejeto")];

  IReadOnlyList<string> WebSites => Sites.Where(site => site.IsActive).OrderBy(site => site.SortOrder).Select(site => site.WebSiteCode).ToArray();

  IReadOnlyList<ProductCardIssue> ErpIssues => IssuesFor(PimValidationLayer.ErpSlo, PimValidationLayer.ErpEuThird);
  IReadOnlyList<ProductCardIssue> CommercialIssues => IssuesFor(PimValidationLayer.Komerciala);
  IReadOnlyList<ProductCardIssue> WebIssues => IssuesFor(PimValidationLayer.Splet).Where(row => MatchesSite(row.ProfileCode)).ToList();
  string ErpStatus => StatusFor([PimValidationLayer.ErpSlo, PimValidationLayer.ErpEuThird], Detail?.Header.ErpStatus ?? "PENDING");
  string WebStatus => StatusFor([PimValidationLayer.Splet], Detail?.Header.WebStatus ?? "PENDING", SelectedSite);

  /* Polja kanala nastanejo iz treh virov, da na kartici ni vec praznega mesta:
       1. kar je v bralnem modelu (vrednosti izdelka),
       2. kar je pisljivo v SAOP (register out.SaopXmlField) — to je urejivo prek odhodne vrste,
       3. kar validacija pogresa (odprte tezave) — polje se pokaze, tudi ce vrstice v katalogu ni.
     Tretja tocka je bistvo: doslej je kartica povedala, da polje manjka, ni pa ga bilo mogoce
     izpolniti; zdaj je manjkajoce polje vnosno mesto. */

  WritableFieldRow? Writable(string fieldKey) =>
    WritableSaopFields.FirstOrDefault(row => string.Equals(row.FieldKey, fieldKey, StringComparison.OrdinalIgnoreCase));

  static string FormatOf(WritableFieldRow? writable) => writable?.ValueFormat switch
  {
    "bool" => "bool",
    "decimal4" or "decimal8" => "decimal",
    _ => "text",
  };

  bool RequiredField(string fieldKey) => Detail?.Issues.Any(issue =>
    string.Equals(issue.FieldCode, fieldKey, StringComparison.OrdinalIgnoreCase)) == true;

  /// <summary>Polje kanala; ce je pisljivo v SAOP, je urejivo prek odhodne vrste, sicer samo prikaz.</summary>
  ProductChannelField Channel(string label, string fieldKey, string? value, string group, bool inReadModel = true)
  {
    var writable = Writable(fieldKey);
    var stored = Detail?.Fields.FirstOrDefault(row => row.FieldKey == fieldKey);
    var resolved = value ?? stored?.Value;
    return new(label, fieldKey, resolved, stored?.Owner ?? (writable is null ? "—" : "PIM"), null, null,
      Pending(fieldKey), inReadModel,
      writable is null ? ProductFieldEdit.None : ProductFieldEdit.Saop, FormatOf(writable),
      RequiredField(fieldKey), string.IsNullOrWhiteSpace(resolved),
      Hint: group);
  }

  /// <summary>Besedilo izdelka. ERP nazive pise SAOP, zato so ta med pisljivimi polji SAOP.</summary>
  ProductChannelField TextField(string label, string textType, string language, string? value, string group)
  {
    var fieldKey = $"ProductText.{textType}.{language}";
    var writable = Writable(fieldKey);
    var stored = Detail?.Texts.FirstOrDefault(row => row.TextType == textType && row.Language == language);
    var resolved = value ?? stored?.Value;
    var multiline = textType.Contains("DESCRIPTION", StringComparison.OrdinalIgnoreCase);
    return new(label, fieldKey, resolved, stored?.Owner ?? (writable is null ? "PIM" : "SAOP"), null, null,
      Pending(fieldKey), true,
      writable is null ? ProductFieldEdit.Text : ProductFieldEdit.Saop,
      writable is null && multiline ? "multiline" : FormatOf(writable),
      RequiredField(fieldKey), string.IsNullOrWhiteSpace(resolved),
      Language: language, TextType: textType, Hint: group);
  }

  ProductChannelField AttributeField(string attributeCode, string? value, string group)
  {
    var fieldKey = $"ProductAttribute.{attributeCode}";
    return new(attributeCode, fieldKey, value, "PIM", null, null, false, true,
      ProductFieldEdit.Attribute, "text", RequiredField(fieldKey), string.IsNullOrWhiteSpace(value),
      AttributeCode: attributeCode, Hint: group);
  }

  /// <summary>Manjkajoca obvezna polja tega kanala, ki jih seznam zgoraj se ne pokriva.</summary>
  IEnumerable<ProductChannelField> MissingRequired(IReadOnlyList<ProductChannelField> known, string prefix, string group)
  {
    if (Detail is null) yield break;
    foreach (var code in Detail.Issues
      .Select(issue => issue.FieldCode)
      .Where(code => code.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
      .Distinct(StringComparer.OrdinalIgnoreCase)
      .OrderBy(code => code, StringComparer.OrdinalIgnoreCase))
    {
      if (known.Any(row => string.Equals(row.FieldKey, code, StringComparison.OrdinalIgnoreCase))) continue;
      var parts = code.Split('.');
      if (code.StartsWith("ProductText.", StringComparison.OrdinalIgnoreCase) && parts.Length >= 3)
        yield return TextField($"{TextLabel(parts[1])} ({parts[2]})", parts[1], parts[2], null, group);
      else if (code.StartsWith("ProductAttribute.", StringComparison.OrdinalIgnoreCase) && parts.Length >= 2)
        yield return AttributeField(string.Join('.', parts.Skip(1)), null, group);
      else
        yield return Channel(FieldLabel(code), code, null, group);
    }
  }

