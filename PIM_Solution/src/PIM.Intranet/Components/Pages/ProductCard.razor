@page "/izdelki/{ProductId:long}"
@using PIM.Intranet.Components.Pages.ProductCardParts
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntranetDataService Data
@inject ProductWorkbenchService Workbench
@inject IntranetFeatureReadService Features
@inject CatalogReadService Catalog
@inject ProductEditService Edits
@inject SaopWriteService SaopWrite
@inject SaopEndpointSnapshotService SaopSnapshot
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>@(Detail?.Header.Name ?? "Izdelek")</PageTitle>

<PimState Loading="Loading" Error="@Error" Empty="@(Detail is null)"
          EmptyText="Izdelek s to oznako ne obstaja." LoadingText="Nalaganje kartice izdelka …">
  @if (Detail is not null)
  {
    var heroUrl = MediaUrlPolicy.Normalize(Detail.Header.ThumbnailUrl);
    var erpBlockingCount = ErpIssues.Count(row => row.Severity == "ERROR");
    var webBlockingCount = WebIssues.Count(row => row.Severity == "ERROR");
    var commercialWarningCount = CommercialIssues.Count;
    <PimPage Title="@Detail.Header.Name" Subtitle="@($"{OrganizationName} · artikel {Detail.Header.ItemId} · EAN {Detail.Header.Ean ?? "—"}")" Crumbs="ProductCrumbs">
      <Actions>
        <div class="card-actions">
          @* A1, pregled 2026-09-08: bralna vloga je dobila 14 urejivih polj in gumb »Shrani
             spremembe«. Kdor ne sme pisati, tu ne dobi gumba, ampak pove, zakaj ga ni. *@
          @if (!CanEdit)
          {
            <PimChip Text="Samo za branje" Tone="warn" />
            <span class="save-state">Urejanje kartice je omejeno na vlogi ADMIN in CATALOG_EDITOR.</span>
          }
          else
          {
            <span class="save-state" role="status" aria-live="polite">
              @if (Busy) { <span>Shranjujem …</span> }
              else if (Conflicts.Count > 0) { <span class="save-error">@Conflicts.Count polj ni bilo shranjenih — nekdo jih je vmes spremenil</span> }
              else if (SaveError is not null) { <span class="save-error">@SaveError</span> }
              else if (SaveMessage is not null) { <span class="save-ok">@SaveMessage</span> }
              else if (Drafts.Count > 0) { <span class="save-dirty">@Drafts.Count neshranjenih</span> }
            </span>
            <button type="button" class="ghost-button" disabled="@(Drafts.Count == 0 || Busy)" @onclick="DiscardChanges">Prekliči</button>
            <button type="button" class="primary-button" disabled="@(Drafts.Count == 0 || Busy)" @onclick="SaveChangesAsync">
              Shrani spremembe@(Drafts.Count > 0 ? $" ({Drafts.Count})" : "")
            </button>
          }
        </div>
      </Actions>
    </PimPage>

    @if (Conflicts.Count > 0)
    {
      @* P3-17, pregled 2026-09-08: dva urednika sta se doslej tiho prepisala. Sporna polja se ne
         zapišejo; tukaj stoji, kaj si videl ti in kaj je v katalogu zdaj, da se odločiš sam. *@
      <section class="ui-card conflict-card" role="alert" aria-labelledby="conflict-title">
        <h2 id="conflict-title">Nekdo je bil hitrejši</h2>
        <p>Ta polja niso bila shranjena, ker jih je med tvojim urejanjem spremenil nekdo drug.
           Ostale spremembe so shranjene. Preveri in vpiši znova, če tvoja vrednost še velja.</p>
        <ul class="conflict-list">
          @foreach (var conflict in Conflicts)
          {
            <li>
              <span class="code-value">@conflict.FieldKey</span>
              <span class="conflict-mine">tvoja izhodiščna: @(string.IsNullOrEmpty(conflict.Expected) ? "—" : conflict.Expected)</span>
              <span class="conflict-theirs">v katalogu zdaj: @(string.IsNullOrEmpty(conflict.TheirValue) ? "—" : conflict.TheirValue)</span>
            </li>
          }
        </ul>
      </section>
    }

    <section class="product-hero" aria-labelledby="product-identity-title">
      <div class="media-tile">
        @if (heroUrl.Href is not null && !HeroImageFailed)
        {
          <img src="@heroUrl.Href" alt="@Detail.Header.Name" loading="lazy" @onerror="HeroFailed" />
        }
        else { <span>Brez slike</span> }
      </div>

      <div class="product-identity">
        <h2 id="product-identity-title" class="visually-hidden">Identiteta izdelka</h2>
        @* A6, uporabnik 2026-08-31: »na kartici artikla se nikjer ne vidi iz katere organizacije
           je artikel«. Sifra artikla je enolicna samo znotraj podjetja — 0000000000001 obstaja
           v DEMO in v Vidadrii — zato podjetje stoji takoj ob njej. *@
        <p class="identity-line">
          <span class="organization-badge">@OrganizationName</span>
          <span class="code-value">@Detail.Header.ItemId</span>
          @if (Detail.Header.Ean is not null) { <span>EAN @Detail.Header.Ean</span> }
          @if (Detail.Header.ItemGroup is not null) { <span>@Detail.Header.ItemGroup</span> }
        </p>
        <div class="header-chips" aria-label="Stanje izdelka">
          <span class="flag-chip @(Detail.Header.IsActive ? "on" : "off")">@(Detail.Header.IsActive ? "Aktiven" : "Neaktiven")</span>
          <span class="flag-chip @(Detail.Header.WebPublish ? "on" : "off")">@(Detail.Header.WebPublish ? "Za splet" : "Ni za splet")</span>
          <PimChip Text="@(Detail.Header.IsPromoted ? "Objavljen v PIM" : "Ni objavljen v PIM")" Tone="@(Detail.Header.IsPromoted ? "good" : "warn")" />
        </div>
        @if (heroUrl.Href is not null) { <a class="media-link" href="@heroUrl.Href" target="_blank" rel="noopener noreferrer">Odpri glavni medij</a> }
        else if (heroUrl.Note is not null) { <span class="muted">@heroUrl.Note</span> }
      </div>

      <div class="hero-completeness">
        <span class="score-value">@Detail.Header.Completeness.ToString("0.#") %</span>
        <span class="score-label">skupna popolnost</span>
        <PimBar Percent="Detail.Header.Completeness" Label="Popolnost izdelka" />
        <span class="score-note">@Detail.Header.OpenIssueCount.ToString("N0") odprtih zahtev</span>
      </div>
    </section>

    <div class="product-workspace">
      <aside class="section-nav-column">
        <nav class="section-nav-card product-section-nav" role="tablist" aria-label="Sklopi kartice izdelka" aria-orientation="vertical">
          @foreach (var entry in SectionList)
          {
            var active = Section == entry.Key;
            <button type="button" role="tab" id="tab-@entry.Key" aria-controls="panel-@entry.Key"
                    aria-selected="@Flag(active)" class="@(active ? "active" : null)" @onclick="() => SelectSection(entry.Key)">
              <span>@entry.Label</span>
              @if (entry.Count is > 0) { <span class="nav-badge @entry.Tone">@entry.Count.Value.ToString("N0")</span> }
            </button>
          }
        </nav>
      </aside>

      <div class="section-content">
        <section id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0" class="section-panel overview-panel" hidden="@(Section != "overview")">
          @if (erpBlockingCount > 0)
          {
            <div class="blocking-banner" role="alert">
              <span class="alert-mark" aria-hidden="true">!</span>
              <div>
                <strong>@erpBlockingCount.ToString("N0") napak blokira ERP</strong>
                <span>Manjkajo obvezni podatki za zapis v SAOP.</span>
              </div>
              <button type="button" class="banner-action" @onclick='() => SelectSection("quality-history")'>Odpri kakovost</button>
            </div>
          }

          <h2 class="section-title">Pregled artikla</h2>
          <section class="channel-strip" aria-label="Stanje treh kanalov izdelka">
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("core")'>
              <span class="channel-name">ERP (SAOP)</span>
              <PimChip Text="@StatusLabel(ErpStatus)" Tone="@Tone(ErpStatus)" />
              <small>@erpBlockingCount.ToString("N0") blokirajočih napak</small>
            </button>
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("commercial")'>
              <span class="channel-name">Komerciala</span>
              <PimChip Text="@(commercialWarningCount == 0 ? "Brez odprtih opozoril" : "Potrebuje pregled")" Tone="@(commercialWarningCount == 0 ? "good" : "warn")" />
              <small>@commercialWarningCount.ToString("N0") opozoril · nikoli ne blokira</small>
            </button>
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("web")'>
              <span class="channel-name">Splet</span>
              <PimChip Text="@StatusLabel(WebStatus)" Tone="@Tone(WebStatus)" />
              <small>@(string.IsNullOrWhiteSpace(SelectedSite) ? "vsa spletna mesta" : SelectedSite)</small>
            </button>
          </section>

          <div class="overview-grid">
            <section class="ui-card key-data-card" aria-labelledby="key-data-title">
              <h2 id="key-data-title">Ključni podatki</h2>
              <dl class="key-data-list">
                <div><dt>Artikel</dt><dd><span>@Detail.Header.ItemId</span><span class="owner-label">@OwnerFor("Product.ItemID")</span></dd></div>
                <div><dt>EAN</dt><dd><span>@Value(Detail.Header.Ean)</span><span class="owner-label">@OwnerFor("Product.EAN")</span></dd></div>
                <div><dt>Aktiven</dt><dd><span>@YesNo(Detail.Header.IsActive)</span><span class="owner-label">@OwnerFor("Product.IsActive")</span></dd></div>
                <div><dt>Za splet</dt><dd><span>@YesNo(Detail.Header.WebPublish)</span><span class="owner-label">@OwnerFor("Product.WebPublish")</span></dd></div>
              </dl>
              <button type="button" class="detail-link" @onclick='() => SelectSection("core")'>Prikaži vse podrobnosti <span aria-hidden="true">›</span></button>
            </section>

            <section class="ui-card task-card" aria-labelledby="tasks-title">
              <h2 id="tasks-title">Odprte naloge</h2>
              @if (erpBlockingCount == 0 && webBlockingCount == 0 && commercialWarningCount == 0)
              {
                <p class="empty-tasks">Ni odprtih nalog. Artikel je pripravljen za svoje cilje.</p>
              }
              else
              {
                <div class="task-list">
                  @if (erpBlockingCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("quality-history")'>
                      <span class="task-mark bad" aria-hidden="true">!</span><span>Dopolni ERP podatke</span><span class="task-status bad">Blokira</span><span aria-hidden="true">›</span>
                    </button>
                  }
                  @if (webBlockingCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("web")'>
                      <span class="task-mark bad" aria-hidden="true">!</span><span>Dopolni spletne podatke</span><span class="task-status bad">Blokira</span><span aria-hidden="true">›</span>
                    </button>
                  }
                  @if (commercialWarningCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("commercial")'>
                      <span class="task-mark warn" aria-hidden="true">!</span><span>Preglej komercialne podatke</span><span class="task-status warn">Opozorilo</span><span aria-hidden="true">›</span>
                    </button>
                  }
                </div>
              }
            </section>
          </div>
        </section>

        <section id="panel-core" role="tabpanel" aria-labelledby="tab-core" tabindex="0" class="section-panel section-stack" hidden="@(Section != "core")">
          <header class="section-heading"><h2>ERP (SAOP)</h2><p>Identiteta, šifranti ERP, partnerja, nazivi za ERP ter logistika, ki jo zahteva izvoz.</p></header>
          <ProductChannelPanel PanelId="panel-erp" TabId="tab-core" Title="ERP (SAOP)"
                               StatusText="@StatusLabel(ErpStatus)" StatusTone="@Tone(ErpStatus)"
                               BlockingCount="@erpBlockingCount"
                               WarningCount="@ErpIssues.Count(row => row.Severity == "WARNING")"
                               LastValidatedUtc="@Detail.Header.LastValidatedUtc" Fields="@ErpFields" Issues="@ErpIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" DefaultGroup="ERP — Slovenija"
                               ReadOnly="@(!CanEdit)" />
        </section>

        @* A7, uporabnik 2026-08-31: »komercialne podatke in pa splet podatke bi locili«.
           Cene ostanejo pri komercialni strani — so komercialen podatek, ne spletna vsebina. *@
        <section id="panel-commercial" role="tabpanel" aria-labelledby="tab-commercial" tabindex="0" class="section-panel section-stack" hidden="@(Section != "commercial")">
          <header class="section-heading"><h2>Komerciala</h2><p>Uvrstitev artikla, aktivnost, nabavni pogoji in cene po cenikih.</p></header>
          <ProductChannelPanel PanelId="panel-komerciala" TabId="tab-commercial" Title="Komerciala"
                               StatusText="@(commercialWarningCount == 0 ? "Brez odprtih opozoril" : "Potrebuje pregled")"
                               StatusTone="@(commercialWarningCount == 0 ? "good" : "warn")" BlockingCount="0"
                               WarningCount="@commercialWarningCount" LastValidatedUtc="@Detail.Header.LastValidatedUtc"
                               Fields="@CommercialFields" Issues="@CommercialIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" DefaultGroup="Klasifikacija in objava"
                               ReadOnly="@(!CanEdit)" />

          <section id="panel-prices" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Cene</h2><a href="cene?izdelek=@Detail.Header.ItemId">Odpri poslovni pogled</a></div>
            @if (PriceChecks?.IsMissing == true) { <PimMissing Object="intranet.GetPriceChecks" What="preverbe cen tega artikla po ceniku" Needs="canon.ProductPrice + šifrant preverb + prag marže" /> }
            <PimState Empty="@(Detail.Prices.Count == 0)" EmptyText="Izdelek nima cene.">
              <PimTable Caption="Cene izdelka po cenikih" Columns="PriceColumns"><Rows>@foreach (var row in Detail.Prices) { <tr><td>@row.PriceList</td><td class="numeric">@row.Net.ToString("N2")</td><td class="numeric">@row.VatRate.ToString("N1") %</td><td class="numeric">@row.Gross.ToString("N2")</td><td>@row.ValidFrom.ToLocalTime().ToString("d")</td><td><PimChip Text="@(row.IsActive ? "Veljavna" : "Neaktivna")" Tone="@(row.IsActive ? "good" : null)" /></td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>

        <section id="panel-web" role="tabpanel" aria-labelledby="tab-web" tabindex="0" class="section-panel section-stack" hidden="@(Section != "web")">
          <header class="section-heading"><h2>Splet</h2><p>Objava, nazivi in opisi po jezikih, kategorije in atributi.</p></header>
          <ProductChannelPanel PanelId="panel-splet" TabId="tab-web" Title="Splet"
                               StatusText="@StatusLabel(WebStatus)" StatusTone="@Tone(WebStatus)"
                               BlockingCount="@webBlockingCount"
                               WarningCount="@WebIssues.Count(row => row.Severity == "WARNING")"
                               LastValidatedUtc="@Detail.Header.LastValidatedUtc" Fields="@WebFields" Issues="@WebIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" DefaultGroup="Spletna polja"
                               ReadOnly="@(!CanEdit)">
            <Toolbar>
              <label for="product-site">Spletno mesto</label>
              <select id="product-site" class="filter-select" @bind="SelectedSite">
                <option value="">Vsa spletna mesta</option>
                @foreach (var site in WebSites) { <option value="@site">@site</option> }
              </select>
            </Toolbar>
          </ProductChannelPanel>

          @* D2 iz pregleda 2026-09-08 in odločitev uporabnika: kam gre izdelek, ne pove več
             »Objava na spletu« iz SAOP (`Product.WebPublish`), ampak ta potrditvena polja.
             Po njih se ravna tudi spletna validacija (migracija 182). *@
          <section id="panel-spletisca" class="ui-card data-card tab-panel web-shops">
            <div class="subsection-head">
              <h2>Spletišča</h2>
              <span class="muted">Označeno spletišče pomeni, da izdelek tja gre — in da ga spletni profil tega spletišča validira.</span>
            </div>

            @if (WebShops.Count == 0)
            {
              <PimMissing Object="canon.WebSite" What="seznam spletišč" Needs="vsaj eno aktivno spletišče v registru" />
            }
            else
            {
              <ul class="shop-list">
                @foreach (var shop in WebShops)
                {
                  var shopCode = shop.WebShopCode;
                  <li>
                    <label>
                      <input type="checkbox" disabled="@(!CanEdit || ShopBusy)"
                             checked="@ShopDraft(shopCode)"
                             @onchange="args => OnShopChanged(shopCode, args)" />
                      <span class="shop-name">@shop.WebShopName</span>
                      <span class="code-value">@shopCode</span>
                    </label>
                    @if (shop.ChangedBy is not null)
                    {
                      <span class="shop-trace">@shop.ChangedBy · @PimFormat.Ago(shop.ChangedUtc)</span>
                    }
                  </li>
                }
              </ul>

              @if (CanEdit)
              {
                <div class="shop-actions">
                  <button type="button" class="primary-button" disabled="@(!ShopDirty || ShopBusy)" @onclick="SaveWebShopsAsync">
                    Shrani spletišča
                  </button>
                  @if (ShopMessage is not null) { <span class="save-ok" role="status">@ShopMessage</span> }
                  @if (ShopError is not null) { <span class="save-error" role="alert">@ShopError</span> }
                </div>
              }
              else
              {
                <p class="muted">Spremembo spletišč smeta vpisati vlogi ADMIN in CATALOG_EDITOR.</p>
              }
            }
          </section>

        </section>

        @* Zavihek »SAOP endpoint«: celoten zapis, kot ga je poslal ERP, tudi polja, ki jih PIM
           ne hrani. Nabor stolpcev se med podjetji razlikuje, zato je oblika dolga in ne siroka,
           razvrstitev v sklope pa pride iz registra out.SaopXmlField (migracija 141).
           Posnetek se isce po zajetih straneh odgovora in traja nekaj sekund, zato se nalozi
           sele ob odprtju zavihka in ne ob vsakem odprtju kartice. *@
        <section id="panel-saop-endpoint" role="tabpanel" aria-labelledby="tab-saop-endpoint" tabindex="0" class="section-panel section-stack" hidden="@(Section != "saop-endpoint")">
          <header class="section-heading">
            <h2>SAOP endpoint</h2>
            <p>Zapis, kot ga ima ERP. Označene vrstice so odkloni od PIM-a.</p>
          </header>

          <section class="ui-card data-card tab-panel">
            <PimState Loading="SnapshotLoading" Error="@SnapshotError" Empty="false"
                      LoadingText="Iščem zajeti zapis SAOP …">
              @if (Snapshot is not null)
              {
                var head = Snapshot.Head;
                <div class="subsection-head">
                  <h2>Posnetek</h2>
                  <span>
                    @if (head.HasSnapshot)
                    {
                      <text>
                        @head.SourceTable · vir @head.SourceCode · @head.EntityType, stran @head.PageNumber ·
                        prevzeto @(head.ReceivedUtc?.ToLocalTime().ToString("g") ?? "—")
                        @if (head.LastModifiedAtUtc is DateTime changed)
                        {
                          <text>· v SAOP nazadnje spremenjen @changed.ToLocalTime().ToString("g")</text>
                        }
                      </text>
                    }
                    else { <text>posnetka ni</text> }
                  </span>
                </div>

                @if (!head.HasSnapshot)
                {
                  @* Prazna tabela ne pove nicesar; pojasnilo pride iz bralnega modela. *@
                  <p class="card-note">@head.Explanation</p>
                }
                else
                {
                  <p class="card-note">
                    @SnapshotDifferenceCount.ToString("N0") od @Snapshot.Rows.Count.ToString("N0") polj se razlikuje od PIM-a.
                    Polja brez kanonične ustreznice PIM ne hrani; prikazana so, ker so v zapisu ERP-ja.
                  </p>

                  @foreach (var group in Snapshot.Rows.GroupBy(row => row.Section))
                  {
                    <div class="subsection-head snapshot-group"><h3>@group.Key</h3><span>@group.Count().ToString("N0") polj</span></div>
                    <PimTable Caption="@($"Zapis SAOP — sklop {group.Key}")" Columns="SnapshotColumns">
                      <Rows>
                        @foreach (var row in group)
                        {
                          <tr class="@(row.IsDifferent ? "row-different" : null)">
                            <td><span class="code-value">@row.ElementName</span></td>
                            <td>@(row.Value ?? "—")</td>
                            <td>@(row.HasCanonical ? row.PimValue ?? "—" : "")</td>
                            <td>
                              @if (!row.HasCanonical) { <span class="muted">PIM ne hrani</span> }
                              else if (row.IsDifferent) { <PimChip Text="Odklon" Tone="bad" /> }
                              else { <PimChip Text="Se ujema" Tone="good" /> }
                            </td>
                          </tr>
                        }
                      </Rows>
                    </PimTable>
                  }
                }
              }
            </PimState>
          </section>
        </section>

        <section id="panel-media" role="tabpanel" aria-labelledby="tab-media" tabindex="0" class="section-panel section-stack" hidden="@(Section != "media")">
          <header class="section-heading"><h2>Mediji</h2><p>Vse slike in dokumenti izdelka, ne samo glavna slika.</p></header>
          <section class="ui-card tab-panel">
            <div class="subsection-head"><h2>Gradiva</h2><a href="mediji?izdelek=@Detail.Header.ItemId">Vsi mediji tega izdelka</a></div>
            <ProductMediaGallery ProductName="@Detail.Header.Name" Media="@Detail.Media" Documents="@Detail.Documents" />
          </section>
        </section>

        <section id="panel-stock" role="tabpanel" aria-labelledby="tab-stock" tabindex="0" class="section-panel section-stack" hidden="@(Section != "stock")">
          <header class="section-heading"><h2>Zaloga</h2><p>Trenutno stanje razpoložljivosti po skladiščih in virih.</p></header>
          <section class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zaloga</h2><a href="zaloge?isci=@Uri.EscapeDataString(Detail.Header.ItemId)">Odpri poslovni pogled</a></div>
            @if (StockChecks?.IsMissing == true) { <PimMissing Object="intranet.GetStockChecks" What="preverbe zaloge tega artikla" Needs="stock.Snapshot, stock.Position, stock.UnmatchedPosition in potrjene pragove" /> }
            <PimState Empty="@(Detail.Stock.Count == 0)" EmptyText="Izdelek nima aktivnega zalogovnega posnetka.">
              <PimTable Caption="Aktivne zalogovne pozicije izdelka" Columns="StockColumns"><Rows>@foreach (var row in Detail.Stock) { <tr><td>@(row.WarehouseName ?? row.WarehouseCode ?? row.MatchKey)</td><td>@(row.ProviderKind ?? "—")</td><td class="numeric">@row.Quantity.ToString("N2")</td><td class="numeric">@(row.IncomingQuantity?.ToString("N2") ?? "—")</td><td>@(row.AvailabilityDate?.ToLocalTime().ToString("d") ?? "—")</td><td>@PimFormat.Ago(row.SnapshotUtc)</td><td>@StockRule(row)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>

        <section id="panel-quality-history" role="tabpanel" aria-labelledby="tab-quality-history" tabindex="0" class="section-panel section-stack" hidden="@(Section != "quality-history")">
          <header class="section-heading"><h2>Kakovost in zgodovina</h2><p>Odprte zahteve, pot v SAOP, revizijska sled in dokaz o izvoru.</p></header>
          <section id="panel-quality" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Kakovost</h2><span>@Detail.Issues.Count.ToString("N0") odprtih zahtev</span></div>
            <PimState Empty="@(Detail.Issues.Count == 0)" EmptyText="Izdelek nima odprtih validacijskih težav.">
              <PimTable Caption="Odprte težave po nivoju validacije" Columns="IssueColumns">
                <Rows>@foreach (var item in LayerIssues) { <tr><td><PimChip Text="@ValidationLayer.Label(item.Layer)" Tone="@(item.Layer == PimValidationLayer.Komerciala ? "warn" : null)" />@if (item.Shared) { <PimChip Text="SKUPNO" Tone="warn" /> }</td><td>@item.Issue.ProfileCode</td><td><PimChip Text="@item.Issue.Severity" Tone="@(item.Issue.Severity == "ERROR" ? "bad" : "warn")" /></td><td>@item.Issue.FieldCode</td><td>@item.Issue.Message</td><td>@item.Issue.LastDetectedUtc.ToLocalTime().ToString("g")</td></tr> }</Rows>
              </PimTable>
            </PimState>
          </section>

          <section id="panel-saop" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zapisi v SAOP</h2><a href="saop">Odpri skupni pregled</a></div>
            <PimState Empty="@(Detail.Outbound.Count == 0)" EmptyText="Za izdelek ni odhodnih sporočil.">
              <PimTable Caption="Spremembe izdelka na poti v SAOP" Columns="OutboundColumns"><Rows>@foreach (var row in Detail.Outbound) { <tr><td>@row.OutboxMessageId</td><td>@row.FieldSummary</td><td>@row.Operation</td><td><PimChip Text="@StatusLabel(row.Status)" Tone="@Tone(row.Status)" /></td><td class="numeric">@row.AttemptCount</td><td>@Moment(row.SentUtc)</td><td>@Moment(row.VerifiedUtc)</td><td>@Value(row.DriftDetail ?? row.LastAttemptFailureReason ?? row.LastError)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>

          <section id="panel-history" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zgodovina sprememb</h2></div>
            <PimState Empty="@(Detail.History.Count == 0)" EmptyText="Za ta izdelek še ni zabeleženih sprememb sledljivih polj.">
              <PimTable Caption="Revizijska sled sprememb izdelka" Columns="HistoryColumns"><Rows>@foreach (var row in Detail.History) { <tr><td>@row.FieldKey</td><td>@Value(row.OldValue)</td><td>@Value(row.NewValue)</td><td>@row.Owner</td><td>@row.ChangeSource</td><td>@row.ChangedBy</td><td>@row.ChangedAtUtc.ToLocalTime().ToString("g")</td><td>@Value(row.Note)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>

          <section id="panel-origin" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Izvor podatkov</h2></div>
            <PimState Empty="@(Origins.Count == 0)" EmptyText="Za izdelek ni mogoče določiti vhodnega zapisa.">
              <PimTable Caption="Vhodni teki in strani, iz katerih izvirajo podatki" Columns="OriginColumns"><Rows>@foreach (var row in Origins) { <tr><td><a href="zajem/tezave/INBOX/@row.InboxId">@row.SourceCode</a></td><td><a href="zajem/teki/@row.RunId">@ShortId(row.RunId)</a></td><td>@row.EntityType</td><td class="numeric">@row.PageNumber</td><td class="numeric">@row.RecordOrdinal</td><td class="numeric">@row.ExtractedFieldCount</td><td>@row.Status</td><td>@row.ReceivedUtc.ToLocalTime().ToString("g")</td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>
      </div>
    </div>
  }
</PimState>

@code {
  [Parameter] public long ProductId { get; set; }

  ProductCardView? Detail;
  IReadOnlyList<ProductOriginRow> Origins = [];
  IReadOnlyList<WebSiteRow> Sites = [];
  IReadOnlyList<LanguageRow> Languages = [];
  PimReadResult<BusinessCheckRow>? PriceChecks;
  PimReadResult<BusinessCheckRow>? StockChecks;
  bool Loading = true;
  bool HeroImageFailed;
  string? Error;
  string Section = "overview";
  string SelectedSite = "";

  int OrganizationId;
  string OrganizationName = "";

  /// <summary>Ali sme prijavljena vloga karkoli shraniti. Servisi to preverijo se enkrat sami.</summary>
  bool CanEdit;

  /// <summary>Spletisca in oznake zanje; merilo spletne validacije namesto Product.WebPublish.</summary>
  IReadOnlyList<ProductWebShopRow> WebShops = [];
  readonly Dictionary<string, bool> ShopDrafts = new(StringComparer.OrdinalIgnoreCase);
  bool ShopBusy;
  string? ShopMessage;
  string? ShopError;
  bool ShopDirty => ShopDrafts.Count > 0;
  IReadOnlyList<WritableFieldRow> WritableSaopFields = [];

  /// <summary>Nepotrjene spremembe: kljuc polja → nova vrednost. Zivijo, dokler jih uporabnik
  /// ne shrani ali preklice; menjava sklopa jih ne izgubi, ker je kartica en obrazec.</summary>
  readonly Dictionary<string, string?> Drafts = new(StringComparer.OrdinalIgnoreCase);
  readonly Dictionary<string, ProductChannelField> DraftFields = new(StringComparer.OrdinalIgnoreCase);
  bool Busy;
  string? SaveMessage;
  string? SaveError;

  /// <summary>Polja, ki jih je nekdo drug spremenil, odkar smo jih prebrali (migracija 186).</summary>
  readonly List<ProductEditConflict> Conflicts = [];

  static readonly IReadOnlyList<PimCrumb> ProductCrumbs = [new("Izdelki", "izdelki"), new("Kartica")];
  static readonly IReadOnlyList<PimColumn> PriceColumns = [new("Cenik"), new("Neto", true), new("DDV", true), new("Bruto", true), new("Velja od"), new("Stanje")];
  static readonly IReadOnlyList<PimColumn> StockColumns = [new("Skladišče"), new("Vir"), new("Količina", true), new("Prihaja", true), new("Razpoložljivo"), new("Svežina"), new("Min/max")];
  static readonly IReadOnlyList<PimColumn> IssueColumns = [new("Nivo"), new("Profil"), new("Resnost"), new("Zahteva"), new("Sporočilo"), new("Zaznano")];
  static readonly IReadOnlyList<PimColumn> OutboundColumns = [new("ID"), new("Polje"), new("Operacija"), new("Status"), new("Poskusov", true), new("Poslano"), new("Potrjeno"), new("Vzrok/odmik")];
  static readonly IReadOnlyList<PimColumn> HistoryColumns = [new("Polje"), new("Stara vrednost"), new("Nova vrednost"), new("Lastnik"), new("Vir"), new("Spremenil"), new("Čas"), new("Razlog")];
  static readonly IReadOnlyList<PimColumn> OriginColumns = [new("Vir"), new("Tek"), new("Entiteta"), new("Stran", true), new("Zapis", true), new("Polj", true), new("Stanje"), new("Prejeto")];

  IReadOnlyList<string> WebSites => Sites.Where(site => site.IsActive).OrderBy(site => site.SortOrder).Select(site => site.WebSiteCode).ToArray();

  IReadOnlyList<ProductCardIssue> ErpIssues => IssuesFor(PimValidationLayer.ErpSlo, PimValidationLayer.ErpEuThird);
  IReadOnlyList<ProductCardIssue> CommercialIssues => IssuesFor(PimValidationLayer.Komerciala);
  IReadOnlyList<ProductCardIssue> WebIssues => IssuesFor(PimValidationLayer.Splet).Where(row => MatchesSite(row.ProfileCode)).ToList();
  string ErpStatus => StatusFor([PimValidationLayer.ErpSlo, PimValidationLayer.ErpEuThird], Detail?.Header.ErpStatus ?? "PENDING");
  string WebStatus => StatusFor([PimValidationLayer.Splet], Detail?.Header.WebStatus ?? "PENDING", SelectedSite);

  /* Polja kanala nastanejo iz treh virov, da na kartici ni vec praznega mesta:
       1. kar je v bralnem modelu (vrednosti izdelka),
       2. kar je pisljivo v SAOP (register out.SaopXmlField) — to je urejivo prek odhodne vrste,
       3. kar validacija pogresa (odprte tezave) — polje se pokaze, tudi ce vrstice v katalogu ni.
     Tretja tocka je bistvo: doslej je kartica povedala, da polje manjka, ni pa ga bilo mogoce
     izpolniti; zdaj je manjkajoce polje vnosno mesto. */

  WritableFieldRow? Writable(string fieldKey) =>
    WritableSaopFields.FirstOrDefault(row => string.Equals(row.FieldKey, fieldKey, StringComparison.OrdinalIgnoreCase));

  static string FormatOf(WritableFieldRow? writable) => writable?.ValueFormat switch
  {
    "bool" => "bool",
    "decimal4" or "decimal8" => "decimal",
    _ => "text",
  };

  IReadOnlyList<ProductAttributeSetRow> AttributeSet = [];

  bool RequiredField(string fieldKey) => Detail?.Issues.Any(issue =>
    string.Equals(issue.FieldCode, fieldKey, StringComparison.OrdinalIgnoreCase)) == true;

  /// <summary>Polje kanala; ce je pisljivo v SAOP, je urejivo prek odhodne vrste, sicer samo prikaz.</summary>
  ProductChannelField Channel(string label, string fieldKey, string? value, string group, bool inReadModel = true)
  {
    var writable = Writable(fieldKey);
    var stored = Detail?.Fields.FirstOrDefault(row => row.FieldKey == fieldKey);
    var resolved = value ?? stored?.Value;
    return new(label, fieldKey, resolved, stored?.Owner ?? (writable is null ? "—" : "PIM"), null, null,
      Pending(fieldKey), inReadModel,
      writable is null ? ProductFieldEdit.None : ProductFieldEdit.Saop, FormatOf(writable),
      RequiredField(fieldKey), string.IsNullOrWhiteSpace(resolved),
      Hint: group);
  }

  /// <summary>Besedilo izdelka. ERP nazive pise SAOP, zato so ta med pisljivimi polji SAOP.</summary>
  ProductChannelField TextField(string label, string textType, string language, string? value, string group)
  {
    var fieldKey = $"ProductText.{textType}.{language}";
    var writable = Writable(fieldKey);
    var stored = Detail?.Texts.FirstOrDefault(row => row.TextType == textType && row.Language == language);
    var resolved = value ?? stored?.Value;
    var multiline = textType.Contains("DESCRIPTION", StringComparison.OrdinalIgnoreCase);
    return new(label, fieldKey, resolved, stored?.Owner ?? (writable is null ? "PIM" : "SAOP"), null, null,
      Pending(fieldKey), true,
      writable is null ? ProductFieldEdit.Text : ProductFieldEdit.Saop,
      writable is null && multiline ? "multiline" : FormatOf(writable),
      RequiredField(fieldKey), string.IsNullOrWhiteSpace(resolved),
      Language: language, TextType: textType, Hint: group);
  }

  ProductChannelField AttributeField(string attributeCode, string? value, string group)
  {
    var fieldKey = $"ProductAttribute.{attributeCode}";
    return new(attributeCode, fieldKey, value, "PIM", null, null, false, true,
      ProductFieldEdit.Attribute, "text", RequiredField(fieldKey), string.IsNullOrWhiteSpace(value),
      AttributeCode: attributeCode, Hint: group);
  }

  /// <summary>
  /// Polja, ki jih izdelek DEJANSKO ima, pa jih pripravljen seznam kanala ne nasteje.
  ///
  /// Uporabnik 2026-08-31: »Treba bo izpisati vsa polja ki jih ima in potem omogociti
  /// spremembo.« Prej je kartica kazala pripravljen seznam polj in manjkajoce zahteve; kar je
  /// vir poslal poleg tega, je bilo v bazi, na zaslonu pa ne. Zdaj se vsako shranjeno polje
  /// kanala pokaze — tudi tisto, ki ga nihce ni predvidel. Urejanje ostane po istem pravilu
  /// kot pri ostalih poljih: kar je pisljivo v SAOP, je urejivo prek odhodne vrste.
  /// </summary>
  IEnumerable<ProductChannelField> StoredFields(IReadOnlyList<ProductChannelField> known, string prefix, string group)
  {
    if (Detail is null) yield break;
    foreach (var stored in Detail.Fields
      .Where(row => row.FieldKey.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
      .OrderBy(row => row.FieldKey, StringComparer.OrdinalIgnoreCase))
    {
      if (known.Any(row => string.Equals(row.FieldKey, stored.FieldKey, StringComparison.OrdinalIgnoreCase))) continue;
      yield return Channel(FieldLabel(stored.FieldKey), stored.FieldKey, stored.Value, group);
    }
  }

  /// <summary>Manjkajoca obvezna polja tega kanala, ki jih seznam zgoraj se ne pokriva.</summary>
  IEnumerable<ProductChannelField> MissingRequired(IReadOnlyList<ProductChannelField> known, string prefix, string group)
  {
    if (Detail is null) yield break;
    foreach (var code in Detail.Issues
      .Select(issue => issue.FieldCode)
      .Where(code => code.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
      .Distinct(StringComparer.OrdinalIgnoreCase)
      .OrderBy(code => code, StringComparer.OrdinalIgnoreCase))
    {
      if (known.Any(row => string.Equals(row.FieldKey, code, StringComparison.OrdinalIgnoreCase))) continue;
      var parts = code.Split('.');
      if (code.StartsWith("ProductText.", StringComparison.OrdinalIgnoreCase) && parts.Length >= 3)
        yield return TextField($"{TextLabel(parts[1])} ({parts[2]})", parts[1], parts[2], null, group);
      else if (code.StartsWith("ProductAttribute.", StringComparison.OrdinalIgnoreCase) && parts.Length >= 2)
        yield return AttributeField(string.Join('.', parts.Skip(1)), null, group);
      else
        yield return Channel(FieldLabel(code), code, null, group);
    }
  }

  /// <summary>
  /// Partner na kartici: ime in sifra skupaj. Uporabnik 2026-08-28: »treba se dodati ime
  /// dobavitleja in proizvajalca, da se oboje vidi ime in kodo«. Sifra ostane, ker gre ona
  /// nazaj v SAOP; kadar imena za sifro ni, ostane sama sifra — izmisljati je ne gre.
  /// </summary>
  static string? PartnerValue(string? code, string? name) =>
    string.IsNullOrWhiteSpace(code) ? null
    : string.IsNullOrWhiteSpace(name) ? code
    : $"{name} ({code})";

  static string TextLabel(string textType) => textType switch
  {
    "WEB_TITLE" => "Spletni naziv",
    "TITLE_ERP" => "ERP naziv",
    "TITLE_ERP2" => "ERP naziv 2",
    "SEARCH_NAME" => "Ime za iskanje",
    "DESCRIPTION" => "Spletni opis",
    "DESCRIPTION_K" => "Kratek opis",
    "DESCRIPTION_KD" => "Kratek opis (dodatni)",
    "DESCRIPTION_KK" => "Ključne lastnosti",
    "DESCRIPTION_O" => "Opomba",
    _ => textType,
  };

  static string FieldLabel(string fieldKey) => fieldKey switch
  {
    "Product.ItemID" => "Šifra artikla",
    "Product.EAN" => "EAN",
    "Product.UoM" => "Merska enota",
    "Product.ItemGroup" => "Skupina artikla",
    "Product.Department" => "ABC klasifikacija",
    "Product.DiscountGroup" => "Skupina popusta",
    "Product.AccountingGroup" => "Knjižna skupina",
    "Product.Supplier" => "Dobavitelj",
    "Product.Manufacturer" => "Proizvajalec",
    "Product.IsActive" => "Aktiven",
    "Product.WebPublish" => "Objava na spletu",
    "ProductAttribute.Garancija" => "Garancija",
    "ProductCommercial.NetWeight" => "Neto teža",
    "ProductCommercial.GrossWeight" => "Bruto teža",
    "ProductCommercial.CustomsTariff" => "Carinska tarifa",
    "ProductCommercial.CountryOfOrigin" => "Država porekla",
    "ProductCommercial.Dimensions" => "Dimenzije",
    "ProductCommercial.Volume" => "Volumen",
    "ProductCommercial.PackageLength" => "Dolžina paketa",
    "ProductCommercial.PackageWidth" => "Širina paketa",
    "ProductCommercial.PackageHeight" => "Višina paketa",
    "ProductCommercial.DimensionUnit" => "Enota mer",
    "ProductCommercial.Pak1" => "Pakiranje 1",
    "ProductCommercial.Pak2" => "Pakiranje 2",
    _ => fieldKey,
  };

  /// <summary>
  /// ERP kanal — kar gre v SAOP. Razdelitev na kanale je prevzeta iz starega intraneta
  /// PIM_test (`ProductCatalogEditorSections.razor`, kartice »ERP — Slovenija«,
  /// »ERP — EU / tretje države«, »Pakiranje«, »Dimenzije pakiranja«), ker je bila tam
  /// poslovno preverjena: ERP nosi identiteto, sifrante ERP, partnerja, davek, nazive za
  /// ERP ter logistiko, ki jo zahteva izvoz (teze, tarifa, poreklo, pakiranje, dimenzije).
  /// Uvrstitev artikla in objava sta komercialni odlocitvi in sta zato na svojem kanalu.
  /// </summary>
  IReadOnlyList<ProductChannelField> ErpFields
  {
    get
    {
      if (Detail is null) return [];
      const string slovenia = "ERP — Slovenija";
      const string extra = "Dodatno (ERP iskanje, drugi naziv)";
      const string names = "Nazivi za ERP po jezikih";
      const string export = "ERP — EU / tretje države";
      const string packaging = "Pakiranje";
      const string dimensions = "Dimenzije pakiranja";
      var commercial = Detail.Commercial;
      var rows = new List<ProductChannelField>
      {
        Channel("Šifra artikla", "Product.ItemID", Detail.Header.ItemId, slovenia),
        Channel("EAN", "Product.EAN", Detail.Header.Ean, slovenia),
        TextField("ERP naziv (sl)", "TITLE_ERP", "sl", null, slovenia),
        Channel("Knjižna skupina", "Product.AccountingGroup", Detail.Header.AccountingGroup, slovenia),
        Channel("Skupina popusta", "Product.DiscountGroup", Detail.Header.DiscountGroup, slovenia),
        Channel("Merska enota", "Product.UoM", Detail.Header.Uom, slovenia),
        Channel("Dobavitelj", "Product.Supplier", PartnerValue(Detail.Header.Supplier, Detail.Header.SupplierName), slovenia),
        Channel("Proizvajalec", "Product.Manufacturer", PartnerValue(Detail.Header.Manufacturer, Detail.Header.ManufacturerName), slovenia),
        Channel("Davčna stopnja", "Product.VatRate", null, slovenia, inReadModel: false),
        Channel("Izloči iz rezervacije zaloge", "ProductPlanning", null, slovenia, inReadModel: false),
        Channel("Garancija", "ProductAttribute.Garancija",
          Detail.Attributes.FirstOrDefault(row => string.Equals(
            row.AttributeCode, "Garancija", StringComparison.OrdinalIgnoreCase))?.Value, slovenia),

        TextField("ERP naziv 2 (sl)", "TITLE_ERP2", "sl", null, extra),
        TextField("Ime za iskanje", "SEARCH_NAME", "sl", null, extra),

        // Za izvoz so obvezna se logisticna polja — v PIM_test svoja kartica, tu svoja skupina.
        Channel("Neto teža", "ProductCommercial.NetWeight", Number(commercial?.NetWeight), export),
        Channel("Bruto teža", "ProductCommercial.GrossWeight", Number(commercial?.GrossWeight), export),
        Channel("Carinska / tarifna oznaka", "ProductCommercial.CustomsTariff", commercial?.CustomsTariff, export),
        Channel("Država porekla", "ProductCommercial.CountryOfOrigin", commercial?.CountryOfOrigin, export),

        Channel("Količina pakiranja", "ProductCommercial.Pak1", Number(commercial?.Pak1), packaging),
        Channel("Količina pakiranja (2)", "ProductCommercial.Pak2", Number(commercial?.Pak2), packaging),
        Channel("Kosov v paketu", "Product.PiecesInPackage", null, packaging, inReadModel: false),

        Channel("Dolžina", "ProductCommercial.PackageLength", Number(commercial?.PackageLength), dimensions),
        Channel("Širina", "ProductCommercial.PackageWidth", Number(commercial?.PackageWidth), dimensions),
        Channel("Višina", "ProductCommercial.PackageHeight", Number(commercial?.PackageHeight), dimensions),
        Channel("Enota mer", "ProductCommercial.DimensionUnit", commercial?.DimensionUnit, dimensions),
        Channel("Prostornina", "ProductCommercial.Volume", Number(commercial?.Volume), dimensions),
        Channel("Dimenzije artikla", "ProductCommercial.Dimensions", commercial?.Dimensions, dimensions),
      };

      // Slovenski naziv in naziv 2 sta ze zgoraj; tu so preostali jeziki, da se manjkajoc
      // prevod da vpisati tudi tam, kjer ga nihce ne zahteva.
      foreach (var language in ErpLanguages.Where(code => !string.Equals(code, "sl", StringComparison.OrdinalIgnoreCase)))
      {
        rows.Add(TextField($"ERP naziv ({language})", "TITLE_ERP", language, null, names));
        rows.Add(TextField($"ERP naziv 2 ({language})", "TITLE_ERP2", language, null, names));
      }

      // Kanonicne kode ProductCommercial.* zdaj zivijo tu, zato se tu tudi dopolnita
      // seznam shranjenih polj in seznam manjkajocih zahtev.
      rows.AddRange(StoredFields(rows, "Product.", "Druga polja iz vira"));
      rows.AddRange(StoredFields(rows, "ProductCommercial.", "Druga polja iz vira"));
      rows.AddRange(MissingRequired(rows, "Product.", "Manjka za ERP"));
      rows.AddRange(MissingRequired(rows, "ProductCommercial.", "Manjka za ERP"));
      return rows;
    }
  }

  /// <summary>
  /// Komercialni kanal — uvrstitev artikla, objava in nabavni pogoji. V PIM_test je bila to
  /// kartica »Komerciala — klasifikacija in objava«: ABC klasifikacija in skupina artikla sta
  /// komercialni razvrstitvi, ne sifranta ERP, aktivnost pa je prodajna odlocitev. Cene in
  /// zaloga imata v tem intranetu svoje strani in svoj zavihek, zato ju tu ni.
  /// </summary>
  IReadOnlyList<ProductChannelField> CommercialFields
  {
    get
    {
      if (Detail is null) return [];
      const string classification = "Klasifikacija in objava";
      const string purchase = "Nabava";
      const string accounting = "Zaloga in knjiženje";
      var rows = new List<ProductChannelField>
      {
        Channel("ABC klasifikacija", "Product.Department", Detail.Header.Department, classification),
        Channel("Rabatna / skupina artikla", "Product.ItemGroup", Detail.Header.ItemGroup, classification),
        Channel("Aktivnost", "Product.IsActive", YesNo(Detail.Header.IsActive), classification),
        Channel("Nabavni podatki", "ProductCommercial.Purchase", null, purchase, inReadModel: false),
        Channel("Knjigovodske šifre", "ProductStockAccounting", Detail.Header.AccountingGroup, accounting),
      };

      rows.AddRange(StoredFields(rows, "ProductPrice.", "Cenovna polja"));
      return rows;
    }
  }

  IReadOnlyList<ProductChannelField> WebFields
  {
    get
    {
      if (Detail is null) return [];
      const string publication = "Objava";
      const string titles = "Nazivi in opisi";
      const string categories = "Kategorije";
      const string attributes = "Atributi";
      var rows = new List<ProductChannelField>
      {
        Channel("Objava na spletu", "Product.WebPublish", YesNo(Detail.Header.WebPublish), publication),
      };

      // Nazivi in opisi po jezikih: prikazani so vsi jeziki spletnih kanalov, tudi tam, kjer
      // besedila se ni — sicer manjkajocega prevoda ni mogoce vpisati.
      foreach (var textType in WebTextTypes)
        foreach (var language in WebLanguages)
          rows.Add(TextField($"{TextLabel(textType)} ({language})", textType, language, null, titles));

      rows.AddRange(Detail.Categories
        .Where(row => string.IsNullOrWhiteSpace(SelectedSite) || string.Equals(row.WebSite, SelectedSite, StringComparison.OrdinalIgnoreCase))
        .Select(row => new ProductChannelField($"Kategorija ({row.WebSite})", $"ProductCategory.{row.WebSite}",
          row.CategoryPath, row.Owner, null, null, false, true, ProductFieldEdit.None, "text", false, false,
          Hint: categories)));
      rows.Add(new("Slike za splet", "ProductMedia", Detail.Media.Count.ToString("N0"), "—", null, null, false, true,
        ProductFieldEdit.None, "text", false, false, Hint: categories));
      rows.Add(new("Spletni kanali", "canon.WebSite", string.Join(", ", WebSites), "—", null, null, false, true,
        ProductFieldEdit.None, "text", false, false, Hint: categories));

      // Nabor atributov po kategoriji (147). Ce kategorija izdelka nabor doloca, so atributi iz
      // nabora v svoji skupini (tudi tisti brez vrednosti, da jih je mogoce vpisati), ostali pa
      // ostanejo vidni v skupini "izven nabora" — na splet ne gredo (out.GetExportRows).
      var inSet = AttributeSet
        .Where(row => row.Level != "EXCLUDED")
        .GroupBy(row => row.AttributeName, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);
      if (inSet.Count > 0)
      {
        const string categorySet = "Atributi kategorije (nabor)";
        const string outsideSet = "Atributi izven nabora — ne gredo na splet";
        foreach (var setRow in inSet.Values.OrderBy(row => row.Level == "REQUIRED" ? 0 : 1).ThenBy(row => row.AttributeName, StringComparer.CurrentCulture))
        {
          var stored = Detail.Attributes.FirstOrDefault(row => string.Equals(row.AttributeCode, setRow.AttributeName, StringComparison.OrdinalIgnoreCase));
          var attributeField = AttributeField(setRow.AttributeName, stored?.Value, categorySet);
          rows.Add(attributeField with { Label = $"{setRow.AttributeName} ({(setRow.Level == "REQUIRED" ? "obvezen" : "priporočen")})",
            Required = attributeField.Required || setRow.Level == "REQUIRED" });
        }
        rows.AddRange(Detail.Attributes
          .Where(row => !inSet.ContainsKey(row.AttributeCode))
          .OrderBy(row => row.AttributeCode, StringComparer.CurrentCulture)
          .Select(row => AttributeField(row.AttributeCode, row.Value, outsideSet)));
      }
      else
      {
        rows.AddRange(Detail.Attributes
          .OrderBy(row => row.AttributeCode, StringComparer.CurrentCulture)
          .Select(row => AttributeField(row.AttributeCode, row.Value, attributes)));
      }

      rows.AddRange(StoredFields(rows, "ProductText.", "Druga besedila iz vira"));
      rows.AddRange(MissingRequired(rows, "ProductText.", "Manjka za splet"));
      rows.AddRange(MissingRequired(rows, "ProductAttribute.", "Manjka za splet"));
      return rows;
    }
  }

  /// <summary>Jeziki, ki jih kartica ponudi za vnos: tisti, ki so ze v izdelku, in tisti, ki jih zahteva validacija.</summary>
  IReadOnlyList<string> WebLanguages => LanguagesFor("WEB_TITLE");
  IReadOnlyList<string> ErpLanguages => LanguagesFor("TITLE_ERP");

  /// <summary>
  /// Jeziki, ki jih kartica ponudi za vnos. Uporabnik 2026-08-28: »Nazivi tako spletni kot ERP
  /// morajo imati vse jezike.« Prej so bili ponujeni samo jeziki, ki jih je izdelek ze imel ali
  /// jih je zahtevala validacija — manjkajocega prevoda zato ni bilo mogoce dodati tam, kjer ga
  /// nihce ni zahteval. Zdaj je izhodisce register canon.Language za to podjetje; kar je v
  /// izdelku poleg registra, se ne izgubi. Red je sl, en, de, hr, it (PimLanguages).
  /// </summary>
  IReadOnlyList<string> LanguagesFor(string textType)
  {
    if (Detail is null) return ["sl"];
    return PimLanguages.Order(RegisteredLanguages
      .Concat(Detail.Texts.Where(row => row.TextType == textType).Select(row => row.Language))
      .Concat(Detail.Issues.Select(issue => issue.FieldCode)
        .Where(code => code.StartsWith($"ProductText.{textType}.", StringComparison.OrdinalIgnoreCase))
        .Select(code => code.Split('.').Last()))
      .Append("sl"));
  }

  /// <summary>Jeziki iz registra tega podjetja; prazen seznam pomeni, da register ni dosegljiv.</summary>
  IReadOnlyList<string> RegisteredLanguages =>
    Languages.Where(row => row.IsActive).Select(row => row.LanguageCode).ToArray();

  /// <summary>Vrste spletnih besedil, ki jih izdelek ze ima ali jih zahteva validacija; brez ERP nazivov.</summary>
  IReadOnlyList<string> WebTextTypes
  {
    get
    {
      if (Detail is null) return ["WEB_TITLE"];
      return Detail.Texts.Select(row => row.TextType)
        .Concat(Detail.Issues.Select(issue => issue.FieldCode)
          .Where(code => code.StartsWith("ProductText.", StringComparison.OrdinalIgnoreCase))
          .Select(code => code.Split('.').Skip(1).FirstOrDefault() ?? ""))
        .Where(type => type.Length > 0 && !type.StartsWith("TITLE_ERP", StringComparison.OrdinalIgnoreCase))
        .Append("WEB_TITLE")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(type => type == "WEB_TITLE" ? 0 : 1).ThenBy(type => type, StringComparer.Ordinal)
        .ToList();
    }
  }

  IEnumerable<(PimValidationLayer Layer, ProductCardIssue Issue, bool Shared)> LayerIssues => Detail is null ? [] :
    Detail.Issues.SelectMany(issue => ProfileLayers(issue.ProfileCode).Select(layer => (layer, issue, IsShared(issue.ProfileCode))))
      .OrderBy(row => row.layer).ThenByDescending(row => row.issue.Severity == "ERROR").ThenBy(row => row.issue.ProfileCode);

  protected override Task OnParametersSetAsync() => LoadAsync();

  async Task LoadAsync()
  {
    Loading = true; Error = null; Detail = null; Origins = []; HeroImageFailed = false;
    Snapshot = null; SnapshotError = null;
    CanEdit = PimPolicies.Allows((await Authentication.GetAuthenticationStateAsync()).User, PimPolicies.CatalogWrite);
    ShopDrafts.Clear();
    ShopMessage = null;
    ShopError = null;
    try
    {
      // Kartica je dosegljiva iz seznama vseh podjetij, zato obseg dolocì izdelek sam;
      // privzeto podjetje bi tuji izdelek prikazalo kot neobstojec.
      var organization = await Data.GetProductOrganizationAsync(ProductId);
      if (organization is null) { Error = "Izdelek s to oznako ne obstaja."; return; }
      OrganizationId = organization.OrganizationId;
      OrganizationName = organization.Name;
      var cardTask = Workbench.GetProductCardAsync(organization.OrganizationId, ProductId, "sl");
      var originTask = Workbench.GetProductOriginAsync(organization.OrganizationId, ProductId);
      var priceTask = Features.GetPriceChecksAsync(organization.OrganizationId, ProductId);
      var stockTask = Features.GetStockChecksAsync(organization.OrganizationId, ProductId);
      var sitesTask = Catalog.GetWebSitesAsync();
      // Register jezikov, ne samo jeziki, ki jih izdelek ze ima: nazivi morajo imeti vse jezike.
      var languagesTask = Catalog.GetLanguagesAsync(organization.OrganizationId);
      var writableTask = SaopWrite.GetWritableFieldsAsync(organization.OrganizationId);
      // Nabor atributov po kategoriji (147): kateri atributi sodijo k izdelku in kateri manjkajo.
      var attributeSetTask = Workbench.GetProductAttributeSetAsync(ProductId);
      // Spletisca (182): oznaka na izdelku pove, kam gre in kdo ga validira.
      var shopTask = Edits.GetWebShopsAsync(ProductId);
      await Task.WhenAll(cardTask, originTask, priceTask, stockTask, sitesTask, languagesTask, writableTask, attributeSetTask, shopTask);
      Detail = await cardTask; Origins = await originTask; PriceChecks = await priceTask; StockChecks = await stockTask;
      Sites = await sitesTask; Languages = await languagesTask; WritableSaopFields = await writableTask;
      AttributeSet = await attributeSetTask; WebShops = await shopTask;
      var fragment = new Uri(Navigation.Uri).Fragment.TrimStart('#');
      if (Sections.Contains(fragment)) Section = fragment;
      if (Section == "saop-endpoint") _ = LoadSnapshotAsync();
    }
    catch { Error = "Kartice izdelka trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  /* Urejanje ima dve poti in ena ne sme prevzeti druge:
       - polje, ki ga PIM pise nazaj v SAOP, gre v odhodno vrsto in caka odobritev,
       - besedilo in lastnost, ki sta last PIM, gresta naravnost v katalog in takoj revalidirata.
     Kartica zbere oboje v en gumb, izid pa pove loceno, da uporabnik ve, kaj je ze veljavno
     in kaj se caka. */

  void OnFieldChanged((ProductChannelField Field, string? Value) change)
  {
    if (!CanEdit) return;
    SaveMessage = null;
    SaveError = null;
    var current = change.Value?.Trim();
    var original = change.Field.Value?.Trim();
    if (string.Equals(current ?? "", original ?? "", StringComparison.Ordinal))
    {
      Drafts.Remove(change.Field.FieldKey);
      DraftFields.Remove(change.Field.FieldKey);
      return;
    }

    Drafts[change.Field.FieldKey] = current;
    DraftFields[change.Field.FieldKey] = change.Field;
  }

  void DiscardChanges()
  {
    Drafts.Clear();
    DraftFields.Clear();
    SaveMessage = null;
    SaveError = null;
  }

  async Task SaveChangesAsync()
  {
    if (Drafts.Count == 0 || Detail is null || Busy) return;
    if (!CanEdit) { SaveError = "Tvoja vloga ne dovoljuje urejanja kartice."; return; }
    Busy = true;
    SaveMessage = null;
    SaveError = null;
    Conflicts.Clear();
    try
    {
      var actor = await ActorAsync();
      var note = $"Kartica izdelka {Detail.Header.ItemId}";
      var outcome = new List<string>();

      var texts = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Text).ToList();
      if (texts.Count > 0)
      {
        var result = await Edits.SaveTextsAsync(OrganizationId, ProductId,
          texts.Select(field => new ProductTextEdit(field.Language!, field.TextType!, Drafts[field.FieldKey],
            field.Value, CheckExpected: true)), actor, note);
        outcome.Add($"{result.ChangedCount:N0} besedil shranjenih");
        Conflicts.AddRange(result.Conflicts);
      }

      var attributes = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Attribute).ToList();
      if (attributes.Count > 0)
      {
        var result = await Edits.SaveAttributesAsync(OrganizationId, ProductId,
          attributes.Select(field => new ProductAttributeEdit(field.AttributeCode!, Drafts[field.FieldKey],
            field.Value, CheckExpected: true)), actor, note);
        outcome.Add($"{result.ChangedCount:N0} lastnosti shranjenih");
        Conflicts.AddRange(result.Conflicts);
      }

      var saop = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Saop).ToList();
      if (saop.Count > 0)
      {
        var result = await SaopWrite.EnqueueAsync(OrganizationId,
          saop.Select(field => (Detail.Header.ItemId, field.FieldKey, Drafts[field.FieldKey])), actor, "CARD", note);
        outcome.Add(result.Rejected == 0
          ? $"{result.Queued:N0} polj uvrščenih v vrsto za SAOP (skupina {result.OutboundBatchId})"
          : $"{result.Queued:N0} polj v vrsti za SAOP, {result.Rejected:N0} zavrnjenih (skupina {result.OutboundBatchId})");
      }

      Drafts.Clear();
      DraftFields.Clear();
      SaveMessage = string.Join(" · ", outcome) + ".";
      await LoadAsync();
    }
    catch (Exception exception)
    {
      // Procedura zavrne zapis, ki bi sel mimo SAOP, z govorno napako; ta mora priti do uporabnika.
      SaveError = exception is Microsoft.Data.SqlClient.SqlException sql && sql.Number is 52401 or 52402
        ? sql.Message
        : "Sprememb ni bilo mogoče shraniti.";
    }
    finally
    {
      Busy = false;
    }
  }

  bool ShopDraft(string code) =>
    ShopDrafts.TryGetValue(code, out var draft)
      ? draft
      : WebShops.FirstOrDefault(shop => string.Equals(shop.WebShopCode, code, StringComparison.OrdinalIgnoreCase))?.IsPublished ?? false;

  void OnShopChanged(string code, ChangeEventArgs args)
  {
    if (!CanEdit) return;
    ShopMessage = null;
    ShopError = null;
    var value = args.Value is bool flag && flag;
    var original = WebShops.FirstOrDefault(shop => string.Equals(shop.WebShopCode, code, StringComparison.OrdinalIgnoreCase))?.IsPublished ?? false;
    if (value == original) ShopDrafts.Remove(code);
    else ShopDrafts[code] = value;
  }

  async Task SaveWebShopsAsync()
  {
    if (!CanEdit || ShopDrafts.Count == 0 || Detail is null || ShopBusy) return;
    ShopBusy = true;
    ShopMessage = null;
    ShopError = null;
    try
    {
      var published = await Edits.SaveWebShopsAsync(OrganizationId, ProductId,
        ShopDrafts.Select(draft => (draft.Key, draft.Value)), await ActorAsync(),
        $"Kartica izdelka {Detail.Header.ItemId}");
      ShopDrafts.Clear();
      ShopMessage = published == 0
        ? "Izdelek ni na nobenem spletišču; spletni profili ga ne validirajo."
        : $"Shranjeno. Izdelek gre na {published} spletišč(a); validacija je osvežena.";
      await LoadAsync();
    }
    catch (UnauthorizedAccessException)
    {
      ShopError = "Tvoja vloga ne dovoljuje urejanja spletišč.";
    }
    catch
    {
      ShopError = "Spletišč ni bilo mogoče shraniti. Stanje ni bilo spremenjeno.";
    }
    finally
    {
      ShopBusy = false;
    }
  }

  async Task<string> ActorAsync()
  {
    var state = await Authentication.GetAuthenticationStateAsync();
    return state.User.Identity?.Name ?? "neznan";
  }

  /// <summary>
  /// Skupine, ki se izrisejo v natanko dveh stolpcih. Uporabnik 2026-08-31: »ERP nazive bi dal
  /// po dva stolpca«. Nazivi so po jezikih pari (naziv in naziv 2), zato dva stolpca postavita
  /// par v isto vrstico; samodejna mreza jih je razbila po sirini zaslona.
  /// </summary>
  static readonly string[] TwoColumnGroups = ["Nazivi za ERP"];

  static readonly string[] Sections = ["overview", "core", "commercial", "web", "saop-endpoint", "media", "stock", "quality-history"];

  /// <param name="Count">Samo stevilo tezav, pri katerih uporabnika caka dejanje.</param>
  sealed record CardSection(string Key, string Label, int? Count, string? Tone = null);

  /* Lokalna navigacija je zapisana kot oznaka in ne sestavljena v RenderTreeBuilder. To ni slog, ampak
     napaka, ki je bila vidna: izoliran slog Blazorja doda oznako obsega samo elementom iz
     datoteke .razor, zato gumbi, sestavljeni v kodi, niso dobili nobenega sloga in so bili
     videti kot goli gumbi brskalnika. */
  IReadOnlyList<CardSection> SectionList => Detail is null ? [] :
  [
    new("overview", "Pregled", null),
    new("core", "ERP", null),
    // A7, uporabnik 2026-08-31: »komercialne podatke in pa splet podatke bi locili«.
    new("commercial", "Komerciala", CommercialIssues.Count, Tone: "warn"),
    new("web", "Splet", WebIssues.Count(row => row.Severity == "ERROR"), Tone: "bad"),
    // Kaj ima ERP v resnici. Stevec je stevilo odklonov, in sicer sele takrat, ko je posnetek
    // nalozen — pred tem ni podatka in izmisljene nicle ne kazemo.
    new("saop-endpoint", "SAOP endpoint", Snapshot is null ? (int?)null : SnapshotDifferenceCount, Tone: "bad"),
    // Uporabnik 2026-08-28: »Zakaj imava medij in zaloga skupaj — ne vem«. Nista isto:
    // mediji so vsebina izdelka, zaloga je trenutno stanje iz drugega vira. Locena sklopa.
    new("media", "Mediji", Detail.Media.Count + Detail.Documents.Count),
    new("stock", "Zaloga", Detail.Stock.Count),
    new("quality-history", "Kakovost in zgodovina", Detail.Issues.Count(row => row.Severity == "ERROR"), Tone: "bad"),
  ];

  SaopEndpointSnapshot? Snapshot;
  bool SnapshotLoading;
  string? SnapshotError;

  int SnapshotDifferenceCount => Snapshot?.Rows.Count(row => row.IsDifferent) ?? 0;

  static readonly IReadOnlyList<PimColumn> SnapshotColumns =
    [new("Element"), new("Vrednost v SAOP"), new("Vrednost v PIM"), new("Ujemanje")];

  void SelectSection(string section)
  {
    Section = section;
    Navigation.NavigateTo($"izdelki/{ProductId}#{section}", replace: true);
    if (section == "saop-endpoint") _ = LoadSnapshotAsync();
  }

  /// <summary>Posnetek se isce po zajetih straneh odgovora, zato se nalozi na zahtevo in samo enkrat.</summary>
  async Task LoadSnapshotAsync()
  {
    if (Snapshot is not null || SnapshotLoading || Detail is null) return;
    SnapshotLoading = true; SnapshotError = null;
    StateHasChanged();
    try
    {
      Snapshot = await SaopSnapshot.GetAsync(OrganizationId, Detail.Header.ItemId);
    }
    catch { SnapshotError = "Posnetka zapisa iz SAOP trenutno ni mogoče prebrati."; }
    finally { SnapshotLoading = false; StateHasChanged(); }
  }
  void HeroFailed() => HeroImageFailed = true;
  ProductChannelField Field(string label, string key, string? value, bool inModel = true)
  {
    var field = Detail?.Fields.FirstOrDefault(row => row.FieldKey == key);
    return new(label, key, value ?? field?.Value, field?.Owner ?? "—", null, null, Pending(key), inModel);
  }
  bool Pending(string key) => Detail?.PendingOverlays.Any(row => row.FieldKey == key) == true;
  string OwnerFor(string key) => Detail?.Fields.FirstOrDefault(row =>
    string.Equals(row.FieldKey, key, StringComparison.OrdinalIgnoreCase))?.Owner ?? "PIM";
  IReadOnlyList<PimValidationLayer> ProfileLayers(string profileCode)
  {
    var profile = Detail?.Profiles.FirstOrDefault(row => row.ProfileCode == profileCode);
    return profile is null ? [] : ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb);
  }
  bool IsShared(string profileCode) => Detail?.Profiles.Any(row => row.ProfileCode == profileCode && ValidationLayer.IsShared(row.Scope)) == true;
  IReadOnlyList<ProductCardIssue> IssuesFor(params PimValidationLayer[] layers) => Detail is null ? [] : Detail.Issues
    .Where(issue => ProfileLayers(issue.ProfileCode).Any(layers.Contains)).DistinctBy(issue => issue.ProductIssueId).ToList();
  string StatusFor(IReadOnlyList<PimValidationLayer> layers, string fallback, string? site = null)
  {
    if (Detail is null) return fallback;
    var profiles = Detail.Profiles.Where(profile => ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).Any(layers.Contains));
    if (!string.IsNullOrWhiteSpace(site)) profiles = profiles.Where(profile => ValidationLayer.IsShared(profile.Scope) || MatchesSite(profile.ProfileCode));
    var statuses = profiles.Select(profile => profile.Status).ToList();
    return statuses.Count == 0 ? fallback : statuses.Any(status => status == "INVALID") ? "INVALID" : statuses.Any(status => status != "VALID") ? "PENDING" : "VALID";
  }
  bool MatchesSite(string profileCode) => string.IsNullOrWhiteSpace(SelectedSite) || Normalize(profileCode).Contains(Normalize(SelectedSite), StringComparison.OrdinalIgnoreCase) || IsShared(profileCode);
  static string Normalize(string value) => new(value.Where(char.IsLetterOrDigit).ToArray());
  static string StockRule(ProductCardStock row) => row.MinimumStock is null && row.MaximumStock is null ? "—" : $"{Number(row.MinimumStock)} / {Number(row.MaximumStock)}";
  static string Moment(DateTime? value) => value?.ToLocalTime().ToString("g") ?? "—";
  static string YesNo(bool value) => value ? "Da" : "Ne";
  static string Flag(bool value) => value ? "true" : "false";
  static string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
  static string Number(decimal? value) => value?.ToString("N2") ?? "—";
  static string Measure(decimal? value, string unit) => value is null ? "—" : $"{value:N2} {unit}";
  static string ShortId(Guid value) => value.ToString("N")[..8];
  static string? OwnerTone(string owner) => owner switch { "PIM" => "good", "SAOP" => "warn", _ => null };
  static string? Tone(string value) => value switch { "VALID" or "Verified" or "Succeeded" or "Processed" => "good", "PENDING" or "Pending" or "PendingApproval" or "Retry" or "Sending" or "Sent" => "warn", "INVALID" or "Error" or "Dead" or "Drift" or "Failed" or "Quarantined" or "Cancelled" => "bad", _ => null };
  static string StatusLabel(string value) => value switch { "VALID" => "Veljavno", "INVALID" => "Neveljavno", "PENDING" => "Čaka izračun", "PendingApproval" => "Čaka odobritev", "Pending" => "V vrsti", "Sent" => "Poslano, nepotrjeno", "Verified" => "Potrjeno", "Drift" => "Odklon", "Dead" => "Mrtvo", "Retry" => "Ponovni poskus", _ => value };
