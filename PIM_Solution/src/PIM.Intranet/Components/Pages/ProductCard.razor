  /// <summary>Šifrant atributov se prebere šele ob prvem odprtju izbirnika — kartica ga sicer ne potrebuje.</summary>
  async Task EnsureAttributeOptionsAsync()
  {
    if (AttributeOptions.Count > 0) return;
    try { AttributeOptions = await CategoryTree.GetAttributeOptionsAsync(); AttributeOptionsError = null; }
    catch { AttributeOptionsError = "Šifranta atributov trenutno ni mogoče prebrati."; }
