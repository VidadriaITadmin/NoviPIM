  /// <summary>
  /// Skupine, ki se izrisejo v natanko dveh stolpcih. Uporabnik 2026-08-31: »ERP nazive bi dal
  /// po dva stolpca«. Nazivi so po jezikih pari (naziv in naziv 2), zato dva stolpca postavita
  /// par v isto vrstico; samodejna mreza jih je razbila po sirini zaslona.
  /// </summary>
  static readonly string[] TwoColumnGroups = ["Nazivi za ERP"];

  static readonly string[] Sections = ["overview", "core", "commercial", "web", "saop-endpoint", "media", "stock", "quality-history"];

  /// <param name="Count">Samo stevilo tezav, pri katerih uporabnika caka dejanje.</param>
  /// <param name="Title">Kaj število pomeni, z besedami (2026-09-28: »1« pri Zalogi je bral kot opozorilo).</param>
  /// <param name="Tone">bad = ustavi objavo, warn = opozorilo, null = samo število vsebine (sivo).</param>
  sealed record CardSection(string Key, string Label, int? Count, string? Tone = null, string? Title = null);

  /// <summary>Značka zavihka po težavah: napake imajo prednost pred opozorili; brez težav ni značke.</summary>
  /// <summary>Težava ustavi objavo: napaka v profilu, ki blokira ERP ali splet (isto pravilo kot panel kanala).</summary>
  static bool Blocking(ProductCardIssue issue) => issue.Severity == "ERROR" && (issue.BlocksErp || issue.BlocksWeb);

  /// <summary>Prazno polje, ki ustavi objavo / ki je samo priporočeno — isto pravilo kot povzetek v ProductChannelPanel.</summary>
  static bool NeedsValue(ProductChannelField field) => field.Required && field.Missing;
  static bool ShouldHaveValue(ProductChannelField field) => field.Recommended && !field.Required && field.Missing;

  static CardSection IssueSection(string key, string label, int errors, int warnings) =>
    errors > 0 ? new(key, label, errors, "bad", PimFormat.Count(errors, "napaka ustavi objavo", "napaki ustavita objavo", "napake ustavijo objavo", "napak ustavi objavo") + (warnings > 0 ? " · " + PimFormat.Count(warnings, "opozorilo", "opozorili", "opozorila", "opozoril") : ""))
    : warnings > 0 ? new(key, label, warnings, "warn", PimFormat.Count(warnings, "opozorilo — objave ne ustavi", "opozorili — objave ne ustavita", "opozorila — objave ne ustavijo", "opozoril — objave ne ustavijo"))
    : new(key, label, null);

  /* Lokalna navigacija je zapisana kot oznaka in ne sestavljena v RenderTreeBuilder. To ni slog, ampak
     napaka, ki je bila vidna: izoliran slog Blazorja doda oznako obsega samo elementom iz
     datoteke .razor, zato gumbi, sestavljeni v kodi, niso dobili nobenega sloga in so bili
     videti kot goli gumbi brskalnika. */
  IReadOnlyList<CardSection> SectionList => Detail is null ? [] :
  [
    new("overview", "Pregled", null),
    // 2026-09-28: ERP zavihek prej ni imel značke, čeprav je imel napake; zdaj vsi trije kanali po istem pravilu.
    // Značke kanalov štejejo prazna polja NA TEM ZAVIHKU (2026-09-28), enako kot povzetek na zavihku:
    // Pak1 je v komercialnem profilu, polje pa stoji na ERP — značka »2« je bila na Komerciali, kjer polja ni.
    IssueSection("core", "ERP", ErpFields.Count(NeedsValue), ErpFields.Count(ShouldHaveValue)),
    // A7, uporabnik 2026-08-31: »komercialne podatke in pa splet podatke bi locili«.
    IssueSection("commercial", "Komerciala", CommercialFields.Count(NeedsValue), CommercialFields.Count(ShouldHaveValue)),
    IssueSection("web", "Splet", WebFields.Count(NeedsValue), WebFields.Count(ShouldHaveValue)),
    // Kaj ima ERP v resnici. Stevec je stevilo odklonov, in sicer sele takrat, ko je posnetek
    // nalozen — pred tem ni podatka in izmisljene nicle ne kazemo.
    new("saop-endpoint", "SAOP endpoint", Snapshot is null || SnapshotDifferenceCount == 0 ? null : SnapshotDifferenceCount, "warn",
      PimFormat.Count(SnapshotDifferenceCount, "polje se razlikuje od SAOP", "polji se razlikujeta od SAOP", "polja se razlikujejo od SAOP", "polj se razlikuje od SAOP")),
    // Uporabnik 2026-08-28: »Zakaj imava medij in zaloga skupaj — ne vem«. Nista isto:
    // mediji so vsebina izdelka, zaloga je trenutno stanje iz drugega vira. Locena sklopa.
    // Število vsebine je sivo in ima opis — ni opozorilo.
    new("media", "Mediji", Detail.Media.Count + Detail.Documents.Count, null,
      $"{PimFormat.Count(Detail.Media.Count, "slika", "sliki", "slike", "slik")} · {PimFormat.Count(Detail.Documents.Count, "dokument", "dokumenta", "dokumenti", "dokumentov")}"),
    new("stock", "Zaloga", Detail.Stock.Count, null, PimFormat.Count(Detail.Stock.Count, "zalogovna vrstica", "zalogovni vrstici", "zalogovne vrstice", "zalogovnih vrstic")),
    // Kakovost šteje vse kanale skupaj; značka pove isto kot vsota ERP + Splet, ne dodatnih težav.
    // Rdeče je samo, kar ustavi objavo; napaka komercialnega profila (npr. Pak1) je bila rdeča »2«,
    // čeprav ne ustavi ničesar (2026-09-28).
    IssueSection("quality-history", "Kakovost in zgodovina", Detail.Issues.Count(Blocking), Detail.Issues.Count(row => !Blocking(row))),
  ];

  SaopEndpointSnapshot? Snapshot;
  bool SnapshotLoading;
  string? SnapshotError;

  int SnapshotDifferenceCount => Snapshot?.Rows.Count(row => row.IsDifferent) ?? 0;

  static readonly IReadOnlyList<PimColumn> SnapshotColumns =
    [new("Element"), new("Vrednost v SAOP"), new("Vrednost v PIM"), new("Ujemanje")];

  void SelectSection(string section)
  {
    Section = section;
    Navigation.NavigateTo($"izdelki/{ProductId}#{section}", replace: true);
    if (section == "saop-endpoint") _ = LoadSnapshotAsync();
    if (section == "quality-history") _ = LoadOriginsAsync();
  }

  // Izvor podatkov se bere lenobno (glej LoadAsync): enkrat na odprtje kartice, ob prvem obisku
  // zavihka Kakovost in zgodovina. Napaka izvora ne podre kartice - tabela ostane prazna s pojasnilom.
  bool OriginsLoaded;
  bool OriginsLoading;
  async Task LoadOriginsAsync()
  {
    if (OriginsLoaded || OriginsLoading) return;
    OriginsLoading = true;
    try { Origins = await Workbench.GetProductOriginAsync(OrganizationId, ProductId); }
    catch { Origins = []; }
    finally { OriginsLoading = false; OriginsLoaded = true; }
    await InvokeAsync(StateHasChanged);
  }

  /// <summary>Posnetek se isce po zajetih straneh odgovora, zato se nalozi na zahtevo in samo enkrat.</summary>
  async Task LoadSnapshotAsync()
  {
    if (Snapshot is not null || SnapshotLoading || Detail is null) return;
    SnapshotLoading = true; SnapshotError = null;
    StateHasChanged();
    try
    {
      Snapshot = await SaopSnapshot.GetAsync(OrganizationId, Detail.Header.ItemId);
    }
    catch { SnapshotError = "Posnetka zapisa iz SAOP trenutno ni mogoče prebrati."; }
    finally { SnapshotLoading = false; StateHasChanged(); }
  }
  void HeroFailed() => HeroImageFailed = true;
  void ToggleActivities() => ActivitiesExpanded = !ActivitiesExpanded;

  async Task<ProductEditService.PackageOrderState?> LoadPackageOrderAsync()
  {
    try { return await Edits.GetPackageOrderStateAsync(ProductId); }
    catch { return null; } // kartica se odpre tudi brez tega; opomba ob oznaki potem kaže samo zajem
  }

  static string HoldChannel(string channel) => channel switch
  {
    "WEB" => "splet",
    "ALL" => "vsi kanali",
    "ERP" => "ERP",
    _ => channel,
  };

  static string HoldRuleName(string createdBy) =>
    string.Equals(createdBy, "pravilo 302", StringComparison.OrdinalIgnoreCase) ? "pravilo Pakirno naročanje" : createdBy;

  static string Quantity(decimal? value) => value is { } number ? number.ToString("0.##") : "prazno";

  /// <summary>
  /// Opomba ob oznaki Pakirno naročanje. Pravilo 302 in katalog.csv gledata OBJAVLJENO Pakiranje 2
  /// (<see cref="PackageOrder"/>), kartica drugje zajem/uvoz (<c>Detail.Commercial</c>); ko se razlikujeta,
  /// opomba pove oboje, da uporabnik ve, zakaj je artikel zadržan, čeprav je Pakiranje 2 vpisano.
  /// </summary>
  (string Text, bool Warning) PackageOrderNote(bool isSet)
  {
    var captured = Detail?.Commercial?.Pak2;
    var published = PackageOrder?.PublishedPak2;
    if (!isSet)
      return ($"Ni vklopljeno: na spletu se artikel naroča po kosih (katalog.csv »Pakirno naročanje« = 0). Če vklopiš, je paket objavljeno Pakiranje 2 ({Quantity(published ?? captured)}).", false);
    if (PackageOrder is null)
      return captured is > 1
        ? ($"Na spletu se naroča samo po celih paketih (paket = {Quantity(captured)}, Pakiranje 2).", false)
        : ($"Pakiranje 2 je {Quantity(captured)} — artikel je zadržan s spleta, dokler Pakiranje 2 ni večje od 1 (vpiše se na zavihku ERP, gre v SAOP prek vrste).", true);
    if (published is > 1)
      return captured is > 1 && captured != published
        ? ($"Na spletu se naroča samo po celih paketih (paket = {Quantity(published)}, objavljeno Pakiranje 2; vpisano {Quantity(captured)} gre na splet ob naslednji objavi v PIM).", false)
        : ($"Na spletu se naroča samo po celih paketih (paket = {Quantity(published)}, Pakiranje 2).", false);
    if (captured is not > 1)
      return ($"Pakiranje 2 je {Quantity(captured)} — artikel je zadržan s spleta, dokler Pakiranje 2 ni večje od 1 (vpiše se na zavihku ERP, gre v SAOP prek vrste) ali ne odstraniš oznake.", true);
    return PackageOrder.IsPromoted
      ? ($"Pakiranje 2 je vpisano ({Quantity(captured)}), na splet pa gre še objavljena vrednost ({Quantity(published)}). Artikel je zadržan s spleta do naslednje objave v PIM (po uspešni validaciji); zadržek se nato sprosti sam ob izvozu katalog.csv.", true)
      : ($"Pakiranje 2 je vpisano ({Quantity(captured)}), artikel pa še ni objavljen v PIM (objava teče po uspešni validaciji). Do takrat je zadržan s spleta; zadržek se nato sprosti sam ob izvozu katalog.csv.", true);
  }
  string ActivityTitle(ProductCardHistory activity) =>
    string.IsNullOrWhiteSpace(activity.FieldKey) ? "Podatek posodobljen" : $"Posodobljeno: {ActivityFieldLabel(activity.FieldKey)}";

  /// <summary>Oznake (233/302) imajo ime v registru (pim.ProductFlagDefinition), ne v <see cref="FieldLabel"/>.</summary>
  string ActivityFieldLabel(string fieldKey) =>
    fieldKey.StartsWith("ProductFlag.", StringComparison.OrdinalIgnoreCase)
    && Flags.FirstOrDefault(flag => string.Equals($"ProductFlag.{flag.FlagCode}", fieldKey, StringComparison.OrdinalIgnoreCase)) is { } flag
      ? $"oznaka {flag.DisplayName}"
      : FieldLabel(fieldKey);
  static string ActivitySummary(ProductCardHistory activity)
  {
    var oldValue = ActivityValue(activity.OldValue);
    var newValue = ActivityValue(activity.NewValue);
    return oldValue is null && newValue is null ? "Podatek je bil posodobljen."
      : oldValue is null ? $"Nastavljena vrednost: {newValue}"
      : newValue is null ? $"Odstranjena vrednost: {oldValue}"
      : $"{oldValue} → {newValue}";
  }
  static string? ActivityValue(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim() switch
  {
    "1" or "true" or "True" => "Da",
    "0" or "false" or "False" => "Ne",
    var text => text,
  };
  ProductChannelField Field(string label, string key, string? value, bool inModel = true)
  {
    var field = Detail?.Fields.FirstOrDefault(row => row.FieldKey == key);
    return new(label, key, value ?? field?.Value, field?.Owner ?? "—", null, null, Pending(key), inModel);
  }
  bool Pending(string key) => LiveOverlay(key) is not null;

  /// <summary>Vrednost iz odhodne vrste, ki še čaka potrditev SAOP (migracija 089, §"Prekrivka"):
  /// pokaže se NAD kanonično vrednostjo, da uporabnik takoj vidi, kaj je poslal, ne da bi se
  /// pretvarjali, da je to že dejstvo — vrstica ostane "obvezno/manjka", dokler SAOP ne potrdi.</summary>
  string? PendingValue(string key) => LiveOverlay(key)?.Value;

  /// <summary>
  /// Najnovejše sporočilo za polje, ki je še na poti v SAOP. Odklon in mrtvo sporočilo nista več na
  /// poti: SAOP vrednosti nima, zato kartica kaže vrednost iz PIM, sporočilo pa ostane v tabeli
  /// »Spremembe izdelka na poti v SAOP«. Uporabnik 2026-09-23: seznam je kazal »Aktiven: Da«,
  /// kartica pa »Ne« iz starega obtičalega sporočila, in polje je bilo zaradi njega zaklenjeno.
  /// </summary>
  ProductPendingOverlay? LiveOverlay(string key) => Detail?.PendingOverlays
    .Where(row => row.FieldKey == key && row.Status is "PendingApproval" or "Pending" or "Retry" or "Sending" or "Sent")
    .OrderByDescending(row => row.CreatedUtc).ThenByDescending(row => row.OutboxMessageId)
    .FirstOrDefault();
  string OwnerFor(string key) => Detail?.Fields.FirstOrDefault(row =>
    string.Equals(row.FieldKey, key, StringComparison.OrdinalIgnoreCase))?.Owner ?? "PIM";
  IReadOnlyList<PimValidationLayer> ProfileLayers(string profileCode)
  {
    var profile = Detail?.Profiles.FirstOrDefault(row => row.ProfileCode == profileCode);
    return profile is null ? [] : ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb);
  }
  bool IsShared(string profileCode) => Detail?.Profiles.Any(row => row.ProfileCode == profileCode && ValidationLayer.IsShared(row.Scope)) == true;
  IReadOnlyList<ProductCardIssue> IssuesFor(params PimValidationLayer[] layers) => Detail is null ? [] : Detail.Issues
    .Where(issue => ProfileLayers(issue.ProfileCode).Any(layers.Contains)).DistinctBy(issue => issue.ProductIssueId).ToList();
  string StatusFor(IReadOnlyList<PimValidationLayer> layers, string fallback, string? site = null)
  {
    if (Detail is null) return fallback;
    var profiles = Detail.Profiles.Where(profile => ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).Any(layers.Contains));
    // 2026-09-28: profil, ki za artikel ne velja (ERP EU za blago s Kitajske, spletišče brez kljukice),
    // nima izračuna. Ko je artikel sicer preverjen, tak profil ne sme obarvati kanala »še ni preverjeno« —
    // kartica je kazala »Še ni preverjeno« ob »Preverjeno pred 44 min«.
    if (Detail.Header.LastValidatedUtc is not null)
      profiles = profiles.Where(profile => profile.ValidatedUtc is not null);
    if (!string.IsNullOrWhiteSpace(site)) profiles = profiles.Where(profile => ValidationLayer.IsShared(profile.Scope) || MatchesSite(profile.ProfileCode));
    var statuses = profiles.Select(profile => profile.Status).ToList();
    return statuses.Count == 0 ? fallback : statuses.Any(status => status == "INVALID") ? "INVALID" : statuses.Any(status => status != "VALID") ? "PENDING" : "VALID";
  }
  bool MatchesSite(string profileCode) => string.IsNullOrWhiteSpace(SelectedSite) || Normalize(profileCode).Contains(Normalize(SelectedSite), StringComparison.OrdinalIgnoreCase) || IsShared(profileCode);
  static string Normalize(string value) => new(value.Where(char.IsLetterOrDigit).ToArray());
  static string StockRule(ProductCardStock row) => row.MinimumStock is null && row.MaximumStock is null ? "—" : $"{Number(row.MinimumStock)} / {Number(row.MaximumStock)}";
  static string Moment(DateTime? value) => value?.ToPimLocal().ToString("g") ?? "—";
  /// <summary>Logična vrednost na kartici: Da / Ne (uporabnik 2026-09-22: v Excelu in SAOP je D/N,
  /// v intranetu »prevest v Da in Ne«, ker je uporabniško bolje).</summary>
  static string YesNo(bool value) => value ? "Da" : "Ne";
  static string Flag(bool value) => value ? "true" : "false";
  static string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
  static string Number(decimal? value) => value?.ToString("N2") ?? "—";
  static string Measure(decimal? value, string unit) => value is null ? "—" : $"{value:N2} {unit}";
  static string ShortId(Guid value) => value.ToString("N")[..8];
  static string? OwnerTone(string owner) => owner switch { "PIM" => "good", "SAOP" => "warn", _ => null };
  static string? Tone(string value) => value switch { "VALID" or "Verified" or "Succeeded" or "Processed" => "good", "PENDING" or "Pending" or "PendingApproval" or "Retry" or "Sending" or "Sent" => "warn", "INVALID" or "Error" or "Dead" or "Drift" or "Failed" or "Quarantined" or "Cancelled" => "bad", _ => null };
  static string StatusLabel(string value) => value switch { "VALID" => "Veljavno", "INVALID" => "Manjkajo podatki", "PENDING" => "Še ni preverjeno", "NOT_ON_WEB" => "Ni objavljeno na spletu", "PendingApproval" => "Čaka odobritev", "Pending" => "V vrsti", "Sent" => "Poslano, nepotrjeno", "Verified" => "Potrjeno", "Drift" => "Odklon", "Dead" => "Mrtvo", "Retry" => "Ponovni poskus", _ => value };
}
