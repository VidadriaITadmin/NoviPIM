      writable is null ? ProductFieldEdit.Attribute : ProductFieldEdit.Saop, "text", RequiredField(fieldKey), string.IsNullOrWhiteSpace(resolved),
      AttributeCode: attributeCode, Hint: group, Recommended: RecommendedField(fieldKey),
