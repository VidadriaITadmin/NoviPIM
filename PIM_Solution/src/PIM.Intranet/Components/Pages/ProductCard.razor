    var original = WebShops.FirstOrDefault(shop => string.Equals(shop.WebShopCode, code, StringComparison.OrdinalIgnoreCase))?.IsPublished ?? false;
    if (value == original) ShopDrafts.Remove(code);
    else ShopDrafts[code] = value;
