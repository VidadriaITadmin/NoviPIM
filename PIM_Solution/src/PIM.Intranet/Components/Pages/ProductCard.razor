@page "/izdelki/{ProductId:long}"
@using PIM.Intranet.Components.Pages.ProductCardParts
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntranetDataService Data
@inject ProductWorkbenchService Workbench
@inject IntranetFeatureReadService Features
@inject CatalogReadService Catalog
@inject ProductEditService Edits
@inject ClearanceService Clearance
@inject SaopWriteService SaopWrite
@inject SaopEndpointSnapshotService SaopSnapshot
@inject AiTextService Ai
@inject QualityReadService Quality
@inject QualityWriteService QualityWrite
@inject WebWithdrawalService Withdrawals
@inject CategoryTreeService CategoryTree
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>@(Detail?.Header.Name ?? "Izdelek")</PageTitle>

<PimState Loading="Loading" Error="@Error" Empty="@(Detail is null)"
          EmptyText="Izdelek s to oznako ne obstaja." LoadingText="Nalaganje kartice izdelka …">
  @if (Detail is not null)
  {
    var heroUrl = MediaUrlPolicy.Normalize(Detail.Header.ThumbnailUrl);
    var erpBlockingCount = ErpIssues.Count(Blocking);
    var webBlockingCount = WebIssues.Count(Blocking);
    var commercialWarningCount = CommercialIssues.Count;
    <PimPage Title="@Detail.Header.Name" Subtitle="@($"{OrganizationName} · artikel {Detail.Header.ItemId} · EAN {Detail.Header.Ean ?? "—"}")" Crumbs="ProductCrumbs">
      <Actions>
        <div class="card-actions">
          @* A1, pregled 2026-09-08: bralna vloga je dobila 14 urejivih polj in gumb »Shrani
             spremembe«. Kdor ne sme pisati, tu ne dobi gumba, ampak pove, zakaj ga ni. *@
          @if (!CanEdit)
          {
            <PimChip Text="Samo za branje" Tone="warn" />
            <span class="save-state">Urejanje kartice je omejeno na vlogi ADMIN in CATALOG_EDITOR.</span>
          }
          else
          {
            @* P3-23, dostopnost: po shranjevanju gumb postane onemogocen in fokus pade v telo
               strani — bralnik zaslona ostane brez konteksta. Fokus zato prevzame izid. *@
            <span class="save-state" role="status" aria-live="polite" tabindex="-1" @ref="SaveStatus">
              @if (Busy) { <span>Shranjujem …</span> }
              else if (Conflicts.Count > 0) { <span class="save-error">@Conflicts.Count polj ni bilo shranjenih — nekdo jih je vmes spremenil</span> }
              else if (SaveError is not null) { <span class="save-error">@SaveError</span> }
              else if (SaveMessage is not null) { <span class="save-ok">@SaveMessage</span> }
              else if (Drafts.Count > 0)
              {
                @* Pregled 2026-09-22: en gumb, dve poti. Besedila in lastnosti veljajo takoj, polja SAOP
                   pa gredo v odobritev na Izhod v SAOP. Uporabnik mora to vedeti PRED klikom. *@
                <span class="save-dirty">@Drafts.Count neshranjenih</span>
                <span class="save-split">
                  @if (DraftNowCount > 0) { <span class="save-now" title="Besedila in lastnosti v lasti PIM: po shranjevanju veljajo takoj.">@DraftNowCount velja takoj</span> }
                  @if (DraftSaopCount > 0) { <span class="save-saop" title="Polja v lasti SAOP: po shranjevanju čakajo na odobritev na strani Izhod v SAOP in veljajo šele, ko jih SAOP potrdi.">@DraftSaopCount gre v odobritev SAOP</span> }
                </span>
              }
            </span>
            <button type="button" class="ghost-button" disabled="@(Drafts.Count == 0 || Busy)" @onclick="DiscardChanges">Prekliči</button>
            <button type="button" class="primary-button" disabled="@(Drafts.Count == 0 || Busy)" @onclick="SaveChangesAsync">
              Shrani spremembe@(Drafts.Count > 0 ? $" ({Drafts.Count})" : "")
            </button>
          }
        </div>
      </Actions>
    </PimPage>

    @if (Conflicts.Count > 0)
    {
      @* P3-17, pregled 2026-09-08: dva urednika sta se doslej tiho prepisala. Sporna polja se ne
         zapišejo; tukaj stoji, kaj si videl ti in kaj je v katalogu zdaj, da se odločiš sam. *@
      <section class="ui-card conflict-card" role="alert" aria-labelledby="conflict-title">
        <h2 id="conflict-title">Nekdo je bil hitrejši</h2>
        <p>Ta polja niso bila shranjena, ker jih je med tvojim urejanjem spremenil nekdo drug.
           Ostale spremembe so shranjene. Preveri in vpiši znova, če tvoja vrednost še velja.</p>
        <ul class="conflict-list">
          @foreach (var conflict in Conflicts)
          {
            <li>
              <span class="code-value">@conflict.FieldKey</span>
              <span class="conflict-mine">tvoja izhodiščna: @(string.IsNullOrEmpty(conflict.Expected) ? "—" : conflict.Expected)</span>
              <span class="conflict-theirs">v katalogu zdaj: @(string.IsNullOrEmpty(conflict.TheirValue) ? "—" : conflict.TheirValue)</span>
            </li>
          }
        </ul>
      </section>
    }

    <section class="product-hero" aria-labelledby="product-identity-title">
      <div class="media-tile">
        @if (heroUrl.Href is not null && !HeroImageFailed)
        {
          <img src="@heroUrl.Href" alt="@Detail.Header.Name" loading="lazy" @onerror="HeroFailed" />
        }
        else { <span>Brez slike</span> }
      </div>

      <div class="product-identity">
        <h2 id="product-identity-title" class="visually-hidden">Identiteta izdelka</h2>
        @* A6, uporabnik 2026-08-31: »na kartici artikla se nikjer ne vidi iz katere organizacije
           je artikel«. Sifra artikla je enolicna samo znotraj podjetja — 0000000000001 obstaja
           v DEMO in v Vidadrii — zato podjetje stoji takoj ob njej. *@
        <p class="identity-line">
          <span class="organization-badge">@OrganizationName</span>
          <span class="code-value">@Detail.Header.ItemId</span>
          @if (Detail.Header.Ean is not null) { <span>EAN @Detail.Header.Ean</span> }
          @if (Detail.Header.ItemGroup is not null) { <span>@Detail.Header.ItemGroup</span> }
        </p>
        <div class="header-chips" aria-label="Stanje izdelka">
          <span class="flag-chip @(Detail.Header.IsActive ? "on" : "off")">@(Detail.Header.IsActive ? "Aktiven" : "Neaktiven")</span>
          @* Dva locena podatka, ne eden namesto drugega: ERP samo naroci "pripravi za splet"
             (Product.WebPublish), kljukice na Spletiscih pa povedo, ali je artikel dejansko tam. *@
          <span class="flag-chip @(Detail.Header.WebPublish ? "on" : "off")" title="Iz SAOP-a: ERP oznaci artikel kot namenjenega za splet.">@(Detail.Header.WebPublish ? "ERP: za splet" : "ERP: ni za splet")</span>
          <span class="flag-chip @(PublishedOnAnySite() ? "on" : "off")" title="Kljukica na zavihku Splet > Spletisca: dejansko odloca o objavi in validaciji.">@(PublishedOnAnySite() ? "Objavljeno na spletu" : "Ni objavljeno na spletu")</span>
          <PimChip Text="@(Detail.Header.IsPromoted ? "Objavljen v PIM" : "Ni objavljen v PIM")" Tone="@(Detail.Header.IsPromoted ? "good" : "warn")" />
        </div>
        @if (heroUrl.Href is not null) { <a class="media-link" href="@heroUrl.Href" target="_blank" rel="noopener noreferrer">Odpri glavni medij</a> }
        else if (heroUrl.Note is not null) { <span class="muted">@heroUrl.Note</span> }
      </div>

      <div class="hero-completeness">
        <span class="score-value">@Detail.Header.Completeness.ToString("0.#") %</span>
        <span class="score-label">skupna popolnost</span>
        <PimBar Percent="Detail.Header.Completeness" Label="Popolnost izdelka" />
        <span class="score-note">@Detail.Header.OpenIssueCount.ToString("N0") odprtih zahtev</span>
      </div>
    </section>

    <div class="product-workspace">
      <aside class="section-nav-column">
        <nav class="section-nav-card product-section-nav" role="tablist" aria-label="Sklopi kartice izdelka" aria-orientation="vertical">
          @foreach (var entry in SectionList)
          {
            var active = Section == entry.Key;
            <button type="button" role="tab" id="tab-@entry.Key" aria-controls="panel-@entry.Key"
                    aria-selected="@Flag(active)" class="@(active ? "active" : null)" @onclick="() => SelectSection(entry.Key)">
              <span>@entry.Label</span>
              @if (entry.Count is > 0)
              {
                <span class="nav-badge @(entry.Tone ?? "count")" title="@entry.Title" aria-hidden="true">@entry.Count.Value.ToString("N0")</span>
                <span class="visually-hidden">(@(entry.Title ?? entry.Count.Value.ToString("N0")))</span>
              }
            </button>
          }
        </nav>
      </aside>

      <div class="section-content">
        <section id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0" class="section-panel overview-panel" hidden="@(Section != "overview")">
          @if (erpBlockingCount > 0)
          {
            <div class="blocking-banner" role="alert">
              <span class="alert-mark" aria-hidden="true">!</span>
              <div>
                <strong>@erpBlockingCount.ToString("N0") napak blokira ERP</strong>
                <span>Manjkajo obvezni podatki za zapis v SAOP.</span>
              </div>
              <button type="button" class="banner-action" @onclick='() => SelectSection("quality-history")'>Odpri kakovost</button>
            </div>
          }

          <h2 class="section-title">Pregled artikla</h2>
          <section class="channel-strip" aria-label="Stanje treh kanalov izdelka">
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("core")'>
              <span class="channel-name">ERP (SAOP)</span>
              <PimChip Text="@StatusLabel(ErpStatus)" Tone="@Tone(ErpStatus)" />
              <small>@erpBlockingCount.ToString("N0") blokirajočih napak</small>
            </button>
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("commercial")'>
              <span class="channel-name">Komerciala</span>
              <PimChip Text="@(commercialWarningCount == 0 ? "Brez odprtih opozoril" : "Potrebuje pregled")" Tone="@(commercialWarningCount == 0 ? "good" : "warn")" />
              <small>@commercialWarningCount.ToString("N0") opozoril · nikoli ne blokira</small>
            </button>
            <button type="button" class="ui-card channel-card" @onclick='() => SelectSection("web")'>
              <span class="channel-name">Splet</span>
              <PimChip Text="@WebStatusLabel" Tone="@WebStatusTone" />
              <small>@(string.IsNullOrWhiteSpace(SelectedSite) ? "vsa spletna mesta" : SelectedSite)</small>
            </button>
          </section>

          <div class="overview-grid">
            <section class="ui-card key-data-card" aria-labelledby="key-data-title">
              <h2 id="key-data-title">Ključni podatki</h2>
              <dl class="key-data-list">
                <div><dt>Artikel</dt><dd><span>@Detail.Header.ItemId</span><span class="owner-label">@OwnerFor("Product.ItemID")</span></dd></div>
                <div><dt>EAN</dt><dd><span>@Value(Detail.Header.Ean)</span><span class="owner-label">@OwnerFor("Product.EAN")</span></dd></div>
                <div><dt>Aktiven</dt><dd><span>@YesNo(Detail.Header.IsActive)</span><span class="owner-label">@OwnerFor("Product.IsActive")</span></dd></div>
                <div><dt>ERP: za splet</dt><dd><span>@YesNo(Detail.Header.WebPublish)</span><span class="owner-label">@OwnerFor("Product.WebPublish")</span></dd></div>
                <div><dt>Objavljeno na spletu</dt><dd><span>@YesNo(PublishedOnAnySite())</span></dd></div>
              </dl>
              <button type="button" class="detail-link" @onclick='() => SelectSection("core")'>Prikaži vse podrobnosti <span aria-hidden="true">›</span></button>
            </section>

            <section class="ui-card task-card" aria-labelledby="tasks-title">
              <h2 id="tasks-title">Odprte naloge</h2>
              @if (erpBlockingCount == 0 && webBlockingCount == 0 && commercialWarningCount == 0)
              {
                <p class="empty-tasks">Ni odprtih nalog. Artikel je pripravljen za svoje cilje.</p>
              }
              else
              {
                <div class="task-list">
                  @if (erpBlockingCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("quality-history")'>
                      <span class="task-mark bad" aria-hidden="true">!</span><span>Dopolni ERP podatke</span><span class="task-status bad">Blokira</span><span aria-hidden="true">›</span>
                    </button>
                  }
                  @if (webBlockingCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("web")'>
                      <span class="task-mark bad" aria-hidden="true">!</span><span>Dopolni spletne podatke</span><span class="task-status bad">Blokira</span><span aria-hidden="true">›</span>
                    </button>
                  }
                  @if (commercialWarningCount > 0)
                  {
                    <button type="button" class="task-item" @onclick='() => SelectSection("commercial")'>
                      <span class="task-mark warn" aria-hidden="true">!</span><span>Preglej komercialne podatke</span><span class="task-status warn">Opozorilo</span><span aria-hidden="true">›</span>
                    </button>
                  }
                </div>
              }
            </section>
          </div>
        </section>

        <section id="panel-core" role="tabpanel" aria-labelledby="tab-core" tabindex="0" class="section-panel section-stack" hidden="@(Section != "core")">
          <header class="section-heading"><h2>ERP (SAOP)</h2><p>Identiteta, šifranti ERP, partnerja, nazivi za ERP ter logistika, ki jo zahteva izvoz.</p></header>
          <ProductChannelPanel PanelId="panel-erp" TabId="tab-core" Title="ERP (SAOP)"
                               StatusText="@StatusLabel(ErpStatus)" StatusTone="@Tone(ErpStatus)"
                               BlockingCount="@erpBlockingCount"
                               WarningCount="@ErpIssues.Count(row => !Blocking(row))"
                               LastValidatedUtc="@Detail.Header.LastValidatedUtc" Fields="@ErpFields" Issues="@ErpIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" EnterToSave="SaveChangesAsync" DefaultGroup="ERP — Slovenija"
                               Waivers="FieldWaivers" CanWaive="CanWaive" WaiverChanged="OnWaiverChangedAsync"
                               ReadOnly="@(!CanEdit)" />
        </section>

        @* A7, uporabnik 2026-08-31: »komercialne podatke in pa splet podatke bi locili«.
           Cene ostanejo pri komercialni strani — so komercialen podatek, ne spletna vsebina. *@
        <section id="panel-commercial" role="tabpanel" aria-labelledby="tab-commercial" tabindex="0" class="section-panel section-stack" hidden="@(Section != "commercial")">
          <header class="section-heading"><h2>Komerciala</h2><p>Uvrstitev artikla, aktivnost, nabavni pogoji in cene po cenikih.</p></header>
          <ProductChannelPanel PanelId="panel-komerciala" TabId="tab-commercial" Title="Komerciala"
                               StatusText="@(commercialWarningCount == 0 ? "Brez odprtih opozoril" : "Potrebuje pregled")"
                               StatusTone="@(commercialWarningCount == 0 ? "good" : "warn")" BlockingCount="0"
                               WarningCount="@commercialWarningCount" LastValidatedUtc="@Detail.Header.LastValidatedUtc"
                               Fields="@CommercialFields" Issues="@CommercialIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" EnterToSave="SaveChangesAsync" DefaultGroup="Klasifikacija in objava"
                               ReadOnly="@(!CanEdit)" />

          <section id="panel-prices" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Cene</h2><a href="cene?izdelek=@Detail.Header.ItemId">Odpri poslovni pogled</a></div>
            @if (PriceChecks?.IsMissing == true) { <PimMissing Object="intranet.GetPriceChecks" What="preverbe cen tega artikla po ceniku" Needs="canon.ProductPrice + šifrant preverb + prag marže" /> }
            <PimState Empty="@(Detail.Prices.Count == 0)" EmptyText="Izdelek nima cene.">
              <PimTable Caption="Cene izdelka po cenikih" Columns="PriceColumns"><Rows>@foreach (var row in Detail.Prices) { <tr><td>@row.PriceList</td><td class="numeric">@row.Net.ToString("N2")</td><td class="numeric">@row.VatRate.ToString("N1") %</td><td class="numeric">@row.Gross.ToString("N2")</td><td>@row.ValidFrom.ToPimLocal().ToString("d")</td><td><PimChip Text="@(row.IsActive ? "Veljavna" : "Neaktivna")" Tone="@(row.IsActive ? "good" : null)" /></td></tr> }</Rows></PimTable>
            </PimState>
          </section>

          @* 274: S-popust na polno pakiranje — privzeta S koda in posebni S po tipu stranke ali stranki. *@
          @if (Section == "commercial")
          {
            <ProductPackagingPanel ProductId="ProductId" ItemId="@Detail.Header.ItemId" CanEdit="CanEdit" />
          }
        </section>

        <section id="panel-web" role="tabpanel" aria-labelledby="tab-web" tabindex="0" class="section-panel section-stack" hidden="@(Section != "web")">
          <header class="section-heading"><h2>Splet</h2><p>Objava, nazivi in opisi po jezikih, kategorije in atributi.</p></header>

          @* 242: zakaj artikel je ali ni v katalog.csv — po istih pravilih kot izvoz (kljukice spletišč,
             kategorija na spletišču, zadržek, izključitev, veljavni profili, pravilo 220), ne po oznaki iz SAOP. *@
          <section id="panel-objava-splet" class="ui-card data-card tab-panel" aria-labelledby="web-export-title">
            <div class="subsection-head">
              <h2 id="web-export-title">Objava za splet (katalog.csv)</h2>
              @* Kategorija se na kartici ne ureja v vrstici, ampak na /izdelki/{sifra}/kategorije (109) -
                 do tja je prej vodila samo pot prek Nastavitve kataloga, zato je bilo videti, da se da
                 kategorijo spremeniti le z uvozom. *@
              <AuthorizeView Policy="@PimPolicies.CatalogWrite">
                <a href="@CategoriesHref">Spremeni kategorije</a>
              </AuthorizeView>
              <AuthorizeView Policy="@PimPolicies.BusinessWrite">
                <button type="button" class="ghost-button" disabled="@WebCheckBusy" @onclick="RecheckWebAsync">@(WebCheckBusy ? "Preverjam …" : "Preveri zdaj")</button>
              </AuthorizeView>
            </div>
            @if (WebExport is null)
            {
              <p class="muted">Stanja objave za splet ni mogoče prebrati (pogled val.ProductChannelReadiness, migracija 242).</p>
            }
            else
            {
              var web = WebExport.Row;
              <p>
                <PimChip Text="@WebExportStates.Label(web.WebExportState)" Tone="@WebExportStates.Tone(web.WebExportState)" />
                @if (web.IsValidationStale) { <PimChip Text="Potrebna preverba" Tone="warn" /> }
                else if (web.WebExportState == WebExportStates.Published && !web.IsWebReady) { <PimChip Text="Napake od zadnje objave" Tone="warn" /> }
                <span class="muted">@WebExportStates.Explain(web.WebExportState)</span>
              </p>
              <dl class="key-data-list">
                <div><dt>V katalog.csv</dt><dd>@(web.IsWithdrawalRow ? "da — odjavna vrstica (prazne Spletne strani, Magento ga umakne)" : web.IsInCatalogCsv ? "da" : "ne")</dd></div>
                <div><dt>Blokirajoče napake za splet</dt><dd>@web.WebBlockingCount.ToString("N0")</dd></div>
                <div><dt>Opozorila</dt><dd>@web.WarningCount.ToString("N0")</dd></div>
                <div>
                  <dt>Zadržek</dt>
                  <dd>
                    @if (PackageOrder is { Holds.Count: > 0 } holdState)
                    {
                      <span class="hold-list">
                      @foreach (var hold in holdState.Holds)
                      {
                        <span class="hold-line">
                          <strong>@HoldChannel(hold.ChannelCode)</strong> ·
                          @(hold.IsRule ? $"samodejni ({HoldRuleName(hold.CreatedBy)})" : $"ročni ({hold.CreatedBy})") ·
                          @PimFormat.Ago(hold.CreatedUtc)
                          <span class="muted">— @hold.Reason</span>
                        </span>
                      }
                      </span>
                    }
                    else
                    {
                      @(web.HasGlobalHold ? "vsi kanali" : web.HasWebHold ? "splet" : "ne")
                    }
                  </dd>
                </div>
                <div><dt>Izključen iz kataloga</dt><dd>@(web.IsExcludedFromCatalog ? "da" : "ne")</dd></div>
                <div><dt>Objavljen v PIM</dt><dd>@(web.IsPromoted ? "da" : "ne — objava teče po uspešni validaciji")</dd></div>
                <div><dt>ERP: za splet</dt><dd>@(web.WebPublish ? "da" : "ne") <span class="muted">(informativno)</span></dd></div>
                <div><dt>Validirano</dt><dd>@(web.LastValidatedUtc?.ToPimLocal().ToString("g") ?? "nikoli") · @PimFormat.Ago(web.LastValidatedUtc)</dd></div>
              </dl>
              <table class="data-table">
                <caption>Spletišča po izvoznih pravilih</caption>
                <thead><tr><th>Spletišče</th><th>Kljukica</th><th>Kategorija</th><th>Blokirajoči neveljavni profili</th><th>V stolpcu »Spletne strani«</th></tr></thead>
                <tbody>
                  @foreach (var site in WebExport.Sites)
                  {
                    <tr>
                      <td>@site.WebSiteName <span class="muted">(@site.TreeLabel)</span></td>
                      <td>@(site.IsChecked ? "da" : "ne")</td>
                      <td>
                        @(site.HasCategory ? "da" : "ne")
                        @if (!site.HasCategory)
                        {
                          <AuthorizeView Policy="@PimPolicies.CatalogWrite"> · <a href="@CategoriesHref">uvrsti</a></AuthorizeView>
                        }
                      </td>
                      <td>@(site.InvalidBlockingProfiles ?? "—")</td>
                      <td>@(site.IsAllowed && web.WebExportState == WebExportStates.Published ? "da" : $"ne — {SiteReason(site, web)}")</td>
                    </tr>
                  }
                </tbody>
              </table>
              @if (WebCheckMessage is not null) { <p class="message-state" role="status">@WebCheckMessage</p> }
              @if (WebCheckError is not null) { <p class="message-state error-message" role="alert">@WebCheckError</p> }
              <p class="muted">»Preveri zdaj« požene validacijo tega artikla v PIM-u in osveži stanje; ne pošilja v SAOP in ne izdela CSV. V katalog.csv pride sprememba ob naslednji objavi in izdelavi datoteke (stran Izhod na splet).</p>
            }
          </section>

          <ProductChannelPanel PanelId="panel-splet" TabId="tab-web" Title="Splet"
                               StatusText="@WebStatusLabel" StatusTone="@WebStatusTone"
                               BlockingCount="@webBlockingCount"
                               WarningCount="@WebIssues.Count(row => !Blocking(row))"
                               LastValidatedUtc="@Detail.Header.LastValidatedUtc" Fields="@WebFields" Issues="@WebIssues"
                               Drafts="Drafts" FieldChanged="OnFieldChanged" EnterToSave="SaveChangesAsync" DefaultGroup="Spletna polja"
                               ReadOnly="@(!CanEdit)">
            <Toolbar>
              <label for="product-site">Spletno mesto</label>
              <select id="product-site" class="filter-select" @bind="SelectedSite">
                <option value="">Vsa spletna mesta</option>
                @foreach (var site in WebSites) { <option value="@site">@site</option> }
              </select>
              @if (CanEdit)
              {
                @* AI predlog (uporabnik 2026-09-21): iz ERP podatkov nastane osnutek spletnega naziva in
                   opisa; v bazo gre sele z gumbom Shrani spremembe, kot vsaka rocna sprememba. *@
                <span class="ai-tools">
                  <label for="ai-language">AI predlog v jeziku</label>
                  <select id="ai-language" class="filter-select" @bind="AiLanguage" disabled="@AiBusy">
                    @foreach (var language in WebLanguages) { <option value="@language">@language</option> }
                  </select>
                  <button type="button" class="ghost-button" disabled="@(AiBusy || !Ai.IsConfigured)"
                          title="@(Ai.IsConfigured ? "Iz ERP nazivov, opisov in atributov predlaga spletni naziv in opis. Nič se ne shrani, dokler ne klikneš Shrani spremembe." : Ai.ConfigurationHint)"
                          @onclick="SuggestWithAiAsync">@(AiBusy ? "AI piše …" : "Predlagaj naziv in opis (AI)")</button>
                  @if (!Ai.IsConfigured) { <span class="muted ai-hint">AI ni nastavljen</span> }
                </span>
              }
            </Toolbar>
            <ChildContent>
              @* Uporabnik 2026-09-28: »zakaj se ne more dodajat in spreminjat na sami kartici artikla, recimo
                 atribute ... in kategorije«. Oboje je zdaj tu, pod polji zavihka Splet. *@
              @if (CanEdit)
              {
                <section class="field-group add-attribute" aria-labelledby="add-attribute-title">
                  <h3 class="group-title" id="add-attribute-title">Dodaj atribut</h3>
                  <div class="add-attribute-row" @onfocusin="EnsureAttributeOptionsAsync">
                    <label for="add-attribute-pick">Atribut iz šifranta</label>
                    <PimPicker Id="add-attribute-pick" Options="AttributePickerOptions" @bind-Value="PickedAttribute"
                               Placeholder="Vpiši del imena atributa …"
                               EmptyText="@(AttributeOptionsError ?? (AttributeOptions.Count == 0 ? "Nalagam šifrant …" : "Ni atributa s tem imenom. Nov atribut dodaš v Nastavitve › Atributi."))" />
                    <button type="button" class="secondary-button" disabled="@string.IsNullOrWhiteSpace(PickedAttribute)" @onclick="AddPickedAttribute">Dodaj na kartico</button>
                  </div>
                  <p class="muted">Atribut dobi prazno okence zgoraj; shrani ga gumb »Shrani spremembe«. Na splet gre samo atribut iz nabora kategorije — nabor urejaš v <a href="nastavitve/nabori-atributov">Nabori atributov</a>.</p>
                </section>
              }
              <section class="field-group">
                <ProductCategoryEditor OrganizationId="OrganizationId" ItemId="@Detail.Header.ItemId" CanEdit="CanEdit" Saved="OnCategoriesSavedAsync" />
              </section>
            </ChildContent>
          </ProductChannelPanel>
          @if (AiMessage is not null) { <p class="message-state" role="status">@AiMessage</p> }
          @if (AiError is not null) { <p class="message-state error-message" role="alert">@AiError</p> }

          @* D2 iz pregleda 2026-09-08 in odločitev uporabnika: kam gre izdelek, ne pove več
             »Objava na spletu« iz SAOP (`Product.WebPublish`), ampak ta potrditvena polja.
             Po njih se ravna tudi spletna validacija (migracija 182). *@
          <section id="panel-spletisca" class="ui-card data-card tab-panel web-shops">
            <div class="subsection-head">
              <h2>Spletišča</h2>
              <span class="muted">Označeno spletišče pomeni, da izdelek tja gre — in da ga spletni profil tega spletišča validira.</span>
            </div>

            @* 251: kljukico je PIM odstranil sam, ker artikel na spletišče ne sme več (npr. uvoz je pobrisal
               sliko). Razlog je zapisan ob umiku: odkljukan artikel spletni profil ne validira več, zato
               napak za splet spodaj ni več videti. *@
            @if (OpenWithdrawals.Count > 0)
            {
              <div class="message-state warn-message web-withdrawn" role="status">
                <strong>Samodejno umaknjen s spleta.</strong>
                <ul>
                  @foreach (var withdrawal in OpenWithdrawals)
                  {
                    <li>@withdrawal.ShopLabel — @(withdrawal.WithdrawnUtc?.ToPimLocal().ToString("g") ?? "") (@WebWithdrawalText.Source(withdrawal.TriggerSource)): @withdrawal.ReasonText.</li>
                  }
                </ul>
                <span>Ko artikel dopolniš, spletišče ponovno označi in shrani. <a href="splet/umaknjeni">Vsi umaknjeni artikli</a></span>
              </div>
            }

            @if (WebShops.Count == 0)
            {
              <PimMissing Object="canon.WebSite" What="seznam spletišč" Needs="vsaj eno aktivno spletišče v registru" />
            }
            else
            {
              <ul class="shop-list">
                @foreach (var shop in WebShops)
                {
                  var shopCode = shop.WebShopCode;
                  <li>
                    <label>
                      <input type="checkbox" disabled="@(!CanEdit || ShopBusy)"
                             checked="@ShopDraft(shopCode)"
                             @onchange="args => OnShopChanged(shopCode, args)" />
                      @* 213: ime je oznaka drevesa (svetila, videlektro) — ista, kot gre v stolpec
                         "Spletne strani" v katalog.csv; interna koda (svetila_si) uporabnika ne zanima. *@
                      <span class="shop-name">@shop.WebShopName</span>
                    </label>
                    @if (shop.ChangedBy is not null)
                    {
                      <span class="shop-trace">@shop.ChangedBy · @PimFormat.Ago(shop.ChangedUtc)</span>
                    }
                  </li>
                }
              </ul>

              @if (CanEdit)
              {
                <div class="shop-actions">
                  <button type="button" class="primary-button" disabled="@(!ShopDirty || ShopBusy)" @onclick="SaveWebShopsAsync">
                    Shrani spletišča
                  </button>
                  @if (ShopMessage is not null) { <span class="save-ok" role="status">@ShopMessage</span> }
                  @if (ShopError is not null) { <span class="save-error" role="alert">@ShopError</span> }
                </div>
              }
              else
              {
                <p class="muted">Spremembo spletišč smeta vpisati vlogi ADMIN in CATALOG_EDITOR.</p>
              }
            }
          </section>

          @* 232/275: odprodaja artikla — pregled vrstic, ročni vnos (količina, popust) in zaključitev.
             Pregled vseh artiklov in uvoz seznama sta na /izdelki/odprodaja. *@
          <section id="panel-odprodaja" class="ui-card data-card tab-panel">
            <div class="subsection-head">
              <h2>Odprodaja</h2>
              <span class="muted">Gre v katalog.csv (Odprodaja, popust %, preostala količina). Naročila kupcev iz SAOP količino sproti zmanjšujejo. <a href="izdelki/odprodaja">Vsi artikli v odprodaji</a></span>
            </div>

            @if (ClearanceItems.Count == 0)
            {
              <p class="muted">Izdelek trenutno ni na nobenem odprodajnem seznamu.</p>
            }
            else
            {
              <div class="table-scroll" role="region" tabindex="0" aria-label="Odprodaja">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th scope="col">Vir</th><th scope="col" class="numeric">Vpisano</th><th scope="col" class="numeric">Prodano</th>
                      <th scope="col" class="numeric">Ostane</th><th scope="col" class="numeric">Zaloga</th><th scope="col" class="numeric">Redna cena</th>
                      <th scope="col" class="numeric">Popust %</th><th scope="col">Odprodajna cena</th><th scope="col">Stanje</th><th scope="col"></th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var item in ClearanceItems)
                    {
                      <tr>
                        <td>@item.Vir</td>
                        <td class="numeric">@ClearanceNum(item.ZacetnaKolicina)</td>
                        <td class="numeric">
                          @if (item.Prodano > 0) { <span title="@item.Narocila">@ClearanceNum(item.Prodano)</span><span class="visually-hidden"> (naročila: @item.Narocila)</span> }
                          else { <span class="muted">0</span> }
                        </td>
                        <td class="numeric">@ClearanceNum(item.Kolicina)</td>
                        <td class="numeric">
                          @if (item.Stock is { } stock)
                          {
                            <span title="@($"Ob vpisu: {ClearanceNum(stock.ZalogaObVpisu) ?? "ni podatka"}. " + (stock.ZalogaSveza ? "Zaloga je sveža in omeji količino na spletu." : "Zaloga ni sveža; velja vpisano minus naročila."))">@(ClearanceNum(stock.Zaloga) ?? "—")</span>
                            <PimChip Text="@ClearanceStock.Label(stock.Nacin)" Tone="@ClearanceStock.Tone(stock.Nacin)" Prefix="Zaloga: " />
                          }
                        </td>
                        <td class="numeric">@item.RednaCena</td>
                        <td class="numeric">@ClearanceNum(item.PopustOdstotek)</td>
                        <td class="numeric">@item.OdprodajnaCena</td>
                        <td>
                          @if (!item.IsActive) { <PimChip Text="@($"zaključena · {PimFormat.Ago(item.EndedUtc ?? item.ImportiranoUtc)}")" Prefix="Stanje: " /> }
                          else if (item.Kolicina is not > 0 && item.Prodano > 0) { <PimChip Text="razprodano" Tone="warn" Prefix="Stanje: " /> }
                          else if (item.Kolicina is not > 0) { <PimChip Text="količina 0" Tone="warn" Prefix="Stanje: " /> }
                          else { <PimChip Text="aktivna" Tone="good" Prefix="Stanje: " /> }
                        </td>
                        <td>
                          @if (CanEdit && item.IsActive)
                          {
                            <button type="button" class="secondary-button" disabled="@ClearanceBusy" @onclick="() => EndClearanceItemAsync(item.ClearanceItemId)">Zaključi</button>
                          }
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            }

            @if (CanEdit)
            {
              <div class="form-grid section-gap">
                <label class="form-field" for="card-clearance-qty">
                  Količina na zalogi
                  <input id="card-clearance-qty" class="form-input" type="number" min="0" step="1" @bind="ClearanceKolicina" />
                </label>
                <label class="form-field" for="card-clearance-discount">
                  Popust %
                  <input id="card-clearance-discount" class="form-input" type="number" min="0" max="100" step="1" @bind="ClearancePopust" />
                </label>
                <div>
                  <button type="button" class="primary-button" disabled="@ClearanceBusy" @onclick="SaveClearanceAsync">
                    @(ClearanceItems.Any(item => item.IsActive && item.Vir == ManualClearanceVir) ? "Posodobi odprodajo" : "Daj v odprodajo")
                  </button>
                </div>
              </div>
              <p class="hint">Ročni vnos se zapiše pod vir »@ManualClearanceVir«. Vpisana količina je trenutna zaloga — prodaja se od takrat šteje znova. Razstavni eksponat označiš na zavihku Splet, razdelek Oznake.</p>
            }
            @if (ClearanceMessage is not null) { <span class="save-ok" role="status">@ClearanceMessage</span> }
            @if (ClearanceError is not null) { <span class="save-error" role="alert">@ClearanceError</span> }
          </section>

          @* 233: splosne oznake artikla (danes samo "Razstavni eksponat"); nova oznaka je
             vrstica v pim.ProductFlagDefinition, ne nova migracija ali koda tu. *@
          <section id="panel-oznake" class="ui-card data-card tab-panel web-shops">
            <div class="subsection-head">
              <h2>Oznake</h2>
            </div>

            @if (Flags.Count == 0)
            {
              <PimMissing Object="pim.ProductFlagDefinition" What="seznam oznak" Needs="vsaj eno aktivno oznako v registru" />
            }
            else
            {
              <ul class="shop-list">
                @foreach (var flag in Flags)
                {
                  var flagCode = flag.FlagCode;
                  <li>
                    <label>
                      <input type="checkbox" disabled="@(!CanEdit || FlagBusy)"
                             checked="@FlagDraft(flagCode)"
                             @onchange="args => OnFlagChanged(flagCode, args)" />
                      <span class="shop-name">@flag.DisplayName</span>
                    </label>
                    @if (flag.ChangedBy is not null)
                    {
                      <span class="shop-trace">@flag.ChangedBy · @PimFormat.Ago(flag.ChangedUtc)</span>
                    }
                    @if (flagCode == ProductEditService.PackageOrderFlag)
                    {
                      @* 302/306: v katalog.csv stolpec »Pakirno naročanje« (1/0, 303); paket je »Pakirna količina« =
                         OBJAVLJENO Pakiranje 2 (pim.ProductCommercial). Kartica drugje kaže zajem, zato tu obe. *@
                      var package = PackageOrderNote(FlagDraft(flagCode));
                      <span class="@(package.Warning ? "save-error" : "shop-trace")" role="@(package.Warning ? "alert" : null)">@package.Text</span>
                    }
                  </li>
                }
              </ul>

              @if (CanEdit)
              {
                <div class="shop-actions">
                  <button type="button" class="primary-button" disabled="@(!FlagDirty || FlagBusy)" @onclick="SaveFlagsAsync">
                    Shrani oznake
                  </button>
                  @if (FlagMessage is not null) { <span class="save-ok" role="status">@FlagMessage</span> }
                  @if (FlagError is not null) { <span class="save-error" role="alert">@FlagError</span> }
                </div>
              }
            }
          </section>

        </section>

        @* Zavihek »SAOP endpoint«: celoten zapis, kot ga je poslal ERP, tudi polja, ki jih PIM
           ne hrani. Nabor stolpcev se med podjetji razlikuje, zato je oblika dolga in ne siroka,
           razvrstitev v sklope pa pride iz registra out.SaopXmlField (migracija 141).
           Posnetek se isce po zajetih straneh odgovora in traja nekaj sekund, zato se nalozi
           sele ob odprtju zavihka in ne ob vsakem odprtju kartice. *@
        <section id="panel-saop-endpoint" role="tabpanel" aria-labelledby="tab-saop-endpoint" tabindex="0" class="section-panel section-stack" hidden="@(Section != "saop-endpoint")">
          <header class="section-heading">
            <h2>SAOP endpoint</h2>
            <p>Zapis, kot ga ima ERP. Označene vrstice so odkloni od PIM-a.</p>
          </header>

          <section class="ui-card data-card tab-panel">
            <PimState Loading="SnapshotLoading" Error="@SnapshotError" Empty="false"
                      LoadingText="Iščem zajeti zapis SAOP …">
              @if (Snapshot is not null)
              {
                var head = Snapshot.Head;
                <div class="subsection-head">
                  <h2>Posnetek</h2>
                  <span>
                    @if (head.HasSnapshot)
                    {
                      <text>
                        @head.SourceTable · vir @head.SourceCode · @head.EntityType, stran @head.PageNumber ·
                        prevzeto @(head.ReceivedUtc?.ToPimLocal().ToString("g") ?? "—")
                        @if (head.LastModifiedAtUtc is DateTime changed)
                        {
                          <text>· v SAOP nazadnje spremenjen @changed.ToPimLocal().ToString("g")</text>
                        }
                      </text>
                    }
                    else { <text>posnetka ni</text> }
                  </span>
                </div>

                @if (!head.HasSnapshot)
                {
                  @* Prazna tabela ne pove nicesar; pojasnilo pride iz bralnega modela. *@
                  <p class="card-note">@head.Explanation</p>
                }
                else
                {
                  <p class="card-note">
                    @SnapshotDifferenceCount.ToString("N0") od @Snapshot.Rows.Count.ToString("N0") polj se razlikuje od PIM-a.
                    Polja brez kanonične ustreznice PIM ne hrani; prikazana so, ker so v zapisu ERP-ja.
                  </p>

                  @foreach (var group in Snapshot.Rows.GroupBy(row => row.Section))
                  {
                    <div class="subsection-head snapshot-group"><h3>@group.Key</h3><span>@group.Count().ToString("N0") polj</span></div>
                    <PimTable Caption="@($"Zapis SAOP — sklop {group.Key}")" Columns="SnapshotColumns">
                      <Rows>
                        @foreach (var row in group)
                        {
                          <tr class="@(row.IsDifferent ? "row-different" : null)">
                            <td><span class="code-value">@row.ElementName</span></td>
                            <td>@(row.Value ?? "—")</td>
                            <td>@(row.HasCanonical ? row.PimValue ?? "—" : "")</td>
                            <td>
                              @if (!row.HasCanonical) { <span class="muted">PIM ne hrani</span> }
                              else if (row.IsDifferent) { <PimChip Text="Odklon" Tone="bad" /> }
                              else { <PimChip Text="Se ujema" Tone="good" /> }
                            </td>
                          </tr>
                        }
                      </Rows>
                    </PimTable>
                  }
                }
              }
            </PimState>
          </section>
        </section>

        <section id="panel-media" role="tabpanel" aria-labelledby="tab-media" tabindex="0" class="section-panel section-stack" hidden="@(Section != "media")">
          <header class="section-heading"><h2>Mediji</h2><p>Vse slike in dokumenti izdelka, ne samo glavna slika.</p></header>
          <section class="ui-card tab-panel">
            <div class="subsection-head"><h2>Gradiva</h2><a href="mediji?izdelek=@(Uri.EscapeDataString(Detail.Header.ItemId))&podjetje=@OrganizationId">Vsi mediji tega izdelka</a></div>
            <ProductMediaGallery ProductName="@Detail.Header.Name" Media="@Detail.Media" Documents="@Detail.Documents" />
          </section>
        </section>

        <section id="panel-stock" role="tabpanel" aria-labelledby="tab-stock" tabindex="0" class="section-panel section-stack" hidden="@(Section != "stock")">
          <header class="section-heading"><h2>Zaloga</h2><p>Trenutno stanje razpoložljivosti po skladiščih in virih.</p></header>
          <section class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zaloga</h2><a href="zaloge?isci=@Uri.EscapeDataString(Detail.Header.ItemId)">Odpri poslovni pogled</a></div>
            @if (StockChecks?.IsMissing == true) { <PimMissing Object="intranet.GetStockChecks" What="preverbe zaloge tega artikla" Needs="stock.Snapshot, stock.Position, stock.UnmatchedPosition in potrjene pragove" /> }
            <PimState Empty="@(Detail.Stock.Count == 0)" EmptyText="Izdelek nima aktivnega zalogovnega posnetka.">
              <PimTable Caption="Aktivne zalogovne pozicije izdelka" Columns="StockColumns"><Rows>@foreach (var row in Detail.Stock) { <tr><td>@(row.WarehouseName ?? row.WarehouseCode ?? row.MatchKey)</td><td>@(row.ProviderKind ?? "—")</td><td class="numeric">@row.Quantity.ToString("N2")</td><td class="numeric">@(row.IncomingQuantity?.ToString("N2") ?? "—")</td><td>@(row.AvailabilityDate?.ToPimLocal().ToString("d") ?? "—")</td><td>@PimFormat.Ago(row.SnapshotUtc)</td><td>@StockRule(row)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>

        <section id="panel-quality-history" role="tabpanel" aria-labelledby="tab-quality-history" tabindex="0" class="section-panel section-stack" hidden="@(Section != "quality-history")">
          <header class="section-heading"><h2>Kakovost in zgodovina</h2><p>Odprte zahteve, pot v SAOP, revizijska sled in dokaz o izvoru.</p></header>
          <section id="panel-quality" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Kakovost</h2><span>@Detail.Issues.Count.ToString("N0") odprtih zahtev</span></div>
            <PimState Empty="@(Detail.Issues.Count == 0)" EmptyText="Izdelek nima odprtih validacijskih težav.">
              <PimTable Caption="Odprte težave po nivoju validacije" Columns="IssueColumns">
                <Rows>@foreach (var item in LayerIssues) { <tr><td><PimChip Text="@ValidationLayer.Label(item.Layer)" Tone="@(item.Layer == PimValidationLayer.Komerciala ? "warn" : null)" />@if (item.Shared) { <PimChip Text="SKUPNO" Tone="warn" /> }</td><td>@item.Issue.ProfileCode</td><td><PimChip Text="@item.Issue.Severity" Tone="@(item.Issue.Severity == "ERROR" ? "bad" : "warn")" /></td><td>@item.Issue.FieldCode</td><td>@item.Issue.Message</td><td>@item.Issue.LastDetectedUtc.ToPimLocal().ToString("g")</td></tr> }</Rows>
              </PimTable>
            </PimState>
          </section>

          <section id="panel-saop" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Zapisi v SAOP</h2><a href="saop">Odpri skupni pregled</a></div>
            <PimState Empty="@(Detail.Outbound.Count == 0)" EmptyText="Za izdelek ni odhodnih sporočil.">
              <PimTable Caption="Spremembe izdelka na poti v SAOP" Columns="OutboundColumns"><Rows>@foreach (var row in Detail.Outbound) { <tr><td>@row.OutboxMessageId</td><td>@row.FieldSummary</td><td>@row.Operation</td><td><PimChip Text="@StatusLabel(row.Status)" Tone="@Tone(row.Status)" /></td><td class="numeric">@row.AttemptCount</td><td>@Moment(row.SentUtc)</td><td>@Moment(row.VerifiedUtc)</td><td>@Value(row.DriftDetail ?? row.LastAttemptFailureReason ?? row.LastError)</td></tr> }</Rows></PimTable>
            </PimState>
          </section>


          <section id="panel-origin" class="ui-card data-card tab-panel">
            <div class="subsection-head"><h2>Izvor podatkov</h2></div>
            @if (!OriginsLoaded) { <p class="hint" role="status"><span class="opening-spinner" aria-hidden="true"></span> Iščem vhodne zapise izdelka …</p> }
            <PimState Empty="@(OriginsLoaded && Origins.Count == 0)" EmptyText="Za izdelek ni mogoče določiti vhodnega zapisa.">
              <PimTable Caption="Vhodni teki in strani, iz katerih izvirajo podatki" Columns="OriginColumns"><Rows>@foreach (var row in Origins) { <tr><td><a href="zajem/tezave/INBOX/@row.InboxId">@row.SourceCode</a></td><td><a href="zajem/teki/@row.RunId">@ShortId(row.RunId)</a></td><td>@row.EntityType</td><td class="numeric">@row.PageNumber</td><td class="numeric">@row.RecordOrdinal</td><td class="numeric">@row.ExtractedFieldCount</td><td>@row.Status</td><td>@row.ReceivedUtc.ToPimLocal().ToString("g")</td></tr> }</Rows></PimTable>
            </PimState>
          </section>
        </section>
      </div>

      @* Aktivnosti so en sam stalni modul. Podatke dobi iz Detail.History, ki ga vrne
         intranet.GetProductCard; zato ne vsebuje demonstracijskih dogodkov in ne kliče baze posebej. *@
      <aside class="activity-column" aria-label="Aktivnosti artikla">
        <section class="ui-card activity-card" aria-labelledby="activity-title">
          <div class="activity-head">
            <div>
              <h2 id="activity-title">Aktivnosti</h2>
              <p>Dejanske spremembe tega artikla</p>
            </div>
            <span class="activity-count" aria-label="@Detail.History.Count.ToString("N0") zabeleženih aktivnosti">@Detail.History.Count.ToString("N0")</span>
          </div>

          @if (Detail.History.Count == 0)
          {
            <p class="activity-empty">Za ta artikel še ni zabeleženih sprememb.</p>
          }
          else
          {
            <ol class="activity-timeline">
              @foreach (var activity in VisibleActivities)
              {
                <li class="activity-event">
                  <span class="activity-marker" aria-hidden="true"></span>
                  <time datetime="@activity.ChangedAtUtc.ToString("O")">@activity.ChangedAtUtc.ToPimLocal().ToString("d. MMM yyyy, HH:mm")</time>
                  <h3>@ActivityTitle(activity)</h3>
                  <p class="activity-change">@ActivitySummary(activity)</p>
                  <p class="activity-meta">
                    @if (!string.IsNullOrWhiteSpace(activity.ChangedBy)) { <span>@activity.ChangedBy</span> }
                    @if (!string.IsNullOrWhiteSpace(activity.Owner)) { <span>@activity.Owner</span> }
                    @if (!string.IsNullOrWhiteSpace(activity.ChangeSource)) { <span>@activity.ChangeSource</span> }
                  </p>
                  @if (!string.IsNullOrWhiteSpace(activity.Note)) { <p class="activity-note">@activity.Note</p> }
                </li>
              }
            </ol>

            @if (Detail.History.Count > InitialActivityCount)
            {
              <button type="button" class="activity-toggle" @onclick="ToggleActivities">
                @(ActivitiesExpanded ? "Prikaži manj" : $"Prikaži vse ({Detail.History.Count:N0})")
              </button>
            }
          }
        </section>
      </aside>
    </div>
  }
</PimState>

@code {
