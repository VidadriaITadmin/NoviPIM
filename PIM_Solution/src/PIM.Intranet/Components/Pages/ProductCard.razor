  IReadOnlyList<ProductChannelField> WebFields
  {
    get
    {
      if (Detail is null) return [];
      const string publication = "Objava";
      const string titles = "Nazivi in opisi";
      const string categories = "Kategorije";
      const string attributes = "Lastnosti izdelka";
      var rows = new List<ProductChannelField>
      {
        Channel("Objava na spletu", "Product.WebPublish", YesNo(Detail.Header.WebPublish), publication),
      };

      // Nazivi in opisi po jezikih: prikazani so vsi jeziki spletnih kanalov, tudi tam, kjer
      // besedila se ni — sicer manjkajocega prevoda ni mogoce vpisati.
      foreach (var textType in WebTextTypes)
        foreach (var language in WebLanguages)
          rows.Add(TextField($"{TextLabel(textType)} ({language})", textType, language, null, titles));

      rows.AddRange(Detail.Categories
        .Where(row => string.IsNullOrWhiteSpace(SelectedSite) || string.Equals(row.WebSite, SelectedSite, StringComparison.OrdinalIgnoreCase))
        .Select(row => new ProductChannelField($"Kategorija ({row.WebSite})", $"ProductCategory.{row.WebSite}",
          row.CategoryPath, row.Owner, null, null, false, true, ProductFieldEdit.None, "text", false, false,
          Hint: categories)));
      rows.Add(new("Slike za splet", "ProductMedia", Detail.Media.Count.ToString("N0"), "—", null, null, false, true,
        ProductFieldEdit.None, "text", false, false, Hint: categories));
      rows.Add(new("Spletni kanali", "canon.WebSite", string.Join(", ", WebSites), "—", null, null, false, true,
        ProductFieldEdit.None, "text", false, false, Hint: categories));

      rows.AddRange(Detail.Attributes
        .OrderBy(row => row.AttributeCode, StringComparer.CurrentCulture)
        .Select(row => AttributeField(row.AttributeCode, row.Value, attributes)));

      rows.AddRange(MissingRequired(rows, "ProductText.", "Manjka za splet"));
      rows.AddRange(MissingRequired(rows, "ProductAttribute.", "Manjka za splet"));
      return rows;
    }
  }

  /// <summary>Jeziki, ki jih kartica ponudi za vnos: tisti, ki so ze v izdelku, in tisti, ki jih zahteva validacija.</summary>
  IReadOnlyList<string> WebLanguages => LanguagesFor("WEB_TITLE");
  IReadOnlyList<string> ErpLanguages => LanguagesFor("TITLE_ERP");

  IReadOnlyList<string> LanguagesFor(string textType)
  {
    if (Detail is null) return ["sl"];
    var languages = Detail.Texts.Where(row => row.TextType == textType).Select(row => row.Language)
      .Concat(Detail.Issues.Select(issue => issue.FieldCode)
        .Where(code => code.StartsWith($"ProductText.{textType}.", StringComparison.OrdinalIgnoreCase))
        .Select(code => code.Split('.').Last()))
      .Append("sl")
      .Distinct(StringComparer.OrdinalIgnoreCase)
      .OrderBy(language => language == "sl" ? 0 : 1).ThenBy(language => language, StringComparer.Ordinal)
      .ToList();
    return languages;
  }

  /// <summary>Vrste spletnih besedil, ki jih izdelek ze ima ali jih zahteva validacija; brez ERP nazivov.</summary>
  IReadOnlyList<string> WebTextTypes
  {
    get
    {
      if (Detail is null) return ["WEB_TITLE"];
      return Detail.Texts.Select(row => row.TextType)
        .Concat(Detail.Issues.Select(issue => issue.FieldCode)
          .Where(code => code.StartsWith("ProductText.", StringComparison.OrdinalIgnoreCase))
          .Select(code => code.Split('.').Skip(1).FirstOrDefault() ?? ""))
        .Where(type => type.Length > 0 && !type.StartsWith("TITLE_ERP", StringComparison.OrdinalIgnoreCase))
        .Append("WEB_TITLE")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(type => type == "WEB_TITLE" ? 0 : 1).ThenBy(type => type, StringComparer.Ordinal)
        .ToList();
    }
  }

  IEnumerable<(PimValidationLayer Layer, ProductCardIssue Issue, bool Shared)> LayerIssues => Detail is null ? [] :
    Detail.Issues.SelectMany(issue => ProfileLayers(issue.ProfileCode).Select(layer => (layer, issue, IsShared(issue.ProfileCode))))
      .OrderBy(row => row.layer).ThenByDescending(row => row.issue.Severity == "ERROR").ThenBy(row => row.issue.ProfileCode);

  protected override Task OnParametersSetAsync() => LoadAsync();

  async Task LoadAsync()
  {
    Loading = true; Error = null; Detail = null; Origins = []; HeroImageFailed = false;
    try
    {
      // Kartica je dosegljiva iz seznama vseh podjetij, zato obseg dolocì izdelek sam;
      // privzeto podjetje bi tuji izdelek prikazalo kot neobstojec.
      var organization = await Data.GetProductOrganizationAsync(ProductId);
      if (organization is null) { Error = "Izdelek s to oznako ne obstaja."; return; }
      OrganizationId = organization.OrganizationId;
      var cardTask = Workbench.GetProductCardAsync(organization.OrganizationId, ProductId, "sl");
      var originTask = Workbench.GetProductOriginAsync(organization.OrganizationId, ProductId);
      var priceTask = Features.GetPriceChecksAsync(organization.OrganizationId, ProductId);
      var stockTask = Features.GetStockChecksAsync(organization.OrganizationId, ProductId);
      var sitesTask = Catalog.GetWebSitesAsync();
      var writableTask = SaopWrite.GetWritableFieldsAsync(organization.OrganizationId);
      await Task.WhenAll(cardTask, originTask, priceTask, stockTask, sitesTask, writableTask);
      Detail = await cardTask; Origins = await originTask; PriceChecks = await priceTask; StockChecks = await stockTask;
      Sites = await sitesTask; WritableSaopFields = await writableTask;
      var fragment = new Uri(Navigation.Uri).Fragment.TrimStart('#');
      if (Tabs.Contains(fragment)) Tab = fragment;
    }
    catch { Error = "Kartice izdelka trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  /* Urejanje ima dve poti in ena ne sme prevzeti druge:
       - polje, ki ga PIM pise nazaj v SAOP, gre v odhodno vrsto in caka odobritev,
       - besedilo in lastnost, ki sta last PIM, gresta naravnost v katalog in takoj revalidirata.
     Kartica zbere oboje v en gumb, izid pa pove loceno, da uporabnik ve, kaj je ze veljavno
     in kaj se caka. */

  void OnFieldChanged((ProductChannelField Field, string? Value) change)
  {
    SaveMessage = null;
    SaveError = null;
    var current = change.Value?.Trim();
    var original = change.Field.Value?.Trim();
    if (string.Equals(current ?? "", original ?? "", StringComparison.Ordinal))
    {
      Drafts.Remove(change.Field.FieldKey);
      DraftFields.Remove(change.Field.FieldKey);
      return;
    }

    Drafts[change.Field.FieldKey] = current;
    DraftFields[change.Field.FieldKey] = change.Field;
  }

  void DiscardChanges()
  {
    Drafts.Clear();
    DraftFields.Clear();
    SaveMessage = null;
    SaveError = null;
  }

  async Task SaveChangesAsync()
  {
    if (Drafts.Count == 0 || Detail is null || Busy) return;
    Busy = true;
    SaveMessage = null;
    SaveError = null;
    try
    {
      var actor = await ActorAsync();
      var note = $"Kartica izdelka {Detail.Header.ItemId}";
      var outcome = new List<string>();

      var texts = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Text).ToList();
      if (texts.Count > 0)
      {
        var result = await Edits.SaveTextsAsync(OrganizationId, ProductId,
          texts.Select(field => new ProductTextEdit(field.Language!, field.TextType!, Drafts[field.FieldKey])), actor, note);
        outcome.Add($"{result.ChangedCount:N0} besedil shranjenih");
      }

      var attributes = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Attribute).ToList();
      if (attributes.Count > 0)
      {
        var result = await Edits.SaveAttributesAsync(OrganizationId, ProductId,
          attributes.Select(field => new ProductAttributeEdit(field.AttributeCode!, Drafts[field.FieldKey])), actor, note);
        outcome.Add($"{result.ChangedCount:N0} lastnosti shranjenih");
      }

      var saop = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Saop).ToList();
      if (saop.Count > 0)
      {
        var result = await SaopWrite.EnqueueAsync(OrganizationId,
          saop.Select(field => (Detail.Header.ItemId, field.FieldKey, Drafts[field.FieldKey])), actor, "CARD", note);
        outcome.Add(result.Rejected == 0
          ? $"{result.Queued:N0} polj uvrščenih v vrsto za SAOP (skupina {result.OutboundBatchId})"
          : $"{result.Queued:N0} polj v vrsti za SAOP, {result.Rejected:N0} zavrnjenih (skupina {result.OutboundBatchId})");
      }

      Drafts.Clear();
      DraftFields.Clear();
      SaveMessage = string.Join(" · ", outcome) + ".";
      await LoadAsync();
    }
    catch (Exception exception)
    {
      // Procedura zavrne zapis, ki bi sel mimo SAOP, z govorno napako; ta mora priti do uporabnika.
      SaveError = exception is Microsoft.Data.SqlClient.SqlException sql && sql.Number is 52401 or 52402
        ? sql.Message
        : "Sprememb ni bilo mogoče shraniti.";
    }
    finally
    {
      Busy = false;
    }
  }

  async Task<string> ActorAsync()
  {
    var state = await Authentication.GetAuthenticationStateAsync();
    return state.User.Identity?.Name ?? "neznan";
  }

  static readonly string[] Tabs = ["overview", "erp", "komerciala", "splet", "media", "prices", "stock", "quality", "saop", "history", "origin"];
  RenderFragment TabButton(string key, string label) => builder =>
  {
    builder.OpenElement(0, "button"); builder.AddAttribute(1, "type", "button"); builder.AddAttribute(2, "role", "tab");
    builder.AddAttribute(3, "id", "tab-" + key); builder.AddAttribute(4, "aria-controls", "panel-" + key);
    builder.AddAttribute(5, "aria-selected", Flag(Tab == key)); builder.AddAttribute(6, "class", Tab == key ? "active" : null);
    builder.AddAttribute(7, "onclick", EventCallback.Factory.Create(this, () => SelectTab(key))); builder.AddContent(8, label); builder.CloseElement();
  };

  void SelectTab(string tab) { Tab = tab; Navigation.NavigateTo($"izdelki/{ProductId}#{tab}", replace: true); }
  void HeroFailed() => HeroImageFailed = true;
  ProductChannelField Field(string label, string key, string? value, bool inModel = true)
  {
    var field = Detail?.Fields.FirstOrDefault(row => row.FieldKey == key);
    return new(label, key, value ?? field?.Value, field?.Owner ?? "—", null, null, Pending(key), inModel);
  }
  bool Pending(string key) => Detail?.PendingOverlays.Any(row => row.FieldKey == key) == true;
  IReadOnlyList<PimValidationLayer> ProfileLayers(string profileCode)
  {
    var profile = Detail?.Profiles.FirstOrDefault(row => row.ProfileCode == profileCode);
    return profile is null ? [] : ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb);
  }
  bool IsShared(string profileCode) => Detail?.Profiles.Any(row => row.ProfileCode == profileCode && ValidationLayer.IsShared(row.Scope)) == true;
  IReadOnlyList<ProductCardIssue> IssuesFor(params PimValidationLayer[] layers) => Detail is null ? [] : Detail.Issues
    .Where(issue => ProfileLayers(issue.ProfileCode).Any(layers.Contains)).DistinctBy(issue => issue.ProductIssueId).ToList();
  string StatusFor(IReadOnlyList<PimValidationLayer> layers, string fallback, string? site = null)
  {
    if (Detail is null) return fallback;
    var profiles = Detail.Profiles.Where(profile => ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).Any(layers.Contains));
    if (!string.IsNullOrWhiteSpace(site)) profiles = profiles.Where(profile => ValidationLayer.IsShared(profile.Scope) || MatchesSite(profile.ProfileCode));
    var statuses = profiles.Select(profile => profile.Status).ToList();
    return statuses.Count == 0 ? fallback : statuses.Any(status => status == "INVALID") ? "INVALID" : statuses.Any(status => status != "VALID") ? "PENDING" : "VALID";
  }
  bool MatchesSite(string profileCode) => string.IsNullOrWhiteSpace(SelectedSite) || Normalize(profileCode).Contains(Normalize(SelectedSite), StringComparison.OrdinalIgnoreCase) || IsShared(profileCode);
  static string Normalize(string value) => new(value.Where(char.IsLetterOrDigit).ToArray());
  static string StockRule(ProductCardStock row) => row.MinimumStock is null && row.MaximumStock is null ? "—" : $"{Number(row.MinimumStock)} / {Number(row.MaximumStock)}";
  static string Moment(DateTime? value) => value?.ToLocalTime().ToString("g") ?? "—";
  static string YesNo(bool value) => value ? "Da" : "Ne";
  static string Flag(bool value) => value ? "true" : "false";
  static string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
  static string Number(decimal? value) => value?.ToString("N2") ?? "—";
  static string Measure(decimal? value, string unit) => value is null ? "—" : $"{value:N2} {unit}";
  static string ShortId(Guid value) => value.ToString("N")[..8];
  static string? OwnerTone(string owner) => owner switch { "PIM" => "good", "SAOP" => "warn", _ => null };
  static string? Tone(string value) => value switch { "VALID" or "Verified" or "Succeeded" or "Processed" => "good", "PENDING" or "Pending" or "PendingApproval" or "Retry" or "Sending" or "Sent" => "warn", "INVALID" or "Error" or "Dead" or "Drift" or "Failed" or "Quarantined" or "Cancelled" => "bad", _ => null };
  static string StatusLabel(string value) => value switch { "VALID" => "Veljavno", "INVALID" => "Neveljavno", "PENDING" => "Čaka izračun", "PendingApproval" => "Čaka odobritev", "Pending" => "V vrsti", "Sent" => "Poslano, nepotrjeno", "Verified" => "Potrjeno", "Drift" => "Odklon", "Dead" => "Mrtvo", "Retry" => "Ponovni poskus", _ => value };
}
