  }

  /// <summary>
  /// 116: prevedljiv atribut ima v canon.ProductAttribute vrstico na jezik (124) z ISTIM ključem polja
  /// »ProductAttribute.&lt;koda&gt;«. Kartica je iz vsake vrstice naredila svoje polje, dva soseda z istim
  /// @key pa sta sesula krog (izdelek 504, »Oblika svetilke« sl + en). Zdaj: ena vrstica na atribut je
  /// urejljiva (slovenska, sicer brez jezika), ostali jeziki so samo za branje z oznako jezika in lastnim
  /// ključem. Urejljiva jezikovna vrstica se shrani samo v svojem jeziku (pim.SaveProductAttributesBulk,
  /// 277) — pim.SaveProductAttributes jezika ne pozna in bi povozil vse jezike.
  /// </summary>
  static ProductCardAttribute PrimaryAttribute(IReadOnlyList<ProductCardAttribute> rows) => ProductCardAttributes.Primary(rows);

  /// <summary>Vrstice enega atributa (vsi jeziki).</summary>
  IReadOnlyList<ProductCardAttribute> StoredAttributes(string attributeCode) => Detail?.Attributes
    .Where(row => string.Equals(row.AttributeCode, attributeCode, StringComparison.OrdinalIgnoreCase))
    .ToList() ?? [];

  /// <summary>Vrednost atributa za prikaz v enem polju: slovenska vrstica, sicer brez jezika, sicer prva.</summary>
  string? StoredAttributeValue(string attributeCode)
  {
    var rows = StoredAttributes(attributeCode);
    return rows.Count == 0 ? null : PrimaryAttribute(rows).Value;
  }

  /// <summary>
  /// Polja enega atributa: eno urejljivo (glej <see cref="PrimaryAttribute"/>) in bralna za ostale jezike.
  /// Brez shranjene vrstice ali z eno samo vrstico ostane dosedanje eno polje.
  /// </summary>
  IEnumerable<ProductChannelField> AttributeFields(string attributeCode, IReadOnlyList<ProductCardAttribute> rows, string group,
    string? label = null, bool required = false)
  {
    var primary = rows.Count == 0 ? null : PrimaryAttribute(rows);
    var field = AttributeField(attributeCode, primary?.Value, group);
    field = field with { Label = label ?? field.Label, Required = field.Required || required };
    if (rows.Count > 1 && primary is not null)
    {
      var language = string.IsNullOrWhiteSpace(primary.LanguageCode) ? null : primary.LanguageCode.Trim().ToLowerInvariant();
      if (language is null || field.Edit != ProductFieldEdit.Attribute)
        // Vrstice brez jezika ni mogoče zapisati, ne da bi povozili prevode; SAOP pot jezika ne pozna.
        field = field with { Edit = ProductFieldEdit.None,
          LockReason = "Atribut ima vrednosti v več jezikih — uredi ga v delovnem listu (Excel), kjer ima vsak jezik svojo vrednost." };
      else
        field = field with { Label = $"{field.Label} · {language}", Language = language };
    }
    yield return field;

    if (primary is null) yield break;
    foreach (var row in rows.Where(row => row.ProductAttributeId != primary.ProductAttributeId)
      .OrderBy(row => row.LanguageCode, StringComparer.OrdinalIgnoreCase))
    {
      var language = string.IsNullOrWhiteSpace(row.LanguageCode) ? "brez jezika" : row.LanguageCode.Trim().ToLowerInvariant();
      yield return new ProductChannelField($"{attributeCode} · {language}",
        ProductCardAttributes.ReadOnlyKey(row),
        row.Value, "PIM", null, null, false, true, ProductFieldEdit.None, "text",
        Language: row.LanguageCode, AttributeCode: attributeCode, Hint: group,
        LockReason: $"Prevod ({language}) je tu samo za branje; uredi ga v delovnem listu (Excel), kjer ima vsak jezik svojo vrednost.");
    }
  }

