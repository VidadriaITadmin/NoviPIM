  /* Urejanje ima dve poti in ena ne sme prevzeti druge:
       - polje, ki ga PIM pise nazaj v SAOP, gre v odhodno vrsto in caka odobritev,
       - besedilo in lastnost, ki sta last PIM, gresta naravnost v katalog in takoj revalidirata.
     Kartica zbere oboje v en gumb, izid pa pove loceno, da uporabnik ve, kaj je ze veljavno
     in kaj se caka. */

  void OnFieldChanged((ProductChannelField Field, string? Value) change)
  {
    if (!CanEdit) return;
    SaveMessage = null;
    SaveError = null;
    var current = change.Value?.Trim();
    var original = change.Field.Value?.Trim();
    // Pri logičnem polju je izbira »da«, prikaz pa »Da« — ista vrednost, ne sprememba.
    var comparison = change.Field.Format == "bool" ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
    if (string.Equals(current ?? "", original ?? "", comparison))
    {
      Drafts.Remove(change.Field.FieldKey);
      DraftFields.Remove(change.Field.FieldKey);
      return;
    }

    Drafts[change.Field.FieldKey] = current;
    DraftFields[change.Field.FieldKey] = change.Field;
  }

  void DiscardChanges()
  {
    Drafts.Clear();
    DraftFields.Clear();
    SaveMessage = null;
    SaveError = null;
  }

  async Task SaveChangesAsync()
  {
    if (Drafts.Count == 0 || Detail is null || Busy) return;
    if (!CanEdit) { SaveError = "Tvoja vloga ne dovoljuje urejanja kartice."; return; }
    Busy = true;
    SaveMessage = null;
    SaveError = null;
    Conflicts.Clear();
    try
    {
      var actor = await ActorAsync();
      var note = $"Kartica izdelka {Detail.Header.ItemId}";
      var outcome = SavedOutcome;

      /* P3-18, pregled 2026-09-08: »ena transakcija ali jasen delni izid«. Ene transakcije ni
         mogoce imeti — besedila in lastnosti gresta v katalog, polja SAOP pa v odhodno vrsto z
         odobritvijo, torej v drugo pot in drug cas. Zato jasen delni izid: kar je slo skozi,
         ostane in se pove; kar ni, obdrzi svoj osnutek, da ga uporabnik ne izgubi in ne ugiba.
         Doslej je ena napaka pobrisala tudi vednost o tem, kaj je bilo ze shranjeno. */
      var saved = SavedBeforeFailure;
      saved.Clear();
      SavedOutcome.Clear();

      var texts = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Text).ToList();
      if (texts.Count > 0)
      {
        var result = await Edits.SaveTextsAsync(OrganizationId, ProductId,
          texts.Select(field => new ProductTextEdit(field.Language!, field.TextType!, Drafts[field.FieldKey],
            field.Value, CheckExpected: true)), actor, note);
        outcome.Add($"{result.ChangedCount:N0} besedil shranjenih — velja takoj");
        Conflicts.AddRange(result.Conflicts);
        foreach (var field in texts) saved.Add(field.FieldKey);
      }

      // 116: jezikovna vrstica prevedljivega atributa gre samo v svoj jezik (277). pim.SaveProductAttributes
      // jezika ne pozna in bi isto vrednost zapisal v vse jezike (slovenska »Neusmerjena« tudi v angleščino).
      var translated = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Attribute && field.Language is not null).ToList();
      if (translated.Count > 0)
      {
        var result = await Edits.SaveAttributesBulkAsync(OrganizationId,
          translated.Select(field => new ProductAttributeBulkEdit(ProductId, field.AttributeCode!, Drafts[field.FieldKey], field.Language)),
          actor, note);
        outcome.Add($"{result.ChangedCount:N0} lastnosti shranjenih v svojem jeziku — velja takoj");
        foreach (var skip in result.Skipped) outcome.Add($"Lastnosti niso shranjene — {skip.Reason}");
        if (result.Skipped.Count == 0) foreach (var field in translated) saved.Add(field.FieldKey);
      }

      var attributes = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Attribute && field.Language is null).ToList();
      if (attributes.Count > 0)
      {
        var result = await Edits.SaveAttributesAsync(OrganizationId, ProductId,
          attributes.Select(field => new ProductAttributeEdit(field.AttributeCode!, Drafts[field.FieldKey],
            field.Value, CheckExpected: true)), actor, note);
        outcome.Add($"{result.ChangedCount:N0} lastnosti shranjenih — velja takoj");
        Conflicts.AddRange(result.Conflicts);
        foreach (var field in attributes) saved.Add(field.FieldKey);
      }

      var saop = DraftFields.Values.Where(field => field.Edit == ProductFieldEdit.Saop).ToList();
      if (saop.Count > 0)
      {
        // Logično polje gre v vrsto kot 1/0, tako kot iz uvoza Excela: kanonična vrednost je 1/0 in
        // potrditev odmeva (243) se z »da« ne bi nikoli ujela.
        var result = await SaopWrite.EnqueueAsync(OrganizationId,
          saop.Select(field => (Detail.Header.ItemId, field.FieldKey,
            field.Format == "bool" ? PIM.Operations.ProductWorkbookContract.BoolValue(Drafts[field.FieldKey]) ?? Drafts[field.FieldKey] : Drafts[field.FieldKey])),
          actor, "CARD", note);
        // Uporabnik 2026-09-23: »se mora to prec povsod spremenit … v SAOP se pošlje zadnja sprememba,
        // ko odobri«. Kar je vrsta sprejela, gre v PIM takoj — ista pot kot uvoz delovnega lista (245);
        // zajem iz SAOP polja z neposlanim sporočilom ne povozi (273).
        var accepted = result.Rows.Where(row => row.Status != "Rejected" && row.FieldKey is not null)
          .Select(row => row.FieldKey!).ToHashSet(StringComparer.Ordinal);
        var erp = saop.Where(field => accepted.Contains(field.FieldKey)).ToList();
        if (erp.Count > 0)
        {
          var written = await Edits.SaveErpFieldsBulkAsync(OrganizationId,
            erp.Select(field => new ProductErpBulkEdit(ProductId, field.FieldKey,
              field.Format == "bool" ? PIM.Operations.ProductWorkbookContract.BoolValue(Drafts[field.FieldKey]) ?? Drafts[field.FieldKey] : Drafts[field.FieldKey])),
            actor, note);
          foreach (var skip in written.Skipped)
            outcome.Add($"{FieldLabel(skip.FieldKey)} ni zapisano v PIM — {skip.Reason}");
        }
        outcome.Add(result.Rejected == 0
          ? $"{result.Queued + result.Duplicates:N0} polj velja v PIM takoj; v SAOP gre zadnja vrednost po odobritvi na Izhod v SAOP (skupina {result.OutboundBatchId})"
          : $"{result.Queued + result.Duplicates:N0} polj velja v PIM takoj in čaka odobritev za SAOP, {result.Rejected:N0} zavrnjenih (skupina {result.OutboundBatchId})");
        if (result.Rejected > 0)
        {
          // Razlog zavrnitve pride iz baze skupaj s Queued/Rejected stevci (SaopWriteService.EnqueueAsync),
          // a se doslej ni prikazal — uporabnik je videl le golo stevilo, brez pojasnila.
          var reasons = result.Rows.Where(row => row.Status == "Rejected")
            .Select(row => $"{FieldLabel(row.FieldKey ?? "?")}: {row.Reason}");
          outcome.Add("Zavrnjeno — " + string.Join("; ", reasons));
        }
        foreach (var field in saop) saved.Add(field.FieldKey);
      }

      // 251: besedilo ali lastnost, ki manjka, lahko artikel naredi neveljaven za splet — takrat ga PIM
      // (ce je samodejni umik vklopljen) odkljuka s spletisc in to pove tu, ne sele v zvoncu.
      if (texts.Count > 0 || attributes.Count > 0)
        outcome.AddRange(WebWithdrawalText.PerProduct(
          await Withdrawals.AfterChangeAsync([ProductId], "KARTICA", actor, revalidate: false)));

      Drafts.Clear();
      DraftFields.Clear();
      SaveMessage = string.Join(" · ", outcome) + ".";
      await LoadAsync();
      await FocusSaveStatusAsync();
    }
    catch (Exception exception)
    {
      // Procedura zavrne zapis, ki bi sel mimo SAOP, z govorno napako; ta mora priti do uporabnika.
      var reason = exception is Microsoft.Data.SqlClient.SqlException sql && sql.Number is 52401 or 52402
        ? sql.Message
        : "Sprememb ni bilo mogoče shraniti.";

      // Delni izid: kar je slo skozi pred napako, ostane shranjeno in se to pove; osnutki tistega,
      // kar ni slo skozi, ostanejo v obrazcu, da uporabnik dela ne izgubi.
      var savedKeys = SavedBeforeFailure;
      if (savedKeys.Count > 0)
      {
        foreach (var key in savedKeys) { Drafts.Remove(key); DraftFields.Remove(key); }
        SaveError = $"{reason} Del je bil shranjen pred napako: {string.Join(" · ", SavedOutcome)}. "
          + $"Neshranjenih polj: {Drafts.Count}.";
        // Osvezitev sme pasti; sporocilo o delnem izidu je pomembnejse od svezih vrednosti.
        try { await LoadAsync(); } catch { }
      }
      else
      {
        SaveError = reason;
      }

      await FocusSaveStatusAsync();
    }
    finally
    {
      Busy = false;
    }
  }

