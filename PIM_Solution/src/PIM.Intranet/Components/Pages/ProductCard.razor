  async Task RecheckWebAsync()
  {
    WebCheckBusy = true; WebCheckMessage = null; WebCheckError = null;
    try
    {
      await QualityWrite.ValidateAsync(ProductId);
      // 251: preverba, ki pokaže, da artikel na označeno spletišče ne sme več, ga (ob vklopljenem
