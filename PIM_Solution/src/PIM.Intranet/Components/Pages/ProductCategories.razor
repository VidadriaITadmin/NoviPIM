@page "/izdelki/kategorije"
@page "/izdelki/{ItemId}/kategorije"
@using PIM.Intranet.Components.Pages.ProductCardParts
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR")]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.IntranetDataService Data
@inject NavigationManager Navigation

@* Ročna uvrstitev enega izdelka. Od 2026-09-28 je isti gradnik (ProductCategoryEditor) tudi na kartici
   izdelka, zavihek Splet — uporabnik je kategorijo iskal tam. Ta stran ostane za hiter vnos po šifri. *@

<PageTitle>Uvrstitev izdelka</PageTitle>
<PimPage OrganizationScope="true" Title="Uvrstitev izdelka"
         Subtitle="Ročna uvrstitev je močnejša od vira: ponovna preslikava dobaviteljevega XML je ne povozi. Stara vrednost ostane v zgodovini sprememb."
         Crumbs="Crumbs" />

@if (Error is not null) { <p class="message-state error-message" role="alert">@Error</p> }

<section class="ui-card panel" aria-label="Izbira izdelka">
  <h2>1. Kateri izdelek</h2>
  <div class="form-grid">
    <label class="form-field" for="product-item">
      Šifra artikla
      <input id="product-item" class="form-input" @bind="ItemIdInput" @onkeyup="OnKeyUp" placeholder="BA.BC15.00300" />
    </label>
  </div>
  <div class="page-actions">
    <button type="button" class="primary-button" @onclick="Find">Poišči</button>
  </div>
  @if (OrganizationName is not null)
  {
    <p class="hint">Podjetje: @OrganizationName. Uvrstitev velja samo zanj. Isto urejanje je tudi na kartici izdelka, zavihek Splet.</p>
  }
</section>

@if (OrganizationId is int organizationId && !string.IsNullOrWhiteSpace(ShownItemId))
{
  <section class="ui-card panel section-gap" aria-label="Uvrstitev po spletnih straneh">
    <h2>2. Kje je izdelek zdaj</h2>
    <ProductCategoryEditor OrganizationId="organizationId" ItemId="@ShownItemId" CanEdit="true" IdPrefix="uvrstitev" />
  </section>
}

@code {
  [Parameter] public string? ItemId { get; set; }

  int? OrganizationId;
  string? OrganizationName;
  string ItemIdInput = "";
  string? ShownItemId;
  string? Error;

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Izdelki", "izdelki"), new("Uvrstitev")];

  protected override async Task OnInitializedAsync()
  {
    var organization = await Data.GetCurrentOrganizationAsync();
    if (organization is null) { Error = "Aktivna organizacija ni na voljo."; return; }
    OrganizationId = organization.OrganizationId;
    OrganizationName = organization.Name;
  }

  /// <summary>Šifra pride iz naslova — tudi ob »nazaj« v brskalniku, ko se stran ne ustvari znova.</summary>
  protected override void OnParametersSet()
  {
    if (string.IsNullOrWhiteSpace(ItemId)) return;
    ItemIdInput = ItemId;
    ShownItemId = ItemId.Trim();
  }

  void Find()
  {
    Error = null;
    if (string.IsNullOrWhiteSpace(ItemIdInput)) { Error = "Vpiši šifro artikla."; return; }
    // Šifra v naslovu: povezavo se da deliti, nazaj v brskalniku deluje.
    Navigation.NavigateTo($"izdelki/{Uri.EscapeDataString(ItemIdInput.Trim())}/kategorije");
  }

  void OnKeyUp(KeyboardEventArgs args)
  {
    if (args.Key == "Enter") Find();
  }
}
