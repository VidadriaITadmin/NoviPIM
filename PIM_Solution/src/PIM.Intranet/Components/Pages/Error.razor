@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

@* A5, pregled 2026-09-08: to je bila nespremenjena angleska predloga (»Error.«, »Development
   Mode«). Stran napake je zadnje, kar uporabnik vidi, zato mora biti v jeziku aplikacije, povedati
   mora ID zahteve (brez njega dnevnika ni mogoce najti) in ponuditi pot naprej. *@

<PageTitle>Napaka</PageTitle>

<PimPage Title="Nekaj je šlo narobe" Subtitle="Zahteve ni bilo mogoče dokončati. Podatki niso bili spremenjeni, razen če stran pove drugače." />

<section class="ui-card error-page">
  <p>
    Napaka je zabeležena. Če se ponovi, pošlji skrbniku spodnjo oznako zahteve — z njo je v
    dnevniku mogoče najti točno to napako.
  </p>

  @if (ShowRequestId)
  {
    <p class="request-id">
      <span>Oznaka zahteve</span>
      <code class="code-value">@RequestId</code>
    </p>
  }
  else
  {
    <p class="muted">Oznake zahteve za ta prikaz ni.</p>
  }

  <div class="error-actions">
    <a class="primary-button" href="nadzorna-plosca">Nazaj na nadzorno ploščo</a>
  </div>
</section>

@code {
  [CascadingParameter] private HttpContext? HttpContext { get; set; }

  private string? RequestId { get; set; }
  private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

  protected override void OnInitialized() =>
    RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
