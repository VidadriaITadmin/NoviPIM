@page "/teki-obdelave"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.IntranetDataService Data
<PageTitle>Uvozi</PageTitle>
<div class="page-header"><div><h1>Uvozi</h1><p>Viri in zgodovina procesnih tekov iz PIM baze.</p></div></div>
@* Povezav na druge strani tu ni vec kot zavihkov: videti so kot preklop pogleda, v resnici
   pa zamenjajo stran in z njo navigacijsko drevo. Odlocitev uporabnika 2026-08-28. *@
@if (Rows is not null) {
  <section class="source-grid" aria-label="Zadnji tek po virih">
  @foreach (var source in Sources) { var last = source.First();
    <article class="ui-card source-card"><div><h2 class="source-name">@(last.SourceCode??last.Pipeline)</h2><span class="status-chip @Chip(last.Status)"><span class="visually-hidden">Status: </span>@Status(last.Status)</span></div><dl><dt>Zadnji tek</dt><dd>@last.StartedUtc.ToPimLocal().ToString("g")</dd><dt>Prebrane vrstice</dt><dd class="numeric">@last.RowsRead.ToString("N0")</dd><dt>Napake</dt><dd class="numeric">@last.RowsFailed.ToString("N0")</dd></dl></article> }
  </section> }
<section class="ui-card toolbar" role="search" aria-labelledby="runs-filter-title">
  <h2 id="runs-filter-title" class="visually-hidden">Filtriranje uvozov</h2>
  <label class="visually-hidden" for="run-search">Poišči uvoz</label><input id="run-search" type="search" class="search-input" placeholder="Poišči postopek ali vir …" @bind="Search" @bind:event="oninput" />
  <label class="visually-hidden" for="run-status">Status</label><select id="run-status" class="filter-select" @bind="FilterStatus"><option value="">Vsi statusi</option>@foreach (var status in Statuses) { <option value="@status">@Status(status)</option> }</select>
  <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>
</section>
<section class="ui-card data-card" aria-label="Zgodovina procesnih tekov">
@if (Loading) { <div class="loading-state" role="status">Nalaganje uvozov …</div> }
else if (Error is not null) { <div class="error-state" role="alert">@Error</div> }
else if (Filtered.Count == 0) { <div class="empty-state">Ni procesnih tekov za izbrane filtre.</div> }
else {
  <div class="table-scroll" role="region" tabindex="0" aria-label="Tabela zgodovine uvozov">
    <table class="data-table"><caption>Zgodovina uvozov</caption><thead><tr><th scope="col">Začetek</th><th scope="col">Postopek</th><th scope="col">Vir</th><th scope="col" class="numeric">Vrstic</th><th scope="col" class="numeric">Uspešno</th><th scope="col" class="numeric">Napake</th><th scope="col">Status</th><th scope="col">Zaključek</th></tr></thead><tbody>@foreach (var row in PageRows) { <tr><td>@row.StartedUtc.ToPimLocal().ToString("g")</td><td>@row.Pipeline</td><td>@(row.SourceCode??"—")</td><td class="numeric">@row.RowsRead.ToString("N0")</td><td class="numeric">@row.RowsSucceeded.ToString("N0")</td><td class="numeric">@row.RowsFailed.ToString("N0")</td><td><span class="status-chip @Chip(row.Status)"><span class="visually-hidden">Status: </span>@Status(row.Status)</span></td><td>@(row.EndedUtc?.ToPimLocal().ToString("g")??"—")</td></tr> }</tbody></table>
  </div>
  <nav class="pagination" aria-label="Strani zgodovine uvozov"><button type="button" disabled="@(Page==0)" @onclick="Previous">Prejšnja</button><span class="page-position">Stran @(Page+1) od @PageCount</span><button type="button" disabled="@(Page+1>=PageCount)" @onclick="Next">Naslednja</button></nav> }
</section>
@code{IReadOnlyList<PIM.Intranet.Services.PipelineRunRow>? Rows;bool Loading=true;string? Error;string Search="",FilterStatus="";int Page;const int PageSize=10;IEnumerable<IGrouping<string,PIM.Intranet.Services.PipelineRunRow>> Sources=>(Rows??[]).GroupBy(x=>x.SourceCode??x.Pipeline).Select(x=>x.OrderByDescending(y=>y.StartedUtc).GroupBy(y=>x.Key).First());IEnumerable<string> Statuses=>(Rows??[]).Select(x=>x.Status).Distinct().Order();IReadOnlyList<PIM.Intranet.Services.PipelineRunRow> Filtered=>(Rows??[]).Where(x=>(FilterStatus==""||x.Status==FilterStatus)&&(Search==""||x.Pipeline.Contains(Search,StringComparison.OrdinalIgnoreCase)||(x.SourceCode?.Contains(Search,StringComparison.OrdinalIgnoreCase)??false))).ToList();IEnumerable<PIM.Intranet.Services.PipelineRunRow> PageRows=>Filtered.Skip(Page*PageSize).Take(PageSize);int PageCount=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/(decimal)PageSize));protected override async Task OnInitializedAsync(){try{var org=await Data.GetCurrentOrganizationAsync();if(org is null){Error="Aktivna organizacija ni na voljo.";return;}Rows=await Data.GetPipelineRunsAsync(org.OrganizationId);}catch{Error="Uvozov trenutno ni mogoče naložiti.";}finally{Loading=false;}}void Previous()=>Page=Math.Max(0,Page-1);void Next()=>Page=Math.Min(PageCount-1,Page+1);
  // Živo stanje seznama: bralcu zaslona se sporoči nalaganje, napaka ali dejansko število rezultatov.
  string ResultSummary=>Loading?"Nalaganje …":Error is not null?"Rezultati niso na voljo":$"{Filtered.Count} rezultatov";
  // Čip nosi barvo, prevod pa samo znane statuse; neznana vrednost iz baze ostane vidna taka, kot je.
  static string Chip(string value)=>value=="Succeeded"?"good":value is "Failed" or "Cancelled"?"bad":"warn";static string Status(string value)=>value switch{"Succeeded"=>"Uspešno","Failed"=>"Napaka","Cancelled"=>"Preklicano","Running"=>"V teku","Pending"=>"Čaka",_=>value};}
