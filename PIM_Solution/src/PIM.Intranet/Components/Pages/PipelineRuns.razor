@page "/teki-obdelave"
@attribute [Authorize]
@inject PIM.Intranet.Services.IntranetDataService Data
<PageTitle>Uvozi</PageTitle><div class="page-header"><div><h1>Uvozi</h1><p>Viri in zgodovina procesnih tekov iz PIM baze.</p></div></div><div class="page-tabs"><span class="page-tab active">Zgodovina uvozov</span><a class="page-tab" href="outbound">Izvozi</a></div>
@if(Loading){<div class="ui-card loading-state">Nalaganje uvozov …</div>}else if(Error is not null){<div class="ui-card error-state" role="alert">@Error</div>}else{<div class="source-grid">@foreach(var source in Sources){var last=source.First();<section class="ui-card source-card"><div><strong>@(last.SourceCode??last.Pipeline)</strong><span class="status-chip @Chip(last.Status)">@Status(last.Status)</span></div><dl><dt>Zadnji tek</dt><dd>@last.StartedUtc.ToLocalTime().ToString("g")</dd><dt>Vrstic</dt><dd>@last.RowsRead.ToString("N0")</dd><dt>Napake</dt><dd>@last.RowsFailed.ToString("N0")</dd></dl></section>}</div><section class="ui-card toolbar"><label class="visually-hidden" for="run-search">Poišči uvoz</label><input id="run-search" class="search-input" placeholder="Poišči postopek ali vir …" @bind="Search" @bind:event="oninput"/><label class="visually-hidden" for="run-status">Status</label><select id="run-status" class="filter-select" @bind="FilterStatus"><option value="">Vsi statusi</option>@foreach(var status in Statuses){<option>@status</option>}</select><span class="result-count">@Filtered.Count rezultatov</span></section><section class="ui-card data-card">@if(Filtered.Count==0){<div class="empty-state">Ni procesnih tekov za izbrane filtre.</div>}else{<table class="data-table"><caption>Zgodovina uvozov</caption><thead><tr><th>Začetek</th><th>Postopek</th><th>Vir</th><th>Vrstic</th><th>Uspešno</th><th>Napake</th><th>Status</th><th>Zaključek</th></tr></thead><tbody>@foreach(var row in PageRows){<tr><td>@row.StartedUtc.ToLocalTime().ToString("g")</td><td>@row.Pipeline</td><td>@(row.SourceCode??"—")</td><td>@row.RowsRead.ToString("N0")</td><td>@row.RowsSucceeded.ToString("N0")</td><td>@row.RowsFailed.ToString("N0")</td><td><span class="status-chip @Chip(row.Status)">@Status(row.Status)</span></td><td>@(row.EndedUtc?.ToLocalTime().ToString("g")??"—")</td></tr>}</tbody></table><nav class="pagination" aria-label="Strani naloženih uvozov"><button disabled="@(Page==0)" @onclick="()=>Page--">Prejšnja</button><span>Stran @(Page+1) od @PageCount</span><button disabled="@(Page+1>=PageCount)" @onclick="()=>Page++">Naslednja</button></nav>}</section>}
@code{IReadOnlyList<PIM.Intranet.Services.PipelineRunRow>? Rows;bool Loading=true;string? Error;string Search="",FilterStatus="";int Page;const int PageSize=10;IEnumerable<IGrouping<string,PIM.Intranet.Services.PipelineRunRow>> Sources=>(Rows??[]).GroupBy(x=>x.SourceCode??x.Pipeline).Select(x=>x.OrderByDescending(y=>y.StartedUtc).GroupBy(y=>x.Key).First());IEnumerable<string> Statuses=>(Rows??[]).Select(x=>x.Status).Distinct().Order();IReadOnlyList<PIM.Intranet.Services.PipelineRunRow> Filtered=>(Rows??[]).Where(x=>(FilterStatus==""||x.Status==FilterStatus)&&(Search==""||x.Pipeline.Contains(Search,StringComparison.OrdinalIgnoreCase)||(x.SourceCode?.Contains(Search,StringComparison.OrdinalIgnoreCase)??false))).ToList();IEnumerable<PIM.Intranet.Services.PipelineRunRow> PageRows=>Filtered.Skip(Page*PageSize).Take(PageSize);int PageCount=>Math.Max(1,(int)Math.Ceiling(Filtered.Count/(decimal)PageSize));protected override async Task OnInitializedAsync(){try{var org=await Data.GetCurrentOrganizationAsync();if(org is null){Error="Aktivna organizacija ni na voljo.";return;}Rows=await Data.GetPipelineRunsAsync(org.OrganizationId);}catch{Error="Uvozov trenutno ni mogoče naložiti.";}finally{Loading=false;}}static string Chip(string value)=>value=="Succeeded"?"good":value is "Failed" or "Cancelled"?"bad":"warn";static string Status(string value)=>value switch{"Succeeded"=>"Uspešno","Failed"=>"Napaka","Cancelled"=>"Preklicano","Running"=>"V teku","Pending"=>"Čaka",_=>value};}
