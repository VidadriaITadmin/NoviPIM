@page "/sistem/opravila"
@attribute [Authorize(Roles = "ADMIN")]
@rendermode InteractiveServer
@implements IDisposable
@inject PIM.Automation.AutomationStore Opravila
@inject PIM.Intranet.Services.AdminConsoleService Nadzor
@inject AuthenticationStateProvider Authentication

@*
  Opravila (migracija 237): en posel = ena odgovornost, en urnik, ena časovna meja.

  Uporabnik 2026-09-21: »Urniki obstajajo na dveh ravneh: pet WorkerCycle ciklov in še 51 vrstic
  ScheduleProfile. Zato je težko odgovoriti na preprosto vprašanje: kaj dejansko poganja ta postopek?«
  Odslej je odgovor tu: posle iz ops.JobDefinition poganja gostitelj avtomatike (PIM.AutomationHost),
  intranet je konzola. Ročni zagon in ustavitev sta ZAHTEVI (ops.RequestJobRun, ops.RequestJobCancel),
  ki ju gostitelj prevzame ob naslednjem tiku — zato stran pove, ali gostitelj sploh utripa.
*@

<PageTitle>Opravila</PageTitle>
<PimPage Title="Opravila"
         Subtitle="@($"Kaj se izvaja, kdaj, s katero časovno mejo in od česa je odvisno. Vsak zagon vedno konča kot uspešen, padel, presežen, ustavljen, zapuščen ali blokiran. Časi so v naši uri ({PimTime.ZoneLabel}).")"
         Crumbs="Crumbs">
  <Actions>
    <button type="button" class="filter-button" disabled="@Loading" @onclick="NaloziAsync">Osveži</button>
  </Actions>
</PimPage>

<PimTabs Active="opravila" Tabs="NadzorTabs.Tabs" Label="Pogledi nadzora" />

@if (Message is not null) { <p class="message-state success-message" role="status" aria-live="polite">@Message</p> }
@if (Error is not null) { <p class="message-state error-message" role="alert">@Error</p> }

@* ── Gostitelj ─────────────────────────────────────────────────────────────── *@
<section class="ui-card data-card section-gap" aria-labelledby="gostitelj-naslov">
  <div class="panel-title">
    <h2 id="gostitelj-naslov">Gostitelj avtomatike</h2>
    @if (Gostitelj is { } g)
    {
      <PimChip Text="@(g.IsAutomationHostLive ? "Teče" : g.HasLease && g.LeaseIsLive ? "Uro drži intranet (rezerva)" : "Ne teče")"
               Tone="@(g.IsAutomationHostLive ? "good" : "bad")" Prefix="Gostitelj: " />
    }
  </div>
  @if (Gostitelj is { } gost)
  {
    <dl class="host-facts">
      <div><dt>Najem drži</dt><dd>@(gost.Owner is null ? "—" : gost.Owner)@(gost.Application is { } app ? $" ({app})" : "")</dd></div>
      <div><dt>Zadnji utrip</dt><dd>@PimTime.FormatWithAge(gost.HeartbeatUtc, "nikoli")@(gost.TickCount is { } t ? $" · tikov {t:N0}" : "")</dd></div>
      <div><dt>Posli</dt><dd>@gost.EnabledJobs vklopljenih · @gost.RunningJobs teče@(gost.StaleRunningJobs > 0 ? $" ({gost.StaleRunningJobs} brez utripa)" : "") · @gost.PendingRequests čakajočih zahtev</dd></div>
      <div><dt>Zadnjih 24 h</dt><dd>@gost.RunsLast24h zagonov · <span class="@(gost.FailedLast24h > 0 ? "error-count" : "muted")">@gost.FailedLast24h padlih</span> · @gost.BlockedLast24h blokiranih</dd></div>
    </dl>
    @if (!gost.IsAutomationHostLive)
    {
      <div class="message-state error-message" role="alert">
        Gostitelj avtomatike (PIM.AutomationHost) ne utripa. Posli ne tečejo; zahteve za zagon čakajo, dokler se ne zažene.
        Preveri storitev: <span class="code-value">Get-Service PIM.AutomationHost</span> oziroma na razvoju
        <span class="code-value">dotnet run --project PIM_Solution\workers\PIM.AutomationHost</span>.
        @if (gost.HasLease && gost.LeaseIsLive && !gost.IsAutomationHostLive) { <text> Uro trenutno drži intranet kot rezerva in poganja samo stare cikle (Izvajalniki).</text> }
      </div>
    }
  }
  else { <p class="panel-note">Stanja gostitelja ni mogoče prebrati.</p> }
  <p class="panel-note">
    Ročni zagon je zahteva, ki jo gostitelj prevzame ob naslednjem tiku (do 15 s); vrata odvisnosti veljajo tudi zanjo — izvoz kataloga
    brez uspešne objave bo blokiran in to zapisano. Tehnični razporedi posameznih postopkov (ops.ScheduleProfile), ki jih workerji
    preverjajo sami, so na <a href="sistem?pogled=postopki">Postopki (tehnično)</a>; procesi in dnevniki na <a href="sistem/workerji">Izvajalnikih</a>.
  </p>
</section>

@* ── Posli po tokovih ───────────────────────────────────────────────────────── *@
<PimState Loading="@(Posli is null)" Empty="@(Posli is { Count: 0 })" EmptyText="V bazi ni poslov (migracija 237)." LoadingText="Berem opravila …">
  @foreach (var tok in JobCatalog.FlowOrder)
  {
    var vTOku = (Posli ?? []).Where(p => p.Flow == tok).OrderBy(p => p.SortOrder).ToList();
    if (vTOku.Count == 0) continue;
    <section class="ui-card data-card section-gap" aria-labelledby="@($"tok-{tok}")">
      <div class="panel-title">
        <h2 id="@($"tok-{tok}")">@JobFlows.Label(tok)</h2>
        <span class="muted">@JobFlows.Description(tok)</span>
      </div>
      <PimTable Caption="@($"Posli toka {JobFlows.Label(tok)}")" Columns="Stolpci">
        <Rows>
          @foreach (var posel in vTOku)
          {
            var kljuc = posel.JobKey;
            var odvisnosti = Odvisnosti.Where(d => d.JobKey == kljuc).ToList();
            <tr class="@(JobRunStatus.IsFailure(posel.LastStatus) && posel.IsEnabled ? "row-alarm" : null)">
              <td class="job-cell">
                <strong>@posel.Label</strong> <span class="code-value key">@posel.JobKey</span>
                <div class="job-note">@posel.Description</div>
                @if (posel.Reach != "Internal") { <span class="reach-flag">@Doseg(posel)</span> }
                @if (posel.IsFlowResult) { <span class="result-flag">rezultat toka</span> }
                @foreach (var d in odvisnosti)
                {
                  <div class="job-note dependency" title="@d.Note">
                    @(d.IsGate ? "vrata" : "sprožilec"): @(Posli?.FirstOrDefault(p => p.JobKey == d.DependsOnJobKey)?.Label ?? d.DependsOnJobKey)@(d.MaxAgeSeconds is { } m ? $" (uspeh mlajši od {m / 60} min)" : "")
                  </div>
                }
              </td>
              <td>
                <div class="schedule-edit">
                  @if (posel.IntervalSeconds is not null)
                  {
                    <label class="visually-hidden" for="@($"razmik-{kljuc}")">Razmik v minutah za @posel.Label</label>
                    <input id="@($"razmik-{kljuc}")" type="number" min="1" max="1440" class="filter-select interval-input"
                           value="@Minute(posel)" @onchange="@(e => NastaviMinute(kljuc, e.Value?.ToString()))" />
                    <span class="muted">min</span>
                  }
                  else
                  {
                    <label class="visually-hidden" for="@($"ura-{kljuc}")">Ura dnevnega zagona za @posel.Label</label>
                    <span class="muted">vsak dan ob</span>
                    <input id="@($"ura-{kljuc}")" type="time" class="filter-select time-input"
                           value="@Ura(posel)" @onchange="@(e => NastaviUro(kljuc, e.Value?.ToString()))" />
                  }
                </div>
                <div class="schedule-edit">
                  <label class="visually-hidden" for="@($"meja-{kljuc}")">Časovna meja v minutah za @posel.Label</label>
                  <span class="muted">meja</span>
                  <input id="@($"meja-{kljuc}")" type="number" min="1" max="1440" class="filter-select interval-input"
                         value="@MejaMinute(posel)" @onchange="@(e => NastaviMejo(kljuc, e.Value?.ToString()))" />
                  <span class="muted">min</span>
                  <button type="button" class="small-action" disabled="@(Busy || !Spremenjen(posel))" @onclick="() => ShraniAsync(posel)">Shrani</button>
                </div>
                <div class="schedule-edit">
                  <PimChip Text="@(posel.IsEnabled ? "Vklopljen" : "Izklopljen")" Tone="@(posel.IsEnabled ? "good" : "bad")" />
                  <button type="button" class="small-action @(posel.IsEnabled ? "warn-action" : "good-action")" disabled="@Busy" @onclick="() => PreklopiAsync(posel)">
                    @(posel.IsEnabled ? "Izklopi" : "Vklopi")
                  </button>
                </div>
              </td>
              <td>
                @if (posel.IsRunning)
                {
                  <div><PimChip Text="@($"Teče {Trajanje(DateTime.UtcNow - (posel.RunningSinceUtc ?? DateTime.UtcNow))}")" Tone="@(posel.RunningIsStale ? "bad" : "warn")" /></div>
                  <div class="job-note">od @PimTime.FormatTime(posel.RunningSinceUtc) na @posel.RunningHost@(posel.RunningStep is { } korak ? $" · {korak}" : "")</div>
                  @if (posel.RunningIsStale) { <div class="drift-flag">brez utripa več kot 10 min — gostitelj ga bo zaprl kot zapuščenega</div> }
                  @if (posel.CancelRequestedUtc is not null) { <div class="job-note">ustavitev zahtevana @PimTime.FormatTime(posel.CancelRequestedUtc)</div> }
                }
                else if (posel.LastStartedUtc is null) { <span class="muted">še nikoli</span> }
                else
                {
                  <div class="nowrap">@PimTime.FormatWithAge(posel.LastStartedUtc)</div>
                  <div class="job-note">
                    <PimChip Text="@StatusOznaka(posel.LastStatus)" Tone="@StatusTon(posel.LastStatus)" />
                    trajanje @PimTime.Duration(posel.LastDurationMs) · @Sprozilec(posel.LastTriggeredBy)
                    @if (posel.LastStepsFailed is > 0) { <span class="error-count"> · padlih korakov: @posel.LastStepsFailed</span> }
                    @if (posel.LastStepsBlocked is > 0) { <span class="error-count"> · blokiranih: @posel.LastStepsBlocked</span> }
                  </div>
                  @if (posel.LastError is { Length: > 0 } napaka) { <div class="drift-flag" title="@napaka">@Skrajsaj(napaka)</div> }
                  <div class="job-note">zadnji uspeh: @PimTime.FormatWithAge(posel.LastSucceededUtc, "nikoli")</div>
                }
                @if (posel.OpenAlerts > 0) { <div class="job-note error-count">odprtih alarmov: @posel.OpenAlerts</div> }
              </td>
              <td class="nowrap">
                @if (posel.IsRequested) { <div><PimChip Text="Zahteva oddana" Tone="warn" /></div><div class="job-note">@posel.RequestedBy · @PimTime.FormatTime(posel.RequestedRunUtc)</div> }
                else if (!posel.IsEnabled) { <span class="muted">—</span> }
                else if (posel.NextDueUtc is { } termin)
                {
                  <div>@PimTime.Format(termin)</div>
                  <div class="job-note">@(termin > DateTime.UtcNow ? $"čez {Trajanje(termin - DateTime.UtcNow)}" : $"na vrsti že {Trajanje(DateTime.UtcNow - termin)}")</div>
                  @if (posel.TriggerSource is { } vir) { <div class="job-note">sprožil: @vir</div> }
                }
                else { <span class="muted">ob naslednjem tiku</span> }
              </td>
              <td>
                <div class="table-actions">
                  @if (posel.IsRunning && posel.RunningJobRunId is { } tekoci)
                  {
                    <button type="button" class="small-action warn-action" disabled="@(Busy || posel.CancelRequestedUtc is not null)" @onclick="() => UstaviAsync(posel, tekoci)">Ustavi</button>
                  }
                  else if (Potrjuje == kljuc)
                  {
                    <button type="button" class="small-action danger-action" disabled="@Busy" @onclick="() => PozeniAsync(posel)">Potrdi zagon</button>
                    <button type="button" class="small-action" @onclick="() => Potrjuje = null">Prekliči</button>
                  }
                  else
                  {
                    <button type="button" class="small-action primary-small" disabled="@(Busy || posel.IsRequested)" @onclick="() => PozeniAsync(posel)">Poženi zdaj</button>
                  }
                  <a class="small-action" href="@($"sistem/zagoni?posel={kljuc}")">Zagoni</a>
                </div>
              </td>
            </tr>
          }
        </Rows>
      </PimTable>
    </section>
  }
</PimState>

@code {
  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Sistem", "sistem"), new("Opravila")];
  static readonly IReadOnlyList<PimColumn> Stolpci =
    [new("Posel"), new("Urnik in meja"), new("Zadnji zagon"), new("Naslednjič"), new("Dejanje")];

  IReadOnlyList<JobDefinitionRow>? Posli;
  IReadOnlyList<JobDependencyRow> Odvisnosti = [];
  AutomationHostRow? Gostitelj;
  readonly Dictionary<string, int> UrejeneMinute = [];
  readonly Dictionary<string, string> UrejeneUre = [];
  readonly Dictionary<string, int> UrejeneMeje = [];
  string? Potrjuje;
  bool Loading = true;
  bool Busy;
  string? Message;
  string? Error;
  readonly CancellationTokenSource ustavi = new();

  protected override async Task OnInitializedAsync()
  {
    await NaloziAsync();
    _ = OsvezujAsync(ustavi.Token);
  }

  async Task NaloziAsync()
  {
    Loading = true;
    try
    {
      var (posli, odvisnosti, _) = await Opravila.GetDefinitionsAsync();
      Posli = posli;
      Odvisnosti = odvisnosti;
      Gostitelj = await Opravila.GetHostAsync();
      UrejeneMinute.Clear(); UrejeneUre.Clear(); UrejeneMeje.Clear();
      Error = null;
    }
    catch (Exception exception) { Posli ??= []; Error = "Opravil iz baze ni mogoče prebrati (je migracija 237 uveljavljena?): " + exception.Message; }
    finally { Loading = false; }
  }

  // Posle poganja drug proces; stran se osvežuje sama vsakih 10 s, da se vidi zahteva, ki jo je gostitelj prevzel.
  async Task OsvezujAsync(CancellationToken token)
  {
    using var ura = new PeriodicTimer(TimeSpan.FromSeconds(10));
    try
    {
      while (await ura.WaitForNextTickAsync(token))
      {
        if (Busy || UrejeneMinute.Count > 0 || UrejeneUre.Count > 0 || UrejeneMeje.Count > 0) continue;
        await InvokeAsync(async () => { await NaloziAsync(); StateHasChanged(); });
      }
    }
    catch (OperationCanceledException) { }
    catch (ObjectDisposedException) { }
  }

  async Task PozeniAsync(JobDefinitionRow posel)
  {
    Message = null; Error = null;
    if (posel.Reach != "Internal" && Potrjuje != posel.JobKey) { Potrjuje = posel.JobKey; return; }
    Potrjuje = null;
    Busy = true;
    try
    {
      var akter = await AkterAsync();
      await Opravila.RequestRunAsync(posel.JobKey, akter);
      Message = Gostitelj?.IsAutomationHostLive == true
        ? $"{posel.Label}: zahteva oddana; gostitelj jo prevzame ob naslednjem tiku."
        : $"{posel.Label}: zahteva oddana, a gostitelj avtomatike ne utripa — zagon počaka, dokler se ne zažene.";
      await SledAsync(akter, "JOB_RUN_REQUEST", $"Zahteva za zagon posla {posel.Label}.", posel.JobKey);
      await NaloziAsync();
    }
    catch (Exception exception) { Error = "Zahteve ni bilo mogoče oddati: " + exception.Message; }
    finally { Busy = false; }
  }

  async Task UstaviAsync(JobDefinitionRow posel, long jobRunId)
  {
    Message = null; Error = null;
    Busy = true;
    try
    {
      var akter = await AkterAsync();
      await Opravila.RequestCancelAsync(jobRunId, akter);
      Message = $"{posel.Label}: ustavitev zahtevana; gostitelj jo izvede ob naslednjem utripu (do 30 s).";
      await SledAsync(akter, "JOB_CANCEL_REQUEST", $"Zahteva za ustavitev posla {posel.Label} (zagon #{jobRunId}).", posel.JobKey);
      await NaloziAsync();
    }
    catch (Exception exception) { Error = "Ustavitve ni bilo mogoče zahtevati: " + exception.Message; }
    finally { Busy = false; }
  }

  // ─── Urnik ──────────────────────────────────────────────────────────────
  int Minute(JobDefinitionRow p) => UrejeneMinute.TryGetValue(p.JobKey, out var v) ? v : Math.Max(1, (p.IntervalSeconds ?? 60) / 60);
  string Ura(JobDefinitionRow p) => UrejeneUre.TryGetValue(p.JobKey, out var v) ? v : (p.DailyAtLocal ?? new TimeOnly(2, 30)).ToString("HH:mm");
  int MejaMinute(JobDefinitionRow p) => UrejeneMeje.TryGetValue(p.JobKey, out var v) ? v : Math.Max(1, p.TimeoutSeconds / 60);

  bool Spremenjen(JobDefinitionRow p) =>
    (p.IntervalSeconds is not null && UrejeneMinute.TryGetValue(p.JobKey, out var m) && m != Math.Max(1, p.IntervalSeconds.Value / 60))
    || (p.IntervalSeconds is null && UrejeneUre.TryGetValue(p.JobKey, out var u) && u != (p.DailyAtLocal ?? new TimeOnly(2, 30)).ToString("HH:mm"))
    || (UrejeneMeje.TryGetValue(p.JobKey, out var meja) && meja != Math.Max(1, p.TimeoutSeconds / 60));

  void NastaviMinute(string kljuc, string? vnos) { if (int.TryParse(vnos, out var m) && m is >= 1 and <= 1440) UrejeneMinute[kljuc] = m; }
  void NastaviMejo(string kljuc, string? vnos) { if (int.TryParse(vnos, out var m) && m is >= 1 and <= 1440) UrejeneMeje[kljuc] = m; }
  void NastaviUro(string kljuc, string? vnos)
  {
    if (TimeOnly.TryParse(vnos, System.Globalization.CultureInfo.InvariantCulture, out var ura)) UrejeneUre[kljuc] = ura.ToString("HH:mm");
  }

  Task ShraniAsync(JobDefinitionRow p) => ShraniAsync(p, p.IsEnabled,
    p.IntervalSeconds is not null ? Minute(p) * 60 : null,
    p.IntervalSeconds is null ? TimeOnly.Parse(Ura(p), System.Globalization.CultureInfo.InvariantCulture) : null,
    MejaMinute(p) * 60, "JOB_SCHEDULE",
    $"{JobCatalog.FormatSchedule(p.IntervalSeconds, p.DailyAtLocal)}, meja {Math.Max(1, p.TimeoutSeconds / 60)} min",
    $"{(p.IntervalSeconds is not null ? $"vsakih {Minute(p)} min" : $"vsak dan ob {Ura(p)}")}, meja {MejaMinute(p)} min");

  Task PreklopiAsync(JobDefinitionRow p) => ShraniAsync(p, !p.IsEnabled, p.IntervalSeconds, p.DailyAtLocal, null,
    p.IsEnabled ? "JOB_DISABLE" : "JOB_ENABLE", p.IsEnabled ? "vklopljen" : "izklopljen", p.IsEnabled ? "izklopljen" : "vklopljen");

  async Task ShraniAsync(JobDefinitionRow p, bool vklopljen, int? sekunde, TimeOnly? ura, int? mejaSekunde, string dejanje, string staro, string novo)
  {
    Busy = true; Message = null; Error = null;
    try
    {
      var akter = await AkterAsync();
      await Opravila.SaveScheduleAsync(p.JobKey, vklopljen, sekunde, ura, mejaSekunde, akter);
      Message = $"{p.Label}: {(vklopljen ? "vklopljen" : "izklopljen")}, {JobCatalog.FormatSchedule(sekunde, ura)}. Velja od naslednjega tika gostitelja.";
      await SledAsync(akter, dejanje, $"Posel {p.Label}: {Message}", p.JobKey, staro, novo);
      await NaloziAsync();
    }
    catch (Exception exception) { Error = "Spremembe posla ni bilo mogoče shraniti: " + exception.Message; }
    finally { Busy = false; }
  }

  async Task SledAsync(string akter, string dejanje, string opis, string kljuc, string? staro = null, string? novo = null)
  {
    try { await Nadzor.LogActivityAsync(akter, dejanje, "Opravilo", opis, entityKey: kljuc, oldValue: staro, newValue: novo); }
    catch { Error = "Dejanje je izvedeno, sled v dnevniku sprememb pa ni zapisana."; }
  }

  async Task<string> AkterAsync() => (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";

  // ─── Oznake ─────────────────────────────────────────────────────────────
  static string Doseg(JobDefinitionRow p) => p.Reach switch { "ExternalCall" => "kliče SAOP ali dobavitelja", "SendsEmail" => "pošlje e-pošto", _ => "" };
  static string Trajanje(TimeSpan t) => PimTime.Duration((long)Math.Max(0, t.TotalMilliseconds));
  static string Skrajsaj(string b) => b.Length <= 160 ? b : b[..157] + "…";

  public static string StatusOznaka(string? status) => status switch
  {
    "Running" => "Teče", "Succeeded" => "Uspešno", "Warning" => "Z opozorilom", "Failed" => "Napaka", "TimedOut" => "Presežena meja",
    "Cancelled" => "Ustavljeno", "Abandoned" => "Zapuščeno", "Blocked" => "Blokirano", null or "" => "—", _ => status,
  };

  public static string? StatusTon(string? status) => status switch
  {
    "Succeeded" => "good", "Running" or "Warning" or "Blocked" => "warn", "Failed" or "TimedOut" or "Abandoned" => "bad", _ => null,
  };

  public static string Sprozilec(string? v) => v switch { "Scheduler" => "urnik", "Human" => "ročno", "Dependency" => "predhodnik", null or "" => "—", _ => v };

  public void Dispose() { ustavi.Cancel(); ustavi.Dispose(); }
}
