@page "/saop/odkloni"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@inject IntranetDataService Data
@inject AuthenticationStateProvider Authentication

<PageTitle>Odkloni SAOP</PageTitle>
<PimPage OrganizationScope="true" Title="Odkloni SAOP" Subtitle="Primerjava dejansko poslane vrednosti z vrednostjo, ki jo je vrnila naslednja sinhronizacija ERP." Crumbs="Crumbs" />

<PimMissing Object="intranet.GetOutboundMessages" What="strukturiran posnetek poslanih vrednosti in strukturiran echo iz SAOP; trenutni DriftDetail je le povzetek" Needs="out.OutboxMessage, posnetek polj ob pošiljanju in povratni SAOP zajem" />

<section class="ui-card data-card section-gap" aria-label="Odkloni SAOP">
  <PimState Loading="Loading" Error="@Error" Empty="@(!Loading && Rows.Count == 0)" EmptyText="Zaznanih odklonov ni." LoadingText="Nalaganje odklonov …">
    <PimTable Caption="Zaznani odkloni po odhodnih operacijah" Columns="Columns">
      <Rows>
        @foreach (var row in Rows)
        {
          <tr>
            <td>@row.CreatedUtc.ToPimLocal().ToString("g")</td><td>@row.EntityType<div class="tree-path">@row.EntityKey</div></td>
            <td>@row.FieldSummary</td><td>—</td><td>@row.DriftDetail</td><td>@row.DriftDetail</td>
            <td><button type="button" class="small-action warn-action" disabled="@Busy" @onclick="() => RetryAsync(row.OutboxMessageId)">Pošlji znova</button></td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
  @if (Message is not null) { <p class="message-state success-message" role="status">@Message</p> }
</section>

@code {
  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("SAOP", "saop"), new("Odkloni")];
  static readonly IReadOnlyList<PimColumn> Columns = [new("Zaznano"), new("Entiteta / ključ"), new("Kaj smo poslali"), new("Kaj je ERP vrnil"), new("Razlika"), new("Povzetek"), new("Dejanje")];
  IReadOnlyList<OutboundRow> Rows = [];
  bool Loading = true, Busy;
  string? Error, Message;

  protected override async Task OnInitializedAsync()
  {
    try { var org = await Data.GetCurrentOrganizationAsync(); if (org is null) { Error = "Aktivna organizacija ni na voljo."; return; } Rows = (await Data.GetOutboundAsync(org.OrganizationId)).Where(row => row.DriftDetail is not null).OrderByDescending(row => row.CreatedUtc).ToArray(); }
    catch { Error = "Odklonov trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  async Task RetryAsync(long id)
  {
    Busy = true; Error = null;
    try { var state = await Authentication.GetAuthenticationStateAsync(); await Data.RetryOutboundAsync(id, state.User.Identity?.Name ?? "neznan"); Message = "Operacija je pripravljena za ponovni poskus."; }
    catch { Error = "Ponovnega poskusa ni bilo mogoče pripraviti."; }
    finally { Busy = false; }
  }
}
