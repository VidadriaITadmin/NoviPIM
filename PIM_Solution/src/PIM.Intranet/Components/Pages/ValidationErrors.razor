@page "/napake-validacije"
@page "/kakovost/napake"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntranetDataService Data
@inject QualityReadService Quality
@inject GovernanceReadService Governance
@inject CatalogReadService Catalog
@inject NavigationManager Navigation
@inject CategoryTreeService Tree

<PageTitle>Napake validacije</PageTitle>

<PimPage Title="Napake validacije" Subtitle="Kaj izdelku manjka, kateri profil to zahteva in kaj se zaradi tega ustavi. Napake ni mogoče označiti za rešeno — izgine sama, ko je izdelek popravljen in znova validiran." Crumbs="Crumbs" />

<section class="kpi-grid" aria-labelledby="quality-kpi-title">
  <h2 id="quality-kpi-title" class="visually-hidden">Povzetek odprtih napak</h2>
  <PimStat Label="Odprte težave" Value="@Number(Overview?.Totals.OpenIssueCount)" Note="@($"{Number(Overview?.Totals.ErrorCount)} napak · {Number(Overview?.Totals.WarningCount)} opozoril")" />
  <PimStat Label="Prizadeti izdelki" Value="@Number(Overview?.Totals.AffectedProductCount)" Note="izdelkov z vsaj eno odprto težavo" />
  <PimStat Label="Blokira ERP" Value="@Number(Overview?.Totals.BlockingErpCount)" Note="težav v profilih, ki ustavijo zapis v SAOP" Href="kakovost/napake?blokira=ERP" />
  <PimStat Label="Blokira splet" Value="@Number(Overview?.Totals.BlockingWebCount)" Note="težav v profilih, ki ustavijo objavo" Href="kakovost/napake?blokira=WEB" />
  <PimStat Label="Samo opozorilo" Value="@Number(Overview?.Totals.AdvisoryCount)" Note="vidno, a ne ustavi ničesar" Href="kakovost/napake?blokira=NONE" />
</section>

<section class="ui-card toolbar" role="search" aria-labelledby="issues-filter-title">
  <h2 id="issues-filter-title" class="visually-hidden">Iskanje odprtih težav</h2>

  <label class="visually-hidden" for="issue-layer">Nivo</label>
  <select id="issue-layer" class="filter-select" @bind="LayerDraft">
    <option value="">Vsi nivoji</option>
    @foreach (var layer in Layers)
    {
      <option value="@ValidationLayer.Code(layer)">@ValidationLayer.Label(layer)</option>
    }
  </select>

  <label class="visually-hidden" for="issue-search">Poišči po šifri ali EAN</label>
  <input id="issue-search" type="search" class="search-input" placeholder="Poišči po šifri ali EAN …" @bind="SearchDraft" @bind:event="oninput" @onkeydown="SearchKeyAsync" />

  <label class="visually-hidden" for="issue-profile">Profil</label>
  <select id="issue-profile" class="filter-select" @bind="ProfileDraft">
    <option value="">Vsi profili</option>
    @foreach (var profile in ProfileCodes)
    {
      <option value="@profile">@profile</option>
    }
  </select>

  @if (LayerDraft == "SPLET")
  {
    <label class="visually-hidden" for="issue-site">Spletno mesto</label>
    <select id="issue-site" class="filter-select" @bind="WebSiteDraft">
      <option value="">Vsa spletna mesta</option>
      @foreach (var site in WebSites)
      {
        <option value="@site.WebSiteCode">@site.WebSiteName</option>
      }
    </select>
  }

  <label class="visually-hidden" for="issue-severity">Resnost</label>
  <select id="issue-severity" class="filter-select" @bind="SeverityDraft">
    <option value="">Vse resnosti</option>
    <option value="ERROR">Samo napake</option>
    <option value="WARNING">Samo opozorila</option>
  </select>

  <label class="visually-hidden" for="issue-blocks">Kaj blokira</label>
  <select id="issue-blocks" class="filter-select" @bind="BlocksDraft">
    <option value="">Blokira: vseeno</option>
    <option value="ERP">Blokira ERP</option>
    <option value="WEB">Blokira splet</option>
    <option value="NONE">Ne blokira</option>
  </select>

  @* 177: vecnivojski obseg — izbrana kategorija zajame tudi vse podkategorije. *@
  <label class="visually-hidden" for="issue-tree">Drevo kategorij</label>
  <select id="issue-tree" class="filter-select" @bind="TreeDraft" @bind:after="LoadCategoryOptionsAsync">
    <option value="">Vse kategorije</option>
    @foreach (var tree in Trees) { <option value="@tree">@TreeLabel(tree)</option> }
  </select>
  @if (!string.IsNullOrWhiteSpace(TreeDraft))
  {
    <label class="visually-hidden" for="issue-category">Kategorija (s podkategorijami)</label>
    <div class="category-select">
      <PimPicker Id="issue-category" Options="CategoryPickerOptions" @bind-Value="CategoryDraftOrNull"
                 Placeholder="Kategorija (celo drevo) — vpiši ime ali pot …" />
    </div>
  }

  <label class="visually-hidden" for="issue-field">Polje</label>
  <select id="issue-field" class="filter-select" @bind="FieldDraft">
    <option value="">Vsa polja</option>
    @foreach (var field in FieldCodes)
    {
      <option value="@field">@field</option>
    }
  </select>

  <button type="button" class="filter-button" @onclick="ApplyFiltersAsync">Uporabi filtre</button>
  <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>
</section>

@if (ActiveChips.Count > 0)
{
  <section class="ui-card active-filters" aria-label="Aktivni filtri">
    @foreach (var chip in ActiveChips)
    {
      <a class="filter-chip" href="@chip.RemoveHref" aria-label="Odstrani filter @chip.Label">@chip.Label<span class="chip-remove" aria-hidden="true"></span></a>
    }
    <a class="filter-chip clear-all" href="kakovost/napake">Počisti vse</a>
  </section>
}

<section class="ui-card data-card" aria-label="Izdelki z odprtimi težavami">
  <PimState Loading="Loading" Error="@Error" Empty="@(PageData is not null && PageData.Products.Count == 0)"
            EmptyText="Za izbrane filtre ni odprtih težav." LoadingText="Nalaganje odprtih težav …">
    @if (PageData is not null)
    {
      <PimTable Caption="Izdelki z odprtimi validacijskimi težavami" AriaLabel="Tabela izdelkov z odprtimi težavami" Columns="Columns">
        <Rows>
          @foreach (var product in PageData.Products)
          {
            <tr>
              <td>
                @foreach (var layer in LayersOf(product.ProductId))
                {
                  <PimChip Text="@ValidationLayer.Code(layer)" Tone="@LayerTone(layer)" />
                }
              </td>
              <td>
                <a class="product-name" href="@ProductHref(product.ProductId)">@product.Name</a>
                <span class="product-meta"><span class="code-value">@product.ItemId</span>@if (product.Ean is not null) { <span>· EAN @product.Ean</span> }</span>
              </td>
              <td class="numeric">@product.ErrorCount.ToString("N0")</td>
              <td class="numeric">@product.WarningCount.ToString("N0")</td>
              <td>
                @if (product.BlockingErpCount > 0) { <PimChip Text="ERP" Tone="bad" Prefix="Blokira: " /> }
                @if (product.BlockingWebCount > 0) { <PimChip Text="Splet" Tone="warn" Prefix="Blokira: " /> }
                @if (product.BlockingErpCount == 0 && product.BlockingWebCount == 0) { <span class="muted">ne blokira</span> }
              </td>
              <td><PimBar Percent="product.Completeness" Label="@($"Popolnost izdelka {product.ItemId}")" /></td>
              <td class="issue-cell">
                <ul class="issue-list">
                  @foreach (var issue in IssuesOf(product.ProductId))
                  {
                    <li>
                      <span class="issue-field">@(issue.FieldCode ?? issue.IssueCode)</span>
                      <span class="issue-profile">@issue.ProfileCode</span>
                      @if (IsShared(issue)) { <PimChip Text="Skupno" Tone="info" /> }
                      <span class="issue-severity @(issue.Severity == "WARNING" ? "warn" : "bad")">@SeverityLabel(issue.Severity)</span>
                      <span class="issue-message">@issue.Message</span>
                    </li>
                  }
                </ul>
                @if (HiddenIssueCount(product) > 0)
                {
                  <a class="issue-more" href="@ProductHref(product.ProductId)">… še @HiddenIssueCount(product) na kartici izdelka</a>
                }
              </td>
              <td>@(product.LastDetectedUtc?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
            </tr>
          }
        </Rows>
      </PimTable>
      <PimPager Skip="Skip" Take="Take" Total="PageData.TotalCount" Label="Strani izdelkov z napakami" SkipChanged="GoToSkipAsync" />
    }
  </PimState>
</section>

<h2 class="section-title">Katera zahteva ustavi največ izdelkov</h2>
<section class="ui-card data-card" aria-label="Pravila z največjim vplivom">
  <PimState Loading="Loading" Error="@Error" Empty="@(Overview is not null && Overview.Rules.Count == 0)"
            EmptyText="Odprtih zahtev ni." LoadingText="Nalaganje pravil …">
    @if (Overview is not null)
    {
      <PimTable Caption="Zahteve, razvrščene po številu prizadetih izdelkov" AriaLabel="Tabela pravil z največjim vplivom" Columns="RuleColumns">
        <Rows>
          @foreach (var rule in Overview.Rules)
          {
            <tr>
              <td><a href="@RuleHref(rule)"><span class="code-value">@rule.FieldCode</span></a></td>
              <td>@rule.ProfileCode</td>
              <td><span class="issue-severity @(rule.Severity == "WARNING" ? "warn" : "bad")">@SeverityLabel(rule.Severity)</span></td>
              <td>
                @if (rule.BlocksErp) { <PimChip Text="ERP" Tone="bad" Prefix="Blokira: " /> }
                @if (rule.BlocksWeb) { <PimChip Text="Splet" Tone="warn" Prefix="Blokira: " /> }
                @if (!rule.BlocksErp && !rule.BlocksWeb) { <span class="muted">ne blokira</span> }
              </td>
              <td class="numeric">@rule.ProductCount.ToString("N0")</td>
              <td class="numeric">@rule.IssueCount.ToString("N0")</td>
            </tr>
          }
        </Rows>
      </PimTable>
    }
  </PimState>
</section>

<h2 class="section-title">Pri katerem dobavitelju se napake kopičijo</h2>
<section class="ui-card data-card" aria-label="Vpliv po dobavitelju">
  <PimState Loading="Loading" Error="@Error" Empty="@(Overview is not null && Overview.Suppliers.Count == 0)"
            EmptyText="Razčlenitve po dobavitelju ni." LoadingText="Nalaganje razčlenitve …">
    @if (Overview is not null)
    {
      <PimTable Caption="Dobavitelji, razvrščeni po številu prizadetih izdelkov" AriaLabel="Tabela vpliva po dobavitelju" Columns="SupplierColumns">
        <Rows>
          @foreach (var supplier in Overview.Suppliers)
          {
            <tr>
              <td>@supplier.Supplier</td>
              <td class="numeric">@supplier.ProductCount.ToString("N0")</td>
              <td class="numeric">@supplier.WithIssuesCount.ToString("N0")</td>
              <td class="numeric">@supplier.IssueCount.ToString("N0")</td>
              <td><PimBar Percent="@Share(supplier)" Label="@($"Delež izdelkov z napako pri {supplier.Supplier}")" Threshold="101" /></td>
            </tr>
          }
        </Rows>
      </PimTable>
    }
  </PimState>
</section>

<p class="muted source-note">
  Vir: <span class="code-value">intranet.GetQualityIssues</span> in <span class="code-value">intranet.GetQualityOverview</span>
  (migracija 102). Stran je bralna: napake ni mogoče zapreti ročno, ker status izhaja iz podatka, ne iz oznake.
</p>

@code {
  [SupplyParameterFromQuery(Name = "isci")] public string? QuerySearch { get; set; }
  [SupplyParameterFromQuery(Name = "nivo")] public string? QueryLayer { get; set; }
  [SupplyParameterFromQuery(Name = "spletisce")] public string? QueryWebSite { get; set; }
  [SupplyParameterFromQuery(Name = "profil")] public string? QueryProfile { get; set; }
  [SupplyParameterFromQuery(Name = "resnost")] public string? QuerySeverity { get; set; }
  [SupplyParameterFromQuery(Name = "blokira")] public string? QueryBlocks { get; set; }
  [SupplyParameterFromQuery(Name = "polje")] public string? QueryField { get; set; }
  [SupplyParameterFromQuery(Name = "drevo")] public string? QueryTree { get; set; }
  [SupplyParameterFromQuery(Name = "kategorija")] public string? QueryCategory { get; set; }
  [SupplyParameterFromQuery(Name = "stran")] public int? QueryPage { get; set; }

  QualityIssuePage? PageData;
  QualityOverview? Overview;
  bool Loading = true;
  string? Error;
  int? OrganizationId;
  string SearchDraft = "";
  string LayerDraft = "";
  string WebSiteDraft = "";
  string ProfileDraft = "";
  string SeverityDraft = "";
  string BlocksDraft = "";
  string FieldDraft = "";
  string TreeDraft = "";
  string CategoryDraft = "";
  IReadOnlyList<string> Trees = [];
  IReadOnlyList<CategoryTreeService.CategoryOptionRow> CategoryOptions = [];
  string? LoadedOptionsTree;
  string? CategoryDraftOrNull { get => string.IsNullOrWhiteSpace(CategoryDraft) ? null : CategoryDraft; set => CategoryDraft = value ?? ""; }
  IReadOnlyList<PimPickerOption> CategoryPickerOptions = [];

  const int Take = 25;
  const int VisibleIssuesPerProduct = 4;
  static readonly PimValidationLayer[] Layers = Enum.GetValues<PimValidationLayer>();
  IReadOnlyList<ValidationProfileRow> Profiles = [];
  IReadOnlyList<WebSiteRow> Sites = [];

  int Skip => Math.Max(0, ((QueryPage ?? 1) - 1) * Take);

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Kakovost", "kakovost"), new("Napake validacije")];

  static readonly IReadOnlyList<PimColumn> Columns =
  [
    new("Nivo"), new("Izdelek"), new("Napak", Numeric: true), new("Opozoril", Numeric: true),
    new("Blokira"), new("Popolnost"), new("Kaj manjka"), new("Zadnji pojav"),
  ];

  static readonly IReadOnlyList<PimColumn> RuleColumns =
  [
    new("Polje"), new("Profil"), new("Resnost"), new("Blokira"),
    new("Izdelkov", Numeric: true), new("Težav", Numeric: true),
  ];

  static readonly IReadOnlyList<PimColumn> SupplierColumns =
  [
    new("Dobavitelj"), new("Izdelkov", Numeric: true), new("Z napako", Numeric: true),
    new("Težav", Numeric: true), new("Delež z napako"),
  ];

  sealed record FilterChip(string Label, string RemoveHref);

  IReadOnlyList<string> ProfileCodes => ProfilesForLayer(LayerDraft, WebSiteDraft)
    .Select(profile => profile.ProfileCode).Distinct().OrderBy(code => code).ToList();

  IReadOnlyList<WebSiteRow> WebSites => Sites;

  IReadOnlyList<string> FieldCodes => Overview is null ? []
    : Overview.Rules.Select(rule => rule.FieldCode).Distinct().OrderBy(code => code).ToList();

  protected override async Task OnParametersSetAsync()
  {
    SearchDraft = QuerySearch ?? "";
    LayerDraft = QueryLayer ?? "";
    WebSiteDraft = QueryWebSite ?? "";
    ProfileDraft = QueryProfile ?? "";
    SeverityDraft = QuerySeverity ?? "";
    BlocksDraft = QueryBlocks ?? "";
    FieldDraft = QueryField ?? "";
    TreeDraft = QueryTree ?? "";
    CategoryDraft = QueryCategory ?? "";

    Loading = true;
    Error = null;
    try
    {
      var organization = await Data.GetCurrentOrganizationAsync();
      if (organization is null) { Error = "Aktivna organizacija ni na voljo."; return; }

      if (OrganizationId != organization.OrganizationId)
      {
        OrganizationId = organization.OrganizationId;
        Overview = await Quality.GetOverviewAsync(organization.OrganizationId);
        Profiles = await Governance.GetValidationProfilesAsync(organization.OrganizationId);
        Sites = await Catalog.GetWebSitesAsync();
        Trees = await Tree.GetTreeCodesAsync();
      }
      await LoadCategoryOptionsAsync();

      var filter = new QualityIssueFilter(
        organization.OrganizationId, Skip, Take, QuerySearch, QueryProfile,
        QuerySeverity, QueryBlocks, QueryField,
        CategoryTreeCode: QueryTree, CategoryCode: QueryCategory);
      var layerProfiles = ProfilesForLayer(QueryLayer, QueryWebSite).Select(profile => profile.ProfileCode).ToArray();
      PageData = string.IsNullOrWhiteSpace(QueryLayer)
        ? await Quality.GetIssuesAsync(filter)
        : await Quality.GetIssuesForProfilesAsync(filter, layerProfiles);
    }
    catch
    {
      Error = "Odprtih težav trenutno ni mogoče naložiti.";
    }
    finally
    {
      Loading = false;
    }
  }

  string ResultSummary => Loading ? "Nalaganje …"
    : Error is not null ? "Rezultati niso na voljo"
    : $"{PageData?.TotalCount ?? 0:N0} izdelkov z odprto težavo";

  IEnumerable<QualityIssueRow> IssuesOf(long productId) => PageData is null ? []
    : PageData.Issues.Where(issue => issue.ProductId == productId).Take(VisibleIssuesPerProduct);

  long HiddenIssueCount(QualityProductRow product)
  {
    if (PageData is null) return 0;
    var shown = PageData.Issues.Count(issue => issue.ProductId == product.ProductId);
    return Math.Max(0, shown - VisibleIssuesPerProduct);
  }

  static decimal Share(QualitySupplierImpact supplier) =>
    supplier.ProductCount == 0 ? 0 : Math.Round(supplier.WithIssuesCount * 100m / supplier.ProductCount, 1);

  List<FilterChip> ActiveChips
  {
    get
    {
      var chips = new List<FilterChip>();
      if (!string.IsNullOrWhiteSpace(QueryLayer)) chips.Add(new($"Nivo: {LayerLabel(QueryLayer)}", Href(layer: "", webSite: "")));
      if (!string.IsNullOrWhiteSpace(QueryWebSite)) chips.Add(new($"Spletno mesto: {QueryWebSite}", Href(webSite: "")));
      if (!string.IsNullOrWhiteSpace(QuerySearch)) chips.Add(new($"Iskanje: {QuerySearch}", Href(search: "")));
      if (!string.IsNullOrWhiteSpace(QueryProfile)) chips.Add(new($"Profil: {QueryProfile}", Href(profile: "")));
      if (!string.IsNullOrWhiteSpace(QuerySeverity)) chips.Add(new($"Resnost: {SeverityLabel(QuerySeverity)}", Href(severity: "")));
      if (!string.IsNullOrWhiteSpace(QueryBlocks)) chips.Add(new($"Blokira: {BlocksLabel(QueryBlocks)}", Href(blocks: "")));
      if (!string.IsNullOrWhiteSpace(QueryField)) chips.Add(new($"Polje: {QueryField}", Href(field: "")));
      if (!string.IsNullOrWhiteSpace(QueryTree)) chips.Add(new($"Kategorija: {CategoryLabel()}", Href(tree: "", category: "")));
      return chips;
    }
  }

  // Filtri in stran zivijo v naslovu: povezavo je mogoce deliti, gumb Nazaj dela, KPI kartica
  // pa lahko pelje naravnost na svoj filtriran seznam. "" pomeni odstrani, null ohrani.
  string Href(string? search = null, string? profile = null, string? severity = null,
    string? blocks = null, string? field = null, string? layer = null, string? webSite = null, int? page = null,
    string? tree = null, string? category = null)
  {
    var parameters = new List<string>();
    Add("nivo", Resolve(layer, QueryLayer));
    Add("drevo", Resolve(tree, QueryTree));
    Add("kategorija", string.IsNullOrWhiteSpace(Resolve(tree, QueryTree)) ? null : Resolve(category, QueryCategory));
    Add("spletisce", Resolve(webSite, QueryWebSite));
    Add("isci", Resolve(search, QuerySearch));
    Add("profil", Resolve(profile, QueryProfile));
    Add("resnost", Resolve(severity, QuerySeverity));
    Add("blokira", Resolve(blocks, QueryBlocks));
    Add("polje", Resolve(field, QueryField));
    var resolvedPage = page ?? (search is null && profile is null && severity is null
      && blocks is null && field is null && layer is null && webSite is null && tree is null && category is null ? QueryPage : null);
    if (resolvedPage is > 1) parameters.Add("stran=" + resolvedPage);

    return parameters.Count == 0 ? "kakovost/napake" : "kakovost/napake?" + string.Join('&', parameters);

    void Add(string name, string? value)
    {
      if (!string.IsNullOrWhiteSpace(value)) parameters.Add(name + "=" + Uri.EscapeDataString(value));
    }

    static string? Resolve(string? requested, string? current) => requested is null ? current : requested;
  }

  string RuleHref(QualityRuleImpact rule) =>
    $"kakovost/napake?profil={Uri.EscapeDataString(rule.ProfileCode)}&polje={Uri.EscapeDataString(rule.FieldCode)}";

  Task ApplyFiltersAsync()
  {
    Navigation.NavigateTo(Href(
      search: SearchDraft.Trim(), profile: ProfileDraft, severity: SeverityDraft,
      blocks: BlocksDraft, field: FieldDraft, layer: LayerDraft, webSite: WebSiteDraft, page: 1,
      tree: TreeDraft, category: CategoryDraft));
    return Task.CompletedTask;
  }

  Task SearchKeyAsync(KeyboardEventArgs args) =>
    args.Key == "Enter" ? ApplyFiltersAsync() : Task.CompletedTask;

  Task GoToSkipAsync(int skip)
  {
    Navigation.NavigateTo(Href(page: skip / Take + 1));
    return Task.CompletedTask;
  }

  static string Number(long? value) => value is null ? "—" : value.Value.ToString("N0");

  static string TreeLabel(string treeCode) => treeCode switch { "svetila_si" => "Svetila", "videlektro" => "Videlektro", _ => treeCode };

  /// <summary>Seznam kategorij se prebere za izbrano drevo; sprememba drevesa pobrise izbiro kategorije.</summary>
  async Task LoadCategoryOptionsAsync()
  {
    if (string.IsNullOrWhiteSpace(TreeDraft)) { CategoryOptions = []; CategoryDraft = ""; LoadedOptionsTree = null; return; }
    if (LoadedOptionsTree == TreeDraft) return;
    try { CategoryOptions = await Tree.GetCategoryOptionsAsync(TreeDraft); LoadedOptionsTree = TreeDraft; }
    catch { CategoryOptions = []; }
    // Vecnivojskost je vidna kot zamik in celotna pot v izbirniku s tipkanjem (LevelNo - 1) * 3 ni vec potrebno racunati v <option>.
    CategoryPickerOptions = CategoryOptions
      .Select(option => new PimPickerOption(option.CategoryCode, option.CategoryName, option.CategoryPath, option.LevelNo - 1))
      .ToList();
    if (CategoryOptions.All(option => option.CategoryCode != CategoryDraft)) CategoryDraft = "";
  }

  string CategoryLabel()
  {
    if (string.IsNullOrWhiteSpace(QueryCategory)) return TreeLabel(QueryTree ?? "") + " (celo drevo)";
    var option = CategoryOptions.FirstOrDefault(candidate => candidate.CategoryCode == QueryCategory);
    return option is null ? QueryCategory : option.CategoryPath + " (s podkategorijami)";
  }

  static string SeverityLabel(string? severity) => severity switch
  {
    "ERROR" => "Napaka",
    "WARNING" => "Opozorilo",
    _ => severity ?? "—",
  };

  static string BlocksLabel(string? blocks) => blocks switch
  {
    "ERP" => "ERP",
    "WEB" => "splet",
    "NONE" => "ne blokira",
    _ => blocks ?? "—",
  };

  IReadOnlyList<ValidationProfileRow> ProfilesForLayer(string? layerValue = null, string? webSiteValue = null)
  {
    layerValue ??= QueryLayer;
    webSiteValue ??= QueryWebSite;
    if (!Enum.TryParse<PimValidationLayer>(NormalizeLayer(layerValue), true, out var layer)) return Profiles;
    return Profiles.Where(profile => ValidationLayer.Resolve(profile.ProfileCode, profile.Scope, profile.BlocksErp, profile.BlocksWeb).Contains(layer))
      .Where(profile => layer != PimValidationLayer.Splet || string.IsNullOrWhiteSpace(webSiteValue)
        || ValidationLayer.IsShared(profile.Scope) || SiteMatches(profile.ProfileCode, webSiteValue))
      .ToArray();
  }

  IEnumerable<PimValidationLayer> LayersOf(long productId) => PageData is null ? [] : PageData.Issues
    .Where(issue => issue.ProductId == productId)
    .SelectMany(issue => ValidationLayer.Resolve(issue.ProfileCode, Profile(issue.ProfileCode)?.Scope, issue.BlocksErp, issue.BlocksWeb))
    .Distinct();

  bool IsShared(QualityIssueRow issue) => ValidationLayer.IsShared(Profile(issue.ProfileCode)?.Scope);
  ValidationProfileRow? Profile(string code) => Profiles.FirstOrDefault(profile => profile.ProfileCode.Equals(code, StringComparison.OrdinalIgnoreCase));

  string ProductHref(long productId)
  {
    var fragment = NormalizeLayer(QueryLayer) switch
    {
      "KOMERCIALA" => "komerciala",
      "SPLET" => "splet",
      _ => "erp",
    };
    return $"izdelki/{productId}#{fragment}";
  }

  static string NormalizeLayer(string? value) => value?.Replace("/", "", StringComparison.Ordinal).Replace("_", "", StringComparison.Ordinal) switch
  {
    "ERPSLO" => nameof(PimValidationLayer.ErpSlo),
    "ERPEUTHIRD" => nameof(PimValidationLayer.ErpEuThird),
    "KOMERCIALA" => nameof(PimValidationLayer.Komerciala),
    "SPLET" => nameof(PimValidationLayer.Splet),
    _ => value ?? "",
  };

  static bool SiteMatches(string profileCode, string site)
  {
    static string Normalize(string value) => new(value.Where(char.IsLetterOrDigit).ToArray());
    return Normalize(profileCode).Contains(Normalize(site), StringComparison.OrdinalIgnoreCase);
  }

  static string LayerLabel(string value) => Enum.TryParse<PimValidationLayer>(NormalizeLayer(value), true, out var layer)
    ? ValidationLayer.Label(layer) : value;

  static string? LayerTone(PimValidationLayer layer) => layer switch
  {
    PimValidationLayer.Komerciala => "info",
    PimValidationLayer.Splet => "warn",
    _ => "bad",
  };
}
