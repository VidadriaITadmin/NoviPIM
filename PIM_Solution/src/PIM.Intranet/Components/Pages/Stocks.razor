@page "/zaloge"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntranetDataService Data
@inject StockReadService Stock
@inject NavigationManager Navigation

<PageTitle>Zaloga</PageTitle>

<PimPage Title="Zaloga" Subtitle="Kaj je na zalogi, kdaj je bil posnetek narejen in katera pozicija nima svojega artikla. Zaloga je samo za branje — PIM je nikoli ne piše nazaj v ERP." />


<section class="ui-card toolbar" role="search" aria-labelledby="stocks-filter-title">
  <h2 id="stocks-filter-title" class="visually-hidden">Filtriranje zaloge</h2>
  <label class="visually-hidden" for="stock-search">Poišči po artiklu ali EAN</label>
  <input id="stock-search" type="search" class="search-input" placeholder="Poišči po artiklu ali EAN …" @bind="SearchDraft" @bind:event="oninput" @onkeydown="SearchKeyAsync" />

  @* Uporabnik 2026-08-31: »zakaj zalogo prikazuje samo dobavitelja in SAOP DEMO, dej da bo se
     ostale zaloge prikazovalo od SAOP (IQ, VID, Ediito)«. Privzeto so zato vsa podjetja;
     SAOP zaloga obstaja pri vseh stirih. *@
  <label class="visually-hidden" for="stock-organization">Podjetje</label>
  <select id="stock-organization" class="filter-select" @bind="OrganizationDraft">
    <option value="">Vsa podjetja</option>
    @foreach (var organization in Organizations) { <option value="@organization.OrganizationId">@organization.Name</option> }
  </select>

  <label class="visually-hidden" for="stock-source">Vir</label>
  <select id="stock-source" class="filter-select" @bind="SourceDraft">
    <option value="">Vsi viri</option>
    @foreach (var source in SourceCodes)
    {
      <option value="@source">@source</option>
    }
  </select>

  @* Uporabnik 2026-08-28: filtra »vsa razpoložljivost« in »ujemanje« sta odpadla — na obe
     vprašanji odgovarjajo že kartice povzetka nad tabelo, ki so klikljive. Namesto njiju je
     prišla vrsta vira: SAOP zaloga je bila v seznamu, a je ni bilo mogoče ločiti od
     dobaviteljeve. Vrsta vira ne sešteva: če je isti artikel na zalogi pri SAOP in pri
     dobavitelju hkrati, sta v tabeli dve ločeni vrstici, ne ena s seštevkom — »vsi viri
     zaloge« je zato unija vrstic, ne seštevek količin. *@
  <label class="visually-hidden" for="stock-kind">Vrsta vira</label>
  <select id="stock-kind" class="filter-select" @bind="KindDraft"
    title="Prikaže vsak vir kot svojo vrstico. Če je artikel na zalogi pri SAOP in pri dobavitelju hkrati, se količini ne seštevata.">
    <option value="">Vsi viri zaloge (ločeno po viru)</option>
    <option value="ERP">ERP (SAOP)</option>
    <option value="DOBAVITELJ">Dobaviteljeva zaloga</option>
  </select>

  @* Uporabnik 2026-09-03: manjkal je filter »ima zalogo ali ne«. Uporablja isti @Availability,
     ki ga intranet.GetStockPositions ze pozna (migracija 134) — samo dvoje smiselnih vrednosti
     za to stran, INCOMING ostane brez kontrole na UI. *@
  <label class="visually-hidden" for="stock-instock">Ima zalogo</label>
  <select id="stock-instock" class="filter-select" @bind="InStockDraft">
    <option value="">Zaloga: vseeno</option>
    <option value="IN_STOCK">Na zalogi</option>
    <option value="OUT_OF_STOCK">Brez zaloge</option>
  </select>

  <label class="visually-hidden" for="stock-age">Svežina posnetka</label>
  <select id="stock-age" class="filter-select" @bind="AgeDraft">
    <option value="">Svežina: vseeno</option>
    <option value="24">Posnetek do 24 ur</option>
    <option value="72">Posnetek do 3 dni</option>
    <option value="168">Posnetek do 7 dni</option>
  </select>

  <button type="button" class="filter-button" @onclick="ApplyFiltersAsync">Uporabi filtre</button>
  <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>
</section>

@* Izvoz zaloge z izbiro vira (migracija 150, razsirjena v 151). Uporabnik 2026-09-03: »bi bilo
   vbolje da filtre nastaviš in potem predlogo prenesš ne pa da imaš filtre in nato lahko kar
   vse preneseš« — trije loceni gumbi (ERP/DOBAVITELJ/VSE) in Obseg izvoza sta odpadla, ker so
   prenos vodili mimo filtrov nad tabelo. En gumb zdaj prenese natanko to, kar je filtrirano
   zgoraj: podjetje, vir, vrsta vira, ima zalogo, svezina in iskanje. *@
<section class="ui-card toolbar stock-export section-gap" aria-label="Prenos zaloge v CSV">
  <span class="toolbar-label">Prenesi zalogo (CSV):</span>
  @if (string.IsNullOrWhiteSpace(OrganizationDraft))
  {
    <span class="muted">najprej izberi podjetje zgoraj</span>
  }
  else
  {
    <a class="filter-button" href="@StockExportHref" target="_blank">Prenesi zalogo po zgornjih filtrih</a>
    <span class="muted">@ExportFilterSummary</span>
  }
</section>

@* Vrstica oblačkov z aktivnimi filtri je odpadla: uporabnik jih je 2026-08-28 označil za
   moteče. Kaj je nastavljeno, se vidi v samih kontrolah nad tabelo, poleg njih pa stoji
   »Počisti«, ki je edino dejanje, ki ga je vrstica oblačkov res ponujala. *@
<section class="ui-card data-card" aria-label="Zalogovne pozicije">
  <PimState Loading="Loading" Error="@Error" Empty="@(PageData is not null && PageData.Rows.Count == 0)"
            EmptyText="Za izbrane filtre ni zalogovnih pozicij." LoadingText="Nalaganje zaloge …">
    @if (PageData is not null)
    {
      <PimTable Caption="Zaloge in dobavljivost v aktivni organizaciji" AriaLabel="Tabela zalogovnih pozicij" Columns="Columns">
        <Rows>
          @foreach (var row in PageData.Rows)
          {
            <tr>
              <td>
                @if (row.MatchedProductId is { } productId)
                {
                  <a class="product-name" href="izdelki/@productId">@(row.ProductName ?? row.ProductItemId ?? row.NormalizedItemId ?? "—")</a>
                }
                else
                {
                  <span class="product-name">@(row.NormalizedItemId ?? row.Ean ?? "—")</span>
                }
                <span class="product-meta">
                  @if (row.NormalizedItemId is not null) { <span class="code-value">@row.NormalizedItemId</span> }
                  @if (row.Ean is not null) { <span>· EAN @row.Ean</span> }
                  @if (row.MatchedProductId is null) { <span class="gap-flag">brez artikla</span> }
                </span>
              </td>
              <td class="numeric">@row.Quantity.ToString("N2")</td>
              <td class="numeric">
                @* Registrirani pogled SAOP (145): razpolozljiva kolicina = trenutna minus rezervirano.
                   Vira brez teh kolicin (GetStocks, dobavitelji) pokazeta pomisljaj, ne nicle. *@
                @(row.AvailableQuantity?.ToString("N2") ?? "—")
                @if (row.OrderedQuantity > 0 || row.ForShipmentQuantity > 0 || row.SupplierOrderedQuantity > 0)
                {
                  <span class="product-meta" title="naročeno · za odpremo · naročeno dobaviteljem">
                    @($"{row.OrderedQuantity ?? 0:N0} · {row.ForShipmentQuantity ?? 0:N0} · {row.SupplierOrderedQuantity ?? 0:N0}")
                  </span>
                }
              </td>
              <td class="numeric">@(row.IncomingQuantity?.ToString("N2") ?? "—")</td>
              <td>
                @if (row.AvailabilityDate is { } arrival) { <span>@arrival.ToString("dd.MM.yyyy")</span> }
                else if (row.IncomingQuantity > 0) { <span class="muted" title="Vir je javil količino, datuma pa ne.">datuma ni</span> }
                else { <span class="muted">—</span> }
              </td>
              <td class="numeric">@Limits(row)</td>
              <td>@row.OrganizationName</td>
              <td>
                <PimChip Text="@KindLabel(row.SourceKind)" Tone="@(row.SourceKind == "ERP" ? "info" : null)" />
                <span class="product-meta"><span class="source-code">@row.SourceCode</span></span>
              </td>
              <td>
                @row.SnapshotUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                <span class="product-meta">@FreshnessLabel(row.FreshnessMinutes)</span>
              </td>
              <td><PimChip Text="@(row.Quantity > 0 ? "Na zalogi" : "Brez zaloge")" Tone="@(row.Quantity > 0 ? "good" : "bad")" /></td>
            </tr>
          }
        </Rows>
      </PimTable>
      <PimPager Skip="Skip" Take="Take" Total="PageData.TotalCount" Label="Strani zalogovnih pozicij" SkipChanged="GoToSkipAsync" />
    }
  </PimState>
</section>

<h2 class="section-title">Svežina po viru</h2>
<section class="ui-card data-card" aria-label="Svežina zaloge po viru">
  <PimState Loading="Loading" Error="@Error" Empty="@(Overview is not null && Overview.Sources.Count == 0)"
            EmptyText="Aktivnih zalogovnih virov ni." LoadingText="Nalaganje virov …">
    @if (Overview is not null)
    {
      <PimTable Caption="Zalogovni viri in starost njihovega zadnjega posnetka" AriaLabel="Tabela zalogovnih virov" Columns="SourceColumns">
        <Rows>
          @foreach (var source in Overview.Sources)
          {
            <tr>
              <td><a href="@($"zaloge?vir={Uri.EscapeDataString(source.SourceCode)}")"><span class="source-code">@source.SourceCode</span></a></td>
              <td>@(source.ProviderKind ?? "—")</td>
              <td class="numeric">@source.PositionCount.ToString("N0")</td>
              <td class="numeric">@source.MatchedCount.ToString("N0")</td>
              <td class="numeric">@source.InStockCount.ToString("N0")</td>
              <td>@(source.SnapshotUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
              <td>
                @if (source.FreshnessMinutes is { } minutes)
                {
                  <PimChip Text="@FreshnessLabel(minutes)" Tone="@(minutes > StaleAfterMinutes ? "warn" : "good")" Prefix="Svežina: " />
                }
                else
                {
                  <span class="muted">—</span>
                }
              </td>
            </tr>
          }
          @if (Overview is not null && Overview.Sources.Count > 0)
          {
            @* Vrstica Skupaj nadomesti kartice povzetka, ki jih je uporabnik odpisal. *@
            <tr class="total-row">
              <td><strong>Skupaj</strong></td>
              <td>@Overview.Sources.Count vir(ov)</td>
              <td class="numeric">@Overview.Totals.PositionCount.ToString("N0")</td>
              <td class="numeric">@Overview.Totals.MatchedCount.ToString("N0")</td>
              <td class="numeric">@Overview.Totals.InStockCount.ToString("N0")</td>
              <td>@(Overview.Totals.NewestSnapshotUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
              <td>@Overview.Totals.UnmatchedCount.ToString("N0") brez artikla</td>
            </tr>
          }
        </Rows>
      </PimTable>
    }
  </PimState>
</section>

<h2 class="section-title">Izpeljane težave</h2>
<section class="ui-card data-card" aria-label="Izpeljane težave zaloge">
  <PimState Loading="Loading" Error="@Error" Empty="@(Overview is not null && Overview.Issues.Count == 0)"
            EmptyText="Zavrnjenih zalogovnih pozicij ni." LoadingText="Nalaganje težav …">
    @if (Overview is not null)
    {
      <PimTable Caption="Zavrnjene zalogovne pozicije po razlogu" AriaLabel="Tabela izpeljanih težav zaloge" Columns="IssueColumns">
        <Rows>
          @foreach (var issue in Overview.Issues)
          {
            <tr>
              <td><span class="code-value">@issue.ReasonCode</span></td>
              <td class="numeric">@issue.PositionCount.ToString("N0")</td>
              <td>@issue.FirstSeenUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
              <td>@issue.LastSeenUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
              <td class="detail-cell">@(issue.SampleDetail ?? "—")</td>
            </tr>
          }
        </Rows>
      </PimTable>
    }
  </PimState>
</section>

<p class="muted source-note">
  Vir: <span class="code-value">intranet.GetStockPositions</span> in <span class="code-value">intranet.GetStockOverview</span>
  (migracija 103). Izpeljane težave nimajo gumba »reši« — izginejo, ko izgine vzrok.
</p>

@code {
  [SupplyParameterFromQuery(Name = "isci")] public string? QuerySearch { get; set; }
  [SupplyParameterFromQuery(Name = "vir")] public string? QuerySource { get; set; }
  [SupplyParameterFromQuery(Name = "starost")] public int? QueryAge { get; set; }
  // Razpolozljivost in ujemanje sta odpadla v dveh korakih: kontroli 2026-08-28, parametra pa
  // 2026-08-31 skupaj s karticami povzetka, ki sta bila edina, kar je nanju kazalo.
  // Ima zalogo (Razpolozljivost) se je vrnila 2026-09-03, a samo kot kontrola na strani; parameter
  // v proceduri ni bil nikoli odstranjen.
  [SupplyParameterFromQuery(Name = "vrsta")] public string? QueryKind { get; set; }
  [SupplyParameterFromQuery(Name = "zaloga")] public string? QueryInStock { get; set; }
  [SupplyParameterFromQuery(Name = "podjetje")] public string? QueryOrganization { get; set; }
  [SupplyParameterFromQuery(Name = "stran")] public int? QueryPage { get; set; }

  StockPositionPage? PageData;
  StockOverview? Overview;
  bool Loading = true;
  string? Error;
  string SearchDraft = "";
  string SourceDraft = "";
  string AgeDraft = "";
  string KindDraft = "";
  string InStockDraft = "";
  string OrganizationDraft = "";
  IReadOnlyList<OrganizationContext> Organizations = [];

  /// <summary>Obseg, za katerega je prebran povzetek; prazen niz je veljaven obseg (vsa podjetja).</summary>
  string? LoadedScope;

  const int Take = 50;
  const int StaleAfterMinutes = 24 * 60;

  /// <summary>
  /// Prenos CSV (migracija 151) natancno sledi filtrom nad tabelo: podjetje je obvezno, ostalo
  /// (vir, vrsta vira, ima zalogo, svezina, iskanje) gre skozi, ce je nastavljeno. Uporabnik
  /// 2026-09-03: prenos naj bo odvisen od filtrov, ne locen od njih.
  /// </summary>
  string StockExportHref
  {
    get
    {
      var kind = KindDraft switch { "ERP" => "ERP", "DOBAVITELJ" => "DOBAVITELJ", _ => "VSE" };
      var parameters = new List<string> { "podjetje=" + Uri.EscapeDataString(OrganizationDraft), "vir=" + kind };
      if (!string.IsNullOrWhiteSpace(SourceDraft)) parameters.Add("virsifra=" + Uri.EscapeDataString(SourceDraft));
      if (!string.IsNullOrWhiteSpace(SearchDraft)) parameters.Add("isci=" + Uri.EscapeDataString(SearchDraft.Trim()));
      if (!string.IsNullOrWhiteSpace(InStockDraft)) parameters.Add("zaloga=" + InStockDraft);
      if (!string.IsNullOrWhiteSpace(AgeDraft)) parameters.Add("starost=" + AgeDraft);
      return "izvoz/zaloge.csv?" + string.Join('&', parameters);
    }
  }

  string ExportFilterSummary
  {
    get
    {
      var parts = new List<string>();
      if (!string.IsNullOrWhiteSpace(SourceDraft)) parts.Add("vir " + SourceDraft);
      if (!string.IsNullOrWhiteSpace(KindDraft)) parts.Add(KindLabel(KindDraft));
      if (!string.IsNullOrWhiteSpace(InStockDraft)) parts.Add(InStockDraft == "IN_STOCK" ? "na zalogi" : "brez zaloge");
      if (!string.IsNullOrWhiteSpace(AgeDraft)) parts.Add("posnetek do " + AgeDraft + " ur");
      if (!string.IsNullOrWhiteSpace(SearchDraft)) parts.Add("iskanje »" + SearchDraft.Trim() + "«");
      return parts.Count == 0 ? "brez dodatnih filtrov" : string.Join(", ", parts);
    }
  }

  int Skip => Math.Max(0, ((QueryPage ?? 1) - 1) * Take);

  static readonly IReadOnlyList<PimColumn> Columns =
  [
    new("Artikel"), new("Količina", Numeric: true), new("Razpoložljivo", Numeric: true), new("Prihodna količina", Numeric: true),
    new("Prihod"), new("Min / max", Numeric: true), new("Podjetje"), new("Vir"),
    new("Čas posnetka"), new("Stanje"),
  ];

  static readonly IReadOnlyList<PimColumn> SourceColumns =
  [
    new("Vir"), new("Vrsta"), new("Pozicij", Numeric: true), new("Pripetih", Numeric: true),
    new("Na zalogi", Numeric: true), new("Zadnji posnetek"), new("Svežina"),
  ];

  static readonly IReadOnlyList<PimColumn> IssueColumns =
  [
    new("Razlog"), new("Pozicij", Numeric: true), new("Prvič"), new("Nazadnje"), new("Primer"),
  ];

  IReadOnlyList<string> SourceCodes => Overview is null ? []
    : Overview.Sources.Select(source => source.SourceCode).Distinct().OrderBy(code => code).ToList();

  protected override async Task OnParametersSetAsync()
  {
    SearchDraft = QuerySearch ?? "";
    SourceDraft = QuerySource ?? "";
    AgeDraft = QueryAge?.ToString() ?? "";
    KindDraft = QueryKind ?? "";
    InStockDraft = QueryInStock ?? "";
    OrganizationDraft = QueryOrganization ?? "";

    Loading = true;
    Error = null;
    try
    {
      if (Organizations.Count == 0) Organizations = await Data.GetOrganizationsAsync();

      // Prazno podjetje pomeni vsa; neveljavna stevilka v naslovu ne sme tiho pomeniti vseh.
      var scope = int.TryParse(QueryOrganization, out var parsed) ? parsed : (int?)null;
      if (LoadedScope != (scope?.ToString() ?? ""))
      {
        LoadedScope = scope?.ToString() ?? "";
        Overview = await Stock.GetOverviewAsync(scope);
      }

      PageData = await Stock.GetPositionsAsync(new StockPositionFilter(
        scope, Skip, Take, QuerySearch, QuerySource,
        QueryInStock, null, QueryAge, "sl", QueryKind));
    }
    catch
    {
      Error = "Zaloge trenutno ni mogoče naložiti.";
    }
    finally
    {
      Loading = false;
    }
  }

  string ResultSummary => Loading ? "Nalaganje …"
    : Error is not null ? "Rezultati niso na voljo"
    : $"{PageData?.TotalCount ?? 0:N0} pozicij";

  string FreshnessNote()
  {
    if (Overview?.Totals.NewestSnapshotUtc is not { } newest) return "posnetka še ni";
    var minutes = (int)Math.Max(0, (DateTime.UtcNow - newest).TotalMinutes);
    return $"najnovejši posnetek {FreshnessLabel(minutes)}";
  }

  static string FreshnessLabel(int minutes) => minutes switch
  {
    < 60 => $"pred {minutes} min",
    < 60 * 48 => $"pred {minutes / 60} h",
    _ => $"pred {minutes / (60 * 24)} dnevi",
  };

  static string Limits(StockPositionRow row) =>
    row.MinimumStock is null && row.MaximumStock is null
      ? "—"
      : $"{row.MinimumStock?.ToString("N0") ?? "—"} / {row.MaximumStock?.ToString("N0") ?? "—"}";

  // Filtri in stran zivijo v naslovu; "" pomeni odstrani, null ohrani obstojecega.
  string Href(string? search = null, string? source = null,
    string? age = null, string? kind = null, string? inStock = null, string? organization = null, int? page = null)
  {
    var parameters = new List<string>();
    Add("isci", Resolve(search, QuerySearch));
    Add("vir", Resolve(source, QuerySource));
    Add("starost", Resolve(age, QueryAge?.ToString()));
    Add("vrsta", Resolve(kind, QueryKind));
    Add("zaloga", Resolve(inStock, QueryInStock));
    Add("podjetje", Resolve(organization, QueryOrganization));
    var resolvedPage = page ?? (search is null && source is null && age is null
      && kind is null && inStock is null && organization is null ? QueryPage : null);
    if (resolvedPage is > 1) parameters.Add("stran=" + resolvedPage);

    return parameters.Count == 0 ? "zaloge" : "zaloge?" + string.Join('&', parameters);

    void Add(string name, string? value)
    {
      if (!string.IsNullOrWhiteSpace(value)) parameters.Add(name + "=" + Uri.EscapeDataString(value));
    }

    static string? Resolve(string? requested, string? current) => requested is null ? current : requested;
  }

  Task ApplyFiltersAsync()
  {
    Navigation.NavigateTo(Href(
      search: SearchDraft.Trim(), source: SourceDraft, age: AgeDraft,
      kind: KindDraft, inStock: InStockDraft, organization: OrganizationDraft, page: 1));
    return Task.CompletedTask;
  }

  Task SearchKeyAsync(KeyboardEventArgs args) =>
    args.Key == "Enter" ? ApplyFiltersAsync() : Task.CompletedTask;

  Task GoToSkipAsync(int skip)
  {
    Navigation.NavigateTo(Href(page: skip / Take + 1));
    return Task.CompletedTask;
  }


  /// <summary>Vrsta vira, kot jo bere clovek. ERP je SAOP, vse ostalo je dobaviteljev vir.</summary>
  static string KindLabel(string? value) => value switch
  {
    "ERP" => "ERP (SAOP)",
    "DOBAVITELJ" => "dobavitelj",
    _ => "neznan vir",
  };


  static string MatchedLabel(string? value) => value switch
  {
    "MATCHED" => "pripeto na artikel",
    "UNMATCHED" => "brez artikla",
    _ => value ?? "—",
  };
}
