@page "/zajem/preslikave"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PipelineReadService Pipeline
@inject GovernanceReadService Governance
@inject IntranetDataService Data

<PageTitle>Preslikave vhodnih podatkov</PageTitle>
<PimPage Title="Preslikave vhodnih podatkov" Subtitle="Kaj je prišlo in česa PIM še ne razume: preslikave polj, vrednosti, dobaviteljeve kategorije ter manjkajoči prevodi." Crumbs="Crumbs" />
<IngestTabs Active="mappings" />

<PimState Loading="Loading" Error="@Error" Empty="false" LoadingText="Nalaganje delovnih seznamov preslikav …">
  @if (Summary is not null)
  {
    <section class="kpi-grid" aria-label="Povzetek dela na preslikavah">
      <PimStat Label="Nerazvrščene vrednosti" Value="@Summary.UnmappedValues.ToString("N0")" Href="zajem/neujemanja" />
      <PimStat Label="Manjkajoči prevodi" Value="@Summary.MissingTranslations.ToString("N0")" Href="kakovost/prevodi" />
      <PimStat Label="Dobaviteljeve kategorije" Value="@Summary.MissingCategories.ToString("N0")" Href="kakovost/kategorije" />
      <PimStat Label="Čakajoče strani" Value="@Summary.PendingPages.ToString("N0")" Note="preveri manjkajočo preslikavo" Href="zajem/cakalna-vrsta" />
    </section>
  }

  <div class="message-state info-message">
    Ta dostava je bralna. Gumbi za dodajanje v slovar, potrjevanje prevoda ali preslikavo
    kategorije se pojavijo šele skupaj z revizijsko sledljivo zapisovalno proceduro; stran se
    ne pretvarja, da spremembo že zna varno shraniti.
  </div>

  <section class="mapping-grid section-gap">
    <article class="ui-card data-card" aria-label="Nerazvrščene vrednosti">
      <PimState Empty="@(Unmapped.Count == 0)" EmptyText="Ni nerazvrščenih vrednosti.">
        <PimTable Caption="Najpogostejše nerazvrščene vrednosti" Columns="UnmappedColumns">
          <Rows>
            @foreach (var row in Unmapped)
            {
              <tr><td><span class="code-value">@row.TargetFieldCode</span></td><td>@row.Value</td><td class="numeric">@row.SeenCount.ToString("N0")</td></tr>
            }
          </Rows>
        </PimTable>
      </PimState>
      <a class="panel-link" href="zajem/neujemanja">Odpri celoten seznam</a>
    </article>

    <article class="ui-card data-card" aria-label="Manjkajoči prevodi">
      <PimState Empty="@(Translations.Count == 0)" EmptyText="Ni odprtih manjkajočih prevodov.">
        <PimTable Caption="Najpogostejše odprte prevodne vrzeli" Columns="TranslationColumns">
          <Rows>
            @foreach (var row in Translations)
            {
              <tr><td><span class="code-value">@row.Domain</span></td><td>@row.SourceValue</td><td class="numeric">@row.SeenCount.ToString("N0")</td></tr>
            }
          </Rows>
        </PimTable>
      </PimState>
      <a class="panel-link" href="kakovost/prevodi">Odpri celoten seznam</a>
    </article>

    <article class="ui-card data-card" aria-label="Dobaviteljeve kategorije">
      <PimState Empty="@(Categories.Count == 0)" EmptyText="Ni dobaviteljevih kategorij brez cilja.">
        <PimTable Caption="Dobaviteljeve kategorije brez cilja" Columns="CategoryColumns">
          <Rows>
            @foreach (var row in Categories)
            {
              <tr><td><span class="code-value">@row.SourceCode</span></td><td class="tree-path">@row.SourcePathKey</td><td class="numeric">@row.SeenCount.ToString("N0")</td></tr>
            }
          </Rows>
        </PimTable>
      </PimState>
      <a class="panel-link" href="kakovost/kategorije">Odpri celoten seznam</a>
    </article>

    <article class="ui-card data-card" aria-label="Preslikave polj">
      <PimState Empty="@(FieldMappings.Count == 0)" EmptyText="Ni aktivnih preslikav polj.">
        <PimTable Caption="Vzorec aktivnih preslikav polj" Columns="FieldColumns">
          <Rows>
            @foreach (var row in FieldMappings)
            {
              <tr><td><span class="code-value">@row.SourceCode</span></td><td>@row.SourceElement</td><td><span class="code-value">@row.TargetFieldCode</span></td></tr>
            }
          </Rows>
        </PimTable>
      </PimState>
      <AuthorizeView Roles="ADMIN,CATALOG_EDITOR,COMMERCIAL">
        <Authorized><a class="panel-link" href="pravila/preslikave">Odpri register preslikav</a></Authorized>
      </AuthorizeView>
    </article>
  </section>
</PimState>

@code {
  IngestSummary? Summary;
  IReadOnlyList<UnmappedValueRow> Unmapped = [];
  IReadOnlyList<MissingTranslationRow> Translations = [];
  IReadOnlyList<MissingCategoryRow> Categories = [];
  IReadOnlyList<FieldMappingRow> FieldMappings = [];
  bool Loading = true;
  string? Error;

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Vhodni podatki", "zajem"), new("Preslikave")];
  static readonly IReadOnlyList<PimColumn> UnmappedColumns = [new("Ciljno polje"), new("Vrednost"), new("Pojavitev", Numeric: true)];
  static readonly IReadOnlyList<PimColumn> TranslationColumns = [new("Domena"), new("Vrednost"), new("Pojavitev", Numeric: true)];
  static readonly IReadOnlyList<PimColumn> CategoryColumns = [new("Vir"), new("Pot"), new("Izdelkov", Numeric: true)];
  static readonly IReadOnlyList<PimColumn> FieldColumns = [new("Vir"), new("Element vira"), new("Ciljno polje")];

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var organization = await Data.GetCurrentOrganizationAsync();
      if (organization is null) { Error = "Aktivna organizacija ni na voljo."; return; }
      var summaryTask = Pipeline.GetSummaryAsync(organization.OrganizationId);
      var unmappedTask = Pipeline.GetUnmappedValuesAsync(organization.OrganizationId, 10);
      var translationsTask = Pipeline.GetMissingTranslationsAsync(null, 10);
      var categoriesTask = Pipeline.GetMissingCategoriesAsync(organization.OrganizationId, 10);
      var fieldsTask = Governance.GetFieldMappingsAsync(organization.OrganizationId, null, null, 0, 10);
      await Task.WhenAll(summaryTask, unmappedTask, translationsTask, categoriesTask, fieldsTask);
      Summary = await summaryTask;
      Unmapped = await unmappedTask;
      Translations = await translationsTask;
      Categories = await categoriesTask;
      FieldMappings = (await fieldsTask).Rows;
    }
    catch { Error = "Delovnih seznamov preslikav trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }
}
