@page "/saop/polja"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SaopWriteService Write
@inject IntranetDataService Data

<PageTitle>Polja za zapis v SAOP</PageTitle>
<PimPage Title="Kaj sme nazaj v SAOP" Subtitle="Bralni pregled polj, za katera obstaja nadzorovana zapisovalna pot. Urejanje lastništva tu ni dovoljeno." Crumbs="Crumbs" />

<PimMissing Object="intranet.GetWritableSaopFields" What="lastnika polja iz pim.FieldOwnership in dokaz, da se polje po zapisu bere nazaj" Needs="pim.FieldOwnership, out.OwnershipPolicy in povezavo s povratnim SAOP poljem" />

<section class="ui-card data-card section-gap" aria-label="Dovoljena polja SAOP">
  <PimState Loading="Loading" Error="@Error" Empty="@(!Loading && Rows.Count == 0)" EmptyText="Za organizacijo ni dovoljenih polj za zapis nazaj." LoadingText="Nalaganje polj …">
    <PimTable Caption="Polja z zapisovalno potjo v SAOP" Columns="Columns">
      <Rows>
        @foreach (var row in Rows)
        {
          <tr>
            <td><span class="code-value">@row.FieldKey</span></td><td>@row.ElementName</td><td>@row.Section</td><td>@row.ValueFormat</td>
            <td>—</td><td>—</td><td><PimChip Text="Ni varno za pisanje" Tone="warn" /></td><td>@(row.IsAddMandatory ? "Da" : "Ne")</td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

<div class="note-panel section-gap">Stran je samo bralna. Brez potrjenega branja nazaj polje ni označeno kot varno, tudi če XML zapisovalna definicija obstaja.</div>

@code {
  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("SAOP", "saop"), new("Kaj sme nazaj")];
  static readonly IReadOnlyList<PimColumn> Columns = [new("Polje"), new("XML element"), new("Sekcija"), new("Oblika"), new("Lastnik"), new("Bere se nazaj"), new("Varnost"), new("Obvezno ob dodajanju")];
  IReadOnlyList<WritableFieldRow> Rows = [];
  bool Loading = true;
  string? Error;
  protected override async Task OnInitializedAsync()
  {
    try { var org = await Data.GetCurrentOrganizationAsync(); if (org is null) { Error = "Aktivna organizacija ni na voljo."; return; } Rows = await Write.GetWritableFieldsAsync(org.OrganizationId); }
    catch { Error = "Polj za zapis v SAOP trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }
}
