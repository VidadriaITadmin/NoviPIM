@page "/saop/polja"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SaopWriteService Write
@inject IntranetDataService Data

<PageTitle>Polja za zapis v SAOP</PageTitle>
<PimPage OrganizationScope="true" Title="Kaj sme nazaj v SAOP" Subtitle="Polja, ki jih PIM sme zapisati nazaj v SAOP. Vsaka sprememba gre skozi čakalno vrsto in odobritev; vsa ostala polja so last SAOP in se popravijo v ERP." Crumbs="Crumbs" />

@* Pregled 2026-09-22: stran je vsakemu polju pripisala »Ni varno za pisanje« in dva vedno prazna
   stolpca (Lastnik, Bere se nazaj), ceprav intranet.GetWritableSaopFields vrne ravno polja v lasti
   PIM, ki se smejo pisati. Kaze se samo to, kar procedura res ve. *@
<section class="ui-card data-card section-gap" aria-label="Dovoljena polja SAOP">
  <PimState Loading="Loading" Error="@Error" Empty="@(!Loading && Rows.Count == 0)" EmptyText="Za organizacijo ni dovoljenih polj za zapis nazaj." LoadingText="Nalaganje polj …">
    <PimTable Caption="Polja z zapisovalno potjo v SAOP" Columns="Columns">
      <Rows>
        @foreach (var row in Rows)
        {
          <tr>
            <td><span class="code-value">@row.FieldKey</span></td><td>@row.ElementName</td><td>@row.Section</td>
            <td>@row.ValueFormat@if (row.TrueValue is not null || row.FalseValue is not null) { <span class="muted"> (da = @(row.TrueValue ?? "—"), ne = @(row.FalseValue ?? "—"))</span> }</td>
            <td>@(row.IsAddMandatory ? "Da" : "Ne")</td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

<div class="note-panel section-gap">Stran je samo bralna. Ali je SAOP zapisano vrednost res prevzel, pokaže zavihek Odkloni (primerjava poslane vrednosti z naslednjim branjem iz SAOP).</div>

@code {
  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("SAOP", "saop"), new("Kaj sme nazaj")];
  static readonly IReadOnlyList<PimColumn> Columns = [new("Polje"), new("XML element"), new("Sekcija"), new("Oblika"), new("Obvezno ob dodajanju")];
  IReadOnlyList<WritableFieldRow> Rows = [];
  bool Loading = true;
  string? Error;
  protected override async Task OnInitializedAsync()
  {
    try { var org = await Data.GetCurrentOrganizationAsync(); if (org is null) { Error = "Aktivna organizacija ni na voljo."; return; } Rows = await Write.GetWritableFieldsAsync(org.OrganizationId); }
    catch { Error = "Polj za zapis v SAOP trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }
}
