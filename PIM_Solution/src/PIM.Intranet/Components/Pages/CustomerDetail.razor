@page "/stranke/{CustomerId:long}"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.IntranetDataService Data
@inject AuthenticationStateProvider Authentication

<PageTitle>Stranka</PageTitle>
@if (Row is null) { <div class="ui-card loading-state">Stranka ni najdena ali se nalaga.</div> }
else
{
  <div class="page-header"><div><p><a href="stranke">Stranke</a> › @Row.CustomerKey</p><h1>@Row.Name</h1><p>Šifra: @Row.CustomerKey</p></div></div>
  <section class="ui-card data-card"><table class="data-table"><caption>Podatki iz SAOP (samo za branje)</caption><tbody><tr><th>Plačnik</th><td>@Row.PayerCode — @Row.PayerName</td></tr><tr><th>Cenik</th><td>@Row.PriceListCode</td></tr><tr><th>Rabatni cenik</th><td>@Row.DiscountPriceListCode</td></tr></tbody></table></section>
  <EditForm Model="Row" OnValidSubmit="Save" class="ui-card panel section-gap">
    <h2>Spletni profil stranke</h2>
    <div class="form-grid">
      <label class="form-field">Tip stranke<select class="filter-select" @bind="TypeCode"><option value="">Ni določen</option>@foreach(var type in Types){<option value="@type.CustomerTypeCode">@type.Name</option>}</select></label>
      <label class="form-field">Vrsta stranke<select class="filter-select" @bind="Kind"><option value="">Ni določena</option><option value="CUSTOMER">Kupec</option><option value="SUPPLIER">Dobavitelj</option><option value="BOTH">Kupec in dobavitelj</option></select></label>
      <label class="form-field">B2B+ velja od<input type="date" class="form-input" @bind="PlusFrom" /></label>
      <label class="form-field">B2B+ velja do<input type="date" class="form-input" @bind="PlusTo" /></label>
    </div>
    <div class="check-grid"><label class="check-field"><input type="checkbox" @bind="Pack" />Popust na polno pakiranje</label><label class="check-field"><input type="checkbox" @bind="Value" />Vrednostni rabat</label><label class="check-field"><input type="checkbox" @bind="Plus" />B2B+ ugodnost</label><label class="check-field"><input type="checkbox" @bind="Web" />Splet omogočen</label></div>
    <div class="panel-actions"><button class="primary-button" type="submit">Shrani profil</button></div>
  </EditForm>
  <section class="ui-card panel section-gap"><h2>Vrednostni prag stranke</h2><div class="form-grid"><label class="form-field">Stopnja (1–3)<input type="number" class="form-input" @bind="TierNumber" /></label><label class="form-field">Prag bruto brez DDV<input type="number" class="form-input" @bind="TierThreshold" /></label><label class="form-field">Popust %<input type="number" class="form-input" @bind="TierPercent" /></label><div class="form-action"><button class="primary-button" @onclick="SaveTier">Shrani prag stranke</button></div></div></section>
  @if (!string.IsNullOrEmpty(Message)) { <p class="message-state info-message" role="status">@Message</p> }
}
@code {
  [Parameter] public long CustomerId {get;set;} PIM.Intranet.Services.CustomerDetailRow? Row;IReadOnlyList<PIM.Intranet.Services.CustomerTypeRow> Types=[];string? TypeCode,Kind,Message;bool Pack,Value,Plus,Web;DateTime? PlusFrom,PlusTo;int TierNumber=1;decimal TierThreshold,TierPercent;int? OrganizationId;
  protected override async Task OnParametersSetAsync(){var org=await Data.GetCurrentOrganizationAsync();if(org is null)return;OrganizationId=org.OrganizationId;Types=await Data.GetCustomerTypesAsync();Row=await Data.GetCustomerDetailAsync(org.OrganizationId,CustomerId);if(Row is null)return;TypeCode=Row.CustomerTypeCode;Kind=Row.CustomerKind;Pack=Row.PackagingDiscountEnabled;Value=Row.ValueDiscountEnabled;Plus=Row.B2bPlusEnabled;Web=Row.WebEnabled;PlusFrom=Row.B2bPlusValidFrom;PlusTo=Row.B2bPlusValidTo;}
  async Task Save(){if(Row is null||OrganizationId is null)return;var auth=await Authentication.GetAuthenticationStateAsync();var actor=auth.User.Identity?.Name??"neznan";Row=Row with{CustomerTypeCode=TypeCode,CustomerKind=Kind,PackagingDiscountEnabled=Pack,ValueDiscountEnabled=Value,B2bPlusEnabled=Plus,WebEnabled=Web,B2bPlusValidFrom=PlusFrom,B2bPlusValidTo=PlusTo};await Data.SaveCustomerWebProfileAsync(OrganizationId.Value,Row,actor);Message="Profil stranke je shranjen in revizijsko zabeležen.";}
  async Task SaveTier(){if(OrganizationId is null)return;var auth=await Authentication.GetAuthenticationStateAsync();await Data.SaveCustomerValueTierAsync(OrganizationId.Value,CustomerId,TierNumber,TierThreshold,TierPercent,auth.User.Identity?.Name??"neznan");Message="Prag stranke je shranjen in revizijsko zabeležen.";}
}
