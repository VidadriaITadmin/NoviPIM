@page "/stranke/{CustomerId:long}"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@inject PIM.Intranet.Services.IntranetDataService Data
@inject AuthenticationStateProvider Authentication

<PageTitle>Stranka</PageTitle>
@if (Row is null) { <p>Stranka ni najdena ali se nalaga.</p> }
else
{
  <h1>@Row.Name</h1><p><strong>Šifra:</strong> @Row.CustomerKey</p>
  <div class="card p-3 mb-3"><h2>Podatki iz SAOP (samo za branje)</h2><p><strong>Plačnik:</strong> @Row.PayerCode — @Row.PayerName</p><p><strong>Cenik:</strong> @Row.PriceListCode · <strong>Rabatni cenik:</strong> @Row.DiscountPriceListCode</p></div>
  <EditForm Model="Row" OnValidSubmit="Save"><div class="mb-2"><label>Tip stranke <select class="form-select" @bind="TypeCode"><option value="">Ni določen</option>@foreach(var type in Types){<option value="@type.CustomerTypeCode">@type.Name</option>}</select></label></div><div class="mb-2"><label>Vrsta stranke <select class="form-select" @bind="Kind"><option value="">Ni določena</option><option value="CUSTOMER">Kupec</option><option value="SUPPLIER">Dobavitelj</option><option value="BOTH">Kupec in dobavitelj</option></select></label></div>
  <div class="form-check"><input type="checkbox" class="form-check-input" @bind="Pack" /><label>Popust na polno pakiranje</label></div><div class="form-check"><input type="checkbox" class="form-check-input" @bind="Value" /><label>Vrednostni rabat</label></div><div class="form-check"><input type="checkbox" class="form-check-input" @bind="Plus" /><label>B2B+ ugodnost</label></div><div class="form-check"><input type="checkbox" class="form-check-input" @bind="Web" /><label>Splet omogočen</label></div>
  <label>B2B+ velja od <input type="date" class="form-control" @bind="PlusFrom" /></label><label>B2B+ velja do <input type="date" class="form-control" @bind="PlusTo" /></label><button class="btn btn-primary mt-3" type="submit">Shrani profil</button></EditForm>
  <h2 class="mt-3">Trije vrednostni pragovi stranke</h2><div class="row"><div class="col"><label>Stopnja (1–3) <input type="number" class="form-control" @bind="TierNumber" /></label></div><div class="col"><label>Prag bruto brez DDV <input type="number" class="form-control" @bind="TierThreshold" /></label></div><div class="col"><label>Popust % <input type="number" class="form-control" @bind="TierPercent" /></label></div><div class="col align-self-end"><button class="btn btn-primary" @onclick="SaveTier">Shrani prag stranke</button></div></div>
  @if (!string.IsNullOrEmpty(Message)) { <p class="alert alert-info mt-2">@Message</p> }
}
@code {
  [Parameter] public long CustomerId {get;set;} PIM.Intranet.Services.CustomerDetailRow? Row;IReadOnlyList<PIM.Intranet.Services.CustomerTypeRow> Types=[];string? TypeCode,Kind,Message;bool Pack,Value,Plus,Web;DateTime? PlusFrom,PlusTo;int TierNumber=1;decimal TierThreshold=800,TierPercent=1;
  protected override async Task OnParametersSetAsync(){Types=await Data.GetCustomerTypesAsync();Row=await Data.GetCustomerDetailAsync(2,CustomerId);if(Row is null)return;TypeCode=Row.CustomerTypeCode;Kind=Row.CustomerKind;Pack=Row.PackagingDiscountEnabled;Value=Row.ValueDiscountEnabled;Plus=Row.B2bPlusEnabled;Web=Row.WebEnabled;PlusFrom=Row.B2bPlusValidFrom;PlusTo=Row.B2bPlusValidTo;}
  async Task Save(){if(Row is null)return;var auth=await Authentication.GetAuthenticationStateAsync();var actor=auth.User.Identity?.Name??"neznan";Row=Row with{CustomerTypeCode=TypeCode,CustomerKind=Kind,PackagingDiscountEnabled=Pack,ValueDiscountEnabled=Value,B2bPlusEnabled=Plus,WebEnabled=Web,B2bPlusValidFrom=PlusFrom,B2bPlusValidTo=PlusTo};await Data.SaveCustomerWebProfileAsync(2,Row,actor);Message="Profil stranke je shranjen in revizijsko zabeležen.";}
  async Task SaveTier(){var auth=await Authentication.GetAuthenticationStateAsync();await Data.SaveCustomerValueTierAsync(2,CustomerId,TierNumber,TierThreshold,TierPercent,auth.User.Identity?.Name??"neznan");Message="Prag stranke je shranjen in revizijsko zabeležen.";}
}
