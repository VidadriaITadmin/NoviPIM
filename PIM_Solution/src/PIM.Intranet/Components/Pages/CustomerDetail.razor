  }

  bool HasManualContact => Card is not null &&
    (Card.Contacts.ManualEmail ?? Card.Contacts.ManualPhone ?? Card.Contacts.ManualMobile ?? Card.Contacts.ManualPersons) is not null;

  static string OriginLabel(string? source) => source switch
  {
    "PIM" => "ročno",
    "SAOP" => "iz SAOP",
    _ => "ni vrednosti",
