@page "/stranke/{CustomerId:long}"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.IntranetDataService Data
@inject PIM.Intranet.Services.CustomerCardService Cards
@inject PIM.Intranet.Services.CustomerListService CustomerList
@inject AuthenticationStateProvider Authentication

@* Kartica stranke po popravkih 2026-08-28. Prej je bila ena stran z dvema tabelama in enim
   obrazcem; uporabnik je zahteval zavihke in sest sklopov: splosni podatki, komercialni
   podatki, poslovne enote in tranziti, zaznamki, dokumenti in finance (se pridejo) ter
   zgodovina sprememb. Vsi podatki pridejo iz enega bralnega klica (migracija 129). *@

<PageTitle>@(Card?.General.Name ?? "Stranka")</PageTitle>

<PimState Loading="Loading" Error="@Error" Empty="@(Card is null)"
          EmptyText="Stranke s to oznako ni." LoadingText="Nalaganje kartice stranke …">
  @if (Card is not null)
  {
    var general = Card.General;
    <PimPage Title="@general.Name" Subtitle="@($"{OrganizationName} · šifra {general.CustomerKey} · {RoleSummary}")" Crumbs="Crumbs" />

    <section class="customer-hero" aria-labelledby="customer-identity-title">
      <div class="customer-mark" aria-hidden="true">@CustomerInitials(general.Name)</div>
      <div class="customer-identity">
        <h2 id="customer-identity-title" class="visually-hidden">Identiteta stranke</h2>
        <p class="identity-line">
          <span class="organization-badge">@OrganizationName</span>
          <span class="code-value">@general.CustomerKey</span>
          @if (!string.IsNullOrWhiteSpace(general.City)) { <span>@general.City</span> }
          @if (!string.IsNullOrWhiteSpace(general.TaxNumber)) { <span>DŠ @general.TaxNumber</span> }
        </p>
        <div class="header-chips" aria-label="Stanje stranke">
          <span class="flag-chip @(general.IsActive == true ? "on" : "off")">@(general.IsActive == true ? "Aktivna" : "Neaktivna")</span>
          <span class="flag-chip @ExportChipClass()">@ExportChipText()</span>
          <span class="flag-chip @(general.MagentoGroupKey is null ? "off" : "on")">Magento: @(general.MagentoGroupKey ?? "brez skupine")</span>
          <PimChip Text="@RoleSummary" Prefix="Vloga: " />
        </div>
        <span class="customer-hero-updated">SAOP: @general.UpdatedUtc.ToPimLocal().ToString("g")</span>
      </div>
      <div class="customer-summary" aria-label="Povzetek stranke">
        <div><span class="summary-value">@Card.Branches.Count.ToString("N0")</span><span class="summary-label">enot in tranzitov</span></div>
        <div><span class="summary-value">@Card.Notes.Count.ToString("N0")</span><span class="summary-label">zaznamkov</span></div>
        <div><span class="summary-value">@(Card.Contacts.SourceAvailable ? "ERP" : "Ročno")</span><span class="summary-label">vir kontaktov</span></div>
      </div>
    </section>

    <div class="customer-workspace">
      <aside class="customer-section-nav-column">
        <nav class="customer-section-nav" role="tablist" aria-label="Sklopi kartice stranke" aria-orientation="vertical">
          @foreach (var tab in Tabs)
          {
            var active = Section == tab.Key;
            <button type="button" role="tab" id="tab-@tab.Key" aria-controls="panel-@tab.Key"
                    aria-selected="@active.ToString().ToLowerInvariant()"
                    class="@(active ? "active" : null)" @onclick="() => Section = tab.Key">
              <span>@tab.Label</span>
              @if (tab.Count is > 0) { <span class="nav-badge">@tab.Count.Value.ToString("N0")</span> }
            </button>
          }
        </nav>
      </aside>

      <div class="customer-section-content">

    <section id="panel-general" role="tabpanel" aria-labelledby="tab-general" hidden="@(Section != "general")">
      <section class="ui-card panel">
        <div class="subsection-head">
          <h2>Splošni podatki stranke</h2>
          <span>ročna vrednost prevlada nad SAOP; prazno polje pomeni brez ročnega prepisa, takrat velja vrednost iz SAOP</span>
        </div>
        <div class="form-grid">
          <label class="form-field">Šifra stranke<input class="form-input" @bind="GeneralDraft.CustomerKey" /></label>
          <label class="form-field">Naziv<input class="form-input" @bind="GeneralDraft.Name" /></label>
          <label class="form-field">Ulica<input class="form-input" @bind="GeneralDraft.Street" /></label>
          <label class="form-field">Hišna številka<input class="form-input" @bind="GeneralDraft.HouseNumber" /></label>
          <label class="form-field">Poštna številka<input class="form-input" @bind="GeneralDraft.PostalCode" /></label>
          <label class="form-field">Kraj<input class="form-input" @bind="GeneralDraft.City" /></label>
          <label class="form-field">Naslov (celoten, če ni razčlenjen)<input class="form-input" @bind="GeneralDraft.Address" /></label>
          <label class="form-field">Država<input class="form-input" @bind="GeneralDraft.Country" /></label>
          <label class="form-field">Davčna številka<input class="form-input" @bind="GeneralDraft.TaxNumber" /></label>
          <label class="form-field">Matična številka<input class="form-input" @bind="GeneralDraft.RegistrationNumber" /></label>
          <label class="form-field">Šifra dejavnosti<input class="form-input" @bind="GeneralDraft.ActivityCode" /></label>
          <label class="form-field">Pravna oblika<input class="form-input" @bind="GeneralDraft.LegalForm" /></label>
          <label class="form-field">Vrsta stranke (šifra iz SAOP)<input class="form-input" @bind="GeneralDraft.CustomerType" /></label>
          <label class="form-field">Plačnik — šifra<input class="form-input" @bind="GeneralDraft.PayerCode" /></label>
          <label class="form-field">Plačnik — naziv<input class="form-input" @bind="GeneralDraft.PayerName" /></label>
          <label class="form-field">Cenik<input class="form-input" @bind="GeneralDraft.PriceListCode" /></label>
          <label class="form-field">Rabatni cenik<input class="form-input" @bind="GeneralDraft.DiscountPriceListCode" /></label>
          <label class="form-field">Valuta<input class="form-input" @bind="GeneralDraft.CurrencyCode" /></label>
          <label class="form-field">Jezik<input class="form-input" @bind="GeneralDraft.LanguageId" /></label>
          <label class="form-field">Plačilni rok (dni)<input type="number" class="form-input" @bind="GeneralDraft.PaymentDays" /></label>
          <label class="form-field">Rabat (%)<input type="number" step="0.01" class="form-input" @bind="GeneralDraft.RebatePercent" /></label>
          <label class="form-field">Zavezanec za DDV
            <select class="filter-select" @bind="GeneralSubjectToVatText">
              <option value="">— brez ročnega prepisa —</option>
              <option value="true">Da</option>
              <option value="false">Ne</option>
            </select>
          </label>
          <label class="form-field">Plačilo vnaprej
            <select class="filter-select" @bind="GeneralUpfrontPaymentText">
              <option value="">— brez ročnega prepisa —</option>
              <option value="true">Da</option>
              <option value="false">Ne</option>
            </select>
          </label>
          <label class="form-field">Neplačnik
            <select class="filter-select" @bind="GeneralIsDefaulterText">
              <option value="">— brez ročnega prepisa —</option>
              <option value="true">Da</option>
              <option value="false">Ne</option>
            </select>
          </label>
          <label class="form-field">Aktivna
            <select class="filter-select" @bind="GeneralIsActiveText">
              <option value="">— brez ročnega prepisa —</option>
              <option value="true">Da</option>
              <option value="false">Ne</option>
            </select>
          </label>
        </div>
        <p class="card-note">
          Zadnja sprememba iz SAOP: @general.UpdatedUtc.ToPimLocal().ToString("g").
          @if (general.HasManualGeneral)
          {
            <text> Ročno prilagojeno: @general.GeneralUpdatedBy, @general.GeneralUpdatedUtc?.ToPimLocal().ToString("g").</text>
          }
        </p>
        <div class="panel-actions">
          <button type="button" class="primary-button" disabled="@Busy" @onclick="SaveGeneralAsync">Shrani splošne podatke</button>
          <button type="button" class="ghost-button" disabled="@(Busy || !general.HasManualGeneral)" @onclick="ClearGeneralAsync">Počisti ročne prilagoditve</button>
        </div>
      </section>

      @{ var contacts = Card.Contacts; }
      <section class="ui-card panel section-gap">
        <div class="subsection-head">
          <h2>Kontakti</h2>
          <span>obvezni stolpci izvoza strank za Magento; ročni vnos prevlada nad vrednostjo iz SAOP</span>
        </div>

        @if (!contacts.SourceAvailable)
        {
          @* Zajema kontaktov ni (migracija 140). Prazna polja brez pojasnila bi izgledala kot
             napaka strani; povemo, kaj natanko manjka, in ročni vnos vseeno ponudimo. *@
          <PimMissing Object="zajem SAOP GetCustomerContacts"
                      What="e-pošta, telefon, mobitel in osebe iz ERP"
                      Needs="vrstico za ta endpoint v map.EntityMapping in preslikave CustomerContact.* v map.FieldMapping; endpoint GetCustomers, ki ga PIM zajema danes, kontaktov ne nosi" />
          <p class="card-note">@contacts.SourceNote</p>
        }

        <div class="form-grid">
          <label class="form-field">E-pošta
            <input class="form-input" type="email" @bind="ContactEmail" placeholder="prodaja@primer.si" />
            <span class="field-origin">@OriginLabel(contacts.EmailSource)</span>
          </label>
          <label class="form-field">Telefon
            <input class="form-input" @bind="ContactPhone" />
            <span class="field-origin">@OriginLabel(contacts.PhoneSource)</span>
          </label>
          <label class="form-field">Mobitel
            <input class="form-input" @bind="ContactMobile" />
            <span class="field-origin">@OriginLabel(contacts.MobileSource)</span>
          </label>
          <label class="form-field">Uporabniki oziroma osebe
            <input class="form-input" @bind="ContactPersons" placeholder="Ana Novak | Bojan Kos" />
            <span class="field-origin">@OriginLabel(contacts.PersonsSource)</span>
          </label>
        </div>

        <p class="card-note">
          Več oseb ločite z znakom <span class="code-value">|</span> — tako jih pričakuje izvoz za Magento.
          Prazno polje pomeni, da ročnega prepisa ni; takrat obvelja vrednost iz SAOP, če obstaja.
          @if (contacts.UpdatedUtc is DateTime touched)
          {
            <text>Zadnji ročni popravek: @contacts.UpdatedBy, @touched.ToPimLocal().ToString("g").</text>
          }
        </p>

        <div class="panel-actions">
          <button type="button" class="primary-button" disabled="@Busy" @onclick="SaveContactsAsync">Shrani kontakte</button>
          <button type="button" class="ghost-button" disabled="@(Busy || !HasManualContact)" @onclick="ClearContactsAsync">Počisti ročni prepis</button>
        </div>
      </section>
    </section>

    <section id="panel-commercial" role="tabpanel" aria-labelledby="tab-commercial" hidden="@(Section != "commercial")">
      <EditForm Model="Draft" OnValidSubmit="SaveProfileAsync" class="ui-card panel">
        <h2>B2B spletne nastavitve</h2>
        <div class="form-grid">
          <label class="form-field">Tip stranke
            <select class="filter-select" @bind="Draft.TypeCode">
              <option value="">Ni določen</option>
              @foreach (var type in Types) { <option value="@type.CustomerTypeCode">@type.Name</option> }
            </select>
          </label>
          <label class="form-field">Vrsta stranke
            <select class="filter-select" @bind="Draft.Kind">
              <option value="">Ni določena — velja izračun</option>
              @foreach (var kind in Kinds) { <option value="@kind.Code">@kind.Label</option> }
            </select>
          </label>
          <label class="form-field">B2B+ velja od<input type="date" class="form-input" @bind="Draft.PlusFrom" /></label>
          <label class="form-field">B2B+ velja do<input type="date" class="form-input" @bind="Draft.PlusTo" /></label>
        </div>
        <div class="check-grid">
          <label class="check-field"><input type="checkbox" @bind="Draft.Packaging" />Popust na polno pakiranje</label>
          <label class="check-field"><input type="checkbox" @bind="Draft.ValueDiscount" />Vrednostni rabat</label>
          <label class="check-field"><input type="checkbox" @bind="Draft.Plus" />B2B+ (brezplačna poštnina)</label>
          @* Oznake Splet pri strankah ni vec (202): v stranke.csv gre vsaka aktivna stranka. *@
        </div>
        <p class="card-note">
          Magento skupina: <span class="code-value">@(general.MagentoGroupKey ?? "ni preslikave za ta tip")</span>.
          Skupina strank je nosilna vez — nanjo so vezane cene in popusti, ne na posamezno stranko.
        </p>
        @* Vloga je izracunana znotraj podjetja stranke (migracija 250); rocna vrsta zgoraj jo prepise. *@
        @if (Role is not null)
        {
          <p class="card-note">
            Vloga v podjetju @Role.OrganizationName: <strong>@Role.RoleLabel</strong> (@Role.RoleSourceLabel).
            @if (Role.SuppliedProductCount > 0)
            {
              <text> Dobavitelj za </text><a href="@ProductsHref("dobavitelj")">@Role.SuppliedProductCount.ToString("N0") izdelkov</a><text>.</text>
            }
            @if (Role.ManufacturedProductCount > 0)
            {
              <text> Proizvajalec za </text><a href="@ProductsHref("proizvajalec")">@Role.ManufacturedProductCount.ToString("N0") izdelkov</a><text>.</text>
            }
            @(Role.InCustomerExport ? " Gre v stranke.csv (aktivna, z B2B profilom)." : " Ne gre v stranke.csv.")
          </p>
        }
        <div class="panel-actions"><button class="primary-button" type="submit" disabled="@Busy">Shrani nastavitve</button></div>
      </EditForm>

      <section class="ui-card data-card section-gap">
        @* Isti popusti kot v stranke.csv (migracija 253): rocni popust stranke, rocni popust tipa,
           sicer SAOP rabatni cenik; poslovna enota ga podeduje od placnika, tranzit ga nima. *@
        <div class="subsection-head"><h2>Skupine popustov</h2><span>kataložni popust po skupini artiklov — natanko to gre v stranke.csv</span></div>
        <PimState Empty="@(Card.GroupDiscounts.Count == 0)"
                  EmptyText="Stranka danes nima veljavnih skupinskih popustov. Tranzit jih nima; poslovna enota jih podeduje od plačnika.">
          <PimTable Caption="Skupine popustov, ki danes veljajo za stranko" Columns="GroupColumns">
            <Rows>
              @foreach (var row in Card.GroupDiscounts)
              {
                <tr><td><span class="code-value">@row.ItemGroupCode</span></td><td class="numeric">@row.DiscountPercent.ToString("N2") %</td><td class="numeric">@(row.MinQuantity?.ToString("N0") ?? "—")</td><td>@Day(row.ValidFrom) – @Day(row.ValidTo)</td><td>@row.CustomerGroupCode</td></tr>
              }
            </Rows>
          </PimTable>
        </PimState>
      </section>

      <section class="ui-card data-card section-gap">
        <div class="subsection-head"><h2>Vrednostni rabat</h2><span>prag na vrednost košarice, bruto brez DDV</span></div>
        <PimState Empty="@(Card.ValueTiers.Count == 0)" EmptyText="Stranka nima svojih pragov; velja splošna lestvica.">
          <PimTable Caption="Vrednostni pragovi stranke" Columns="TierColumns">
            <Rows>
              @foreach (var row in Card.ValueTiers)
              {
                <tr><td class="numeric">@row.TierNumber</td><td class="numeric">@row.ThresholdGrossExVat.ToString("N2") €</td><td class="numeric">@row.PercentValue.ToString("N2") %</td><td><PimChip Text="@(row.IsActive ? "Velja" : "Ne velja")" Tone="@(row.IsActive ? "good" : null)" /></td></tr>
              }
            </Rows>
          </PimTable>
        </PimState>
        <div class="form-grid section-gap">
          <label class="form-field">Stopnja (1–3)<input type="number" class="form-input" @bind="TierNumber" /></label>
          <label class="form-field">Prag bruto brez DDV<input type="number" class="form-input" @bind="TierThreshold" /></label>
          <label class="form-field">Popust %<input type="number" class="form-input" @bind="TierPercent" /></label>
          <div class="form-action"><button type="button" class="primary-button" disabled="@Busy" @onclick="SaveTierAsync">Shrani prag</button></div>
        </div>
      </section>

      <section class="ui-card data-card section-gap">
        <div class="subsection-head"><h2>Posebni popusti za stranko</h2><span>odstopanje od popusta na polno pakiranje pri posameznem izdelku</span></div>
        <PimState Empty="@(Card.SpecialDiscounts.Count == 0)" EmptyText="Stranka nima posebnih popustov na izdelek.">
          <PimTable Caption="Posebni popusti stranke po izdelku" Columns="SpecialColumns">
            <Rows>
              @foreach (var row in Card.SpecialDiscounts)
              {
                <tr><td><span class="code-value">@(row.ItemId ?? "—")</span></td><td>@row.DiscountCode</td><td>@Day(row.ValidFrom) – @Day(row.ValidTo)</td><td><PimChip Text="@(row.IsActive ? "Velja" : "Ne velja")" Tone="@(row.IsActive ? "good" : null)" /></td></tr>
              }
            </Rows>
          </PimTable>
        </PimState>
      </section>
    </section>

    <section id="panel-branches" role="tabpanel" aria-labelledby="tab-branches" hidden="@(Section != "branches")">
      <section class="ui-card data-card">
        <div class="subsection-head">
          <h2>Poslovne enote in tranziti</h2>
          <span>poslovna enota podeduje skupinske popuste od plačnika, tranzit jih nima</span>
        </div>
        <PimState Empty="@(Card.Branches.Count == 0)" EmptyText="Stranka nima zapisanih poslovnih enot ali tranzitov.">
          <PimTable Caption="Poslovne enote in tranziti stranke" Columns="BranchColumns">
            <Rows>
              @foreach (var row in Card.Branches)
              {
                <tr>
                  <td><PimChip Text="@(row.BranchKind == "PE" ? "Poslovna enota" : "Tranzit")" Tone="@(row.BranchKind == "PE" ? "info" : "warn")" /></td>
                  <td>
                    @if (row.BranchCustomerId is long id) { <a href="stranke/@id">@row.BranchName</a> }
                    else { <span>@row.BranchName</span> }
                    <div class="tree-path"><span class="code-value">@(row.BranchCode ?? "brez šifre")</span> · @(row.FromCatalog ? "iz šifranta strank" : "ročno vpisana")</div>
                  </td>
                  <td>@(row.Note ?? "—")</td>
                  <td>@row.CreatedBy</td>
                  <td>@row.CreatedUtc.ToPimLocal().ToString("g")</td>
                </tr>
              }
            </Rows>
          </PimTable>
        </PimState>
      </section>

      <section class="ui-card panel section-gap">
        <h2>Dodaj enoto</h2>
        <div class="form-grid">
          <label class="form-field">Vrsta
            <select class="filter-select" @bind="BranchKind">
              <option value="PE">Poslovna enota</option>
              <option value="TRANZIT">Tranzit</option>
            </select>
          </label>
          <label class="form-field">Iz šifranta strank
            <select class="filter-select" @bind="BranchCustomerKey">
              <option value="">— vpiši na novo —</option>
              @foreach (var candidate in BranchCandidates)
              {
                <option value="@candidate.CustomerId">@candidate.Name (@candidate.CustomerKey)</option>
              }
            </select>
          </label>
          <label class="form-field">Šifra (ročni vnos)<input class="form-input" @bind="BranchCode" disabled="@(BranchCustomerKey.Length > 0)" /></label>
          <label class="form-field">Naziv (ročni vnos)<input class="form-input" @bind="BranchName" disabled="@(BranchCustomerKey.Length > 0)" /></label>
          <label class="form-field">Opomba<input class="form-input" @bind="BranchNote" /></label>
          <div class="form-action"><button type="button" class="primary-button" disabled="@Busy" @onclick="SaveBranchAsync">Dodaj</button></div>
        </div>
      </section>
    </section>

    <section id="panel-notes" role="tabpanel" aria-labelledby="tab-notes" hidden="@(Section != "notes")">
      <section class="ui-card panel">
        <h2>Nov zaznamek</h2>
        <p class="card-note">Zaznamki so vidni vsem uporabnikom skupaj z imenom avtorja. Zapisanega zaznamka ni mogoče spremeniti.</p>
        <textarea class="form-input note-input" rows="4" placeholder="Opomba o stranki …" @bind="NoteBody"></textarea>
        <div class="panel-actions"><button type="button" class="primary-button" disabled="@(Busy || NoteBody.Trim().Length == 0)" @onclick="AddNoteAsync">Zapiši zaznamek</button></div>
      </section>

      <section class="ui-card data-card section-gap">
        <PimState Empty="@(Card.Notes.Count == 0)" EmptyText="Za to stranko še ni zaznamkov.">
          <ul class="note-list">
            @foreach (var note in Card.Notes)
            {
              <li class="note-entry">
                <div class="note-head"><strong>@note.CreatedBy</strong><span>@note.CreatedUtc.ToPimLocal().ToString("g")</span></div>
                <p>@note.Body</p>
              </li>
            }
          </ul>
        </PimState>
      </section>
    </section>

    <section id="panel-history" role="tabpanel" aria-labelledby="tab-history" hidden="@(Section != "history")">
      <section class="ui-card data-card">
        <PimState Empty="@(Card.History.Count == 0)" EmptyText="Za to stranko še ni zabeleženih sprememb.">
          <PimTable Caption="Revizijska sled sprememb stranke" Columns="HistoryColumns">
            <Rows>
              @foreach (var row in Card.History)
              {
                <tr><td>@row.EntityType</td><td>@row.ActionCode</td><td class="wrap-cell">@Short(row.OldValueJson)</td><td class="wrap-cell">@Short(row.NewValueJson)</td><td>@row.ChangedBy</td><td>@row.ChangedUtc.ToPimLocal().ToString("g")</td></tr>
              }
            </Rows>
          </PimTable>
        </PimState>
      </section>
    </section>

    <section id="panel-documents" role="tabpanel" aria-labelledby="tab-documents" hidden="@(Section != "documents")">
      <PimMissing Object="pim.CustomerDocument in pim.CustomerFinance"
                  What="dokumenti stranke (pogodbe, izjave) ter finančni podatki (odprte postavke, limit, plačilna disciplina)"
                  Needs="odločitev, kateri vir jih prinese — SAOP finančni moduli ali ločen zajem" />
    </section>

      </div>
    </div>

    @if (Message is not null) { <p class="message-state info-message" role="status">@Message</p> }
    @if (SaveError is not null) { <p class="message-state error-message" role="alert">@SaveError</p> }
  }
</PimState>

@code {
  [Parameter] public long CustomerId { get; set; }

  sealed record Tab(string Key, string Label, int? Count = null);
  sealed record KindOption(string Code, string Label);

  /// <summary>Nepotrjene spremembe spletnega profila; obrazec ne piše v bralni model.</summary>
  sealed class ProfileDraft
  {
    public string? TypeCode { get; set; }
    public string? Kind { get; set; }
    public bool Packaging { get; set; }
    public bool ValueDiscount { get; set; }
    public bool Plus { get; set; }
    public bool Web { get; set; }
    public DateTime? PlusFrom { get; set; }
    public DateTime? PlusTo { get; set; }
  }

  CustomerCard? Card;
  IReadOnlyList<PIM.Intranet.Services.CustomerTypeRow> Types = [];
  IReadOnlyList<PIM.Intranet.Services.CustomerListRow> AllCustomers = [];
  PIM.Intranet.Services.CustomerListRow? Role;
  string OrganizationName = "";
  ProfileDraft Draft = new();
  PIM.Intranet.Services.CustomerGeneralDraft GeneralDraft = new();
  int? OrganizationId;
  bool Loading = true;
  bool Busy;
  string? Error;
