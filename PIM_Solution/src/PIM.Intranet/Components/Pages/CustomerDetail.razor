  public static string KindLabel(string? value) =>
    Kinds.FirstOrDefault(kind => string.Equals(kind.Code, value, StringComparison.Ordinal))?.Label ?? "vrsta ni določena";

  static string CustomerInitials(string? name)
  {
    var parts = (name ?? "Stranka").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var initials = string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    return initials.Length > 0 ? initials : "S";
  }

  string ExportChipClass() => Role?.InCustomerExport == true ? "on" : "off";

  string ExportChipText() => Role?.InCustomerExport == true ? "V stranke.csv" : "Ni v stranke.csv";

  // Podnaslov pove vlogo, kot jo vidi seznam: rocna vrsta, ce obstaja, sicer izracun (250).
  string RoleSummary => Role is null ? KindLabel(Card?.General.CustomerKind) : $"{Role.RoleLabel} ({Role.RoleSourceLabel})";

  // Izdelki, kjer je ta stranka dobavitelj ali proizvajalec — v njenem podjetju, s sifro tega podjetja.
  string ProductsHref(string filter) =>
    $"izdelki?podjetje={OrganizationId}&{filter}={Uri.EscapeDataString(Card?.General.CustomerKey ?? "")}";

  protected override Task OnParametersSetAsync() => LoadAsync();

  async Task LoadAsync()
  {
    Loading = true; Error = null;
    try
    {
      // Podjetje pride iz stranke, ne iz »aktivne organizacije«: seznam kaze vsa podjetja (250),
      // prej pa je kartica vzela prvo (DEMO) in stranke drugega podjetja ni nasla.
      var organization = await Data.GetCustomerOrganizationAsync(CustomerId);
      if (organization is null) { Card = null; return; }
      OrganizationId = organization.OrganizationId;
      OrganizationName = organization.Name;
      Types = await Data.GetCustomerTypesAsync();
      AllCustomers = await CustomerList.GetAsync(organization.OrganizationId);
      Role = AllCustomers.FirstOrDefault(row => row.CustomerId == CustomerId);
      Card = await Cards.GetAsync(organization.OrganizationId, CustomerId);
      if (Card is null) return;
      Draft = new()
      {
        TypeCode = Card.General.CustomerTypeCode,
        Kind = Card.General.CustomerKind,
        Packaging = Card.General.PackagingDiscountEnabled,
        ValueDiscount = Card.General.ValueDiscountEnabled,
        Plus = Card.General.B2bPlusEnabled,
        Web = Card.General.WebEnabled,
        PlusFrom = Card.General.B2bPlusValidFrom,
        PlusTo = Card.General.B2bPlusValidTo,
      };
      // Obrazec ureja rocni prepis, ne ucinkovite vrednosti: sicer bi prvo shranjevanje
      // posnetek iz SAOP zapisalo kot rocno vrednost in izvor ne bi mogel vec popravljati.
      ContactEmail = Card.Contacts.ManualEmail ?? "";
      ContactPhone = Card.Contacts.ManualPhone ?? "";
      ContactMobile = Card.Contacts.ManualMobile ?? "";
      ContactPersons = Card.Contacts.ManualPersons ?? "";
      // Obrazec pokaze TRENUTNO (ucinkovito) vrednost, ne praznega polja - uporabnik vidi
      // podatek tak, kot je, in ga po potrebi popravi. Ce polja ne spremeni in shrani, bo
      // shranjena vrednost enaka trenutnemu SAOP izvoru in je procedura ne bo zapisala kot
      // rocni prepis (glej b2b.SaveCustomerGeneral) - obstojeci prepisi na drugih poljih
      // ostanejo nedotaknjeni, ker gredo skozi isto polje-za-polje primerjavo.
      var general = Card.General;
      GeneralDraft = new()
      {
        CustomerKey = general.CustomerKey, Name = general.Name,
        PayerCode = general.PayerCode, PayerName = general.PayerName,
        PriceListCode = general.PriceListCode, DiscountPriceListCode = general.DiscountPriceListCode,
        Address = general.Address, Street = general.Street, HouseNumber = general.HouseNumber,
        City = general.City, PostalCode = general.PostalCode, Country = general.Country,
        TaxNumber = general.TaxNumber, RegistrationNumber = general.RegistrationNumber,
        ActivityCode = general.ActivityCode, SubjectToVat = general.SubjectToVat,
        PaymentDays = general.PaymentDays, RebatePercent = general.RebatePercent,
        IsActive = general.IsActive, CustomerType = general.SourceCustomerType,
        LegalForm = general.LegalForm, IsDefaulter = general.IsDefaulter,
        UpfrontPayment = general.UpfrontPayment, LanguageId = general.LanguageId,
        CurrencyCode = general.CurrencyCode,
      };
    }
    catch { Error = "Kartice stranke trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  async Task<string> ActorAsync() =>
    (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";

  // "Brez prepisa" (null) je tretje stanje poleg da/ne, zato kljukica ne zadostuje - spustni
  // seznam z izpraznjeno vrednostjo za null je edini nacin, da ostane vidno locljivo od "ne".
  static string BoolDraftText(bool? value) => value switch { true => "true", false => "false", _ => "" };
  static bool? ParseBoolDraftText(string value) => value switch { "true" => true, "false" => false, _ => null };

  string GeneralSubjectToVatText { get => BoolDraftText(GeneralDraft.SubjectToVat); set => GeneralDraft.SubjectToVat = ParseBoolDraftText(value); }
  string GeneralUpfrontPaymentText { get => BoolDraftText(GeneralDraft.UpfrontPayment); set => GeneralDraft.UpfrontPayment = ParseBoolDraftText(value); }
  string GeneralIsDefaulterText { get => BoolDraftText(GeneralDraft.IsDefaulter); set => GeneralDraft.IsDefaulter = ParseBoolDraftText(value); }
  string GeneralIsActiveText { get => BoolDraftText(GeneralDraft.IsActive); set => GeneralDraft.IsActive = ParseBoolDraftText(value); }

  async Task SaveGeneralAsync()
  {
    if (OrganizationId is null) return;
    Busy = true; Message = null; SaveError = null;
    try
    {
      await Cards.SaveGeneralAsync(OrganizationId.Value, CustomerId, GeneralDraft, await ActorAsync());
      Message = "Splošni podatki so shranjeni in revizijsko zabeleženi.";
      await LoadAsync();
    }
    catch { SaveError = "Splošnih podatkov ni bilo mogoče shraniti."; }
    finally { Busy = false; }
  }

  /// <summary>Umik vseh rocnih prilagoditev splosnih podatkov; velja izvor iz SAOP, kjer obstaja.</summary>
  async Task ClearGeneralAsync()
  {
    if (OrganizationId is null) return;
    Busy = true; Message = null; SaveError = null;
    try
    {
      await Cards.SaveGeneralAsync(OrganizationId.Value, CustomerId, new PIM.Intranet.Services.CustomerGeneralDraft(), await ActorAsync());
      Message = "Ročne prilagoditve so umaknjene; velja vrednost iz SAOP, kjer obstaja.";
      await LoadAsync();
    }
    catch { SaveError = "Ročnih prilagoditev ni bilo mogoče umakniti."; }
    finally { Busy = false; }
  }

  async Task SaveProfileAsync()
  {
    if (Card is null || OrganizationId is null) return;
    Busy = true; Message = null; SaveError = null;
    try
    {
      var general = Card.General;
      var row = new PIM.Intranet.Services.CustomerDetailRow(
        general.CustomerId, general.CustomerKey, general.Name, general.PayerCode, general.PayerName,
        general.PriceListCode, general.DiscountPriceListCode, Draft.TypeCode, Draft.Kind,
        Draft.Packaging, Draft.ValueDiscount, Draft.Plus, Draft.PlusFrom, Draft.PlusTo, Draft.Web,
        general.MagentoGroupKey);
      await Data.SaveCustomerWebProfileAsync(OrganizationId.Value, row, await ActorAsync());
      Message = "Nastavitve stranke so shranjene in revizijsko zabeležene.";
      await LoadAsync();
    }
    catch { SaveError = "Nastavitev ni bilo mogoče shraniti."; }
    finally { Busy = false; }
  }

