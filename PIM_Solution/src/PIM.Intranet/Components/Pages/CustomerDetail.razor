  async Task AddNoteAsync()
  {
    if (OrganizationId is null || NoteBody.Trim().Length == 0) return;
    Busy = true; Message = null; SaveError = null;
    try
    {
      await Cards.AddNoteAsync(OrganizationId.Value, CustomerId, NoteBody.Trim(), await ActorAsync());
      NoteBody = "";
      Message = "Zaznamek je zapisan.";
      await LoadAsync();
    }
    catch { SaveError = "Zaznamka ni bilo mogoče zapisati."; }
    finally { Busy = false; }
  }

  async Task SaveBranchAsync()
  {
    if (OrganizationId is null) return;
    Busy = true; Message = null; SaveError = null;
    try
    {
      long? branchCustomerId = long.TryParse(BranchCustomerKey, out var parsed) ? parsed : null;
      await Cards.SaveBranchAsync(OrganizationId.Value, CustomerId, BranchKind, branchCustomerId,
        branchCustomerId is null ? BranchCode : null, branchCustomerId is null ? BranchName : null,
        BranchNote, await ActorAsync());
      BranchCustomerKey = ""; BranchCode = ""; BranchName = ""; BranchNote = "";
      Message = "Enota je dodana.";
      await LoadAsync();
    }
    catch { SaveError = "Enote ni bilo mogoče dodati. Enota iz šifranta mora biti stranka tega podjetja, ročna enota pa mora imeti naziv."; }
    finally { Busy = false; }
  }

  static string Day(DateTime? value) => value?.ToPimLocal().ToString("d") ?? "—";
  static string Short(string? value) =>
    string.IsNullOrWhiteSpace(value) ? "—" : value.Length <= 160 ? value : value[..160] + " …";
}
