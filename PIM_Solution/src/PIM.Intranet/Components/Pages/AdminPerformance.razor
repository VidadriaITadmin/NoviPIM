@page "/sistem/zmogljivost"
@attribute [Authorize(Roles = "ADMIN")]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.AdminConsoleService Nadzor

@*
  Kako hitro deluje posamezni del.

  Povprečje samo pove, da je nekaj hitro "v povprečju". Najdaljši zagon pove, kdaj sistem ne
  bo ujel svojega razmika — in prav to je tisto, kar odpove ponoči, ko nihče ne gleda. Zato
  sta v tabeli oba, poleg njiju pa razmik iz urnika: postopek, ki traja dlje od svojega
  razmika, se lovi sam s seboj in vsak naslednji zagon čaka na prejšnjega.
*@

<PageTitle>Zmogljivost postopkov</PageTitle>
<PimPage Title="Zmogljivost postopkov"
         Subtitle="Koliko zagonov, koliko jih pade in kako dolgo trajajo. Podatek je dejansko izmerjen, ne ocena."
         Crumbs="Crumbs">
  <Actions>
    <label class="visually-hidden" for="zmogljivost-obdobje">Obdobje</label>
    <select id="zmogljivost-obdobje" class="filter-select" @bind="Dni" @bind:after="NaloziAsync">
      <option value="1">Zadnji dan</option>
      <option value="7">Zadnjih 7 dni</option>
      <option value="30">Zadnjih 30 dni</option>
      <option value="90">Zadnjih 90 dni</option>
    </select>
  </Actions>
</PimPage>

@if (Prepocasni.Count > 0)
{
  <div class="message-state warn-message" role="status">
    @Prepocasni.Count @(Prepocasni.Count == 1 ? "postopek traja" : "postopkov traja") dlje od svojega razmika:
    @string.Join(", ", Prepocasni.Select(row => $"{row.Pipeline} ({row.OrganizationName})")).
    Naslednji zagon zato čaka na prejšnjega.
  </div>
}

<section class="ui-card data-card section-gap" aria-label="Zmogljivost postopkov">
  <PimState Loading="Loading" Error="@Error" Empty="@(Rows.Count == 0)"
            EmptyText="V izbranem obdobju ni zabeleženih zagonov." LoadingText="Računam zmogljivost …">
    <PimTable Caption="Zagoni, uspešnost in trajanja po postopku" Columns="Stolpci">
      <Rows>
        @foreach (var vrstica in Rows)
        {
          <tr class="@(vrstica.FailedCount > 0 ? "row-alarm" : null)">
            <td><span class="code-value">@vrstica.Pipeline</span></td>
            <td>@(vrstica.OrganizationName ?? "—")</td>
            <td class="numeric">@vrstica.RunCount.ToString("N0")</td>
            <td class="numeric">
              @vrstica.SuccessShare.ToString("0.#") %
              @if (vrstica.FailedCount > 0)
              {
                <span class="muted"> (@vrstica.FailedCount.ToString("N0") padcev)</span>
              }
            </td>
            <td class="numeric">@PimTime.Duration(vrstica.AvgDurationMs)</td>
            <td class="numeric">
              @PimTime.Duration(vrstica.MaxDurationMs)
              @if (vrstica.OverrunsInterval) { <span class="drift-flag">čez razmik</span> }
            </td>
            <td class="numeric">@Razmik(vrstica.IntervalSeconds)</td>
            <td class="numeric">@vrstica.RowsRead.ToString("N0")</td>
            <td class="numeric">@vrstica.RowsFailed.ToString("N0")</td>
            <td class="nowrap">@PimTime.FormatWithAge(vrstica.LastStartedUtc)</td>
          </tr>
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

@code {
  IReadOnlyList<WorkerPerformanceRow> Rows = [];
  int Dni = 7;
  bool Loading = true;
  string? Error;

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Sistem", "sistem"), new("Zmogljivost postopkov")];
  static readonly IReadOnlyList<PimColumn> Stolpci =
  [
    new("Postopek"), new("Podjetje"), new("Zagonov", true), new("Uspešnost", true),
    new("Povprečno", true), new("Najdlje", true), new("Razmik", true),
    new("Prebranih vrstic", true), new("Padlih vrstic", true), new("Zadnjič"),
  ];

  protected override Task OnInitializedAsync() => NaloziAsync();

  async Task NaloziAsync()
  {
    Loading = true;
    Error = null;
    try { Rows = await Nadzor.GetPerformanceAsync(Dni); }
    catch { Error = "Zmogljivosti trenutno ni mogoče izračunati."; }
    finally { Loading = false; }
  }

  IReadOnlyList<WorkerPerformanceRow> Prepocasni => [.. Rows.Where(row => row.OverrunsInterval)];

  static string Razmik(int? seconds) => seconds is null ? "—"
    : seconds < 60 ? $"{seconds} s"
    : $"{seconds / 60} min";
}
