@page "/splet"
@attribute [Authorize]
@rendermode InteractiveServer
@inject GovernanceReadService Governance
@inject CatalogReadService Catalog
@inject IntranetDataService Data
@inject WebExportBuildService Exports
@inject AdminConsoleService AdminConsole

<PageTitle>Izhod na splet</PageTitle>
<PimPage Title="Izhod na splet" Subtitle="Datoteke, ki gredo na spletna mesta: kaj je v njih in kako jih dobiš." />

<div class="filter-bar section-gap">
  <label class="field-control"><span>Spletno mesto</span><select class="filter-select" value="@SelectedSite" @onchange="SiteChanged"><option value="">Vsa spletna mesta</option>@foreach (var site in Sites) { <option value="@site.WebSiteCode">@site.WebSiteName</option> }</select></label>
  <div class="page-actions"><a href="splet/izvoz">Pripravi izvoz</a> <a href="splet/katalog">Nadzor kataloga in odprodaje</a></div>
</div>

<PimState Loading="Loading" Error="@Error" Empty="false" LoadingText="Nalaganje spletnih izhodov …">

  @* G6 in G7: uporabnik 2026-08-28 — »bi oni dejansko CSV videli, ki ga bomo dali za splet in
     da si ga lahko potegnejo dol«, in »imeli bomo vec CSVjev za splet, artikli in pa stranke,
     tako da bi mogli oba omogociti za pogled«.

     Do migracije 142 je bila tu datoteka z diska iz mape WebExport:Directory. Zdaj datoteka
     nastane na zahtevo iz istih tabel in iste procedure (out.GetExportRows), kot jo zapise
     PIM.B2bWorker — predogled in datoteka, ki odide, torej ne moreta pokazati razlicne
     vsebine, mape pa ni treba nastavljati in deliti. *@
  <h2 class="section-title">Datoteke za splet</h2>
  <section class="ui-card data-card">
    @if (BuildableProfiles.Count == 0)
    {
      <PimMissing Object="out.ExportProfile"
                  What="izvozni profil za splet, iz katerega je mogoce sestaviti CSV"
                  Needs="aktiven profil s stolpci in znanim virom vrednosti (ValueSourceCode)" />
    }
    else
    {
      <PimTable Caption="Datoteke, ki gredo na spletno mesto" Columns="FileColumns">
        <Rows>
          @foreach (var profile in BuildableProfiles)
          {
            <tr class="@(SelectedProfileId == profile.ExportProfileId ? "is-open" : null)">
              <td><PimChip Text="@profile.ContentKind" Tone="@(profile.ContentKind == "Izdelki" ? "info" : null)" /></td>
              <td><span class="code-value">@FileNameFor(profile)</span></td>
              <td class="numeric">@(SelectedProfileId == profile.ExportProfileId && Preview is not null ? Preview.TotalCount.ToString("N0") : "—")</td>
              <td class="numeric">@profile.ColumnCount.ToString("N0")</td>
              <td>@LastRunSummary(profile)</td>
              <td>
                <button type="button" class="small-action" disabled="@PreviewLoading" @onclick="() => TogglePreviewAsync(profile)">
                  @(SelectedProfileId == profile.ExportProfileId ? "Skrij" : "Poglej")
                </button>
                <a class="small-action" href="@DownloadHref(profile)">Prenesi</a>
              </td>
            </tr>
            @if (SelectedProfileId == profile.ExportProfileId && Preview is not null)
            {
              <tr class="preview-row">
                <td colspan="6">
                  <div class="csv-preview" role="region" tabindex="0" aria-label="@($"Predogled datoteke {FileNameFor(profile)}")">
                    <table class="data-table csv-table">
                      <caption>Prvih @Preview.Rows.Count vrstic datoteke @FileNameFor(profile)</caption>
                      <thead><tr>@foreach (var column in Preview.Columns) { <th scope="col">@column</th> }</tr></thead>
                      <tbody>
                        @foreach (var row in Preview.Rows)
                        {
                          <tr>@foreach (var value in row) { <td>@value</td> }</tr>
                        }
                      </tbody>
                    </table>
                  </div>
                  @if (Preview.TotalCount > Preview.Rows.Count)
                  {
                    <p class="card-note">Predogled je odrezan pri @PreviewRows vrsticah; v datoteki jih bo @Preview.TotalCount.ToString("N0"). Celo datoteko dobiš s prenosom.</p>
                  }
                </td>
              </tr>
            }
          }
        </Rows>
      </PimTable>
      @if (PreviewError is not null)
      {
        <div class="note-panel">@PreviewError</div>
      }
      <p class="card-note">
        Urejanje datoteke tukaj ni mogoče in tudi ne bi imelo učinka: CSV nastane iz kataloga
        ob vsakem prenosu. Popravek zato sodi na kartico izdelka ali stranke, od koder pride
        v naslednjo datoteko.
      </p>
    }
  </section>

  <h2 class="section-title">Zgodovina dostav</h2>
  <section class="ui-card data-card">
    @if (RecentRuns.Count == 0)
    {
      <div class="note-panel">Za katalog.csv in stranke.csv v zadnjih 30 dneh še ni bilo zabeleženega izvoza.</div>
    }
    else
    {
      <PimTable Caption="Zadnji izvozi katalog.csv in stranke.csv" Columns="RunColumns">
        <Rows>
          @foreach (var run in RecentRuns)
          {
            <tr>
              <td>@FileNameForCode(run.ProfileCode)</td>
              <td>@run.StartedUtc.ToPimLocal().ToString("g")</td>
              <td><span class="status-chip @(run.Status == "Succeeded" ? "good" : run.Status == "Running" ? "warn" : "bad")">@run.Status</span></td>
              <td class="numeric">@(run.RowCountValue?.ToString("N0") ?? "—")</td>
              <td>@TriggerLabel(run.TriggeredBy)</td>
              <td>@(run.ErrorRedacted ?? "—")</td>
            </tr>
          }
        </Rows>
      </PimTable>
    }
  </section>
</PimState>

@code {
  static readonly IReadOnlyList<PimColumn> FileColumns =
    [new("Vsebina"), new("Datoteka"), new("Vrstic", true), new("Stolpcev", true), new("Zadnji izvoz"), new("Dejanje")];
  static readonly IReadOnlyList<PimColumn> RunColumns =
    [new("Datoteka"), new("Kdaj"), new("Status"), new("Vrstic", true), new("Sprožil"), new("Napaka")];

  // Zakaj izdelek ne pride do datoteke (blokirajoce zahteve, stolpci brez vira) ni vec tu —
  // uporabnik 2026-09-10: ta stran naj kaze samo, kaj JE v datoteki; razlog, zakaj kaksnega
  // izdelka ni, sodi na /kakovost (nivo Splet).

  /// <summary>Koliko vrstic pokaze predogled; cela datoteka jih ima lahko 100.000.</summary>
  const int PreviewRows = 1000;

  /// <summary>
  /// Uporabnik 2026-09-10: »zakaj imava toliko csvjev, ce pa imava samo dva — katalog.csv in
  /// stranke.csv«. Register out.ExportProfile ima vec profilov na kanal MAGENTO (produkti,
  /// stranke, hitra osvezitev cen/zaloge) in poleg tega se B2B/legacy profile — vsi so tehnicno
  /// "na zahtevo gradljivi", zato jih je stran prej nastela vseh pet. Ta stran zdaj namenoma
  /// kaze samo ta dva — dejanski par, ki ga PIM.B2bWorker izvozi na splet (MagentoProductSchema /
  /// MagentoCustomerSchema) — z imenoma, kot ju vidi uporabnik, ne kodo profila.
  /// </summary>
  static readonly (string ProfileCode, string FileName)[] CatalogFiles =
  [
    ("MAGENTO_PRODUCTS", "katalog.csv"),
    ("MAGENTO_CUSTOMERS", "stranke.csv"),
  ];

  int? SelectedProfileId;
  bool PreviewLoading;
  string? PreviewError;
  WebExportPage? Preview;
  IReadOnlyList<WebSiteRow> Sites = [];
  IReadOnlyList<ExportProfileRow> Profiles = [];
  IReadOnlyList<ExportRunRow> RecentRuns = [];
  int? OrganizationId;
  string SelectedSite = "";
  bool Loading = true;
  string? Error;

  /// <summary>Samo katalog in stranke, in samo ce sta v registru se aktivna — drugim gumba ne ponudimo.</summary>
  IReadOnlyList<ExportProfileRow> BuildableProfiles => CatalogFiles
    .Select(entry => Profiles.FirstOrDefault(profile => profile.ProfileCode == entry.ProfileCode))
    .Where(profile => profile is not null && profile.IsActive)
    .Select(profile => profile!)
    .ToArray();

  static string FileNameFor(ExportProfileRow profile) =>
    CatalogFiles.FirstOrDefault(entry => entry.ProfileCode == profile.ProfileCode).FileName ?? profile.ProfileCode;
  static string FileNameForCode(string profileCode) =>
    CatalogFiles.FirstOrDefault(entry => entry.ProfileCode == profileCode).FileName ?? profileCode;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var org = (await Data.GetOrganizationsAsync()).SingleOrDefault(value => value.OrganizationId == 2);
      if (org is null) { Error = "Aktivna organizacija ni na voljo."; return; }
      OrganizationId = org.OrganizationId;
      Sites = await Catalog.GetWebSitesAsync();
      Profiles = await Governance.GetExportProfilesAsync();
      // Vsi zadnji zagoni obeh profilov, cez vsa podjetja (procedura filtra po podjetju ne
      // pozna) — tu se prikaze samo tisti del, ki sodi k aktivnemu podjetju.
      var allRuns = await AdminConsole.GetExportRunsAsync(days: 30, profileCode: null, take: 200);
      RecentRuns = allRuns
        .Where(run => run.OrganizationId == OrganizationId
          && CatalogFiles.Any(entry => entry.ProfileCode == run.ProfileCode))
        .OrderByDescending(run => run.StartedUtc)
        .ToArray();
    }
    catch { Error = "Spletnih izhodov trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  /// <summary>Uporabnik 2026-09-10: »dodaj, kdaj je bilo zadnjič izvoženo«.</summary>
  string LastRunSummary(ExportProfileRow profile)
  {
    var last = RecentRuns.FirstOrDefault(run => run.ProfileCode == profile.ProfileCode);
    if (last is null) return "še nikoli";
    var when = PimFormat.Ago(last.EndedUtc ?? last.StartedUtc);
    return last.Status switch
    {
      "Succeeded" => $"{when} ({TriggerLabel(last.TriggeredBy)})",
      "Running" => $"teče že {when}",
      _ => $"{when} — napaka",
    };
  }

  static string TriggerLabel(string triggeredBy) => triggeredBy switch
  {
    "Scheduler" or "Task" => "urnik",
    _ => "ročno",
  };

  void SiteChanged(ChangeEventArgs args) => SelectedSite = args.Value?.ToString() ?? "";

  async Task TogglePreviewAsync(ExportProfileRow profile)
  {
    if (SelectedProfileId == profile.ExportProfileId) { SelectedProfileId = null; Preview = null; PreviewError = null; return; }
    if (OrganizationId is null) return;

    SelectedProfileId = profile.ExportProfileId;
    Preview = null; PreviewError = null; PreviewLoading = true;
    try
    {
      Preview = await Exports.PreviewAsync(OrganizationId.Value, profile.ExportProfileId,
        SiteFilterFor(profile), profile.OnlyPublishedDefault, search: null, skip: 0, take: PreviewRows);
    }
    catch
    {
      SelectedProfileId = null;
      PreviewError = $"Predogleda datoteke {FileNameFor(profile)} trenutno ni mogoče pripraviti.";
    }
    finally { PreviewLoading = false; }
  }

  /// <summary>Spletno mesto je filter izdelkov; pri strankah nima pomena in bi izvoz izpraznil.</summary>
  string? SiteFilterFor(ExportProfileRow profile) =>
    profile.ContentKind == "Izdelki" && SelectedSite.Length > 0 ? SelectedSite : null;

  string DownloadHref(ExportProfileRow profile) => "izvoz/splet-na-zahtevo?" + string.Join('&', new[]
  {
    $"podjetje={OrganizationId}", $"profil={profile.ExportProfileId}",
    $"koda={Uri.EscapeDataString(profile.ProfileCode)}",
    $"ime={Uri.EscapeDataString(FileNameFor(profile))}",
    $"objavljeni={profile.OnlyPublishedDefault.ToString().ToLowerInvariant()}",
    $"spletisce={Uri.EscapeDataString(SiteFilterFor(profile) ?? string.Empty)}"
  });

}
