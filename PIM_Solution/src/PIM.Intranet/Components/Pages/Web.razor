@page "/splet"
@attribute [Authorize]
@rendermode InteractiveServer
@inject GovernanceReadService Governance
@inject CatalogReadService Catalog
@inject IntranetDataService Data
@inject WebExportFileService Exports

<PageTitle>Izhod na splet</PageTitle>
<PimPage Title="Izhod na splet" Subtitle="Datoteke, ki gredo na spletna mesta: kaj je v njih, kaj ne pride skozi in zakaj." />

<div class="filter-bar section-gap">
  <label class="field-control"><span>Spletno mesto</span><select value="@SelectedSite" @onchange="SiteChangedAsync"><option value="">Vsa spletna mesta</option>@foreach (var site in Sites) { <option value="@site.WebSiteCode">@site.WebSiteName</option> }</select></label>
</div>

<PimState Loading="Loading" Error="@Error" Empty="false" LoadingText="Nalaganje spletnih izhodov …">
  <section class="kpi-grid" aria-label="Pripravljenost spletnega izvoza">
    <PimStat Label="Gre na splet" Value="@ValidWeb.ToString("N0")" Note="brez blokirajoče spletne napake" />
    <PimStat Label="Ne gre" Value="@WebSummary.AffectedProductCount.ToString("N0")" Note="ista množica kot nivo SPLET na Kakovosti" Href="@IssueHref()" />
    <PimStat Label="Gre, a z odprto težavo" Value="@Number(Readiness?.Totals.PublishedWithOpenIssues)" Href="kakovost/napake?nivo=SPLET&resnost=WARNING" />
    <PimStat Label="Stolpcev brez vira" Value="@FilteredCoverage.Sum(profile => profile.UnmappedColumnCount).ToString("N0")" Note="stolpec brez vira ostane prazen" />
  </section>

  <h2 class="section-title">Zakaj izdelek ne pride do datoteke</h2>
  <section class="ui-card data-card">
    <PimTable Caption="Spletne zahteve, ki blokirajo izvoz" Columns="ReasonColumns">
      <Rows>
        @foreach (var reason in FilteredReasons)
        {
          <tr><td><a href="@IssueHref(reason)"><span class="code-value">@reason.FieldCode</span></a></td><td>@reason.ProfileCode</td><td><PimChip Text="Splet" Tone="warn" Prefix="Blokira: " /></td><td class="numeric">@reason.ProductCount.ToString("N0")</td></tr>
        }
      </Rows>
    </PimTable>
    @if (FilteredReasons.Count == 0) { <div class="note-panel">Za izbrano spletno mesto ni zabeleženega blokirajočega razloga.</div> }
  </section>

  <h2 class="section-title">Stolpci profila brez vira</h2>
  <section class="ui-card data-card">
    <PimTable Caption="Pokritost stolpcev spletnih profilov" Columns="CoverageColumns">
      <Rows>
        @foreach (var profile in FilteredCoverage)
        {
          <tr><td>@profile.ProfileCode</td><td class="numeric">@profile.ColumnCount.ToString("N0")</td><td class="numeric">@profile.MappedColumnCount.ToString("N0")</td><td class="numeric">@profile.UnmappedColumnCount.ToString("N0")</td><td><PimBar Percent="@Coverage(profile)" Label="@($"Pokritost {profile.ProfileCode}")" /></td></tr>
        }
      </Rows>
    </PimTable>
  </section>

  <h2 class="section-title">Izvozni profili tega spletnega mesta</h2>
  <section class="ui-card data-card">
    <PimTable Caption="Spletni izvozni profili" Columns="ProfileColumns">
      <Rows>
        @foreach (var profile in FilteredProfiles)
        {
          <tr><td><a href="izvozi/profili/@profile.ExportProfileId">@profile.Name</a><div class="tree-path">@profile.ProfileCode</div></td><td class="numeric">@profile.ColumnCount.ToString("N0")</td><td class="numeric">@profile.MappedColumnCount.ToString("N0")</td><td>—</td><td>—</td><td><a href="izvozi/profili/@profile.ExportProfileId">→</a></td></tr>
        }
      </Rows>
    </PimTable>
  </section>

  @* G6 in G7: uporabnik 2026-08-28 — »bi oni dejansko CSV videli, ki ga bomo dali za splet in
     da si ga lahko potegnejo dol«, in »imeli bomo vec CSVjev za splet, artikli in pa stranke,
     tako da bi mogli oba omogociti za pogled«. Prikazana je datoteka z diska, ki jo izdela
     PIM.B2bWorker in ki dejansko odide — ne drugi izvoz, sestavljen tu, ki bi lahko kazal
     drugacno vsebino od tiste, ki je odsla. *@
  <h2 class="section-title">Datoteke za splet</h2>
  <section class="ui-card data-card">
    @if (ExportDirectory is null)
    {
      <PimMissing Object="WebExport:Directory"
                  What="mapo, v katero PIM.B2bWorker zapiše magento-products.csv in magento-customers.csv"
                  Needs="nastavitev WebExport:Directory v appsettings.Local.json; dokler je ni, intranet ne ve, kje datoteke so" />
    }
    else if (ExportFiles.Count == 0)
    {
      <div class="note-panel">
        V mapi <span class="code-value">@ExportDirectory</span> ni nobene datoteke CSV.
        Izvoz izdela <span class="code-value">PIM.B2bWorker --export-magento</span>; dokler ne teče, tu ni česa prikazati.
      </div>
    }
    else
    {
      <PimTable Caption="Datoteke, ki gredo na spletno mesto" Columns="FileColumns">
        <Rows>
          @foreach (var file in ExportFiles)
          {
            <tr class="@(SelectedFile == file.FileName ? "is-open" : null)">
              <td><PimChip Text="@file.Kind" Tone="@(file.Kind == "Izdelki" ? "info" : null)" /></td>
              <td><span class="code-value">@file.FileName</span></td>
              <td class="numeric">@(file.RowCount < 0 ? "—" : file.RowCount.ToString("N0"))</td>
              <td class="numeric">@WebExportFileService.Size(file.SizeBytes)</td>
              <td>@file.ModifiedUtc.ToLocalTime().ToString("g")</td>
              <td>
                <button type="button" class="small-action" @onclick="() => TogglePreview(file.FileName)">
                  @(SelectedFile == file.FileName ? "Skrij" : "Poglej")
                </button>
                <a class="small-action" href="@($"izvoz/splet/{Uri.EscapeDataString(file.FileName)}")">Prenesi</a>
              </td>
            </tr>
            @if (SelectedFile == file.FileName && Preview is not null)
            {
              <tr class="preview-row">
                <td colspan="6">
                  <div class="csv-preview" role="region" tabindex="0" aria-label="@($"Predogled datoteke {file.FileName}")">
                    <table class="data-table csv-table">
                      <caption>Prvih @Preview.Rows.Count vrstic datoteke @file.FileName</caption>
                      <thead><tr>@foreach (var column in Preview.Columns) { <th scope="col">@column</th> }</tr></thead>
                      <tbody>
                        @foreach (var row in Preview.Rows)
                        {
                          <tr>@foreach (var value in row) { <td>@value</td> }</tr>
                        }
                      </tbody>
                    </table>
                  </div>
                  @if (Preview.Truncated)
                  {
                    <p class="card-note">Predogled je odrezan pri @WebExportFileService.PreviewRows vrsticah. Celo datoteko dobiš s prenosom.</p>
                  }
                </td>
              </tr>
            }
          }
        </Rows>
      </PimTable>
      <p class="card-note">
        Urejanje datoteke tukaj še ni mogoče: sprememba v CSV bi se ob naslednjem izvozu prepisala,
        ker CSV nastane iz kataloga. Popravek zato sodi na kartico izdelka ali stranke, od koder
        pride v naslednjo datoteko.
      </p>
    }
  </section>

  <h2 class="section-title">Zgodovina dostav</h2>
  <PimMissing Object="intranet.GetWebExportDeliveries" What="čas izdelave, profil, število vrstic, velikost, rezultat in cilj vsake spletne dostave" Needs="evidence iz PIM.B2bWorker in dostavnega transporta" />
</PimState>

@code {
  static readonly IReadOnlyList<PimColumn> ReasonColumns = [new("Zahteva"), new("Profil"), new("Blokira"), new("Izdelkov", true)];
  static readonly IReadOnlyList<PimColumn> CoverageColumns = [new("Profil"), new("Stolpcev", true), new("Z virom", true), new("Brez vira", true), new("Pokritost")];
  static readonly IReadOnlyList<PimColumn> ProfileColumns = [new("Profil"), new("Stolpcev", true), new("Pokritih", true), new("Zadnja datoteka"), new("Vrstic"), new("Podrobnost")];
  static readonly IReadOnlyList<PimColumn> FileColumns =
    [new("Vsebina"), new("Datoteka"), new("Vrstic", true), new("Velikost", true), new("Nastala"), new("Dejanje")];

  IReadOnlyList<WebExportFile> ExportFiles = [];
  string? ExportDirectory;
  string? SelectedFile;
  WebExportPreview? Preview;
  IReadOnlyList<WebSiteRow> Sites = [];
  IReadOnlyList<ExportProfileRow> Profiles = [];
  IReadOnlyList<ValidationProfileRow> ValidationProfiles = [];
  ExportReadiness? Readiness;
  ValidationLayerSummary WebSummary = new(PimValidationLayer.Splet, 0, 0);
  int? OrganizationId;
  string SelectedSite = "";
  bool Loading = true;
  string? Error;

  IReadOnlyList<ExportProfileRow> FilteredProfiles => Profiles.Where(IsWebProfile).Where(profile => SiteMatches(profile.ProfileCode, profile.ChannelCode)).ToArray();
  IReadOnlyList<ExportProfileCoverage> FilteredCoverage => (Readiness?.Profiles ?? []).Where(profile => IsWebProfile(profile.ChannelCode)).Where(profile => SiteMatches(profile.ProfileCode, profile.ChannelCode)).ToArray();
  IReadOnlyList<ExportBlockingReason> FilteredReasons => (Readiness?.Reasons ?? []).Where(reason => reason.BlocksWeb).Where(reason => SiteMatches(reason.ProfileCode, "")).ToArray();
  long ValidWeb => Math.Max(0, WebSummary.ProductCount - WebSummary.AffectedProductCount);

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var org = await Data.GetCurrentOrganizationAsync();
      if (org is null) { Error = "Aktivna organizacija ni na voljo."; return; }
      OrganizationId = org.OrganizationId;
      var sitesTask = Catalog.GetWebSitesAsync();
      var profilesTask = Governance.GetExportProfilesAsync();
      var validationTask = Governance.GetValidationProfilesAsync(org.OrganizationId);
      var readinessTask = Governance.GetExportReadinessAsync(org.OrganizationId);
      Sites = await sitesTask; Profiles = await profilesTask; ValidationProfiles = await validationTask; Readiness = await readinessTask;
      ExportDirectory = Exports.Directory;
      ExportFiles = Exports.List();
      await LoadSummaryAsync();
    }
    catch { Error = "Spletnih izhodov trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  async Task SiteChangedAsync(ChangeEventArgs args) { SelectedSite = args.Value?.ToString() ?? ""; await LoadSummaryAsync(); }
  async Task LoadSummaryAsync()
  {
    if (OrganizationId is null) return;
    WebSummary = (await Governance.GetValidationLayerSummariesAsync(OrganizationId.Value, ValidationProfiles, SelectedSite)).First(summary => summary.Layer == PimValidationLayer.Splet);
  }
  bool SiteMatches(string profileCode, string channel)
  {
    if (string.IsNullOrWhiteSpace(SelectedSite)) return true;
    static string Normalize(string value) => new(value.Where(char.IsLetterOrDigit).ToArray());
    return Normalize(profileCode + channel).Contains(Normalize(SelectedSite), StringComparison.OrdinalIgnoreCase);
  }
  static bool IsWebProfile(ExportProfileRow profile) => IsWebProfile(profile.ChannelCode);
  static bool IsWebProfile(string channel) => !channel.Contains("SAOP", StringComparison.OrdinalIgnoreCase) && !channel.Contains("ERP", StringComparison.OrdinalIgnoreCase);
  string IssueHref(ExportBlockingReason? reason = null)
  {
    var values = new List<string> { "nivo=SPLET" };
    if (!string.IsNullOrWhiteSpace(SelectedSite)) values.Add("spletisce=" + Uri.EscapeDataString(SelectedSite));
    if (reason is not null) { values.Add("profil=" + Uri.EscapeDataString(reason.ProfileCode)); values.Add("polje=" + Uri.EscapeDataString(reason.FieldCode)); }
    return "kakovost/napake?" + string.Join('&', values);
  }
  void TogglePreview(string fileName)
  {
    if (SelectedFile == fileName) { SelectedFile = null; Preview = null; return; }
    SelectedFile = fileName;
    Preview = Exports.Preview(fileName);
  }

  static decimal Coverage(ExportProfileCoverage profile) => profile.ColumnCount == 0 ? 0 : Math.Round(100m * profile.MappedColumnCount / profile.ColumnCount, 1);
  static string Number(long? value) => value is null ? "—" : value.Value.ToString("N0");
}
