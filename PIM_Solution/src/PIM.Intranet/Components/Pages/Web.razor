@page "/splet"
@attribute [Authorize]
@rendermode InteractiveServer
@inject MagentoArtifactService Artifacts
@inject AdminConsoleService AdminConsole
@inject QualityReadService Quality

<PageTitle>CSV za Magento</PageTitle>
<PimPage Title="CSV za Magento" Subtitle="Dejanski izhod PIM-a za IQLighting: katalog.csv in stranke.csv, ki ju bere Magento." />
<div class="page-actions section-gap">
  <button class="filter-button" disabled="@(Loading || PreviewLoading)" @onclick="LoadAsync">Osveži stanje</button>
  <a href="sistem/posel/WEB_CATALOG_EXPORT">Urnik in zagon: CSV za Magento</a>
  <a href="splet/katalog">Nadzor objave artiklov</a>
  <a href="splet/umaknjeni">Umaknjeni s spleta</a>
  <a href="kakovost/artikli?podjetje=2">Validacija artiklov</a>
  <a href="splet/izvoz">Predogled trenutnih podatkov PIM</a>
</div>
<p class="card-note">Izdelava CSV bere podatke v PIM-u in ima svoj cikel. Čas izdelave potrjuje nastanek datoteke; ne potrjuje, da jo je Magento že prebral. Popravki na karticah se prenesejo ob naslednji uspešni izdelavi.</p>
<PimState Loading="Loading" Error="@Error" Empty="false">
  @* 242: mapa in pravice so bile vzrok, da datoteki dneve nista nastajali; stran to pove pred prvim padcem. *@
  <section class="ui-card data-card section-gap">
    <h2>Izhodna mapa</h2>
    @if (Folder is null)
    {
      <p class="message-state error-message">Izhodne mape ni mogoče določiti. Preveri register EXPORT_ROOT na strani Mape in povezavo z bazo.</p>
    }
    else
    {
      <p><strong>@Folder.Root</strong> <span class="tree-path">vir: @Folder.Source</span></p>
      <p class="card-note">
        Mapa @(Folder.Exists ? "obstaja" : "NE obstaja") ·
        zapis iz tega procesa intraneta (račun @Folder.Account): @(Folder.WritableByThisProcess ? "mogoč" : "NI mogoč") ·
        dokončan par datotek: @(Folder.HasCompletePair ? "da" : "ne").
        Worker, ki datoteki izdela, lahko teče pod drugim računom (Windows naloga, storitev); zanj velja napaka zadnjega poskusa spodaj.
      </p>
      @if (!Folder.Exists || !Folder.WritableByThisProcess)
      {
        <p class="message-state error-message">Pravice do izhodne mape uredi kot skrbnik: <code>powershell -ExecutionPolicy Bypass -File scripts\Nastavi-pravice-izvozne-mape.ps1</code> (doda pravico spreminjanja računu nalog in bazenu IIS, nato preveri z -SamoPreveri). Do takrat vsak poskus izdelave pade, prejšnji veljavni par pa ostane.</p>
      }
    }
  </section>
  <section class="ui-card data-card section-gap">
    <table class="data-table"><caption>Dokončane datoteke za Magento</caption>
      <thead><tr><th>Datoteka</th><th>Dejanska datoteka</th><th>Zadnji poskus in zadnji uspeh izdelave</th><th>Dejanje</th></tr></thead>
      <tbody>@foreach (var code in Codes)
      {
        var artifact = Status.GetValueOrDefault(code);
        var attempt = Runs.FirstOrDefault(run => run.ProfileCode == code && (run.Status != "Succeeded" || run.Sha256 is not null || run.ByteCountValue is not null));
        var success = Runs.FirstOrDefault(run => run.ProfileCode == code && run.Status == "Succeeded" && (run.Sha256 is not null || run.ByteCountValue is not null));
        <tr>
          <td><strong>@MagentoArtifactService.FileName(code)</strong></td>
          <td>@if (artifact is not null)
          {
            <div>@artifact.PublishedUtc.ToPimLocal().ToString("g") · @PimFormat.Ago(artifact.PublishedUtc)</div>
            <div class="tree-path">@((artifact.Bytes / 1024d / 1024d).ToString("N1")) MB · generacija @artifact.Generation</div>
            @if (DateTime.UtcNow - artifact.PublishedUtc > TimeSpan.FromMinutes(StaleAfterMinutes)) { <PimChip Text="@($"Starejša od {StaleAfterMinutes} minut — preveri urnik")" Tone="warn" /> }
          }
          else { <span class="message-state error-message">@FileErrors.GetValueOrDefault(code)</span> }</td>
          <td>@if (attempt is not null)
          {
            <PimChip Text="@StatusLabel(attempt.Status)" Tone="@(attempt.Status == "Succeeded" ? "good" : attempt.Status == "Running" ? "warn" : "bad")" Prefix="Zadnji poskus: " />
            <div>@attempt.StartedUtc.ToPimLocal().ToString("g") · @Sprozilec(attempt.TriggeredBy) @attempt.Actor</div>
            @if (attempt.ErrorRedacted is not null) { <div class="error-message">@attempt.ErrorRedacted</div> }
            @if (attempt.Status != "Succeeded")
            {
              <div class="tree-path">Zadnji uspeh: @(success is null ? "nikoli" : $"{success.StartedUtc.ToPimLocal():g} · {PimFormat.Ago(success.StartedUtc)} · {success.RowCountValue?.ToString("N0")} vrstic")</div>
            }
          } else { <span>Ni zabeleženega poskusa.</span> }</td>
          <td>
            <button class="small-action" disabled="@(artifact is null || PreviewLoading)" @onclick="() => SelectAsync(code)">Preglej vsebino</button>
            @if (artifact is not null) { <a class="small-action" href="@($"izvoz/magento-datoteka/{code}")">Prenesi izdelano datoteko</a> }
          </td>
        </tr>
      }</tbody>
    </table>
  </section>
  @* 242: sestava kataloga po istih pravilih, po katerih nastane katalog.csv — koliko vrstic bo v datoteki in zakaj ostalih ni. *@
  <section class="ui-card data-card section-gap">
    <h2>Sestava kataloga (podjetje @WorkerCycles.CatalogOrganization) po izvoznih pravilih</h2>
    @if (SummaryLoading) { <p class="card-note">Računam sestavo kataloga …</p> }
    else if (SummaryError is not null) { <p class="message-state error-message">@SummaryError</p> }
    else if (Summary is { } s)
    {
      <div class="kpi-grid">
        <PimStat Label="Aktivni artikli" Value="@s.ActiveCount.ToString("N0")" />
        <PimStat Label="Objavljeni v PIM" Value="@s.PromotedCount.ToString("N0")" Note="po uspešni validaciji" />
        <PimStat Label="Vrstic v katalog.csv" Value="@s.InCsvCount.ToString("N0")" Href="kakovost/artikli?podjetje=2&stanje=IN_CSV" />
        <PimStat Label="Objavljeni na spletu" Value="@s.PublishedCount.ToString("N0")" Href="kakovost/artikli?podjetje=2&stanje=PUBLISHED" Note="s spletno stranjo" />
        <PimStat Label="Brez spletnega mesta" Value="@s.NoSiteCount.ToString("N0")" Href="kakovost/artikli?podjetje=2&stanje=NO_SITE" Note="v CSV samo kot odjava, če so bili prej na spletu" />
        <PimStat Label="Strank v stranke.csv" Value="@s.CustomerCount.ToString("N0")" />
      </div>
      <table class="data-table"><caption>Zakaj artikel ni v katalog.csv</caption>
        <thead><tr><th>Razlog</th><th>Artiklov</th><th>Pojasnilo</th></tr></thead>
        <tbody>
          <tr><td>@WebExportStates.Label(WebExportStates.NotPromoted)</td><td>@s.NotPromotedCount.ToString("N0")</td><td>@WebExportStates.Explain(WebExportStates.NotPromoted)</td></tr>
          <tr><td>@WebExportStates.Label(WebExportStates.NoCategory)</td><td>@s.NoCategoryCount.ToString("N0")</td><td>@WebExportStates.Explain(WebExportStates.NoCategory)</td></tr>
          <tr><td>@WebExportStates.Label(WebExportStates.BlockedErrors)</td><td>@s.BlockedErrorsCount.ToString("N0")</td><td>@WebExportStates.Explain(WebExportStates.BlockedErrors)</td></tr>
          <tr><td>@WebExportStates.Label(WebExportStates.Hold)</td><td>@s.HoldCount.ToString("N0")</td><td>@WebExportStates.Explain(WebExportStates.Hold)</td></tr>
          <tr><td>@WebExportStates.Label(WebExportStates.Excluded)</td><td>@s.ExcludedCount.ToString("N0")</td><td>@WebExportStates.Explain(WebExportStates.Excluded)</td></tr>
        </tbody>
      </table>
      <p class="card-note">Validacija: @s.StaleCount.ToString("N0") artiklov z zastarelo validacijo (starejša od 2 ur); najstarejša validacija @(s.OldestValidationUtc?.ToPimLocal().ToString("g") ?? "nikoli"). Števila veljajo za trenutno stanje baze; datoteka zgoraj je nastala ob svojem času in se lahko razlikuje do naslednje izdelave.</p>
    }
  </section>
  @if (Selected is not null)
  {
    <section class="ui-card data-card section-gap">
      <h2>@MagentoArtifactService.FileName(Selected): pregled vsebine</h2>
      <div class="filter-bar">
        <label class="field-control"><span>Šifra, EAN, naziv ali druga vrednost v CSV</span><input class="search-input" @bind="SearchDraft" /></label>
        <button class="filter-button" disabled="@PreviewLoading" @onclick="SearchAsync">Poišči v datoteki</button>
        <label><input type="checkbox" @bind="AllColumns" /> Vsi stolpci</label>
      </div>
      <PimState Loading="PreviewLoading" Error="@PreviewError" Empty="@(Preview?.Page.Rows.Count == 0)" EmptyText="V izdelani datoteki ni zadetkov.">
        @if (Preview is not null)
        {
          <p class="card-note">Generacija @Preview.Artifact.Generation · @Preview.Artifact.PublishedUtc.ToPimLocal().ToString("g") · @Preview.FileRows.ToString("N0") vrstic v datoteki · @Preview.Page.TotalCount.ToString("N0") zadetkov · @Preview.Page.Columns.Count stolpcev.</p>
          <p class="card-note">Prazne oznake spletnih mest lahko pomenijo umik artikla iz spletnih mest. Prisotnost vrstice v CSV sama ne pomeni dovoljenja za objavo.</p>
          <div class="csv-preview" role="region" tabindex="0" aria-label="Vsebina izdelanega CSV">
            <table class="data-table csv-table"><thead><tr>@foreach (var index in VisibleColumns) { <th>@Preview.Page.Columns[index]</th> }</tr></thead>
              <tbody>@foreach (var row in Preview.Page.Rows) { <tr>@foreach (var index in VisibleColumns) { <td>@row[index]</td> }</tr> }</tbody>
            </table>
          </div>
          <PimPager Skip="Preview.Page.Skip" Take="50" Total="Preview.Page.TotalCount" SkipChanged="PageAsync" />
        }
      </PimState>
    </section>
  }
  <section class="ui-card data-card section-gap">
    <h2>Zgodovina izdelave in ročnih prenosov</h2>
    <p class="card-note">Ročni prenos iz trenutne baze ne osveži datoteke za Magento. Uspešno izdelavo datoteke potrjuje zabeležen SHA-256 (oziroma velikost, kadar kontrolne vsote ni bilo mogoče prebrati).</p>
    <table class="data-table"><thead><tr><th>Datoteka</th><th>Čas</th><th>Izid</th><th>Vrstic</th><th>Vrsta</th><th>Sprožil</th><th>Napaka</th></tr></thead>
      <tbody>@foreach (var run in Runs.Take(30))
      { <tr><td>@MagentoArtifactService.FileName(run.ProfileCode)</td><td>@run.StartedUtc.ToPimLocal().ToString("g")</td><td>@StatusLabel(run.Status)</td><td>@(run.RowCountValue?.ToString("N0") ?? "—")</td><td>@(run.Sha256 is not null || run.ByteCountValue is not null ? "Izdelana datoteka" : run.Status == "Succeeded" ? "Prenos iz baze" : "Poskus")</td><td>@Sprozilec(run.TriggeredBy) @run.Actor</td><td>@(run.ErrorRedacted ?? "—")</td></tr> }</tbody>
    </table>
  </section>
</PimState>

@code {
  static readonly string[] Codes = ["MAGENTO_PRODUCTS", "MAGENTO_CUSTOMERS"];
  /// <summary>Cikel magento-csv teče vsakih 15 min (242) in izvoz traja minute; starost nad 30 min pomeni, da cikel ne teče ali pada.</summary>
  const int StaleAfterMinutes = 30;
  readonly Dictionary<string, MagentoArtifact> Status = [];
  readonly Dictionary<string, string> FileErrors = [];
  IReadOnlyList<ExportRunRow> Runs = [];
  MagentoOutputFolder? Folder;
  WebExportSummary? Summary;
  bool Loading = true, PreviewLoading, AllColumns, SummaryLoading;
  string? Error, Selected, PreviewError, SummaryError;
  string SearchDraft = "", AppliedSearch = "";
  MagentoArtifactPage? Preview;
  IEnumerable<int> VisibleColumns => Preview is null ? [] : Enumerable.Range(0, Preview.Page.Columns.Count)
    .Where(index => AllColumns || index < 8 || Preview.Page.Columns[index].Contains("splet", StringComparison.OrdinalIgnoreCase)
      || Preview.Page.Columns[index].Contains("zaloga", StringComparison.OrdinalIgnoreCase)
      || Preview.Page.Columns[index].Contains("cena", StringComparison.OrdinalIgnoreCase));
  static string StatusLabel(string status) => status switch { "Succeeded" => "Uspešno", "Failed" => "Napaka", "Running" => "V teku", "Abandoned" => "Zapuščen", _ => status };
  static string Sprozilec(string triggeredBy) => triggeredBy switch { "Scheduler" => "razporejevalnik", "Task" => "naloga", _ => "ročno" };
  protected override Task OnInitializedAsync() => LoadAsync();
  async Task LoadAsync()
  {
    Loading = true; Error = null; Status.Clear(); FileErrors.Clear(); Preview = null; Selected = null;
    try
    {
      try { Folder = await Artifacts.FolderAsync(); }
      catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or Microsoft.Data.SqlClient.SqlException) { Folder = null; }
      var runs = new List<ExportRunRow>();
      foreach (var code in Codes)
      {
        runs.AddRange(await AdminConsole.GetExportRunsAsync(30, code, 200));
        try { Status[code] = await Artifacts.StatusAsync(code); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException) { FileErrors[code] = ex is InvalidOperationException ? ex.Message : "Datoteka ni dosegljiva. Preveri izhodno mapo in pravice procesa."; }
      }
      Runs = runs.Where(run => run.OrganizationId == WorkerCycles.CatalogOrganization).OrderByDescending(run => run.StartedUtc).ToArray();
    }
    catch { Error = "Stanja izvoza ni mogoče prebrati. Preveri povezavo z bazo in dnevnik aplikacije."; }
    finally { Loading = false; }
    // Sestava kataloga je izračun nad vsemi aktivnimi artikli (nekaj sekund); ne sme zadrževati stanja datotek.
    _ = LoadSummaryAsync();
  }
  async Task LoadSummaryAsync()
  {
    SummaryLoading = true; SummaryError = null;
    await InvokeAsync(StateHasChanged);
    try { Summary = await Quality.GetWebExportSummaryAsync(WorkerCycles.CatalogOrganization); }
    catch { SummaryError = "Sestave kataloga ni mogoče izračunati. Preveri povezavo z bazo (migracija 242)."; }
    finally { SummaryLoading = false; await InvokeAsync(StateHasChanged); }
  }
  async Task SelectAsync(string code) { Selected = code; SearchDraft = AppliedSearch = ""; await PageAsync(0); }
  async Task SearchAsync() { AppliedSearch = SearchDraft.Trim(); await PageAsync(0); }
  async Task PageAsync(int skip)
  {
    if (Selected is null || PreviewLoading) return;
    PreviewLoading = true; PreviewError = null;
    var previous = Preview?.Artifact.Generation;
    Preview = null;
    try
    {
      Preview = await Artifacts.PreviewAsync(Selected, AppliedSearch, skip);
      if (skip > 0 && previous is not null && previous != Preview.Artifact.Generation)
        Preview = await Artifacts.PreviewAsync(Selected, AppliedSearch, 0);
    }
    catch { PreviewError = "Vsebine ni mogoče prebrati ali CSV ni veljaven. Osveži stanje in preveri zadnji izvoz."; }
    finally { PreviewLoading = false; }
  }
}
