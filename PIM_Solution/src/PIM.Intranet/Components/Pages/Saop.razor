@page "/saop"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IntranetDataService Data

<PageTitle>SAOP — pisanje nazaj</PageTitle>
<PimPage Title="SAOP — pisanje nazaj" Subtitle="Vsak zapis nazaj v ERP: stanje odobritve in dostave, odgovor ERP ter potrditev pri naslednji sinhronizaciji." />

<PimState Loading="Loading" Error="@Error" Empty="false" LoadingText="Nalaganje izhodov SAOP …">
  <section class="kpi-grid" aria-label="Stanje zapisov v SAOP">
    <PimStat Label="Čaka odobritev" Value="@Count("PendingApproval")" Href="outbound" />
    <PimStat Label="V vrsti" Value="@Count("Pending", "Retry")" Href="outbound" />
    <PimStat Label="Poslano, nepotrjeno" Value="@Count("Sent")" Note="HTTP uspeh še ni potrditev" Href="saop/zgodovina?stanje=Sent" />
    <PimStat Label="Potrjeno" Value="@Count("Verified", "Succeeded")" Href="saop/zgodovina?stanje=Verified" />
    <PimStat Label="Napake" Value="@Count("Error", "Dead")" Href="outbound" />
    <PimStat Label="Odkloni" Value="@Rows.Count(row => row.DriftDetail is not null).ToString("N0")" Href="saop/odkloni" />
  </section>

  <section class="hub-grid section-gap" aria-label="Delovne strani SAOP">
    <PimHubCard Title="Čakalna vrsta" Href="outbound" Description="Odobritev, preklic in ponovni poskus odhodnih sporočil." Count="@Count("PendingApproval", "Pending", "Retry")" />
    <PimHubCard Title="Zgodovina" Href="saop/zgodovina" Description="Ena vrstica na operacijo in odgovor ERP." />
    <PimHubCard Title="Odkloni" Href="saop/odkloni" Description="Poslana vrednost se ne ujema s tem, kar je vrnil ERP." Count="@Rows.Count(row => row.DriftDetail is not null).ToString("N0")" />
    <PimHubCard Title="Kaj sme nazaj" Href="saop/polja" Description="Bralni pregled dovoljenih polj in varnosti pisanja." />
    <PimHubCard Title="Množično urejanje" Href="izvozi/mnozicno" Description="Nadzorovano naročilo več sprememb z odobritvijo." />
    <PimHubCard Title="Obvestila" Href="izvozi/obvestila" Description="Napake in opozorila odhodnega toka." />
  </section>

  <section class="ui-card data-card section-gap" aria-label="SAOP po entitetah">
    <PimTable Caption="Stanje zapisovalnih poti po entitetah" Columns="Columns">
      <Rows>
        @foreach (var entity in Entities)
        {
          var entityRows = EntityRows(entity);
          var supported = IsSupported(entity, entityRows);
          <tr>
            <td><strong>@entity.Label</strong>@if (!supported) { <div class="tree-path">pot nazaj še ne obstaja</div> }</td>
            <td class="numeric">@Metric(entityRows, supported, "PendingApproval")</td>
            <td class="numeric">@Metric(entityRows, supported, "Pending", "Retry")</td>
            <td class="numeric">@Metric(entityRows, supported, "Sent")</td>
            <td class="numeric">@Metric(entityRows, supported, "Verified", "Succeeded")</td>
            <td class="numeric">@Metric(entityRows, supported, "Error", "Dead")</td>
            <td>@(supported ? entityRows.MaxBy(row => row.CreatedUtc)?.CreatedUtc.ToLocalTime().ToString("g") ?? "—" : "—")</td>
          </tr>
        }
      </Rows>
    </PimTable>
  </section>
</PimState>

<div class="note-panel section-gap"><strong>Pomembno:</strong> stanje <span class="code-value">Sent</span> pomeni poslano, nepotrjeno. Zeleno je šele <span class="code-value">Verified</span> oziroma potrjen uspeh.</div>

@code {
  sealed record EntityDefinition(string Label, string[] Keys);
  static readonly EntityDefinition[] Entities =
  [new("Artikli", ["PRODUCT", "ITEM", "ARTICLE"]), new("Cene", ["PRICE"]), new("Ceniki", ["PRICELIST", "PRICE_LIST"]), new("Stranke", ["CUSTOMER"]), new("Dokumenti", ["DOCUMENT", "ORDER"] )];
  static readonly IReadOnlyList<PimColumn> Columns = [new("Entiteta"), new("Čaka", true), new("V vrsti", true), new("Poslano", true), new("Potrjeno", true), new("Napake", true), new("Zadnji zapis")];
  IReadOnlyList<OutboundRow> Rows = [];
  bool Loading = true;
  string? Error;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var organization = await Data.GetCurrentOrganizationAsync();
      if (organization is null) { Error = "Aktivna organizacija ni na voljo."; return; }
      Rows = await Data.GetOutboundAsync(organization.OrganizationId);
    }
    catch { Error = "Stanja zapisov v SAOP trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  string Count(params string[] statuses) => Rows.LongCount(row => statuses.Contains(row.Status, StringComparer.OrdinalIgnoreCase)).ToString("N0");
  IReadOnlyList<OutboundRow> EntityRows(EntityDefinition entity) => Rows.Where(row => entity.Keys.Any(key => row.EntityType.Contains(key, StringComparison.OrdinalIgnoreCase) || row.TargetKind.Contains(key, StringComparison.OrdinalIgnoreCase))).ToArray();
  static bool IsSupported(EntityDefinition entity, IReadOnlyList<OutboundRow> rows) => entity.Label == "Artikli" || rows.Count > 0;
  static string Metric(IReadOnlyList<OutboundRow> rows, bool supported, params string[] statuses) => supported ? rows.LongCount(row => statuses.Contains(row.Status, StringComparer.OrdinalIgnoreCase)).ToString("N0") : "—";
}
