@page "/zajem/tezave"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PipelineReadService Pipeline
@inject IntranetDataService Data

<PageTitle>Težave vhodnih podatkov</PageTitle>
<PimPage Title="Težave vhodnih podatkov" Subtitle="Tehnične napake zajema na enem delovnem seznamu: čakalne strani, karantena, zavrnjena zaloga, mrtva pisma in sistemske napake. Ponavljajoči vzroki so združeni, ne prikazani tisočkrat." Crumbs="Crumbs" />
<IngestTabs Active="issues" />

<section class="ui-card toolbar" role="search" aria-labelledby="ingest-issues-filter-title">
  <h2 id="ingest-issues-filter-title" class="visually-hidden">Filtriranje težav vhodnih podatkov</h2>
  <label class="visually-hidden" for="ingest-issue-search">Poišči težavo</label>
  <input id="ingest-issue-search" type="search" class="search-input" placeholder="Vir, razlog ali podjetje …" @bind="Search" @bind:event="oninput" @onkeyup="OnKeyAsync" />
  <label class="visually-hidden" for="ingest-issue-organization">Podjetje</label>
  <select id="ingest-issue-organization" class="filter-select" @bind="Organization" @bind:after="ApplyAsync">
    <option value="">Vsa podjetja</option>
    @foreach (var organization in Organizations)
    {
      <option value="@organization.OrganizationId">@organization.Name</option>
    }
  </select>

  <label class="visually-hidden" for="ingest-issue-source">Vir</label>
  <select id="ingest-issue-source" class="filter-select" @bind="Source" @bind:after="ApplyAsync">
    <option value="">Vsi viri</option>
    @foreach (var source in Sources)
    {
      <option value="@source">@source</option>
    }
  </select>

  <label class="visually-hidden" for="ingest-issue-kind">Vrsta težave</label>
  <select id="ingest-issue-kind" class="filter-select" @bind="Kind" @bind:after="ApplyAsync">
    <option value="">Vse težave</option>
    <option value="INBOX">Čakalna vrsta in karantena</option>
    <option value="STOCK">Zavrnjena zaloga</option>
    <option value="DEADLETTER">Mrtva pisma</option>
    <option value="ERROR">Sistemske napake</option>
  </select>
  <button type="button" class="filter-button" @onclick="ApplyAsync">Uporabi filtre</button>
  <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>
</section>

<section class="ui-card data-card section-gap" aria-label="Seznam težav vhodnih podatkov">
  <PimState Loading="Loading" Error="@Error" Empty="@(Rows.Count == 0)" EmptyText="Za izbrane filtre ni težav." LoadingText="Nalaganje težav …">
    <PimTable Caption="Združene težave po viru in vzroku" Columns="Columns">
      <Rows>
        @foreach (var row in Rows)
        {
          <tr>
            <td><PimChip Text="@Severity(row.Severity)" Tone="@Tone(row.Severity)" Prefix="Resnost: " /></td>
            <td>
              <a href="zajem/tezave/@row.IssueKind/@row.IssueId"><strong>@row.Title</strong></a>
              <div class="issue-detail">@row.Detail</div>
            </td>
            <td>@row.OrganizationName</td>
            <td><span class="code-value">@row.SourceCode</span></td>
            <td class="numeric">@row.OccurrenceCount.ToString("N0")</td>
            <td>@row.FirstSeenUtc.ToPimLocal().ToString("g")</td>
            <td>@row.LastSeenUtc.ToPimLocal().ToString("g")</td>
            <td>
              @if (row.RunId is not null) { <a href="zajem/teki/@row.RunId">Odpri tek</a> }
              else { <span class="muted">—</span> }
            </td>
          </tr>
        }
      </Rows>
    </PimTable>
    <PimPager Skip="Skip" Take="Take" Total="Total" SkipChanged="OnSkipChangedAsync" Label="Strani težav vhodnih podatkov" />
  </PimState>
</section>

@code {
  [Parameter, SupplyParameterFromQuery(Name = "vrsta")] public string? RequestedKind { get; set; }

  IReadOnlyList<InboundIssueRow> Rows = [];
  IReadOnlyList<OrganizationContext> Organizations = [];
  IReadOnlyList<string> Sources = [];
  bool Loading = true;
  bool QueryApplied;
  string? Error;
  string Search = "";
  string Kind = "";
  // Prazen niz pomeni vsa podjetja. Tezava enega podjetja je pogosto vidna sele v primerjavi
  // z ostalimi, zato je privzeti obseg skupen.
  string Organization = "";
  string Source = "";
  int Skip;
  const int Take = 50;
  long Total;

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Vhodni podatki", "zajem"), new("Težave")];
  static readonly IReadOnlyList<PimColumn> Columns =
  [
    new("Resnost"), new("Težava"), new("Podjetje"), new("Vir"), new("Ponovitev", Numeric: true),
    new("Prvič"), new("Nazadnje"), new("Povezava"),
  ];

  int? OrganizationFilter => int.TryParse(Organization, out var value) ? value : null;

  protected override async Task OnInitializedAsync()
  {
    try { Organizations = await Data.GetOrganizationsAsync(); }
    catch { Organizations = []; }

    await LoadAsync();
  }

  protected override async Task OnParametersSetAsync()
  {
    if (!QueryApplied && !string.IsNullOrWhiteSpace(RequestedKind))
    {
      QueryApplied = true;
      Kind = RequestedKind.ToUpperInvariant();
      await LoadAsync();
    }
  }

  async Task LoadAsync()
  {
    Loading = true;
    Error = null;
    try
    {
      var scope = OrganizationFilter;
      var optionsTask = Pipeline.GetInboundFilterOptionsAsync(scope);
      var issuesTask = Pipeline.GetInboundIssuesAsync(scope, Kind, Search, Skip, Take, Source == "" ? null : Source);
      await Task.WhenAll(optionsTask, issuesTask);
      Sources = (await optionsTask).Sources;
      if (Source != "" && !Sources.Contains(Source)) Source = "";
      (Rows, Total) = await issuesTask;
    }
    catch { Error = "Težav vhodnih podatkov trenutno ni mogoče naložiti."; }
    finally { Loading = false; }
  }

  async Task ApplyAsync() { Skip = 0; await LoadAsync(); }
  async Task OnKeyAsync(KeyboardEventArgs args) { if (args.Key == "Enter") await ApplyAsync(); }
  async Task OnSkipChangedAsync(int skip) { Skip = skip; await LoadAsync(); }
  string ResultSummary => Loading ? "Nalaganje …" : Error is not null ? "Rezultati niso na voljo" : $"{Total:N0} skupin težav";
  static string Severity(string value) => value switch { "Critical" => "Kritično", "Error" => "Napaka", "Warning" => "Opozorilo", _ => value };
  static string? Tone(string value) => value switch { "Critical" or "Error" => "bad", "Warning" => "warn", _ => null };
}
