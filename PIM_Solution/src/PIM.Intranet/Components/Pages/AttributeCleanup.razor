@page "/nastavitve/atributi/ciscenje"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@implements IDisposable
@inject PIM.Intranet.Services.AttributeMappingService Attributes
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject PimWriteGuard Guard

@* Naloga #15 (lastnik 2026-09-29): »kateri atributi pomenijo isto … seznam kandidatov za združitev, s
   številom artiklov in primeri vrednosti; lastnik odloči, kaj se združi« in »uvoz naj besedilo lepo
   uredi (enote, presledki, velike začetnice)«. Pregled je za vse vloge; združitev izbranih parov (#48,
   migracija 319, lastnik 2026-09-29 »Grlo … angleško socket, pa še kej se najde«) sme samo CatalogWrite
   (ADMIN, CATALOG_EDITOR) — preverja servis, stran samo skrije gumbe. Nič se ne združi samodejno; vsaka
   združitev ima dnevnik prej/potem in povratek (Zgodovina združitev spodaj). Pravilo zapisa je vklopljeno z migracijo 314 (#49, lastnik
   2026-09-29 »Da«): zajem, katalog.csv in obstoječe vrednosti; tu je pregled ostanka in dnevnik poenotenj. *@

<PageTitle>Čiščenje atributov</PageTitle>
<PimPage Title="Čiščenje atributov" Subtitle="Predlogi, kateri atributi pomenijo isto (izbrane pare lahko združiš, s povratkom), in lep zapis vrednosti (vklopljen za uvoz, katalog.csv in obstoječe vrednosti)." Crumbs="Crumbs">
  <Actions>
    <a class="secondary-button" href="nastavitve/atributi">Register atributov</a>
  </Actions>
</PimPage>

<PimTabs Active="@View" Tabs="Tabs" Label="Pogledi čiščenja atributov" />

<p class="message-state info-message cleanup-note" role="status">
  @if (View == ViewPolish)
  {
    <span>Pravilo je <strong>vklopljeno</strong> (30. 9. 2026): novi uvozi (XML, SAOP) in katalog.csv vrednosti zapišejo lepo, obstoječe vrednosti so poenotene, vsaka sprememba je v dnevniku spodaj (prej, potem, kdaj). Tabela kaže samo, kar je bilo od takrat vpisano ročno (kartica, delovni list): v katalog.csv gre že lepo zapisano, v PIM pa ostane, kot je vpisano. Polja, ki gredo v SAOP (npr. Garancija), in enote (»Enota …«) pravilo pusti pri miru.</span>
  }
  else
  {
    <span>Seznam je predlog. Nič se ne združi samodejno: izbereš par, določiš, kateri atribut ostane, in potrdiš po predogledu (izdelki po podjetjih, trki). Opuščeni atribut se deaktivira, ne izbriše; vsako združitev lahko razveljaviš. Spremljevalni atributi »Enota …« niso v seznamu, ker po zasnovi pri vseh merah nosijo iste enote (mm, kg).</span>
  }
</p>

@if (View == ViewPolish)
{
  <section class="ui-card toolbar section-gap" role="search" aria-labelledby="polish-filter-title">
    <h2 id="polish-filter-title" class="visually-hidden">Filtriranje predogleda zapisa</h2>
    <label class="visually-hidden" for="polish-search">Išči po atributu ali vrednosti</label>
    <input id="polish-search" class="search-input cleanup-search" type="search" placeholder="Išči po atributu ali vrednosti" @bind="Search" @bind:after="SyncUrl" />
    <label class="visually-hidden" for="polish-attribute">Atribut</label>
    <select id="polish-attribute" class="filter-select" @bind="AttributeFilter" @bind:after="SyncUrl">
      <option value="">Vsi atributi (@(Polish?.Changes.Count ?? 0))</option>
      @foreach (var group in PolishAttributes)
      {
        <option value="@group.Name">@group.Name (@group.Count)</option>
      }
    </select>
    @if (HasFilters) { <button type="button" class="secondary-button" @onclick="ClearFiltersAsync">Počisti filtre</button> }
    <span class="result-count" role="status" aria-live="polite">@PolishSummary</span>
    <button type="button" class="secondary-button" disabled="@(FilteredPolish.Count == 0)" @onclick="ExportPolishAsync">Izvozi v Excel (@FilteredPolish.Count.ToString("N0"))</button>
    <button type="button" class="secondary-button" disabled="@PolishLoading" @onclick="RefreshPolishAsync" title="@ComputedTitle(Polish?.ComputedUtc)">Osveži</button>
  </section>

  @if (Polish is not null)
  {
    <section class="kpi-grid" aria-label="Obseg lepega zapisa">
      <PimStat Label="Različnih vrednosti" Value="@Polish.DistinctValues.ToString("N0")" Note="pregledanih parov atribut–vrednost" />
      <PimStat Label="Še ni lepo zapisano" Value="@Polish.Changes.Count.ToString("N0")" Note="različnih zapisov v PIM" />
      <PimStat Label="Vrstic pri izdelkih" Value="@Polish.Changes.Sum(row => row.Rows).ToString("N0")" Note="katalog.csv jih zapiše lepo" />
      <PimStat Label="Izračunano" Value="@Polish.ComputedUtc.ToPimLocal().ToString("HH:mm")" Note="@($"v {Polish.ElapsedMs / 1000.0:N1} s; velja 10 min, »Osveži« na novo")" />
    </section>
  }

  <details class="ui-card rule-help">
    <summary>Kaj pravilo naredi</summary>
    <ul>
      <li>najprej obstoječe poenotenje (presledki, »≥ 80« → »≥80«, decimalna pika, napetost, frekvenca, slovar ENOTNO);</li>
      <li>razpon brez presledkov: »30 - 50« → »30-50«;</li>
      <li>presledek za vejico v seznamu: »3CCT,IP65« → »3CCT, IP65«; decimalna »1,5« ostane število;</li>
      <li>presledek med številom in enoto: »50m« → »50 m«, »do 30m« → »do 30 m«, »10W« → »10 W«; »IP44«, »E27«, »GU10« ostanejo;</li>
      <li>velika začetnica samo pri čistem besedilu: »toplo bela« → »Toplo bela«; »LED«, »mm«, šifre iz SAOP in povezave ostanejo;</li>
      <li>pri miru pusti: napetost in frekvenco (imata svoje pravilo), polja, ki gredo v SAOP (Garancija), enote (»Enota …«) in vrednost, ki jo določa slovar ENOTNO.</li>
    </ul>
    <p class="card-note">Izjeme (npr. »5000K« naj ostane brez presledka) dodaš v <a href="pravila/slovar">slovar vrednosti</a> z jezikom ENOTNO: vrednost, ki je cilj slovarja, ostane, kot jo zapišeš, tudi v katalog.csv.</p>
  </details>

  <section class="ui-card data-card section-gap" aria-label="Predogled zapisa vrednosti">
    <PimState Loading="PolishLoading" Error="@Error" Empty="@(FilteredPolish.Count == 0)" EmptyText="@(HasFilters ? "Za ta filter ni vrednosti, ki bi jih pravilo zapisalo drugače. Počisti filtre." : "Vse vrednosti so lepo zapisane. Nove ročne vnose pravilo uredi ob izvozu katalog.csv.")" LoadingText="Pregledujem vse različne vrednosti (približno 10 s) …">
      <PimTable Caption="Vrednosti v PIM, ki jih pravilo zapiše drugače (prej in potem; v katalog.csv gredo že lepo)" Columns="PolishColumns">
        <Rows>
          @foreach (var row in FilteredPolish.Take(PolishTake))
          {
            <tr>
              <td>@row.AttributeCode</td>
              <td><span class="value-before">@row.OldValue</span></td>
              <td><span class="value-after">@row.NewValue</span></td>
              <td class="numeric">@row.Rows.ToString("N0")</td>
              <td class="numeric">@row.Products.ToString("N0")</td>
            </tr>
          }
        </Rows>
      </PimTable>
      @if (FilteredPolish.Count > PolishTake)
      {
        <p class="card-note table-more">Prikazanih je prvih @PolishTake.ToString("N0") od @FilteredPolish.Count.ToString("N0"). Izvoz v Excel vsebuje vse. <button type="button" class="small-action" @onclick="() => PolishTake += 500">Pokaži še 500</button></p>
      }
    </PimState>
  </section>

  <section class="ui-card data-card section-gap" aria-labelledby="normalization-log-title">
    <h2 id="normalization-log-title" class="log-title">Dnevnik poenotenj</h2>
    <p class="card-note">Vsaka sprememba obstoječih vrednosti je zapisana: podjetje, šifra, atribut, prej, potem in kdaj. Povratek (vrne samo vrednosti, ki jih od takrat nihče ni spremenil) naredi skrbnik baze s postopkom <code>pim.RevertAttributeValueNormalization</code>; tudi povratek se zapiše sem.</p>
    <PimState Loading="RunsLoading" Error="@RunsError" Empty="@(Runs.Count == 0)" EmptyText="Dnevnik je prazen: poenotenje obstoječih vrednosti še ni teklo." LoadingText="Berem dnevnik …">
      <PimTable Caption="Poenotenja vrednosti atributov (najnovejše najprej)" Columns="RunColumns">
        <Rows>
          @foreach (var run in Runs)
          {
            <tr>
              <td>@RunLabel(run.ChangedBy)</td>
              <td>@run.LastUtc.ToPimLocal().ToString("d. M. yyyy HH:mm")</td>
              <td class="numeric">@run.Rows.ToString("N0")</td>
              <td class="numeric">@run.Products.ToString("N0")</td>
              <td class="numeric">@run.Organizations.ToString("N0")</td>
              <td><button type="button" class="small-action" disabled="@(ExportingRun is not null)" aria-label="@($"Izvozi dnevnik {run.ChangedBy} v Excel")" @onclick="() => ExportRunAsync(run.ChangedBy)">@(ExportingRun == run.ChangedBy ? "Pripravljam …" : "Izvozi v Excel")</button></td>
            </tr>
          }
        </Rows>
      </PimTable>
    </PimState>
  </section>
}
else
{
  <section class="ui-card toolbar section-gap" role="search" aria-labelledby="duplicate-filter-title">
    <h2 id="duplicate-filter-title" class="visually-hidden">Filtriranje kandidatov za združitev</h2>
    <label class="visually-hidden" for="duplicate-search">Išči po imenu atributa</label>
    <input id="duplicate-search" class="search-input cleanup-search" type="search" placeholder="Išči po imenu atributa" @bind="Search" @bind:after="SyncUrl" />
    <label class="visually-hidden" for="duplicate-kind">Vrsta predloga</label>
    <select id="duplicate-kind" class="filter-select" @bind="KindFilter" @bind:after="SyncUrl">
      <option value="">Vse vrste (@(Report?.Candidates.Count ?? 0))</option>
      @foreach (var kind in Kinds)
      {
        <option value="@kind.Key">@kind.Label (@KindCount(kind.Key))</option>
      }
    </select>
    <label class="visually-hidden" for="duplicate-sort">Razvrsti</label>
    <select id="duplicate-sort" class="filter-select" @bind="Sort" @bind:after="SyncUrl">
      <option value="">Najmočnejši predlog najprej</option>
      <option value="izdelki">Največ izdelkov najprej</option>
      <option value="ime">Po imenu atributa</option>
    </select>
    @if (HasFilters) { <button type="button" class="secondary-button" @onclick="ClearFiltersAsync">Počisti filtre</button> }
    <span class="result-count" role="status" aria-live="polite">@DuplicateSummary</span>
    <button type="button" class="secondary-button" disabled="@(FilteredCandidates.Count == 0)" @onclick="ExportDuplicatesAsync">Izvozi v Excel (@FilteredCandidates.Count.ToString("N0"))</button>
    <button type="button" class="secondary-button" disabled="@DuplicateLoading" @onclick="RefreshDuplicatesAsync" title="@ComputedTitle(Report?.ComputedUtc)">Osveži</button>
  </section>

  @if (Result is not null)
  {
    <div class="message-state success-message merge-result" role="status">
      <span>@Result</span>
      @if (IsAdmin) { <a class="small-action" href="sistem/sled">Sled sprememb</a> }
      <button type="button" class="small-action" @onclick="() => Result = null">Zapri</button>
    </div>
  }
  @if (MergeError is not null)
  {
    <p class="message-state error-message" role="alert">@MergeError</p>
  }

  <PimBulkBar Count="Selection.Count" AllMatching="false" MatchingTotal="MergeableFiltered.Count"
              PageSelected="Selection.AllSelected(MergeableFiltered.Select(PairKey))" PageRowCount="MergeableFiltered.Count"
              OnPageChanged="SelectAllPairs" OnSelectAllMatching="() => SelectAllPairs(true)" OnClear="ClearSelection"
              AriaLabel="Izbira parov in združevanje" Hint="Označi pare, ki pomenijo isto, in jih združi v enega.">
    @if (CanWrite)
    {
      <button type="button" class="primary-button" disabled="@Merging" @onclick="() => OpenMergeAsync(SelectedPairs)">Združi v … (@Selection.Count.ToString("N0"))</button>
    }
    else
    {
      <span class="bulk-readonly" role="status">Samo za branje: pare združuje skrbnik ali urednik kataloga.</span>
    }
  </PimBulkBar>

  @if (CanWrite && Plans.Count > 0)
  {
    <section class="ui-card merge-panel" role="dialog" aria-modal="false" aria-labelledby="merge-title" aria-describedby="merge-help">
      <div class="merge-head">
        <h2 id="merge-title">@MergeTitle</h2>
        <button type="button" class="small-action" disabled="@Merging" @onclick="CloseMerge">Zapri</button>
      </div>
      <p id="merge-help" class="card-note">Izberi, kateri atribut ostane. Vrednosti opuščenega preidejo nanj; kjer imata izdelka različni vrednosti, <strong>ostane vrednost atributa, ki ostane</strong> (trk je zapisan in se da vrniti). Opuščeni atribut se deaktivira, ne izbriše. V SAOP ne gre nič.</p>
      @if (OverlapMessage is not null)
      {
        <p class="message-state warn-message" role="alert">@OverlapMessage</p>
      }
      @foreach (var plan in Plans)
      {
        <fieldset class="merge-pair" disabled="@Merging">
          <legend>@plan.First.Name · @plan.Second.Name</legend>
          <div class="merge-choice" role="radiogroup" aria-label="@($"Kateri atribut ostane ({plan.First.Name} ali {plan.Second.Name})")">
            <span class="merge-label">Ostane</span>
            @foreach (var option in new[] { plan.First, plan.Second })
            {
              <label class="merge-radio">
                <input type="radio" name="@($"keep-{plan.Id}")" checked="@(plan.KeepCode == option.AttributeCode)"
                       @onchange="() => ChangeKeepAsync(plan, option.AttributeCode!)" />
                <span>@option.Name <span class="attribute-meta">(@option.Products.ToString("N0") izdelkov)</span></span>
              </label>
            }
          </div>
          <label class="form-field merge-english" for="@($"english-{plan.Id}")">
            Angleško ime atributa, ki ostane
            <input id="@($"english-{plan.Id}")" class="form-input" maxlength="200" @bind="plan.EnglishName" @bind:event="oninput"
                   placeholder="npr. Socket" aria-describedby="@($"english-help-{plan.Id}")" />
            <span id="@($"english-help-{plan.Id}")" class="attribute-meta">@EnglishHelp(plan)</span>
          </label>
          @if (plan.Loading)
          {
            <p class="card-note" role="status">Računam predogled …</p>
          }
          else if (plan.Error is not null)
          {
            <p class="message-state error-message" role="alert">@plan.Error</p>
          }
          else if (plan.Preview is { } preview)
          {
            var summary = preview.Summary;
            <p class="merge-summary">
              Opusti se <strong>@summary.SourceName</strong>, ostane <strong>@summary.TargetName</strong>:
              @Count(summary.Values, "vrednost", "vrednosti", "vrednosti", "vrednosti") pri @Count(summary.Products, "izdelku", "izdelkih", "izdelkih", "izdelkih").
            </p>
            <table class="merge-table">
              <caption class="visually-hidden">Vrednosti po podjetjih za par @summary.SourceName in @summary.TargetName</caption>
              <thead><tr><th scope="col">Podjetje</th><th scope="col" class="numeric">Izdelkov</th><th scope="col" class="numeric">Novih pri cilju</th><th scope="col" class="numeric">Enakih</th><th scope="col" class="numeric">Trkov</th></tr></thead>
              <tbody>
                @foreach (var organization in preview.Organizations)
                {
                  <tr>
                    <td>@organization.Name @if (!organization.IsActive) { <PimChip Text="neaktivno" Prefix="Podjetje: " /> }</td>
                    <td class="numeric">@organization.Products.ToString("N0")</td>
                    <td class="numeric">@organization.Moved.ToString("N0")</td>
                    <td class="numeric">@organization.Same.ToString("N0")</td>
                    <td class="numeric">@organization.Conflicts.ToString("N0")</td>
                  </tr>
                }
              </tbody>
            </table>
            <p class="attribute-meta">Vrednosti so štete v obeh plasteh (podatek iz vira in podatek v PIM), zato jih je lahko več kot izdelkov.</p>
            <ul class="merge-effects">
              @foreach (var line in EffectLines(summary)) { <li>@line</li> }
            </ul>
            @if (preview.Conflicts.Count > 0)
            {
              <details class="merge-conflicts">
                <summary>Trki (@summary.Conflicts.ToString("N0")) — ostane vrednost atributa @summary.TargetName</summary>
                <table class="merge-table">
                  <caption class="visually-hidden">Izdelki z različno vrednostjo (prvih @preview.Conflicts.Count)</caption>
                  <thead><tr><th scope="col">Podjetje</th><th scope="col">Šifra</th><th scope="col">@summary.SourceName (gre)</th><th scope="col">@summary.TargetName (ostane)</th></tr></thead>
                  <tbody>
                    @foreach (var conflict in preview.Conflicts)
                    {
                      <tr><td>@conflict.Organization</td><td>@conflict.ItemId</td><td><span class="value-before">@conflict.SourceValue</span></td><td><span class="value-after">@conflict.TargetValue</span></td></tr>
                    }
                  </tbody>
                </table>
              </details>
            }
          }
        </fieldset>
      }
      @if (Merging)
      {
        <p class="card-note merge-progress" role="status" aria-live="polite">@Progress</p>
      }
      <div class="merge-actions">
        <button type="button" class="primary-button" disabled="@(!CanConfirm)" @onclick="ConfirmMergeAsync">@ConfirmLabel</button>
        @if (Merging && Validating)
        {
          <button type="button" class="secondary-button" @onclick="CancelValidation">Prekliči validacijo</button>
        }
        else
        {
          <button type="button" class="secondary-button" disabled="@Merging" @onclick="CloseMerge">Prekliči</button>
        }
      </div>
    </section>
  }

  <section class="ui-card data-card section-gap" aria-label="Kandidati za združitev atributov">
    <PimState Loading="DuplicateLoading" Error="@Error" Empty="@(FilteredCandidates.Count == 0)" EmptyText="@(HasFilters ? "Za ta filter ni predlogov. Počisti filtre." : "Ni atributov, ki bi bili videti podvojeni.")" LoadingText="Primerjam atribute, izdelke in vrednosti …">
      <PimTable Caption="Pari atributov, ki morda pomenijo isto" Columns="DuplicateColumns">
        <Rows>
          @foreach (var candidate in FilteredCandidates)
          {
            var key = PairKey(candidate);
            var mergeable = Mergeable(candidate);
            <tr class="@(Selection.Contains(key) ? "is-selected" : null)">
              <td class="check-cell">
                <input type="checkbox" checked="@Selection.Contains(key)" disabled="@(!mergeable || Merging)"
                       aria-label="@($"Izberi par {candidate.First.Name} in {candidate.Second.Name}")"
                       title="@(mergeable ? null : "Atribut ni v registru — najprej ga dodaj v register atributov")"
                       @onchange="args => TogglePair(candidate, args.Value is true)" />
              </td>
              <td><PimChip Text="@KindLabel(candidate.Kind)" Tone="@KindTone(candidate.Kind)" Prefix="Vrsta predloga: " /></td>
              <td>@AttributeCell(candidate.First)</td>
              <td>@AttributeCell(candidate.Second)</td>
              <td class="numeric">@candidate.SharedProducts.ToString("N0")</td>
              <td class="numeric">@candidate.SameValueProducts.ToString("N0")</td>
              <td class="numeric">@candidate.CommonValues.ToString("N0")</td>
              <td>
                @if (CanWrite && mergeable)
                {
                  <button type="button" class="small-action" disabled="@Merging" aria-label="@($"Združi {candidate.First.Name} in {candidate.Second.Name}")"
                          @onclick="() => OpenMergeAsync([candidate])">Združi …</button>
                }
              </td>
            </tr>
          }
        </Rows>
      </PimTable>
    </PimState>
  </section>
  <p class="card-note">
    <strong>Isti podatek</strong>: ista izdelka, pri vsaj 80 % skupnih izdelkov ista vrednost (0, 1, 2, da, ne se ne štejejo).
    <strong>Podobne vrednosti</strong>: skoraj drugi izdelki, vsaj polovica vrednosti enakih — isti pomen pri različnih dobaviteljih.
    <strong>Podobno ime</strong>: ime se razlikuje samo v »(2)«, oznaki jezika ali ločilih oziroma eno vsebuje drugo.
    @if (Report is not null) { <span>Izračunano ob @Report.ComputedUtc.ToPimLocal().ToString("HH:mm") (@($"{Report.ElapsedMs / 1000.0:N1} s") za @Report.Attributes.Count.ToString("N0") atributov); izračun velja 10 minut, »Osveži« ga naredi znova.</span> }
  </p>

  <section class="ui-card data-card section-gap" aria-labelledby="merge-history-title">
    <h2 id="merge-history-title" class="log-title">Zgodovina združitev</h2>
    <p class="card-note">Vsaka združitev je zapisana po vrstici (izdelek, vrednost prej in potem, nastavitve). Razveljavitev vrne vrednosti in nastavitve; kar je kdo po združitvi spremenil, ostane. Združitve, ki si delijo atribut, razveljaviš od zadnje proti prvi.</p>
    @if (RevertTarget is { } revertRun)
    {
      <div class="merge-panel revert-panel" role="alertdialog" aria-labelledby="revert-title" aria-describedby="revert-body">
        <p id="revert-title"><strong>Razveljaviti združitev »@revertRun.SourceName« → »@revertRun.TargetName«?</strong></p>
        <p id="revert-body" class="card-note">@RevertText(revertRun)</p>
        <div class="merge-actions">
          <button type="button" class="danger-button" disabled="@(Merging || RevertPreview is null)" @onclick="ConfirmRevertAsync">Razveljavi združitev</button>
          <button type="button" class="secondary-button" disabled="@Merging" @onclick="CancelRevert">Prekliči</button>
        </div>
      </div>
    }
    <PimState Loading="MergesLoading" Error="@MergesError" Empty="@(Merges.Count == 0)" EmptyText="Ni še nobene združitve. Izberi par zgoraj in ga združi." LoadingText="Berem zgodovino združitev …">
      <PimTable Caption="Združitve atributov (najnovejše najprej)" Columns="MergeColumns">
        <Rows>
          @foreach (var run in Merges)
          {
            <tr>
              <td>@run.MergedUtc.ToPimLocal().ToString("d. M. yyyy HH:mm")</td>
              <td>
                <span class="value-before">@run.SourceName</span> → <a class="attribute-name" href="@($"nastavitve/atributi/{Uri.EscapeDataString(run.TargetCode)}")">@run.TargetName</a>
              </td>
              <td class="numeric">@((run.Summary?.Values ?? 0).ToString("N0"))</td>
              <td class="numeric">@((run.Summary?.Products ?? 0).ToString("N0"))</td>
              <td class="numeric">@((run.Summary?.Conflicts ?? 0).ToString("N0"))</td>
              <td>@run.MergedBy</td>
              <td>
                @if (run.RevertedUtc is { } reverted)
                {
                  <PimChip Text="@($"razveljavljeno {reverted.ToPimLocal():d. M. HH:mm}")" Prefix="Stanje: " />
                }
                else
                {
                  <PimChip Text="združeno" Tone="good" Prefix="Stanje: " />
                }
              </td>
              <td>
                @if (CanWrite && run.RevertedUtc is null)
                {
                  <button type="button" class="small-action" disabled="@(Merging || !run.CanRevert)"
                          title="@(run.CanRevert ? null : "Najprej razveljavi poznejšo združitev z istim atributom")"
                          aria-label="@($"Razveljavi združitev {run.SourceName} v {run.TargetName}")" @onclick="() => AskRevertAsync(run)">Razveljavi …</button>
                }
              </td>
            </tr>
          }
        </Rows>
      </PimTable>
    </PimState>
  </section>
}

@code {
  const string ViewDuplicates = "podvojeni";
  const string ViewPolish = "zapis";

  [SupplyParameterFromQuery(Name = "pogled")] public string? RequestedView { get; set; }
  [SupplyParameterFromQuery(Name = "q")] public string? RequestedSearch { get; set; }
  [SupplyParameterFromQuery(Name = "vrsta")] public string? RequestedKind { get; set; }
  [SupplyParameterFromQuery(Name = "atribut")] public string? RequestedAttribute { get; set; }
  [SupplyParameterFromQuery(Name = "razvrsti")] public string? RequestedSort { get; set; }

  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Nastavitve", "nastavitve"), new("Atributi", "nastavitve/atributi"), new("Čiščenje")];
  static readonly IReadOnlyList<(string Key, string Label)> Kinds =
    [("SAME_DATA", "Isti podatek"), ("SIMILAR_VALUES", "Podobne vrednosti"), ("SIMILAR_NAME", "Podobno ime")];
  static readonly IReadOnlyList<PimColumn> DuplicateColumns =
  [
    new("Izbor"), new("Predlog"), new("Atribut A"), new("Atribut B"), new("Skupni izdelki", Numeric: true),
    new("Ista vrednost", Numeric: true), new("Skupne vrednosti", Numeric: true), new("Dejanje")
  ];
  static readonly IReadOnlyList<PimColumn> PolishColumns =
    [new("Atribut"), new("Prej"), new("Potem"), new("Vrstic", Numeric: true), new("Izdelkov", Numeric: true)];
  static readonly IReadOnlyList<PimColumn> RunColumns =
    [new("Poenotenje"), new("Kdaj"), new("Vrstic", Numeric: true), new("Izdelkov", Numeric: true), new("Podjetij", Numeric: true), new("Dnevnik")];

  PIM.Intranet.Services.AttributeMappingService.DuplicateReport? Report;
  PIM.Intranet.Services.AttributeMappingService.PolishPreview? Polish;
  IReadOnlyList<PIM.Intranet.Services.AttributeMappingService.NormalizationRun> Runs = [];
  bool RunsLoading = true;
  string? RunsError, ExportingRun;
  bool DuplicateLoading = true, PolishLoading = true;
  string? Error;
  string View = ViewDuplicates;
  string Search = "", KindFilter = "", AttributeFilter = "", Sort = "";
  int PolishTake = 500;

  IReadOnlyList<PimTab> Tabs =>
  [
    new(ViewDuplicates, "Podvojeni atributi", "nastavitve/atributi/ciscenje", "Kandidati za združitev",
      Report is null ? null : Report.Candidates.Count.ToString("N0")),
    new(ViewPolish, "Lep zapis vrednosti", "nastavitve/atributi/ciscenje?pogled=zapis", "Ostanek in dnevnik",
      Polish is null ? null : Polish.Changes.Count.ToString("N0")),
  ];

  protected override async Task OnParametersSetAsync()
  {
    View = string.Equals(RequestedView, ViewPolish, StringComparison.OrdinalIgnoreCase) ? ViewPolish : ViewDuplicates;
    Search = RequestedSearch ?? "";
    KindFilter = Kinds.Any(kind => kind.Key == RequestedKind) ? RequestedKind! : "";
    AttributeFilter = RequestedAttribute ?? "";
    Sort = RequestedSort is "izdelki" or "ime" ? RequestedSort : "";
    Error = null;
    await Task.CompletedTask;
  }

  /* Težka poizvedba teče šele po prvem izrisu: stran se odpre takoj s stanjem »Računam …«
     (klikalnik je pri nalaganju v OnParametersSetAsync izmeril 21 s do prvega prikaza). */
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    // Vsak pogled se samodejno naloži enkrat; po napaki ga uporabnik ponovi z »Osveži« (brez zanke).
    if (View == ViewPolish && !polishAttempted) { polishAttempted = true; await LoadRunsAsync(); await LoadPolishAsync(false); }
    else if (View == ViewDuplicates && !duplicatesAttempted) { duplicatesAttempted = true; await LoadDuplicatesAsync(false); await LoadMergesAsync(); }
  }

  bool duplicatesAttempted, polishAttempted;

  async Task LoadDuplicatesAsync(bool refresh)
  {
    DuplicateLoading = true;
    Error = null;
    StateHasChanged();
    try { Report = await Attributes.GetDuplicateCandidatesAsync(refresh); }
    catch (Exception exception) { Error = "Primerjave atributov ni bilo mogoče izračunati: " + exception.Message; }
    finally { DuplicateLoading = false; StateHasChanged(); }
  }

  async Task LoadPolishAsync(bool refresh)
  {
    PolishLoading = true;
    Error = null;
    StateHasChanged();
    try { Polish = await Attributes.GetPolishPreviewAsync(refresh); }
    catch (Exception exception) { Error = "Predogleda zapisa ni bilo mogoče izračunati: " + exception.Message; }
    finally { PolishLoading = false; StateHasChanged(); }
  }

  async Task LoadRunsAsync()
  {
    RunsLoading = true;
    RunsError = null;
    StateHasChanged();
    try { Runs = await Attributes.GetNormalizationRunsAsync(); }
    catch (Exception exception) { RunsError = "Dnevnika poenotenj ni bilo mogoče prebrati: " + exception.Message; }
    finally { RunsLoading = false; StateHasChanged(); }
  }

  async Task ExportRunAsync(string changedBy)
  {
    ExportingRun = changedBy;
    RunsError = null;
    StateHasChanged();
    try
    {
      var csv = await Attributes.GetNormalizationLogCsvAsync(changedBy);
      var file = "dnevnik-poenotenja-" + new string(changedBy.Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()) + ".csv";
      await Js.InvokeVoidAsync("pimDownloadText", file, csv, "text/csv;charset=utf-8");
    }
    catch (Exception exception) { RunsError = "Dnevnika ni bilo mogoče izvoziti: " + exception.Message; }
    finally { ExportingRun = null; StateHasChanged(); }
  }

  /// <summary>Oznaka poenotenja po domače; povratek ostane, kot je zapisan (vsebuje, kdo ga je naredil).</summary>
  static string RunLabel(string changedBy) => changedBy switch
  {
    "migracija 291" => "Migracija 291: napetost, frekvenca, decimalke",
    "migracija 294" => "Migracija 294: jezik atributov",
    "migracija 295" => "Migracija 295: neprevedene vrednosti",
    "migracija 301" => "Migracija 301: enota na atributu",
    "migracija 314" => "Migracija 314: lep zapis (enote, vejice, velika začetnica)",
    "migracija 316" => "Migracija 316: enote »Enota …« ostanejo",
    _ => changedBy,
  };

  Task RefreshDuplicatesAsync() => LoadDuplicatesAsync(true);
  Task RefreshPolishAsync() => LoadPolishAsync(true);

  static string? ComputedTitle(DateTime? computedUtc) =>
    computedUtc is null ? null : $"Izračunano ob {computedUtc.Value.ToPimLocal():HH:mm}; izračunaj znova";

  async Task ExportDuplicatesAsync() => await Js.InvokeVoidAsync("pimDownloadText", "podvojeni-atributi.csv", DuplicateCsv, "text/csv;charset=utf-8");
  async Task ExportPolishAsync() => await Js.InvokeVoidAsync("pimDownloadText", "predogled-zapisa-atributov.csv", PolishCsv, "text/csv;charset=utf-8");

  bool HasFilters => Search.Length > 0 || KindFilter.Length > 0 || AttributeFilter.Length > 0 || Sort.Length > 0;

  void SyncUrl() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
  {
    ["pogled"] = View == ViewPolish ? ViewPolish : null,
    ["q"] = string.IsNullOrWhiteSpace(Search) ? null : Search.Trim(),
    ["vrsta"] = View == ViewDuplicates && KindFilter.Length > 0 ? KindFilter : null,
    ["atribut"] = View == ViewPolish && AttributeFilter.Length > 0 ? AttributeFilter : null,
    ["razvrsti"] = View == ViewDuplicates && Sort.Length > 0 ? Sort : null,
  }));

  Task ClearFiltersAsync()
  {
    Search = KindFilter = AttributeFilter = Sort = "";
    SyncUrl();
    return Task.CompletedTask;
  }

  bool Matches(string? text) => Search.Length == 0 || PimText.Fold(text).Contains(PimText.Fold(Search), StringComparison.Ordinal);

  IReadOnlyList<PIM.Intranet.Services.DuplicateCandidate> FilteredCandidates
  {
    get
    {
      if (Report is null) return [];
      var rows = Report.Candidates
        .Where(candidate => KindFilter.Length == 0 || candidate.Kind == KindFilter)
        .Where(candidate => Matches(candidate.First.Name) || Matches(candidate.Second.Name));
      rows = Sort switch
      {
        "izdelki" => rows.OrderByDescending(candidate => candidate.First.Products + candidate.Second.Products),
        "ime" => rows.OrderBy(candidate => candidate.First.Name, StringComparer.CurrentCulture),
        _ => rows,
      };
      return rows.ToList();
    }
  }

  IReadOnlyList<PIM.Intranet.Services.AttributeMappingService.PolishPreviewRow> FilteredPolish =>
    Polish is null ? [] : Polish.Changes
      .Where(row => AttributeFilter.Length == 0 || row.AttributeCode == AttributeFilter)
      .Where(row => Matches(row.AttributeCode) || Matches(row.OldValue) || Matches(row.NewValue))
      .ToList();

  IReadOnlyList<(string Name, int Count)> PolishAttributes =>
    Polish is null ? [] : Polish.Changes.GroupBy(row => row.AttributeCode)
      .Select(group => (group.Key, group.Count())).OrderBy(group => group.Key, StringComparer.CurrentCulture).ToList();

  int KindCount(string kind) => Report?.Candidates.Count(candidate => candidate.Kind == kind) ?? 0;

  string DuplicateSummary => DuplicateLoading ? "Računam …" : Error is not null ? "Rezultati niso na voljo"
    : Count(FilteredCandidates.Count, "predlog", "predloga", "predlogi", "predlogov");

  string PolishSummary => PolishLoading ? "Računam …" : Error is not null ? "Rezultati niso na voljo"
    : $"{Count(FilteredPolish.Count, "zapis", "zapisa", "zapisi", "zapisov")}, {Count(FilteredPolish.Sum(row => row.Rows), "vrstica", "vrstici", "vrstice", "vrstic")}";

  /// <summary>Slovenska dvojina in množina: 1 predlog, 2 predloga, 3 predlogi, 5 predlogov.</summary>
  static string Count(long n, string one, string two, string few, string many) => (n % 100) switch
  {
    1 => $"{n:N0} {one}",
    2 => $"{n:N0} {two}",
    3 or 4 => $"{n:N0} {few}",
    _ => $"{n:N0} {many}",
  };

  static string KindLabel(string kind) => Kinds.FirstOrDefault(item => item.Key == kind).Label ?? kind;
  static string? KindTone(string kind) => kind switch { "SAME_DATA" => "bad", "SIMILAR_VALUES" => "warn", _ => null };

  static RenderFragment AttributeCell(PIM.Intranet.Services.CleanupAttribute item) => __builder =>
  {
    <div class="attribute-cell">
      @if (item.AttributeCode is not null)
      {
        <a class="attribute-name" href="@($"nastavitve/atributi/{Uri.EscapeDataString(item.AttributeCode)}")">@item.Name</a>
      }
      else
      {
        <span class="attribute-name">@item.Name</span> <PimChip Text="ni v registru" Tone="warn" Prefix="Register: " />
      }
      <span class="attribute-meta">@item.Products.ToString("N0") izdelkov · @item.DistinctValues.ToString("N0") vrednosti@(item.ByOrganization is null ? "" : " · " + item.ByOrganization)</span>
      @if (item.Samples is not null) { <span class="attribute-samples" title="Najpogostejše vrednosti">@item.Samples</span> }
    </div>
  };

  string DuplicateCsv => Csv(
    ["Predlog", "Atribut A", "Koda A", "Izdelkov A", "Po podjetjih A", "Primeri A", "Atribut B", "Koda B", "Izdelkov B",
     "Po podjetjih B", "Primeri B", "Skupni izdelki", "Ista vrednost", "Skupne vrednosti"],
    FilteredCandidates.Select(candidate => new[]
    {
      KindLabel(candidate.Kind), candidate.First.Name, candidate.First.AttributeCode ?? "ni v registru", candidate.First.Products.ToString(),
      candidate.First.ByOrganization ?? "", candidate.First.Samples ?? "", candidate.Second.Name, candidate.Second.AttributeCode ?? "ni v registru",
      candidate.Second.Products.ToString(), candidate.Second.ByOrganization ?? "", candidate.Second.Samples ?? "",
      candidate.SharedProducts.ToString(), candidate.SameValueProducts.ToString(), candidate.CommonValues.ToString()
    }));

  string PolishCsv => Csv(
    ["Atribut", "Prej", "Potem", "Vrstic", "Izdelkov"],
    FilteredPolish.Select(row => new[] { row.AttributeCode, row.OldValue, row.NewValue, row.Rows.ToString(), row.Products.ToString() }));

  /// <summary>CSV s podpičjem (BOM doda pimDownloadText), da ga Excel odpre s šumniki; filtri na zaslonu so upoštevani.</summary>
  static string Csv(IReadOnlyList<string> header, IEnumerable<string[]> rows)
  {
    var builder = new System.Text.StringBuilder();
    builder.AppendLine(string.Join(';', header.Select(Cell)));
    foreach (var row in rows) builder.AppendLine(string.Join(';', row.Select(Cell)));
    return builder.ToString();

    static string Cell(string value) =>
      value.IndexOfAny([';', '"', '\n', '\r']) >= 0 ? "\"" + value.Replace("\"", "\"\"") + "\"" : value;
  }
  /* ─── Združitev atributov (#48, migracija 319) ─────────────────────────────────────────────
     Pravila so v canon.MergeAttributeDefinitions; stran izbere pare, pokaže predogled (po podjetjih,
     trki, nastavitve), združi in nato validira prizadete izdelke v paketih (napredek, preklic). */

  static readonly IReadOnlyList<PimColumn> MergeColumns =
  [
    new("Kdaj"), new("Opuščen → ostane"), new("Vrednosti", Numeric: true), new("Izdelkov", Numeric: true),
    new("Trkov", Numeric: true), new("Kdo"), new("Stanje"), new("Dejanje")
  ];

  sealed class MergePlan
  {
    public required int Id { get; init; }
    public required PIM.Intranet.Services.CleanupAttribute First { get; init; }
    public required PIM.Intranet.Services.CleanupAttribute Second { get; init; }
    public required string KeepCode { get; set; }
    public string? EnglishName { get; set; }
    public PIM.Intranet.Services.AttributeMappingService.MergePreview? Preview { get; set; }
    public bool Loading { get; set; }
    public string? Error { get; set; }
    public PIM.Intranet.Services.CleanupAttribute Keep => KeepCode == First.AttributeCode ? First : Second;
    public PIM.Intranet.Services.CleanupAttribute Drop => KeepCode == First.AttributeCode ? Second : First;
  }

  readonly PimRowSelection<PIM.Intranet.Services.DuplicateCandidate> Selection = new();
  List<MergePlan> Plans = [];
  IReadOnlyList<PIM.Intranet.Services.AttributeMappingService.MergeRun> Merges = [];
  PIM.Intranet.Services.AttributeMappingService.MergeRun? RevertTarget;
  PIM.Intranet.Services.AttributeMappingService.RevertSummary? RevertPreview;
  bool CanWrite, IsAdmin, Merging, Validating, MergesLoading = true;
  string? Result, MergeError, MergesError, Progress;
  CancellationTokenSource? validationCancel;

  protected override async Task OnInitializedAsync()
  {
    CanWrite = await Guard.AllowsAsync(PimPolicies.CatalogWrite);
    IsAdmin = (await Guard.CurrentUserAsync())?.IsInRole("ADMIN") == true;
  }

  public void Dispose() => validationCancel?.Cancel();

  static string PairKey(PIM.Intranet.Services.DuplicateCandidate candidate) => candidate.First.Name + "\u001f" + candidate.Second.Name;

  /// <summary>Združiti se da samo atributa iz registra (postopek dela po kodi, vrednosti po slovenskem imenu).</summary>
  static bool Mergeable(PIM.Intranet.Services.DuplicateCandidate candidate) =>
    candidate.First.AttributeCode is not null && candidate.Second.AttributeCode is not null
    && !string.Equals(candidate.First.AttributeCode, candidate.Second.AttributeCode, StringComparison.OrdinalIgnoreCase);

  IReadOnlyList<PIM.Intranet.Services.DuplicateCandidate> MergeableFiltered => FilteredCandidates.Where(Mergeable).ToList();

  IReadOnlyList<PIM.Intranet.Services.DuplicateCandidate> SelectedPairs => Selection.Items.ToList();

  void TogglePair(PIM.Intranet.Services.DuplicateCandidate candidate, bool selected) => Selection.Toggle(PairKey(candidate), candidate, selected);

  void SelectAllPairs(bool selected) =>
    Selection.SetPage(MergeableFiltered.Select(candidate => KeyValuePair.Create(PairKey(candidate), candidate)), selected);

  void ClearSelection() => Selection.Clear();

  async Task LoadMergesAsync()
  {
    MergesLoading = true;
    MergesError = null;
    try { Merges = await Attributes.GetMergesAsync(); }
    catch (Exception exception) { MergesError = "Zgodovine združitev ni bilo mogoče prebrati: " + exception.Message; }
    finally { MergesLoading = false; StateHasChanged(); }
  }

  async Task OpenMergeAsync(IReadOnlyList<PIM.Intranet.Services.DuplicateCandidate> candidates)
  {
    Result = MergeError = null;
    RevertTarget = null;
    var id = 0;
    // Privzeto ostane atribut z več izdelki (pri »Grlo« in »Podnožje / socket« je to Grlo — odločitev lastnika).
    Plans = candidates.Where(Mergeable).Select(candidate => new MergePlan
    {
      Id = ++id,
      First = candidate.First,
      Second = candidate.Second,
      KeepCode = (candidate.Second.Products > candidate.First.Products ? candidate.Second : candidate.First).AttributeCode!,
    }).ToList();
    StateHasChanged();
    foreach (var plan in Plans.ToList()) await LoadPreviewAsync(plan);
  }

  async Task LoadPreviewAsync(MergePlan plan)
  {
    plan.Loading = true;
    plan.Error = null;
    plan.Preview = null;
    StateHasChanged();
    try
    {
      plan.Preview = await Attributes.PreviewMergeAsync(plan.Drop.AttributeCode!, plan.KeepCode, null);
      if (string.IsNullOrWhiteSpace(plan.EnglishName))
        plan.EnglishName = plan.Preview.Summary.EnglishNameBefore ?? SuggestEnglish(plan.Drop.Name);
    }
    catch (Exception exception) { plan.Error = "Predogleda ni bilo mogoče izračunati: " + exception.Message; }
    finally { plan.Loading = false; StateHasChanged(); }
  }

  Task ChangeKeepAsync(MergePlan plan, string keepCode)
  {
    if (plan.KeepCode == keepCode) return Task.CompletedTask;
    plan.KeepCode = keepCode;
    plan.EnglishName = null;
    return LoadPreviewAsync(plan);
  }

  /// <summary>»Podnožje / socket« → »Socket«: dvojezično ime opuščenega atributa pove angleško ime (lastnik: »angleško socket«).</summary>
  static string? SuggestEnglish(string name)
  {
    var slash = name.LastIndexOf(" / ", StringComparison.Ordinal);
    if (slash < 0) return null;
    var english = name[(slash + 3)..].Trim();
    return english.Length == 0 ? null : char.ToUpperInvariant(english[0]) + english[1..];
  }

  static string EnglishHelp(MergePlan plan) => plan.Preview?.Summary.EnglishNameBefore is { } before
    ? $"Zdaj »{before}«. Če ime pustiš, se ne spremeni."
    : "Atribut, ki ostane, zdaj nima angleškega imena. Prazno polje = brez spremembe.";

  string? OverlapMessage
  {
    get
    {
      var repeated = Plans.SelectMany(plan => new[] { plan.First, plan.Second })
        .GroupBy(attribute => attribute.AttributeCode, StringComparer.OrdinalIgnoreCase)
        .Where(group => group.Count() > 1).Select(group => group.First().Name).ToList();
      return repeated.Count == 0 ? null
        : $"Atribut »{string.Join("«, »", repeated)}« je v več izbranih parih. Združi jih enega za drugim (najprej en par, nato naslednjega), da je jasno, kaj ostane.";
    }
  }

  bool CanConfirm => CanWrite && !Merging && Plans.Count > 0 && OverlapMessage is null
    && Plans.All(plan => plan.Preview is not null && !plan.Loading && plan.Error is null);

  string MergeTitle => Plans.Count == 1
    ? $"Združi »{Plans[0].Drop.Name}« v »{Plans[0].Keep.Name}«"
    : $"Združi {Count(Plans.Count, "par", "para", "pare", "parov")} atributov";

  string ConfirmLabel
  {
    get
    {
      if (Merging) return "Združujem …";
      var values = Plans.Sum(plan => plan.Preview?.Summary.Values ?? 0);
      var products = Plans.Sum(plan => plan.Preview?.Summary.Products ?? 0);
      var pairs = Plans.Count == 1 ? "Združi" : $"Združi {Count(Plans.Count, "par", "para", "pare", "parov")}";
      return $"{pairs}: {Count(values, "vrednost", "vrednosti", "vrednosti", "vrednosti")} pri {Count(products, "izdelku", "izdelkih", "izdelkih", "izdelkih")}";
    }
  }

  /// <summary>Glagol v številu: 1 se izklopi, 2 se izklopita, 3–4 se izklopijo, 5+ se izklopi.</summary>
  static string Verb(long n, string one, string two, string few, string many) => (n % 100) switch
  {
    1 => one,
    2 => two,
    3 or 4 => few,
    _ => many,
  };

  static IEnumerable<string> EffectLines(PIM.Intranet.Services.AttributeMappingService.MergeSummary summary)
  {
    if (summary.Moved + summary.Filled > 0)
      yield return $"»{summary.TargetName}« dobi {Count(summary.Moved + summary.Filled, "novo vrednost", "novi vrednosti", "nove vrednosti", "novih vrednosti")} (izdelki bodo ponovno validirani).";
    if (summary.Same > 0)
      yield return $"{Count(summary.Same, "vrednost je", "vrednosti sta", "vrednosti so", "vrednosti je")} pri »{summary.TargetName}« že enakih — pri »{summary.SourceName}« se samo odstranijo.";
    if (summary.Conflicts > 0)
      yield return $"{Count(summary.Conflicts, "trk", "trka", "trki", "trkov")}: ostane vrednost »{summary.TargetName}«, vrednost »{summary.SourceName}« je zapisana v zgodovini in se z razveljavitvijo vrne.";
    if (summary.FieldMappingsDeactivated > 0)
      yield return $"Zajem XML: {Count(summary.FieldMappingsDeactivated, "preslikava", "preslikavi", "preslikave", "preslikav")} v »{summary.SourceName}« {Verb(summary.FieldMappingsDeactivated, "se izklopi", "se izklopita", "se izklopijo", "se izklopi")} — isti podatek iz vira že gre v »{summary.TargetName}«.";
    if (summary.FieldMappingsRetargeted > 0)
      yield return $"Zajem XML: {Count(summary.FieldMappingsRetargeted, "preslikava", "preslikavi", "preslikave", "preslikav")} odslej {Verb(summary.FieldMappingsRetargeted, "piše", "pišeta", "pišejo", "piše")} v »{summary.TargetName}«, zato naslednji zajem opuščenega atributa ne napolni znova.";
    if (summary.AttributeMaps > 0)
      yield return $"Register virov: {Count(summary.AttributeMaps, "izvorni atribut kaže", "izvorna atributa kažeta", "izvorni atributi kažejo", "izvornih atributov kaže")} na »{summary.TargetName}«.";
    if (summary.CategorySetsRetargeted + summary.CategorySetsDeactivated > 0)
      yield return $"Nabori kategorij: {summary.CategorySetsRetargeted:N0} preneseno na »{summary.TargetName}«, {summary.CategorySetsDeactivated:N0} izklopljeno (kategorija ga že ima).";
    if (summary.RequirementsRetargeted + summary.RequirementsDeactivated > 0)
      yield return $"Zahteve validacije: {summary.RequirementsRetargeted:N0} prenesenih na »{summary.TargetName}«, {summary.RequirementsDeactivated:N0} izklopljenih (enaka že obstaja).";
    if (summary.ExportColumnsRetargeted > 0)
      yield return $"katalog.csv: {Count(summary.ExportColumnsRetargeted, "stolpec bere", "stolpca bereta", "stolpci berejo", "stolpcev bere")} »{summary.TargetName}« (ime stolpca ostane).";
    if (summary.ExportColumnsKeptEmpty > 0)
      yield return $"katalog.csv: stolpec »{summary.ExportColumnsKeptNames ?? summary.SourceName}« ostane v glavi, a bo prazen — podatek je v stolpcu »{summary.TargetName}«.";
    if (summary.UnitPairs > 0)
      yield return $"Par enote: {Count(summary.UnitPairs, "atribut »Enota …« se veže", "atributa »Enota …« se vežeta", "atributi »Enota …« se vežejo", "atributov »Enota …« se veže")} na »{summary.TargetName}«.";
    yield return $"»{summary.SourceName}« se deaktivira (ostane v registru z opombo, v kaj je združen). V SAOP ne gre nič.";
  }

  void CloseMerge()
  {
    if (Merging) return;
    Plans = [];
  }

  void CancelValidation() => validationCancel?.Cancel();

  async Task ConfirmMergeAsync()
  {
    if (!CanConfirm) return;
    Merging = true;
    MergeError = Result = null;
    var done = new List<string>();
    var products = new List<long>();
    try
    {
      var index = 0;
      foreach (var plan in Plans.ToList())
      {
        index++;
        Progress = $"Združujem {index} od {Plans.Count}: »{plan.Drop.Name}« v »{plan.Keep.Name}« …";
        StateHasChanged();
        try
        {
          var outcome = await Attributes.MergeAsync(plan.Drop.AttributeCode!, plan.KeepCode, plan.EnglishName);
          products.AddRange(outcome.ProductIds);
          var summary = outcome.Summary;
          done.Add($"»{plan.Drop.Name}« → »{plan.Keep.Name}« ({Count(summary?.Values ?? 0, "vrednost", "vrednosti", "vrednosti", "vrednosti")} pri {Count(summary?.Products ?? 0, "izdelku", "izdelkih", "izdelkih", "izdelkih")}"
            + (summary?.EnglishNameAfter is { } english && english != summary.EnglishNameBefore ? $", angleško »{english}«" : "") + ")");
        }
        catch (Exception exception)
        {
          MergeError = $"Par »{plan.Drop.Name}« in »{plan.Keep.Name}« ni združen: {exception.Message}"
            + (done.Count > 0 ? " Prejšnji pari so združeni (glej Zgodovina združitev)." : "");
          break;
        }
      }
      var validation = await ValidateAsync(products);
      if (done.Count > 0)
        Result = $"Združeno: {string.Join("; ", done)}. {validation} Združeni par izgine s seznama; razveljaviš ga v Zgodovini združitev spodaj.";
    }
    finally
    {
      Merging = Validating = false;
      Progress = null;
      if (MergeError is null) { Plans = []; Selection.Clear(); }
      StateHasChanged();
    }
    await LoadMergesAsync();
    await LoadDuplicatesAsync(true);
  }

  /// <summary>Validacija izdelkov, pri katerih se je vrednost ciljnega atributa spremenila (v paketih, s preklicem).</summary>
  async Task<string> ValidateAsync(IReadOnlyList<long> products)
  {
    var distinct = products.Distinct().ToList();
    if (distinct.Count == 0) return "Atribut, ki ostane, ni dobil ali izgubil nobene vrednosti, zato validacija ni potrebna.";
    Validating = true;
    validationCancel = new CancellationTokenSource();
    var progress = new Progress<int>(count =>
    {
      Progress = $"Validacija: {count:N0} od {distinct.Count:N0} izdelkov …";
      _ = InvokeAsync(StateHasChanged);
    });
    Progress = $"Validacija: 0 od {distinct.Count:N0} izdelkov …";
    StateHasChanged();
    try
    {
      var validated = await Attributes.RevalidateAsync(distinct, progress, validationCancel.Token);
      return $"Validacija ponovljena za {Count(validated, "izdelek", "izdelka", "izdelke", "izdelkov")}.";
    }
    catch (OperationCanceledException)
    {
      return "Validacija je preklicana; ostali izdelki se preverijo ob naslednji validaciji.";
    }
    catch (Exception exception)
    {
      return "Validacija ni uspela (" + exception.Message + "); izdelki se preverijo ob naslednji validaciji.";
    }
    finally
    {
      Validating = false;
      validationCancel?.Dispose();
      validationCancel = null;
    }
  }

  async Task AskRevertAsync(PIM.Intranet.Services.AttributeMappingService.MergeRun run)
  {
    Result = MergeError = null;
    Plans = [];
    RevertTarget = run;
    RevertPreview = null;
    StateHasChanged();
    try { RevertPreview = await Attributes.PreviewRevertAsync(run.MergeId); }
    catch (Exception exception) { MergeError = "Razveljavitve ni bilo mogoče pripraviti: " + exception.Message; RevertTarget = null; }
  }

  void CancelRevert()
  {
    RevertTarget = null;
    RevertPreview = null;
  }

  string RevertText(PIM.Intranet.Services.AttributeMappingService.MergeRun run)
  {
    if (RevertPreview is not { } preview) return "Računam, kaj se da vrniti …";
    var skipped = preview.ValuesSkipped + preview.SettingsSkipped;
    return $"Vrne se {Count(preview.ValuesReverted, "vrednost", "vrednosti", "vrednosti", "vrednosti")} in "
      + $"{Count(preview.SettingsReverted, "nastavitev", "nastavitvi", "nastavitve", "nastavitev")} (preslikave, nabori, zahteve, izvoz, register, angleško ime). "
      + (skipped > 0 ? $"{Count(skipped, "sprememba je bila", "spremembi sta bili", "spremembe so bile", "sprememb je bilo")} od združitve urejenih in ostanejo, kot so. " : "")
      + $"Atribut »{run.SourceName}« bo spet aktiven.";
  }

  async Task ConfirmRevertAsync()
  {
    if (RevertTarget is not { } run || Merging) return;
    Merging = true;
    MergeError = Result = null;
    try
    {
      var outcome = await Attributes.RevertMergeAsync(run.MergeId);
      var validation = await ValidateAsync(outcome.ProductIds);
      Result = $"Razveljavljeno: »{run.SourceName}« je spet samostojen atribut ({Count(outcome.Summary?.ValuesReverted ?? 0, "vrednost vrnjena", "vrednosti vrnjeni", "vrednosti vrnjene", "vrednosti vrnjenih")}"
        + (outcome.Summary is { ValuesSkipped: > 0 } summary ? $", {summary.ValuesSkipped:N0} ostalo, ker so bile medtem spremenjene" : "") + $"). {validation}";
      RevertTarget = null;
      RevertPreview = null;
    }
    catch (Exception exception) { MergeError = "Razveljavitev ni uspela: " + exception.Message; }
    finally { Merging = false; Progress = null; StateHasChanged(); }
    await LoadMergesAsync();
    await LoadDuplicatesAsync(true);
  }
}
