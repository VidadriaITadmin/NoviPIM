@page "/nastavitve/nabori-atributov"
@attribute [Authorize(Roles = "ADMIN,CATALOG_EDITOR,COMMERCIAL")]
@rendermode InteractiveServer
@using PIM.Intranet.Services
@inject CategoryTreeService Tree
@inject AuthenticationStateProvider Authentication

@* Uporabnik 2026-09-08: "nova stran pod nastavitve ... da povemo po kategorijah ali od svetil ali
   od videlektra koliko atributov in katerih ima katera kategorija in na podlagi tega lahko
   uporabniki spreminjajo in dodajajo po zelji". Register in pravila so iz migracije 147 (isti kot
   pri gumbu Atributi na /nastavitve/kategorije); ta stran doda pregled celega drevesa naenkrat in
   mnozicno urejanje (izbira vec atributov, kopiranje nabora, lepljenje seznama iz mastrov). *@

<PageTitle>Nabori atributov po kategorijah</PageTitle>
<PimPage Title="Nabori atributov po kategorijah"
         Subtitle="Za vsako drevo (svetila, videlektro) pove, koliko in katere atribute ima katera kategorija. Nabor se deduje na podkategorije; določa, kateri atributi so na kartici izdelka, kaj zahteva spletna validacija in kateri atributi gredo v spletni izvoz."
         Crumbs="Crumbs" />

@if (Message is not null) { <p class="message-state" role="status">@Message</p> }
@if (Error is not null) { <p class="message-state error-message" role="alert">@Error</p> }

<section class="ui-card tree-picker" aria-labelledby="tree-picker-title">
  <h2 id="tree-picker-title" class="visually-hidden">Izbira drevesa</h2>
  @if (Trees.Count == 0 && !Loading)
  {
    <p class="muted">V bazi ni nobenega drevesa kategorij.</p>
  }
  <div class="tree-chips" role="tablist" aria-label="Drevesa kategorij">
    @foreach (var tree in Trees)
    {
      <button type="button" role="tab" class="tree-chip @(tree.CategoryTreeCode == TreeCode ? "is-active" : null)"
              aria-selected="@(tree.CategoryTreeCode == TreeCode ? "true" : "false")"
              @onclick="() => SelectTreeAsync(tree.CategoryTreeCode)">
        <strong>@TreeLabel(tree.CategoryTreeCode)</strong>
        <span class="tree-meta">@tree.CategoriesWithOwnSet.ToString("N0") / @tree.Categories.ToString("N0") kategorij z naborom · @tree.ProductCount.ToString("N0") izdelkov</span>
        @if (tree.WebProfileCode is null)
        {
          <PimChip Text="brez spletnega profila" Tone="bad" />
        }
      </button>
    }
  </div>
</section>

@if (Overview is not null)
{
  <section class="kpi-grid section-gap" aria-label="Povzetek drevesa">
    <PimStat Label="Kategorije z lastnim naborom" Value="@Overview.Summary.CategoriesWithOwnSet.ToString("N0")" Note="@($"od {Overview.Summary.Categories:N0}")" />
    <PimStat Label="Kategorije z učinkovitim naborom" Value="@Overview.Summary.CategoriesWithEffectiveSet.ToString("N0")" Note="lastne in podedovane vrstice" />
    <PimStat Label="Vrstic nabora" Value="@Overview.Summary.OwnRows.ToString("N0")" Note="obvezni, priporočeni in izločeni" />
    <PimStat Label="Izdelki pod naborom" Value="@Overview.Summary.ProductsUnderSet.ToString("N0")" Note="@($"od {Overview.Summary.ProductCount:N0} v drevesu")" />
    <PimStat Label="Atributov v registru" Value="@Overview.Summary.AttributesInRegister.ToString("N0")" Note="@(Overview.Summary.WebProfileCode is null ? "drevo nima spletnega profila" : $"spletni profil {Overview.Summary.WebProfileCode}")" Href="nastavitve/atributi" />
  </section>

  @if (Overview.Summary.WebProfileCode is null)
  {
    <p class="message-state error-message" role="alert">
      Drevo @TreeLabel(TreeCode) nima aktivnega spletnega validacijskega profila, zato nabora ni mogoče shraniti. Profil se doda v pravilih validacije.
    </p>
  }
}

<section class="ui-card toolbar section-gap" role="search" aria-labelledby="set-filter-title">
  <h2 id="set-filter-title" class="visually-hidden">Filtriranje kategorij</h2>

  <label class="visually-hidden" for="set-search">Iskanje</label>
  <input id="set-search" class="form-input" type="search" placeholder="Išči po poti ali kodi kategorije"
         @bind="Search" @bind:after="LoadAsync" />

  <label class="visually-hidden" for="set-level">Raven drevesa</label>
  <select id="set-level" class="filter-select" @bind="Level" @bind:after="LoadAsync">
    <option value="">Vse ravni</option>
    <option value="1">1. raven</option>
    <option value="2">2. raven</option>
    <option value="3">3. raven</option>
    <option value="4">4. raven</option>
  </select>

  <label class="filter-check">
    <input type="checkbox" @bind="OnlyWithoutSet" @bind:after="LoadAsync" />
    Samo brez nabora
  </label>
  <label class="filter-check">
    <input type="checkbox" @bind="OnlyWithProducts" @bind:after="LoadAsync" />
    Samo z izdelki
  </label>

  <span class="result-count" role="status" aria-live="polite">@ResultSummary</span>
</section>

<section class="ui-card data-card section-gap" aria-label="Nabori po kategorijah">
  <PimState Loading="Loading" Error="@Error" Empty="@(Overview is null || Overview.Rows.Count == 0)"
            EmptyText="Za te filtre ni nobene kategorije." LoadingText="Nalaganje naborov …">
    <PimTable Caption="Kategorije drevesa z lastnimi in podedovanimi atributi ter pokritostjo pri izdelkih" Columns="Columns">
      <Rows>
        @foreach (var row in Overview!.Rows)
        {
          <tr class="@(row.HasOwnSet ? "has-own" : row.HasEffectiveSet ? "has-inherited" : "no-set")">
            <td>
              <div class="category-cell" style="@Indent(row.LevelNo)">
                <span class="category-name">@row.CategoryName</span>
                <span class="code-value">@row.CategoryCode</span>
                @if (!row.IsActive) { <PimChip Text="neaktivna" Tone="warn" /> }
              </div>
            </td>
            <td class="numeric" title="Neposredno v kategoriji / v kategoriji in pod njo">@row.ProductCount.ToString("N0") / @row.DescendantProductCount.ToString("N0")</td>
            <td class="numeric">@Count(row.EffectiveRequired, row.OwnRequired)</td>
            <td class="numeric">@Count(row.EffectiveRecommended, row.OwnRecommended)</td>
            <td class="numeric">@Count(row.EffectiveExcluded, row.OwnExcluded)</td>
            <td>
              @if (row.HasEffectiveSet)
              {
                <span class="names" title="@row.EffectiveNames">@row.EffectiveNames</span>
                @if (row.InheritedCount > 0 && !row.HasOwnSet) { <PimChip Text="podedovan" Prefix="Nabor: " /> }
              }
              else
              {
                <span class="muted">brez nabora — na kartici in v izvozu vsi atributi izdelka</span>
              }
            </td>
            <td class="numeric" title="Različni atributi z vrednostjo pri izdelkih poddrevesa; koliko od njih nabor ne omenja">
              @row.UsedAttributeCount.ToString("N0")
              @if (row.UsedNotInSetCount > 0 && row.HasEffectiveSet) { <span class="warn-count">(@row.UsedNotInSetCount izven)</span> }
            </td>
            <td class="table-actions">
              <button type="button" class="@(Editing == row.CategoryCode ? "primary-button" : "secondary-button")" disabled="@Busy"
                      @onclick="() => ToggleEditorAsync(row)">@(Editing == row.CategoryCode ? "Zapri" : "Uredi")</button>
            </td>
          </tr>

          @if (Editing == row.CategoryCode)
          {
            <tr class="editor-row">
              <td colspan="8">
                <div class="set-editor" aria-label="@($"Nabor atributov za {row.CategoryName}")">
                  <div class="editor-head">
                    <span class="editor-origin">Nabor za: <strong>@row.CategoryName</strong></span>
                    <span class="editor-path">@row.CategoryPath</span>
                    <span class="editor-note">Obvezen atribut blokira splet, priporočen opozori, izločen razveljavi podedovanega. Velja tudi za podkategorije; najbližja vrstica zmaga.</span>
                  </div>

                  @if (EditorLoading) { <p class="message-state">Nalaganje nabora …</p> }
                  else
                  {
                    <div class="editor-grid">
                      <div class="editor-block">
                        <h3>Trenutni nabor (@EditorSet.Rows.Count(setRow => setRow.Level != "EXCLUDED"))@(EditorSet.Rows.Any(setRow => setRow.Level == "EXCLUDED") ? $" · izločenih {EditorSet.Rows.Count(setRow => setRow.Level == "EXCLUDED")}" : "")</h3>

                        @if (EditorSet.Rows.Count > 0)
                        {
                          @* 2026-09-29 uporabnik: "omogoci da vec na enkrat odstranim ... tiste atribute ki v tej
                             kategoriji nimajo vrednosti". Izbira + mnozicna dejanja; podedovane vrstice se tu izlocijo
                             ali odstranijo pri izvoru (kategoriji, kjer so dolocene), s potrditvijo in razveljavitvijo. *@
                          <div class="set-toolbar">
                            <button type="button" class="small-action" disabled="@(Busy || EmptyRows.Count == 0)" @onclick="SelectEmpty"
                                    title="Označi atribute, ki jih noben izdelek te kategorije (in podkategorij) nima izpolnjenih">
                              Označi brez vrednosti (@EmptyRows.Count)
                            </button>
                            @if (SelectedRows.Count > 0)
                            {
                              <div class="pim-selection" role="group" aria-label="Dejanja za izbrane atribute">
                                <strong>Izbranih @SelectedRows.Count</strong>
                                <label class="visually-hidden" for="bulk-level">Nova raven za izbrane</label>
                                <select id="bulk-level" class="filter-select" @bind="BulkLevel" disabled="@Busy">
                                  <option value="REQUIRED">obvezen</option>
                                  <option value="RECOMMENDED">priporočen</option>
                                  <option value="EXCLUDED">izločen</option>
                                </select>
                                <button type="button" class="ghost-button" disabled="@Busy" @onclick="() => SetLevelSelectedAsync(row)">Nastavi raven</button>
                                <button type="button" class="ghost-button" disabled="@Busy" @onclick="AskRemoveHere">Odstrani iz te kategorije</button>
                                <button type="button" class="ghost-button danger-action" disabled="@Busy" @onclick="() => AskRemoveAtSourceAsync(row)">Odstrani pri izvoru …</button>
                                <button type="button" class="ghost-button" disabled="@Busy" @onclick="SelectedClear">Počisti izbiro</button>
                              </div>
                            }
                          </div>
                        }

                        @if (Pending is not null)
                        {
                          <div class="confirm-panel" role="alertdialog" aria-labelledby="confirm-title" aria-describedby="confirm-body">
                            <p id="confirm-title"><strong>@Pending.Title</strong></p>
                            <ul id="confirm-body">
                              @foreach (var line in Pending.Lines) { <li>@line</li> }
                            </ul>
                            <div class="editor-actions">
                              @foreach (var choice in Pending.Choices)
                              {
                                <button type="button" class="@(choice.Danger ? "danger-button" : "primary-button")" disabled="@(Busy || choice.Items.Count == 0)"
                                        @onclick="() => ApplyAsync(row, choice)">@choice.Label</button>
                              }
                              <button type="button" class="secondary-button" disabled="@Busy" @onclick="() => Pending = null">Prekliči</button>
                            </div>
                          </div>
                        }

                        @if (Undo is not null && Pending is null)
                        {
                          <div class="undo-panel" role="status">
                            <span>@Undo.Label</span>
                            <button type="button" class="small-action" disabled="@Busy" @onclick="() => UndoAsync(row)">Razveljavi</button>
                          </div>
                        }

                        <table class="attribute-set">
                          <caption class="visually-hidden">Učinkovit nabor atributov kategorije @row.CategoryName</caption>
                          <thead><tr>
                            <th scope="col" class="check-cell">
                              <input type="checkbox" aria-label="Označi vse atribute nabora" checked="@(EditorSet.Rows.Count > 0 && SelectedRows.Count == EditorSet.Rows.Count)"
                                     disabled="@(EditorSet.Rows.Count == 0)" @onchange="args => SelectAll(args.Value is true)" />
                            </th>
                            <th scope="col">Atribut</th><th scope="col">Raven</th><th scope="col">Določen na</th><th scope="col" class="numeric">Ima vrednost</th><th scope="col"><span class="visually-hidden">Dejanje</span></th>
                          </tr></thead>
                          <tbody>
                            @if (EditorSet.Rows.Count == 0)
                            {
                              <tr><td colspan="6" class="muted">Nabor še ni določen. Dodaj atribute iz registra, jih prilepi ali kopiraj nabor druge kategorije.</td></tr>
                            }
                            @foreach (var setRow in EditorSet.Rows)
                            {
                              <tr class="@(setRow.IsInherited ? "is-inherited" : null) @(setRow.Level == "EXCLUDED" ? "is-excluded" : null) @(Selected.Contains(setRow.AttributeCode) ? "is-selected" : null)">
                                <td class="check-cell">
                                  <input type="checkbox" aria-label="@($"Označi {setRow.AttributeName}")" checked="@Selected.Contains(setRow.AttributeCode)"
                                         @onchange="args => ToggleSelected(setRow.AttributeCode, args.Value)" />
                                </td>
                                <td>@setRow.AttributeName <span class="code-value">@setRow.AttributeCode</span></td>
                                <td>
                                  <select class="filter-select" value="@setRow.Level" disabled="@Busy" aria-label="@($"Raven za {setRow.AttributeName}")"
                                          @onchange="args => SetLevelAsync(row, setRow.AttributeCode, args.Value?.ToString())">
                                    <option value="REQUIRED">obvezen</option>
                                    <option value="RECOMMENDED">priporočen</option>
                                    <option value="EXCLUDED">izločen</option>
                                  </select>
                                </td>
                                <td>@(setRow.IsInherited ? $"podedovan: {setRow.DefinedAtCategoryName ?? setRow.DefinedAtCategoryCode}" : "tu")</td>
                                <td class="numeric @(setRow.ProductsWithValue == 0 ? "zero-value" : null)" title="Izdelki v tej kategoriji in pod njo, ki atribut imajo / vsi">@setRow.ProductsWithValue.ToString("N0") / @setRow.ProductCount.ToString("N0")</td>
                                <td>
                                  @if (!setRow.IsInherited)
                                  {
                                    <button type="button" class="small-action" disabled="@Busy" @onclick="() => RemoveOneAsync(row, setRow)">Odstrani</button>
                                  }
                                  else if (setRow.Level != "EXCLUDED")
                                  {
                                    @* Podedovane vrstice tu ni, zato je ni mogoce izbrisati; izlocitev jo skrije v tej kategoriji in pod njo. *@
                                    <button type="button" class="small-action" disabled="@Busy" @onclick="() => RemoveOneAsync(row, setRow)"
                                            title="@($"Atribut je določen na »{setRow.DefinedAtCategoryName ?? setRow.DefinedAtCategoryCode}«. Tu se izloči, tam ostane. Za odstranitev povsod ga označi in izberi »Odstrani pri izvoru«.")">Izloči tu</button>
                                  }
                                </td>
                              </tr>
                            }
                          </tbody>
                        </table>

                        @if (EditorSet.Suggestions.Count > 0)
                        {
                          <details class="attribute-suggestions" open>
                            <summary>Atributi, ki jih izdelki te kategorije že nosijo, a niso v naboru (@EditorSet.Suggestions.Count)</summary>
                            <ul>
                              @foreach (var suggestion in EditorSet.Suggestions)
                              {
                                <li>
                                  <span>@suggestion.AttributeName</span>
                                  <span class="muted">@suggestion.ProductsWithValue.ToString("N0") izdelkov</span>
                                  @if (suggestion.InRegister)
                                  {
                                    <button type="button" class="small-action" disabled="@Busy" @onclick='() => SetLevelAsync(row, suggestion.AttributeCode, "RECOMMENDED")'>priporočen</button>
                                    <button type="button" class="small-action" disabled="@Busy" @onclick='() => SetLevelAsync(row, suggestion.AttributeCode, "REQUIRED")'>obvezen</button>
                                  }
                                  else
                                  {
                                    <button type="button" class="small-action" disabled="@Busy" @onclick='() => CreateAndAddAsync(row, suggestion.AttributeName, "RECOMMENDED")'>ustvari v registru in dodaj</button>
                                  }
                                </li>
                              }
                            </ul>
                            @if (EditorSet.Suggestions.Any(suggestion => suggestion.InRegister))
                            {
                              <button type="button" class="secondary-button" disabled="@Busy" @onclick="() => AddAllSuggestionsAsync(row)">
                                Dodaj vse iz registra kot priporočene (@EditorSet.Suggestions.Count(suggestion => suggestion.InRegister))
                              </button>
                            }
                          </details>
                        }
                      </div>

                      <div class="editor-block">
                        <h3>Dodaj iz registra</h3>
                        <label class="visually-hidden" for="pick-search">Išči atribut</label>
                        <input id="pick-search" class="form-input search-input" type="search" placeholder="Išči po imenu ali kodi" @bind="PickerSearch" @bind:event="oninput" />
                        <ul class="picker-list" aria-label="Atributi registra, ki še niso v naboru">
                          @foreach (var option in PickerOptions)
                          {
                            <li>
                              <label>
                                <input type="checkbox" checked="@Picked.Contains(option.AttributeCode)" @onchange="args => TogglePick(option.AttributeCode, args.Value)" />
                                @option.Name <span class="code-value">@option.AttributeCode</span>
                              </label>
                            </li>
                          }
                          @if (PickerOptions.Count == 0) { <li class="muted">Ni atributa, ki bi ustrezal iskanju in še ne bil v naboru.</li> }
                        </ul>
                        @if (CanCreateFromSearch)
                        {
                          @* 177: atribut, ki ga register se nima, se ustvari tu — brez obiska /nastavitve/atributi. *@
                          <div class="editor-actions create-hint">
                            <span class="muted">V registru ni atributa »@PickerSearch.Trim()«.</span>
                            <button type="button" class="secondary-button" disabled="@Busy" @onclick="() => CreateAndAddAsync(row, PickerSearch.Trim(), PickLevel)">
                              Ustvari v registru in dodaj kot @LevelLabel(PickLevel)
                            </button>
                          </div>
                        }
                        <div class="editor-actions">
                          <label class="editor-field" for="pick-level">
                            <span class="editor-label">Raven</span>
                            <select id="pick-level" class="filter-select" @bind="PickLevel">
                              <option value="REQUIRED">obvezen</option>
                              <option value="RECOMMENDED">priporočen</option>
                              <option value="EXCLUDED">izločen</option>
                            </select>
                          </label>
                          <button type="button" class="primary-button" disabled="@(Busy || Picked.Count == 0)" @onclick="() => AddPickedAsync(row)">
                            Dodaj izbrane (@Picked.Count)
                          </button>
                        </div>

                        <h3>Prilepi seznam</h3>
                        <p class="muted">Ena vrstica na atribut: koda ali slovensko ime, po želji »;raven« (obvezen, priporočen, izločen). Primer: <span class="code-value">Nazivna moč;obvezen</span>. Vrstica brez ravni dobi spodnjo.</p>
                        <label class="visually-hidden" for="paste-text">Seznam atributov</label>
                        <textarea id="paste-text" class="form-input paste-area" rows="5" @bind="PasteText" placeholder="Garancija;obvezen&#10;Napetost&#10;IP zaščita"></textarea>
                        <div class="editor-actions">
                          <label class="editor-field" for="paste-level">
                            <span class="editor-label">Privzeta raven</span>
                            <select id="paste-level" class="filter-select" @bind="PasteLevel">
                              <option value="REQUIRED">obvezen</option>
                              <option value="RECOMMENDED">priporočen</option>
                              <option value="EXCLUDED">izločen</option>
                            </select>
                          </label>
                          <button type="button" class="primary-button" disabled="@(Busy || string.IsNullOrWhiteSpace(PasteText))" @onclick="() => ImportPasteAsync(row)">Uvozi seznam</button>
                        </div>
                        @if (PendingUnknown.Count > 0)
                        {
                          <div class="unknown-panel" role="region" aria-label="Imena, ki jih register nima">
                            <p><strong>@PendingUnknown.Count</strong> imen ni v registru atributov:
                              @string.Join(", ", PendingUnknown.Select(name => $"{name.Given} (koda {name.ProposedCode})"))</p>
                            <div class="editor-actions">
                              <button type="button" class="primary-button" disabled="@Busy" @onclick="() => CreateUnknownAndSaveAsync(row)">Ustvari v registru in dodaj vse (@PendingItems.Count)</button>
                              <button type="button" class="secondary-button" disabled="@(Busy || PendingItems.Count == PendingUnknown.Count)" @onclick="() => SaveKnownOnlyAsync(row)">Dodaj samo znane (@(PendingItems.Count - PendingUnknown.Count))</button>
                              <button type="button" class="small-action" disabled="@Busy" @onclick="ClearPending">Prekliči</button>
                            </div>
                          </div>
                        }

                        <h3>Kopiraj nabor druge kategorije</h3>
                        <div class="editor-actions">
                          <label class="editor-field" for="copy-tree">
                            <span class="editor-label">Drevo</span>
                            <select id="copy-tree" class="filter-select" @bind="CopyTree" @bind:after="LoadCopySourcesAsync">
                              @foreach (var tree in Trees) { <option value="@tree.CategoryTreeCode">@TreeLabel(tree.CategoryTreeCode)</option> }
                            </select>
                          </label>
                          <label class="editor-field copy-source" for="copy-category">
                            <span class="editor-label">Kategorija z naborom</span>
                            <PimPicker Id="copy-category" Options="CopySourceOptions(row)" @bind-Value="CopyCategoryOrNull"
                                       Placeholder="Vpiši ime ali pot kategorije z naborom …" EmptyText="V tem drevesu še ni kategorije z naborom." />
                          </label>
                        </div>
                        <div class="editor-actions">
                          <label class="filter-check"><input type="checkbox" @bind="CopyIncludeInherited" /> tudi podedovane vrstice vira</label>
                          <label class="filter-check"><input type="checkbox" @bind="CopyOverwrite" /> prepiši raven že obstoječih</label>
                          <button type="button" class="secondary-button" disabled="@(Busy || string.IsNullOrWhiteSpace(CopyCategory))" @onclick="() => CopyAsync(row)">Kopiraj nabor</button>
                        </div>
                      </div>
                    </div>
                  }
                </div>
              </td>
            </tr>
          }
        }
      </Rows>
    </PimTable>
  </PimState>
</section>

<details class="ui-card card-note section-gap">
  <summary>Kje nabor učinkuje</summary>
  <ul>
    <li><strong>Kartica izdelka</strong> (/izdelki/{id}): atributi iz nabora so v svoji skupini (tudi prazni, da jih je mogoče vpisati), ostali so označeni kot »izven nabora«.</li>
    <li><strong>Validacija</strong>: obvezen atribut je zahteva ERROR v spletnem profilu drevesa, priporočen je WARNING; upošteva jih naslednji tek validacije.</li>
    <li><strong>Spletni izvoz</strong> (katalog.csv, od 291): gredo vsi izpolnjeni atributi izdelka; izpusti se samo atribut z ravnjo <em>izločen</em>.</li>
    <li>Isti nabor ureja tudi gumb <strong>Atributi</strong> pri kategoriji na <a href="nastavitve/kategorije">/nastavitve/kategorije</a>; register atributov je na <a href="nastavitve/atributi">/nastavitve/atributi</a>.</li>
  </ul>
</details>

@code {
  static readonly IReadOnlyList<PimCrumb> Crumbs = [new("Nastavitve", "nastavitve"), new("Nabori atributov po kategorijah")];

  static readonly IReadOnlyList<PimColumn> Columns =
  [
    new("Kategorija"), new("Izdelki", Numeric: true), new("Obvezni", Numeric: true), new("Priporočeni", Numeric: true),
    new("Izločeni", Numeric: true), new("Atributi v naboru"), new("V rabi pri izdelkih", Numeric: true), new(""),
  ];

  IReadOnlyList<CategoryTreeService.TreeSummaryRow> Trees = [];
  CategoryTreeService.OverviewView? Overview;
  IReadOnlyList<CategoryTreeService.AttributeOptionRow> AttributeOptions = [];

  bool Loading = true;
  bool Busy;
  string? Error;
  string? Message;
  string TreeCode = "";
  string Search = "";
  string Level = "";
  bool OnlyWithoutSet;
  bool OnlyWithProducts;

  // Urejevalnik ene kategorije: isti bralni model in isti postopek kot na /nastavitve/kategorije (147).
  string? Editing;
  bool EditorLoading;
  CategoryTreeService.AttributeSetView EditorSet = new([], []);
  string PickerSearch = "";
  readonly HashSet<string> Picked = new(StringComparer.OrdinalIgnoreCase);
  string PickLevel = "RECOMMENDED";
  string PasteText = "";
  string PasteLevel = "RECOMMENDED";
  // 177: prilepljena imena, ki jih register nima — stran ponudi ustvarjanje namesto napake.
  IReadOnlyList<CategoryTreeService.ResolvedAttributeName> PendingUnknown = [];
  IReadOnlyList<CategoryTreeService.AttributeSetItem> PendingItems = [];
  string CopyTree = "";
  string CopyCategory = "";
  bool CopyIncludeInherited = true;
  bool CopyOverwrite;
  IReadOnlyList<CategoryTreeService.OverviewRow> CopySources = [];
  string? CopyCategoryOrNull { get => string.IsNullOrWhiteSpace(CopyCategory) ? null : CopyCategory; set => CopyCategory = value ?? ""; }

  IReadOnlyList<PimPickerOption> CopySourceOptions(CategoryTreeService.OverviewRow target) =>
    CopySources
      .Where(source => !(source.CategoryTreeCode == target.CategoryTreeCode && source.CategoryCode == target.CategoryCode))
      .Select(source => new PimPickerOption(source.CategoryCode, source.CategoryName, source.CategoryPath, source.LevelNo - 1, $"{source.EffectiveCount} atributov"))
      .ToList();

  string ResultSummary => Loading ? "Nalaganje …"
    : Error is not null ? "Rezultati niso na voljo"
    : Overview is null ? ""
    : $"{Overview.Rows.Count:N0} kategorij · {Overview.Rows.Count(row => row.HasOwnSet):N0} z lastnim naborom · {Overview.Rows.Count(row => !row.HasEffectiveSet):N0} brez nabora";

  static string Indent(int level) => $"padding-left:{(level - 1) * 22}px";

  /// <summary>Drevo se imenuje po spletni trgovini, ne po tehnicni kodi.</summary>
  static string TreeLabel(string treeCode) => treeCode switch
  {
    "svetila_si" => "Svetila",
    "videlektro" => "Videlektro",
    _ => treeCode,
  };

  static string Count(int effective, int own) => effective == 0 ? "—" : own == effective ? effective.ToString("N0") : $"{effective:N0} ({own:N0} tu)";

  int? LevelNo => int.TryParse(Level, out var value) ? value : null;

  /// <summary>Iskani niz ni ime ali koda nobenega atributa v registru (tudi ne takega, ki je ze v naboru).</summary>
  bool CanCreateFromSearch =>
    PickerSearch.Trim().Length >= 2
    && !AttributeOptions.Any(option => string.Equals(option.Name, PickerSearch.Trim(), StringComparison.OrdinalIgnoreCase)
      || string.Equals(option.AttributeCode, PickerSearch.Trim(), StringComparison.OrdinalIgnoreCase));

  IReadOnlyList<CategoryTreeService.AttributeOptionRow> PickerOptions =>
    AttributeOptions
      .Where(option => EditorSet.Rows.All(existing => !string.Equals(existing.AttributeCode, option.AttributeCode, StringComparison.OrdinalIgnoreCase)))
      .Where(option => string.IsNullOrWhiteSpace(PickerSearch)
        || option.Name.Contains(PickerSearch, StringComparison.OrdinalIgnoreCase)
        || option.AttributeCode.Contains(PickerSearch, StringComparison.OrdinalIgnoreCase))
      .ToList();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      Trees = await Tree.GetAttributeSetTreesAsync();
      // Svetila so danes edino drevo z izdelki in nabori; videlektro je izbira ob kliku.
      TreeCode = Trees.FirstOrDefault(tree => tree.CategoryTreeCode == "svetila_si")?.CategoryTreeCode
        ?? Trees.FirstOrDefault()?.CategoryTreeCode ?? "";
    }
    catch (Exception exception) { Error = exception.Message; }
    await LoadAsync();
  }

  async Task LoadAsync()
  {
    Loading = true;
    Error = null;
    try
    {
      Overview = string.IsNullOrWhiteSpace(TreeCode)
        ? null
        : await Tree.GetAttributeSetOverviewAsync(TreeCode, Search, OnlyWithoutSet, OnlyWithProducts, LevelNo);
    }
    catch (Exception exception) { Error = exception.Message; Overview = null; }
    finally { Loading = false; }
  }

  async Task ReloadTreesAsync()
  {
    try { Trees = await Tree.GetAttributeSetTreesAsync(); }
    catch (Exception exception) { Error = exception.Message; }
  }

  async Task SelectTreeAsync(string treeCode)
  {
    if (treeCode == TreeCode) return;
    TreeCode = treeCode;
    Editing = null;
    Message = null;
    await LoadAsync();
  }

  async Task ToggleEditorAsync(CategoryTreeService.OverviewRow row)
  {
    if (Editing == row.CategoryCode) { Editing = null; return; }
    Message = null;
    Error = null;
    Editing = row.CategoryCode;
    Selected.Clear();
    Pending = null;
    Undo = null;
    ParentCodes = null;
    Picked.Clear();
    PickerSearch = "";
    PasteText = "";
    ClearPending();
    CopyCategory = "";
    if (string.IsNullOrWhiteSpace(CopyTree)) CopyTree = TreeCode;
    await LoadEditorAsync(row);
    await LoadCopySourcesAsync();
  }

  async Task LoadEditorAsync(CategoryTreeService.OverviewRow row)
  {
    EditorLoading = true;
    try
    {
      if (AttributeOptions.Count == 0) AttributeOptions = await Tree.GetAttributeOptionsAsync();
      EditorSet = await Tree.GetAttributeSetAsync(row.CategoryTreeCode, row.CategoryCode);
      Selected.IntersectWith(EditorSet.Rows.Select(setRow => setRow.AttributeCode));
    }
    catch (Exception exception) { Error = exception.Message; EditorSet = new([], []); }
    finally { EditorLoading = false; }
  }

  /// <summary>Vir kopiranja je kategorija z ucinkovitim naborom; za izbrano drevo se seznam prebere posebej, ker je lahko drugo od odprtega.</summary>
  async Task LoadCopySourcesAsync()
  {
    CopyCategory = "";
    try
    {
      var view = CopyTree == TreeCode && Overview is not null && string.IsNullOrWhiteSpace(Search) && LevelNo is null && !OnlyWithoutSet && !OnlyWithProducts
        ? Overview
        : await Tree.GetAttributeSetOverviewAsync(CopyTree, null, false, false, null);
      CopySources = view.Rows.Where(source => source.HasEffectiveSet).ToList();
    }
    catch (Exception exception) { Error = exception.Message; CopySources = []; }
  }

  void TogglePick(string attributeCode, object? value)
  {
    if (value is true) Picked.Add(attributeCode); else Picked.Remove(attributeCode);
  }

  /// <summary>Po vsaki spremembi se osvezijo urejevalnik, pregled in stevci dreves — isti podatki na treh mestih ne smejo razhajati.</summary>
  async Task AfterChangeAsync(CategoryTreeService.OverviewRow row)
  {
    ParentCodes = null;
    await LoadEditorAsync(row);
    await LoadAsync();
    await ReloadTreesAsync();
  }

  /// <summary>Raven null odstrani atribut iz nabora te kategorije (podedovanega se tu ne da odstraniti, le izlociti).</summary>
  async Task SetLevelAsync(CategoryTreeService.OverviewRow row, string attributeCode, string? level)
  {
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      await Tree.SaveAttributeSetAsync(row.CategoryTreeCode, row.CategoryCode, attributeCode, level, await ActorAsync());
      Message = level is null
        ? $"Atribut {attributeCode} je odstranjen iz nabora kategorije »{row.CategoryName}«."
        : $"Atribut {attributeCode} je v naboru kategorije »{row.CategoryName}« kot {LevelLabel(level)}. Validacija ga upošteva ob naslednjem teku.";
      await AfterChangeAsync(row);
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  Task AddPickedAsync(CategoryTreeService.OverviewRow row) =>
    SaveManyAsync(row, Picked.Select(code => new CategoryTreeService.AttributeSetItem(code, PickLevel)).ToList(), clearPicked: true);

  Task AddAllSuggestionsAsync(CategoryTreeService.OverviewRow row) =>
    SaveManyAsync(row, EditorSet.Suggestions.Where(suggestion => suggestion.InRegister)
      .Select(suggestion => new CategoryTreeService.AttributeSetItem(suggestion.AttributeCode, "RECOMMENDED")).ToList(), clearPicked: false);

  /// <summary>Vrstica: »koda ali ime[;raven]«. Raven sme biti slovenska ali angleska; brez nje velja privzeta.</summary>
  Task ImportPasteAsync(CategoryTreeService.OverviewRow row)
  {
    var items = new List<CategoryTreeService.AttributeSetItem>();
    foreach (var line in PasteText.Split('\n'))
    {
      var parts = line.Split([';', '\t'], 2);
      var name = parts[0].Trim();
      if (name.Length == 0) continue;
      var level = parts.Length > 1 ? ParseLevel(parts[1]) : null;
      if (parts.Length > 1 && level is null)
      {
        Error = $"Neznana raven »{parts[1].Trim()}« v vrstici »{line.Trim()}«. Dovoljeno: obvezen, priporočen, izločen.";
        return Task.CompletedTask;
      }
      items.Add(new(name, level ?? PasteLevel));
    }
    return ImportResolvedAsync(row, items);
  }

  /// <summary>Neznana imena niso napaka, ampak ponudba: ustvari jih v registru ali dodaj samo znana.</summary>
  async Task ImportResolvedAsync(CategoryTreeService.OverviewRow row, IReadOnlyList<CategoryTreeService.AttributeSetItem> items)
  {
    if (items.Count == 0) return;
    Error = null;
    try
    {
      var resolved = await Tree.ResolveAttributeNamesAsync(items.Select(item => item.CodeOrName).ToList());
      var unknown = resolved.Where(name => name.AttributeCode is null).ToList();
      if (unknown.Count == 0) { await SaveManyAsync(row, items, clearPicked: false); return; }
      PendingUnknown = unknown;
      PendingItems = items;
      Message = null;
    }
    catch (Exception exception) { Error = exception.Message; }
  }

  async Task CreateUnknownAndSaveAsync(CategoryTreeService.OverviewRow row)
  {
    Busy = true;
    Error = null;
    try
    {
      var actor = await ActorAsync();
      foreach (var name in PendingUnknown) await Tree.EnsureAttributeDefinitionAsync(name.Given, actor);
      AttributeOptions = await Tree.GetAttributeOptionsAsync();
      var items = PendingItems;
      ClearPending();
      Busy = false;
      await SaveManyAsync(row, items, clearPicked: false);
      Message = $"V register je dodanih {PendingUnknownCountLast} atributov; " + Message;
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  int PendingUnknownCountLast;

  Task SaveKnownOnlyAsync(CategoryTreeService.OverviewRow row)
  {
    var unknown = PendingUnknown.Select(name => name.Given).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var known = PendingItems.Where(item => !unknown.Contains(item.CodeOrName)).ToList();
    ClearPending();
    return SaveManyAsync(row, known, clearPicked: false);
  }

  void ClearPending()
  {
    PendingUnknownCountLast = PendingUnknown.Count;
    PendingUnknown = [];
    PendingItems = [];
  }

  /// <summary>En atribut, ki ga register se nima: ustvari ga (koda iz imena) in ga takoj da v nabor.</summary>
  async Task CreateAndAddAsync(CategoryTreeService.OverviewRow row, string name, string level)
  {
    if (string.IsNullOrWhiteSpace(name)) return;
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      var actor = await ActorAsync();
      var code = await Tree.EnsureAttributeDefinitionAsync(name.Trim(), actor);
      AttributeOptions = await Tree.GetAttributeOptionsAsync();
      await Tree.SaveAttributeSetAsync(row.CategoryTreeCode, row.CategoryCode, code, level, actor);
      PickerSearch = "";
      Message = $"Atribut »{name.Trim()}« je v registru kot {code} in v naboru kategorije »{row.CategoryName}« kot {LevelLabel(level)}.";
      await AfterChangeAsync(row);
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  static string? ParseLevel(string text) => text.Trim().ToLowerInvariant() switch
  {
    "obvezen" or "obvezno" or "required" or "req" or "r" => "REQUIRED",
    "priporočen" or "priporocen" or "priporočeno" or "priporoceno" or "recommended" or "rec" or "p" => "RECOMMENDED",
    "izločen" or "izlocen" or "izločeno" or "izloceno" or "excluded" or "exc" or "x" => "EXCLUDED",
    _ => null,
  };

  async Task SaveManyAsync(CategoryTreeService.OverviewRow row, IReadOnlyList<CategoryTreeService.AttributeSetItem> items, bool clearPicked)
  {
    if (items.Count == 0) return;
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      var saved = await Tree.SaveAttributeSetBulkAsync(row.CategoryTreeCode, row.CategoryCode, items, await ActorAsync());
      Message = $"V nabor kategorije »{row.CategoryName}« je zapisanih {saved} atributov. Validacija jih upošteva ob naslednjem teku.";
      if (clearPicked) Picked.Clear();
      PasteText = "";
      await AfterChangeAsync(row);
    }
    // Postopek zavrne neznane atribute vse naenkrat z nastetimi imeni; sporocilo pride iz baze.
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  async Task CopyAsync(CategoryTreeService.OverviewRow row)
  {
    if (string.IsNullOrWhiteSpace(CopyCategory)) return;
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      var copied = await Tree.CopyAttributeSetAsync(CopyTree, CopyCategory, row.CategoryTreeCode, row.CategoryCode, CopyIncludeInherited, CopyOverwrite, await ActorAsync());
      var source = CopySources.FirstOrDefault(candidate => candidate.CategoryCode == CopyCategory)?.CategoryPath ?? CopyCategory;
      Message = copied == 0
        ? $"Iz »{source}« ni bilo česa prepisati: vse vrstice so v naboru kategorije »{row.CategoryName}« že bile."
        : $"Iz »{source}« je v nabor kategorije »{row.CategoryName}« prepisanih {copied} atributov.";
      await AfterChangeAsync(row);
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  // --- Izbira vrstic nabora in mnozicna dejanja (2026-09-29) ------------------------------------

  /// <summary>Ena sprememba nabora: atribut v kategoriji dobi raven (null = vrstica se odstrani).</summary>
  sealed record SetChange(string CategoryCode, string AttributeCode, string? Level);

  /// <param name="Undo">Spremembe, ki vrnejo stanje pred tem dejanjem.</param>
  sealed record SetChoice(string Label, bool Danger, IReadOnlyList<SetChange> Items, IReadOnlyList<SetChange> Undo, string Done);

  sealed record PendingAction(string Title, IReadOnlyList<string> Lines, IReadOnlyList<SetChoice> Choices);

  sealed record UndoAction(string Label, IReadOnlyList<SetChange> Items);

  readonly HashSet<string> Selected = new(StringComparer.OrdinalIgnoreCase);
  string BulkLevel = "RECOMMENDED";
  PendingAction? Pending;
  UndoAction? Undo;

  IReadOnlyList<CategoryTreeService.AttributeSetRow> SelectedRows =>
    EditorSet.Rows.Where(setRow => Selected.Contains(setRow.AttributeCode)).ToList();

  IReadOnlyList<CategoryTreeService.AttributeSetRow> EmptyRows =>
    EditorSet.Rows.Where(setRow => setRow.ProductsWithValue == 0 && setRow.Level != "EXCLUDED").ToList();

  void ToggleSelected(string attributeCode, object? value)
  {
    if (value is true) Selected.Add(attributeCode); else Selected.Remove(attributeCode);
    Pending = null;
  }

  void SelectAll(bool on)
  {
    Selected.Clear();
    if (on) Selected.UnionWith(EditorSet.Rows.Select(setRow => setRow.AttributeCode));
    Pending = null;
  }

  void SelectEmpty()
  {
    Selected.Clear();
    Selected.UnionWith(EmptyRows.Select(setRow => setRow.AttributeCode));
    Pending = null;
  }

  void SelectedClear() { Selected.Clear(); Pending = null; }

  static string SourceName(CategoryTreeService.AttributeSetRow setRow) => setRow.DefinedAtCategoryName ?? setRow.DefinedAtCategoryCode;

  /// <summary>Slovenska dvojina in mnozina: 1 atribut, 2 atributa, 3 atributi, 5 atributov.</summary>
  static string Attributes(int count) => (count % 100) switch
  {
    1 => $"{count} atribut", 2 => $"{count} atributa", 3 or 4 => $"{count} atributi", _ => $"{count} atributov",
  };

  /// <summary>Atributi, ki jih ima (neizlocene) ze nadrejena kategorija; prebere se sele, ko je potrebno.</summary>
  HashSet<string>? ParentCodes;

  async Task<HashSet<string>> ParentCodesAsync(CategoryTreeService.OverviewRow row)
  {
    if (ParentCodes is not null) return ParentCodes;
    var parent = string.IsNullOrWhiteSpace(row.ParentCategoryCode) ? null : await Tree.GetAttributeSetAsync(row.CategoryTreeCode, row.ParentCategoryCode);
    ParentCodes = new(parent?.Rows.Where(setRow => setRow.Level != "EXCLUDED").Select(setRow => setRow.AttributeCode) ?? [], StringComparer.OrdinalIgnoreCase);
    return ParentCodes;
  }

  /// <summary>
  /// »Odstrani« v tej kategoriji, tako da atributa tu res ni vec:
  /// - lastna vrstica se izbrise; ce ima atribut tudi nadrejena kategorija, bi se po izbrisu pojavil kot
  ///   podedovan (izmerjeno 2026-09-29 na »Dolzina«), zato se namesto tega tu izloci;
  /// - podedovana se tu izloci (pri izvoru ostane, ker jo tam morda rabijo sestrske kategorije);
  /// - ze izlocena, ki je zgoraj ni vec, se samo pocisti; ostale izlocene nimajo kaj spremeniti.
  /// </summary>
  static (SetChange Change, SetChange Undo)? RemoveHere(CategoryTreeService.OverviewRow row, CategoryTreeService.AttributeSetRow setRow, HashSet<string> parentCodes)
  {
    var inParent = parentCodes.Contains(setRow.AttributeCode);
    var undoLevel = setRow.IsInherited ? null : setRow.Level;
    string? level;
    if (setRow.Level == "EXCLUDED")
    {
      if (setRow.IsInherited || inParent) return null;
      level = null;
    }
    else level = setRow.IsInherited || inParent ? "EXCLUDED" : null;
    return (new(row.CategoryCode, setRow.AttributeCode, level), new(row.CategoryCode, setRow.AttributeCode, undoLevel));
  }

  async Task RemoveOneAsync(CategoryTreeService.OverviewRow row, CategoryTreeService.AttributeSetRow setRow)
  {
    try
    {
      if (RemoveHere(row, setRow, await ParentCodesAsync(row)) is not { } change)
      {
        Message = $"Atribut {setRow.AttributeName} je v kategoriji »{row.CategoryName}« že izločen. Da izgine s seznama, ga označi in izberi »Odstrani pri izvoru«.";
        return;
      }
      var done = change.Change.Level == "EXCLUDED"
        ? $"Atribut {setRow.AttributeName} je v kategoriji »{row.CategoryName}« izločen; pri nadrejeni kategoriji ostane."
        : $"Atribut {setRow.AttributeName} je odstranjen iz nabora kategorije »{row.CategoryName}«.";
      await ApplyAsync(row, new SetChoice("", false, [change.Change], [change.Undo], done));
    }
    catch (Exception exception) { Error = exception.Message; }
  }

  async Task AskRemoveHere()
  {
    var editing = Overview?.Rows.FirstOrDefault(candidate => candidate.CategoryCode == Editing);
    if (editing is null) return;
    Error = null;
    try
    {
      var parentCodes = await ParentCodesAsync(editing);
      var rows = SelectedRows;
      var changes = rows.Select(setRow => RemoveHere(editing, setRow, parentCodes)).OfType<(SetChange Change, SetChange Undo)>().ToList();
      var deleted = changes.Count(change => change.Change.Level is null);
      var excluded = changes.Count - deleted;
      var unchanged = rows.Count - changes.Count;
      var lines = new List<string>();
      if (deleted > 0) lines.Add($"Vrstica te kategorije se izbriše — {Attributes(deleted)}.");
      if (excluded > 0) lines.Add($"Tu se izloči, ker ga določa nadrejena kategorija (tam ostane za ostale podkategorije) — {Attributes(excluded)}.");
      if (unchanged > 0) lines.Add($"Že izločeno, brez spremembe — {Attributes(unchanged)}. Da izgine s seznama, uporabi »Odstrani pri izvoru«.");
      lines.Add("Velja tudi za podkategorije. Kartica in validacija (ob naslednjem teku) atributa ne ponujata več; iz katalog.csv ga izpusti samo raven »izločen«.");
      Pending = new($"Odstraniti izbrane atribute iz nabora kategorije »{editing.CategoryName}«? ({Attributes(changes.Count)})", lines,
        [new($"Odstrani ({changes.Count})", true, changes.Select(change => change.Change).ToList(), changes.Select(change => change.Undo).ToList(),
          $"Odstranjeno iz nabora kategorije »{editing.CategoryName}«: {Attributes(changes.Count)}.")]);
    }
    catch (Exception exception) { Error = exception.Message; }
  }

  /// <summary>
  /// »Odstrani pri izvoru«: vrstica se izbrise v kategoriji, kjer je dolocena, torej tudi pri vseh njenih
  /// podkategorijah. Pred potrditvijo se za vsak izvor prebere, koliko izdelkov pod njim atribut sploh ima,
  /// da je mogoce varno odstraniti samo tiste, ki so prazni povsod.
  /// </summary>
  async Task AskRemoveAtSourceAsync(CategoryTreeService.OverviewRow row)
  {
    Busy = true;
    Error = null;
    Pending = null;
    try
    {
      var rows = SelectedRows;
      var sources = new Dictionary<string, CategoryTreeService.AttributeSetView>(StringComparer.OrdinalIgnoreCase);
      foreach (var source in rows.Select(setRow => setRow.DefinedAtCategoryCode).Distinct(StringComparer.OrdinalIgnoreCase))
        sources[source] = string.Equals(source, row.CategoryCode, StringComparison.OrdinalIgnoreCase)
          ? EditorSet
          : await Tree.GetAttributeSetAsync(row.CategoryTreeCode, source);

      var lines = new List<string>();
      var all = new List<SetChange>();
      var allUndo = new List<SetChange>();
      var empty = new List<SetChange>();
      var emptyUndo = new List<SetChange>();
      foreach (var group in rows.GroupBy(setRow => setRow.DefinedAtCategoryCode, StringComparer.OrdinalIgnoreCase))
      {
        var atSource = sources[group.Key].Rows.ToDictionary(setRow => setRow.AttributeCode, StringComparer.OrdinalIgnoreCase);
        var withValue = new List<string>();
        var productCount = atSource.Values.FirstOrDefault()?.ProductCount ?? 0;
        foreach (var setRow in group)
        {
          var change = new SetChange(group.Key, setRow.AttributeCode, null);
          var undo = new SetChange(group.Key, setRow.AttributeCode, setRow.Level);
          all.Add(change);
          allUndo.Add(undo);
          var values = atSource.TryGetValue(setRow.AttributeCode, out var sourceRow) ? sourceRow.ProductsWithValue : 0;
          if (values == 0) { empty.Add(change); emptyUndo.Add(undo); }
          else withValue.Add($"{setRow.AttributeName} ({values:N0})");
        }
        var name = SourceName(group.First());
        var here = string.Equals(group.Key, row.CategoryCode, StringComparison.OrdinalIgnoreCase);
        lines.Add($"»{name}«{(here ? " (ta kategorija)" : " in vse njene podkategorije")}: {Attributes(group.Count())}, "
          + $"{group.Count() - withValue.Count} brez vrednosti pri {productCount:N0} izdelkih"
          + (withValue.Count > 0 ? $"; z vrednostmi (št. izdelkov): {string.Join(", ", withValue)}." : "."));
        if (group.Any(setRow => setRow.Level == "EXCLUDED"))
          lines.Add($"Pri »{name}« so med izbranimi tudi izločeni atributi: če jih ima kakšna nadrejena kategorija, se po odstranitvi izločitve spet pojavijo.");
      }
      lines.Add("Vrednosti pri izdelkih ostanejo; spremeni se, kateri atributi so na kartici in v validaciji. Izpolnjen atribut gre v katalog.csv še naprej, razen če je kje izločen.");

      Pending = new($"Odstraniti izbrane atribute pri izvoru? ({Attributes(all.Count)})", lines,
      [
        new($"Odstrani samo prazne ({empty.Count})", false, empty, emptyUndo,
          $"Odstranjeno pri izvoru (brez vrednosti pri vseh izdelkih): {Attributes(empty.Count)}."),
        new($"Odstrani vse izbrane ({all.Count})", true, all, allUndo,
          $"Odstranjeno pri izvoru: {Attributes(all.Count)}."),
      ]);
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  Task SetLevelSelectedAsync(CategoryTreeService.OverviewRow row)
  {
    // Podedovana vrstica z isto ravnjo bi tu dobila odvec lastno kopijo.
    var rows = SelectedRows.Where(setRow => setRow.Level != BulkLevel).ToList();
    if (rows.Count == 0) { Message = $"Vsi izbrani atributi so že {LevelLabel(BulkLevel)}."; return Task.CompletedTask; }
    return ApplyAsync(row, new SetChoice("", false,
      rows.Select(setRow => new SetChange(row.CategoryCode, setRow.AttributeCode, BulkLevel)).ToList(),
      rows.Select(setRow => new SetChange(row.CategoryCode, setRow.AttributeCode, setRow.IsInherited ? null : setRow.Level)).ToList(),
      $"V kategoriji »{row.CategoryName}« je zdaj {LevelLabel(BulkLevel)}: {Attributes(rows.Count)}."));
  }

  /// <summary>Zapis po kategorijah prek istega postopka kot drugje (147/170): revizija v b2b.AuditLog in zahteve validacije.</summary>
  async Task WriteChangesAsync(CategoryTreeService.OverviewRow row, IReadOnlyList<SetChange> changes)
  {
    var actor = await ActorAsync();
    foreach (var group in changes.GroupBy(change => change.CategoryCode, StringComparer.OrdinalIgnoreCase))
      await Tree.SaveAttributeSetBulkAsync(row.CategoryTreeCode, group.Key,
        group.Select(change => new CategoryTreeService.AttributeSetItem(change.AttributeCode, change.Level)).ToList(), actor);
  }

  async Task ApplyAsync(CategoryTreeService.OverviewRow row, SetChoice choice)
  {
    if (choice.Items.Count == 0) return;
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      await WriteChangesAsync(row, choice.Items);
      Pending = null;
      Selected.Clear();
      Undo = new(choice.Done, choice.Undo);
      Message = choice.Done + " Validacija jih upošteva ob naslednjem teku.";
      await AfterChangeAsync(row);
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  async Task UndoAsync(CategoryTreeService.OverviewRow row)
  {
    if (Undo is null) return;
    Busy = true;
    Message = null;
    Error = null;
    try
    {
      await WriteChangesAsync(row, Undo.Items);
      Message = $"Razveljavljeno, prejšnja raven vrnjena: {Attributes(Undo.Items.Count)}.";
      Undo = null;
      await AfterChangeAsync(row);
    }
    catch (Exception exception) { Error = exception.Message; }
    finally { Busy = false; }
  }

  async Task<string> ActorAsync()
  {
    var state = await Authentication.GetAuthenticationStateAsync();
    return state.User.Identity?.Name ?? "neznan";
  }

  static string LevelLabel(string level) => level switch
  {
    "REQUIRED" => "obvezen", "RECOMMENDED" => "priporočen", "EXCLUDED" => "izločen", _ => level,
  };
}
