@* Zgodovinska izvedba je ohranjena brez javne poti zaradi sledljivosti stare F10 pogodbe.
   Aktivna kartica izdelka je ProductCard.razor. *@
@attribute [Authorize]
@rendermode InteractiveServer
@inject PIM.Intranet.Services.IntranetDataService Data
<PageTitle>Izdelek</PageTitle>
@if (Loading) { <div class="ui-card loading-state" role="status">Nalaganje izdelka …</div> }
else if (Error is not null) { <div class="ui-card error-state" role="alert">@Error</div> }
else if (Detail is null) { <div class="ui-card empty-state">Izdelek ne obstaja v aktivni organizaciji.</div> }
else {
  <nav class="breadcrumb" aria-label="Pot do izdelka">
    <a href="izdelki">Izdelki</a><span class="breadcrumb-sep" aria-hidden="true"></span><span class="breadcrumb-current" aria-current="page">@Detail.Header.ItemId</span>
  </nav>
  <div class="page-header">
    <div>
      <h1>@Detail.Header.ItemId</h1>
      <p class="identity-line"><span>ItemID: @Detail.Header.ItemId</span>@if (Detail.Header.Ean is not null) { <span>EAN: @Detail.Header.Ean</span> }</p>
    </div>
    <div class="header-chips">
      <span class="status-chip @Chip(Detail.Header.Status)"><span class="visually-hidden">Status: </span>@Detail.Header.Status</span>
      <span class="flag-chip @(Detail.Header.IsActive ? "on" : "off")">Aktiven: @YesNo(Detail.Header.IsActive)</span>
      <span class="flag-chip @(Detail.Header.WebPublish ? "on" : "off")">Za splet: @YesNo(Detail.Header.WebPublish)</span>
    </div>
  </div>

  @* Povzetek stanja: ena kartica na dejanski validacijski profil, zadnja kartica je dejanska popolnost izdelka. *@
  <section class="detail-summary" aria-labelledby="povzetek-izdelka-naslov">
    <h2 id="povzetek-izdelka-naslov" class="visually-hidden">Povzetek stanja izdelka</h2>
    <div class="summary-grid">
      @foreach (var profile in Detail.Profiles)
      {
        <article class="ui-card summary-card">
          <h3>@profile.ProfileCode</h3>
          <p class="summary-status"><span class="status-chip @Chip(profile.Status)"><span class="visually-hidden">Status: </span>@profile.Status</span></p>
          <p class="summary-issues">@Detail.Issues.Count(row => row.ProfileCode == profile.ProfileCode) odprtih težav</p>
        </article>
      }
      <article class="ui-card summary-card completeness-card">
        <h3>Popolnost</h3>
        <p class="summary-value">@Detail.Header.Completeness.ToString("0.#") %</p>
        <span class="progress-track" role="progressbar" aria-label="Popolnost izdelka" aria-valuenow="@Number(Detail.Header.Completeness)" aria-valuemin="0" aria-valuemax="100"><i class="@(Detail.Header.Completeness < 75 ? "warn" : null)" aria-hidden="true" style="width:@Percent(Detail.Header.Completeness)"></i></span>
      </article>
    </div>
  </section>

  <div class="page-tabs" role="tablist" aria-label="Sklopi izdelka">
    <button type="button" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="@Flag(Tab=="overview")" class="page-tab @(Tab=="overview"?"active":null)" @onclick='()=>Tab="overview"'>Pregled</button><button type="button" role="tab" id="tab-profiles" aria-controls="panel-profiles" aria-selected="@Flag(Tab=="profiles")" class="page-tab @(Tab=="profiles"?"active":null)" @onclick='()=>Tab="profiles"'>Validacijski profili (@Detail.Profiles.Count)</button><button type="button" role="tab" id="tab-issues" aria-controls="panel-issues" aria-selected="@Flag(Tab=="issues")" class="page-tab @(Tab=="issues"?"active":null)" @onclick='()=>Tab="issues"'>Odprte težave (@Detail.Issues.Count)</button><button type="button" role="tab" id="tab-history" aria-controls="panel-history" aria-selected="@Flag(Tab=="history")" class="page-tab @(Tab=="history"?"active":null)" @onclick='()=>Tab="history"'>Zgodovina (@Detail.History.Count)</button>
  </div>

  <section id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0" class="ui-card panel tab-panel" hidden="@(Tab!="overview")">
    <h2>Podatki izdelka</h2>
    <table class="data-table detail-table"><caption>Razpoložljivi podatki izdelka</caption><tbody><tr><th scope="row">Artikel</th><td>@Detail.Header.ItemId</td></tr>@if(Detail.Header.Ean is not null){<tr><th scope="row">EAN</th><td>@Detail.Header.Ean</td></tr>}@if(Detail.Header.Uom is not null){<tr><th scope="row">Enota mere</th><td>@Detail.Header.Uom</td></tr>}@if(Detail.Header.ItemGroup is not null){<tr><th scope="row">Skupina</th><td>@Detail.Header.ItemGroup</td></tr>}@if(Detail.Header.Department is not null){<tr><th scope="row">Oddelek</th><td>@Detail.Header.Department</td></tr>}@if(Detail.Header.Manufacturer is not null){<tr><th scope="row">Proizvajalec</th><td>@Detail.Header.Manufacturer</td></tr>}@if(Detail.Header.Supplier is not null){<tr><th scope="row">Dobavitelj</th><td>@Detail.Header.Supplier</td></tr>}<tr><th scope="row">Popolnost</th><td>@Detail.Header.Completeness.ToString("0.#") %</td></tr>@if(Detail.Header.LastValidatedUtc is not null){<tr><th scope="row">Zadnja validacija</th><td>@Detail.Header.LastValidatedUtc.Value.ToLocalTime().ToString("g")</td></tr>}</tbody></table>
  </section>

  <section id="panel-profiles" role="tabpanel" aria-labelledby="tab-profiles" tabindex="0" class="ui-card data-card tab-panel" hidden="@(Tab!="profiles")">
    @if(Detail.Profiles.Count==0){<div class="empty-state">Izdelek nima izračunanih validacijskih profilov.</div>}else{<div class="table-scroll" role="region" tabindex="0" aria-label="Tabela validacijskih profilov izdelka"><table class="data-table"><caption>Validacijski profili izdelka</caption><thead><tr><th scope="col">Profil</th><th scope="col">Status</th><th scope="col">Popolnost</th><th scope="col">Validirano</th></tr></thead><tbody>@foreach(var row in Detail.Profiles){<tr><td>@row.ProfileCode</td><td><span class="status-chip @Chip(row.Status)"><span class="visually-hidden">Status: </span>@row.Status</span></td><td><div class="progress-line"><span class="progress-track" role="progressbar" aria-label="Popolnost profila @row.ProfileCode" aria-valuenow="@Number(row.Completeness)" aria-valuemin="0" aria-valuemax="100"><i class="@(row.Completeness < 75 ? "warn" : null)" aria-hidden="true" style="width:@Percent(row.Completeness)"></i></span><span class="progress-value">@row.Completeness.ToString("0.#") %</span></div></td><td>@row.ValidatedUtc.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div>}
  </section>

  <section id="panel-issues" role="tabpanel" aria-labelledby="tab-issues" tabindex="0" class="ui-card data-card tab-panel" hidden="@(Tab!="issues")">
    @if(Detail.Issues.Count==0){<div class="empty-state">Izdelek nima odprtih validacijskih težav.</div>}else{<div class="table-scroll" role="region" tabindex="0" aria-label="Tabela odprtih validacijskih težav izdelka"><table class="data-table"><caption>Odprte validacijske težave izdelka</caption><thead><tr><th scope="col">Profil</th><th scope="col">Koda</th><th scope="col">Sporočilo</th><th scope="col">Zadnji pojav</th></tr></thead><tbody>@foreach(var row in Detail.Issues){<tr><td>@row.ProfileCode</td><td>@row.IssueCode</td><td>@row.Message</td><td>@row.LastDetectedUtc.ToLocalTime().ToString("g")</td></tr>}</tbody></table></div>}
  </section>
  <section id="panel-history" role="tabpanel" aria-labelledby="tab-history" tabindex="0" class="ui-card data-card tab-panel" hidden="@(Tab!="history")">
    <h2>Zgodovina sprememb</h2>
    @if(Detail.History.Count==0){<div class="empty-state">Za ta izdelek še ni zabeleženih sprememb sledljivih polj.</div>}else{<div class="table-scroll" role="region" tabindex="0" aria-label="Tabela zgodovine sprememb izdelka"><table class="data-table"><caption>Spremembe vrednosti izdelka po poljih</caption><thead><tr><th scope="col">Polje</th><th scope="col">Stara vrednost</th><th scope="col">Nova vrednost</th><th scope="col">Vir</th><th scope="col">Spremenil</th><th scope="col">Čas</th><th scope="col">Lastnik</th></tr></thead><tbody>@foreach(var row in Detail.History){<tr><td>@row.FieldKey</td><td>@Value(row.OldValue)</td><td>@Value(row.NewValue)</td><td>@row.ChangeSource</td><td>@row.ChangedBy</td><td>@row.ChangedAtUtc.ToLocalTime().ToString("g")</td><td>@row.Owner</td></tr>}</tbody></table></div>}
  </section>
}
@code { [Parameter] public long ProductId {get;set;} PIM.Intranet.Services.ProductDetailView? Detail; bool Loading=true; string? Error; string Tab="overview"; protected override async Task OnParametersSetAsync(){Loading=true;Error=null;try{var org=await Data.GetCurrentOrganizationAsync();if(org is null){Error="Aktivna organizacija ni na voljo.";return;}Detail=await Data.GetProductDetailAsync(org.OrganizationId,ProductId);}catch{Error="Izdelka trenutno ni mogoče naložiti.";}finally{Loading=false;}} static string Chip(string v)=>v=="VALID"?"good":v=="PENDING"?"warn":"bad";
  static string YesNo(bool value)=>value?"Da":"Ne";
  // aria-selected mora biti izpisan kot niz; logična vrednost bi atribut izpustila.
  static string Flag(bool value)=>value?"true":"false";
  static string Percent(decimal value)=>$"{Math.Clamp(value,0,100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%";
  // aria-valuenow mora biti številka s piko ne glede na območne nastavitve strežnika.
  static string Number(decimal value)=>Math.Clamp(value,0,100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
  static string Value(string? value)=>string.IsNullOrEmpty(value)?"—":value;
}
