@page "/izdelki/{ProductId:long}"
@attribute [Authorize]
@inject PIM.Intranet.Services.IntranetDataService Data
<PageTitle>Izdelek</PageTitle>
@if (Loading) { <div class="ui-card loading-state">Nalaganje izdelka …</div> }
else if (Error is not null) { <div class="ui-card error-state">@Error</div> }
else if (Detail is null) { <div class="ui-card empty-state">Izdelek ne obstaja v aktivni organizaciji.</div> }
else {
  <div class="page-header"><div><p><a href="izdelki">Izdelki</a> › @Detail.Header.ItemId</p><h1>@Detail.Header.ItemId</h1>@if(Detail.Header.Ean is not null){<p>EAN: @Detail.Header.Ean</p>}</div><span class="status-chip @Chip(Detail.Header.Status)">@Detail.Header.Status</span></div>
  <div class="page-tabs"><button class="page-tab @(Tab=="overview"?"active":null)" @onclick='()=>Tab="overview"'>Pregled</button><button class="page-tab @(Tab=="profiles"?"active":null)" @onclick='()=>Tab="profiles"'>Validacijski profili (@Detail.Profiles.Count)</button><button class="page-tab @(Tab=="issues"?"active":null)" @onclick='()=>Tab="issues"'>Odprte težave (@Detail.Issues.Count)</button></div>
  @if(Tab=="overview") { <section class="ui-card panel"><h2>Podatki izdelka</h2><table class="data-table"><caption>Razpoložljivi podatki izdelka</caption><tbody><tr><th>Artikel</th><td>@Detail.Header.ItemId</td></tr>@if(Detail.Header.Ean is not null){<tr><th>EAN</th><td>@Detail.Header.Ean</td></tr>}@if(Detail.Header.Uom is not null){<tr><th>Enota mere</th><td>@Detail.Header.Uom</td></tr>}@if(Detail.Header.ItemGroup is not null){<tr><th>Skupina</th><td>@Detail.Header.ItemGroup</td></tr>}@if(Detail.Header.Department is not null){<tr><th>Oddelek</th><td>@Detail.Header.Department</td></tr>}@if(Detail.Header.Manufacturer is not null){<tr><th>Proizvajalec</th><td>@Detail.Header.Manufacturer</td></tr>}@if(Detail.Header.Supplier is not null){<tr><th>Dobavitelj</th><td>@Detail.Header.Supplier</td></tr>}<tr><th>Popolnost</th><td>@Detail.Header.Completeness.ToString("0.#") %</td></tr></tbody></table></section> }
  else if(Tab=="profiles") { <section class="ui-card data-card">@if(Detail.Profiles.Count==0){<div class="empty-state">Izdelek nima izračunanih validacijskih profilov.</div>}else{<table class="data-table"><caption>Validacijski profili izdelka</caption><thead><tr><th>Profil</th><th>Status</th><th>Popolnost</th><th>Validirano</th></tr></thead><tbody>@foreach(var row in Detail.Profiles){<tr><td>@row.ProfileCode</td><td><span class="status-chip @Chip(row.Status)">@row.Status</span></td><td>@row.Completeness.ToString("0.#") %</td><td>@row.ValidatedUtc.ToLocalTime().ToString("g")</td></tr>}</tbody></table>}</section> }
  else { <section class="ui-card data-card">@if(Detail.Issues.Count==0){<div class="empty-state">Izdelek nima odprtih validacijskih težav.</div>}else{<table class="data-table"><caption>Odprte validacijske težave izdelka</caption><thead><tr><th>Profil</th><th>Koda</th><th>Sporočilo</th><th>Zadnji pojav</th></tr></thead><tbody>@foreach(var row in Detail.Issues){<tr><td>@row.ProfileCode</td><td>@row.IssueCode</td><td>@row.Message</td><td>@row.LastDetectedUtc.ToLocalTime().ToString("g")</td></tr>}</tbody></table>}</section> }
}
@code { [Parameter] public long ProductId {get;set;} PIM.Intranet.Services.ProductDetailView? Detail; bool Loading=true; string? Error; string Tab="overview"; protected override async Task OnParametersSetAsync(){Loading=true;Error=null;try{var org=await Data.GetCurrentOrganizationAsync();if(org is null){Error="Aktivna organizacija ni na voljo.";return;}Detail=await Data.GetProductDetailAsync(org.OrganizationId,ProductId);}catch{Error="Izdelka trenutno ni mogoče naložiti.";}finally{Loading=false;}} static string Chip(string v)=>v=="VALID"?"good":v=="PENDING"?"warn":"bad"; }
