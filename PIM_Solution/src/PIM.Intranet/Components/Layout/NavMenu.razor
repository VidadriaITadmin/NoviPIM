@inject AuthenticationStateProvider AuthenticationStateProvider

@* Vir navigacije je PimNavigation (koda), ne sec.Navigation* (baza) — glej razlago v
   PimNavigation.cs. Bralni model v bazi ostaja, samo menija ne polni vec. *@

<a class="pim-brand" href="nadzorna-plosca" aria-label="PIM nadzorna plošča">
  <span class="pim-mark" aria-hidden="true">P</span>
  <span class="pim-brand-copy"><strong>PIM</strong><small>Upravljanje podatkov</small></span>
</a>
<nav class="app-navigation">
  @foreach (var section in Sections)
  {
    @if (section.Title is not null)
    {
      <div class="navigation-group">@section.Title</div>
    }
    @foreach (var item in section.Items)
    {
      <NavLink class="navigation-link" href="@item.Route" Match="Match(item.Route)">
        <span class="navigation-icon @item.Icon" aria-hidden="true"></span>
        <span class="navigation-copy">
          <strong>@item.Label</strong>
          @if (!string.IsNullOrWhiteSpace(item.Description))
          {
            <small>@item.Description</small>
          }
        </span>
        @if (item.IsHub)
        {
          <span class="navigation-chevron" aria-hidden="true">›</span>
        }
      </NavLink>
    }
  }
</nav>

@code {
  IReadOnlyList<PIM.Intranet.Services.PimNavSection> Sections = [];

  protected override async Task OnInitializedAsync()
  {
    var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var roles = state.User.Claims
      .Where(claim => claim.Type == System.Security.Claims.ClaimTypes.Role)
      .Select(claim => claim.Value)
      .ToHashSet(StringComparer.Ordinal);
    Sections = PIM.Intranet.Services.PimNavigation.For(roles);
  }

  // Razdelilne strani morajo ostati poudarjene tudi na svojih podstraneh (nastavitve/atributi),
  // seznami z lastno podrobnostjo pa prav tako (izdelki/123).
  static NavLinkMatch Match(string route) => NavLinkMatch.Prefix;
}
