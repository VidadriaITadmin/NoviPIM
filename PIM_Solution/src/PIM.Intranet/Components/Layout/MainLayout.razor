@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <form method="post" action="/odjava"><AntiforgeryToken /><button type="submit" class="btn btn-link">Odjava</button></form>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Prišlo je do nepričakovane napake.
    <a href="" class="reload">Ponovno naloži</a>
    <a class="dismiss">🗙</a>
</div>
