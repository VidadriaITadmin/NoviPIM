@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PIM.Intranet.Services.AdminConsoleService Nadzor
@inject NavigationManager Navigation

@* Preklop navigacije je CSS, ne JavaScript in ne vezje: postavitev ostane staticni SSR, ker
   obrazca za prijavo in odjavo potrebujeta antiforgery, ta pa v interaktivnem nacinu ne velja. *@
<input type="checkbox" id="pim-menu-toggle" class="menu-toggle-input" aria-hidden="true" tabindex="-1" />
<div class="app-shell">
  <aside id="primary-navigation" class="app-sidebar"><NavMenu /></aside>
  <label class="menu-scrim" for="pim-menu-toggle" aria-hidden="true"></label>
  <main class="app-main">
    <header class="app-topbar">
      <label class="menu-glyph" for="pim-menu-toggle" aria-controls="primary-navigation" title="Preklopi glavno navigacijo">
        <span class="menu-glyph-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Preklopi glavno navigacijo</span>
      </label>
      <div class="flow-context" title="@Lifecycle.Description">
        <small>Podatkovni tok</small><strong>@Lifecycle.Label</strong>
      </div>
      <div class="topbar-spacer"></div>

      @* Zvonec je skrbnikov. Prej je vodil naravnost na /sistem, ne da bi skrbnik videl, kaj
         sploh caka — zdaj <details> odpre spustni seznam zadnjih obvestil brez vezja Blazorja
         (glava ostaja staticna SSR), povezava na dno pa še vedno vodi na polni pregled.
         <details> se sam zapre samo ob ponovnem kliku na zvonec; klik kamorkoli drugam, Escape
         in premik fokusa ven ga zaprejo prek wwwroot/js/pim-shell.js (vkljucen v App.razor). *@
      @if (IsAdmin)
      {
        <details class="notification-menu">
          <summary class="notification-button @(Attention.Total > 0 ? "notification-alarm" : null)" title="@AlertTitle">
            <span class="notification-icon" aria-hidden="true"></span>
            @if (Attention.Total > 0)
            {
              <span class="notification-count">@Attention.Total</span>
            }
            <span class="visually-hidden">@AlertTitle</span>
          </summary>
          <div class="notification-panel">
            <div class="notification-panel-header">
              <strong>Obvestila</strong>
              @if (RecentAlerts.Count > 0)
              {
                <form method="post" action="obvestila/precitaj-vse">
                  <AntiforgeryToken />
                  <input type="hidden" name="vrniNa" value="@ReturnPath" />
                  <button type="submit" class="notification-mark-all">Označi vse kot prebrano</button>
                </form>
              }
            </div>
            @if (RecentAlerts.Count == 0)
            {
              <p class="notification-empty">Trenutno ni novih obvestil.</p>
            }
            else
            {
              <ul class="notification-list">
                @foreach (var alert in RecentAlerts)
                {
                  <li class="notification-item severity-@Chip(alert.Severity) notification-unseen">
                    @* Odpiranje obvestila ga v istem POST-u oznaci kot prebranega in nato odpre pravo
                       datoteko/pogled. Po preusmeritvi se glava znova izrise z novim stevcem, zato
                       zvonec ne obdrzi starega stevila in seznam ne polni ze pregledanih zapisov. *@
                    <form method="post" action="@($"obvestila/precitaj/{alert.AlertId}")" class="notification-item-form">
                      <AntiforgeryToken />
                      <input type="hidden" name="vrniNa" value="@AlertHref(alert)" />
                      <button type="submit" class="notification-item-body" title="@($"Odpri in označi kot prebrano: {alert.Title}")">
                        <div class="notification-item-top">
                          <span class="notification-title">@alert.Title</span>
                          <span class="notification-severity-label">@alert.Severity</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(alert.PayloadSummaryRedacted))
                        {
                          <span class="notification-detail">@alert.PayloadSummaryRedacted</span>
                        }
                        <span class="notification-meta">@alert.OrganizationName · @alert.Pipeline · @alert.LastSeenUtc.ToPimLocal().ToString("g")</span>
                      </button>
                    </form>
                  </li>
                }
              </ul>
            }
            <a class="notification-panel-link" href="sistem">Odpri vsa obvestila</a>
          </div>
        </details>
      }
      <div class="signed-user"><span>@Initials</span><strong>@DisplayName</strong></div>
      <form method="post" action="odjava"><AntiforgeryToken /><button type="submit" class="logout-button">Odjava</button></form>
    </header>
    <article class="app-content">@Body</article>
  </main>
</div>

@* Okno izvozov v ozadju: napredek, ocena preostanka in prenos uporabnikovega izvoza na VSAKI
   strani, ne samo na /izdelki, ki ga je sprožila. Uporabnik 2026-09-22 je kliknil »Izvozi«,
   takoj za tem »Uvozi«, in ni vec vedel, kaj se dogaja. Postavitev je staticni SSR, zato okno
   izrise wwwroot/js/pim-export.js iz GET /izvoz/opravila; data-permanent ga ohrani cez
   izboljsano navigacijo Blazorja, da ne utripa ob vsakem kliku. *@
<div id="pim-export-tray" class="export-tray" data-permanent aria-live="polite"></div>

@code {
  string DisplayName = "Uporabnik";
  string Initials = "U";
  bool IsAdmin;
  AttentionSummary Attention = AttentionSummary.Empty;
  IReadOnlyList<AdminAlertRow> RecentAlerts = [];
  PimLifecycleArea Lifecycle = PimLifecycle.Oversight;
  string ReturnPath = "";

  string AlertTitle => Attention.Total == 0 ? "Vse teče: ni odprtih opozoril" : $"Potrebuje pozornost: {Attention.Title}";
  static string Chip(string severity) => severity is "Critical" ? "bad" : severity is "Warning" ? "warn" : "good";

  // Klik na obvestilo mora odpreti stran, kjer je videti in resljivo prav TO, o cemer opozorilo
  // govori — ne vedno isti splosni pregled. Preslikava je po AlertKind (glej migracijo 222 za
  // popoln seznam vrst, ki jih baza sploh kdaj zapise); privzeto se uporabi celoten pregled.
  // Blok 7 prenove nadzora: alarm posla (Pipeline "OPRAVILO:<KEY>", npr. JobFailed, SourceStale)
  // odpre stran tega posla s koraki, fazami in izpisom; gostitelj in postopki odprejo Nadzor, kjer
  // je gostitelj in vsak posel s svojim postopkom. Podatkovni alarmi zgoraj ostanejo na strani
  // podatkov, ker jih tam tudi rešiš.
  static string AlertHref(AdminAlertRow alert) => alert.AlertKind switch
  {
    "ReservationExcluded" => "nastavitve/rezervacija-zaloge",
    "StockSnapshotStale" or "StockSnapshotEmpty" => "zaloge",
    "OutboundDead" or "OutboundDrift" or "OutboundUnacknowledged" => "izvozi/obvestila",
    "ExportRejected" => "splet",
    // 251: artikli, ki jim je PIM odstranil kljukico spletisca, z razlogom in pregledom.
    "WebShopWithdrawn" => "splet/umaknjeni",
    _ when alert.Pipeline is { } pipeline && pipeline.StartsWith("OPRAVILO:", StringComparison.Ordinal) && pipeline.Length > "OPRAVILO:".Length
      => "sistem/posel/" + Uri.EscapeDataString(pipeline["OPRAVILO:".Length..]),
    _ when alert.Pipeline == "GOSTITELJ" => "sistem",
    "StaleHeartbeat" or "StalledWatermark" or "PipelinePaused" or "PipelineDisabled" or "PipelineOverdue" => "sistem",
    _ => "sistem",
  };

  protected override async Task OnInitializedAsync()
  {
    ReturnPath = Navigation.ToBaseRelativePath(Navigation.Uri);
    Lifecycle = PimLifecycle.ResolveLifecycleArea(ReturnPath);
    var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
    DisplayName = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? user.Identity?.Name ?? "Uporabnik";
    Initials = string.Concat(DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    IsAdmin = user.IsInRole(PimRoles.Admin);
    if (!IsAdmin) return;

    var userKey = user.Identity?.Name ?? "neznan";
    try
    {
      // Števec ni vezan na izbrano podjetje: postopek, ki je padel pri podjetju 3, je enako
      // narobe, tudi kadar skrbnik gleda podjetje 1.
      Attention = await Nadzor.GetAttentionAsync(userKey);
      RecentAlerts = await Nadzor.GetRecentAlertsAsync(userKey);
    }
    catch
    {
      // Baza ni dosegljiva: zvonec ostane brez stevca, stran pa se vseeno izrise s svojim
      // lastnim sporocilom o napaki.
      Attention = AttentionSummary.Empty;
      RecentAlerts = [];
    }
  }
}

<div id="blazor-error-ui">
    Prišlo je do nepričakovane napake.
    <a href="" class="reload">Ponovno naloži</a>
    <a class="dismiss" aria-label="Zapri sporočilo">×</a>
</div>
