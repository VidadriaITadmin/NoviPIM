@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PIM.Intranet.Services.IntranetDataService Data
@inject NavigationManager Navigation

@* Preklop navigacije je CSS, ne JavaScript in ne vezje: postavitev ostane staticni SSR, ker
   obrazca za prijavo in odjavo potrebujeta antiforgery, ta pa v interaktivnem nacinu ne velja. *@
<input type="checkbox" id="pim-menu-toggle" class="menu-toggle-input" aria-hidden="true" tabindex="-1" />
<div class="app-shell">
  <aside id="primary-navigation" class="app-sidebar"><NavMenu /></aside>
  <label class="menu-scrim" for="pim-menu-toggle" aria-hidden="true"></label>
  <main class="app-main">
    <header class="app-topbar">
      <label class="menu-glyph" for="pim-menu-toggle" aria-controls="primary-navigation" title="Preklopi glavno navigacijo">
        <span class="menu-glyph-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Preklopi glavno navigacijo</span>
      </label>
      <div class="flow-context" title="@Lifecycle.Description">
        <small>Podatkovni tok</small><strong>@Lifecycle.Label</strong>
      </div>
      <div class="topbar-spacer"></div>

      <a class="notification-button" href="system/integracije" title="@AlertTitle">
        <span class="notification-icon" aria-hidden="true"></span>
        @if (OpenAlerts > 0)
        {
          <span class="notification-count">@OpenAlerts</span>
        }
        <span class="visually-hidden">@AlertTitle</span>
      </a>
      <div class="signed-user"><span>@Initials</span><strong>@DisplayName</strong></div>
      <form method="post" action="odjava"><AntiforgeryToken /><button type="submit" class="logout-button">Odjava</button></form>
    </header>
    <article class="app-content">@Body</article>
  </main>
</div>

@code {
  string DisplayName = "Uporabnik";
  string Initials = "U";
  int OpenAlerts;
  PimLifecycleArea Lifecycle = PimLifecycle.Oversight;

  string AlertTitle => OpenAlerts == 0 ? "Ni odprtih opozoril" : $"Odprta opozorila: {OpenAlerts}";

  protected override async Task OnInitializedAsync()
  {
    Lifecycle = PimLifecycle.ResolveLifecycleArea(Navigation.ToBaseRelativePath(Navigation.Uri));
    var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
    DisplayName = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? user.Identity?.Name ?? "Uporabnik";
    Initials = string.Concat(DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    try
    {
      var organization = await Data.GetCurrentOrganizationAsync();
      if (organization is not null) OpenAlerts = await Data.GetOpenAlertCountAsync(organization.OrganizationId);
    }
    catch
    {
      // Baza ni dosegljiva: zvonec ostane brez stevca, stran pa se vseeno izrise s svojim
      // lastnim sporocilom o napaki.
      OpenAlerts = 0;
    }
  }
}

<div id="blazor-error-ui">
    Prišlo je do nepričakovane napake.
    <a href="" class="reload">Ponovno naloži</a>
    <a class="dismiss" aria-label="Zapri sporočilo">×</a>
</div>
