@inject SafeguardService Safeguards
@inject AuthenticationStateProvider Authentication

@* 281: spremembe za SAOP, ki čakajo potrditev, pokazane na strani odobritve s seznamom in potrditvijo na mestu —
   brez skakanja na druge strani (uporabnik 2026-09-24). Nesumljive spremembe so ob odobritvi že šle. *@

@if (Message is not null) { <p class="message-state success-message" role="status">@Message</p> }
@if (Error is not null) { <p class="message-state error-message" role="alert">@Error</p> }
@if (LoadError is not null) { <p class="message-state error-message" role="alert">@LoadError</p> }
@if (Items.Count > 0 && !Hidden)
{
  <SaopDeactivationConfirm Items="Items" Busy="Busy" OnSendAll="ConfirmAsync" OnCancel="() => Hidden = true" />
}

@code {
  /// <summary>Stran ga poveča po odobritvi, da se seznam osveži.</summary>
  [Parameter] public int Version { get; set; }

  /// <summary>Samo spremembe tega podjetja (stran z izbranim podjetjem); null = vse.</summary>
  [Parameter] public int? OrganizationId { get; set; }

  IReadOnlyList<SaopHeldRow> Items = [];
  (int Version, int? OrganizationId)? loadedKey;
  bool rendered, loading;
  bool Busy, Hidden;
  string? Message, Error, LoadError;

  /* 46: seznam se bere šele po prvem izrisu — stran (tudi predupodabljanje) nikoli ne čaka na pasico.
     Nov Version (po odobritvi) ali drugo podjetje seznam prebere znova. */
  protected override async Task OnParametersSetAsync()
  {
    if (rendered && loadedKey != (Version, OrganizationId)) await ReloadAsync();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    rendered = true;
    loadedKey = null;
    await ReloadAsync();
  }

  async Task ReloadAsync()
  {
    if (loading) return;
    loading = true;
    try
    {
      /* parametri so se med branjem lahko spet spremenili — beri, dokler seznam ne ustreza zadnjim */
      while (loadedKey != (Version, OrganizationId))
      {
        loadedKey = (Version, OrganizationId);
        Hidden = false;
        await LoadAsync();
      }
    }
    finally { loading = false; }
    await InvokeAsync(StateHasChanged);
  }

  async Task LoadAsync()
  {
    try { Items = await Safeguards.GetSaopHeldAsync(organizationId: OrganizationId); LoadError = null; }
    catch (Exception exception) when (exception is Microsoft.Data.SqlClient.SqlException or InvalidOperationException)
    {
      /* 46: napaka ali iztek branja ne sme izgledati kot »nič ne čaka« */
      Items = [];
      LoadError = "Seznama sprememb, ki čakajo potrditev za SAOP, ni bilo mogoče prebrati. Osveži stran čez nekaj trenutkov. "
        + "Spremembe, ki čakajo potrditev, medtem ne gredo v SAOP.";
    }
  }

  async Task ConfirmAsync()
  {
    Busy = true; Error = null; Message = null;
    try
    {
      var actor = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "neznan";
      var confirmed = await Safeguards.ConfirmSaopHeldAsync(Items.Select(item => item.OutboxMessageId).ToList(), actor);
      Message = $"Potrjeno: {confirmed:N0} sprememb gre v SAOP.";
      await LoadAsync();
    }
    catch (UnauthorizedAccessException) { Error = "Tvoja vloga pošiljanja v SAOP ne dovoljuje."; }
    catch (Microsoft.Data.SqlClient.SqlException exception) { Error = "Potrditev ni uspela: " + exception.Message; }
    finally { Busy = false; }
  }
}
