<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pogodba bralnega API-ja brez baze: katalog končnih točk (src/PIM.Api/Catalog.cs) se mora ujemati s
       postopki in parametri v migraciji 287, MCP (McpProtocol.cs) mora odgovarjati po protokolu.
       Sklic na cel projekt PIM.Api: napaka prevajanja kjerkoli v API-ju podre ta test (in vrata). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PIM.Api\PIM.Api.csproj" />
  </ItemGroup>
</Project>
