<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pogodba bralnega API-ja brez baze: katalog končnih točk (src/PIM.Api/Catalog.cs) se mora ujemati s
       postopki in parametri v migraciji 287. Napaka tu = API bi ob klicu padel z »parameter ne obstaja«. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\PIM.Api\Catalog.cs" Link="Catalog.cs" />
  </ItemGroup>
</Project>
