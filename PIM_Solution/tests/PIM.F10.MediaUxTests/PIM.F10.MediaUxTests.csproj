<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- #32: MediaBulkEdit (paketno urejanje medijev) potrebuje ves intranet; povezane datoteke spodaj ostanejo,
         zato je CS0436 (isti tip v viru in v sklicu) utisan. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PIM.Intranet/PIM.Intranet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\PIM.Intranet\Services\MediaKindPolicy.cs" Link="MediaKindPolicy.cs" />
    <Compile Include="..\..\src\PIM.Intranet\Services\MediaUrlPolicy.cs" Link="MediaUrlPolicy.cs" />
  </ItemGroup>
</Project>
